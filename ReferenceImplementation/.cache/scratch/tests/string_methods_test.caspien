import "stdlib/libc.caspien"
import "stdlib/gt/*"
import "stdlib/print.caspien"
import "stdlib/string.caspien"

func report(name: static imut string, ok: imut bool) void{
	if ok{ print("PASS ") } else { print("FAIL ") }
	println(name)
}

@throws
func pair(a: static imut string, b: static imut string, n: imut u64, eq: imut bool, sw: imut bool, ew: imut bool, aEmpty: imut bool) void{
	?catch(e){ throw e }
	let sa = mut ? new String(a)
	let sb = mut ? new String(b)
	match Some(sa){
		match Some(sb){
			report(a, sa.length(sa) == n)
			report(a, sa.isEmpty(sa) == aEmpty)
			report(b, sa.equals(sa, sb) == eq)
			report(b, sa.equals(sa, b) == eq)
			report(b, sa.startsWith(sa, sb) == sw)
			report(b, sa.startsWith(sa, b) == sw)
			report(b, sa.endsWith(sa, sb) == ew)
			report(b, sa.endsWith(sa, b) == ew)
		}
	}
}

