// Assigning an owned value over an owns member reached through a pointer, a ref parameter or an index must drop the old
// value's own members too (before: only the outer block was freed). run_tests.py's leak check fails this program if any
// block stays registered at exit.
import "stdlib/libc.caspien"
import "stdlib/gt/*"
import "stdlib/print.caspien"
import "stdlib/string.caspien"

struct H{@pub{
	v: owns mut String
}}

func setIt(h: ref some mut H, b: owns mut String) void{
	h.v = b
}

@throws
func viaHeap() mut u64{
	?catch(e){ throw e }
	let a = mut ? new String("old")
	let b = mut ? new String("newer")
	let h = mut ? new H{v= a}
	match Some(h){ h.v = b }
	let n = mut 0
	match Some(h){
		match Some(h.v){ n = h.v.length(h.v) }
	}
	return n
}

@throws
func viaParam() mut u64{
	?catch(e){ throw e }
	let a = mut ? new String("old")
	let b = mut ? new String("a longer string")
	let h = mut ? new H{v= a}
	match Some(h){ setIt(h, b) }
	let n = mut 0
	match Some(h){
		match Some(h.v){ n = h.v.length(h.v) }
	}
	return n
}

@throws
func viaIndex() mut u64{
	?catch(e){ throw e }
	let a = mut ? new String("old")
	let b = mut ? new String("xy")
	let hs = mut ? dyn([H{v= a}])
	match 0 into hs{ hs[0].v = b }
	let n = mut 0
	match 0 in hs{
		let r = mut ref hs[0].v
		match Some(r){ n = r.length(r) }
	}
	return n
}

func check(name: static imut string, got: imut u64, want: imut u64) void{
	if got == want{ print("PASS ") } else { print("FAIL ") }
	println(name)
}

func main() void{
	?catch(e){ return }
	let x = mut ? viaHeap()
	check("heap member", x, 5)
	let y = mut ? viaParam()
	check("ref param member", y, 15)
	let z = mut ? viaIndex()
	check("dyn element member", z, 2)
}
