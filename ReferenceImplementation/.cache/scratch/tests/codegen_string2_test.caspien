// Differential test of the converted run-time-String leaf methods of codegenCaspien against the Java originals (check lines generated by gen_codegen_string2_test.py).
import "stdlib/libc.caspien"
import "stdlib/gt/*"
import "../Codegen/src/main/java/caspien/codegen/codegenCaspien/x86backend/X86Backend.caspien"

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

// got == null means the method threw; want "EX" means the Java threw.
func chk(name: static imut string, got: ref imut String, want: static imut string) void{
	let ok = mut String.literalsEqual(want, "EX")
	match Some(got){
		ok = got.equals(got, want)
	}
	check(name, ok)
}

func chkn(name: static imut string, got: owns mut String, want: static imut string) void{
	chk(name, got, want)
}

func nb() owns mut X86Backend{
	?catch(e){ return null }
	let b = mut ? new X86Backend(CodegenTarget.LINUX_X64)
	? b.wire(b)
	return b
}

func t_x(a: static imut string) owns mut String{
	?catch(e){ return null }
	let b = mut nb()
	match Some(b){ match Some(b.gen){
		let r = mut ? b.gen.xText(b.gen, a)
		return r
	} }
	return null
}

func t_ml(a: static imut string) owns mut String{
	?catch(e){ return null }
	let b = mut nb()
	let s = mut ? new String(a)
	match Some(b){ match Some(b.gen){ match Some(s){
		let r = mut ? b.gen.mangleLabel(b.gen, s)
		return r
	} } }
	return null
}

func t_mg(a: static imut string) owns mut String{
	?catch(e){ return null }
	let b = mut nb()
	let s = mut ? new String(a)
	match Some(b){ match Some(b.emit){ match Some(s){
		let r = mut ? b.emit.mangleGlobalName(b.emit, s)
		return r
	} } }
	return null
}

func t_po(v: mut s64) owns mut String{
	?catch(e){ return null }
	let r = mut ? X86Emit.plusOffset(v)
	return r
}

func t_ot(v: mut s64) owns mut String{
	?catch(e){ return null }
	let r = mut ? X86Emit.offsetText(v)
	return r
}

func t_mt(v: mut s64) owns mut String{
	?catch(e){ return null }
	let b = mut nb()
	match Some(b){ match Some(b.regForm){
		let r = mut ? b.regForm.rfMemText(b.regForm, v)
		return r
	} }
	return null
}

func t_rt(a: static imut string) owns mut String{
	?catch(e){ return null }
	let b = mut nb()
	match Some(b){ match Some(b.regForm){
		let r = mut ? b.regForm.rfRegText(b.regForm, a)
		return r
	} }
	return null
}

func t_alias(r: static imut string, f: static imut string) mut bool{
	?catch(e){ return false }
	let a = mut ? new String(r)
	let b = mut ? new String(f)
	let res = mut false
	match Some(a){ match Some(b){ res = X86Core.regAliasOf(a, b) } }
	return res
}

func t_fl(x: static imut string) mut bool{
	?catch(e){ return false }
	let a = mut ? new String(x)
	let res = mut false
	match Some(a){ res = X86Core.isFloatLiteral(a) }
	return res
}

// prefixes and expected labels are comma separated; true when every label matches in order
func t_labels(prefixes: static imut string, want: static imut string) mut bool{
	?catch(e){ return false }
	let b = mut nb()
	let all = mut ? new String()
	let src = mut ? new String(prefixes)
	let cur = mut ? new String()
	match Some(src){
		let n = mut src.length(src)
		for i in 0..n{
			let c = mut src.charAt(src, i)
			if c == ','{
				match Some(b){ match Some(b.regForm){ match Some(cur){
					let l = mut ? b.regForm.newInternalLabel(b.regForm, cur)
					match Some(all){
						? all.append(all, l)
						? all.append(all, ",")
					}
				} } }
				cur = ? new String()
			} else{
				match Some(cur){ ? cur.appendChar(cur, c) }
			}
		}
	}
	let ok = mut false
	match Some(all){ ok = all.equals(all, want) }
	return ok
}

func state_ok(b: ref imut X86Backend, mask: mut s32, used: imut bool) mut bool{
	let r = mut false
	match Some(b){
		r = b.core.rfVarMask == mask && b.core.rfVarUsed == used
	}
	return r
}

func c_reg(name: static imut string, tok: static imut string, want: static imut string, mask: mut s32, used: imut bool) void{
	?catch(e){ check(name, false)
		return }
	let b = mut nb()
	let s = mut ? new String(tok)
	match Some(b){ match Some(b.regForm){ match Some(s){
		let g = try b.regForm.rfReg(b.regForm, s) catch(err){
			check(name, String.literalsEqual(want, "EX") && state_ok(b, mask, used))
			return
		}
		check(name, String.literalsEqual(g, want) && state_ok(b, mask, used))
		return
	} } }
	check(name, false)
}

func t_mem(ov: static imut string, hasOv: imut bool, ix: static imut string, hasIx: imut bool, scale: mut s64, disp: mut s64, base: static imut string) owns mut String{
	?catch(e){ return null }
	let b = mut nb()
	if hasOv{
		let t = mut ? String.from(ov)
		match Some(b){ b.core.rfMemOverride = t }
	}
	if hasIx{
		let t = mut ? String.from(ix)
		match Some(b){ b.core.rfIdxReg = t }
	}
	match Some(b){
		b.core.rfIdxScale = scale
		b.core.rfIdxDisp = disp
	}
	match Some(b){ match Some(b.gen){
		let r = mut ? b.gen.rfMemOperand(b.gen, base)
		return r
	} }
	return null
}

func c_x(name: static imut string, a: static imut string, want: static imut string) void{ let r = mut t_x(a)
	chk(name, r, want) }
func c_ml(name: static imut string, a: static imut string, want: static imut string) void{ let r = mut t_ml(a)
	chk(name, r, want) }
func c_mg(name: static imut string, a: static imut string, want: static imut string) void{ let r = mut t_mg(a)
	chk(name, r, want) }
func c_po(name: static imut string, v: mut s64, want: static imut string) void{ let r = mut t_po(v)
	chk(name, r, want) }
func c_ot(name: static imut string, v: mut s64, want: static imut string) void{ let r = mut t_ot(v)
	chk(name, r, want) }
func c_mt(name: static imut string, v: mut s64, want: static imut string) void{ let r = mut t_mt(v)
	chk(name, r, want) }
func c_rt(name: static imut string, a: static imut string, want: static imut string) void{ let r = mut t_rt(a)
	chk(name, r, want) }
func c_mem(name: static imut string, ov: static imut string, hasOv: imut bool, ix: static imut string, hasIx: imut bool, scale: mut s64, disp: mut s64, base: static imut string, want: static imut string) void{
	let r = mut t_mem(ov, hasOv, ix, hasIx, scale, disp, base)
	chk(name, r, want)
}

func t_min() mut s64{
	let:<mut s64> m = mut -9223372036854775807
	let:<mut s64> one = mut 1
	return m - one
}

func part0() void{
	c_x("xText xmm0", "xmm0", "%xmm0")
	c_x("xText xmm15", "xmm15", "%xmm15")
	c_x("xText ", "", "%")
	c_x("xText x", "x", "%x")
	c_ml("mangleLabel @L1", "@L1", "L_L1")
	c_ml("mangleLabel a@b@c", "a@b@c", "aL_bL_c")
	c_ml("mangleLabel ", "", "")
	c_ml("mangleLabel x", "x", "x")
	c_ml("mangleLabel @@", "@@", "L_L_")
	c_ml("mangleLabel L_1", "L_1", "L_1")
	c_mg("mangleGlobalName a.b.c", "a.b.c", "a_b_c")
	c_mg("mangleGlobalName x", "x", "x")
	c_mg("mangleGlobalName ", "", "")
	c_mg("mangleGlobalName ...", "...", "___")
	c_mg("mangleGlobalName a..b", "a..b", "a__b")
	c_po("plusOffset 0", 0, "")
	c_ot("offsetText 0", 0, "")
	c_mt("rfMemText 0", 0, "0(%rbp)")
	c_po("plusOffset 1", 1, "+1")
	c_ot("offsetText 1", 1, "1")
	c_mt("rfMemText 1", 1, "1(%rbp)")
	c_po("plusOffset -1", (-1), "+-1")
	c_ot("offsetText -1", (-1), "-1")
	c_mt("rfMemText -1", (-1), "-1(%rbp)")
	c_po("plusOffset 5", 5, "+5")
	c_ot("offsetText 5", 5, "5")
	c_mt("rfMemText 5", 5, "5(%rbp)")
	c_po("plusOffset -5", (-5), "+-5")
	c_ot("offsetText -5", (-5), "-5")
	c_mt("rfMemText -5", (-5), "-5(%rbp)")
	c_po("plusOffset 8", 8, "+8")
	c_ot("offsetText 8", 8, "8")
	c_mt("rfMemText 8", 8, "8(%rbp)")
	c_po("plusOffset 4096", 4096, "+4096")
	c_ot("offsetText 4096", 4096, "4096")
	c_mt("rfMemText 4096", 4096, "4096(%rbp)")
	c_po("plusOffset 123456789012", 123456789012, "+123456789012")
	c_ot("offsetText 123456789012", 123456789012, "123456789012")
	c_mt("rfMemText 123456789012", 123456789012, "123456789012(%rbp)")
	c_po("plusOffset 9223372036854775807", 9223372036854775807, "+9223372036854775807")
	c_ot("offsetText 9223372036854775807", 9223372036854775807, "9223372036854775807")
	c_mt("rfMemText 9223372036854775807", 9223372036854775807, "9223372036854775807(%rbp)")
	c_po("plusOffset -9223372036854775808", t_min(), "+-9223372036854775808")
	c_ot("offsetText -9223372036854775808", t_min(), "-9223372036854775808")
	c_mt("rfMemText -9223372036854775808", t_min(), "-9223372036854775808(%rbp)")
	c_rt("rfRegText rax", "rax", "%rax")
	c_rt("rfRegText r15", "r15", "%r15")
	c_rt("rfRegText rsp", "rsp", "%rsp")
	check("regAliasOf rax rax", t_alias("rax", "rax") == true)
	check("regAliasOf rax rbx", t_alias("rax", "rbx") == false)
	check("regAliasOf rax rcx", t_alias("rax", "rcx") == false)
	check("regAliasOf rax rdx", t_alias("rax", "rdx") == false)
	check("regAliasOf rax rsi", t_alias("rax", "rsi") == false)
	check("regAliasOf rax rdi", t_alias("rax", "rdi") == false)
	check("regAliasOf rax r8", t_alias("rax", "r8") == false)
	check("regAliasOf rax r12", t_alias("rax", "r12") == false)
	check("regAliasOf rax r15", t_alias("rax", "r15") == false)
	check("regAliasOf rax rbp", t_alias("rax", "rbp") == false)
	check("regAliasOf rax r", t_alias("rax", "r") == false)
	check("regAliasOf rax r1", t_alias("rax", "r1") == false)
	check("regAliasOf eax rax", t_alias("eax", "rax") == true)
	check("regAliasOf eax rbx", t_alias("eax", "rbx") == false)
	check("regAliasOf eax rcx", t_alias("eax", "rcx") == false)
	check("regAliasOf eax rdx", t_alias("eax", "rdx") == false)
	check("regAliasOf eax rsi", t_alias("eax", "rsi") == false)
	check("regAliasOf eax rdi", t_alias("eax", "rdi") == false)
	check("regAliasOf eax r8", t_alias("eax", "r8") == false)
	check("regAliasOf eax r12", t_alias("eax", "r12") == false)
	check("regAliasOf eax r15", t_alias("eax", "r15") == false)
	check("regAliasOf eax rbp", t_alias("eax", "rbp") == false)
	check("regAliasOf eax r", t_alias("eax", "r") == false)
	check("regAliasOf eax r1", t_alias("eax", "r1") == false)
	check("regAliasOf ax rax", t_alias("ax", "rax") == true)
	check("regAliasOf ax rbx", t_alias("ax", "rbx") == false)
	check("regAliasOf ax rcx", t_alias("ax", "rcx") == false)
	check("regAliasOf ax rdx", t_alias("ax", "rdx") == false)
	check("regAliasOf ax rsi", t_alias("ax", "rsi") == false)
	check("regAliasOf ax rdi", t_alias("ax", "rdi") == false)
	check("regAliasOf ax r8", t_alias("ax", "r8") == false)
	check("regAliasOf ax r12", t_alias("ax", "r12") == false)
	check("regAliasOf ax r15", t_alias("ax", "r15") == false)
	check("regAliasOf ax rbp", t_alias("ax", "rbp") == false)
	check("regAliasOf ax r", t_alias("ax", "r") == false)
	check("regAliasOf ax r1", t_alias("ax", "r1") == false)
	check("regAliasOf al rax", t_alias("al", "rax") == true)
	check("regAliasOf al rbx", t_alias("al", "rbx") == false)
	check("regAliasOf al rcx", t_alias("al", "rcx") == false)
	check("regAliasOf al rdx", t_alias("al", "rdx") == false)
	check("regAliasOf al rsi", t_alias("al", "rsi") == false)
	check("regAliasOf al rdi", t_alias("al", "rdi") == false)
	check("regAliasOf al r8", t_alias("al", "r8") == false)
	check("regAliasOf al r12", t_alias("al", "r12") == false)
	check("regAliasOf al r15", t_alias("al", "r15") == false)
	check("regAliasOf al rbp", t_alias("al", "rbp") == false)
	check("regAliasOf al r", t_alias("al", "r") == false)
	check("regAliasOf al r1", t_alias("al", "r1") == false)
	check("regAliasOf ah rax", t_alias("ah", "rax") == true)
	check("regAliasOf ah rbx", t_alias("ah", "rbx") == false)
	check("regAliasOf ah rcx", t_alias("ah", "rcx") == false)
	check("regAliasOf ah rdx", t_alias("ah", "rdx") == false)
}

