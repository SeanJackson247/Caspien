// Without a @drop hook, a borrowed object declared AFTER the borrower in the same scope is fine (both die at scope end, nothing reads it then).
// Expected output:
// PASS later local 2
import "stdlib/libc.caspien"
import "stdlib/gt/*"
struct A{@pub{ v: mut u64 }}
struct B{@pub{ a: ref some mut A }}
func report(name: static imut string, got: mut u64) void{
	unsafe extern{ printf("PASS %s %llu\n", name, got) }
}
func main() void{
	?catch(e){ return }
	let a1 = mut ?new A{v= 1}
	let b = mut B{a= ref a1}
	let a2 = mut ?new A{v= 2}
	b.a = ref a2
	let r = mut b.a.v
	report("later local", r)
}
