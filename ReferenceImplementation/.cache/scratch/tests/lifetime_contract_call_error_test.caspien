// The call violates the contract: `a` is declared after `b` (it dies first), but wire() promises a outlives b.
import "stdlib/libc.caspien"
import "stdlib/gt/*"
struct A{@pub{ v: mut u64 }}
struct B{@pub{ a: ref some mut A }}
@lock match(lifetime(a) >= lifetime(b))
func wire(a: ref some mut A, b: ref some mut B) void{
	b.a = a
}
func main() void{
	?catch(e){ return }
	let a0 = mut ?new A{v= 1}
	let b = mut ?new B{a= ref a0}
	if true{
		let a = mut ?new A{v= 5}
		wire(a, b)
	}
}
