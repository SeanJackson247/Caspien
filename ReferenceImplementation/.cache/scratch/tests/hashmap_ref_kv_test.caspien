// REF HashMap<K, V> (stdlib/ref/hash_map.caspien) with a value type that differs from the key type (u8 -> u64, u64 -> u8, u16 -> u32). Expected values from a Python model (hashmap_kv_test.py).
import "stdlib/libc.caspien"
import "stdlib/ref/hash_map.caspien"
import "stdlib/gt/*"

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

func main() void{
	?catch(e){
		unsafe extern{ printf("FAIL uncaught: %s\n", e.msg) }
		return
	}
	let a = mut ? new HashMap:<u8, u64>(mut 0, mut 0, mut 4)
	for i in 0..200{
		let:<mut u8> key = mut wrap:<u8>(i)
		a.set(a, key, i * 1000003 + 17)
	}
	let sumA = mut 0
	for i in 0..200{
		let:<mut u8> key = mut wrap:<u8>(i)
		sumA = sumA + a.get(a, key, mut 0)
	}
	check("u8 -> u64: count", a.count == 200)
	check("u8 -> u64: sum", sumA == 19900063100)
	let absent = mut 0
	for i in 200..256{
		let:<mut u8> key = mut wrap:<u8>(i)
		if a.contains(a, key){
			absent = absent + 1
		}
	}
	check("u8 -> u64: absent keys not found", absent == 0)

	let b = mut ? new HashMap:<u64, u8>(mut 0, mut 0, mut 4)
	for i in 0..5000{
		let key = mut (i * 7919 + 13)
		let:<mut u8> val = mut wrap:<u8>(i * 3)
		b.set(b, key, val)
	}
	let sumB = mut 0
	for i in 0..5000{
		let key = mut (i * 7919 + 13)
		sumB = sumB + b.get(b, key, mut 0) as u64
	}
	check("u64 -> u8: count", b.count == 5000)
	check("u64 -> u8: sum", sumB == 634900)

	let c = mut ? new HashMap:<u16, u32>(mut 0, mut 0, mut 4)
	for i in 0..5000{
		let:<mut u16> key = mut wrap:<u16>(i * 37)
		let:<mut u32> val = mut wrap:<u32>(i * 2654435761)
		c.set(c, key, val)
	}
	let sumC = mut 0
	for i in 0..5000{
		let:<mut u16> key = mut wrap:<u16>(i * 37)
		sumC = sumC + c.get(c, key, mut 0) as u64
	}
	check("u16 -> u32: count", c.count == 5000)
	check("u16 -> u32: sum", sumC == 10736343109020)
}
