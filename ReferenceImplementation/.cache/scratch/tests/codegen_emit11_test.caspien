	c_rfRotate("rfRotate 0 ROTL 4 %v1 #5 #5", 0, "ROTL", 4, "%v1", "#5", "#5", "    movl $5, %r14d\n    roll $5, %r14d\n    movl %r14d, %r14d\n|d=0;v=-1;m=2;u=true;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfRotate("rfRotate 0 SAR 7 x x %t3", 0, "SAR", 7, "x", "x", "%t3", "EX")
	c_rfRotate("rfRotate 0 ROTR 2 %v1 x #-2147483649", 0, "ROTR", 2, "%v1", "x", "#-2147483649", "EX")
	c_rfRotate("rfRotate 0 SHL 5 %v1 #5 #", 0, "SHL", 5, "%v1", "#5", "#", "EX")
	c_rfRotate("rfRotate 0 SHR 6 %t3 %t0 #2147483648", 0, "SHR", 6, "%t3", "%t0", "#2147483648", "    movq %rax, %r12\n|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfRotate("rfRotate 0 ROTR 3 %t0 #5 #-3", 0, "ROTR", 3, "%t0", "#5", "#-3", "    movl $5, %eax\n    rorq $21, %rax\n|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfRotate("rfRotate 0 SAR 6 x %t0 abc", 0, "SAR", 6, "x", "%t0", "abc", "EX")
