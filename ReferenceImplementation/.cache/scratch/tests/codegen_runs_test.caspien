// Differential test of the converted run-detection leaves of codegenCaspien (findRunStart, collectRunEntries, populateDirectMembers, noteArgRegLoaded) against the Java originals (check lines generated by gen_codegen_runs_test.py).
import "stdlib/libc.caspien"
import "stdlib/gt/*"
import "../Codegen/src/main/java/caspien/codegen/codegenCaspien/x86backend/X86Backend.caspien"

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

func t_min() mut s64{
	let:<mut s64> m = mut -9223372036854775807
	let:<mut s64> one = mut 1
	return m - one
}

// got == null means the method threw; want "EX" means the Java threw.
func chk(name: static imut string, got: ref imut String, want: static imut string) void{
	let ok = mut String.literalsEqual(want, "EX")
	match Some(got){
		ok = got.equals(got, want)
	}
	check(name, ok)
}

func nb() owns mut X86Backend{
	?catch(e){ return null }
	let b = mut ? new X86Backend(CodegenTarget.LINUX_X64)
	? b.wire(b)
	return b
}

func num(v: mut s64) owns mut String{
	?catch(e){ return null }
	let r = mut ? String.fromS64(v)
	return r
}

func fill(lines: ref mut ObjectList<BytecodeStatement>, spec: static imut string) void{
	?catch(e){ return }
	let s = mut ? new String(spec)
	let stmt = mut ? new BytecodeStatement()
	let tok = mut ? new String()
	let n = mut s.length(s)
	for i in 0..n{
		let c = mut s.charAt(s, i)
		if c == ' ' || c == ';'{
			let f = mut ? new String("f")
			let tk = mut ? new BytecodeToken(tok, f, 1, BytecodeTokenKind.CODE)
			? stmt.items.add(stmt.items, tk)
			tok = ? new String()
			if c == ';'{
				match Some(lines){ ? lines.add(lines, stmt) }
				stmt = ? new BytecodeStatement()
			}
		} else{
			? tok.appendChar(tok, c)
		}
	}
}


func t_frs(spec: static imut string, end: mut s32, target: mut s64) owns mut String{
	?catch(e){ return null }
	let lines = mut ? new ObjectList:<BytecodeStatement>()
	let b = mut nb()
	fill(lines, spec)
	match Some(b){ match Some(lines){ b.core.allLines = ref lines } }
	let:<mut s32> r = mut -99
	match Some(b){ match Some(b.emit){
		r = ? b.emit.findRunStart(b.emit, end, target)
	} }
	let s = mut ? String.fromS64(wrap:<s64>(r))
	return s
}

func c_frs(name: static imut string, spec: static imut string, end: mut s32, target: mut s64, want: mut s32) void{
	let r = mut t_frs(spec, end, target)
	let w = mut num(wrap:<s64>(want))
	match Some(w){ match Some(r){ check(name, r.equals(r, w)) } }
}

func t_cre(spec: static imut string, s: mut s32, e: mut s32) owns mut String{
	?catch(e2){ return null }
	let lines = mut ? new ObjectList:<BytecodeStatement>()
	let b = mut nb()
	fill(lines, spec)
	match Some(b){ match Some(lines){ b.core.allLines = ref lines } }
	let out = mut ? new String()
	match Some(b){ match Some(b.emit){
		let en = mut ? b.emit.collectRunEntries(b.emit, s, e)
		let n = mut len(en.sizes.backing)
		for i in 0..n{
			match i in en.sizes.backing{ match i in en.storeLines.backing{
				? out.appendS64(out, en.sizes.backing[i])
				? out.append(out, ":")
				? out.appendS64(out, wrap:<s64>(en.storeLines.backing[i]))
				? out.append(out, "|")
			} }
		}
	} }
	return out
}

func c_cre(name: static imut string, spec: static imut string, s: mut s32, e: mut s32, want: static imut string) void{
	let r = mut t_cre(spec, s, e)
	chk(name, r, want)
}

func t_pdm(spec: static imut string, s: mut s32, e: mut s32, total: mut s64) owns mut String{
	?catch(e2){ return null }
	let lines = mut ? new ObjectList:<BytecodeStatement>()
	let b = mut nb()
	fill(lines, spec)
	match Some(b){ match Some(lines){ b.core.allLines = ref lines } }
	let out = mut ? new String()
	match Some(b){ match Some(b.emit){
		? b.emit.populateDirectMembers(b.emit, s, e, total)
	} }
	let n = mut len(lines.items)
	for i in 0..n{
		match Some(b){
			match Some(b.core){
				let key = mut wrap:<s32>(i)
				if b.core.pushStoreOffsetByLine.contains(b.core.pushStoreOffsetByLine, key){
					let v = mut b.core.pushStoreOffsetByLine.get(b.core.pushStoreOffsetByLine, key, 0)
					? out.appendS64(out, wrap:<s64>(key))
					? out.append(out, "=")
					? out.appendS64(out, v)
					? out.append(out, "|")
				}
			}
		}
	}
	return out
}

func c_pdm(name: static imut string, spec: static imut string, s: mut s32, e: mut s32, total: mut s64, want: static imut string) void{
	let r = mut t_pdm(spec, s, e, total)
	chk(name, r, want)
}

func t_nal(tags: static imut string, withTop: imut bool) owns mut String{
	?catch(e){ return null }
	let b = mut nb()
	let out = mut ? new String()
	if withTop{
		let seed = mut ? new ObjectList:<String>()
		let pre = mut ? new String("pre")
		? seed.add(seed, pre)
		match Some(b){ match Some(b.core){ ? b.core.loadedArgRegsStack.add(b.core.loadedArgRegsStack, seed) } }
	}
	let ts = mut ? new String(tags)
	let n = mut ts.length(ts)
	let tok = mut ? new String()
	for i in 0..n{
		let c = mut ts.charAt(ts, i)
		if c == ','{
			match Some(b){ match Some(b.emit){ ? b.emit.noteArgRegLoaded(b.emit, tok) } }
			tok = ? new String()
		} else{
			? tok.appendChar(tok, c)
		}
	}
	let emptyStack = mut false
	match Some(b){ match Some(b.core){ emptyStack = b.core.loadedArgRegsStack.isEmpty(b.core.loadedArgRegsStack) } }
	if emptyStack{
		? out.append(out, "empty")
	} else{
		let m = mut 0
		match Some(b){ match Some(b.core){
			let top = b.core.loadedArgRegsStack.peek(b.core.loadedArgRegsStack)
			match Some(top){ m = top.size(top) }
		} }
		for j in 0..m{
			if j > 0{ ? out.append(out, "|") }
			match Some(b){ match Some(b.core){
				let top = b.core.loadedArgRegsStack.peek(b.core.loadedArgRegsStack)
				match Some(top){
					let e = top.get(top, j)
					match Some(e){ ? out.append(out, e) }
				}
			} }
		}
	}
	return out
}

func c_nal(name: static imut string, tags: static imut string, withTop: imut bool, want: static imut string) void{
	let r = mut t_nal(tags, withTop)
	chk(name, r, want)
}

