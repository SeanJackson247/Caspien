// LinkedHashMap: a random run (with removals and compactions) checked against linkedhashmap_test.py; iteration must follow insertion order.
import "stdlib/libc.caspien"
import "stdlib/ref/linked_hash_map.caspien"
import "stdlib/gt/*"

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

func main() void{
	?catch(e){
		unsafe extern{ printf("FAIL uncaught: %s\n", e.msg) }
		return
	}
	let m = mut ? new LinkedHashMap:<u64, u64>(mut 0, mut 16)
	let x = mut 4242
	let removed = mut 0
	let found = mut 0
	for i in 0..6000{
		x = (x * 1103515245 + 12345) % 2147483648
		let op = mut (bits_right(x, 16) % 4)
		let key = mut (bits_right(x, 8) % 1500)
		if op < 2{
			? m.set(m, key, i)
		}
		else{
			if op == 2{
				if m.remove(m, key){ removed = removed + 1 }
			}
			else{
				if m.contains(m, key){ found = found + 1 }
			}
		}
	}
	let keySum = mut 0
	let valSum = mut 0
	let wk = mut 0
	let wv = mut 0
	let rank = mut 0
	let firstKey = mut 0
	let lastKey = mut 0
	for match i in m.slots{
		if m.isLive(m, i){
			let k = mut m.keyAt(m, i)
			let v = mut m.valueAt(m, i)
			rank = rank + 1
			keySum = keySum + k
			valSum = valSum + v
			wk = (wk + rank * k) % 1000003
			wv = (wv + rank * v) % 1000003
			if rank == 1{ firstKey = k }
			lastKey = k
		}
	}
	check("random run: size", m.size(m) == 930 && rank == 930)
	check("random run: removes", removed == 689)
	check("random run: contains", found == 697)
	check("sum of keys", keySum == 703299)
	check("sum of values", valSum == 4046519)
	check("first and last key", firstKey == 298 && lastKey == 139)
	check("order-weighted key checksum", wk == 754921)
	check("order-weighted value checksum", wv == 395522)
	check("compaction kept slots bounded", m.slotCount(m) < 2 * m.size(m) + 10)

	let t = mut ? new LinkedHashMap:<u8, u8>(mut 0, mut 4)
	? t.set(t, mut 30, mut 1)
	? t.set(t, mut 10, mut 2)
	? t.set(t, mut 20, mut 3)
	? t.set(t, mut 30, mut 4)
	check("replace keeps size", t.size(t) == 3)
	check("replace keeps position", t.slotCount(t) == 3)
	check("get", t.get(t, mut 30, mut 0) == 4 && t.get(t, mut 99, mut 7) == 7)
	check("remove absent", !t.remove(t, mut 99))
	check("remove present", t.remove(t, mut 10) && !t.contains(t, mut 10) && t.size(t) == 2)
	? t.set(t, mut 10, mut 9)
	let seq = mut 0
	let ordered = mut true
	for match i in t.slots{
		if t.isLive(t, i){
			seq = seq + 1
			let kk = mut t.keyAt(t, i)
			if seq == 1{ if kk != 30{ ordered = false } }
			if seq == 2{ if kk != 20{ ordered = false } }
			if seq == 3{ if kk != 10{ ordered = false } }
		}
	}
	check("re-added key goes last", ordered && seq == 3)
	check("remove all", t.remove(t, mut 30) && t.remove(t, mut 20) && t.remove(t, mut 10) && t.size(t) == 0)
}
