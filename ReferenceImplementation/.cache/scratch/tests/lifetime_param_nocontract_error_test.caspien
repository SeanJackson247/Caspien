// Storing one parameter into another without a contract is rejected: the caller may pass a short-lived A with a long-lived B.
import "stdlib/libc.caspien"
import "stdlib/gt/*"
struct A{@pub{ v: mut u64 }}
struct B{@pub{ a: ref some mut A }}
func wire(a: ref some mut A, b: ref some mut B) void{
	b.a = a
}
func main() void{
	?catch(e){ return }
	let a = mut ?new A{v= 5}
	let b = mut ?new B{a= ref a}
	wire(a, b)
}
