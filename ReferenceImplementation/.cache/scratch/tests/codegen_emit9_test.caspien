func part0() void{
	c_rfIndexedBase("rfIndexedBase 0 $-16 r8", 0, "$-16", "r8", "|ret=rbp|d=0;v=-1;m=0;u=false;ir=null;is=1;id=-16;sh=0;sk=0;mo=null")
	c_rfIndexedBase("rfIndexedBase 0 %v1 r15", 0, "%v1", "r15", "|ret=r14|d=0;v=-1;m=2;u=true;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfIndexedBase("rfIndexedBase 0 $24 rcx", 0, "$24", "rcx", "|ret=rbp|d=0;v=-1;m=0;u=false;ir=null;is=1;id=24;sh=0;sk=0;mo=null")
	c_rfIndexedBase("rfIndexedBase 0 %t0 xmm0", 0, "%t0", "xmm0", "|ret=rax|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfIndexedBase("rfIndexedBase 0 %t2 r8", 0, "%t2", "r8", "|ret=r11|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfIndexedBase("rfIndexedBase 0 &a.b rbp", 0, "&a.b", "rbp", "    leaq a_b(%rip), %rbp\n|ret=rbp|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfIndexedBase("rfIndexedBase 0 %t2 rbp", 0, "%t2", "rbp", "|ret=r11|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfIndexedBase("rfIndexedBase 0 $-16 xmm0", 0, "$-16", "xmm0", "|ret=rbp|d=0;v=-1;m=0;u=false;ir=null;is=1;id=-16;sh=0;sk=0;mo=null")
	c_rfIndexedBase("rfIndexedBase 0 %t0 r11", 0, "%t0", "r11", "|ret=rax|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfIndexedBase("rfIndexedBase 0 &a.b rax", 0, "&a.b", "rax", "    leaq a_b(%rip), %rax\n|ret=rax|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
