	c_rfIndexedBase("rfIndexedBase 0 %t2 r15", 0, "%t2", "r15", "|ret=r11|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfIndexedBase("rfIndexedBase 0 $24 r11", 0, "$24", "r11", "|ret=rbp|d=0;v=-1;m=0;u=false;ir=null;is=1;id=24;sh=0;sk=0;mo=null")
	c_rfIndexedBase("rfIndexedBase 0 $24 rsi", 0, "$24", "rsi", "|ret=rbp|d=0;v=-1;m=0;u=false;ir=null;is=1;id=24;sh=0;sk=0;mo=null")
