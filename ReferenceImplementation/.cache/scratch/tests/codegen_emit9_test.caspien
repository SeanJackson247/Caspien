	c_rfIndexedBase("rfIndexedBase 0 &glob rsi", 0, "&glob", "rsi", "    leaq glob(%rip), %rsi\n|ret=rsi|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfIndexedBase("rfIndexedBase 0 &a.b xmm0", 0, "&a.b", "xmm0", "    leaq a_b(%rip), %xmm0\n|ret=xmm0|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfIndexedBase("rfIndexedBase 0 %v1 rcx", 0, "%v1", "rcx", "|ret=r14|d=0;v=-1;m=2;u=true;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
