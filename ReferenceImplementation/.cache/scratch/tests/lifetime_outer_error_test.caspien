// `b` lives in the outer scope, `a2` only in the inner block: storing `ref a2` into `b` lets the borrow outlive its target. Must not compile.
import "stdlib/libc.caspien"
import "stdlib/gt/*"
struct A{@pub{ v: mut u64 }}
struct B{@pub{ a: ref some mut A }}
func main() void{
	?catch(e){ return }
	let a1 = mut ?new A{v= 1}
	let b = mut B{a= ref a1}
	if b.a.v == 1{
		let a2 = mut ?new A{v= 2}
		b.a = ref a2
	}
	unsafe extern{ printf("%llu\n", b.a.v) }
}
