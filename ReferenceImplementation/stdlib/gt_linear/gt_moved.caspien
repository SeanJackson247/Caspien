// The real "@gt_moved" -- called with the OLD address of an allocation
// that has just been moved by a realloc (the block now lives at a new
// address, and the old one was already released by realloc itself).
// Does what "@gt_destruct" does -- removes the pointer from the table
// (swap-with-last, O(1), shrinks the buffer if occupancy drops below
// half capacity) -- but NEVER frees the memory. A no-op for 'null', and
// a no-op if the pointer isn't registered at all.
//
// Uses 'match @lock ghost_table{...}', see ghost_table.caspien's own
// file-level comment. 'unsafe' is only needed around the 'realloc'
// extern call used when shrinking the table.
import "ghost_table.caspien"

@gt_moved
@pub
func gt_moved(ptr: raw imut u8) void{
	if ptr != null{
		match @lock ghost_table{
			OPEN:{
				let idx = mut 0
				let found = mut false
				let n = mut ghost_table.len
				for walk in 0..n{
					let slot = gtSlotAt(ghost_table.base, walk)
					let val = gtReadSlot(slot)
					if val == ptr{
						found = mut true
						idx = walk
						break
					}
				}
				if found{
					let lastIdx = mut (ghost_table.len - 1)
					if idx != lastIdx{
						let lastSlot = gtSlotAt(ghost_table.base, lastIdx)
						let lastVal = gtReadSlot(lastSlot)
						let targetSlot = gtSlotAt(ghost_table.base, idx)
						gtWriteSlot(targetSlot, lastVal)
					}
					ghost_table.len = mut (ghost_table.len - 1)
					if ghost_table.len < (ghost_table.capacity / 2){
						let newCapacity = mut (ghost_table.capacity / 2)
						let:<raw mut u8> newBase = null
						unsafe extern{
							newBase = realloc(ghost_table.base, newCapacity * 8)
						}
						if newBase != null{
							ghost_table.base = newBase
							ghost_table.capacity = newCapacity
						}
					}
				}
			}
			CLOSED:{
				continue
			}
		}
	}
}
