// BigInt: an arbitrary-precision signed integer, the Caspien counterpart of java.math.BigInteger as the compiler's Java code uses it.
// Sign and magnitude: `limbs` holds the magnitude as 32-bit limbs, least significant first, with no leading zero limb (zero = no limbs,
// never negative); `neg` is the sign. Every value is built through a constructor, which trims and fixes the sign, so the invariant always holds.
//
// Built with `new BigInt()` (zero), `BigInt.valueOf(s64)`, `BigInt.fromU64(u64)` or `BigInt.parse(text, radix)`. Every operation that makes a
// new number returns a fresh `owns some mut BigInt` and is `@throws` (out of memory; `divide`/`remainder`/`mod`/`parse` also throw a message).
// Methods take the receiver twice, like the other stdlib classes: `a.add(a, b)`.
//
// Java names and semantics: add subtract multiply divide (truncates toward zero) remainder (sign of the dividend) mod (non-negative, modulus
// must be positive) pow negate abs signum compareTo equals min max shiftLeft shiftRight (arithmetic: floors) bitAnd bitOr xor bitNot andNot
// (two's-complement semantics, as in Java; `and`/`or`/`not` are keywords, hence `bitAnd`/`bitOr`/`bitNot`) bitLength bitCount testBit; `toS64()` is longValue (low 64 bits, two's complement). Differences:
// shift counts and exponents are unsigned (`u64`); `toString(radix)` is `toStringRadix`. Not provided: sqrt, gcd, modPow, primes.
import "libc.caspien"
import "string.caspien"

@pub
struct BigInt{@pub{
	limbs: owns some mut dynarray(imut u32)
	neg: mut bool
}}

/** `new BigInt()` -- zero. */
@pub
@throws
impl constructor for BigInt() self{
	?catch(e){ throw e }
	let l = mut ? dyn:<u32>([])
	return BigInt{limbs= l, neg= mut false}
}

/** `new BigInt(limbs, negative)` -- adopts a magnitude (least significant limb first); leading zero limbs are cut and a zero is never negative. */
@pub
@throws
impl constructor for BigInt(arr: owns some mut dynarray(imut u32), negative: mut bool) self{
	?catch(e){ throw e }
	let n = mut len(arr)
	let sig = mut 0
	for i in 0..n{
		match i in arr{
			if arr[i] != 0{
				sig = i + 1
			}
		}
	}
	let:<mut u32> zero = mut 0
	let cut = mut ? resize(arr, sig, zero)
	let sign = mut negative
	if sig == 0{
		sign = mut false
	}
	return BigInt{limbs= cut, neg= sign}
}

/** Limb `i` of the magnitude as a u64 (0 past the end). */
func bigintLimb(a: ref some imut BigInt, i: mut u64) mut u64{
	match i in a.limbs{
		let v = mut a.limbs[i]
		return v as u64
	}
	return 0
}

/** A zero-filled limb array of `n` limbs. */
@throws
func bigintZeros(n: mut u64) owns some mut dynarray(imut u32){
	?catch(e){ throw e }
	let seed = mut ? dyn:<u32>([])
	let:<mut u32> zero = mut 0
	let r = mut ? resize(seed, n, zero)
	return r
}

/** Compares magnitudes: -1, 0 or 1. */
func bigintCmpMag(a: ref some imut BigInt, b: ref some imut BigInt) mut s64{
	let na = mut len(a.limbs)
	let nb = mut len(b.limbs)
	if na > nb{ return 1 }
	if na < nb{ return -1 }
	for k in 0..na{
		let i = mut (na - 1 - k)
		let x = mut bigintLimb(a, i)
		let y = mut bigintLimb(b, i)
		if x > y{ return 1 }
		if x < y{ return -1 }
	}
	return 0
}

/** |a| + |b| as a limb array (one limb longer than the longer operand). */
@throws
func bigintAddMag(a: ref some imut BigInt, b: ref some imut BigInt) owns some mut dynarray(imut u32){
	?catch(e){ throw e }
	let na = mut len(a.limbs)
	let nb = mut len(b.limbs)
	let n = mut na
	if nb > n{ n = nb }
	let size = mut (n + 1)
	let r = mut ? bigintZeros(size)
	let:<mut u64> carry = mut 0
	for i in 0..n{
		let s = mut (bigintLimb(a, i) + bigintLimb(b, i) + carry)
		carry = bits_right(s, 32)
		let lo = mut bits_and(s, 4294967295)
		match i into r{
			r[i] = wrap:<u32>(lo)
		}
	}
	match n into r{
		r[n] = wrap:<u32>(carry)
	}
	return r
}

/** |a| - |b| as a limb array; the caller guarantees |a| >= |b|. */
@throws
func bigintSubMag(a: ref some imut BigInt, b: ref some imut BigInt) owns some mut dynarray(imut u32){
	?catch(e){ throw e }
	let n = mut len(a.limbs)
	let r = mut ? bigintZeros(n)
	let:<mut u64> borrow = mut 0
	for i in 0..n{
		let x = mut bigintLimb(a, i)
		let y = mut (bigintLimb(b, i) + borrow)
		let:<mut u64> d = mut 0
		if x >= y{
			d = x - y
			borrow = 0
		}
		else{
			d = x + 4294967296 - y
			borrow = 1
		}
		match i into r{
			r[i] = wrap:<u32>(d)
		}
	}
	return r
}

/** |a| * |b| as a limb array (na + nb limbs). */
@throws
func bigintMulMag(a: ref some imut BigInt, b: ref some imut BigInt) owns some mut dynarray(imut u32){
	?catch(e){ throw e }
	let na = mut len(a.limbs)
	let nb = mut len(b.limbs)
	let size = mut (na + nb)
	let r = mut ? bigintZeros(size)
	for i in 0..na{
		let ai = mut bigintLimb(a, i)
		let:<mut u64> carry = mut 0
		for j in 0..nb{
			let k = mut (i + j)
			let bj = mut bigintLimb(b, j)
			match k into r{
				let cur = mut (r[k] as u64)
				let t = mut (cur + ai * bj + carry)
				carry = bits_right(t, 32)
				let lo = mut bits_and(t, 4294967295)
				r[k] = wrap:<u32>(lo)
			}
		}
		let top = mut (i + nb)
		match top into r{
			r[top] = wrap:<u32>(carry)
		}
	}
	return r
}

/** (|a| * m + add) as a limb array, for small `m` and `add` (below 2^32). */
@throws
func bigintMulAddSmall(a: ref some imut BigInt, m: mut u64, add: mut u64) owns some mut dynarray(imut u32){
	?catch(e){ throw e }
	let n = mut len(a.limbs)
	let size = mut (n + 1)
	let r = mut ? bigintZeros(size)
	let:<mut u64> carry = mut add
	for i in 0..n{
		let t = mut (bigintLimb(a, i) * m + carry)
		carry = bits_right(t, 32)
		let lo = mut bits_and(t, 4294967295)
		match i into r{
			r[i] = wrap:<u32>(lo)
		}
	}
	match n into r{
		r[n] = wrap:<u32>(carry)
	}
	return r
}

/** |a| / d for a small divisor d (1 .. 2^32-1) as a limb array. */
@throws
func bigintDivSmall(a: ref some imut BigInt, d: mut u64) owns some mut dynarray(imut u32){
	?catch(e){ throw e }
	let n = mut len(a.limbs)
	let r = mut ? bigintZeros(n)
	let:<mut u64> rem = mut 0
	match d != 0{
		for k in 0..n{
			let i = mut (n - 1 - k)
			let cur = mut (bits_left(rem, 32) + bigintLimb(a, i))
			let q = mut (cur / d)
			rem = cur - q * d
			match i into r{
				r[i] = wrap:<u32>(q)
			}
		}
	}
	return r
}

/** |a| mod d for a small divisor d (1 .. 2^32-1). */
func bigintModSmall(a: ref some imut BigInt, d: mut u64) mut u64{
	let n = mut len(a.limbs)
	let:<mut u64> rem = mut 0
	match d != 0{
		for k in 0..n{
			let i = mut (n - 1 - k)
			let cur = mut (bits_left(rem, 32) + bigintLimb(a, i))
			rem = cur % d
		}
	}
	return rem
}

/** The number of leading zero bits of the 32-bit value `x` (32 for 0). */
func bigintNlz(x: mut u64) mut u64{
	let:<mut u64> c = mut 0
	for k in 0..32{
		let i = mut (31 - k)
		if bits_and(bits_right(x, i), 1) == 1{
			break
		}
		c = c + 1
	}
	return c
}

/** A copy of |a|'s limbs. */
@throws
func bigintCopyMag(a: ref some imut BigInt) owns some mut dynarray(imut u32){
	?catch(e){ throw e }
	let n = mut len(a.limbs)
	let r = mut ? bigintZeros(n)
	for i in 0..n{
		let v = mut bigintLimb(a, i)
		match i into r{
			r[i] = wrap:<u32>(v)
		}
	}
	return r
}

/** Limb `i` of |x| shifted left by `s` bits (0 <= s < 32), truncated to 32 bits: reads limbs i and i-1. */
func bigintShiftedLimb(x: ref some imut BigInt, i: mut u64, s: mut u64) mut u64{
	let hi = mut bigintLimb(x, i)
	let:<mut u64> lo = mut 0
	if i >= 1{
		lo = bigintLimb(x, i - 1)
	}
	let inv = mut (32 - s)
	return bits_and(bits_or(bits_left(hi, s), bits_right(lo, inv)), 4294967295)
}

/** |a| << k as a limb array. */
@throws
func bigintShlMag(a: ref some imut BigInt, k: mut u64) owns some mut dynarray(imut u32){
	?catch(e){ throw e }
	let ls = mut bits_right(k, 5)
	let bs = mut bits_and(k, 31)
	let na = mut len(a.limbs)
	let size = mut (na + ls + 1)
	let r = mut ? bigintZeros(size)
	for j in 0..size{
		if j >= ls{
			let src = mut (j - ls)
			let w = mut bigintShiftedLimb(a, src, bs)
			match j into r{
				r[j] = wrap:<u32>(w)
			}
		}
	}
	return r
}

/** |a| >> k (truncating the magnitude) as a limb array. */
@throws
func bigintShrMag(a: ref some imut BigInt, k: mut u64) owns some mut dynarray(imut u32){
	?catch(e){ throw e }
	let ls = mut bits_right(k, 5)
	let bs = mut bits_and(k, 31)
	let na = mut len(a.limbs)
	let:<mut u64> size = mut 0
	if ls < na{
		size = na - ls
	}
	let r = mut ? bigintZeros(size)
	let inv = mut (32 - bs)
	for j in 0..size{
		let lo = mut bigintLimb(a, j + ls)
		let hi = mut bigintLimb(a, j + ls + 1)
		let w = mut bits_and(bits_or(bits_right(lo, bs), bits_left(hi, inv)), 4294967295)
		match j into r{
			r[j] = wrap:<u32>(w)
		}
	}
	return r
}

/** |a| / |b| (quotient) or |a| mod |b| (when `wantRem`) as a limb array; |b| must not be zero. Knuth's algorithm D on 32-bit limbs. */
@throws
func bigintDivMag(a: ref some imut BigInt, b: ref some imut BigInt, wantRem: mut bool) owns some mut dynarray(imut u32){
	?catch(e){ throw e }
	let na = mut len(a.limbs)
	let nb = mut len(b.limbs)
	if bigintCmpMag(a, b) < 0{
		if wantRem{
			let same = mut ? bigintCopyMag(a)
			return same
		}
		let none = mut ? bigintZeros(0)
		return none
	}
	if nb == 1{
		let d = mut bigintLimb(b, 0)
		if wantRem{
			let m = mut bigintModSmall(a, d)
			let one = mut ? bigintZeros(1)
			match 0 into one{
				one[0] = wrap:<u32>(m)
			}
			return one
		}
		let qs = mut ? bigintDivSmall(a, d)
		return qs
	}
	let top = mut bigintLimb(b, nb - 1)
	let s = mut bigintNlz(top)
	let inv = mut (32 - s)
	let usize = mut (na + 1)
	let un = mut ? bigintZeros(usize)
	let vn = mut ? bigintZeros(nb)
	for i in 0..nb{
		let w = mut bigintShiftedLimb(b, i, s)
		match i into vn{
			vn[i] = wrap:<u32>(w)
		}
	}
	for i in 0..usize{
		let w = mut bigintShiftedLimb(a, i, s)
		match i into un{
			un[i] = wrap:<u32>(w)
		}
	}
	let m = mut (na - nb)
	let qsize = mut (m + 1)
	let q = mut ? bigintZeros(qsize)
	let vtopIdx = mut (nb - 1)
	let vsecIdx = mut (nb - 2)
	let:<mut u64> vtop = mut 0
	let:<mut u64> vsec = mut 0
	match vtopIdx in vn{
		vtop = vn[vtopIdx] as u64
	}
	match vsecIdx in vn{
		vsec = vn[vsecIdx] as u64
	}
	for kk in 0..qsize{
		let j = mut (m - kk)
		let hiIdx = mut (j + nb)
		let loIdx = mut (j + nb - 1)
		let lo2Idx = mut (j + nb - 2)
		let:<mut u64> uHi = mut 0
		let:<mut u64> uLo = mut 0
		let:<mut u64> uLo2 = mut 0
		match hiIdx in un{
			uHi = un[hiIdx] as u64
		}
		match loIdx in un{
			uLo = un[loIdx] as u64
		}
		match lo2Idx in un{
			uLo2 = un[lo2Idx] as u64
		}
		let num = mut (bits_left(uHi, 32) + uLo)
		let:<mut u64> qhat = mut 0
		let:<mut u64> rhat = mut 0
		match vtop != 0{
			qhat = num / vtop
			rhat = num - qhat * vtop
		}
		let:<mut bool> stop = mut false
		for fix in 0..2{
			if stop == false{
				if qhat >= 4294967296 || qhat * vsec > bits_left(rhat, 32) + uLo2{
					qhat = qhat - 1
					rhat = rhat + vtop
					if rhat >= 4294967296{
						stop = true
					}
				}
				else{
					stop = true
				}
			}
		}
		let:<mut u64> carryM = mut 0
		let:<mut u64> borrow = mut 0
		for i in 0..nb{
			let vi = mut 0
			let vIdx = mut i
			match vIdx in vn{
				vi = vn[vIdx] as u64
			}
			let p = mut (qhat * vi + carryM)
			carryM = bits_right(p, 32)
			let sub = mut bits_and(p, 4294967295)
			let idx = mut (j + i)
			match idx into un{
				let cur = mut (un[idx] as u64)
				let y = mut (sub + borrow)
				let:<mut u64> res = mut 0
				if cur >= y{
					res = cur - y
					borrow = 0
				}
				else{
					res = cur + 4294967296 - y
					borrow = 1
				}
				un[idx] = wrap:<u32>(res)
			}
		}
		let:<mut bool> negative = mut false
		match hiIdx into un{
			let cur = mut (un[hiIdx] as u64)
			let y = mut (carryM + borrow)
			let:<mut u64> res = mut 0
			if cur >= y{
				res = cur - y
			}
			else{
				res = cur + 4294967296 - y
				negative = true
			}
			un[hiIdx] = wrap:<u32>(res)
		}
		if negative{
			qhat = qhat - 1
			let:<mut u64> carryA = mut 0
			for i in 0..nb{
				let vi = mut 0
				let vIdx = mut i
				match vIdx in vn{
					vi = vn[vIdx] as u64
				}
				let idx = mut (j + i)
				match idx into un{
					let t = mut (un[idx] as u64 + vi + carryA)
					carryA = bits_right(t, 32)
					let lo = mut bits_and(t, 4294967295)
					un[idx] = wrap:<u32>(lo)
				}
			}
			match hiIdx into un{
				let t = mut (un[hiIdx] as u64 + carryA)
				let lo = mut bits_and(t, 4294967295)
				un[hiIdx] = wrap:<u32>(lo)
			}
		}
		match j into q{
			q[j] = wrap:<u32>(qhat)
		}
	}
	if wantRem{
		let r = mut ? bigintZeros(nb)
		for i in 0..nb{
			let lo = mut 0
			let hi = mut 0
			let a0 = mut i
			let a1 = mut (i + 1)
			match a0 in un{
				lo = un[a0] as u64
			}
			match a1 in un{
				hi = un[a1] as u64
			}
			let w = mut bits_and(bits_or(bits_right(lo, s), bits_left(hi, inv)), 4294967295)
			match i into r{
				r[i] = wrap:<u32>(w)
			}
		}
		return r
	}
	return q
}

/** The digit character table is `bigintDigitChar`/`bigintDigitValue`. */
/** The value of the digit character `c` (0-9, a-z, A-Z), or 99 when `c` is not a digit. */
func bigintDigitValue(c: mut char) mut u64{
	if c == '0'{ return 0 }
	if c == '1'{ return 1 }
	if c == '2'{ return 2 }
	if c == '3'{ return 3 }
	if c == '4'{ return 4 }
	if c == '5'{ return 5 }
	if c == '6'{ return 6 }
	if c == '7'{ return 7 }
	if c == '8'{ return 8 }
	if c == '9'{ return 9 }
	if c == 'a'{ return 10 }
	if c == 'b'{ return 11 }
	if c == 'c'{ return 12 }
	if c == 'd'{ return 13 }
	if c == 'e'{ return 14 }
	if c == 'f'{ return 15 }
	if c == 'g'{ return 16 }
	if c == 'h'{ return 17 }
	if c == 'i'{ return 18 }
	if c == 'j'{ return 19 }
	if c == 'k'{ return 20 }
	if c == 'l'{ return 21 }
	if c == 'm'{ return 22 }
	if c == 'n'{ return 23 }
	if c == 'o'{ return 24 }
	if c == 'p'{ return 25 }
	if c == 'q'{ return 26 }
	if c == 'r'{ return 27 }
	if c == 's'{ return 28 }
	if c == 't'{ return 29 }
	if c == 'u'{ return 30 }
	if c == 'v'{ return 31 }
	if c == 'w'{ return 32 }
	if c == 'x'{ return 33 }
	if c == 'y'{ return 34 }
	if c == 'z'{ return 35 }
	if c == 'A'{ return 10 }
	if c == 'B'{ return 11 }
	if c == 'C'{ return 12 }
	if c == 'D'{ return 13 }
	if c == 'E'{ return 14 }
	if c == 'F'{ return 15 }
	if c == 'G'{ return 16 }
	if c == 'H'{ return 17 }
	if c == 'I'{ return 18 }
	if c == 'J'{ return 19 }
	if c == 'K'{ return 20 }
	if c == 'L'{ return 21 }
	if c == 'M'{ return 22 }
	if c == 'N'{ return 23 }
	if c == 'O'{ return 24 }
	if c == 'P'{ return 25 }
	if c == 'Q'{ return 26 }
	if c == 'R'{ return 27 }
	if c == 'S'{ return 28 }
	if c == 'T'{ return 29 }
	if c == 'U'{ return 30 }
	if c == 'V'{ return 31 }
	if c == 'W'{ return 32 }
	if c == 'X'{ return 33 }
	if c == 'Y'{ return 34 }
	if c == 'Z'{ return 35 }
	return 99
}

/** The character for digit value `d` (0-35); '?' when `d` is larger. */
func bigintDigitChar(d: mut u64) mut char{
	if d == 0{ return '0' }
	if d == 1{ return '1' }
	if d == 2{ return '2' }
	if d == 3{ return '3' }
	if d == 4{ return '4' }
	if d == 5{ return '5' }
	if d == 6{ return '6' }
	if d == 7{ return '7' }
	if d == 8{ return '8' }
	if d == 9{ return '9' }
	if d == 10{ return 'a' }
	if d == 11{ return 'b' }
	if d == 12{ return 'c' }
	if d == 13{ return 'd' }
	if d == 14{ return 'e' }
	if d == 15{ return 'f' }
	if d == 16{ return 'g' }
	if d == 17{ return 'h' }
	if d == 18{ return 'i' }
	if d == 19{ return 'j' }
	if d == 20{ return 'k' }
	if d == 21{ return 'l' }
	if d == 22{ return 'm' }
	if d == 23{ return 'n' }
	if d == 24{ return 'o' }
	if d == 25{ return 'p' }
	if d == 26{ return 'q' }
	if d == 27{ return 'r' }
	if d == 28{ return 's' }
	if d == 29{ return 't' }
	if d == 30{ return 'u' }
	if d == 31{ return 'v' }
	if d == 32{ return 'w' }
	if d == 33{ return 'x' }
	if d == 34{ return 'y' }
	if d == 35{ return 'z' }
	return '?'
}

/** Whether `a op b` is negative, from the two signs. */
func bigintBitopSign(an: mut bool, bn: mut bool, op: mut u64) mut bool{
	if op == 0{ return an && bn }
	if op == 1{ return an || bn }
	if op == 2{ return an != bn }
	return an && (bn == false)
}

/** Number of trailing zero bits of |x| (0 for zero). */
func bigintTz(x: ref some imut BigInt) mut u64{
	let n = mut len(x.limbs)
	let:<mut u64> count = mut 0
	for i in 0..n{
		let v = mut bigintLimb(x, i)
		if v == 0{
			count = count + 32
		}
		else{
			let low = mut (32 - bigintNlz(bits_and(v, 0 - v)) - 1)
			return count + low
		}
	}
	return count
}

/** The two's-complement form of x in `n` limbs (sign-extended; n must exceed the magnitude's limbs). */
@throws
func bigintTwos(x: ref some imut BigInt, n: mut u64) owns some mut dynarray(imut u32){
	?catch(e){ throw e }
	let t = mut ? bigintZeros(n)
	let neg = mut x.neg
	let:<mut u64> carry = mut 1
	for i in 0..n{
		let v = mut bigintLimb(x, i)
		let:<mut u64> w = mut v
		if neg{
			let inv = mut (bits_and(bits_not(v), 4294967295) + carry)
			carry = bits_right(inv, 32)
			w = bits_and(inv, 4294967295)
		}
		match i into t{
			t[i] = wrap:<u32>(w)
		}
	}
	return t
}

/** |a op b| in two's complement, op 0 = and, 1 = or, 2 = xor, 3 = andNot (the sign is `bigintBitopSign`). */
@throws
func bigintBitopMag(a: ref some imut BigInt, b: ref some imut BigInt, op: mut u64) owns some mut dynarray(imut u32){
	?catch(e){ throw e }
	let na = mut len(a.limbs)
	let nb = mut len(b.limbs)
	let n = mut na
	if nb > n{ n = nb }
	n = n + 1
	let ta = mut ? bigintTwos(a, n)
	let tb = mut ? bigintTwos(b, n)
	let t = mut ? bigintZeros(n)
	let:<mut u64> last = mut 0
	for i in 0..n{
		let:<mut u64> x = mut 0
		let:<mut u64> y = mut 0
		match i in ta{
			x = ta[i] as u64
		}
		match i in tb{
			y = tb[i] as u64
		}
		let:<mut u64> r = mut 0
		if op == 0{ r = bits_and(x, y) }
		if op == 1{ r = bits_or(x, y) }
		if op == 2{ r = bits_xor(x, y) }
		if op == 3{ r = bits_and(x, bits_and(bits_not(y), 4294967295)) }
		last = r
		match i into t{
			t[i] = wrap:<u32>(r)
		}
	}
	if bits_and(bits_right(last, 31), 1) == 1{
		let r2 = mut ? bigintZeros(n)
		let:<mut u64> carry = mut 1
		for i in 0..n{
			let:<mut u64> ti = mut 0
			match i in t{
				ti = t[i] as u64
			}
			let v = mut (bits_and(bits_not(ti), 4294967295) + carry)
			carry = bits_right(v, 32)
			let lo = mut bits_and(v, 4294967295)
			match i into r2{
				r2[i] = wrap:<u32>(lo)
			}
		}
		return r2
	}
	return t
}

/** The number of bits in |x| (0 for zero). */
func bigintBitLenMag(x: ref some imut BigInt) mut u64{
	let n = mut len(x.limbs)
	if n == 0{ return 0 }
	let top = mut bigintLimb(x, n - 1)
	return (n - 1) * 32 + (32 - bigintNlz(top))
}

/** The number of one bits in |x|. */
func bigintPopMag(x: ref some imut BigInt) mut u64{
	let n = mut len(x.limbs)
	let:<mut u64> count = mut 0
	for i in 0..n{
		let v = mut bigintLimb(x, i)
		for k in 0..32{
			count = count + bits_and(bits_right(v, k), 1)
		}
	}
	return count
}

@pub
impl BigInt{
	/** The number with value `v`. */
	@pub
	@throws
	static func valueOf(v: mut s64) owns some mut BigInt{
		?catch(e){ throw e }
		let:<mut u64> u = mut wrap:<u64>(v)
		if v < 0{
			u = 0 - u
		}
		let arr = mut ? bigintZeros(2)
		let lo = mut bits_and(u, 4294967295)
		let hi = mut bits_right(u, 32)
		match 0 into arr{
			arr[0] = wrap:<u32>(lo)
		}
		match 1 into arr{
			arr[1] = wrap:<u32>(hi)
		}
		let r = mut ? new BigInt(arr, v < 0)
		return r
	}

	/** The number with the unsigned value `v`. */
	@pub
	@throws
	static func fromU64(v: mut u64) owns some mut BigInt{
		?catch(e){ throw e }
		let arr = mut ? bigintZeros(2)
		let lo = mut bits_and(v, 4294967295)
		let hi = mut bits_right(v, 32)
		match 0 into arr{
			arr[0] = wrap:<u32>(lo)
		}
		match 1 into arr{
			arr[1] = wrap:<u32>(hi)
		}
		let r = mut ? new BigInt(arr, mut false)
		return r
	}

	/** Parses an optionally signed number (`-`/`+`, then digits 0-9 a-z A-Z below `radix`, 2..36). Throws on an empty or invalid text. */
	@pub
	@throws
	static func parse(text: static imut string, radix: mut u64) owns some mut BigInt{
		?catch(e){ throw e }
		if radix < 2{ throw "BigInt: radix out of range" }
		if radix > 36{ throw "BigInt: radix out of range" }
		// the digit group: the largest power of the radix below 2^32
		let:<mut u64> chunkPow = mut radix
		let:<mut u64> chunkLen = mut 1
		for step in 0..32{
			if chunkPow * radix <= 4294967295{
				chunkPow = chunkPow * radix
				chunkLen = chunkLen + 1
			}
		}
		let a = mut ? dyn(text)
		let n = mut len(a)
		let cur = mut ? new BigInt()
		let:<mut bool> negative = mut false
		let:<mut u64> acc = mut 0
		let:<mut u64> pw = mut 1
		let:<mut u64> cnt = mut 0
		let:<mut u64> total = mut 0
		for i in 0..n{
			match i in a{
				let c = mut a[i]
				let:<mut bool> sign = mut false
				if i == 0{
					if c == '-'{
						negative = true
						sign = true
					}
					if c == '+'{
						sign = true
					}
				}
				if sign == false{
					let d = mut bigintDigitValue(c)
					if d >= radix{ throw "BigInt: invalid digit" }
					acc = acc * radix + d
					pw = pw * radix
					cnt = cnt + 1
					total = total + 1
					if cnt == chunkLen{
						let arr = mut ? bigintMulAddSmall(cur, pw, acc)
						let nxt = mut ? new BigInt(arr, mut false)
						cur = nxt
						acc = 0
						pw = 1
						cnt = 0
					}
				}
			}
		}
		if total == 0{ throw "BigInt: no digits" }
		if cnt > 0{
			let arr2 = mut ? bigintMulAddSmall(cur, pw, acc)
			let nxt2 = mut ? new BigInt(arr2, mut false)
			cur = nxt2
		}
		let out = mut ? bigintCopyMag(cur)
		let r = mut ? new BigInt(out, negative)
		return r
	}

	@pub
	func signum(_self: ref some imut self) mut s64{
		if len(_self.limbs) == 0{ return 0 }
		if _self.neg{ return -1 }
		return 1
	}

	@pub
	func isZero(_self: ref some imut self) mut bool{
		return len(_self.limbs) == 0
	}

	/** -1, 0 or 1 as `_self` is less than, equal to or greater than `other`. */
	@pub
	func compareTo(_self: ref some imut self, other: ref some imut BigInt) mut s64{
		if _self.neg != other.neg{
			if _self.neg{ return -1 }
			return 1
		}
		let c = mut bigintCmpMag(_self, other)
		if _self.neg{
			return 0 - c
		}
		return c
	}

	@pub
	func equals(_self: ref some imut self, other: ref some imut BigInt) mut bool{
		if _self.neg != other.neg{ return mut false }
		return bigintCmpMag(_self, other) == 0
	}

	@pub
	@throws
	func negate(_self: ref some imut self) owns some mut BigInt{
		?catch(e){ throw e }
		let arr = mut ? bigintCopyMag(_self)
		let r = mut ? new BigInt(arr, _self.neg == false)
		return r
	}

	@pub
	@throws
	func abs(_self: ref some imut self) owns some mut BigInt{
		?catch(e){ throw e }
		let arr = mut ? bigintCopyMag(_self)
		let r = mut ? new BigInt(arr, mut false)
		return r
	}

	@pub
	@throws
	func add(_self: ref some imut self, other: ref some imut BigInt) owns some mut BigInt{
		?catch(e){ throw e }
		let sn = mut _self.neg
		let on = mut other.neg
		let c = mut bigintCmpMag(_self, other)
		let arr = mut ? bigintZeros(0)
		let sign = mut false
		if sn == on{
			let t = mut ? bigintAddMag(_self, other)
			arr = t
			sign = sn
		}
		else{
			if c >= 0{
				let t2 = mut ? bigintSubMag(_self, other)
				arr = t2
				sign = sn
			}
			else{
				let t3 = mut ? bigintSubMag(other, _self)
				arr = t3
				sign = on
			}
		}
		let r = mut ? new BigInt(arr, sign)
		return r
	}

	@pub
	@throws
	func subtract(_self: ref some imut self, other: ref some imut BigInt) owns some mut BigInt{
		?catch(e){ throw e }
		let sn = mut _self.neg
		let on = mut other.neg
		let c = mut bigintCmpMag(_self, other)
		let arr = mut ? bigintZeros(0)
		let sign = mut false
		if sn != on{
			let t = mut ? bigintAddMag(_self, other)
			arr = t
			sign = sn
		}
		else{
			if c >= 0{
				let t2 = mut ? bigintSubMag(_self, other)
				arr = t2
				sign = sn
			}
			else{
				let t3 = mut ? bigintSubMag(other, _self)
				arr = t3
				sign = sn == false
			}
		}
		let r = mut ? new BigInt(arr, sign)
		return r
	}

	@pub
	@throws
	func multiply(_self: ref some imut self, other: ref some imut BigInt) owns some mut BigInt{
		?catch(e){ throw e }
		let arr = mut ? bigintMulMag(_self, other)
		let r = mut ? new BigInt(arr, _self.neg != other.neg)
		return r
	}

	/** Quotient truncated toward zero. Throws on a zero divisor. */
	@pub
	@throws
	func divide(_self: ref some imut self, other: ref some imut BigInt) owns some mut BigInt{
		?catch(e){ throw e }
		if len(other.limbs) == 0{ throw "BigInt: division by zero" }
		let arr = mut ? bigintDivMag(_self, other, mut false)
		let r = mut ? new BigInt(arr, _self.neg != other.neg)
		return r
	}

	/** The remainder, with the sign of the dividend (Java's `remainder`). Throws on a zero divisor. */
	@pub
	@throws
	func remainder(_self: ref some imut self, other: ref some imut BigInt) owns some mut BigInt{
		?catch(e){ throw e }
		if len(other.limbs) == 0{ throw "BigInt: division by zero" }
		let arr = mut ? bigintDivMag(_self, other, mut true)
		let r = mut ? new BigInt(arr, _self.neg)
		return r
	}

	/** The non-negative remainder; the modulus must be positive (Java's `mod`). */
	@pub
	@throws
	func mod(_self: ref some imut self, m: ref some imut BigInt) owns some mut BigInt{
		?catch(e){ throw e }
		if len(m.limbs) == 0{ throw "BigInt: modulus not positive" }
		if m.neg{ throw "BigInt: modulus not positive" }
		let remArr = mut ? bigintDivMag(_self, m, mut true)
		let modArr = mut ? bigintCopyMag(m)
		let negative = mut _self.neg
		let rem = mut ? new BigInt(remArr, negative)
		if rem.neg{
			let mm = mut ? new BigInt(modArr, mut false)
			let fixed = mut ? mm.add(mm, rem)
			return fixed
		}
		return rem
	}

	/** `_self` to the power `e`. */
	@pub
	@throws
	func pow(_self: ref some imut self, e: mut u64) owns some mut BigInt{
		?catch(e2){ throw e2 }
		let arr = mut ? bigintCopyMag(_self)
		let negative = mut _self.neg
		let result = mut ? BigInt.valueOf(1)
		let base = mut ? new BigInt(arr, negative)
		for step in 0..64{
			if bits_right(e, step) != 0{
				if bits_and(bits_right(e, step), 1) == 1{
					let nr = mut ? result.multiply(result, base)
					result = nr
				}
				if bits_right(e, step + 1) != 0{
					let nb = mut ? base.multiply(base, base)
					base = nb
				}
			}
		}
		return result
	}

	@pub
	@throws
	func min(_self: ref some imut self, other: ref some imut BigInt) owns some mut BigInt{
		?catch(e){ throw e }
		let c = mut _self.compareTo(_self, other)
		let arr = mut ? bigintZeros(0)
		let sign = mut false
		if c <= 0{
			let t = mut ? bigintCopyMag(_self)
			arr = t
			sign = _self.neg
		}
		else{
			let t2 = mut ? bigintCopyMag(other)
			arr = t2
			sign = other.neg
		}
		let r = mut ? new BigInt(arr, sign)
		return r
	}

	@pub
	@throws
	func max(_self: ref some imut self, other: ref some imut BigInt) owns some mut BigInt{
		?catch(e){ throw e }
		let c = mut _self.compareTo(_self, other)
		let arr = mut ? bigintZeros(0)
		let sign = mut false
		if c >= 0{
			let t = mut ? bigintCopyMag(_self)
			arr = t
			sign = _self.neg
		}
		else{
			let t2 = mut ? bigintCopyMag(other)
			arr = t2
			sign = other.neg
		}
		let r = mut ? new BigInt(arr, sign)
		return r
	}

	@pub
	@throws
	func shiftLeft(_self: ref some imut self, n: mut u64) owns some mut BigInt{
		?catch(e){ throw e }
		let arr = mut ? bigintShlMag(_self, n)
		let r = mut ? new BigInt(arr, _self.neg)
		return r
	}

	/** Arithmetic shift right: floors, so a negative number rounds toward minus infinity (Java's `shiftRight`). */
	@pub
	@throws
	func shiftRight(_self: ref some imut self, n: mut u64) owns some mut BigInt{
		?catch(e){ throw e }
		let neg = mut _self.neg
		let inexact = mut (neg && bigintTz(_self) < n)
		let arr = mut ? bigintShrMag(_self, n)
		let shifted = mut ? new BigInt(arr, mut false)
		if inexact{
			// -(ceil(m / 2^n)): one more than the truncated magnitude when low bits were lost
			let up = mut ? bigintMulAddSmall(shifted, 1, 1)
			let r = mut ? new BigInt(up, mut true)
			return r
		}
		if neg{
			shifted.neg = mut true
		}
		return shifted
	}

	@pub
	@throws
	func bitAnd(_self: ref some imut self, other: ref some imut BigInt) owns some mut BigInt{
		?catch(e){ throw e }
		let arr = mut ? bigintBitopMag(_self, other, mut 0)
		let sign = mut bigintBitopSign(_self.neg, other.neg, mut 0)
		let r = mut ? new BigInt(arr, sign)
		return r
	}

	@pub
	@throws
	func bitOr(_self: ref some imut self, other: ref some imut BigInt) owns some mut BigInt{
		?catch(e){ throw e }
		let arr = mut ? bigintBitopMag(_self, other, mut 1)
		let sign = mut bigintBitopSign(_self.neg, other.neg, mut 1)
		let r = mut ? new BigInt(arr, sign)
		return r
	}

	@pub
	@throws
	func xor(_self: ref some imut self, other: ref some imut BigInt) owns some mut BigInt{
		?catch(e){ throw e }
		let arr = mut ? bigintBitopMag(_self, other, mut 2)
		let sign = mut bigintBitopSign(_self.neg, other.neg, mut 2)
		let r = mut ? new BigInt(arr, sign)
		return r
	}

	@pub
	@throws
	func andNot(_self: ref some imut self, other: ref some imut BigInt) owns some mut BigInt{
		?catch(e){ throw e }
		let arr = mut ? bigintBitopMag(_self, other, mut 3)
		let sign = mut bigintBitopSign(_self.neg, other.neg, mut 3)
		let r = mut ? new BigInt(arr, sign)
		return r
	}

	/** -_self - 1. */
	@pub
	@throws
	func bitNot(_self: ref some imut self) owns some mut BigInt{
		?catch(e){ throw e }
		let neg = mut ? _self.negate(_self)
		let one = mut ? BigInt.valueOf(1)
		let r = mut ? neg.subtract(neg, one)
		return r
	}

	/** The minimal two's-complement length without the sign bit (Java's `bitLength`). */
	@pub
	func bitLength(_self: ref some imut self) mut u64{
		let bits = mut bigintBitLenMag(_self)
		if _self.neg{
			// -2^k needs k bits, any other negative number as many as its magnitude
			if bigintPopMag(_self) == 1{
				return bits - 1
			}
		}
		return bits
	}

	/** The number of bits that differ from the sign bit (Java's `bitCount`). */
	@pub
	func bitCount(_self: ref some imut self) mut u64{
		let pop = mut bigintPopMag(_self)
		if _self.neg{
			// popcount(|x| - 1) = popcount(|x|) - 1 + trailing zeros of |x|
			return pop - 1 + bigintTz(_self)
		}
		return pop
	}

	/** Bit `n` of the two's-complement form. */
	@pub
	func testBit(_self: ref some imut self, n: mut u64) mut bool{
		let idx = mut bits_right(n, 5)
		let sh = mut bits_and(n, 31)
		let w = mut bigintLimb(_self, idx)
		let bit = mut bits_and(bits_right(w, sh), 1)
		if _self.neg{
			let tz = mut bigintTz(_self)
			if n < tz{ return mut false }
			if n == tz{ return mut true }
			return bit == 0
		}
		return bit == 1
	}

	/** The low 64 bits of the two's-complement form, as an unsigned number. */
	@pub
	func toU64(_self: ref some imut self) mut u64{
		let lo = mut bigintLimb(_self, 0)
		let hi = mut bigintLimb(_self, 1)
		let low = mut (bits_left(hi, 32) + lo)
		if _self.neg{
			return 0 - low
		}
		return low
	}

	/** The low 64 bits of the two's-complement form (Java's `longValue`). */
	@pub
	func toS64(_self: ref some imut self) mut s64{
		let u = mut _self.toU64(_self)
		return wrap:<s64>(u)
	}

	@pub
	func fitsS64(_self: ref some imut self) mut bool{
		let bits = mut bigintBitLenMag(_self)
		if bits < 64{ return mut true }
		if bits > 64{ return mut false }
		// 64 bits: only -2^63 itself (magnitude 2^63) fits
		if _self.neg == false{ return mut false }
		let n = mut len(_self.limbs)
		if bigintLimb(_self, 1) != 2147483648{ return mut false }
		return bigintLimb(_self, 0) == 0
	}

	@pub
	func fitsU64(_self: ref some imut self) mut bool{
		if _self.neg{ return mut false }
		return bigintBitLenMag(_self) <= 64
	}

	/** The digits of the number in `radix` (2..36), lower case, with a leading `-` for a negative number. */
	@pub
	@throws
	func toStringRadix(_self: ref some imut self, radix: mut u64) owns some mut String{
		?catch(e){ throw e }
		if radix < 2{ throw "BigInt: radix out of range" }
		if radix > 36{ throw "BigInt: radix out of range" }
		let na = mut len(_self.limbs)
		let negative = mut _self.neg
		let first = mut ? bigintCopyMag(_self)
		let s = mut ? new String()
		if na == 0{
			? s.appendChar(s, '0')
			return s
		}
		if negative{
			? s.appendChar(s, '-')
		}
		let:<mut u64> chunkPow = mut radix
		let:<mut u64> chunkLen = mut 1
		for step in 0..32{
			if chunkPow * radix <= 4294967295{
				chunkPow = chunkPow * radix
				chunkLen = chunkLen + 1
			}
		}
		let maxChunks = mut (na * 2 + 2)
		let cur = mut ? new BigInt(first, mut false)
		let chunks = mut ? bigintZeros(0)
		let:<mut u32> zero = mut 0
		for step in 0..maxChunks{
			if len(cur.limbs) > 0{
				let rem = mut bigintModSmall(cur, chunkPow)
				let q = mut ? bigintDivSmall(cur, chunkPow)
				let nxt = mut ? new BigInt(q, mut false)
				cur = nxt
				let cnt = mut len(chunks)
				let grown = mut (cnt + 1)
				let g = mut ? resize(chunks, grown, zero)
				chunks = g
				match cnt into chunks{
					chunks[cnt] = wrap:<u32>(rem)
				}
			}
		}
		let count = mut len(chunks)
		let:<mut bool> started = mut false
		for k in 0..count{
			let ci = mut (count - 1 - k)
			let:<mut u64> value = mut 0
			match ci in chunks{
				value = chunks[ci] as u64
			}
			let digs = mut ? bigintZeros(chunkLen)
			match radix != 0{
				for t in 0..chunkLen{
					let dv = mut (value % radix)
					value = value / radix
					match t into digs{
						digs[t] = wrap:<u32>(dv)
					}
				}
			}
			for t in 0..chunkLen{
				let idx = mut (chunkLen - 1 - t)
				let:<mut u64> d = mut 0
				match idx in digs{
					d = digs[idx] as u64
				}
				if d != 0{
					started = true
				}
				if started{
					? s.appendChar(s, bigintDigitChar(d))
				}
			}
		}
		return s
	}

	/** Decimal text. */
	@pub
	@throws
	func toString(_self: ref some imut self) owns some mut String{
		?catch(e){ throw e }
		let s = mut ? _self.toStringRadix(_self, 10)
		return s
	}
}
