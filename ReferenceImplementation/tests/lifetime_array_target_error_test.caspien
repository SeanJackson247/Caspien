// A ref into a dynarray element cannot be stored in a struct member: a resize moves the block, the address would dangle.
import "stdlib/libc.caspien"
import "stdlib/gt/*"
struct A{@pub{ v: mut u64 }}
struct Holder{@pub{ n: owns mut A }}
struct B{@pub{ a: ref some mut A }}
func main() void{
	?catch(e){ return }
	let v = mut ? dyn([Holder{n= null}])
	v = ? resize(v, 4, Holder{n= null})
	match 0 in v{
		let b = mut B{a= ref v[0].n}
	}
}
