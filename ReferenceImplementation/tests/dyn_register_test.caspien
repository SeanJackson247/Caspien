// Safe `dyn`/`dyn([..])` blocks and unsafe `unsafe dyn` blocks are registered with the ghost table; `resize` unregisters the old
// address with `gt_moved` (no free) and registers the new one only when the block moved. Checked through the table's own entry
// count: it returns to its starting value when the scope ends (a stale entry would keep it higher, a missing registration would
// leave the block unfreed -- see dyn_register_check.sh, which runs this under valgrind).
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"

let static c0 = mut 0
let static c1 = mut 0
let static c2 = mut 0
let static c3 = mut 0

func live() mut u64{
	let n = mut 0
	unsafe assume{
		assume match ghost_table.lockState : OPEN
		n = mut ghost_table.len
	}
	return n
}

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

// Returns the entry count while a safe dynarray is alive, after growing it (small, then far past any in-place growth, then
// shrinking) and the sum of its elements.
func safePart() void{
	?catch(e){ return }
	let arr = mut ?dyn:<u64>([])
	unsafe global{ c0 = live() }
	arr = ?resize(arr, 4, 3)
	arr = ?resize(arr, 200000, 5)
	unsafe global{ c1 = live() }
	arr = ?resize(arr, 2, 9)
	unsafe global{ c2 = live() }
	let sum = mut 0
	for i in 0..2{
		match i in arr{ sum += arr[i] }
	}
	unsafe global{ c3 = sum }
}

func literalPart() void{
	?catch(e){ return }
	let lit = mut ?dyn([1, 2, 3])
	unsafe global{ c0 = live() }
	lit = ?resize(lit, 100000, 7)
	unsafe global{ c1 = live() }
}

func unsafePart() void{
	unsafe global udyn{
		let u = mut unsafe dyn:<u64>([])
		c0 = live()
		u = resize(u, 3)
		u = resize(u, 300000)
		c1 = live()
		u[299999] = 5
		c2 = u[299999]
		u = resize(u, 0)
		c3 = live()
		u = resize(u, 4)
		u[3] = 11
		c2 = c2 + u[3]
	}
}

func textPart() void{
	unsafe global udyn{
		let t = mut unsafe dyn("abc")
		c0 = live()
		c1 = len(t, '\0')
		c2 = 0
		if t[1] == 'b'{ c2 = 98 }
	}
}

func main() void{
	let base = mut live()
	unsafe global{
		safePart()
		check("safe dyn registered", c0 == base + 1)
		check("safe resize keeps one entry", c1 == base + 1)
		check("safe shrink keeps one entry", c2 == base + 1)
		check("safe elements survive resize", c3 == 6)
		check("safe scope end unregisters", live() == base)
		literalPart()
		check("literal dyn registered", c0 == base + 1)
		check("literal resize keeps one entry", c1 == base + 1)
		check("literal scope end unregisters", live() == base)
		unsafePart()
		check("unsafe dyn registered", c0 == base + 1)
		check("unsafe resize keeps one entry", c1 == base + 1)
		check("unsafe element write", c2 == 16)
		check("unsafe resize to zero keeps one entry", c3 == base + 1)
		check("unsafe scope end unregisters", live() == base)
		textPart()
		check("unsafe dyn(text) registered", c0 == base + 1)
		check("unsafe dyn(text) is the bytes, NUL-terminated", c1 == 3 && c2 == 98)
		check("unsafe dyn(text) scope end unregisters", live() == base)
	}
}
