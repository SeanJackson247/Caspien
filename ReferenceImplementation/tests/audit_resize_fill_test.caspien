// `resize` with a struct-literal fill (`Holder{n= null}`): the fill is several pushes (class id, members), so the audit used to read the class id as the
// element count and priced the 100-slot resize at 2 slots. Real heap: the 100 Holder slots (1616 bytes with the header) + 100 nodes of 24 bytes.
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
struct Node{@pub{
	value: mut u64
	pad: mut u64
}}
struct Holder{@pub{ n: owns mut Node }}
func main() void{
	?catch(e){ return }
	let v = mut ? dyn([Holder{n= null}])
	v = ? resize(v, 100, Holder{n= null})
	for i in 0..100{
		let nn = mut ? new Node{value= i, pad= 0}
		match i in v{
			v[i].n = nn
		}
	}
}
