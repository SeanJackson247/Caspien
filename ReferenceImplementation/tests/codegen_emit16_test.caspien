	c_rfFloatX("rfFloatX 0 DIV 6 %y1 %y2 #5", 0, "DIV", 6, "%y1", "%y2", "#5", "    movaps %xmm6, %xmm5\n    divsd .LFC0(%rip), %xmm5\n|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
