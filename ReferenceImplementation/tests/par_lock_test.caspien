// A `par` handle is a swap-lock struct: `state` and `:resolve()` are reachable only inside `match @lock h{ OPEN:{..} }`.
// 1. polling several handles through the lock gives the right results; 2. a handle dropped without ever being resolved waits for its thread
// (the drop hook joins it): the `seen` counter written by the thread is complete by the time the scope ends.
// Expected output (model: par_lock_test.py):
// PASS results 605
// PASS dropped handles waited 8
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
import "../stdlib/par_call.caspien"
import "../stdlib/await_call.caspien"
import "../stdlib/sleep.caspien"

let static seen = mut atomic 0

@async
func scale(x: mut u64) mut u64{
	return x * 11
}

@async
func slowBump(x: mut u64) mut u64{
	let left = mut sleep(1)
	let cur = mut 0
	unsafe atomic{ cur = mut seen }
	let next = mut (cur + 1)
	unsafe atomic{ seen = next }
	return x + left
}

func report(name: static imut string, got: mut u64) void{
	unsafe extern{ printf("PASS %s %llu\n", name, got) }
}

func pollOne(n: mut u64) mut u64{
	?catch(e){ return 0 }
	let h = mut ? par scale(mut n)
	let r = mut 0
	for i in 0..100000000{
		let ready = mut false
		match @lock h{
			OPEN:{
				match h.state{
					READY:{
						ready = true
						r = h.resolve(h)
					}
					default:{ ready = false }
				}
			}
			CLOSED:default(1000)
		}
		if ready{ break }
		yield
	}
	return r
}

func dropMany() void{
	?catch(e){ return }
	for n in 0..8{
		let h = mut ? par slowBump(mut n)
		match @lock h{
			OPEN:{ }
			CLOSED:default(1000)
		}
	}
}

func main() void{
	let total = mut 0
	for n in 1..11{
		total = total + pollOne(mut n)
	}
	report("results", total)
	dropMany()
	let after = mut 0
	unsafe atomic{ after = mut seen }
	report("dropped handles waited", after)
}
