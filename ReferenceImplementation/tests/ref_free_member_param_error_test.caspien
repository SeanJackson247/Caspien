// A member ref reached through a `ref some` parameter: the callee frees the target inside the match body.
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
struct Node{@pub{ value: mut u64 }}
struct Hold{@pub{ p: ref mut Node }}
func consume(n: owns mut Node) void{ }
func g(h: ref some mut Hold, o: owns mut Node) mut u64{
	let s = mut 0
	match Some(h.p){
		consume(o)
		s = h.p.value
	}
	return s
}
func main() void{ }
