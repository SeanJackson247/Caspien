	c_emitCases4("emitCases4 0 DOT 8 False 3", 0, "DOT 8", false, 3, "    popq %rbx\n    movq %rbx, %rax\n    andq $-8, %rax\n    negq %rax\n    addq $0, %rax\n    andq $7, %rbx\n    addq %rbx, %rax\n    addq %rsp, %rax\n    movq (%rax), %rax\n    addq $8, %rsp\n    pushq %rax\n|ret=true|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_emitCases4("emitCases4 0 DOT 8 False 8", 0, "DOT 8", false, 8, "    popq %rbx\n    movq %rbx, %rax\n    andq $-8, %rax\n    negq %rax\n    addq $0, %rax\n    andq $7, %rbx\n    addq %rbx, %rax\n    addq %rsp, %rax\n    movq (%rax), %rax\n    addq $8, %rsp\n    pushq %rax\n|ret=true|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_emitCases4("emitCases4 0 DOT 8 False 12", 0, "DOT 8", false, 12, "    popq %rbx\n    movq %rbx, %rax\n    andq $-8, %rax\n    negq %rax\n    addq $8, %rax\n    andq $7, %rbx\n    addq %rbx, %rax\n    addq %rsp, %rax\n    movq (%rax), %rax\n    addq $16, %rsp\n    pushq %rax\n|ret=true|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_emitCases4("emitCases4 0 DOT 8 False 16", 0, "DOT 8", false, 16, "    popq %rbx\n    movq %rbx, %rax\n    andq $-8, %rax\n    negq %rax\n    addq $8, %rax\n    andq $7, %rbx\n    addq %rbx, %rax\n    addq %rsp, %rax\n    movq (%rax), %rax\n    addq $16, %rsp\n    pushq %rax\n|ret=true|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_emitCases4("emitCases4 0 DOT 8 False 20", 0, "DOT 8", false, 20, "    popq %rbx\n    movq %rbx, %rax\n    andq $-8, %rax\n    negq %rax\n    addq $16, %rax\n    andq $7, %rbx\n    addq %rbx, %rax\n    addq %rsp, %rax\n    movq (%rax), %rax\n    addq $24, %rsp\n    pushq %rax\n|ret=true|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_emitCases4("emitCases4 0 DOT 8 False 24", 0, "DOT 8", false, 24, "    popq %rbx\n    movq %rbx, %rax\n    andq $-8, %rax\n    negq %rax\n    addq $16, %rax\n    andq $7, %rbx\n    addq %rbx, %rax\n    addq %rsp, %rax\n    movq (%rax), %rax\n    addq $24, %rsp\n    pushq %rax\n|ret=true|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
