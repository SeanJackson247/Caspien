	c_r1("pushReg", "pushReg", "xmm0", "    pushq %xmm0\n")
	c_r1("popReg", "popReg", "xmm0", "    popq %xmm0\n")
	c_r2("movMemToReg xmm0 0", "movMemToReg", "xmm0", 0, "    movq 0(%rbp), %xmm0\n")
