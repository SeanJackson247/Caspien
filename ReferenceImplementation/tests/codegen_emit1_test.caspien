// Differential test of the converted X86Emit pushReg/popReg/movMemToReg/movRegToMem/leaMemToReg/leaGlobalToReg/storePiece against the Java originals (lines generated by gen_codegen_emit1_test.py).
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
import "../Codegen/src/main/java/caspien/codegen/codegenCaspien/x86backend/X86Backend.caspien"

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

func nb(alias: imut bool) owns mut X86Backend{
	?catch(e){ return null }
	let b = mut ? new X86Backend(CodegenTarget.LINUX_X64)
	? b.wire(b)
	if alias{
		match Some(b){ match Some(b.core){
			let k1 = mut ? String.from("g.a")
			let k2 = mut ? String.from("g.a")
			let v2 = mut ? String.from("par.ent")
			? b.core.globalAliasOffset.put(b.core.globalAliasOffset, k1, 24)
			? b.core.globalAliasParent.put(b.core.globalAliasParent, k2, v2)
		} }
	}
	return b
}

func outOf(b: ref imut X86Backend) owns mut String{
	?catch(e){ return null }
	let r = mut ? new String()
	match Some(b){ match Some(b.core){ r = ? b.core.out.substring(b.core.out, 0) } }
	return r
}

func chk(name: static imut string, got: ref imut String, want: static imut string) void{
	let ok = mut false
	match Some(got){ ok = got.equals(got, want) }
	check(name, ok)
}

func c_r1(name: static imut string, m: static imut string, reg: static imut string, want: static imut string) void{
	?catch(e){
		check(name, false)
		return
	}
	let b = mut nb(false)
	let rg = mut ? new String(reg)
	if String.literalsEqual(m, "pushReg"){
		match Some(b){ match Some(b.emit){ ? b.emit.pushReg(b.emit, rg) } }
	} else{
		match Some(b){ match Some(b.emit){ ? b.emit.popReg(b.emit, rg) } }
	}
	let o = mut outOf(b)
	chk(name, o, want)
}

func c_r2(name: static imut string, m: static imut string, reg: static imut string, off: mut s64, want: static imut string) void{
	?catch(e){
		check(name, false)
		return
	}
	let b = mut nb(false)
	let rg = mut ? new String(reg)
	if String.literalsEqual(m, "movMemToReg"){
		match Some(b){ match Some(b.emit){ ? b.emit.movMemToReg(b.emit, rg, off) } }
	} elseif String.literalsEqual(m, "movRegToMem"){
		match Some(b){ match Some(b.emit){ ? b.emit.movRegToMem(b.emit, rg, off) } }
	} else{
		match Some(b){ match Some(b.emit){ ? b.emit.leaMemToReg(b.emit, rg, off) } }
	}
	let o = mut outOf(b)
	chk(name, o, want)
}

func c_lg(name: static imut string, reg: static imut string, g: static imut string, alias: imut bool, want: static imut string) void{
	?catch(e){
		check(name, false)
		return
	}
	let b = mut nb(alias)
	let rg = mut ? new String(reg)
	let gg = mut ? new String(g)
	match Some(b){ match Some(b.emit){ ? b.emit.leaGlobalToReg(b.emit, rg, gg) } }
	let o = mut outOf(b)
	chk(name, o, want)
}

func c_sp(name: static imut string, reg: static imut string, base: static imut string, off: mut s64, w: mut s32, want: static imut string) void{
	?catch(e){
		check(name, false)
		return
	}
	let b = mut nb(false)
	let rg = mut ? new String(reg)
	let bs = mut ? new String(base)
	match Some(b){ match Some(b.emit){ ? b.emit.storePiece(b.emit, rg, bs, off, w) } }
	let o = mut outOf(b)
	chk(name, o, want)
}

func part0() void{
	c_r1("pushReg", "pushReg", "rax", "    pushq %rax\n")
	c_r1("popReg", "popReg", "rax", "    popq %rax\n")
	c_r2("movMemToReg rax 0", "movMemToReg", "rax", 0, "    movq 0(%rbp), %rax\n")
	c_r2("movRegToMem rax 0", "movRegToMem", "rax", 0, "    movq %rax, 0(%rbp)\n")
	c_r2("leaMemToReg rax 0", "leaMemToReg", "rax", 0, "    leaq 0(%rbp), %rax\n")
