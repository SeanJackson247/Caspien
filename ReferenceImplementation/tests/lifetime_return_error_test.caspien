// A struct holding a `ref some` borrows from the local it was built from; returning it would let the borrow outlive that local. Must not compile.
import "stdlib/libc.caspien"
import "stdlib/gt/*"
struct A{@pub{ v: mut u64 }}
struct B{@pub{ a: ref some mut A }}
@throws
func make() owns some mut B{
	?catch(e){ throw e }
	let a = mut ?new A{v= 1}
	let b = mut ?new B{a= ref a}
	return b
}
func main() void{
	?catch(e){ return }
	let b = mut ?make()
}
