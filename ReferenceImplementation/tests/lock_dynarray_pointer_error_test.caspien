// A lock struct may not hold a dynarray of auto.
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
enum Gate{ OPEN, CLOSED }
struct Counter{@pub{ n: mut u64 }}

@lock(match self.gate : OPEN)
struct Slot{@pub{
	swap gate: atomic mut Gate
	ps: owns mut dynarray(auto mut Counter)
}}
func main() void{
}
