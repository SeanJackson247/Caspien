// A move written with a mutability wrapper (`a = mut b`) still moves b: using b afterwards is an error (it used to be accepted, leaving two owners of one block).
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
struct World{@pub{
	ticks: mut u64
}}
func take(p: owns some mut World) void{ }
func main() void{
	?catch(e){ return }
	let a = mut ? new World{ticks= 1}
	let b = mut ? new World{ticks= 2}
	a = mut b
	let t = mut b.ticks
}
