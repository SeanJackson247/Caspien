// A lock struct holding an interface-typed owns member: every implementer is checked, and this one holds a ref.
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
enum Gate{ OPEN, CLOSED }
struct Counter{@pub{ n: mut u64 }}
interface Source{
	get(_self: ref some mut self) mut u64;
}
struct Holder{@pub{ p: ref mut Counter }}
impl Source for Holder{
	@pub
	@realizes
	func get(_self: ref some mut self) mut u64{
		return 7
	}
}
@lock(match self.gate : OPEN)
struct Slot{@pub{
	swap gate: atomic mut Gate
	src: owns mut Source
}}
let static slot = mut Slot{gate= Gate.OPEN, src= null}
func main() void{
}
