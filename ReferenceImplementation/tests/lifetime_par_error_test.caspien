// A scoped value cannot cross par: the thread would outlive the borrow (safe code already refuses any pointer across par).
import "stdlib/libc.caspien"
import "stdlib/gt/*"
struct A{@pub{ v: mut u64 }}
struct B{@pub{ a: ref some mut A }}
@async
func work(b: ref some mut B) void{
}
func main() void{
	?catch(e){ return }
	let a = mut ?new A{v= 1}
	let b = mut ?new B{a= ref a}
	?par work(b)
}
