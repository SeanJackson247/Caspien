// The owner of the borrowed object is moved into a call that may drop it while `b` holds a borrow, then `b.a` is read. Must not compile.
import "stdlib/libc.caspien"
import "stdlib/gt/*"
struct A{@pub{ v: mut u64 }}
struct B{@pub{ a: ref some mut A }}
func consume(x: owns mut A) void{ }
func main() void{
	?catch(e){ return }
	let a = mut ?new A{v= 1}
	let b = mut B{a= ref a}
	consume(a)
	unsafe extern{ printf("%llu\n", b.a.v) }
}
