func part0() void{
	c_rfOp2("rfOp2 0 $5 a.b x y", 0, "$5", "a.b", "x y", "    $5q x y, a.b\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 0  x y ", 0, "", "x y", "", "    q , x y\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 0 -8(%rbp)  %rax", 0, "-8(%rbp)", "", "%rax", "    -8(%rbp)q %rax, \n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 0 foo -8(%rbp) a.b", 0, "foo", "-8(%rbp)", "a.b", "    fooq a.b, -8(%rbp)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 0 a.b a.b ", 0, "a.b", "a.b", "", "    a.bq , a.b\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 0 a.b %rax foo", 0, "a.b", "%rax", "foo", "    a.bq foo, %rax\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 0 $5 -8(%rbp) -8(%rbp)", 0, "$5", "-8(%rbp)", "-8(%rbp)", "    $5q -8(%rbp), -8(%rbp)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 0 foo 16(%rax) x y", 0, "foo", "16(%rax)", "x y", "    fooq x y, 16(%rax)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 0 x y x y x y", 0, "x y", "x y", "x y", "    x yq x y, x y\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 0 foo %rax -8(%rbp)", 0, "foo", "%rax", "-8(%rbp)", "    fooq -8(%rbp), %rax\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 0 a.b x y foo", 0, "a.b", "x y", "foo", "    a.bq foo, x y\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 0 -8(%rbp) 16(%rax) %rax", 0, "-8(%rbp)", "16(%rax)", "%rax", "    -8(%rbp)q %rax, 16(%rax)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 0 -8(%rbp) $5 %rax", 0, "-8(%rbp)", "$5", "%rax", "    -8(%rbp)q %rax, $5\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 0 a.b foo 16(%rax)", 0, "a.b", "foo", "16(%rax)", "    a.bq 16(%rax), foo\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 0 x y -8(%rbp) -8(%rbp)", 0, "x y", "-8(%rbp)", "-8(%rbp)", "    x yq -8(%rbp), -8(%rbp)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 0 a.b x y %rax", 0, "a.b", "x y", "%rax", "    a.bq %rax, x y\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 0 -8(%rbp) -8(%rbp) ", 0, "-8(%rbp)", "-8(%rbp)", "", "    -8(%rbp)q , -8(%rbp)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 0 foo 16(%rax) %rax", 0, "foo", "16(%rax)", "%rax", "    fooq %rax, 16(%rax)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 0 a.b 16(%rax) -8(%rbp)", 0, "a.b", "16(%rax)", "-8(%rbp)", "    a.bq -8(%rbp), 16(%rax)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 0 x y %rax %rax", 0, "x y", "%rax", "%rax", "    x yq %rax, %rax\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4 foo 16(%rax) 16(%rax)", 4, "foo", "16(%rax)", "16(%rax)", "    fooq 16(%rax), 16(%rax)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4 -8(%rbp)  -8(%rbp)", 4, "-8(%rbp)", "", "-8(%rbp)", "    -8(%rbp)q -8(%rbp), \n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4 foo -8(%rbp) ", 4, "foo", "-8(%rbp)", "", "    fooq , -8(%rbp)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4 x y %rax ", 4, "x y", "%rax", "", "    x yq , %rax\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4 foo $5 16(%rax)", 4, "foo", "$5", "16(%rax)", "    fooq 16(%rax), $5\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4  a.b foo", 4, "", "a.b", "foo", "    q foo, a.b\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4 %rax $5 foo", 4, "%rax", "$5", "foo", "    %raxq foo, $5\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4 -8(%rbp) $5 $5", 4, "-8(%rbp)", "$5", "$5", "    -8(%rbp)q $5, $5\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4   x y", 4, "", "", "x y", "    q x y, \n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4 a.b 16(%rax) foo", 4, "a.b", "16(%rax)", "foo", "    a.bq foo, 16(%rax)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4 %rax 16(%rax) x y", 4, "%rax", "16(%rax)", "x y", "    %raxq x y, 16(%rax)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4  16(%rax) a.b", 4, "", "16(%rax)", "a.b", "    q a.b, 16(%rax)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4 a.b $5 a.b", 4, "a.b", "$5", "a.b", "    a.bq a.b, $5\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4 x y foo foo", 4, "x y", "foo", "foo", "    x yq foo, foo\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4 $5 16(%rax) $5", 4, "$5", "16(%rax)", "$5", "    $5q $5, 16(%rax)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4 a.b %rax x y", 4, "a.b", "%rax", "x y", "    a.bq x y, %rax\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4 a.b foo foo", 4, "a.b", "foo", "foo", "    a.bq foo, foo\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4 foo 16(%rax) $5", 4, "foo", "16(%rax)", "$5", "    fooq $5, 16(%rax)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4 x y  ", 4, "x y", "", "", "    x yq , \n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 4 16(%rax) 16(%rax) %rax", 4, "16(%rax)", "16(%rax)", "%rax", "    16(%rax)q %rax, 16(%rax)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 8 -8(%rbp) -8(%rbp) $5", 8, "-8(%rbp)", "-8(%rbp)", "$5", "    -8(%rbp)q $5, -8(%rbp)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 8 $5 foo a.b", 8, "$5", "foo", "a.b", "    $5q a.b, foo\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 8 16(%rax) x y %rax", 8, "16(%rax)", "x y", "%rax", "    16(%rax)q %rax, x y\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 8 16(%rax)  foo", 8, "16(%rax)", "", "foo", "    16(%rax)q foo, \n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 8 $5 -8(%rbp) ", 8, "$5", "-8(%rbp)", "", "    $5q , -8(%rbp)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 8 %rax -8(%rbp) ", 8, "%rax", "-8(%rbp)", "", "    %raxq , -8(%rbp)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 8 x y 16(%rax) -8(%rbp)", 8, "x y", "16(%rax)", "-8(%rbp)", "    x yq -8(%rbp), 16(%rax)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 8  16(%rax) foo", 8, "", "16(%rax)", "foo", "    q foo, 16(%rax)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 8 x y 16(%rax) a.b", 8, "x y", "16(%rax)", "a.b", "    x yq a.b, 16(%rax)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 8 a.b  x y", 8, "a.b", "", "x y", "    a.bq x y, \n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 8 %rax -8(%rbp) x y", 8, "%rax", "-8(%rbp)", "x y", "    %raxq x y, -8(%rbp)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 8 16(%rax) 16(%rax) ", 8, "16(%rax)", "16(%rax)", "", "    16(%rax)q , 16(%rax)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 8 $5 x y 16(%rax)", 8, "$5", "x y", "16(%rax)", "    $5q 16(%rax), x y\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 8 16(%rax) a.b x y", 8, "16(%rax)", "a.b", "x y", "    16(%rax)q x y, a.b\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 8 %rax %rax -8(%rbp)", 8, "%rax", "%rax", "-8(%rbp)", "    %raxq -8(%rbp), %rax\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 8 a.b a.b ", 8, "a.b", "a.b", "", "    a.bq , a.b\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 8 a.b 16(%rax) foo", 8, "a.b", "16(%rax)", "foo", "    a.bq foo, 16(%rax)\n|d=0;v=-1;m=0;u=false")
	c_rfOp2("rfOp2 8 -8(%rbp) $5 %rax", 8, "-8(%rbp)", "$5", "%rax", "    -8(%rbp)q %rax, $5\n|d=0;v=-1;m=0;u=false")
