func c_gtSaveLoadedArgRegs(label: static imut string, su: mut s32, want: static imut string) void{
	?catch(ex){
		check(label, false)
		return
	}
	let thrown = mut false
	let b = mut nb(su)
	let rl = mut ? new ObjectList:<String>()
	try{
		match Some(b){ match Some(b.regForm){
			rl = try b.regForm.gtSaveLoadedArgRegs(b.regForm) catch(e){
				thrown = true
				continue
			}
		} }
	}
	let rv = mut ? String.from("|ret=[")
	let:<mut u64> rn = mut 0
	match Some(rl){ rn = rl.size(rl) }
	for ri in 0..rn{
		if ri > 0{ ? rv.append(rv, ", ") }
		match Some(rl){
			let it = rl.get(rl, ri)
			match Some(it){ ? rv.append(rv, it) }
		}
	}
	? rv.append(rv, "]")
	verdict(label, thrown, b, rv, want)
}

