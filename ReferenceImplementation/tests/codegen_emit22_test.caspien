	c_emitCases1("emitCases1 0 PUSH 8 ARG7 False 12", 0, "PUSH 8 ARG7", false, 12, "    movq %rax, %rax\n    pushq %rax\n|ret=true|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null;lv=12")
	c_emitCases1("emitCases1 0 ASSIGN 3 True 16", 0, "ASSIGN 3", true, 16, "    popq %rax\n    popq %rbx\n    movw %ax, (%rbx)\n    rorq $16, %rax\n    movb %al, 2(%rbx)\n    rolq $16, %rax\n|ret=true|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_emitCases1("emitCases1 0 ALLOC 0 True -16", 0, "ALLOC 0", true, (-16), "    subq $0, %rsp\n|ret=true|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_emitCases1("emitCases1 0 ASSIGN 8 a b False 24", 0, "ASSIGN 8 a b", false, 24, "    popq %rax\n    popq %rbx\n    movq %rax, (%rbx)\n|ret=true|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_emitCases1("emitCases1 0 PUSH 8 %x1 False 24", 0, "PUSH 8 %x1", false, 24, "    movq %xmm9, %rax\n    pushq %rax\n|ret=true|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null;lv=24")
