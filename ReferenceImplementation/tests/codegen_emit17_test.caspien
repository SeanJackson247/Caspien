	c_rfBin("rfBin 15 ROTL 2 %v1 #6 %t0", 15, "ROTL", 2, "%v1", "#6", "%t0", "    pushq %rcx\n    movq %rax, %rcx\n    movl $6, %r14d\n    movzwq %r14w, %r14\n    rolw %cl, %r14w\n    popq %rcx\n|d=0;v=-1;m=2;u=true;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfBin("rfBin 15 GT 8 x %t3 $-16", 15, "GT", 8, "x", "%t3", "$-16", "EX")
	c_rfBin("rfBin 15 GT 2 %t3 #4294967295 #255", 15, "GT", 2, "%t3", "#4294967295", "#255", "    movl $65535, %r12d\n    movzwq %r12w, %r12\n    cmpq $255, %r12\n    seta %r12b\n    movzbq %r12b, %r12\n|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfBin("rfBin 15 BAND 7 #5 $-16 %t3", 15, "BAND", 7, "#5", "$-16", "%t3", "EX")
	c_rfBin("rfBin 15 ROTL 5 x #4294967295 #255", 15, "ROTL", 5, "x", "#4294967295", "#255", "EX")
	c_rfBin("rfBin 15 MUL 3 %t3 #4294967297 %v1", 15, "MUL", 3, "%t3", "#4294967297", "%v1", "    movq %r14, %r12\n    shlq $32, %r12\n    addq %r14, %r12\n|d=0;v=-1;m=2;u=true;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfBin("rfBin 15 ADD 3 x #4294967295 %t3", 15, "ADD", 3, "x", "#4294967295", "%t3", "EX")
}

