// `auto c` of a variable that is itself a pointer (owns) used to produce the address of the variable, so writes through it corrupted the stack.
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
struct Counter{@pub{ n: mut u64 }}
func main() void{
	?catch(e){ return }
	let c = mut ? new Counter{n= 41}
	let a = mut auto c
	a.n = a.n + 1
}
