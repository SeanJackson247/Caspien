import "../../../../../../BytecodeParser/src/main/java/caspien/bytecode/Text.caspien"
import "collections.caspien"

// Helpers only the Codegen port needs (Java calls containsAnyWord/String.toLowerCase with arrays and Unicode; here literal names and ASCII).

@pub
struct CodegenText{@pub{
}}

impl constructor for CodegenText() self{
	return CodegenText{}
}

@pub
impl CodegenText{
	/** The array literal {"rbx", "ebx", "bx", "bl", "bh"} Java passes to `containsAnyWord`. */
	@pub
	@throws
	static func rbxNames() owns some mut ObjectList<String>{
		?catch(e){ throw e }
		let l = mut ? new ObjectList:<String>()
		let n0 = mut ? new String("rbx")
		let n1 = mut ? new String("ebx")
		let n2 = mut ? new String("bx")
		let n3 = mut ? new String("bl")
		let n4 = mut ? new String("bh")
		? l.add(l, n0)
		? l.add(l, n1)
		? l.add(l, n2)
		? l.add(l, n3)
		? l.add(l, n4)
		return l
	}

	/** The array literal {"rdi", "edi", "di", "dil"} Java passes to `containsAnyWord`. */
	@pub
	@throws
	static func rdiNames() owns some mut ObjectList<String>{
		?catch(e){ throw e }
		let l = mut ? new ObjectList:<String>()
		let n0 = mut ? new String("rdi")
		let n1 = mut ? new String("edi")
		let n2 = mut ? new String("di")
		let n3 = mut ? new String("dil")
		? l.add(l, n0)
		? l.add(l, n1)
		? l.add(l, n2)
		? l.add(l, n3)
		return l
	}

	/** The array literal {"rsi", "esi", "si", "sil"} Java passes to `containsAnyWord`. */
	@pub
	@throws
	static func rsiNames() owns some mut ObjectList<String>{
		?catch(e){ throw e }
		let l = mut ? new ObjectList:<String>()
		let n0 = mut ? new String("rsi")
		let n1 = mut ? new String("esi")
		let n2 = mut ? new String("si")
		let n3 = mut ? new String("sil")
		? l.add(l, n0)
		? l.add(l, n1)
		? l.add(l, n2)
		? l.add(l, n3)
		return l
	}

	/** ASCII lower case of one char (port-only helper for the case-insensitive config words). */
	@pub
	static func lowerChar(c: mut char) mut char{
		if c == 'A'{ return 'a' }
		if c == 'B'{ return 'b' }
		if c == 'C'{ return 'c' }
		if c == 'D'{ return 'd' }
		if c == 'E'{ return 'e' }
		if c == 'F'{ return 'f' }
		if c == 'G'{ return 'g' }
		if c == 'H'{ return 'h' }
		if c == 'I'{ return 'i' }
		if c == 'J'{ return 'j' }
		if c == 'K'{ return 'k' }
		if c == 'L'{ return 'l' }
		if c == 'M'{ return 'm' }
		if c == 'N'{ return 'n' }
		if c == 'O'{ return 'o' }
		if c == 'P'{ return 'p' }
		if c == 'Q'{ return 'q' }
		if c == 'R'{ return 'r' }
		if c == 'S'{ return 's' }
		if c == 'T'{ return 't' }
		if c == 'U'{ return 'u' }
		if c == 'V'{ return 'v' }
		if c == 'W'{ return 'w' }
		if c == 'X'{ return 'x' }
		if c == 'Y'{ return 'y' }
		if c == 'Z'{ return 'z' }
		return c
	}
}
