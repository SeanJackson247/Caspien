import "../collections.caspien"
import "BytecodeStatement.caspien"

@pub
struct BytecodeProgram{@pub{
	items: owns some mut ObjectList<BytecodeStatement>
}}

@pub
@throws
impl constructor for BytecodeProgram() self{
	?catch(e){ throw e }
	let items = mut ? new ObjectList:<BytecodeStatement>()
	return BytecodeProgram{items= items}
}
