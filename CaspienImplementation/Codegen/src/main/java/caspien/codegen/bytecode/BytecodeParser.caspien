// SHIM (16 Oct): placeholder for the shared BytecodeParser/ package, which is not ported yet. Returns an empty program; remove when the real port exists.
import "../../../../../../../stdlib/string.caspien"
import "BytecodeProgram.caspien"

@pub
struct BytecodeParser{@pub{
}}

impl constructor for BytecodeParser() self{
	return BytecodeParser{}
}

@pub
impl BytecodeParser{
	/** Java `parse(List<String> rawLines, String originFile)`; the shim takes the whole text. */
	@pub
	@throws
	func parse(_self: ref some mut self, text: ref imut String, originFile: ref imut String) owns some mut BytecodeProgram{
		?catch(e){ throw e }
		let p = mut ? new BytecodeProgram()
		return p
	}
}
