import "stdlib/string.caspien"
import "CodegenTarget.caspien"
import "collections.caspien"
import "CodegenText.caspien"
import "../../../../../../BytecodeParser/src/main/java/caspien/bytecode/Text.caspien"

@pub
struct CodegenConfig{@pub{
	target: imut CodegenTarget
	bmi2: imut bool
	avx: imut bool
}}

impl constructor for CodegenConfig(target: imut CodegenTarget, bmi2: imut bool, avx: imut bool) self{
	return CodegenConfig{target= target, bmi2= bmi2, avx= avx}
}

@pub
impl CodegenConfig{
	@pub
	@throws
	static func parse(text: ref imut String, path: ref imut String) owns some mut CodegenConfig{
		?catch(e){ throw e }
		// text.lines().toList(): the Text line-break split (it drops trailing blank lines, which the loop below skips anyway)
		let lines = mut ? new ObjectList:<String>()
		match Some(text){ lines = ? Text.splitLineBreaks(text) }
		// forced: no nullable enum local, 0 = Java's `null`, 1 = WINDOWS_GNU_X64, 2 = LINUX_X64
		let:<mut s32> target = mut 0
		let bmi2 = mut false
		let avx = mut false
		let count = mut 0
		match Some(lines){ count = lines.size(lines) }
		for li in 0..count{
			let rawLine = mut ? new String()
			match Some(lines){
				let l = lines.get(lines, li)
				match Some(l){ rawLine = ? l.trim(l) }
			}
			if rawLine.length(rawLine) == 0 || rawLine.startsWith(rawLine, "#"){
				continue
			}
			let parts = mut ? Text.splitSpace(rawLine, 2)
			if parts.size(parts) != 2{
				throw "config: expected 'key value'"
			}
			let key = mut ? new String()
			let valueText = mut ? new String()
			let p0 = parts.get(parts, 0)
			match Some(p0){ key = ? p0.substring(p0, 0) }
			let p1 = parts.get(parts, 1)
			match Some(p1){ valueText = ? p1.trim(p1) }
			// forced: no equalsIgnoreCase in the String library, so the value is lower-cased once (ASCII) and compared with equals
			let value = mut ? new String()
			let vn = mut valueText.length(valueText)
			for k in 0..vn{
				let ch = mut valueText.charAt(valueText, k)
				? value.appendChar(value, CodegenText.lowerChar(ch))
			}
			if key.equals(key, "target"){
				if value.equals(value, "windows"){
					throw "config: target 'windows' (MASM/Intel syntax) is no longer supported -- use 'windows_gnu' (gcc/mingw-w64)"
				} else if value.equals(value, "windows_gnu") || value.equals(value, "windows-gnu") || value.equals(value, "mingw"){
					target = 1
				} else if value.equals(value, "linux"){
					target = 2
				} else{
					throw "config: unknown target -- expected 'windows_gnu' or 'linux'"
				}
			} else if key.equals(key, "bmi2"){
				if value.equals(value, "on"){
					bmi2 = true
				} else if value.equals(value, "off"){
					bmi2 = false
				} else{
					throw "config: bmi2 must be 'on' or 'off'"
				}
			} else if key.equals(key, "avx"){
				if value.equals(value, "on") == false && value.equals(value, "off") == false{
					throw "config: avx must be 'on' or 'off'"
				}
				avx = value.equals(value, "on")
			} else if key.equals(key, "jcc-padding"){
				if value.equals(value, "on") == false && value.equals(value, "off") == false{
					throw "config: jcc-padding must be 'on' or 'off'"
				}
			} else{
				throw "config: unknown config key"
			}
		}
		if target == 0{
			throw "config: missing required 'target' key"
		}
		if target == 1{
			let w = mut ? new CodegenConfig(CodegenTarget.WINDOWS_GNU_X64, bmi2, avx)
			return w
		}
		let l = mut ? new CodegenConfig(CodegenTarget.LINUX_X64, bmi2, avx)
		return l
	}
}
