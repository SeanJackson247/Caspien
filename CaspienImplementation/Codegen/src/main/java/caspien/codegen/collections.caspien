import "stdlib/libc.caspien"
import "stdlib/string.caspien"

// Stand-ins for the java.util classes the codegen files use on Strings and objects (see README.md, "Caspien port").
// A list owns its elements one by one (`Slot<T>` holds an `owns` pointer), so an element is reached by `ref`, never copied.
// `ObjectList<T>` methods are checked for every T, so String-only searches are the plain functions `listIndexOfText` etc.

@pub
struct Slot<T>{@pub{
	v: owns mut T
}}

@pub
struct ObjectList<T>{@pub{
	items: owns some mut dynarray(mut Slot<T>)
}}

@pub
@throws
impl<T> constructor for ObjectList<T>() self{
	?catch(e){ throw e }
	let items = mut ? dyn:<Slot:<T>>([])
	return ObjectList:<T>{items= items}
}

@pub
impl<T> ObjectList<T>{
	/** Java `size()`. */
	@pub
	func size(_self: ref some imut self) mut u64{
		return len(_self.items)
	}

	@pub
	func isEmpty(_self: ref some imut self) bool{
		return len(_self.items) == 0
	}

	/** Java `get(i)`: a reference to element `i`, null when `i` is out of range. */
	@pub
	func get(_self: ref some imut self, i: imut u64) ref mut T{
		match i in _self.items{
			return ref _self.items[i].v
		}
		return null
	}

	/** Java `get(i)` for an element that must exist: a non-null reference (no ghost-table id is made); throws when `i` is out of range or the slot is empty. */
	@pub
	@throws
	func getSome(_self: ref some imut self, i: imut u64) ref some mut T{
		match i in _self.items{
			match Some(_self.items[i].v){
				let r = mut ref _self.items[i].v    // owner proven alive: an address, no ghost-table id
				return r
			}
		}
		throw "index out of range"
	}

	/** Java `add(x)` / `push(x)`: appends `item` (moved in). */
	@pub
	@throws
	func add(_self: ref some mut self, item: owns mut T) void{
		?catch(e){ throw e }
		let n = mut len(_self.items)
		let empty = mut Slot:<T>{v= null}
		let grown = mut ? resize(_self.items, n + 1, empty)
		_self.items = grown
		match n into _self.items{
			_self.items[n].v = item
		}
	}

	/** Java `peek()`: a reference to the last element, null when empty. */
	@pub
	func peek(_self: ref some imut self) ref mut T{
		let n = mut len(_self.items)
		if n == 0{
			return null
		}
		let last = mut (n - 1)
		return _self.get(_self, last)
	}

	/** Java `pop()` without the result: drops the last element (nothing when empty). */
	@pub
	@throws
	func removeLast(_self: ref some mut self) void{
		?catch(e){ throw e }
		let n = mut len(_self.items)
		if n > 0{
			let empty = mut Slot:<T>{v= null}
			let shrunk = mut ? resize(_self.items, n - 1, empty)
			_self.items = shrunk
		}
	}

	/** Java `clear()`. */
	@pub
	@throws
	func clear(_self: ref some mut self) void{
		?catch(e){ throw e }
		if len(_self.items) > 0{
			let empty = mut Slot:<T>{v= null}
			let none = mut ? resize(_self.items, 0, empty)
			_self.items = none
		}
	}

	/** Java `add(i, x)`: inserts `item` before element `i` (moved in); throws when `i` > size. */
	@pub
	@throws
	func insertAt(_self: ref some mut self, i: imut u64, item: owns mut T) void{
		?catch(e){ throw e }
		let n = mut len(_self.items)
		if i > n{
			throw "index out of range"
		}
		let empty = mut Slot:<T>{v= null}
		let grown = mut ? resize(_self.items, n + 1, empty)
		_self.items = grown
		let k = mut n
		let shifts = mut (n - i)
		for step in 0..shifts{
			let km = mut (k - 1)
			let:<owns mut T> moved = mut null
			match k into _self.items{
				match km into _self.items{
					moved = _self.items[km].v
					_self.items[k].v = moved
				}
			}
			k = km
		}
		match i into _self.items{
			_self.items[i].v = item
		}
	}

	/** Java `remove(i)` without the result: drops element `i` and closes the gap; throws when `i` is out of range. */
	@pub
	@throws
	func removeAt(_self: ref some mut self, i: imut u64) void{
		?catch(e){ throw e }
		let n = mut len(_self.items)
		if i >= n{
			throw "index out of range"
		}
		match i into _self.items{
			_self.items[i].v = null
		}
		let:<mut u64> k = mut 0
		k = i + 0
		let shifts = mut (n - 1 - i)
		for step in 0..shifts{
			let kp = mut (k + 1)
			let:<owns mut T> moved = mut null
			match k into _self.items{
				match kp into _self.items{
					moved = _self.items[kp].v
					_self.items[k].v = moved
				}
			}
			k = kp
		}
		let empty = mut Slot:<T>{v= null}
		let shrunk = mut ? resize(_self.items, n - 1, empty)
		_self.items = shrunk
	}

	/** Replaces element `i` (the old one is dropped); nothing when `i` is out of range. */
	@pub
	func setAt(_self: ref some mut self, i: imut u64, item: owns mut T) void{
		match i into _self.items{
			_self.items[i].v = item
		}
	}
}

/** For a list of Strings: index of the first element equal to `needle`, or -1 (Java `indexOf`). A plain function because `ObjectList<T>` methods are checked for every T. */
@pub
func listIndexOfText(list: ref some imut ObjectList<String>, needle: ref some imut String) mut s64{
	let n = mut list.size(list)
	for i in 0..n{
		let e = list.get(list, i)
		match Some(e){
			if e.equals(e, needle){
				return wrap:<s64>(i)
			}
		}
	}
	return -1
}

@pub
func listIndexOfLiteral(list: ref some imut ObjectList<String>, needle: static imut string) mut s64{
	let n = mut list.size(list)
	for i in 0..n{
		let e = list.get(list, i)
		match Some(e){
			if e.equals(e, needle){
				return wrap:<s64>(i)
			}
		}
	}
	return -1
}

/** Java `contains` on a list of Strings. */
@pub
func listContains(list: ref some imut ObjectList<String>, needle: ref some imut String) bool{
	return listIndexOfText(list, needle) >= 0
}

@pub
func listContainsLiteral(list: ref some imut ObjectList<String>, needle: static imut string) bool{
	return listIndexOfLiteral(list, needle) >= 0
}

/** An open-addressing hash index over the entries of a set or map: slot = entry number + 1 (0 = empty); the capacity is a power of two and the table at most half full, so a probe always meets an empty slot. */
@pub
struct HashIndex{@pub{
	slots: owns some mut dynarray(mut s64)
	cap: mut u64
}}

@pub
@throws
impl constructor for HashIndex(cap: mut u64) self{
	?catch(e){ throw e }
	let slots = mut ? dyn:<s64>([])
	let:<mut s64> zero = mut 0
	let grown = mut ? resize(slots, cap, zero)
	return HashIndex{slots= grown, cap= cap}
}

@pub
impl HashIndex{
	@pub
	/** The entry number + 1 stored in slot `pos` (0 when empty). */
	func slotAt(_self: ref some imut self, pos: imut u64) mut s64{
		match pos in _self.slots{
			return _self.slots[pos]
		}
		return 0
	}

	@pub
	/** Stores `entry1` (entry number + 1) in the first empty slot of the probe sequence of hash `h`. */
	func place(_self: ref some mut self, h: imut u64, entry1: imut s64) void{
		let cap = mut _self.cap
		if cap == 0{
			return
		}
		let mask = mut (cap - 1)
		let pos = mut bits_and(h, mask)
		for step in 0..cap{
			if _self.slotAt(_self, pos) == 0{
				let v = mut (entry1 + 0)
				match pos into _self.slots{
					_self.slots[pos] = v
				}
				return
			}
			pos = bits_and(pos + 1, mask)
		}
	}
}

/** The capacity (a power of two, at least 16) that keeps `count` entries at most half of the table. */
func hashIndexCapacityFor(count: imut u64) mut u64{
	let cap = mut 16
	for step in 0..60{
		if cap < count * 2{
			cap = cap * 2
		}
	}
	return cap
}

/** A set of Strings in insertion order (Java `HashSet<String>`; hash-indexed). */
@pub
struct StringSet{@pub{
	items: owns some mut ObjectList<String>
	index: owns some mut HashIndex
}}

@pub
@throws
impl constructor for StringSet() self{
	?catch(e){ throw e }
	let items = mut ? new ObjectList:<String>()
	let index = mut ? new HashIndex(16)
	return StringSet{items= items, index= index}
}

@pub
impl StringSet{
	@pub
	func size(_self: ref some imut self) mut u64{
		return _self.items.size(_self.items)
	}

	@pub
	func isEmpty(_self: ref some imut self) bool{
		return _self.items.isEmpty(_self.items)
	}

	/** Index of the element equal to `text`, or -1; `h` is the hash of `text`. */
	func findHashed(_self: ref some imut self, text: ref some imut String, h: imut u64) mut s64{
		let cap = mut _self.index.cap
		if cap == 0{
			return -1
		}
		let mask = mut (cap - 1)
		let pos = mut bits_and(h, mask)
		for step in 0..cap{
			let slot = mut _self.index.slotAt(_self.index, pos)
			if slot == 0{
				return -1
			}
			let e = _self.items.get(_self.items, wrap:<u64>(slot - 1))
			match Some(e){
				if e.equals(e, text){
					return slot - 1
				}
			}
			pos = bits_and(pos + 1, mask)
		}
		return -1
	}

	func findHashedLit(_self: ref some imut self, text: static imut string, h: imut u64) mut s64{
		let cap = mut _self.index.cap
		if cap == 0{
			return -1
		}
		let mask = mut (cap - 1)
		let pos = mut bits_and(h, mask)
		for step in 0..cap{
			let slot = mut _self.index.slotAt(_self.index, pos)
			if slot == 0{
				return -1
			}
			let e = _self.items.get(_self.items, wrap:<u64>(slot - 1))
			match Some(e){
				if e.equals(e, text){
					return slot - 1
				}
			}
			pos = bits_and(pos + 1, mask)
		}
		return -1
	}

	@pub
	func contains(_self: ref some imut self, text: ref some imut String) bool{
		let h = mut text.hashCode(text)
		return _self.findHashed(_self, text, h) >= 0
	}

	@pub
	func contains(_self: ref some imut self, text: static imut string) bool{
		let h = mut String.hashLiteral(text)
		return _self.findHashedLit(_self, text, h) >= 0
	}

	/** Rebuilds the index for `cap` slots from the elements. */
	@throws
	func rebuild(_self: ref some mut self, cap: mut u64) void{
		?catch(e){ throw e }
		let fresh = mut ? new HashIndex(cap)
		let n = mut _self.items.size(_self.items)
		for i in 0..n{
			let e = _self.items.get(_self.items, i)
			match Some(e){
				let h = mut e.hashCode(e)
				fresh.place(fresh, h, wrap:<s64>(i + 1))
			}
		}
		_self.index = fresh
	}

	/** Java `add`: true when `text` was not yet in the set (it is then moved in). */
	@pub
	@throws
	func add(_self: ref some mut self, text: owns some mut String) bool{
		?catch(e){ throw e }
		let h = mut text.hashCode(text)
		if _self.findHashed(_self, text, h) >= 0{
			return false
		}
		let n = mut _self.items.size(_self.items)
		? _self.items.add(_self.items, text)
		match Some(_self){
			if (n + 1) * 2 > _self.index.cap{
				let cap = mut hashIndexCapacityFor(n + 1)
				? _self.rebuild(_self, cap)
			} else {
				_self.index.place(_self.index, h, wrap:<s64>(n + 1))
			}
		}
		return true
	}

	@pub
	func at(_self: ref some imut self, i: imut u64) ref mut String{
		return _self.items.get(_self.items, i)
	}

	@pub
	@throws
	func clear(_self: ref some mut self) void{
		?catch(e){ throw e }
		? _self.items.clear(_self.items)
		let fresh = mut ? new HashIndex(16)
		_self.index = fresh
	}
}

/** One key/value pair of a `StringMap`. */
@pub
struct MapEntry<V>{@pub{
	key: owns some mut String
	value: owns mut V
}}

/** Java `LinkedHashMap<String, V>` for an owning V: pairs in insertion order (hash-indexed). */
@pub
struct StringMap<V>{@pub{
	entries: owns some mut ObjectList<MapEntry<V>>
	index: owns some mut HashIndex
}}

@pub
@throws
impl<V> constructor for StringMap<V>() self{
	?catch(e){ throw e }
	let entries = mut ? new ObjectList:<MapEntry:<V>>()
	let index = mut ? new HashIndex(16)
	return StringMap:<V>{entries= entries, index= index}
}

@pub
impl<V> StringMap<V>{
	@pub
	func size(_self: ref some imut self) mut u64{
		return _self.entries.size(_self.entries)
	}

	@pub
	func isEmpty(_self: ref some imut self) bool{
		return _self.entries.isEmpty(_self.entries)
	}

	/** Index of the entry whose key equals `key` (hash `h`), or -1. */
	func findHashed(_self: ref some imut self, key: ref some imut String, h: imut u64) mut s64{
		let cap = mut _self.index.cap
		if cap == 0{
			return -1
		}
		let mask = mut (cap - 1)
		let pos = mut bits_and(h, mask)
		for step in 0..cap{
			let slot = mut _self.index.slotAt(_self.index, pos)
			if slot == 0{
				return -1
			}
			let e = _self.entries.get(_self.entries, wrap:<u64>(slot - 1))
			match Some(e){
				match Some(e.key){
					if e.key.equals(e.key, key){
						return slot - 1
					}
				}
			}
			pos = bits_and(pos + 1, mask)
		}
		return -1
	}

	func findHashedLit(_self: ref some imut self, key: static imut string, h: imut u64) mut s64{
		let cap = mut _self.index.cap
		if cap == 0{
			return -1
		}
		let mask = mut (cap - 1)
		let pos = mut bits_and(h, mask)
		for step in 0..cap{
			let slot = mut _self.index.slotAt(_self.index, pos)
			if slot == 0{
				return -1
			}
			let e = _self.entries.get(_self.entries, wrap:<u64>(slot - 1))
			match Some(e){
				match Some(e.key){
					if e.key.equals(e.key, key){
						return slot - 1
					}
				}
			}
			pos = bits_and(pos + 1, mask)
		}
		return -1
	}

	/** Index of the entry whose key equals `key`, or -1. */
	func find(_self: ref some imut self, key: ref some imut String) mut s64{
		let h = mut key.hashCode(key)
		return _self.findHashed(_self, key, h)
	}

	func findLit(_self: ref some imut self, key: static imut string) mut s64{
		let h = mut String.hashLiteral(key)
		return _self.findHashedLit(_self, key, h)
	}

	@pub
	func containsKey(_self: ref some imut self, key: ref some imut String) bool{
		return _self.find(_self, key) >= 0
	}

	@pub
	func containsKey(_self: ref some imut self, key: static imut string) bool{
		return _self.findLit(_self, key) >= 0
	}

	/** Rebuilds the index for `cap` slots from the entries. */
	@throws
	func rebuild(_self: ref some mut self, cap: mut u64) void{
		?catch(e){ throw e }
		let fresh = mut ? new HashIndex(cap)
		let n = mut _self.entries.size(_self.entries)
		for i in 0..n{
			let e = _self.entries.get(_self.entries, i)
			match Some(e){
				match Some(e.key){
					let h = mut e.key.hashCode(e.key)
					fresh.place(fresh, h, wrap:<s64>(i + 1))
				}
			}
		}
		_self.index = fresh
	}

	/** Appends `entry` (moved in; its key has hash `h`) and keeps the index in step. */
	@throws
	func append(_self: ref some mut self, entry: owns some mut MapEntry<V>, h: imut u64) void{
		?catch(e){ throw e }
		let n = mut _self.entries.size(_self.entries)
		? _self.entries.add(_self.entries, entry)
		match Some(_self){
			if (n + 1) * 2 > _self.index.cap{
				let cap = mut hashIndexCapacityFor(n + 1)
				? _self.rebuild(_self, cap)
			} else {
				_self.index.place(_self.index, h, wrap:<s64>(n + 1))
			}
		}
	}

	/** Java `get(key)`: a reference to the value, null when the key is absent. */
	@pub
	func get(_self: ref some imut self, key: ref some imut String) ref mut V{
		let at = mut _self.find(_self, key)
		if at < 0{
			return null
		}
		return _self.valueAt(_self, wrap:<u64>(at))
	}

	@pub
	func get(_self: ref some imut self, key: static imut string) ref mut V{
		let at = mut _self.findLit(_self, key)
		if at < 0{
			return null
		}
		return _self.valueAt(_self, wrap:<u64>(at))
	}

	@pub
	func keyAt(_self: ref some imut self, i: imut u64) ref mut String{
		let e = _self.entries.get(_self.entries, i)
		match Some(e){
			return ref e.key
		}
		return null
	}

	@pub
	func valueAt(_self: ref some imut self, i: imut u64) ref mut V{
		let e = _self.entries.get(_self.entries, i)
		match Some(e){
			return ref e.value
		}
		return null
	}

	/** Java `put`: replaces the value of an existing key (the new key is then dropped), otherwise appends the pair. */
	@pub
	@throws
	func put(_self: ref some mut self, key: owns some mut String, value: owns mut V) void{
		?catch(e){ throw e }
		let h = mut key.hashCode(key)
		let at = mut _self.findHashed(_self, key, h)
		if at >= 0{
			let e = _self.entries.get(_self.entries, wrap:<u64>(at))
			match Some(e){
				e.value = value
			}
		} else {
			let entry = mut ? new MapEntry:<V>{key= key, value= value}
			match Some(_self){
				? _self.append(_self, entry, h)
			}
		}
	}

	@pub
	@throws
	func clear(_self: ref some mut self) void{
		?catch(e){ throw e }
		? _self.entries.clear(_self.entries)
		let fresh = mut ? new HashIndex(16)
		_self.index = fresh
	}
}

/** One key/value pair of a `StringScalarMap`. */
@pub
struct ScalarEntry<V>{@pub{
	key: owns some mut String
	value: mut V
}}

/** Java `LinkedHashMap<String, V>` for a plain scalar V (bool, s64, ...). Hash-indexed. */
@pub
struct StringScalarMap<V>{@pub{
	entries: owns some mut ObjectList<ScalarEntry<V>>
	index: owns some mut HashIndex
}}

@pub
@throws
impl<V> constructor for StringScalarMap<V>() self{
	?catch(e){ throw e }
	let entries = mut ? new ObjectList:<ScalarEntry:<V>>()
	let index = mut ? new HashIndex(16)
	return StringScalarMap:<V>{entries= entries, index= index}
}

@pub
impl<V> StringScalarMap<V>{
	@pub
	func size(_self: ref some imut self) mut u64{
		return _self.entries.size(_self.entries)
	}

	@pub
	func isEmpty(_self: ref some imut self) bool{
		return _self.entries.isEmpty(_self.entries)
	}

	/** Index of the entry whose key equals `key` (hash `h`), or -1. */
	func findHashed(_self: ref some imut self, key: ref some imut String, h: imut u64) mut s64{
		let cap = mut _self.index.cap
		if cap == 0{
			return -1
		}
		let mask = mut (cap - 1)
		let pos = mut bits_and(h, mask)
		for step in 0..cap{
			let slot = mut _self.index.slotAt(_self.index, pos)
			if slot == 0{
				return -1
			}
			let e = _self.entries.get(_self.entries, wrap:<u64>(slot - 1))
			match Some(e){
				match Some(e.key){
					if e.key.equals(e.key, key){
						return slot - 1
					}
				}
			}
			pos = bits_and(pos + 1, mask)
		}
		return -1
	}

	func findHashedLit(_self: ref some imut self, key: static imut string, h: imut u64) mut s64{
		let cap = mut _self.index.cap
		if cap == 0{
			return -1
		}
		let mask = mut (cap - 1)
		let pos = mut bits_and(h, mask)
		for step in 0..cap{
			let slot = mut _self.index.slotAt(_self.index, pos)
			if slot == 0{
				return -1
			}
			let e = _self.entries.get(_self.entries, wrap:<u64>(slot - 1))
			match Some(e){
				match Some(e.key){
					if e.key.equals(e.key, key){
						return slot - 1
					}
				}
			}
			pos = bits_and(pos + 1, mask)
		}
		return -1
	}

	/** Index of the entry whose key equals `key`, or -1. */
	func find(_self: ref some imut self, key: ref some imut String) mut s64{
		let h = mut key.hashCode(key)
		return _self.findHashed(_self, key, h)
	}

	func findLit(_self: ref some imut self, key: static imut string) mut s64{
		let h = mut String.hashLiteral(key)
		return _self.findHashedLit(_self, key, h)
	}

	@pub
	func containsKey(_self: ref some imut self, key: ref some imut String) bool{
		return _self.find(_self, key) >= 0
	}

	@pub
	func containsKey(_self: ref some imut self, key: static imut string) bool{
		return _self.findLit(_self, key) >= 0
	}

	/** Rebuilds the index for `cap` slots from the entries. */
	@throws
	func rebuild(_self: ref some mut self, cap: mut u64) void{
		?catch(e){ throw e }
		let fresh = mut ? new HashIndex(cap)
		let n = mut _self.entries.size(_self.entries)
		for i in 0..n{
			let e = _self.entries.get(_self.entries, i)
			match Some(e){
				match Some(e.key){
					let h = mut e.key.hashCode(e.key)
					fresh.place(fresh, h, wrap:<s64>(i + 1))
				}
			}
		}
		_self.index = fresh
	}

	/** Appends `entry` (moved in; its key has hash `h`) and keeps the index in step. */
	@throws
	func append(_self: ref some mut self, entry: owns some mut ScalarEntry<V>, h: imut u64) void{
		?catch(e){ throw e }
		let n = mut _self.entries.size(_self.entries)
		? _self.entries.add(_self.entries, entry)
		match Some(_self){
			if (n + 1) * 2 > _self.index.cap{
				let cap = mut hashIndexCapacityFor(n + 1)
				? _self.rebuild(_self, cap)
			} else {
				_self.index.place(_self.index, h, wrap:<s64>(n + 1))
			}
		}
	}

	/** Java `getOrDefault`. */
	@pub
	func getOrDefault(_self: ref some imut self, key: ref some imut String, fallback: mut V) mut V{
		let at = mut _self.find(_self, key)
		if at < 0{
			return fallback
		}
		return _self.valueAt(_self, wrap:<u64>(at), fallback)
	}

	@pub
	func getOrDefault(_self: ref some imut self, key: static imut string, fallback: mut V) mut V{
		let at = mut _self.findLit(_self, key)
		if at < 0{
			return fallback
		}
		return _self.valueAt(_self, wrap:<u64>(at), fallback)
	}

	@pub
	func keyAt(_self: ref some imut self, i: imut u64) ref mut String{
		let e = _self.entries.get(_self.entries, i)
		match Some(e){
			return ref e.key
		}
		return null
	}

	@pub
	func valueAt(_self: ref some imut self, i: imut u64, fallback: mut V) mut V{
		let e = _self.entries.get(_self.entries, i)
		match Some(e){
			return e.value
		}
		return fallback
	}

	@pub
	@throws
	func put(_self: ref some mut self, key: owns some mut String, value: mut V) void{
		?catch(e){ throw e }
		let h = mut key.hashCode(key)
		let at = mut _self.findHashed(_self, key, h)
		if at >= 0{
			let e = _self.entries.get(_self.entries, wrap:<u64>(at))
			match Some(e){
				e.value = value
			}
			return
		}
		let entry = mut ? new ScalarEntry:<V>{key= key, value= value}
		match Some(_self){
			? _self.append(_self, entry, h)
		}
	}

	@pub
	@throws
	func clear(_self: ref some mut self) void{
		?catch(e){ throw e }
		? _self.entries.clear(_self.entries)
		let fresh = mut ? new HashIndex(16)
		_self.index = fresh
	}
}

