				match Some(reg11){ ? rw8.append(rw8, reg11) }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, rw8) } } }
				let lab11 = mut ? new String()
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.gen){ lab11 = ? _self.hub.gen.mangleLabel(_self.hub.gen, l11) } } }
				let rw9 = mut ? String.from("    je ")
				match Some(lab11){ ? rw9.append(rw9, lab11) }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, rw9) } } }
				return true
			}
		}
		match Some(mnemonic){
			if mnemonic.equals(mnemonic, "R_BRC"){
				let op12 = mut ? new String()
				match Some(line){ op12 = ? X86Core.lineTok(line, 1) }
				let sz12 = ? X86Core.tokRef(line, 2)
				let a12 = mut ? new String()
				match Some(line){ a12 = ? X86Core.lineTok(line, 3) }
				let b12 = mut ? new String()
				match Some(line){ b12 = ? X86Core.lineTok(line, 4) }
				let l12 = mut ? new String()
				match Some(line){ l12 = ? X86Core.lineTok(line, 5) }
				let isF = mut false
				match Some(sz12){ isF = sz12.startsWith(sz12, "F") }
				if isF{
					let fs = mut ? new String()
					match Some(sz12){ fs = ? sz12.substring(sz12, 1) }
					let:<mut s32> fn12 = mut 0
					match Some(fs){ fn12 = ? fs.parseS32(fs) }
					let lab12 = mut ? new String()
					match Some(_self){ match Some(_self.hub){ match Some(_self.hub.gen){ lab12 = ? _self.hub.gen.mangleLabel(_self.hub.gen, l12) } } }
					match Some(_self){ match Some(_self.hub){ match Some(_self.hub.gen){ ? _self.hub.gen.rfFloat(_self.hub.gen, true, op12, fn12, null, a12, b12, lab12) } } }
					return true
				}
				let:<mut s64> bs12 = mut 0
				match Some(line){ bs12 = ? X86Core.tokenS64(line, 2) }
				let res12 = mut ? new String()
				let lab12 = mut ? new String()
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.gen){ lab12 = ? _self.hub.gen.mangleLabel(_self.hub.gen, l12) } } }
				if bs12 < 8{
					match Some(_self){ match Some(_self.hub){ match Some(_self.hub.gen){ res12 = ? _self.hub.gen.rfBrcNarrow(_self.hub.gen, op12, wrap:<s32>(bs12), a12, b12, lab12) } } }
					return true
				}
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.gen){ res12 = ? _self.hub.gen.rfBrc(_self.hub.gen, op12, a12, b12, lab12) } } }
				return true
			}
		}
		match Some(mnemonic){
			if mnemonic.equals(mnemonic, "R_CMOV"){
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.gen){ ? _self.hub.gen.rfCmov(_self.hub.gen, line) } } }
			return true
			}
		}
		return false
	}







}
