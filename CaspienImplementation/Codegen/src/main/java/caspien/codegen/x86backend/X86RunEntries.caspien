import "../../../../../../../stdlib/dynamic_array.caspien"

@pub
struct X86RunEntries{@pub{
	sizes: owns some mut DynamicArray<s64>
	storeLines: owns some mut DynamicArray<s32>
}}

@pub
@throws
impl constructor for X86RunEntries() self{
	?catch(e){ throw e }
	let sizes = mut ? new DynamicArray:<s64>()
	let storeLines = mut ? new DynamicArray:<s32>()
	return X86RunEntries{sizes= sizes, storeLines= storeLines}
}
