/** `LINUX_ARG_REGS[i]`: a fresh copy of the entry; throws past the end. */
@pub
@throws
func X86Core_linuxArgRegs_at(i: imut u64) owns some mut String{
	?catch(e){ throw e }
	? X86Core_linuxArgRegs_ensure()
	let out = mut ? new String()
	let found = mut false
	/*! termination: finite */
	match @lock X86Core_LINUX_ARG_REGS{
