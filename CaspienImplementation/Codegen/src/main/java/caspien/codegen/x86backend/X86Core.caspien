				let e3 = mut ? String.from("rcx")
				match Some(X86Core_LINUX_ARG_REGS.value){ ? X86Core_LINUX_ARG_REGS.value.add(X86Core_LINUX_ARG_REGS.value, e3) }
				let e4 = mut ? String.from("r8")
				match Some(X86Core_LINUX_ARG_REGS.value){ ? X86Core_LINUX_ARG_REGS.value.add(X86Core_LINUX_ARG_REGS.value, e4) }
				let e5 = mut ? String.from("r9")
				match Some(X86Core_LINUX_ARG_REGS.value){ ? X86Core_LINUX_ARG_REGS.value.add(X86Core_LINUX_ARG_REGS.value, e5) }
			}
		}
