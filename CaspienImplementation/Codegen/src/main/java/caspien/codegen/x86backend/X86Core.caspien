/*
 * The Java `static final` constants. Caspien's idiom for shared constants is a lock-protected `let static` (safe code may not read a bare static):
 * each is a struct with a `swap` gate and is read through `match @lock`. A `let static` initialiser cannot hold a string literal (it is emitted as
 * null), so the strings and tables start empty and are filled once, under the lock, on first use; reads return a copy (strings) or answer a question (tables).
 */
enum ConstGate{ OPEN, CLOSED }

@pub
@lock(match self.gate : OPEN)
struct ConstString{@pub{
	swap gate: atomic mut ConstGate
	value: owns mut String
}}

@pub
@lock(match self.gate : OPEN)
struct ConstInt{@pub{
	swap gate: atomic mut ConstGate
	value: mut s32
}}

@pub
@lock(match self.gate : OPEN)
struct ConstList{@pub{
	swap gate: atomic mut ConstGate
	value: owns mut ObjectList<String>
}}

@pub
@lock(match self.gate : OPEN)
struct ConstSet{@pub{
	swap gate: atomic mut ConstGate
	value: owns mut StringSet
}}


let static X86Core_CSR_MARK = mut ConstString{gate= ConstGate.OPEN, value= null}

/** Java `CSR_MARK` = "@@CSR@@": a fresh copy of the constant. */
@pub
@throws
func X86Core_csrMark() owns some mut String{
	?catch(e){ throw e }
	let out = mut ? new String()
	/*! termination: finite */
	match @lock X86Core_CSR_MARK{
		OPEN:{
			let have = mut false
			match Some(X86Core_CSR_MARK.value){ have = true }
			if !have{
				X86Core_CSR_MARK.value = ? new String()
				match Some(X86Core_CSR_MARK.value){ ? X86Core_CSR_MARK.value.append(X86Core_CSR_MARK.value, "@@CSR@@") }
			}
			match Some(X86Core_CSR_MARK.value){ out = ? X86Core_CSR_MARK.value.substring(X86Core_CSR_MARK.value, 0) }
		}
		CLOSED:default(1000000)
	}
	return out
}


