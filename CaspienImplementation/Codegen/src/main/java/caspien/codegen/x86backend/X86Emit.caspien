			let p2 = mut ? new String(", %rsp")
			let:<mut s64> d = mut 0
			match Some(_self){ d = ? _self.parseRspDelta(_self, t, p1, p2) }
			delta = 0 - d
		} else if t.startsWith(t, "sub rsp, "){
