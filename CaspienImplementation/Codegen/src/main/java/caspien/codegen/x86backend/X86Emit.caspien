	@pub
	@throws
	func extractWordsFromReversedBlock(_self: ref some mut self, totalWords: mut s64, size: mut s32) void{
		?catch(e){ throw e }
		let:<mut s64> elemWords = mut (wrap:<s64>(size + 7) / 8)
		let ln421 = mut ? String.from("    movq %rax, %r11")
		match Some(_self){ ? _self.raw_(_self, ln421) }
		let ln422 = mut ? String.from("    subq %r14, %r11")
		match Some(_self){ ? _self.raw_(_self, ln422) }
		let ln423 = mut ? String.from("    shlq $3, %r14")
		match Some(_self){ ? _self.raw_(_self, ln423) }
		let ln424 = mut ? String.from("    movq %rcx, %r13")
		match Some(_self){ ? _self.raw_(_self, ln424) }
		let ln425 = mut ? String.from("    movq %r14, %rcx")
		match Some(_self){ ? _self.raw_(_self, ln425) }
		let:<mut u64> ew = mut 0
		if elemWords > 0{
			ew = wrap:<u64>(elemWords)
		}
		for j in 0..ew{
			let:<mut s64> jj = mut wrap:<s64>(j)
			let:<mut s64> lo = mut (0 - jj * 8)
			let:<mut s64> hi = mut (0 - (jj * 8 + 8))
			let:<mut s64> dst = mut ((totalWords - 1 - jj) * 8)
			let ln426 = mut ? String.from("    movq ")
			? ln426.appendS64(ln426, lo)
			? ln426.append(ln426, "(%r11), %rax")
			match Some(_self){ ? _self.raw_(_self, ln426) }
			let ln427 = mut ? String.from("    movq ")
			? ln427.appendS64(ln427, hi)
			? ln427.append(ln427, "(%r11), %r14")
			match Some(_self){ ? _self.raw_(_self, ln427) }
			let ln428 = mut ? String.from("    shrdq %cl, %r14, %rax")
			match Some(_self){ ? _self.raw_(_self, ln428) }
			let ln429 = mut ? String.from("    movq %rax, ")
			? ln429.appendS64(ln429, dst)
			? ln429.append(ln429, "(%rsp)")
			match Some(_self){ ? _self.raw_(_self, ln429) }
		}
		let ln430 = mut ? String.from("    movq %r13, %rcx")
		match Some(_self){ ? _self.raw_(_self, ln430) }
		if totalWords > elemWords{
			let:<mut s64> drop = mut ((totalWords - elemWords) * 8)
			let ln431 = mut ? String.from("    addq $")
			? ln431.appendS64(ln431, drop)
			? ln431.append(ln431, ", %rsp")
			match Some(_self){ ? _self.raw_(_self, ln431) }
		}
	}

	@pub
	@throws
	func storeOddSize(_self: ref some mut self, srcReg64: ref imut String, baseReg64: ref imut String, off: mut s64, size: mut s32) void{
		?catch(e){ throw e }
		let:<mut s32> w0 = mut 4
		let:<mut s32> w1 = mut 2
		let:<mut s32> w2 = mut 1
		let count = mut 3
		if size == 3{
			w0 = 2
			w1 = 1
			count = 2
		} elseif size == 5{
			w0 = 4
			w1 = 1
			count = 2
		} elseif size == 6{
			w0 = 4
			w1 = 2
			count = 2
		}
		let at = mut off
		let:<mut s32> rot = mut 0
		for i in 0..count{
			let:<mut s32> w = mut w0
			if i == 1{ w = w1 }
			if i == 2{ w = w2 }
			match Some(_self){ ? _self.storePiece(_self, srcReg64, baseReg64, at, w) }
			at = at + (w as s64)
			if i + 1 < count{
				match Some(_self){ ? _self.rotReg(_self, srcReg64, true, w * 8) }
				rot = rot + w * 8
			}
		}
		if rot > 0{
			match Some(_self){ ? _self.rotReg(_self, srcReg64, false, rot) }
		}
	}

	@pub
	@throws
	func storePiece(_self: ref some mut self, srcReg64: ref imut String, baseReg64: ref imut String, off: mut s64, width: mut s32) void{
		?catch(e){ throw e }
		let line = mut ? String.from("    mov")
		match Some(_self){ ? line.append(line, _self.movSuffix(_self, width)) }
		? line.append(line, " %")
		let sized = mut ? new String()
		match Some(_self){ match Some(srcReg64){ sized = ? _self.sizedReg(_self, srcReg64, width) } }
		? line.append(line, sized)
		? line.append(line, ", ")
		let ot = mut ? X86Emit.offsetText(off)
		? line.append(line, ot)
		? line.append(line, "(%")
		match Some(baseReg64){ ? line.append(line, baseReg64) }
		? line.append(line, ")")
		match Some(_self){ ? _self.raw_(_self, line) }
	}

	@pub
	@throws
	func rotReg(_self: ref some mut self, reg64: ref imut String, right: mut bool, bits: mut s32) void{
		?catch(e){ throw e }
		if right{
			let line = mut ? String.from("    rorq $")
			? line.appendS64(line, bits as s64)
			? line.append(line, ", %")
			match Some(reg64){ ? line.append(line, reg64) }
			match Some(_self){ ? _self.raw_(_self, line) }
		} else{
			let line = mut ? String.from("    rolq $")
			? line.appendS64(line, bits as s64)
			? line.append(line, ", %")
			match Some(reg64){ ? line.append(line, reg64) }
			match Some(_self){ ? _self.raw_(_self, line) }
		}
	}

	@pub
	@throws
	func storeSizedToAddr(_self: ref some mut self, srcReg64: ref imut String, addrReg64: ref imut String, size: mut s32) void{
		?catch(e){ throw e }
		if X86Core.isOddSize(size){
			match Some(_self){ ? _self.storeOddSize(_self, srcReg64, addrReg64, 0, size) }
			return
		}
		let line = mut ? String.from("    mov")
		match Some(_self){ ? line.append(line, _self.movSuffix(_self, size)) }
		? line.append(line, " %")
		let t7 = mut ? new String()
		match Some(_self){ match Some(srcReg64){ t7 = ? _self.sizedReg(_self, srcReg64, size) } }
		? line.append(line, t7)
		? line.append(line, ", ")
		let t8 = mut ? new String()
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.gen){ t8 = ? _self.hub.gen.rfMemOperand(_self.hub.gen, addrReg64) } } }
		? line.append(line, t8)
		match Some(_self){ ? _self.raw_(_self, line) }
	}

	@pub
	@throws
	func pushBlockFromFrame(_self: ref some mut self, baseOffset: mut s64, size: mut s64) void{
		?catch(e){ throw e }
		let rax = mut ? String.from("rax")
		let:<mut u64> words = mut 0
		if size > 0{
			words = wrap:<u64>(size + 7) / 8
		}
		for i in 0..words{
			let:<mut s64> at = mut (baseOffset + wrap:<s64>(i) * 8)
			match Some(_self){ ? _self.loadSizedFromFrame(_self, rax, at, 8) }
			match Some(_self){ ? _self.pushReg(_self, rax) }
		}
	}

	@pub
	@throws
	func pushBlockFromFrameConstructionAware(_self: ref some mut self, baseOffset: mut s64, size: mut s64) void{
		?catch(e){ throw e }
		let rax = mut ? String.from("rax")
		let has = mut false
		let:<mut s64> coff = mut 0
		match Some(_self){ match Some(_self.core){
			has = _self.core.pushStoreOffsetByLine.contains(_self.core.pushStoreOffsetByLine, _self.core.currentLineIndex)
			coff = _self.core.pushStoreOffsetByLine.get(_self.core.pushStoreOffsetByLine, _self.core.currentLineIndex, 0)
		} }
		if has == false{
			match Some(_self){ ? _self.pushBlockFromFrame(_self, baseOffset, size) }
			return
		}
		let ln416 = mut ? String.from("    subq $")
		? ln416.appendS64(ln416, size)
		? ln416.append(ln416, ", %rsp")
		match Some(_self){ ? _self.raw_(_self, ln416) }
		let:<mut s64> pos = mut 0
		let:<mut u64> rounds = mut 0
		if size > 0{
			rounds = wrap:<u64>(size)
		}
		for step in 0..rounds{
			if pos >= size{
				break
			}
			let:<mut s64> left = mut (size - pos)
			let:<mut s32> w = mut X86Emit.widthFor(left)
			let:<mut s64> from = mut (baseOffset + pos)
			match Some(_self){ ? _self.loadSizedFromFrame(_self, rax, from, w) }
			let:<mut s64> dst = mut (coff + pos)
			let ln417 = mut ? String.from("    mov")
			match Some(_self){ ? ln417.append(ln417, _self.movSuffix(_self, w)) }
			? ln417.append(ln417, " %")
			let t6 = mut ? new String()
			match Some(_self){ match Some(rax){ t6 = ? _self.sizedReg(_self, rax, w) } }
			? ln417.append(ln417, t6)
			? ln417.append(ln417, ", ")
			? ln417.appendS64(ln417, dst)
			? ln417.append(ln417, "(%rsp)")
			match Some(_self){ ? _self.raw_(_self, ln417) }
			pos = pos + (w as s64)
		}
	}

	@pub
	@throws
	func assignBlock(_self: ref some mut self, size: mut s64) void{
		?catch(e){ throw e }
		let:<mut s64> words = mut ((size + 7) / 8)
		let:<mut s64> span = mut (words * 8)
		let ln418 = mut ? String.from("    movq ")
		? ln418.appendS64(ln418, span)
		? ln418.append(ln418, "(%rsp), %r15")
		match Some(_self){ ? _self.raw_(_self, ln418) }
		let rax = mut ? String.from("rax")
		let r15 = mut ? String.from("r15")
		let:<mut u64> cnt = mut 0
		if words > 0{
			cnt = wrap:<u64>(words)
		}
		for i in 0..cnt{
			match Some(_self){ ? _self.popReg(_self, rax) }
			let:<mut s64> k = mut (words - 1 - wrap:<s64>(i))
			let:<mut s64> destOff = mut (k * 8)
			let:<mut s64> n = mut (size - destOff)
			if n > 8{
				n = 8
			}
			if n == 8{
				let ot = mut ? X86Emit.offsetText(destOff)
				let ln419 = mut ? String.from("    movq %rax, ")
				match Some(ot){ ? ln419.append(ln419, ot) }
				? ln419.append(ln419, "(%r15)")
				match Some(_self){ ? _self.raw_(_self, ln419) }
			} elseif X86Core.isOddSize(wrap:<s32>(n)){
				match Some(_self){ ? _self.storeOddSize(_self, rax, r15, destOff, wrap:<s32>(n)) }
			} else{
				match Some(_self){ ? _self.storePiece(_self, rax, r15, destOff, wrap:<s32>(n)) }
			}
		}
		let ln420 = mut ? String.from("    addq $8, %rsp")
		match Some(_self){ ? _self.raw_(_self, ln420) }
	}

	@pub
	@throws
	func assignConstructionBlock(_self: ref some mut self, size: mut s64) void{
		?catch(e){ throw e }
		if size > 0 && size % 8 == 0 && size <= 64{
			let ln432 = mut ? String.from("    movq ")
			? ln432.appendS64(ln432, size)
			? ln432.append(ln432, "(%rsp), %r15")
			match Some(_self){ ? _self.raw_(_self, ln432) }
			let:<mut u64> nw = mut wrap:<u64>(size / 8)
			for w in 0..nw{
				let:<mut s64> o = mut (wrap:<s64>(w) * 8)
				let ln433 = mut ? String.from("    movq ")
				? ln433.appendS64(ln433, o)
				? ln433.append(ln433, "(%rsp), %rdi")
				match Some(_self){ ? _self.raw_(_self, ln433) }
				let ln434 = mut ? String.from("    movq %rdi, ")
				? ln434.appendS64(ln434, o)
				? ln434.append(ln434, "(%r15)")
				match Some(_self){ ? _self.raw_(_self, ln434) }
			}
			let:<mut s64> fin = mut (size + 8)
			let ln435 = mut ? String.from("    addq $")
			? ln435.appendS64(ln435, fin)
			? ln435.append(ln435, ", %rsp")
			match Some(_self){ ? _self.raw_(_self, ln435) }
			return
		}
		let ln436 = mut ? String.from("    movq ")
		? ln436.appendS64(ln436, size)
		? ln436.append(ln436, "(%rsp), %r15")
		match Some(_self){ ? _self.raw_(_self, ln436) }
		let ln437 = mut ? String.from("    movq %r15, %rdi")
		match Some(_self){ ? _self.raw_(_self, ln437) }
		let ln438 = mut ? String.from("    movq %rsp, %rsi")
		match Some(_self){ ? _self.raw_(_self, ln438) }
		let ln439 = mut ? String.from("    pushq %rcx")
		match Some(_self){ ? _self.raw_(_self, ln439) }
		let ln440 = mut ? String.from("    movq $")
		? ln440.appendS64(ln440, size)
		? ln440.append(ln440, ", %rcx")
		match Some(_self){ ? _self.raw_(_self, ln440) }
		let ln441 = mut ? String.from("    rep movsb")
		match Some(_self){ ? _self.raw_(_self, ln441) }
		let ln442 = mut ? String.from("    popq %rcx")
		match Some(_self){ ? _self.raw_(_self, ln442) }
		let ln443 = mut ? String.from("    addq $")
		? ln443.appendS64(ln443, size)
		? ln443.append(ln443, ", %rsp")
		match Some(_self){ ? _self.raw_(_self, ln443) }
		let ln444 = mut ? String.from("    addq $8, %rsp")
		match Some(_self){ ? _self.raw_(_self, ln444) }
	}
}
