	@pub
	@throws
	func collectDeclarations(_self: ref some mut self, lines: ref imut ObjectList<BytecodeStatement>) void{
		?catch(e){ throw e }
		let plain = mut ? new StringSet()
		let running = mut ? new StringScalarMap:<s64>()
		let total = mut 0
		match Some(lines){ total = lines.size(lines) }
		for li in 0..total{
			let parts = mut ? new ObjectList:<String>()
			match Some(lines){
				let l = lines.get(lines, li)
				match Some(l){ parts = ? X86Core.textsOf(l) }
			}
			let cnt = mut parts.size(parts)
			if cnt == 0{
				continue
			}
			let mn = mut ? X86Core.partCopy(parts, 0)
			if (mn.equals(mn, "GLOBAL") || mn.equals(mn, "ALLOC_STATIC")) && cnt >= 3{
				let name = mut ? X86Core.partCopy(parts, 1)
				if name.firstIndexOf(name, '.') < 0{
					let added = mut ? plain.add(plain, name)
				}
			}
			if mn.equals(mn, "FUNC_START") && cnt >= 2{
				let fname = mut ? X86Core.partCopy(parts, 1)
				match Some(_self){ match Some(_self.core){
					let added2 = mut ? _self.core.declaredFunctionNames.add(_self.core.declaredFunctionNames, fname)
				} }
			}
		}
		for li2 in 0..total{
			let parts = mut ? new ObjectList:<String>()
			match Some(lines){
				let l = lines.get(lines, li2)
				match Some(l){ parts = ? X86Core.textsOf(l) }
			}
			let cnt = mut parts.size(parts)
			if cnt == 0{
				continue
			}
			let mn = mut ? X86Core.partCopy(parts, 0)
			if mn.equals(mn, "GLOBAL") || mn.equals(mn, "ALLOC_STATIC"){
				let name = mut ? X86Core.partCopy(parts, 1)
				let sizeText = mut ? X86Core.partCopy(parts, 2)
				let size = mut ? sizeText.parseS64(sizeText)
				let dot = mut -1
				let nn = mut name.length(name)
				for k in 0..nn{
					if name.charAt(name, k) == '.'{
						dot = wrap:<s64>(k)
					}
				}
				let direct = mut ? new String()
				if dot >= 0{
					direct = ? name.substring(name, 0, wrap:<u64>(dot))
				}
				let known = mut false
				let isAlias = mut false
				let nested = mut false
				match Some(_self){ match Some(_self.core){
					known = _self.core.globalAliasOffset.containsKey(_self.core.globalAliasOffset, name)
					nested = _self.core.globalAliasOffset.containsKey(_self.core.globalAliasOffset, direct)
				} }
				if dot >= 0 && (plain.contains(plain, direct) || nested) && known == false{
					isAlias = true
				}
				if isAlias{
					let parent = mut ? new String()
					let:<mut s64> baseOffset = mut 0
					if nested{
						match Some(_self){ match Some(_self.core){
							baseOffset = _self.core.globalAliasOffset.getOrDefault(_self.core.globalAliasOffset, direct, 0)
						} }
						match Some(_self){ match Some(_self.core){
							let pp = _self.core.globalAliasParent.get(_self.core.globalAliasParent, direct)
							match Some(pp){ parent = ? pp.substring(pp, 0) }
						} }
					} else{
						parent = ? direct.substring(direct, 0)
					}
					let prev = mut running.getOrDefault(running, direct, 0)
					let offset = mut (baseOffset + prev)
					let nameCopy1 = mut ? name.substring(name, 0)
					let nameCopy2 = mut ? name.substring(name, 0)
					let parentCopy = mut ? parent.substring(parent, 0)
					match Some(_self){ match Some(_self.core){ ? _self.core.globalAliasOffset.put(_self.core.globalAliasOffset, nameCopy1, offset) } }
					match Some(_self){ match Some(_self.core){ ? _self.core.globalAliasParent.put(_self.core.globalAliasParent, nameCopy2, parentCopy) } }
					let directCopy = mut ? direct.substring(direct, 0)
					? running.put(running, directCopy, prev + size)
