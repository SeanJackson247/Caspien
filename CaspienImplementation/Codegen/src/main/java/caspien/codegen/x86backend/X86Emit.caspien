	static func widthFor(left: mut s64) mut s32{
		if left >= 8{
			return 8
		} elseif left >= 4{
			return 4
		} elseif left >= 2{
			return 2
		}
		return 1
	}

	static func pickBySize(size: mut s32, s1: static imut string, s2: static imut string, s4: static imut string, other: static imut string) static imut string{
