				? ac.append(ac, "\"")
				match Some(_self){ ? _self.raw_(_self, ac) }
			}
		}
	}

	@pub
	@throws
	func emitStorageDirective(_self: ref some mut self, size: mut s64, init: mut s64) void{
		?catch(e){ throw e }
		if size == 8{
			let ln407 = mut ? String.from("    .quad ")
			? ln407.appendS64(ln407, init)
			match Some(_self){ ? _self.raw_(_self, ln407) }
		} elseif size == 4{
			let ln408 = mut ? String.from("    .long ")
			? ln408.appendS64(ln408, init)
			match Some(_self){ ? _self.raw_(_self, ln408) }
		} elseif size == 2{
			let ln409 = mut ? String.from("    .word ")
			? ln409.appendS64(ln409, init)
			match Some(_self){ ? _self.raw_(_self, ln409) }
		} elseif size == 1{
			let ln410 = mut ? String.from("    .byte ")
			? ln410.appendS64(ln410, init)
			match Some(_self){ ? _self.raw_(_self, ln410) }
		} else{
			let ln411 = mut ? String.from("    .zero ")
			? ln411.appendS64(ln411, size)
			match Some(_self){ ? _self.raw_(_self, ln411) }
		}
	}

	@pub
	@throws
	func mangleGlobalName(_self: ref some mut self, name: ref some imut String) owns some mut String{
		?catch(e){ throw e }
		let r = mut ? name.replace(name, '.', '_')
		return r
	}

	@pub
