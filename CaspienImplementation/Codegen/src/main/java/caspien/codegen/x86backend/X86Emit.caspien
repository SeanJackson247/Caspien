				match Some(_self){ match Some(_self.core){
					let v1 = _self.core.stringLiterals.valueAt(_self.core.stringLiterals, si)
					match Some(v1){ vl = ? v1.substring(v1, 0) }
				} }
				? kl.append(kl, ":")
				match Some(_self){ ? _self.raw_(_self, kl) }
