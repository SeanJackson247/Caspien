	}

	@pub
	@throws
	func precomputeConstructionOffsets(_self: ref some mut self) void{
		?catch(e){ throw e }
		// forced: the stdlib HashMap/HashSet have no clear(), so the three (empty-or-not) collections are replaced by fresh empty ones
		let h1 = mut ? new HashMap:<s32, s64>(mut 0, mut 0, mut 16)
		match Some(_self){ match Some(_self.core){ _self.core.pushStoreOffsetByLine = h1 } }
		let h2 = mut ? new HashSet:<s32>(mut 0, mut 16)
		match Some(_self){ match Some(_self.core){ _self.core.constructionScopedAssign = h2 } }
		let h3 = mut ? new HashSet:<s32>(mut 0, mut 16)
		match Some(_self){ match Some(_self.core){ _self.core.packedNewLines = h3 } }
		let:<mut u64> n = mut 0
		match Some(_self){ match Some(_self.core){ match Some(_self.core.allLines){ n = _self.core.allLines.size(_self.core.allLines) } } }
		for i in 0..n{
			match Some(_self){ match Some(_self.core){ match Some(_self.core.allLines){
			let l = _self.core.allLines.get(_self.core.allLines, i)
			match Some(l){
				if l.items.size(l.items) == 0{
					continue
				}
				let isNew = mut (X86Core.tokenIs(l, 0, "NEW") && l.items.size(l.items) >= 2)
				let isBlockAssign = mut false
				if (X86Core.tokenIs(l, 0, "ASSIGN") || X86Core.tokenIs(l, 0, "ATOMIC_ASSIGN")) && l.items.size(l.items) >= 4{
					let t1 = l.items.get(l.items, 1)
					let t2 = l.items.get(l.items, 2)
					let t3 = l.items.get(l.items, 3)
					match Some(t1){ match Some(t2){ match Some(t3){
						isBlockAssign = t1.text.equals(t1.text, t2.text) && t2.text.equals(t2.text, t3.text)
					} } }
				}
				if isNew == false && isBlockAssign == false{
					continue
				}
				let declaredSize = mut ? X86Core.tokenS64(l, 1)
				let:<mut s32> ii = mut wrap:<s32>(i)
				let:<mut s32> runStart = mut 0
				match Some(_self){ runStart = ? _self.findRunStart(_self, ii, declaredSize) }
				if runStart < 0{
					continue
				}
				if isBlockAssign{
					let ents = mut ? new X86RunEntries()
					match Some(_self){ ents = ? _self.collectRunEntries(_self, runStart, ii) }
					let:<mut u64> cnt = mut 0
					match Some(ents){ cnt = len(ents.sizes.backing) }
					if cnt <= 1{
						continue // a single PUSH feeding this ASSIGN: an ordinary scalar assign or a whole-block copy, not a construction
					}
				}
				match Some(_self){ ? _self.populateDirectMembers(_self, runStart, ii, declaredSize) }
				if isBlockAssign{
					match Some(_self){ match Some(_self.core){ _self.core.constructionScopedAssign.add(_self.core.constructionScopedAssign, ii) } }
				} else{
					match Some(_self){ match Some(_self.core){ _self.core.packedNewLines.add(_self.core.packedNewLines, ii) } }
				}
			}
			} } }
		}
	}

	@pub
	func isWinAbi(_self: ref some mut self) mut bool{
		let result = mut false
		match Some(_self.core){
			result = _self.core.target == CodegenTarget.WINDOWS_GNU_X64
		}
		return result
	}

	@pub
	@throws
	func collectDeclarations(_self: ref some mut self, lines: ref imut ObjectList<BytecodeStatement>) void{
		?catch(e){ throw e }
		let plainGlobalNames = mut ? new StringSet()
		let:<mut u64> total = mut 0
		match Some(lines){ total = lines.size(lines) }
		for li in 0..total{
			match Some(lines){
				let line = lines.get(lines, li)
				match Some(line){
					if line.items.size(line.items) == 0{
						continue
					}
					if (X86Core.tokenIs(line, 0, "GLOBAL") || X86Core.tokenIs(line, 0, "ALLOC_STATIC")) && line.items.size(line.items) >= 3{
						let name = mut ? X86Core.lineTok(line, 1)
						if name.contains(name, ".") == false{
							let added = mut ? plainGlobalNames.add(plainGlobalNames, name)
						}
					}
					match Some(line){ // re-matched: the allocations above ended the proof
						if X86Core.tokenIs(line, 0, "FUNC_START") && line.items.size(line.items) >= 2{
							let fname = mut ? X86Core.lineTok(line, 1)
							match Some(_self){ match Some(_self.core){
								let added2 = mut ? _self.core.declaredFunctionNames.add(_self.core.declaredFunctionNames, fname)
							} }
						}
					}
				}
			}
		}
		// Pass 2: real declarations, aliasing dotted fields of a known
		// parent block instead of giving them their own storage.
		let parentRunningOffset = mut ? new StringScalarMap:<s64>()
		for li2 in 0..total{
			match Some(lines){
				let line = lines.get(lines, li2)
				match Some(line){
					let cnt = mut line.items.size(line.items)
					if cnt == 0{
						continue
					}
					if X86Core.tokenIs(line, 0, "GLOBAL") || X86Core.tokenIs(line, 0, "ALLOC_STATIC"){
						let name = mut ? X86Core.lineTok(line, 1)
						let:<mut s64> size = mut 0
						match Some(line){ size = ? X86Core.tokenS64(line, 2) }
						// forced: the string library has no lastIndexOf, so a backward scan for the last '.'
						let:<mut s64> dot = mut -1
						let nn = mut name.length(name)
						for k in 0..nn{
							let kk = mut (nn - 1 - k)
							if name.charAt(name, kk) == '.'{
								dot = wrap:<s64>(kk)
								break
							}
						}
						let:<owns mut String> direct = null
						if dot >= 0{
							direct = ? name.substring(name, 0, wrap:<u64>(dot))
						} else{
							direct = null
						}
						let isAlias = mut false
						match Some(direct){ match Some(_self){ match Some(_self.core){
							if (plainGlobalNames.contains(plainGlobalNames, direct) || _self.core.globalAliasOffset.containsKey(_self.core.globalAliasOffset, direct)) && _self.core.globalAliasOffset.containsKey(_self.core.globalAliasOffset, name) == false{
								isAlias = true
							}
						} } }
						if isAlias{
							let nested = mut false
							match Some(direct){ match Some(_self){ match Some(_self.core){
								nested = _self.core.globalAliasOffset.containsKey(_self.core.globalAliasOffset, direct)
							} } }
							let parent = mut ? new String()
							let:<mut s64> baseOffset = mut 0
							if nested{
								match Some(direct){ match Some(_self){ match Some(_self.core){
									let pp = _self.core.globalAliasParent.get(_self.core.globalAliasParent, direct)
									match Some(pp){ parent = ? pp.substring(pp, 0) }
								} } }
								match Some(direct){ match Some(_self){ match Some(_self.core){
									baseOffset = _self.core.globalAliasOffset.getOrDefault(_self.core.globalAliasOffset, direct, 0)
								} } }
							} else{
								match Some(direct){ parent = ? direct.substring(direct, 0) }
								baseOffset = 0
							}
							let:<mut s64> offset = mut 0
							match Some(direct){ offset = baseOffset + parentRunningOffset.getOrDefault(parentRunningOffset, direct, 0) }
							let nameCopy1 = mut ? name.substring(name, 0)
							let nameCopy2 = mut ? name.substring(name, 0)
							let parentCopy = mut ? parent.substring(parent, 0)
							match Some(_self){ match Some(_self.core){ ? _self.core.globalAliasOffset.put(_self.core.globalAliasOffset, nameCopy1, offset) } }
							match Some(_self){ match Some(_self.core){ ? _self.core.globalAliasParent.put(_self.core.globalAliasParent, nameCopy2, parentCopy) } }
							let directCopy = mut ? new String()
							match Some(direct){ directCopy = ? direct.substring(direct, 0) }
							let:<mut s64> prevRunning = mut 0
							match Some(direct){ prevRunning = parentRunningOffset.getOrDefault(parentRunningOffset, direct, 0) }
							? parentRunningOffset.put(parentRunningOffset, directCopy, prevRunning + size)
							if cnt >= 4{
								let have = mut false
								match Some(_self){ match Some(_self.core){ have = _self.core.aliasInits.containsKey(_self.core.aliasInits, parent) } }
								if have == false{
									let fresh = mut ? new ObjectList:<DynamicArray:<s64>>()
									let parentKey = mut ? parent.substring(parent, 0)
									match Some(_self){ match Some(_self.core){ ? _self.core.aliasInits.put(_self.core.aliasInits, parentKey, fresh) } }
								}
								let:<mut s64> bits = mut 0
								match Some(line){
									let t3 = line.items.get(line.items, 3)
									match Some(t3){ match Some(_self){ bits = ? _self.initBits(_self, t3.text, size) } }
								}
								let arr = mut ? dyn([offset, size, bits])
								let entry = mut ? new DynamicArray:<s64>(arr)
								match Some(_self){ match Some(_self.core){
									let inits = _self.core.aliasInits.get(_self.core.aliasInits, parent)
									match Some(inits){ ? inits.add(inits, entry) }
								} }
							}
							continue
						}
						if cnt >= 4{
							let:<mut s64> init = mut 0
							match Some(line){
								let t3b = line.items.get(line.items, 3)
								match Some(t3b){ match Some(_self){ init = ? _self.initBits(_self, t3b.text, size) } }
							}
							let pairArr = mut ? dyn([size, init])
							let pair = mut ? new DynamicArray:<s64>(pairArr)
							let key1 = mut ? name.substring(name, 0)
							let key2 = mut ? name.substring(name, 0)
							match Some(_self){ match Some(_self.core){ ? _self.core.globalsSizeInit.put(_self.core.globalsSizeInit, key1, pair) } }
							match Some(_self){ match Some(_self.core){ ? _self.core.globalsHasInit.put(_self.core.globalsHasInit, key2, true) } }
						} else{
							let present = mut false
							match Some(_self){ match Some(_self.core){ present = _self.core.globalsSizeInit.containsKey(_self.core.globalsSizeInit, name) } }
							if present == false{
								let:<mut s64> zeroInit = mut 0
								let pair2Arr = mut ? dyn([size, zeroInit])
								let pair2 = mut ? new DynamicArray:<s64>(pair2Arr)
								let key3 = mut ? name.substring(name, 0)
								let key4 = mut ? name.substring(name, 0)
								match Some(_self){ match Some(_self.core){ ? _self.core.globalsSizeInit.put(_self.core.globalsSizeInit, key3, pair2) } }
								match Some(_self){ match Some(_self.core){ ? _self.core.globalsHasInit.put(_self.core.globalsHasInit, key4, false) } }
							}
						}
					} else{
						match Some(line){ // re-matched: the GLOBAL branch above allocates
							if X86Core.tokenIs(line, 0, "STRING") && cnt >= 3{
								let id = mut ? X86Core.lineTok(line, 1)
								let text = mut ? new String()
								match Some(line){ text = ? X86Core.lineTok(line, 2) }
								let tn = mut text.length(text)
								// Strip the surrounding quotes the parser keeps on a
								// STRING literal token -- real .asciz wants the raw text.
								if tn >= 2 && text.startsWith(text, "\"") && text.endsWith(text, "\""){
									text = ? text.substring(text, 1, tn - 1)
								}
								match Some(_self){ match Some(_self.core){ ? _self.core.stringLiterals.put(_self.core.stringLiterals, id, text) } }
							}
						}
					}
				}
			}
		}
	}

	/** The initial value of a global as bits: a float/double literal as IEEE bits (size <= 4: float), else the integer value. */
	@pub
	@throws
	func initBits(_self: ref some mut self, text: ref imut String, size: mut s64) mut s64{
		?catch(e){ throw e }
		let isFloatInit = mut false
		match Some(text){
			isFloatInit = text.equals(text, "null") == false && X86Core.isInteger(text) == false && X86Core.isFloatLiteral(text)
		}
		if isFloatInit{
			let:<mut s64> fb = mut 0
			match Some(text){
				let b = mut ? FloatText.bits(text, size > 4)
				fb = wrap:<s64>(b)
			}
			return fb
		}
		let:<mut s64> v = mut 0
		match Some(_self){ match Some(text){
			v = ? _self.parseInitValue(_self, text)
		} }
		return v
	}

	/** "null" is 0, an integer is itself, anything else 0; throws "NumberFormatException" for an integer that does not fit. */
	@pub
	@throws
	func parseInitValue(_self: ref some mut self, text: ref some imut String) mut s64{
		?catch(e){ throw e }
		if text.equals(text, "null"){
			return 0
		}
		let:<mut s64> v = mut 0
		if X86Core.isInteger(text){
			v = ? text.parseS64(text)
		}
		return v
	}

	@pub
	@throws
	func emitDataSections(_self: ref some mut self) void{
		?catch(e){ throw e }
		let:<mut u64> ng = mut 0
		match Some(_self){ match Some(_self.core){ ng = _self.core.globalsSizeInit.size(_self.core.globalsSizeInit) } }
		if ng > 0{
			match Some(_self){ ? _self.rawLit(_self, ".data") }
			for gi in 0..ng{
				let key = mut ? new String()
				match Some(_self){ match Some(_self.core){
					let k0 = _self.core.globalsSizeInit.keyAt(_self.core.globalsSizeInit, gi)
					match Some(k0){ key = ? k0.substring(k0, 0) }
				} }
				let:<mut s64> size = mut 0
				let:<mut s64> init = mut 0
				match Some(_self){ match Some(_self.core){
					let v0 = _self.core.globalsSizeInit.valueAt(_self.core.globalsSizeInit, gi)
					match Some(v0){
