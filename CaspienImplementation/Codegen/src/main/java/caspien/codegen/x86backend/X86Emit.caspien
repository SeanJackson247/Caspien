	@pub
	@throws
	func leaGlobalToReg(_self: ref some mut self, reg: ref imut String, globalName: ref imut String) void{
		?catch(e){ throw e }
		let line = mut ? String.from("    leaq ")
		let isAlias = mut false
		match Some(_self){ match Some(_self.core){ match Some(globalName){
			isAlias = _self.core.globalAliasOffset.containsKey(_self.core.globalAliasOffset, globalName)
		} } }
		if isAlias{
			let:<mut s64> offset = mut 0
			let parentLabel = mut ? new String()
			match Some(_self){ match Some(_self.core){ match Some(globalName){
				offset = _self.core.globalAliasOffset.getOrDefault(_self.core.globalAliasOffset, globalName, 0)
				let parent = _self.core.globalAliasParent.get(_self.core.globalAliasParent, globalName)
				match Some(parent){ parentLabel = ? _self.mangleGlobalName(_self, parent) }
			} } }
			? line.append(line, parentLabel)
			let plus = mut ? X86Emit.plusOffset(offset)
			? line.append(line, plus)
		} else {
			let label = mut ? new String()
			match Some(_self){ match Some(globalName){ label = ? _self.mangleGlobalName(_self, globalName) } }
			? line.append(line, label)
		}
		? line.append(line, "(%rip), %")
		match Some(reg){ ? line.append(line, reg) }
		match Some(_self){ ? _self.raw_(_self, line) }
	}

	/** `name(%rip)` for a global; `sym+N` adds N bytes, an alias global is addressed through its parent. */
	@pub
	@throws
	func globalRipOperand(_self: ref some mut self, globalName: ref some imut String) owns some mut String{
		?catch(e){ throw e }
		let plus = mut globalName.indexOf(globalName, '+')
		let base = mut ? globalName.substring(globalName, 0)
		let:<mut s64> extra = mut 0
		if plus > 0{
			let tail = mut ? globalName.substring(globalName, wrap:<u64>(plus) + 1)
			let head = mut ? globalName.substring(globalName, 0, wrap:<u64>(plus))
			extra = ? tail.parseS64(tail)
			base = head
		}
		let isAlias = mut false
		match Some(_self){ match Some(_self.core){
			isAlias = _self.core.globalAliasOffset.containsKey(_self.core.globalAliasOffset, base)
		} }
		let label = mut ? new String()
		let:<mut s64> off = mut extra
		if isAlias{
			match Some(_self){ match Some(_self.core){
				off = _self.core.globalAliasOffset.getOrDefault(_self.core.globalAliasOffset, base, 0) + extra
			} }
			match Some(_self){ match Some(_self.core){
				let parent = _self.core.globalAliasParent.get(_self.core.globalAliasParent, base)
				match Some(parent){
					label = ? _self.mangleGlobalName(_self, parent)
				}
			} }
		} else{
			label = ? _self.mangleGlobalName(_self, base)
		}
		let po = mut ? X86Emit.plusOffset(off)
		? label.append(label, po)
		? label.append(label, "(%rip)")
		return label
	}

	@pub
	@throws
	func movImmToReg(_self: ref some mut self, reg: ref imut String, imm: mut s64) void{
		?catch(e){ throw e }
		if imm >= 0 && imm <= 0xFFFFFFFF{
			let narrow = mut ? new String()
			match Some(_self){ match Some(reg){ narrow = ? _self.sizedReg(_self, reg, 4) } }
			let same = mut false
			match Some(reg){ same = narrow.equals(narrow, reg) }
			if same == false{
				let line = mut ? String.from("    movl $")
				? line.appendS64(line, imm)
				? line.append(line, ", %")
				match Some(narrow){ ? line.append(line, narrow) }
				match Some(_self){ ? _self.raw_(_self, line) }
				return
			}
		}
		let line = mut ? String.from("    movq $")
		? line.appendS64(line, imm)
		? line.append(line, ", %")
		match Some(reg){ ? line.append(line, reg) }
		match Some(_self){ ? _self.raw_(_self, line) }
	}

	/** The register name for the low `size` bytes of `reg64` (al/ax/eax/rax, r8b/r8w/r8d/r8 ...). The if-chain is one `match Some` per test (an allocation in an earlier branch ends the alive proof of `reg64`). */
	@pub
	@throws
	func sizedReg(_self: ref some mut self, reg64: ref imut String, size: mut s32) owns some mut String{
		?catch(e){ throw e }
		match Some(reg64){
			if reg64.equals(reg64, "rax"){
				let r = mut ? String.from(X86Emit.pickBySize(size, "al", "ax", "eax", "rax"))
				return r
			}
		}
		match Some(reg64){
			if reg64.equals(reg64, "rbx"){
				let r = mut ? String.from(X86Emit.pickBySize(size, "bl", "bx", "ebx", "rbx"))
				return r
			}
		}
		match Some(reg64){
			if reg64.equals(reg64, "rcx"){
				let r = mut ? String.from(X86Emit.pickBySize(size, "cl", "cx", "ecx", "rcx"))
				return r
			}
		}
		match Some(reg64){
			if reg64.equals(reg64, "rdx"){
				let r = mut ? String.from(X86Emit.pickBySize(size, "dl", "dx", "edx", "rdx"))
				return r
			}
		}
		match Some(reg64){
			if reg64.equals(reg64, "rsi"){
				let r = mut ? String.from(X86Emit.pickBySize(size, "sil", "si", "esi", "rsi"))
				return r
			}
		}
		match Some(reg64){
			if reg64.equals(reg64, "rdi"){
				let r = mut ? String.from(X86Emit.pickBySize(size, "dil", "di", "edi", "rdi"))
				return r
			}
		}
		// else: the register is returned as is, with the size letter appended for r8..r15
		let high = mut false
		match Some(reg64){ high = Text.isHighGpr(reg64) && size < 8 }
		let out = mut ? new String() // Java returns reg64 itself; the port returns an owned copy
		match Some(reg64){ out = ? reg64.substring(reg64, 0) }
		if high{
			? out.append(out, X86Emit.pickBySize(size, "b", "w", "d", "d"))
		}
		return out
	}

	@pub
	@throws
	func signExtendReg(_self: ref some mut self, reg: ref imut String, size: mut s32) void{
		?catch(e){ throw e }
		if size >= 8{
			return
		}
		if size == 4{
			let line = mut ? String.from("    movslq %")
			let t9 = mut ? new String()
			match Some(_self){ match Some(reg){ t9 = ? _self.sizedReg(_self, reg, 4) } }
			? line.append(line, t9)
			? line.append(line, ", %")
			match Some(reg){ ? line.append(line, reg) }
			match Some(_self){ ? _self.raw_(_self, line) }
		} else{
			let line = mut ? String.from("    movs")
			match Some(_self){ ? line.append(line, _self.movSuffix(_self, size)) }
			? line.append(line, "q %")
			let t10 = mut ? new String()
			match Some(_self){ match Some(reg){ t10 = ? _self.sizedReg(_self, reg, size) } }
			? line.append(line, t10)
			? line.append(line, ", %")
			match Some(reg){ ? line.append(line, reg) }
			match Some(_self){ ? _self.raw_(_self, line) }
		}
	}

