@pub
impl constructor for X86Emit(hub: ref some mut X86Backend) self{
	return X86Emit{hub= hub, core= ref hub.core}
}

@pub
impl X86Emit{
	@pub
	func lineAtOffsetIsAtomicSwap(_self: ref some mut self, offset: mut s32) mut bool{
		let r = mut false
		match Some(_self.core){ match Some(_self.core.allLines){
			let idx = mut (_self.core.currentLineIndex + offset)
			if idx >= 0 && wrap:<u64>(idx) < _self.core.allLines.size(_self.core.allLines){
				let l = _self.core.allLines.get(_self.core.allLines, wrap:<u64>(idx))
				match Some(l){
					r = l.items.size(l.items) > 0 && X86Core.tokenIs(l, 0, "ATOMIC_SWAP")
				}
			}
		} }
		return r
	}

	@pub
	@throws
	func noteArgRegLoaded(_self: ref some mut self, tag: ref imut String) void{
		?catch(e){ throw e }
		let need = mut false
		match Some(_self.core){
			if _self.core.loadedArgRegsStack.isEmpty(_self.core.loadedArgRegsStack) == false{
				let top = _self.core.loadedArgRegsStack.peek(_self.core.loadedArgRegsStack)
				match Some(top){ match Some(tag){
					need = listContains(top, tag) == false
				} }
			}
		}
		if need{
			let copy = mut ? new String() // the list owns its elements, so the add needs its own copy
			match Some(tag){ copy = ? tag.substring(tag, 0) }
			match Some(_self.core){
				let top2 = _self.core.loadedArgRegsStack.peek(_self.core.loadedArgRegsStack)
				match Some(top2){ ? top2.add(top2, copy) }
			}
		}
	}

	/** The innermost call buffer, or the main output when no call bracket is open. */
	@pub
	func currentSink(_self: ref some mut self) ref mut String{
		match Some(_self.core){
			if _self.core.callBufferStack.isEmpty(_self.core.callBufferStack){
				return ref _self.core.out
			}
			return _self.core.callBufferStack.peek(_self.core.callBufferStack)
		}
		return null
	}

	@pub
	func consumeVarargsXmmCount(_self: ref some mut self) mut s32{
		let:<mut s32> count = mut 0
		match Some(_self.core){
			if _self.core.pendingVarargsXmmCount < 0{
				count = 0
			} else{
				count = _self.core.pendingVarargsXmmCount
			}
			_self.core.pendingVarargsXmmCount = -1
		}
		return count
	}

	@pub
	@throws
	func findRunStart(_self: ref some mut self, endExclusive: mut s32, targetSize: mut s64) mut s32{
		?catch(e){ throw e }
		let:<mut s32> result = mut -1
		// A nested NEW opens a run of its own; the enclosing (total, target) wait on this stack.
		let saved0 = mut ? dyn:<s64>([])
		let:<mut s64> zero64 = mut 0
		let saved = mut ? resize(saved0, 16, zero64)
		let:<mut u64> depth = mut 0
		let:<mut s64> total = mut 0
		let:<mut s64> target = mut targetSize
		let:<mut s32> idx = mut endExclusive
		unsafe loop{ // forced: Java's while(true) is a `loop`, which needs `unsafe loop`
			loop{
				if total < target && idx > 0{
					match Some(_self.core){ match Some(_self.core.allLines){
						let prev = _self.core.allLines.get(_self.core.allLines, wrap:<u64>(idx - 1))
						match Some(prev){
							if prev.items.size(prev.items) == 0{
								result = -1
								break
							}
							if (X86Core.tokenIs(prev, 0, "PUSH") || X86Core.tokenIs(prev, 0, "ATOMIC_PUSH") || X86Core.tokenIs(prev, 0, "STACK_LOCK")) && prev.items.size(prev.items) >= 2{
								total = total + ? X86Core.tokenS64(prev, 1)
								idx = idx - 1
							} else if X86Core.tokenIs(prev, 0, "NEW") && prev.items.size(prev.items) >= 2{
								if depth + 2 > len(saved){
									let:<mut u64> doubled = mut (len(saved) * 2)
									saved = ? resize(saved, doubled, zero64)
								}
								match depth into saved{ saved[depth] = total }
								depth = depth + 1
								match depth into saved{ saved[depth] = target }
								depth = depth + 1
								match Some(prev){ target = ? X86Core.tokenS64(prev, 1) } // re-matched: the resize above ended the proof
								total = 0
								idx = idx - 1
							} else{
								result = -1
								break
							}
							continue
						}
					} }
				}
				if total != target{
					result = -1
					break
				}
				if depth == 0{
					result = idx
					break
				}
				// nested run confirmed: the enclosing run resumes before it; the nested NEW's pointer is one 8-byte word
				depth = depth - 1
				match depth in saved{ target = saved[depth] }
				depth = depth - 1
				match depth in saved{ total = saved[depth] + 8 }
			}
		}
		return result
	}

	@pub
	@throws
	func populateDirectMembers(_self: ref some mut self, start: mut s32, endExclusive: mut s32, runTotal: mut s64) void{
		?catch(e){ throw e }
		let entries = mut ? _self.collectRunEntries(_self, start, endExclusive)
		let:<mut s64> before = mut 0
		let:<mut s64> after = mut runTotal
		let cnt = mut len(entries.sizes.backing)
		for i in 0..cnt{
			match i in entries.sizes.backing{ match i in entries.storeLines.backing{
				let sz = mut entries.sizes.backing[i]
				after = after - sz
				let lineIdx = mut entries.storeLines.backing[i]
				if lineIdx >= 0{
					match Some(_self.core){
						_self.core.pushStoreOffsetByLine.set(_self.core.pushStoreOffsetByLine, lineIdx, before - after)
					}
				}
				before = before + sz
			} }
		}
	}

	@pub
	@throws
	func storeConstructionOrPlainPush(_self: ref some mut self, regName: ref imut String, size: mut s32) void{
		?catch(e){ throw e }
		let has = mut false
		let:<mut s64> coff = mut 0
		match Some(_self){ match Some(_self.core){
			// forced: the stdlib HashMap has no null-returning get, so Java's `get() == null` is contains() then get()
			has = _self.core.pushStoreOffsetByLine.contains(_self.core.pushStoreOffsetByLine, _self.core.currentLineIndex)
			coff = _self.core.pushStoreOffsetByLine.get(_self.core.pushStoreOffsetByLine, _self.core.currentLineIndex, 0)
		} }
		if has == false{
			match Some(_self){ ? _self.pushReg(_self, regName) }
			return
		}
		let ln401 = mut ? String.from("    subq $")
		? ln401.appendS64(ln401, size as s64)
		? ln401.append(ln401, ", %rsp")
		match Some(_self){ ? _self.raw_(_self, ln401) }
		if coff == 0{
			let rsp = mut ? String.from("rsp")
			match Some(_self){ ? _self.storeSizedToAddr(_self, regName, rsp, size) }
		} elseif X86Core.isOddSize(size){
			let rsp2 = mut ? String.from("rsp")
			match Some(_self){ ? _self.storeOddSize(_self, regName, rsp2, coff, size) }
		} else{
			let ln402 = mut ? String.from("    mov")
			match Some(_self){ ? ln402.append(ln402, _self.movSuffix(_self, size)) }
			? ln402.append(ln402, " %")
			let t1 = mut ? new String()
			match Some(_self){ match Some(regName){ t1 = ? _self.sizedReg(_self, regName, size) } }
			? ln402.append(ln402, t1)
			? ln402.append(ln402, ", ")
			? ln402.appendS64(ln402, coff)
			? ln402.append(ln402, "(%rsp)")
			match Some(_self){ ? _self.raw_(_self, ln402) }
		}
	}

	@pub
	@throws
	func collectRunEntries(_self: ref some mut self, start: mut s32, endExclusive: mut s32) owns some mut X86RunEntries{
		?catch(e){ throw e }
		let entries = mut ? new X86RunEntries()
		let:<mut s32> idx = mut start
		let:<mut u64> bound = mut 0
		if endExclusive > start{
			bound = wrap:<u64>(endExclusive - start)
		}
		for step in 0..bound{
			let:<mut s32> kind = mut 0
			let:<mut s64> val = mut 0
			match Some(_self.core){ match Some(_self.core.allLines){
				let l = _self.core.allLines.get(_self.core.allLines, wrap:<u64>(idx))
				match Some(l){
					if l.items.size(l.items) >= 2{
						if X86Core.tokenIs(l, 0, "PUSH") || X86Core.tokenIs(l, 0, "ATOMIC_PUSH"){
							kind = 1
							val = ? X86Core.tokenS64(l, 1)
						} else if X86Core.tokenIs(l, 0, "STACK_LOCK"){
							kind = 2
							val = ? X86Core.tokenS64(l, 1)
						} else if X86Core.tokenIs(l, 0, "NEW"){
							kind = 3
							val = ? X86Core.tokenS64(l, 1)
						}
					}
				}
			} }
			if kind == 0{
				break
			}
			if kind == 1 || kind == 2{
				? entries.sizes.pushBack(entries.sizes, val)
				if kind == 1{
					? entries.storeLines.pushBack(entries.storeLines, idx)
				} else{
					? entries.storeLines.pushBack(entries.storeLines, -1)
				}
			} else{
				let:<mut s64> sum = mut 0
				let:<mut u64> popCount = mut 0
				let cnt = mut len(entries.sizes.backing)
				for jj in 0..cnt{
					let j = mut (cnt - 1 - jj)
					match j in entries.sizes.backing{
						sum = sum + entries.sizes.backing[j]
					}
					popCount = popCount + 1
					if sum >= val{
						break
					}
				}
				if sum == val{
					for k in 0..popCount{
						let a = mut ? entries.sizes.popBack(entries.sizes, 0)
						let b = mut ? entries.storeLines.popBack(entries.storeLines, 0)
					}
				}
				? entries.sizes.pushBack(entries.sizes, 8)
				? entries.storeLines.pushBack(entries.storeLines, -1)
			}
			idx = idx + 1
		}
		return entries
	}

	@pub
	@throws
	func emitNewRepack(_self: ref some mut self, size: mut s64, line: ref imut BytecodeStatement) void{
		?catch(e){ throw e }
		// Chunk sizes on the stack, in push order (first field first).
		let chunk = mut ? new DynamicArray:<s64>()
		let fieldSize = mut ? new DynamicArray:<s64>()   // 0 for a padding gap
		let elemSize = mut ? new DynamicArray:<s64>()    // > 0 for "a<elemBytes>x<n>": a fixed array written element by element, n whole words
		let elemCount = mut ? new DynamicArray:<s64>()
		let:<mut u64> lineLen = mut 0
		match Some(line){ lineLen = line.items.size(line.items) }
		for i in 2..lineLen{
			match Some(line){
			let tokTok = line.items.get(line.items, i)
			match Some(tokTok){
				let tok = tokTok.text
				if tok.charAt(tok, 0) == 'a'{
					let x = mut tok.indexOf(tok, 'x')
					let es = mut ? tok.substring(tok, 1, wrap:<u64>(x))
					let e = mut ? es.parseS64(es)
					let cs = mut ? tok.substring(tok, wrap:<u64>(x + 1))
					let cnt = mut ? cs.parseS64(cs)
					? chunk.pushBack(chunk, cnt * 8)
					? fieldSize.pushBack(fieldSize, e * cnt)
					? elemSize.pushBack(elemSize, e)
					? elemCount.pushBack(elemCount, cnt)
					continue
				}
				let ns = mut ? tok.substring(tok, 1)
				let n = mut ? ns.parseS64(ns)
				if tok.charAt(tok, 0) == 'm'{
					? chunk.pushBack(chunk, ((n + 7) / 8) * 8)
					? fieldSize.pushBack(fieldSize, n)
				} else{
					? chunk.pushBack(chunk, n)
					? fieldSize.pushBack(fieldSize, 0)
				}
				? elemSize.pushBack(elemSize, 0)
				? elemCount.pushBack(elemCount, 0)
			}
			}
		}
		let:<mut s64> total = mut 0
		let chunkN = mut len(chunk.backing)
		for ci in 0..chunkN{
			match ci in chunk.backing{ total = total + chunk.backing[ci] }
		}
		match Some(_self){ ? _self.rawLit(_self, "    movq %rsp, %r12") } // r12: the reversed field words on the stack
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ ? _self.hub.regForm.emitMallocCall(_self.hub.regForm, size) } } }
		match Some(_self){ ? _self.rawLit(_self, "    movq %rax, %r14") } // r14: the fresh buffer
		// A failed malloc leaves r14 null: skip every copy into it; the null is pushed and the bytecode's own check throws.
		let pre = mut ? String.from("new_done")
		let newRepackDone = mut ? new String()
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ newRepackDone = ? _self.hub.regForm.newInternalLabel(_self.hub.regForm, pre) } } }
		match Some(_self){ ? _self.rawLit(_self, "    testq %r14, %r14") }
		let jz = mut ? String.from("    jz ")
		match Some(newRepackDone){ ? jz.append(jz, newRepackDone) }
		match Some(_self){ ? _self.raw_(_self, jz) }
		let:<mut s64> dst = mut 0      // running true offset in the buffer
		let:<mut s64> consumed = mut 0 // bytes of chunks pushed so far (from the first field)
		for i in 0..chunkN{
			let:<mut s64> chI = mut 0
			let:<mut s64> s = mut 0
			let:<mut s64> esI = mut 0
			let:<mut s64> ecI = mut 0
			match i in chunk.backing{ chI = chunk.backing[i] }
			consumed = consumed + chI
			let:<mut s64> chunkBase = mut (total - consumed) // this chunk's lowest address, relative to r12
			match i in fieldSize.backing{ s = fieldSize.backing[i] }
			if s == 0{
				dst = dst + chI // padding gap: bytes in the buffer stay whatever malloc left
				continue
			}
			match i in elemSize.backing{ esI = elemSize.backing[i] }
			if esI > 0{
				match i in elemCount.backing{ ecI = elemCount.backing[i] }
				let:<mut u64> cntU = mut wrap:<u64>(ecI)
				for k in 0..cntU{
					let:<mut s64> kk = mut wrap:<s64>(k)
					match Some(_self){ ? _self.copyBytesR12ToR14(_self, chunkBase + (ecI - 1 - kk) * 8, dst + kk * esI, esI) }
				}
				dst = dst + s
				continue
			}
			let:<mut s64> words = mut ((s + 7) / 8)
			let:<mut u64> wU = mut wrap:<u64>(words)
			for k in 0..wU{
				let:<mut s64> kk = mut wrap:<s64>(k)
				let:<mut s64> bytes = mut (s - 8 * kk)
				if bytes > 8{
					bytes = 8
				}
				let:<mut s64> srcOff = mut 0
				if words > 1{
					srcOff = chunkBase + (words - 1 - kk) * 8
				} else{
					srcOff = chunkBase
				}
				match Some(_self){ ? _self.copyBytesR12ToR14(_self, srcOff, dst + 8 * kk, bytes) }
			}
			dst = dst + s
		}
		let lb = mut ? new String()
		match Some(newRepackDone){ lb = ? newRepackDone.substring(newRepackDone, 0) }
		? lb.append(lb, ":")
		match Some(_self){ ? _self.raw_(_self, lb) }
		let ad = mut ? String.from("    addq $")
		? ad.appendS64(ad, total)
		? ad.append(ad, ", %rsp")
		match Some(_self){ ? _self.raw_(_self, ad) }
		let r14 = mut ? String.from("r14")
		match Some(_self){ ? _self.pushReg(_self, r14) }
	}

	@pub
	@throws
	func emitAssignRepack(_self: ref some mut self, size: mut s64, line: ref imut BytecodeStatement) void{
		?catch(e){ throw e }
		// One entry per layout token: chunk = bytes it occupies on the stack, fieldSize = real bytes (0 for a padding gap),
		// elemSize/count > 0 for "a<elemBytes>x<n>" (a fixed array written element by element: n whole words, one per element).
		let chunk = mut ? new DynamicArray:<s64>()
		let fieldSize = mut ? new DynamicArray:<s64>()
		let elemSize = mut ? new DynamicArray:<s64>()
		let elemCount = mut ? new DynamicArray:<s64>()
		let:<mut u64> lineLen = mut 0
		match Some(line){ lineLen = line.items.size(line.items) }
		for i in 4..lineLen{
			match Some(line){
			let tokTok = line.items.get(line.items, i)
			match Some(tokTok){
				let tok = tokTok.text
				let kind = mut tok.charAt(tok, 0)
				if kind == 'a'{
					let x = mut tok.indexOf(tok, 'x')
					let es = mut ? tok.substring(tok, 1, wrap:<u64>(x))
					let e = mut ? es.parseS64(es)
					let cs = mut ? tok.substring(tok, wrap:<u64>(x + 1))
					let cnt = mut ? cs.parseS64(cs)
					? chunk.pushBack(chunk, cnt * 8)
					? fieldSize.pushBack(fieldSize, e * cnt)
					? elemSize.pushBack(elemSize, e)
					? elemCount.pushBack(elemCount, cnt)
					continue
				}
				let ns = mut ? tok.substring(tok, 1)
				let n = mut ? ns.parseS64(ns)
				if kind == 'm'{
					? chunk.pushBack(chunk, ((n + 7) / 8) * 8)
					? fieldSize.pushBack(fieldSize, n)
				} else{
					? chunk.pushBack(chunk, n)
					? fieldSize.pushBack(fieldSize, 0)
				}
				? elemSize.pushBack(elemSize, 0)
				? elemCount.pushBack(elemCount, 0)
			}
			}
		}
		let:<mut s64> total = mut 0
		let chunkN = mut len(chunk.backing)
		for ci in 0..chunkN{
			match ci in chunk.backing{ total = total + chunk.backing[ci] }
		}
		match Some(_self){ ? _self.rawLit(_self, "    movq %rsp, %r10") }
		let l2 = mut ? String.from("    movq ")
		? l2.appendS64(l2, total)
		? l2.append(l2, "(%rsp), %r11")
		match Some(_self){ ? _self.raw_(_self, l2) }
		let r10 = mut ? String.from("r10")
		let r11 = mut ? String.from("r11")
		let:<mut s64> dst = mut 0
		let:<mut s64> consumed = mut 0
		for i in 0..chunkN{
			let:<mut s64> chI = mut 0
			let:<mut s64> s = mut 0
			let:<mut s64> esI = mut 0
			let:<mut s64> ecI = mut 0
			match i in chunk.backing{ chI = chunk.backing[i] }
			consumed = consumed + chI
			let:<mut s64> chunkBase = mut (total - consumed)
			match i in fieldSize.backing{ s = fieldSize.backing[i] }
			if s == 0{
				dst = dst + chI
				continue
			}
			match i in elemSize.backing{ esI = elemSize.backing[i] }
			if esI > 0{
				match i in elemCount.backing{ ecI = elemCount.backing[i] }
				let:<mut u64> cntU = mut wrap:<u64>(ecI)
				for k in 0..cntU{
					let:<mut s64> kk = mut wrap:<s64>(k)
					// element k was pushed k-th, so the last element sits nearest %rsp
					match Some(_self){ ? _self.copyBytes(_self, r10, chunkBase + (ecI - 1 - kk) * 8, r11, dst + kk * esI, esI) }
				}
				dst = dst + s
				continue
			}
			let:<mut s64> words = mut ((s + 7) / 8)
			let:<mut u64> wU = mut wrap:<u64>(words)
			for k in 0..wU{
				let:<mut s64> kk = mut wrap:<s64>(k)
				let:<mut s64> bytes = mut (s - 8 * kk)
				if bytes > 8{
					bytes = 8
				}
				let:<mut s64> srcOff = mut 0
				if words > 1{
					srcOff = chunkBase + (words - 1 - kk) * 8
				} else{
					srcOff = chunkBase
				}
				match Some(_self){ ? _self.copyBytes(_self, r10, srcOff, r11, dst + 8 * kk, bytes) }
			}
			dst = dst + s
		}
		let l3 = mut ? String.from("    addq $")
		? l3.appendS64(l3, total + 8)
		? l3.append(l3, ", %rsp")
		match Some(_self){ ? _self.raw_(_self, l3) }
	}

	@pub
	@throws
	func copyBytes(_self: ref some mut self, srcReg: ref imut String, srcOff: mut s64, dstReg: ref imut String, dstOff: mut s64, n: mut s64) void{
		?catch(e){ throw e }
		let rax = mut ? String.from("rax")
		let:<mut s64> done = mut 0
		let:<mut u64> rounds = mut 0
		if n > 0{
			rounds = wrap:<u64>(n)
		}
		for step in 0..rounds{
			if done >= n{
				break
			}
			let:<mut s64> left = mut (n - done)
			let:<mut s32> w = mut X86Emit.widthFor(left)
			let:<mut s64> so = mut (srcOff + done)
			let:<mut s64> dof = mut (dstOff + done)
			let ln403 = mut ? String.from("    mov")
			match Some(_self){ ? ln403.append(ln403, _self.movSuffix(_self, w)) }
			? ln403.append(ln403, " ")
			? ln403.appendS64(ln403, so)
			? ln403.append(ln403, "(%")
			match Some(srcReg){ ? ln403.append(ln403, srcReg) }
			? ln403.append(ln403, "), %")
			let t2 = mut ? new String()
			match Some(_self){ match Some(rax){ t2 = ? _self.sizedReg(_self, rax, w) } }
			? ln403.append(ln403, t2)
			match Some(_self){ ? _self.raw_(_self, ln403) }
			let ln404 = mut ? String.from("    mov")
			match Some(_self){ ? ln404.append(ln404, _self.movSuffix(_self, w)) }
			? ln404.append(ln404, " %")
			let t3 = mut ? new String()
			match Some(_self){ match Some(rax){ t3 = ? _self.sizedReg(_self, rax, w) } }
			? ln404.append(ln404, t3)
			? ln404.append(ln404, ", ")
			? ln404.appendS64(ln404, dof)
			? ln404.append(ln404, "(%")
			match Some(dstReg){ ? ln404.append(ln404, dstReg) }
			? ln404.append(ln404, ")")
			match Some(_self){ ? _self.raw_(_self, ln404) }
			done = done + (w as s64)
		}
	}

	@pub
	@throws
	func copyBytesR12ToR14(_self: ref some mut self, srcOff: mut s64, dstOff: mut s64, n: mut s64) void{
		?catch(e){ throw e }
		let rax = mut ? String.from("rax")
		let:<mut s64> done = mut 0
		let:<mut u64> rounds = mut 0
		if n > 0{
			rounds = wrap:<u64>(n)
		}
		for step in 0..rounds{
			if done >= n{
				break
			}
			let:<mut s64> left = mut (n - done)
			let:<mut s32> w = mut X86Emit.widthFor(left)
			let:<mut s64> so = mut (srcOff + done)
			let:<mut s64> dof = mut (dstOff + done)
			let ln405 = mut ? String.from("    mov")
			match Some(_self){ ? ln405.append(ln405, _self.movSuffix(_self, w)) }
			? ln405.append(ln405, " ")
			? ln405.appendS64(ln405, so)
			? ln405.append(ln405, "(%")
			? ln405.append(ln405, "r12), %")
			let t4 = mut ? new String()
			match Some(_self){ match Some(rax){ t4 = ? _self.sizedReg(_self, rax, w) } }
			? ln405.append(ln405, t4)
			match Some(_self){ ? _self.raw_(_self, ln405) }
			let ln406 = mut ? String.from("    mov")
			match Some(_self){ ? ln406.append(ln406, _self.movSuffix(_self, w)) }
			? ln406.append(ln406, " %")
			let t5 = mut ? new String()
			match Some(_self){ match Some(rax){ t5 = ? _self.sizedReg(_self, rax, w) } }
			? ln406.append(ln406, t5)
			? ln406.append(ln406, ", ")
			? ln406.appendS64(ln406, dof)
			? ln406.append(ln406, "(%")
			? ln406.append(ln406, "r14)")
			match Some(_self){ ? _self.raw_(_self, ln406) }
			done = done + (w as s64)
