	@pub
	@throws
	func emitShiftCore(_self: ref some mut self, op: ref imut String, size: mut s32, v: ref imut String) void{
		?catch(e){ throw e }
		let isSar = mut false
		let left = mut false
		match Some(op){
			isSar = op.equals(op, "SAR")
			left = op.equals(op, "SHL")
		}
		if isSar{
			match Some(_self){ ? _self.signExtendReg(_self, v, size) }
			let sc = mut ? X86Core_rfScratch()
			match Some(_self){ ? _self.movImmToReg(_self, sc, 63) }
			let l1 = mut ? String.from("    cmpq %")
			? l1.append(l1, sc)
			? l1.append(l1, ", %rcx")
			match Some(_self){ ? _self.raw_(_self, l1) }
			let l2 = mut ? String.from("    cmovaq %")
			? l2.append(l2, sc)
			? l2.append(l2, ", %rcx")
			match Some(_self){ ? _self.raw_(_self, l2) }
			let l3 = mut ? String.from("    sarq %cl, %")
			match Some(v){ ? l3.append(l3, v) }
			match Some(_self){ ? _self.raw_(_self, l3) }
			match Some(_self){ ? _self.zeroExtendReg(_self, v, size) }
			return
		}
		if left == false{
			match Some(_self){ ? _self.zeroExtendReg(_self, v, size) }
		}
		let l4 = mut ? String.from("    shrq %cl, %")
		if left{
			l4 = ? String.from("    shlq %cl, %")
		}
		match Some(v){ ? l4.append(l4, v) }
		match Some(_self){ ? _self.raw_(_self, l4) }
		match Some(_self){ ? _self.rawLit(_self, "    cmpq $64, %rcx") }
		match Some(_self){ ? _self.rawLit(_self, "    sbbq %rcx, %rcx") }
		let l5 = mut ? String.from("    andq %rcx, %")
		match Some(v){ ? l5.append(l5, v) }
		match Some(_self){ ? _self.raw_(_self, l5) }
		if left{
			match Some(_self){ ? _self.zeroExtendReg(_self, v, size) }
		}
	}

	@pub
	@throws
	func emitShiftBmi2(_self: ref some mut self, op: ref imut String, size: mut s32, v: ref imut String, cnt: ref imut String) void{
		?catch(e){ throw e }
		let left = mut false
		match Some(op){ left = op.equals(op, "SHL") }
		if left == false{
			match Some(_self){ ? _self.zeroExtendReg(_self, v, size) }
		}
		let shiftOp = mut ? new String()
		if left{
			shiftOp = ? String.from("shlxq")
		} else{
