	@pub
	@throws
	func emitFunctionEpilogue(_self: ref some mut self) void{
		?catch(e){ throw e }
		let ln309 = mut ? X86Core_csrMark()
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln309) } } }
		let ln310 = mut ? String.from("    movq %rbp, %rsp")
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln310) } } }
		let rbp = mut ? String.from("rbp")
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.popReg(_self.hub.emit, rbp) } } }
		let ln311 = mut ? String.from("    ret")
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln311) } } }
	}
}
