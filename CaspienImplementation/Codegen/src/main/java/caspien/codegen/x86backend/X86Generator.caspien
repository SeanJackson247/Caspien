	@pub
	@throws
	func finishCalleeSaved(_self: ref some mut self) void{
		?catch(e){ throw e }
		let:<mut s32> start = mut -1
		let:<mut s64> frameBytes = mut 0
		let win = mut false
		match Some(_self){ match Some(_self.core){
			start = _self.core.csrFuncStart
			frameBytes = _self.core.csrAllocSum
		} }
		if start < 0{
			return
		}
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ win = _self.hub.emit.isWinAbi(_self.hub.emit) } } }
		let body = mut ? new String()
		match Some(_self){ match Some(_self.core){ body = ? _self.core.out.substring(_self.core.out, wrap:<u64>(start)) } }
		let none = mut ? new String()
		let dwb = mut ? new String("dwb")
		let regs = mut ? new ObjectList:<ObjectList:<String>>() // {name, kind gpr|xmm}
		let rbxNames = mut ? CodegenText.rbxNames()
		if Text.containsAnyWord(body, rbxNames, none){
			let pr = mut ? new ObjectList:<String>()
			let pn = mut ? new String("rbx")
			let pk = mut ? new String("gpr")
			? pr.add(pr, pn)
			? pr.add(pr, pk)
			? regs.add(regs, pr)
		}
		for r in 12..16{
			let rname = mut ? String.from("r")
			? rname.appendS64(rname, wrap:<s64>(r))
			if Text.containsWord(body, rname, dwb, false){
				let pr = mut ? new ObjectList:<String>()
				let pk = mut ? new String("gpr")
				? pr.add(pr, rname)
				? pr.add(pr, pk)
				? regs.add(regs, pr)
			}
		}
		if win{
			let rdiNames = mut ? CodegenText.rdiNames()
			if Text.containsAnyWord(body, rdiNames, none){
				let pr = mut ? new ObjectList:<String>()
				let pn = mut ? new String("rdi")
				let pk = mut ? new String("gpr")
				? pr.add(pr, pn)
				? pr.add(pr, pk)
				? regs.add(regs, pr)
			}
			let rsiNames = mut ? CodegenText.rsiNames()
			if Text.containsAnyWord(body, rsiNames, none){
				let pr = mut ? new ObjectList:<String>()
				let pn = mut ? new String("rsi")
				let pk = mut ? new String("gpr")
				? pr.add(pr, pn)
				? pr.add(pr, pk)
				? regs.add(regs, pr)
			}
			for x in 6..16{
				let xname = mut ? String.from("xmm")
				? xname.appendS64(xname, wrap:<s64>(x))
				if Text.containsWord(body, xname, none, false){
					let pr = mut ? new ObjectList:<String>()
					let pk = mut ? new String("xmm")
					? pr.add(pr, xname)
					? pr.add(pr, pk)
					? regs.add(regs, pr)
				}
			}
		}
		let restoreText = mut ? String.from("")
		// forced: Arrays.fill(vSlots, null) as a loop of setAt(i, null)
		let:<mut u64> nSlots = mut 0
		match Some(_self){ match Some(_self.core){ nSlots = _self.core.vSlots.size(_self.core.vSlots) } }
		for z in 0..nSlots{
			match Some(_self){ match Some(_self.core){ _self.core.vSlots.setAt(_self.core.vSlots, z, null) } }
		}
		if regs.isEmpty(regs) == false{
			let noAlloc = mut false
			match Some(_self){ match Some(_self.core){ noAlloc = _self.core.csrAllocPos < 0 } }
			if noAlloc{
				// no locals at all (no ALLOC line): make the frame ourselves, right after the prologue
				let blankLine = mut ? String.from("")
				match Some(_self){ match Some(_self.core){
					_self.core.csrAllocPos = _self.core.csrFuncStart
					_self.core.csrAllocBytes = 0
					_self.core.csrAllocLine = blankLine
