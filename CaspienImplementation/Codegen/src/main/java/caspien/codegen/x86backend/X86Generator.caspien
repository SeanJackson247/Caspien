			// forced: Arrays.fill(vSlots, null) as a loop of setAt(i, null)
			for z2 in 0..nSlots{
				match Some(_self){ match Some(_self.core){ _self.core.vSlots.setAt(_self.core.vSlots, z2, null) } }
			}
			let:<mut s32> needMask = mut 0
			match Some(_self){ needMask = ? _self.varMarksNeeded(_self, start) }
			for vi in 0..3{
				let:<mut s32> varMask = mut 0
				match Some(_self){ match Some(_self.core){ varMask = _self.core.rfVarMask } }
				let:<mut s32> one = mut 1
				if bits_and(bits_and(varMask, needMask), bits_left(one, wrap:<s32>(vi))) != 0{
					cur = cur + 8
					let slot = mut ? String.from("-")
					? slot.appendS64(slot, cur)
					? slot.append(slot, "(%rbp)")
					match Some(_self){ match Some(_self.core){ _self.core.vSlots.setAt(_self.core.vSlots, vi, slot) } }
				}
			}
			let:<mut s64> fifteen = mut 15
			let:<mut s64> notMask = mut bits_not(fifteen)
			let total = mut bits_and(cur + 15, notMask)
			let:<mut s64> allocSum = mut 0
			let:<mut s64> allocBytes = mut 0
			match Some(_self){ match Some(_self.core){
				allocSum = _self.core.csrAllocSum
				allocBytes = _self.core.csrAllocBytes
			} }
			frameBytes = allocSum - allocBytes + total
