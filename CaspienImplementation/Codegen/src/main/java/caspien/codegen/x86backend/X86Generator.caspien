				throw "codegen internal error: ALLOC line moved"
			}
			let replacement = mut ? String.from("")
			? replacement.append(replacement, newSub)
			? replacement.append(replacement, saves)
			match Some(_self){ match Some(_self.core){ ? _self.core.out.replaceRange(_self.core.out, wrap:<u64>(allocPos), wrap:<u64>(allocPos) + allocLen, replacement) } }
			restoreText = ? restores.substring(restores, 0)
		}
		match Some(_self){ ? _self.expandVarMarks(_self, start) }
		let:<mut u64> from = mut wrap:<u64>(start)
		let marked = mut ? X86Core_csrMark()
		? marked.append(marked, "\n")
		let:<mut s64> i = mut -1
		// forced: `loop` is unsafe-only and a while needs no bound in Java; a for over length()+1 (never reached, each pass advances `from`) with a break at the Java loop condition
		let bound2 = mut 0
		match Some(_self){ match Some(_self.core){ bound2 = _self.core.out.length(_self.core.out) + 1 } }
		for step2 in 0..bound2{
			match Some(_self){ match Some(_self.core){ i = _self.core.out.indexOf(_self.core.out, marked, from) } }
			if i < 0{
				break
			}
			match Some(_self){ match Some(_self.core){ ? _self.core.out.replaceRange(_self.core.out, wrap:<u64>(i), wrap:<u64>(i) + marked.length(marked), restoreText) } }
			from = wrap:<u64>(i) + restoreText.length(restoreText)
		}
		let rspMarked = mut ? X86Core_rspMark()
		? rspMarked.append(rspMarked, "\n")
