					// forced: a thrown message must be a literal, so the function and register names cannot be appended
					throw "codegen internal error: a function uses a callee-saved register before its frame is allocated"
				}
			}
			let:<mut s64> cur = mut 0
			match Some(_self){ match Some(_self.core){ cur = _self.core.csrAllocBytes } }
			let saves = mut ? new String()
			let restores = mut ? new String()
			for k2 in 0..nregs{
				let r0 = mut ? new String()
				let r1 = mut ? new String()
				let rr = regs.get(regs, k2)
				match Some(rr){
					let a0 = rr.get(rr, 0)
					match Some(a0){ r0 = ? a0.substring(a0, 0) }
				}
				match Some(rr){
					let a1 = rr.get(rr, 1)
					match Some(a1){ r1 = ? a1.substring(a1, 0) }
				}
				let x = mut r1.equals(r1, "xmm")
				let saveMn = mut ? new String()
				if x{
					cur = cur + 16
					saveMn = ? String.from("movups")
				} else{
					cur = cur + 8
					saveMn = ? String.from("movq")
				}
				let mem = mut ? String.from("-")
				? mem.appendS64(mem, cur)
				? mem.append(mem, "(%rbp)")
				let st = mut ? String.from("    ")
				? st.append(st, saveMn)
				? st.append(st, " %")
				? st.append(st, r0)
				? st.append(st, ", ")
				? st.append(st, mem)
				let ld = mut ? String.from("    ")
				? ld.append(ld, saveMn)
				? ld.append(ld, " ")
				? ld.append(ld, mem)
				? ld.append(ld, ", %")
				? ld.append(ld, r0)
				? saves.append(saves, st)
				? saves.append(saves, '\n')
