	@pub
	@throws
	func rfFloatX(_self: ref some mut self, op: ref imut String, n: mut s32, dstTok: ref imut String, aTok: ref imut String, bTok: ref imut String) void{
		?catch(e){ throw e }
		let:<owns mut String> xd = mut null
		match Some(_self){ match Some(dstTok){ xd = ? _self.xvStr(_self, dstTok) } }
		let isAdd = mut false
		let isSub = mut false
		let isMul = mut false
		let isDiv = mut false
		match Some(op){
			isAdd = op.equals(op, "ADD")
			isSub = op.equals(op, "SUB")
			isMul = op.equals(op, "MUL")
			isDiv = op.equals(op, "DIV")
		}
		if isAdd == false && isSub == false && isMul == false && isDiv == false{
			throw "unknown R_FBINX operator"
		}
		let mn = mut ? String.from("div")
		if isAdd{
			mn = ? String.from("add")
		} elseif isSub{
			mn = ? String.from("sub")
		} elseif isMul{
			mn = ? String.from("mul")
		}
		let:<owns mut String> sfx = mut null
		match Some(_self){ sfx = ? String.from(X86Generator.fsfx(n)) }
		if isMul{
			let other = mut ? new String()
			let hasOther = mut false
			match Some(_self){
				let o0 = ? _self.rfTimesTwoOperand(_self, n, aTok, bTok)
				match Some(o0){
					hasOther = true
					other = ? o0.substring(o0, 0)
				}
			}
			if hasOther{
				let oX = mut false
				match Some(other){ oX = X86Core.rfIsXvar(other) }
				if oX{
					let:<owns mut String> ox = mut null
					match Some(_self){ match Some(other){ ox = ? _self.xvStr(_self, other) } }
					match Some(_self){ ? _self.rfMovaps(_self, xd, ox) }
				} else{
					match Some(_self){ ? _self.rfLoadXmm(_self, other, xd, n) }
				}
				let la = mut ? String.from("    add")
				match Some(sfx){ ? la.append(la, sfx) }
				? la.append(la, " %")
				match Some(xd){ ? la.append(la, xd) }
				? la.append(la, ", %")
				match Some(xd){ ? la.append(la, xd) }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, la) } } }
				return
			}
		}
		let avx = mut false
		match Some(_self){ match Some(_self.core){ avx = _self.core.avx } }
		let aXv = mut false
		let bXv = mut false
		let bSlot = mut false
		let bImm = mut false
		match Some(aTok){ aXv = X86Core.rfIsXvar(aTok) }
		match Some(bTok){
			bXv = X86Core.rfIsXvar(bTok)
			bSlot = X86Core.rfIsSlot(bTok)
			bImm = X86Core.rfIsImm(bTok)
		}
		if avx{
			let ra = mut ? new String()
			if aXv{
				match Some(_self){ match Some(aTok){ ra = ? _self.xvStr(_self, aTok) } }
			} else{
				let bEq = mut false
				if bXv{
					let:<owns mut String> bs0 = mut null
					match Some(_self){ match Some(bTok){ bs0 = ? _self.xvStr(_self, bTok) } }
					match Some(bs0){ match Some(xd){ bEq = bs0.equals(bs0, xd) } }
				}
				if bXv && bEq{
					match Some(_self){ ra = ? _self.xmmAStr(_self) }
				} else{
					match Some(xd){ ra = ? xd.substring(xd, 0) }
				}
				match Some(_self){ ? _self.rfLoadXmm(_self, aTok, ra, n) }
			}
			let vb = mut ? new String()
			if bXv{
				let:<owns mut String> bs1 = mut null
				match Some(_self){ match Some(bTok){ bs1 = ? _self.xvStr(_self, bTok) } }
				vb = ? String.from("%")
				match Some(bs1){ ? vb.append(vb, bs1) }
			} elseif bSlot{
				let:<mut s64> so = mut 0
				match Some(bTok){ so = ? X86Core.rfSlot(bTok) }
				? vb.appendS64(vb, so)
				? vb.append(vb, "(%rbp)")
			} elseif bImm{
				let:<mut s64> bv = mut 0
				match Some(bTok){ bv = ? X86Core.rfImm(bTok) }
				match Some(_self){ vb = ? _self.floatPoolMem(_self, bv, n) }
			} else{
				let:<owns mut String> xb = mut null
				match Some(_self){ xb = ? _self.xmmBStr(_self) }
				match Some(_self){ ? _self.rfLoadXmm(_self, bTok, xb, n) }
				vb = ? String.from("%")
				match Some(xb){ ? vb.append(vb, xb) }
			}
			let lv = mut ? String.from("    v")
			match Some(mn){ ? lv.append(lv, mn) }
			match Some(sfx){ ? lv.append(lv, sfx) }
			? lv.append(lv, " ")
			match Some(vb){ ? lv.append(lv, vb) }
			? lv.append(lv, ", %")
			match Some(ra){ ? lv.append(lv, ra) }
			? lv.append(lv, ", %")
			match Some(xd){ ? lv.append(lv, xd) }
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, lv) } } }
			return
		}
		let commutative = mut (isAdd || isMul)
		let aT = mut ? new String()
		let bT = mut ? new String()
		match Some(aTok){ aT = ? aTok.substring(aTok, 0) }
		match Some(bTok){ bT = ? bTok.substring(bTok, 0) }
		let bIsDst = mut false
		let aIsDst = mut false
		if bXv{
			let:<owns mut String> bs2 = mut null
			match Some(_self){ match Some(bT){ bs2 = ? _self.xvStr(_self, bT) } }
			match Some(bs2){ match Some(xd){ bIsDst = bs2.equals(bs2, xd) } }
		}
		if aXv{
			let:<owns mut String> as2 = mut null
			match Some(_self){ match Some(aT){ as2 = ? _self.xvStr(_self, aT) } }
			match Some(as2){ match Some(xd){ aIsDst = as2.equals(as2, xd) } }
		}
		if bIsDst && aIsDst == false && commutative{
			let tmp = mut ? new String()
			match Some(aT){ tmp = ? aT.substring(aT, 0) }
			match Some(bT){ aT = ? bT.substring(bT, 0) }
			bT = tmp
			aIsDst = true
			bIsDst = false
		}
		let:<owns mut String> work = mut null
		match Some(xd){ work = ? xd.substring(xd, 0) }
		if bIsDst{
			match Some(_self){ work = ? _self.xmmAStr(_self) }
		}
		let bText = mut ? new String()
		let bXv2 = mut false
		let bSlot2 = mut false
		let bImm2 = mut false
		match Some(bT){
			bXv2 = X86Core.rfIsXvar(bT)
			bSlot2 = X86Core.rfIsSlot(bT)
			bImm2 = X86Core.rfIsImm(bT)
		}
		if bXv2{
			let:<owns mut String> bs3 = mut null
			match Some(_self){ match Some(bT){ bs3 = ? _self.xvStr(_self, bT) } }
			bText = ? String.from("%")
			match Some(bs3){ ? bText.append(bText, bs3) }
		} elseif bSlot2{
			let:<mut s64> off = mut 0
			match Some(bT){ off = ? X86Core.rfSlot(bT) }
			? bText.appendS64(bText, off)
			? bText.append(bText, "(%rbp)")
		} elseif bImm2{
			let:<mut s64> bv2 = mut 0
			match Some(bT){ bv2 = ? X86Core.rfImm(bT) }
			match Some(_self){ bText = ? _self.floatPoolMem(_self, bv2, n) }
		} else{
			let:<owns mut String> xb2 = mut null
			match Some(_self){ xb2 = ? _self.xmmBStr(_self) }
			match Some(_self){ ? _self.rfLoadXmm(_self, bT, xb2, n) }
			bText = ? String.from("%")
			match Some(xb2){ ? bText.append(bText, xb2) }
		}
		let aXv2 = mut false
		match Some(aT){ aXv2 = X86Core.rfIsXvar(aT) }
		if aXv2{
			let:<owns mut String> as3 = mut null
			match Some(_self){ match Some(aT){ as3 = ? _self.xvStr(_self, aT) } }
			match Some(_self){ ? _self.rfMovaps(_self, work, as3) }
		} else{
			match Some(_self){ ? _self.rfLoadXmm(_self, aT, work, n) }
		}
		let lm = mut ? String.from("    ")
		match Some(mn){ ? lm.append(lm, mn) }
		match Some(sfx){ ? lm.append(lm, sfx) }
		? lm.append(lm, " ")
		match Some(bText){ ? lm.append(lm, bText) }
		? lm.append(lm, ", %")
		match Some(work){ ? lm.append(lm, work) }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, lm) } } }
		match Some(_self){ ? _self.rfMovaps(_self, xd, work) }
	}

	@pub
	@throws
	func rfFloat(_self: ref some mut self, compare: mut bool, op: ref imut String, n: mut s32, dstTok: ref imut String, aTok: ref imut String, bTok: ref imut String) void{
		?catch(e){ throw e }
		match Some(_self){ ? _self.rfFloat(_self, compare, op, n, dstTok, aTok, bTok, null) }
	}

	@pub
	@throws
	func rfFloat(_self: ref some mut self, compare: mut bool, op: ref imut String, n: mut s32, dstTok: ref imut String, aTok: ref imut String, bTok: ref imut String, branchLabel: ref imut String) void{
		?catch(e){ throw e }
		let hasD = mut false
		let d = mut ? new String()
		match Some(dstTok){
			hasD = true
			match Some(_self){ d = ? _self.regStr(_self, dstTok) }
		}
		let:<owns mut String> xa = mut null
		match Some(_self){ xa = ? _self.xmmAStr(_self) }
		let isMul = mut false
		match Some(op){ isMul = op.equals(op, "MUL") }
		let:<owns mut String> sfx = mut null
		match Some(_self){ sfx = ? String.from(X86Generator.fsfx(n)) }
		if compare == false && isMul{
			let other = mut ? new String()
			let hasOther = mut false
			match Some(_self){
				let o0 = ? _self.rfTimesTwoOperand(_self, n, aTok, bTok)
				match Some(o0){
					hasOther = true
					other = ? o0.substring(o0, 0)
				}
			}
			if hasOther{
				match Some(_self){ ? _self.rfLoadXmm(_self, other, xa, n) }
				let la = mut ? String.from("    add")
				match Some(sfx){ ? la.append(la, sfx) }
				? la.append(la, " %")
				match Some(xa){ ? la.append(la, xa) }
				? la.append(la, ", %")
				match Some(xa){ ? la.append(la, xa) }
				match Some(_self){ ? _self.rawS(_self, la) }
				if hasD == false{
					throw "no destination"
				}
				match Some(_self){ ? _self.rfXmmToGpr(_self, xa, d, n) }
				return
			}
		}
		let:<owns mut String> xb = mut null
		match Some(_self){ xb = ? _self.xmmBStr(_self) }
		let aXv = mut false
		match Some(aTok){ aXv = X86Core.rfIsXvar(aTok) }
		let aDirect = mut (compare && aXv)
		if aDirect == false{
			match Some(_self){ ? _self.rfLoadXmm(_self, aTok, xa, n) }
		} else{
			match Some(_self){ match Some(aTok){ xa = ? _self.xvStr(_self, aTok) } }
		}
		let bXv = mut false
		let bSlot = mut false
		let bImm = mut false
		match Some(bTok){
			bXv = X86Core.rfIsXvar(bTok)
			bSlot = X86Core.rfIsSlot(bTok)
			bImm = X86Core.rfIsImm(bTok)
		}
		let bText = mut ? new String()
		if bXv{
			let:<owns mut String> bs = mut null
			match Some(_self){ match Some(bTok){ bs = ? _self.xvStr(_self, bTok) } }
			bText = ? String.from("%")
			match Some(bs){ ? bText.append(bText, bs) }
		} elseif bSlot{
			let:<mut s64> off = mut 0
			match Some(bTok){ off = ? X86Core.rfSlot(bTok) }
			? bText.appendS64(bText, off)
			? bText.append(bText, "(%rbp)")
		} elseif bImm{
			let:<mut s64> bv = mut 0
			match Some(bTok){ bv = ? X86Core.rfImm(bTok) }
			match Some(_self){ bText = ? _self.floatPoolMem(_self, bv, n) }
		} else{
			match Some(_self){ ? _self.rfLoadXmm(_self, bTok, xb, n) }
			bText = ? String.from("%")
			match Some(xb){ ? bText.append(bText, xb) }
		}
		let aText = mut ? String.from("%")
		match Some(xa){ ? aText.append(aText, xa) }
		let isAdd = mut false
		let isSub = mut false
		let isDiv = mut false
		let isEq = mut false
		let isNeq = mut false
		let isLt = mut false
		let isLtEq = mut false
		let isGt = mut false
		let isGtEq = mut false
		match Some(op){
			isAdd = op.equals(op, "ADD")
			isSub = op.equals(op, "SUB")
			isDiv = op.equals(op, "DIV")
			isEq = op.equals(op, "EQ")
			isNeq = op.equals(op, "NEQ")
			isLt = op.equals(op, "LT")
			isLtEq = op.equals(op, "LT_EQ")
			isGt = op.equals(op, "GT")
			isGtEq = op.equals(op, "GT_EQ")
		}
		if compare == false{
			let mn = mut ? new String()
			if isAdd{
				mn = ? String.from("add")
			} elseif isSub{
				mn = ? String.from("sub")
			} elseif isMul{
				mn = ? String.from("mul")
			} elseif isDiv{
				mn = ? String.from("div")
			} else{
				throw "unknown R_FBIN operator"
			}
			let lf = mut ? String.from("    ")
			match Some(mn){ ? lf.append(lf, mn) }
			match Some(sfx){ ? lf.append(lf, sfx) }
			? lf.append(lf, " ")
			match Some(bText){ ? lf.append(lf, bText) }
			? lf.append(lf, ", ")
			match Some(aText){ ? lf.append(lf, aText) }
			match Some(_self){ ? _self.rawS(_self, lf) }
			if hasD == false{
				throw "no destination"
			}
			match Some(_self){ ? _self.rfXmmToGpr(_self, xa, d, n) }
			return
		}
		let lu = mut ? String.from("    ucomi")
		match Some(sfx){ ? lu.append(lu, sfx) }
		? lu.append(lu, " ")
		match Some(bText){ ? lu.append(lu, bText) }
		? lu.append(lu, ", ")
		match Some(aText){ ? lu.append(lu, aText) }
		match Some(_self){ ? _self.rawS(_self, lu) }
		let hasLabel = mut false
		match Some(branchLabel){ hasLabel = true }
		if hasLabel{
			let jcc = mut ? new String()
			if isEq{
				jcc = ? String.from("jne")
			} elseif isNeq{
				jcc = ? String.from("je")
			} elseif isLt{
				jcc = ? String.from("jae")
			} elseif isLtEq{
				jcc = ? String.from("ja")
			} elseif isGtEq{
				jcc = ? String.from("jb")
			} elseif isGt{
				jcc = ? String.from("jbe")
			} else{
				throw "unknown R_BRC float operator"
			}
			let lj = mut ? String.from("    ")
			match Some(jcc){ ? lj.append(lj, jcc) }
			? lj.append(lj, " ")
			match Some(branchLabel){ ? lj.append(lj, branchLabel) }
			match Some(_self){ ? _self.rawS(_self, lj) }
			return
		}
		let setcc = mut ? new String()
		if isEq{
			setcc = ? String.from("sete")
		} elseif isNeq{
			setcc = ? String.from("setne")
		} elseif isLt{
			setcc = ? String.from("setb")
		} elseif isLtEq{
			setcc = ? String.from("setbe")
		} elseif isGtEq{
			setcc = ? String.from("setae")
		} elseif isGt{
			setcc = ? String.from("seta")
		} else{
			throw "unknown R_FCMP operator"
		}
		if hasD == false{
			throw "no destination"
		}
		match Some(_self){ ? _self.rfSetcc(_self, setcc, d) }
	}

	@pub
	@throws
	func rfSetcc(_self: ref some mut self, setcc: ref imut String, d: ref imut String) void{
		?catch(e){ throw e }
		let:<owns mut String> d8 = mut null
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(d){ d8 = ? _self.hub.emit.sizedReg(_self.hub.emit, d, 1) } } } }
		let ln106 = mut ? String.from("    ")
		match Some(setcc){ ? ln106.append(ln106, setcc) }
		? ln106.append(ln106, " %")
		match Some(d8){ ? ln106.append(ln106, d8) }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln106) } } }
		let ln107 = mut ? String.from("    movzbq %")
		match Some(d8){ ? ln107.append(ln107, d8) }
		? ln107.append(ln107, ", %")
		match Some(d){ ? ln107.append(ln107, d) }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln107) } } }
	}

	@pub
	@throws
	func rfRmw(_self: ref some mut self, op: ref imut String, slotTok: ref imut String, srcTok: ref imut String) void{
		?catch(e){ throw e }
		let isVar = mut false
		match Some(slotTok){ isVar = X86Core.rfIsVar(slotTok) }
		let isInc = mut false
		let isDec = mut false
		let isAdd = mut false
		let isSub = mut false
		match Some(op){
			isInc = op.equals(op, "INC")
			isDec = op.equals(op, "DEC")
			isAdd = op.equals(op, "ADD")
			isSub = op.equals(op, "SUB")
		}
		let srcSlot = mut false
		match Some(srcTok){ srcSlot = X86Core.rfIsSlot(srcTok) }
		if isVar{
			let vr = mut ? new String()
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ match Some(slotTok){
				vr = ? _self.hub.regForm.rfReg(_self.hub.regForm, slotTok)
			} } } }
			if isInc{
				let ln = mut ? String.from("    incq %")
				? ln.append(ln, vr)
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln) } } }
				return
			} elseif isDec{
				let ln = mut ? String.from("    decq %")
				? ln.append(ln, vr)
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln) } } }
				return
			} elseif isAdd || isSub{
				let mn = mut ? String.from("add")
				if isAdd == false{
					mn = ? String.from("sub")
				}
				// forced: rfRegText takes only a literal register name; rfRegText(vr) is "%" + vr
				let vrText = mut ? String.from("%")
				? vrText.append(vrText, vr)
				if srcSlot{
					let scratch = mut ? X86Core_rfScratch()
					let:<mut s64> so = mut 0
					match Some(srcTok){ so = ? X86Core.rfSlot(srcTok) }
					match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.movMemToReg(_self.hub.emit, scratch, so) } } }
					let scratchText = mut ? new String()
					let scx3 = mut ? X86Core_rfScratch()
					match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ scratchText = ? _self.hub.regForm.rfRegTextOf(_self.hub.regForm, scx3) } } }
					match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ ? _self.hub.regForm.rfOp2(_self.hub.regForm, mn, vrText, scratchText) } } }
				} else{
					let:<owns mut String> src = mut null
					match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ match Some(srcTok){ src = ? _self.hub.regForm.rfSrc(_self.hub.regForm, srcTok) } } } }
					match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ ? _self.hub.regForm.rfOp2(_self.hub.regForm, mn, vrText, src) } } }
				}
				return
			} else{
				throw "unknown R_RMW operator"
			}
		}
		let mem = mut ? new String()
		match Some(slotTok){
			let off = mut ? X86Core.rfSlot(slotTok)
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ mem = ? _self.hub.regForm.rfMemText(_self.hub.regForm, off) } } }
		}
		if isInc{
			let ln = mut ? String.from("    incq ")
			? ln.append(ln, mem)
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln) } } }
			return
		} elseif isDec{
			let ln = mut ? String.from("    decq ")
			? ln.append(ln, mem)
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln) } } }
			return
		} elseif isAdd || isSub{
			let mn = mut ? String.from("add")
			if isAdd == false{
				mn = ? String.from("sub")
			}
			if srcSlot{
				let scratch = mut ? X86Core_rfScratch()
				let:<mut s64> so = mut 0
				match Some(srcTok){ so = ? X86Core.rfSlot(srcTok) }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.movMemToReg(_self.hub.emit, scratch, so) } } }
				let scratchText = mut ? new String()
				let scx4 = mut ? X86Core_rfScratch()
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ scratchText = ? _self.hub.regForm.rfRegTextOf(_self.hub.regForm, scx4) } } }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ ? _self.hub.regForm.rfOp2(_self.hub.regForm, mn, mem, scratchText) } } }
			} else{
				let:<owns mut String> src = mut null
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ match Some(srcTok){ src = ? _self.hub.regForm.rfSrc(_self.hub.regForm, srcTok) } } } }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ ? _self.hub.regForm.rfOp2(_self.hub.regForm, mn, mem, src) } } }
			}
			return
		} else{
			throw "unknown R_RMW operator"
		}
	}

	@pub
	static func fsfx(n: mut s32) static imut string{
		if n == 4{
			return "ss"
		}
		return "sd"
	}

	@pub
	static func widthSfx(w: mut s32) static imut string{
		if w == 8{
			return "sd"
		}
		return "ss"
	}

	@pub
	static func fmov(n: mut s32) static imut string{
		if n == 8{
			return "movsd"
		}
		return "movss"
	}

	static func maskIf4(v: mut s64, n: mut s32) mut s64{
		if n == 4{
			return bits_and(v, 0xFFFFFFFF)
		}
		return v
	}

	static func maskUnless8(v: mut s64, n: mut s32) mut s64{
		if n == 8{
			return v
		}
		return bits_and(v, 0xFFFFFFFF)
	}

	@pub
	@throws
	func mangleLabel(_self: ref some mut self, text: ref some imut String) owns some mut String{
		?catch(e){ throw e }
		let r = mut ? text.replace(text, "@", "L_")
		return r
	}

	@pub
	@throws
	func movRegToRegRbpFromRsp(_self: ref some mut self) void{
		?catch(e){ throw e }
		let ln112 = mut ? String.from("    movq %rsp, %rbp")
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln112) } } }
	}

	@pub
	@throws
	func varMarksNeeded(_self: ref some mut self, start: mut s32) mut s32{
		?catch(e){ throw e }
		let regs = mut ? new ObjectList:<String>()
		let rn0 = mut ? new String("r13")
		let rn1 = mut ? new String("r14")
		let rn2 = mut ? new String("r12")
		? regs.add(regs, rn0)
		? regs.add(regs, rn1)
		? regs.add(regs, rn2)
		let sm = mut ? X86Core_v1314Save()
		? sm.append(sm, "\n")
		let rm = mut ? X86Core_v1314Rest()
		? rm.append(rm, "\n")
		let dwb = mut ? new String("dwb")
		let:<mut s32> mask = mut 0
		let:<mut u64> from = mut 0
		if start > 0{
			from = wrap:<u64>(start)
		}
		let:<mut s64> i = mut -1
		// forced: `loop` is unsafe-only and a while needs no bound in Java; a for over length()+1 (never reached, each pass advances `from`) with a break at the Java loop condition
		let bound0 = mut 0
		match Some(_self){ match Some(_self.core){ bound0 = _self.core.out.length(_self.core.out) + 1 } }
		for step0 in 0..bound0{
			match Some(_self){ match Some(_self.core){ i = _self.core.out.indexOf(_self.core.out, sm, from) } }
			if i < 0{
				break
			}
			let:<mut u64> segStart = mut wrap:<u64>(i)
			segStart = segStart + sm.length(sm)
			let:<mut s64> j = mut -1
			match Some(_self){ match Some(_self.core){ j = _self.core.out.indexOf(_self.core.out, rm, segStart) } }
			if j < 0{
				break
			}
			let seg = mut ? new String()
			match Some(_self){ match Some(_self.core){ seg = ? _self.core.out.substring(_self.core.out, segStart, wrap:<u64>(j)) } }
			for vi in 0..3{
				let hit = mut false
				let nm = regs.get(regs, vi)
				match Some(nm){ hit = Text.containsWord(seg, nm, dwb, false) }
				if hit{
					let:<mut s32> one = mut 1
					mask = bits_or(mask, bits_left(one, wrap:<s32>(vi)))
				}
			}
			from = wrap:<u64>(j) + rm.length(rm)
		}
		return mask
	}

	@pub
	@throws
	func expandVarMarks(_self: ref some mut self, start: mut s32) void{
		?catch(e){ throw e }
		let regs = mut ? new ObjectList:<String>()
		let rn0 = mut ? new String("r13")
		let rn1 = mut ? new String("r14")
		let rn2 = mut ? new String("r12")
		? regs.add(regs, rn0)
		? regs.add(regs, rn1)
		? regs.add(regs, rn2)
		let sm = mut ? X86Core_v1314Save()
		? sm.append(sm, "\n")
		let rm = mut ? X86Core_v1314Rest()
		? rm.append(rm, "\n")
		let dwb = mut ? new String("dwb")
		let:<mut u64> from = mut 0
		if start > 0{
			from = wrap:<u64>(start)
		}
		let:<mut s64> i = mut -1
		// forced: `loop` is unsafe-only and a while needs no bound in Java; a for over length()+1 (never reached, each pass advances `from`) with a break at the Java loop condition
		let bound1 = mut 0
		match Some(_self){ match Some(_self.core){ bound1 = _self.core.out.length(_self.core.out) + 1 } }
		for step1 in 0..bound1{
			match Some(_self){ match Some(_self.core){ i = _self.core.out.indexOf(_self.core.out, sm, from) } }
			if i < 0{
				break
			}
			let:<mut u64> segStart = mut wrap:<u64>(i)
			segStart = segStart + sm.length(sm)
			let:<mut s64> j = mut -1
			match Some(_self){ match Some(_self.core){ j = _self.core.out.indexOf(_self.core.out, rm, segStart) } }
			if j < 0{
