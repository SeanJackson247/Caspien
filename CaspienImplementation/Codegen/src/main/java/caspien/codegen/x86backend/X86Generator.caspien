			? newSub.appendS64(newSub, total)
			? newSub.append(newSub, ", %rsp\n")
			let:<mut u64> allocLen = mut 0
			let same = mut false
			let current = mut ? new String()
			match Some(_self){ match Some(_self.core){
				match Some(_self.core.csrAllocLine){ allocLen = _self.core.csrAllocLine.length(_self.core.csrAllocLine) }
			} }
			match Some(_self){ match Some(_self.core){ current = ? _self.core.out.substring(_self.core.out, wrap:<u64>(allocPos), wrap:<u64>(allocPos) + allocLen) } }
			match Some(_self){ match Some(_self.core){
				match Some(_self.core.csrAllocLine){ same = current.equals(current, _self.core.csrAllocLine) }
			} }
			if same == false{
