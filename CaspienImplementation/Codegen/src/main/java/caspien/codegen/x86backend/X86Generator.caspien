		}
		if isT{
			let rr = mut ? new String()
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ match Some(baseTok){
				rr = ? _self.hub.regForm.rfReg(_self.hub.regForm, baseTok)
