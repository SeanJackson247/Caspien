			let lt = mut ? String.from(".section .rdata,\"dr\"")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, lt) } } }
		} else{
			let lt = mut ? String.from(".section .rodata")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, lt) } } }
		}
		let cnt = mut 0
		match Some(_self){ match Some(_self.core){ cnt = _self.core.floatPool.size(_self.core.floatPool) } }
		// forced: StringMap has no keySet(); the keys are walked by index (keyAt), the value is then looked up by key as in Java
		for i in 0..cnt{
			let key = mut ? new String()
			let value = mut ? new String()
			match Some(_self){ match Some(_self.core){
				let k0 = _self.core.floatPool.keyAt(_self.core.floatPool, i)
				match Some(k0){ key = ? k0.substring(k0, 0) }
			} }
			match Some(_self){ match Some(_self.core){
				let v0 = _self.core.floatPool.get(_self.core.floatPool, key)
				match Some(v0){ value = ? v0.substring(v0, 0) }
			} }
