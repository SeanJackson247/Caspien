@pub
impl constructor for X86Generator(hub: ref some mut X86Backend) self{
	return X86Generator{hub= hub, core= ref hub.core}
}

@pub
impl X86Generator{
	@pub
	@throws
	func generate(_self: ref some mut self, lines: ref some mut ObjectList<BytecodeStatement>) owns mut String{
		?catch(e){ throw e }
		let empty0 = mut ? new String()
		// forced: String has no setLength; replaceRange over the whole text with "" empties the same object in place
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.core){ ? _self.hub.core.out.replaceRange(_self.hub.core.out, 0, _self.hub.core.out.length(_self.hub.core.out), empty0) } } }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.core){ ? _self.hub.core.globalsSizeInit.clear(_self.hub.core.globalsSizeInit) } } }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.core){ ? _self.hub.core.globalsHasInit.clear(_self.hub.core.globalsHasInit) } } }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.core){ ? _self.hub.core.stringLiterals.clear(_self.hub.core.stringLiterals) } } }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.core){ ? _self.hub.core.floatPool.clear(_self.hub.core.floatPool) } } }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.core){ ? _self.hub.core.globalAliasOffset.clear(_self.hub.core.globalAliasOffset) } } }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.core){ ? _self.hub.core.aliasInits.clear(_self.hub.core.aliasInits) } } }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.core){ ? _self.hub.core.globalAliasParent.clear(_self.hub.core.globalAliasParent) } } }
		match Some(lines){ match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.collectDeclarations(_self.hub.emit, lines) } } } }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.emitHeader(_self.hub.emit) } } }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.emitDataSections(_self.hub.emit) } } }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.rawLit(_self.hub.emit, ".text") } } }
		match Some(lines){ match Some(_self){ match Some(_self.hub){ match Some(_self.hub.core){ _self.hub.core.allLines = lines } } } }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.precomputeConstructionOffsets(_self.hub.emit) } } }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.core){ ? _self.hub.core.callBufferStack.clear(_self.hub.core.callBufferStack) } } }
		// forced: DynamicArray has no clear(); popBack until empty
		let:<mut u64> pending = mut 0
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.core){ pending = len(_self.hub.core.argTrackDeltaStack.backing) } } }
		for pi in 0..pending{
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.core){ ? _self.hub.core.argTrackDeltaStack.popBack(_self.hub.core.argTrackDeltaStack, 0) } } }
		}
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.core){ _self.hub.core.argTrackSuspendDepth = 0 } } }
		let:<mut u64> total = mut 0
		match Some(lines){ total = lines.size(lines) }
		for li in 0..total{
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.core){ _self.hub.core.currentLineIndex = wrap:<s32>(li) } } }
			match Some(lines){
				let ln = lines.get(lines, li)
				match Some(ln){ match Some(_self){ match Some(_self.hub){ match Some(_self.hub.calls){ ? _self.hub.calls.emitLine(_self.hub.calls, ln) } } } }
			}
		}
		match Some(_self){ ? _self.emitFloatPool(_self) }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ _self.hub.emit.emitFooter(_self.hub.emit) } } }
		let:<owns mut String> result = mut null
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.core){ result = ? _self.hub.core.out.substring(_self.hub.core.out, 0) } } }
		return result
	}


	/** `regForm.rfReg` as an owned String (helper of the port; no Java counterpart). */
	@pub
	@throws
	func regStr(_self: ref some mut self, tok: ref imut String) owns some mut String{
		?catch(e){ throw e }
		let r = mut ? new String()
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ match Some(tok){
			r = ? _self.hub.regForm.rfReg(_self.hub.regForm, tok)
		} } } }
		return r
	}

	/** `rfIsTemp(tok) && rfReg(tok).equals(d)` (helper of the port). */
	@pub
	@throws
	func tempIsReg(_self: ref some mut self, tok: ref imut String, d: ref imut String) mut bool{
		?catch(e){ throw e }
		let t = mut false
		match Some(tok){ t = X86Core.rfIsTemp(tok) }
		if t == false{
			return false
		}
		let:<owns mut String> r = mut null
		match Some(_self){ match Some(tok){ r = ? _self.regStr(_self, tok) } }
		let eq = mut false
		match Some(r){ match Some(d){ eq = r.equals(r, d) } }
		return eq
	}

	/** "%" + reg (helper of the port). */
	@pub
	@throws
	func pct(_self: ref some mut self, reg: ref imut String) owns some mut String{
		?catch(e){ throw e }
		let r = mut ? String.from("%")
		match Some(reg){ ? r.append(r, reg) }
		return r
	}

	/** `emit.raw` (helper of the port). */
	@pub
	@throws
	func rawS(_self: ref some mut self, line: ref imut String) void{
		?catch(e){ throw e }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, line) } } }
	}

	/** `op2` through the register form with owned texts (helper of the port). */
	@pub
	@throws
	func op2S(_self: ref some mut self, op: static imut string, dst: ref imut String, src: ref imut String) void{
		?catch(e){ throw e }
		let o = mut ? String.from(op)
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ ? _self.hub.regForm.rfOp2(_self.hub.regForm, o, dst, src) } } }
	}

	@pub
	@throws
	func rfBin(_self: ref some mut self, op: ref imut String, size: mut s32, dstTok: ref imut String, aTok: ref imut String, bTok: ref imut String) void{
		?catch(e){ throw e }
		let isShift = mut false
		let isRot = mut false
		let isAdd = mut false
		let isSub = mut false
		let isMul = mut false
		let isAnd = mut false
		let isOr = mut false
		let isBand = mut false
		let isBor = mut false
		let isBxor = mut false
		let isEq = mut false
		let isNeq = mut false
		let first = mut ' '
		match Some(op){
			isShift = op.equals(op, "SHL") || op.equals(op, "SHR") || op.equals(op, "SAR")
			isRot = op.equals(op, "ROTL") || op.equals(op, "ROTR")
			isAdd = op.equals(op, "ADD")
			isSub = op.equals(op, "SUB")
			isMul = op.equals(op, "MUL")
			isAnd = op.equals(op, "AND")
			isOr = op.equals(op, "OR")
			isBand = op.equals(op, "BAND")
			isBor = op.equals(op, "BOR")
			isBxor = op.equals(op, "BXOR")
			isEq = op.equals(op, "EQ")
			isNeq = op.equals(op, "NEQ")
			if op.length(op) > 0{
				first = op.charAt(op, 0)
			}
		}
		if isShift{
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ ? _self.hub.regForm.rfShift(_self.hub.regForm, op, size, dstTok, aTok, bTok) } } }
			return
		}
		if isRot{
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ ? _self.hub.regForm.rfRotate(_self.hub.regForm, op, size, dstTok, aTok, bTok) } } }
			return
		}
		let:<owns mut String> d = mut null
		match Some(_self){ match Some(dstTok){ d = ? _self.regStr(_self, dstTok) } }
		let commutative = mut (isAdd || isMul || isAnd || isOr || isBand || isBor || isBxor || isEq || isNeq)
		let aT = mut ? new String()
		let bT = mut ? new String()
		match Some(aTok){ aT = ? aTok.substring(aTok, 0) }
		match Some(bTok){ bT = ? bTok.substring(bTok, 0) }
		let aImm = mut false
		let bImm = mut false
		match Some(aT){ aImm = X86Core.rfIsImm(aT) }
		match Some(bT){ bImm = X86Core.rfIsImm(bT) }
		if (isAdd || isMul || isBand || isBor || isBxor) && aImm && bImm == false{
			let sw = mut ? new String()
			match Some(aT){ sw = ? aT.substring(aT, 0) }
			match Some(bT){ aT = ? bT.substring(bT, 0) }
			bT = sw
		}
		match Some(aT){ aImm = X86Core.rfIsImm(aT) }
		match Some(bT){ bImm = X86Core.rfIsImm(bT) }
		if isMul && bImm && aImm == false{
			let:<mut s64> bv = mut 0
			match Some(bT){ bv = ? X86Core.rfImm(bT) }
			let done = mut false
			match Some(_self){ match Some(d){ done = ? _self.rfMulByBigConst(_self, d, aT, bv) } }
			if done{
				return
			}
		}
		if isMul && size == 8 && bImm && aImm == false{
			let:<mut s64> bv2 = mut 0
			match Some(bT){ bv2 = ? X86Core.rfImm(bT) }
			if X86Core.rfFitsImm32(bv2) && X86Core.mulByConstShape(bv2) == false{
				let aSame = mut false
				let bSame = mut false
				match Some(_self){ aSame = ? _self.tempIsReg(_self, aT, d) }
				match Some(_self){ bSame = ? _self.tempIsReg(_self, bT, d) }
				if aSame == false && bSame == false{
					let aSrc = mut ? new String()
					let aTemp = mut false
					match Some(aT){ aTemp = X86Core.rfIsTemp(aT) }
					if aTemp{
						let:<owns mut String> ar = mut null
						match Some(_self){ match Some(aT){ ar = ? _self.regStr(_self, aT) } }
						match Some(_self){ aSrc = ? _self.pct(_self, ar) }
					} else{
						let:<mut s64> so = mut 0
						match Some(aT){ so = ? X86Core.rfSlot(aT) }
						match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ aSrc = ? _self.hub.regForm.rfMemText(_self.hub.regForm, so) } } }
					}
					let li = mut ? String.from("    imulq $")
					? li.appendS64(li, bv2)
					? li.append(li, ", ")
					match Some(aSrc){ ? li.append(li, aSrc) }
					? li.append(li, ", %")
					match Some(d){ ? li.append(li, d) }
					match Some(_self){ ? _self.rawS(_self, li) }
					return
				}
			}
		}
		let hasBText = mut false
		let bText = mut ? new String()
		let bSameD = mut false
		match Some(_self){ bSameD = ? _self.tempIsReg(_self, bT, d) }
		let aSameD = mut false
		match Some(_self){ aSameD = ? _self.tempIsReg(_self, aT, d) }
		if bSameD && aSameD == false{
			if commutative{
				let t = mut ? new String()
				match Some(aT){ t = ? aT.substring(aT, 0) }
				match Some(bT){ aT = ? bT.substring(bT, 0) }
				bT = t
			} else{
				let r15 = mut ? X86Core_rfScratch()
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ ? _self.hub.regForm.rfRegToReg(_self.hub.regForm, r15, d) } } }
				bText = ? String.from("%r15")
				hasBText = true
			}
		}
		let narrowCmp = mut (size < 8 && (isAdd || isSub || isMul || isAnd || isOr || isBand || isBor || isBxor) == false)
		let signedCmp = mut (narrowCmp && first == 'S')
		if narrowCmp{
			match Some(aT){ aImm = X86Core.rfIsImm(aT) }
			match Some(bT){ bImm = X86Core.rfIsImm(bT) }
			if aImm{
				let:<mut s64> av = mut 0
				match Some(aT){ av = ? X86Core.rfImm(aT) }
				aT = ? String.from("#")
				? aT.appendS64(aT, X86Core.rfExtImm(av, size, signedCmp))
			}
			if bImm{
				let:<mut s64> bv3 = mut 0
				match Some(bT){ bv3 = ? X86Core.rfImm(bT) }
				bT = ? String.from("#")
				? bT.appendS64(bT, X86Core.rfExtImm(bv3, size, signedCmp))
			}
		}
		match Some(aT){ aImm = X86Core.rfIsImm(aT) }
		match Some(bT){ bImm = X86Core.rfIsImm(bT) }
		let aTemp2 = mut false
		match Some(aT){ aTemp2 = X86Core.rfIsTemp(aT) }
		let:<mut s64> bImmV = mut 0
		if bImm{
			match Some(bT){ bImmV = ? X86Core.rfImm(bT) }
		}
		if hasBText == false && isBand && size == 8 && bImm && aTemp2{
			let aSame2 = mut false
			match Some(_self){ aSame2 = ? _self.tempIsReg(_self, aT, d) }
			if aSame2 == false && (bImmV == 0xFFFFFFFF || bImmV == 0xFFFF || bImmV == 0xFF){
				let:<owns mut String> ar2 = mut null
				match Some(_self){ match Some(aT){ ar2 = ? _self.regStr(_self, aT) } }
				let zl = mut ? new String()
				let src4 = mut ? new String()
				let dst4 = mut ? new String()
				if bImmV == 0xFFFFFFFF{
					match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(ar2){ src4 = ? _self.hub.emit.sizedReg(_self.hub.emit, ar2, 4) } } } }
					match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(d){ dst4 = ? _self.hub.emit.sizedReg(_self.hub.emit, d, 4) } } } }
					zl = ? String.from("    movl %")
					? zl.append(zl, src4)
					? zl.append(zl, ", %")
					? zl.append(zl, dst4)
				} else{
					let:<mut s32> zsize = mut 2
					let zsfx = mut ? String.from("w")
					if bImmV == 0xFF{
						zsize = 1
						zsfx = ? String.from("b")
					}
					match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(ar2){ src4 = ? _self.hub.emit.sizedReg(_self.hub.emit, ar2, zsize) } } } }
					match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(d){ dst4 = ? _self.hub.emit.sizedReg(_self.hub.emit, d, 4) } } } }
					zl = ? String.from("    movz")
					? zl.append(zl, zsfx)
					? zl.append(zl, "l %")
					? zl.append(zl, src4)
					? zl.append(zl, ", %")
					? zl.append(zl, dst4)
				}
				match Some(_self){ ? _self.rawS(_self, zl) }
				return
			}
		}
		let aSame3 = mut false
		match Some(_self){ aSame3 = ? _self.tempIsReg(_self, aT, d) }
		if aSame3 == false{
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ ? _self.hub.regForm.rfMov(_self.hub.regForm, dstTok, aT) } } }
		}
		if hasBText == false && isBand && size == 8 && bImm && bImmV == 0xFFFFFFFF{
			let:<owns mut String> d4 = mut null
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(d){ d4 = ? _self.hub.emit.sizedReg(_self.hub.emit, d, 4) } } } }
			let lm = mut ? String.from("    movl %")
			match Some(d4){ ? lm.append(lm, d4) }
			? lm.append(lm, ", %")
			match Some(d4){ ? lm.append(lm, d4) }
			match Some(_self){ ? _self.rawS(_self, lm) }
			return
		}
		if hasBText == false{
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ match Some(bT){ bText = ? _self.hub.regForm.rfSrc(_self.hub.regForm, bT) } } } }
		}
		if narrowCmp{
			match Some(_self){ ? _self.rfExtend(_self, d, size, signedCmp) }
			if bText.equals(bText, "%r15"){
				let r15b = mut ? X86Core_rfScratch()
				match Some(_self){ ? _self.rfExtend(_self, r15b, size, signedCmp) }
			} else{
				let bTemp = mut false
				match Some(bT){ bTemp = X86Core.rfIsTemp(bT) }
				let bSame4 = mut false
				match Some(_self){ bSame4 = ? _self.tempIsReg(_self, bT, d) }
				if bTemp && bSame4 == false{
					let:<owns mut String> br = mut null
					match Some(_self){ match Some(bT){ br = ? _self.regStr(_self, bT) } }
					match Some(_self){ ? _self.rfExtend(_self, br, size, signedCmp) }
				}
			}
		}
		let:<owns mut String> dText = mut null
		match Some(_self){ match Some(d){ dText = ? _self.pct(_self, d) } }
		if isAdd{
			match Some(_self){ ? _self.op2S(_self, "add", dText, bText) }
			return
		} elseif isSub{
			match Some(_self){ ? _self.op2S(_self, "sub", dText, bText) }
			return
		} elseif isMul{
			if bText.startsWith(bText, "$"){
				let num = mut ? bText.substring(bText, 1)
				let:<mut s64> nv = mut 0
				match Some(num){ nv = ? num.parseS64(num) }
				let did = mut false
				match Some(_self){ match Some(d){ did = ? _self.rfMulByConst(_self, d, nv) } }
				if did{
					return
				}
			}
			match Some(_self){ ? _self.op2S(_self, "imul", dText, bText) }
			return
		} elseif isBand || isBor || isBxor{
			if isBand{
				match Some(_self){ ? _self.op2S(_self, "and", dText, bText) }
			} elseif isBor{
				match Some(_self){ ? _self.op2S(_self, "or", dText, bText) }
			} else{
				match Some(_self){ ? _self.op2S(_self, "xor", dText, bText) }
			}
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(d){ ? _self.hub.emit.zeroExtendReg(_self.hub.emit, d, size) } } } }
			return
		} elseif isAnd || isOr{
			if size == 1{
				let bReg = mut ? new String()
				let bTemp2 = mut false
				match Some(bT){ bTemp2 = X86Core.rfIsTemp(bT) }
				if bTemp2{
					match Some(_self){ match Some(bT){ bReg = ? _self.regStr(_self, bT) } }
				} else{
					match Some(d){ bReg = ? d.substring(d, 0) }
				}
				let s1 = mut ? new String()
				let s2 = mut ? new String()
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(bReg){ s1 = ? _self.hub.emit.sizedReg(_self.hub.emit, bReg, 1) } } } }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(d){ s2 = ? _self.hub.emit.sizedReg(_self.hub.emit, d, 1) } } } }
				let lb = mut ? String.from("    and")
				if isOr{
					lb = ? String.from("    or")
				}
				? lb.append(lb, "b %")
				? lb.append(lb, s1)
				? lb.append(lb, ", %")
				? lb.append(lb, s2)
				match Some(_self){ ? _self.rawS(_self, lb) }
			} elseif isAnd{
				match Some(_self){ ? _self.op2S(_self, "and", dText, bText) }
			} else{
				match Some(_self){ ? _self.op2S(_self, "or", dText, bText) }
			}
			return
		}
		let isLt = mut false
		let isLtEq = mut false
		let isGt = mut false
		let isGtEq = mut false
		let isSlt = mut false
		let isSltEq = mut false
		let isSgt = mut false
		let isSgtEq = mut false
		match Some(op){
			isLt = op.equals(op, "LT")
			isLtEq = op.equals(op, "LT_EQ")
			isGt = op.equals(op, "GT")
			isGtEq = op.equals(op, "GT_EQ")
			isSlt = op.equals(op, "SLT")
			isSltEq = op.equals(op, "SLT_EQ")
			isSgt = op.equals(op, "SGT")
			isSgtEq = op.equals(op, "SGT_EQ")
		}
		let setcc = mut ? new String()
		if isEq{
			setcc = ? String.from("sete")
		} elseif isNeq{
			setcc = ? String.from("setne")
		} elseif isLt{
			setcc = ? String.from("setb")
		} elseif isLtEq{
			setcc = ? String.from("setbe")
		} elseif isGt{
			setcc = ? String.from("seta")
		} elseif isGtEq{
			setcc = ? String.from("setae")
		} elseif isSlt{
			setcc = ? String.from("setl")
		} elseif isSltEq{
			setcc = ? String.from("setle")
		} elseif isSgt{
			setcc = ? String.from("setg")
		} elseif isSgtEq{
			setcc = ? String.from("setge")
		} else{
			throw "unknown R_BIN operator"
		}
		match Some(_self){ ? _self.op2S(_self, "cmp", dText, bText) }
		let:<owns mut String> d8 = mut null
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(d){ d8 = ? _self.hub.emit.sizedReg(_self.hub.emit, d, 1) } } } }
		let l5 = mut ? String.from("    ")
		match Some(setcc){ ? l5.append(l5, setcc) }
		? l5.append(l5, " %")
		match Some(d8){ ? l5.append(l5, d8) }
		match Some(_self){ ? _self.rawS(_self, l5) }
		let l6 = mut ? String.from("    movzbq %")
		match Some(d8){ ? l6.append(l6, d8) }
		? l6.append(l6, ", %")
		match Some(d){ ? l6.append(l6, d) }
		match Some(_self){ ? _self.rawS(_self, l6) }
	}

	@pub
	@throws
	func rfMulByBigConst(_self: ref some mut self, d: ref imut String, aTok: ref imut String, k: mut s64) mut bool{
