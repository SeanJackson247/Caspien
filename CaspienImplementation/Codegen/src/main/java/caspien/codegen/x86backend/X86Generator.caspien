			match Some(_self){ match Some(_self.core){ allocPos = _self.core.csrAllocPos } }
			let beforeAlloc = mut ? new String()
			match Some(_self){ match Some(_self.core){ beforeAlloc = ? _self.core.out.substring(_self.core.out, wrap:<u64>(start), wrap:<u64>(allocPos)) } }
			let nregs = mut regs.size(regs)
			for k in 0..nregs{
				let csrMk = mut ? X86Core_csrMark()
				let emptyRepl = mut ? new String()
				let early = mut ? beforeAlloc.replace(beforeAlloc, csrMk, emptyRepl)
				let r0 = mut ? new String()
				let r1 = mut ? new String()
				let rr = regs.get(regs, k)
				match Some(rr){
					let a0 = rr.get(rr, 0)
					match Some(a0){ r0 = ? a0.substring(a0, 0) }
				}
				match Some(rr){
					let a1 = rr.get(rr, 1)
					match Some(a1){ r1 = ? a1.substring(a1, 0) }
				}
				let usedEarly = mut false
				if r1.equals(r1, "xmm"){
					usedEarly = Text.containsWord(early, r0, none, false)
				} else if r0.equals(r0, "rbx"){
					let nm = mut ? CodegenText.rbxNames()
					usedEarly = Text.containsAnyWord(early, nm, none)
				} else if r0.equals(r0, "rdi"){
					let nm = mut ? CodegenText.rdiNames()
					usedEarly = Text.containsAnyWord(early, nm, none)
				} else if r0.equals(r0, "rsi"){
					let nm = mut ? CodegenText.rsiNames()
					usedEarly = Text.containsAnyWord(early, nm, none)
				} else{
					usedEarly = Text.containsWord(early, r0, dwb, false)
				}
