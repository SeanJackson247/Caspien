			match Some(addrTok){ nm = ? addrTok.substring(addrTok, 1) }
			areg = ? X86Core_rfScratch()
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(areg){ match Some(nm){ ? _self.hub.emit.leaGlobalToReg(_self.hub.emit, areg, nm) } } } } }
			hasAreg = true
