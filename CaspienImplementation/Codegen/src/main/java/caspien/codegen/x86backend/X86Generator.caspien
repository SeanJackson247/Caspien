			isGlobal = X86Core.rfIsGlobal(addrTok)
			isSlot = X86Core.rfIsSlot(addrTok)
		}
		match Some(srcTok){ isImm = X86Core.rfIsImm(srcTok) }
		let odd = X86Core.isOddSize(n)
		let areg = mut ? new String()
		let hasAreg = mut false
		let ripMem = mut ? new String()
		let hasRip = mut false
		if isGlobal && odd == false{
			let:<owns mut String> nm = mut null
			match Some(addrTok){ nm = ? addrTok.substring(addrTok, 1) }
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(nm){ ripMem = ? _self.hub.emit.globalRipOperand(_self.hub.emit, nm) } } } }
			hasRip = true
