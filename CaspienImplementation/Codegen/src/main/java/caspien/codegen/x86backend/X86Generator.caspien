			match Some(_self){ match Some(_self.core){ seg = ? _self.core.out.substring(_self.core.out, segStart, wrap:<u64>(j)) } }
			let sv = mut ? new String()
			let rs = mut ? new String()
			for vi in 0..3{
				let have = mut false
				let slot = mut ? new String()
				match Some(_self){ match Some(_self.core){
					let s = _self.core.vSlots.get(_self.core.vSlots, vi)
					match Some(s){
						have = true
						slot = ? s.substring(s, 0)
					}
				} }
				let nm = mut ? new String()
				let nmSrc = regs.get(regs, vi)
				match Some(nmSrc){ nm = ? nmSrc.substring(nmSrc, 0) }
				if have && Text.containsWord(seg, nm, dwb, false){
					? sv.append(sv, "    movq %")
					? sv.append(sv, nm)
					? sv.append(sv, ", ")
					? sv.append(sv, slot)
					? sv.append(sv, "\n")
					? rs.append(rs, "    movq ")
					? rs.append(rs, slot)
					? rs.append(rs, ", %")
					? rs.append(rs, nm)
					? rs.append(rs, "\n")
