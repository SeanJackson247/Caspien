			colon = key.indexOf(key, ':')
			let:<mut s64> n = mut 0
			let:<mut s64> bits = mut 0
			let head = mut ? key.substring(key, 0, wrap:<u64>(colon))
			n = ? head.parseS64(head)
			let tail = mut ? key.substring(key, wrap:<u64>(colon + 1))
			bits = ? tail.parseS64(tail)
			if n == 4{
				let lt = mut ? String.from("    .p2align 2")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, lt) } } }
			} else{
				let lt = mut ? String.from("    .p2align 3")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, lt) } } }
			}
			let l1 = mut ? new String()
			match Some(value){ l1 = ? value.substring(value, 0) }
			? l1.append(l1, ":")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, l1) } } }
			let l2 = mut ? String.from("    .long ")
			if n != 4{
