			match Some(_self){ match Some(_self.core){ ? _self.core.out.replaceRange(_self.core.out, wrap:<u64>(j), wrap:<u64>(j) + rm.length(rm), rs) } }
			match Some(_self){ match Some(_self.core){ ? _self.core.out.replaceRange(_self.core.out, wrap:<u64>(i), wrap:<u64>(i) + sm.length(sm), sv) } }
