			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(reg){ sz = ? _self.hub.emit.sizedReg(_self.hub.emit, reg, n) } } } }
			let ln = mut ? String.from("    mov")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? ln.append(ln, _self.hub.emit.movSuffix(_self.hub.emit, n)) } } }
			? ln.append(ln, " %")
			match Some(sz){ ? ln.append(ln, sz) }
			? ln.append(ln, ", ")
			match Some(ripMem){ ? ln.append(ln, ripMem) }
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln) } } }
