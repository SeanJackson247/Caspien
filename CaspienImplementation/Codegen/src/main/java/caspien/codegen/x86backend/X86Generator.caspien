			? rspFix.append(rspFix, "(%rbp), %rsp\n")
		}
		from = wrap:<u64>(start)
		// forced: same bounded for as above
		match Some(_self){ match Some(_self.core){ bound2 = _self.core.out.length(_self.core.out) + 1 } }
		for step9 in 0..bound2{
			match Some(_self){ match Some(_self.core){ i = _self.core.out.indexOf(_self.core.out, rspMarked, from) } }
			if i < 0{
				break
			}
			match Some(_self){ match Some(_self.core){ ? _self.core.out.replaceRange(_self.core.out, wrap:<u64>(i), wrap:<u64>(i) + rspMarked.length(rspMarked), rspFix) } }
