	@pub
	@throws
	func emitFloatPool(_self: ref some mut self) void{
		?catch(e){ throw e }
		let empty = mut true
		let win = mut false
		match Some(_self){ match Some(_self.core){
			empty = _self.core.floatPool.isEmpty(_self.core.floatPool)
			win = _self.core.target == CodegenTarget.WINDOWS_GNU_X64
		} }
