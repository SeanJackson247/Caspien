import "stdlib/string.caspien"
import "Prog.caspien"
import "RegOps.caspien"
import "LabelIndex.caspien"

/** Port of LoopRotationPass (switch `loop-rotation`): the loop header test is copied to the back edge (`JMP @X` -> header copy + inverted branch to a new label `@loop_rot_N`). */
@pub
struct LoopRotationPass{@pub{
}}

impl constructor for LoopRotationPass() self{
	return LoopRotationPass{}
}

@pub
impl LoopRotationPass{
	static func isLabel(prog: ref some imut Prog, i: mut u64) mut bool{
		if prog.count(prog, i) != 1 || prog.tokStartsCh(prog, i, 0, '@') == false{
			return false
		}
		let e = mut prog.lineEnd(prog, i)
		return prog.buf.charAt(prog.buf, e - 1) == ':'
	}

	static func isJmp(prog: ref some imut Prog, i: mut u64) mut bool{
		if prog.count(prog, i) == 2 &&then prog.opEq(prog, i, "JMP") &&then prog.tokStartsCh(prog, i, 1, '@'){
			return true
		}
		return false
	}

	static func isBranch(prog: ref some imut Prog, i: mut u64) mut bool{
		if prog.count(prog, i) != 6{
			return false
		}
		if prog.opEq(prog, i, "R_BRC") == false &&then prog.opEq(prog, i, "R_BRCM") == false{
			return false
		}
		return prog.tokStartsCh(prog, i, 5, '@')
	}

	static func isTemp(prog: ref some imut Prog, i: mut u64, k: mut u64) mut bool{
		let p = mut prog.tokPos(prog, i, k)
		if p < 0{
			return false
		}
		let a = mut wrap:<u64>(p)
		let q = mut Ln.tokEnd(prog.buf, a, prog.lineEnd(prog, i))
		if q - a != 3{
			return false
		}
		if prog.buf.charAt(prog.buf, a) == '%' &&then prog.buf.charAt(prog.buf, a + 1) == 't'{
			return true
		}
		return false
	}

	static func simpleBin(prog: ref some imut Prog, i: mut u64) mut bool{
		if prog.eqLit(prog, i, 1, "ADD") || prog.eqLit(prog, i, 1, "SUB") || prog.eqLit(prog, i, 1, "MUL") || prog.eqLit(prog, i, 1, "AND") || prog.eqLit(prog, i, 1, "OR"){
			return true
		}
		if prog.eqLit(prog, i, 1, "BAND") || prog.eqLit(prog, i, 1, "BOR") || prog.eqLit(prog, i, 1, "BXOR") || prog.eqLit(prog, i, 1, "SHL") || prog.eqLit(prog, i, 1, "SHR") || prog.eqLit(prog, i, 1, "SAR"){
			return true
		}
		return false
	}

	static func isPure(prog: ref some imut Prog, i: mut u64) mut bool{
		if prog.len(prog, i) == 0{
			return false
		}
		let c = mut prog.count(prog, i)
		if prog.opEq(prog, i, "R_MOV") || prog.opEq(prog, i, "R_LD"){
			return c == 4 && LoopRotationPass.isTemp(prog, i, 2)
		}
		if prog.opEq(prog, i, "R_LDI"){
			return c >= 6 && LoopRotationPass.isTemp(prog, i, 2)
		}
		if prog.opEq(prog, i, "R_LDD"){
			return c == 5 && LoopRotationPass.isTemp(prog, i, 2)
		}
		if prog.opEq(prog, i, "R_BIN"){
			if c == 6 &&then LoopRotationPass.simpleBin(prog, i) &&then LoopRotationPass.isTemp(prog, i, 3){
				return true
			}
			return false
		}
		return false
	}

	/** True when the lines from `from` are labels only (up to the first non-label) and one of them is `<token k of line src>:`. */
	static func labelRunAfterContains(prog: ref some imut Prog, from: mut u64, src: mut u64, k: mut u64) mut bool{
		let n = mut prog.size(prog)
		let j = mut from
		for st in 0..n{
			if j >= n{
				break
			}
			if LoopRotationPass.isLabel(prog, j) == false{
				return false
			}
			if prog.tokIsOtherPlus(prog, j, 0, src, k, ':'){
				return true
			}
			j += 1
		}
		return false
	}

	@pub
	@throws
	static func run(prog: ref some mut Prog) void{
		?catch(e){ throw e }
		let n = mut prog.size(prog)
		let labels = mut ? LabelIndex.build(prog)
		// plan: for each rotated back edge j: header start h, header branch b, the id of the new body label of b
		let rj = mut ? dyn:<u64>([])
		let rh = mut ? dyn:<u64>([])
		let rb = mut ? dyn:<u64>([])
		let rl = mut ? dyn:<u64>([])
		let nr = mut 0
		let:<mut s64> counter = mut 0
		for j in 0..n{
			if LoopRotationPass.isJmp(prog, j) == false{
				continue
			}
			let at = mut labels.find(labels, prog, j, 1)
			if at < 0 || wrap:<u64>(at) >= j{
				continue
			}
			let h = mut (wrap:<u64>(at) + 1)
			for st in 0..n{
				if h < j &&then LoopRotationPass.isLabel(prog, h){
					h += 1
				} else {
					break
				}
			}
			let b = mut h
			let pure = mut 0
			for st in 0..5{
				if b < j &&then LoopRotationPass.isPure(prog, b) &&then pure <= 3{
					b += 1
					pure += 1
				} else {
					break
				}
			}
			if b >= j || pure > 3{
				continue
			}
			if LoopRotationPass.isBranch(prog, b) == false || RegOps.cmpId(prog, b, 1) == 0{
				continue
			}
			if prog.tokEq(prog, b, 5, j, 1) || LoopRotationPass.labelRunAfterContains(prog, j + 1, b, 5) == false{
				continue
			}
			// the body label of this header branch (shared by several back edges to the same header)
			let lab = mut -1
			for q in 0..nr{
				match q in rb{
					if rb[q] == b{
						match q in rl{
							lab = wrap:<s64>(rl[q])
						}
					}
				}
			}
			if lab < 0{
				lab = counter
				counter += 1
			}
			rj = ? resize(rj, nr + 1, 0)
			rh = ? resize(rh, nr + 1, 0)
			rb = ? resize(rb, nr + 1, 0)
			rl = ? resize(rl, nr + 1, 0)
			match nr into rj{ rj[nr] = j }
			match nr into rh{ rh[nr] = h }
			match nr into rb{ rb[nr] = b }
			match nr into rl{ rl[nr] = wrap:<u64>(lab) }
			nr += 1
		}
		if nr == 0{
			return
		}
		// output: original lines, each back edge replaced by the header copy + inverted branch, a label after each header branch
		let cap = mut (n + nr * 5 + 8)
		let os = mut ? dyn:<u64>([])
		os = ? resize(os, cap, 0)
		let oe = mut ? dyn:<u64>([])
		oe = ? resize(oe, cap, 0)
		let w = mut 0
		let ri = mut 0
		for i in 0..n{
			// is line i a back edge that is rotated?
			let rot = mut -1
			for q in 0..nr{
				match q in rj{
					if rj[q] == i{
						rot = wrap:<s64>(q)
					}
				}
			}
			if rot >= 0{
				let qq = mut wrap:<u64>(rot)
				let h = mut 0
				let b = mut 0
				let lab = mut 0
				match qq in rh{ h = rh[qq] }
				match qq in rb{ b = rb[qq] }
				match qq in rl{ lab = rl[qq] }
				for k in h..b{
					match w into os{ os[w] = prog.lineStart(prog, k) }
					match w into oe{ oe[w] = prog.lineEnd(prog, k) }
					w += 1
				}
				prog.begin(prog)
				? prog.addTok(prog, b, 0)
				? RegOps.addOpposite(prog, RegOps.cmpId(prog, b, 1))
				? prog.addTok(prog, b, 2)
				? prog.addTok(prog, b, 3)
				? prog.addTok(prog, b, 4)
				? prog.addLit(prog, "@loop_rot_")
				? prog.glueS64(prog, wrap:<s64>(lab))
				match w into os{ os[w] = prog.cur }
				match w into oe{ oe[w] = prog.used }
				w += 1
			} else {
				match w into os{ os[w] = prog.lineStart(prog, i) }
				match w into oe{ oe[w] = prog.lineEnd(prog, i) }
				w += 1
			}
			// a header branch gets its body label right after it (once per header)
			let first = mut -1
			for q in 0..nr{
				match q in rb{
					if rb[q] == i{
						if first < 0{
							first = wrap:<s64>(q)
						}
					}
				}
			}
			if first >= 0{
				let qq = mut wrap:<u64>(first)
				let lab = mut 0
				match qq in rl{ lab = rl[qq] }
				prog.begin(prog)
				? prog.addLit(prog, "@loop_rot_")
				? prog.glueS64(prog, wrap:<s64>(lab))
				? prog.glueCh(prog, ':')
				match w into os{ os[w] = prog.cur }
				match w into oe{ oe[w] = prog.used }
				w += 1
			}
		}
		// back into the program
		prog.truncate(prog, 0)
		for x in 0..w{
			let a = mut 0
			let z = mut 0
			match x in os{ a = os[x] }
			match x in oe{ z = oe[x] }
			? prog.pushRange(prog, a, z)
		}
	}
}
