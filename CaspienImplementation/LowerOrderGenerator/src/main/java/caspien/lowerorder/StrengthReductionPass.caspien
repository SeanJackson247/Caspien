import "stdlib/string.caspien"
import "Prog.caspien"

/** Port of StrengthReductionPass: unsigned `PUSH 8 K ; DIV_INT 8` -> `PUSH 8 n ; SHR 8`, `MOD_INT 8` -> `PUSH 8 K-1 ; BITS_AND 8` (K a power of two). Edits the two lines in place. */
@pub
struct StrengthReductionPass{@pub{
}}

impl constructor for StrengthReductionPass() self{
	return StrengthReductionPass{}
}

@pub
impl StrengthReductionPass{
	@pub
	@throws
	static func run(prog: ref some mut Prog) void{
		?catch(e){ throw e }
		let n = mut prog.size(prog)
		let i = mut 0
		for step in 0..n{
			if i + 1 >= n{
				break
			}
			let kind = mut 0
			let k = mut -1
			if prog.opEq(prog, i, "PUSH") &&then prog.count(prog, i) == 3 &&then prog.eqLit(prog, i, 1, "8"){
				k = prog.numTok(prog, i, 2)
			}
			if k >= 2 &&then bits_and(k, k - 1) == 0{
				let j = mut (i + 1)
				if prog.count(prog, j) == 2 &&then prog.eqLit(prog, j, 1, "8"){
					if prog.opEq(prog, j, "DIV_INT"){
						kind = 1
					} else if prog.opEq(prog, j, "MOD_INT") &&then k <= 2147483648{
						kind = 2
					}
				}
			}
			if kind != 0{
				let v = mut (k - 1)
				if kind == 1{
					v = 0
					let t = mut k
					for b in 0..63{
						if t > 1{
							t = t / 2
							v += 1
						}
					}
				}
				prog.begin(prog)
				? prog.addTok(prog, i, 0)
				? prog.addTok(prog, i, 1)
				? prog.addS64(prog, v)
				prog.setBuilt(prog, i)
				prog.begin(prog)
				if kind == 1{
					? prog.addLit(prog, "SHR 8")
				} else{
					? prog.addLit(prog, "BITS_AND 8")
				}
				prog.setBuilt(prog, i + 1)
				i += 2
			} else{
				i += 1
			}
		}
	}
}
