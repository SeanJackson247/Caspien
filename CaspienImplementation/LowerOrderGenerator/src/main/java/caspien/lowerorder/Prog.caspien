		?catch(e0){ throw e0 }
		? _self.sep(_self)
		? _self.reserve(_self, 256)
		let:<raw mut u8> lp = null
		unsafe memcopy raw{
			let tmp = mut raw lit
			memcopy(raw lp, mut 8, raw tmp)
		}
		let u = mut _self.used
		let w = mut 0
		for step in 0..256{
			let q = mut (lp + w)
			let lc = mut '\0'
			unsafe memcopy raw{
				memcopy(raw lc, mut 1, q)
			}
			if lc == '\0'{
				break
			}
			_self.buf.setCharAt(_self.buf, u + w, lc)
			w += 1
		}
		_self.used = u + w
	}

	@pub
	static func dig(d: mut u64) mut char{
		if d == 0{ return '0' }
		if d == 1{ return '1' }
		if d == 2{ return '2' }
		if d == 3{ return '3' }
		if d == 4{ return '4' }
		if d == 5{ return '5' }
		if d == 6{ return '6' }
		if d == 7{ return '7' }
		if d == 8{ return '8' }
		return '9'
	}

