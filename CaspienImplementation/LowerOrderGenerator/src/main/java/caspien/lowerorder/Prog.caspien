	/** Removes line `idx` of the NEW table (the later lines move up). */
	@pub
	func outRemoveAt(_self: ref some mut self, idx: mut u64) void{
		let m = mut _self.n2
		if idx >= m{
			return
		}
		let lim = mut (m - 1)
		for q in idx..lim{
			let q1 = mut (q + 1)
			let a = mut 0
			let b = mut 0
			match q1 in _self.ls2{ a = _self.ls2[q1] }
			match q1 in _self.le2{ b = _self.le2[q1] }
			match q into _self.ls2{ _self.ls2[q] = a }
			match q into _self.le2{ _self.le2[q] = b }
		}
		_self.n2 = lim
	}

	/** The last `t` lines of the NEW table move to position `at` (the lines from `at` on move down). */
	@pub
	@throws
	func outRotateTail(_self: ref some mut self, at: mut u64, t: mut u64) void{
		?catch(e0){ throw e0 }
		let m = mut _self.n2
		if t == 0 || at + t > m{
			return
		}
		let span = mut (m - at)
		let keep = mut (span - t)
		// copy the tail aside, shift the middle up, put the tail first
		let tmpS = mut ? dyn:<u64>([])
		let tmpE = mut ? dyn:<u64>([])
		tmpS = ? resize(tmpS, t, 0)
		tmpE = ? resize(tmpE, t, 0)
		let tailStart = mut (m - t)
		for q in 0..t{
			let src = mut (tailStart + q)
			let a = mut 0
			let b = mut 0
			match src in _self.ls2{ a = _self.ls2[src] }
			match src in _self.le2{ b = _self.le2[src] }
			match q into tmpS{ tmpS[q] = a }
			match q into tmpE{ tmpE[q] = b }
		}
		for r in 0..keep{
			let src = mut (tailStart - 1 - r)
			let dst = mut (m - 1 - r)
			let a = mut 0
			let b = mut 0
			match src in _self.ls2{ a = _self.ls2[src] }
			match src in _self.le2{ b = _self.le2[src] }
			match dst into _self.ls2{ _self.ls2[dst] = a }
			match dst into _self.le2{ _self.le2[dst] = b }
		}
		for q in 0..t{
			let dst = mut (at + q)
			let a = mut 0
			let b = mut 0
			match q in tmpS{ a = tmpS[q] }
			match q in tmpE{ b = tmpE[q] }
			match dst into _self.ls2{ _self.ls2[dst] = a }
			match dst into _self.le2{ _self.le2[dst] = b }
		}
	}

	@throws
	func putS64(_self: ref some mut self, v: mut s64) void{
		?catch(e0){ throw e0 }
		? _self.reserve(_self, 24)
		let neg = mut (v < 0)
		let m = mut v
		if neg{
			m = 0 - v
		}
		let digits = mut 1
		let t = mut m
		for q in 0..20{
			if t >= 10{
				t = t / 10
				digits += 1
			}
		}
		let total = mut wrap:<u64>(digits)
		let u = mut _self.used
		let start = mut u
		if neg{
			_self.buf.setCharAt(_self.buf, u, '-')
			start = u + 1
		}
		let x = mut m
		let pos = mut (start + total)
		for q in 0..total{
			pos -= 1
			let dg = mut (x % 10)
			_self.buf.setCharAt(_self.buf, pos, Prog.dig(wrap:<u64>(dg)))
			x = x / 10
		}
		_self.used = start + total
	}

	/** Line `i` becomes the text built since `begin`. */
	@pub
	func setBuilt(_self: ref some mut self, i: mut u64) void{
		_self.setRange(_self, i, _self.cur, _self.used)
	}

	/** Appends the built text as a new line. */
	@pub
	@throws
	func pushBuilt(_self: ref some mut self) void{
		?catch(e0){ throw e0 }
		? _self.pushRange(_self, _self.cur, _self.used)
	}

	// ---- text in / out ----

	/** Java `Files.readAllLines` split (\n, \r\n or \r end a line; no empty last line); every line is normalized into the buffer (BytecodeParser tokenization: whitespace separates tokens, a "..." string and a 'c' char literal are one token). */
	@pub
	@throws
	static func parse(text: ref some imut String) owns some mut Prog{
		?catch(e0){ throw e0 }
		let tl = mut text.length(text)
		let nl = mut 2
		for x in 0..tl{
			let c = mut text.charAt(text, x)
			if c == '\n' || c == '\r'{
				nl += 1
			}
		}
		let slack = mut (tl / 8 + 4096)
		let p = mut ? new Prog(tl + slack, nl)
		let a = mut 0
		let i = mut 0
		let limit = mut (tl + 1)
		for step in 0..limit{
			if i >= tl{
				break
			}
			let c = mut text.charAt(text, i)
			if c == '\n' || c == '\r'{
				? p.ingest(p, text, a, i)
				if c == '\r' &&then i + 1 < tl &&then text.charAt(text, i + 1) == '\n'{
					i += 1
				}
				i += 1
				a = i
			} else {
				i += 1
			}
		}
		if a < tl{
			? p.ingest(p, text, a, tl)
		}
		return p
	}

	/** Normalizes the source range [a, z) of `text` onto the end of the buffer as one new line. */
	@throws
	func ingest(_self: ref some mut self, text: ref some imut String, a: mut u64, z: mut u64) void{
		?catch(e0){ throw e0 }
		let u = mut _self.used
		// fast path: already normal (single spaces, no other whitespace, no quote that could hold a space or char literal)
		let normal = mut true
		let prevSp = mut true
		for x in a..z{
			let c = mut text.charAt(text, x)
			if c == ' '{
				if prevSp{
					normal = false
					break
				}
				prevSp = true
			} else {
				prevSp = false
				if c == '"' || c == '\'' || Ln.isWs(c){
					normal = false
					break
				}
			}
		}
		if normal &&then z > a &&then prevSp{
			normal = false
		}
		if normal{
			let w = mut (z - a)
			? _self.reserve(_self, w)
			for d in 0..w{
				_self.buf.setCharAt(_self.buf, u + d, text.charAt(text, a + d))
			}
			_self.used = u + w
			? _self.pushRange(_self, u, u + w)
			return
		}
		// general path (a port of the BytecodeParser tokenizer)
		_self.cur = u
		let i = mut a
		let guard = mut (z + 1)
		for step in 0..guard{
			if i >= z{
				break
			}
			let c = mut text.charAt(text, i)
			if Ln.isWs(c){
				i += 1
				continue
			}
			let st = mut i
			let stop = mut i
			if c == '"'{
				i += 1
				for k in 0..z{
					if i >= z{
						break
					}
					if text.charAt(text, i) == '"'{
						break
					}
					if text.charAt(text, i) == '\\' &&then i + 1 < z{
						i += 1
					}
					i += 1
				}
				if i < z{
					i += 1
				}
				stop = i
				if stop > z{
					stop = z
				}
			} else {
				let end = mut 0
				let found = mut false
				if c == '\''{
					if i + 3 < z &&then text.charAt(text, i + 1) == '\\' &&then text.charAt(text, i + 3) == '\''{
						end = i + 4
						found = true
					} else if i + 2 < z &&then text.charAt(text, i + 2) == '\''{
						end = i + 3
						found = true
					}
				}
				let accept = mut false
				if found{
					if end == z{
						accept = true
					} else {
						accept = Ln.isWs(text.charAt(text, end))
					}
				}
				if accept{
					i = end
					stop = end
				} else {
					for k in 0..z{
						if i >= z{
							break
						}
						if Ln.isWs(text.charAt(text, i)){
							break
						}
						i += 1
					}
					stop = i
				}
			}
			? _self.sep(_self)
			let w = mut (stop - st)
			? _self.reserve(_self, w)
			let u2 = mut _self.used
			for d in 0..w{
				_self.buf.setCharAt(_self.buf, u2 + d, text.charAt(text, st + d))
			}
			_self.used = u2 + w
		}
		? _self.pushRange(_self, u, _self.used)
	}

	/** Every line followed by '\n' (BytecodeSerializer). */
	@pub
	@throws
	func serialize(_self: ref some imut self) owns some mut String{
		?catch(e0){ throw e0 }
		let total = mut 0
		let n = mut _self.n
		for i in 0..n{
			total += _self.len(_self, i) + 1
		}
		let out = mut ? new String()
		if total > 0{
			let sp = mut ' '
			let g = mut ? resize(out.chars.backing, total, sp)
			out.chars.backing = g
		}
		let w = mut 0
		for i in 0..n{
			let s = mut _self.lineStart(_self, i)
			let e = mut _self.lineEnd(_self, i)
			let m = mut (e - s)
			for d in 0..m{
				out.setCharAt(out, w + d, _self.buf.charAt(_self.buf, s + d))
			}
			w += m
			out.setCharAt(out, w, '\n')
			w += 1
		}
		return out
	}
}
