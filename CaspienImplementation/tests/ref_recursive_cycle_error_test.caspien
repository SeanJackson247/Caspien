// A cycle that goes through an `owns` member is still rejected, even though a `ref` elsewhere in it would be fine.
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
struct A{@pub{
	b: owns mut B
	back: ref mut A
}}
struct B{@pub{
	a: owns mut A
}}
func main() void{
	unsafe extern{ printf("unreachable\n") }
}
