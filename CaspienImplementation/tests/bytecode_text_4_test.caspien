// Differential test of the Caspien port of BytecodeParser/ against the Java original (generated by gen_bytecode_text_test.py GROUP).
import "stdlib/libc.caspien"
import "stdlib/gt/*"
import "stdlib/string.caspien"
import "stdlib/print.caspien"
import "stdlib/print_string.caspien"
import "../Codegen/src/main/java/caspien/codegen/collections.caspien"
import "../BytecodeParser/src/main/java/caspien/bytecode/Text.caspien"
import "../BytecodeParser/src/main/java/caspien/bytecode/BytecodeProgram.caspien"
import "../BytecodeParser/src/main/java/caspien/bytecode/BytecodeParser.caspien"
import "../BytecodeParser/src/main/java/caspien/bytecode/BytecodeSerializer.caspien"

@throws
func putB(o: ref some mut String, b: imut bool) void{
	?catch(e){ throw e }
	if b{ ? o.appendChar(o, 'T') } else { ? o.appendChar(o, 'F') }
}

@throws
func putS(o: ref some mut String, s: ref imut String) void{
	?catch(e){ throw e }
	let n = mut 0
	match Some(s){ n = s.length(s) }
	let isNone = mut true
	match Some(s){ isNone = false }
	if isNone{
		? o.appendChar(o, 'N')
		return
	}
	? o.appendU64(o, n)
	? o.appendChar(o, ':')
	match Some(s){ ? o.append(o, s) }
}

@throws
func putL(o: ref some mut String, l: ref imut ObjectList<String>) void{
	?catch(e){ throw e }
	let isNone = mut true
	match Some(l){ isNone = false }
	if isNone{
		? o.appendChar(o, 'N')
		return
	}
	let n = mut 0
	match Some(l){ n = l.size(l) }
	? o.appendChar(o, '[')
	for i in 0..n{
		if i > 0{ ? o.appendChar(o, ',') }
		match Some(l){
			let x = mut l.get(l, i)
			? putS(o, x)
		}
	}
	? o.appendChar(o, ']')
}

@throws
func putP(o: ref some mut String, p: ref imut Span) void{
	?catch(e){ throw e }
	let isNone = mut true
	match Some(p){ isNone = false }
	if isNone{
		? o.appendChar(o, 'N')
		return
	}
	let:<mut s64> a = mut 0
	let:<mut s64> b = mut 0
	match Some(p){
		a = p.start + 0
		b = p.end + 0
	}
	? o.appendChar(o, 'S')
	? o.appendS64(o, a)
	? o.appendChar(o, ',')
	? o.appendS64(o, b)
}


@throws
func putStm(o: ref some mut String, st: ref imut BytecodeStatement) void{
	?catch(e){ throw e }
	let n = mut 0
	match Some(st){ n = st.size(st) }
	for i in 0..n{
		if i > 0{ ? o.appendChar(o, ' ') }
		let k = mut 0
		let:<mut s32> ln = mut 0
		let file = mut ? new String()
		let tx = mut ? new String()
		match Some(st){
			let t = mut st.get(st, i)
			match Some(t){
				if t.kind == BytecodeTokenKind.STRING{ k = 1 }
				if t.kind == BytecodeTokenKind.COMMENT{ k = 2 }
				ln = t.line + 0
			}
		}
		match Some(st){
			let t = mut st.get(st, i)
			match Some(t){ ? file.append(file, t.file) }
		}
		match Some(st){
			let t = mut st.get(st, i)
			match Some(t){ ? tx.append(tx, t.text) }
		}
		? o.appendU64(o, k)
		? o.appendChar(o, ':')
		? o.appendS64(o, wrap:<s64>(ln))
		? o.appendChar(o, ':')
		? o.append(o, file)
		? o.appendChar(o, ':')
		? o.appendU64(o, tx.length(tx))
		? o.appendChar(o, ':')
		? o.append(o, tx)
	}
}

@throws
func putProg(o: ref some mut String, p: ref imut BytecodeProgram) void{
	?catch(e){ throw e }
	let n = mut 0
	match Some(p){ n = p.size(p) }
	for i in 0..n{
		if i > 0{ ? o.appendChar(o, '|') }
		match Some(p){
			let st = mut p.get(p, i)
			? putStm(o, st)
		}
	}
}

@throws
func mkTok(text: static imut string, line: imut s32, kind: imut BytecodeTokenKind) owns some mut BytecodeToken{
	?catch(e){ throw e }
	let a = mut ? new String(text)
	let b = mut ? new String("f")
	let t = mut ? new BytecodeToken(a, b, line, kind)
	return t
}

@throws
func mkStm(n: imut s32) owns some mut BytecodeStatement{
	?catch(e){ throw e }
	let st = mut ? new BytecodeStatement()
	if n >= 1{
		let t1 = mut ? mkTok("A", 1, BytecodeTokenKind.CODE)
		? st.add(st, t1)
	}
	if n >= 2{
		let t2 = mut ? mkTok("\"b c\"", 1, BytecodeTokenKind.STRING)
		? st.add(st, t2)
	}
	if n >= 3{
		let t3 = mut ? mkTok("7", 1, BytecodeTokenKind.CODE)
		? st.add(st, t3)
	}
	return st
}

@throws
func mkProg(n: imut u64) owns some mut BytecodeProgram{
	?catch(e){ throw e }
	let p = mut ? new BytecodeProgram()
	for i in 0..n{
		let st = mut ? mkStm(wrap:<s32>(i % 4))
		? p.add(p, st)
	}
	return p
}

func chk(label: static imut string, got: ref imut String, want: static imut string) mut u64{
	let same = mut false
	match Some(got){ same = got.equals(got, want) }
	if same{
		return 0
	}
	print("FAIL ")
	print(label)
	print(" got ")
	println(got)
	print("   want ")
	println(want)
	return 1
}

@throws
func t0() mut u64{
	?catch(e){ throw e }
	let a = mut ? new String("\"a b\"\x0bPUSH\x0b'\\\\'\x0b")
	let f = mut ? new String("f.hob")
	let o = mut ? new String()
	let st = mut ? BytecodeParser.parseLine(a, f, 4)
	? putStm(o, st)
	return chk("parseLine#0", o, "1:4:f.hob:5:\"a b\" 0:4:f.hob:4:PUSH 0:4:f.hob:4:'\\\\'")
}
