// `--audit` with argument values: a function whose loop bound or allocation size is a PARAMETER is unbound on its own, but a caller that passes values it
// knows (literals, locals computed from literals, its own parameters, a range) gets a bound for that call. tests/audit_args_check.sh compares every figure with
// tests/gas_model.py (a concrete interpreter over the bytecode) and requires the callers below to be BOUNDED; the peak live heap is compared with the
// real allocator. The program also runs and prints PASS lines.
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

// loop bound = parameter
func sumTo(n: imut u64) mut u64{
	let s = mut 0
	for i in 0..n{
		s += i
	}
	return s
}

// loop bound = a local computed from the parameter
func sumLocal(n: imut u64) mut u64{
	let hi = mut (n + 2)
	let s = mut 0
	for i in 1..hi{
		s += i
	}
	return s
}

// two bounds, one a product
func grid(w: imut u64, h: imut u64) mut u64{
	let t = mut 0
	for y in 0..h{
		for x in 0..w{
			t += x + y
		}
	}
	return t
}

// forwards its parameter (and a derived value) to the callee
func outer(n: imut u64) mut u64{
	let a = mut sumTo(n)
	let b = mut sumTo(n + 1)
	return a + b
}

// the bound is the range argument: the recursion is lowered to a loop over it
@recursive
func tri(acc: mut u64, r: imut range) mut u64{
	match r is base{ return acc }
	let lo = mut (r.start + 1)
	let hi = mut r.end
	let r2 = imut (lo..hi)
	match r2 within r{ return tri(acc + r.start, r2) }
	else{ return acc }
}

// the parameter is changed before it is passed on
func viaMod(n: mut u64) mut u64{
	n += 5
	let t = mut sumTo(n)
	n = n * 2
	return t + sumTo(n)
}

struct Node{@pub{
	value: mut u64
}}

// allocates a block whose size is a parameter, and one node per iteration
func grow(n: imut u64) mut u64{
	?catch(e){ return 0 }
	let d = mut ?dyn([0])
	d = mut ?resize(d, n, 0)
	let t = mut 0
	for i in 0..n{
		let nd = mut ?new Node{value= i}
		t += nd.value
	}
	return t + len(d)
}

func main() void{
	let a = mut sumTo(5)
	check("sumTo 5", a == 10)
	let b = mut sumTo(7)
	check("sumTo 7", b == 21)
	let c = mut sumLocal(3)
	check("sumLocal 3", c == 10)
	let g = mut grid(3, 4)
	check("grid 3 4", g == 30)
	let o = mut outer(4)
	check("outer 4", o == 16)
	let t = mut tri(0, 0..6)
	check("tri 0..6", t == 15)
	let m = mut viaMod(2)
	check("viaMod 2", m == 21 + 91)
	let w = mut grow(6)
	check("grow 6", w == 21)
}
