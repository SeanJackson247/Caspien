// yield inside a held lock is an error
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
import "../stdlib/par_call.caspien"
import "../stdlib/await_call.caspien"
enum Gate{ OPEN, CLOSED }
@lock(match self.gate : OPEN)
struct Box{@pub{ swap gate: atomic mut Gate
	n: mut u64 }}
let static box = mut Box{gate= Gate.OPEN, n= mut 0}

func main() void{
	match @lock box{
		OPEN:{
			box.n += 1
			yield
		}
		CLOSED:default(10)
	}
}
