	c_rfShift("rfShift 0 ROTL 6 %t0 %t3 #-3", 0, "ROTL", 6, "%t0", "%t3", "#-3", "    movq %r12, %rax\n    xorl %eax, %eax\n|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfShift("rfShift 0 SAR 6 #5 %t0 %s", 0, "SAR", 6, "#5", "%t0", "%s", "EX")
