	c_rfBrc("rfBrc 0 EQ #5 #-2147483649 $5", 0, "EQ", "#5", "#-2147483649", "$5", "    movq $-2147483649, %r15\n    cmpq $5, %r15\n    jne $5\n|ret=jne|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfBrc("rfBrc 0 BAD %v1 abc foo", 0, "BAD", "%v1", "abc", "foo", "EX")
	c_rfBrc("rfBrc 0 NEQ %s #2147483648 ", 0, "NEQ", "%s", "#2147483648", "", "    movl $2147483648, %r15d\n    cmpq %r15, %r15\n    je \n|ret=je|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfBrc("rfBrc 0 LT_EQ %s 5 %rax", 0, "LT_EQ", "%s", "5", "%rax", "EX")
