func part0() void{
	c_rfBrc("rfBrc 0 GT_EQ %v1 #2147483648 %rax", 0, "GT_EQ", "%v1", "#2147483648", "%rax", "    movl $2147483648, %r15d\n    cmpq %r15, %r14\n    jb %rax\n|ret=jb|d=0;v=-1;m=2;u=true;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfBrc("rfBrc 0 NEQ x abc x y", 0, "NEQ", "x", "abc", "x y", "EX")
	c_rfBrc("rfBrc 0 SLT %v1 %t3 ", 0, "SLT", "%v1", "%t3", "", "    cmpq %r12, %r14\n    jge \n|ret=jge|d=0;v=-1;m=2;u=true;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfBrc("rfBrc 0 EQ #5 5 x y", 0, "EQ", "#5", "5", "x y", "EX")
	c_rfBrc("rfBrc 0 EQ x %s a.b", 0, "EQ", "x", "%s", "a.b", "EX")
	c_rfBrc("rfBrc 0 BAD %t0 %v1 $5", 0, "BAD", "%t0", "%v1", "$5", "EX")
	c_rfBrc("rfBrc 0 NEQ %v1 #5 x y", 0, "NEQ", "%v1", "#5", "x y", "    cmpq $5, %r14\n    je x y\n|ret=je|d=0;v=-1;m=2;u=true;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfBrc("rfBrc 0 GT_EQ %s 5 x y", 0, "GT_EQ", "%s", "5", "x y", "EX")
	c_rfBrc("rfBrc 0 BAD #5 abc -8(%rbp)", 0, "BAD", "#5", "abc", "-8(%rbp)", "EX")
	c_rfBrc("rfBrc 0 EQ %s #-3 x y", 0, "EQ", "%s", "#-3", "x y", "    cmpq $-3, %r15\n    jne x y\n|ret=jne|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfBrc("rfBrc 0 SGT_EQ #5 # %rax", 0, "SGT_EQ", "#5", "#", "%rax", "EX")
	c_rfBrc("rfBrc 0 LT %s abc -8(%rbp)", 0, "LT", "%s", "abc", "-8(%rbp)", "EX")
	c_rfBrc("rfBrc 0 EQ %t3 # x y", 0, "EQ", "%t3", "#", "x y", "EX")
	c_rfBrc("rfBrc 0 NEQ %t0 5 foo", 0, "NEQ", "%t0", "5", "foo", "EX")
	c_rfBrc("rfBrc 0 SLT %s %v1 foo", 0, "SLT", "%s", "%v1", "foo", "    cmpq %r14, %r15\n    jge foo\n|ret=jge|d=0;v=-1;m=2;u=true;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfBrc("rfBrc 0 SLT %t3 # a.b", 0, "SLT", "%t3", "#", "a.b", "EX")
	c_rfBrc("rfBrc 0 EQ x #2147483648 %rax", 0, "EQ", "x", "#2147483648", "%rax", "EX")
	c_rfBrc("rfBrc 0 LT_EQ %t0 # x y", 0, "LT_EQ", "%t0", "#", "x y", "EX")
	c_rfBrc("rfBrc 0 NEQ %v1 %t3 16(%rax)", 0, "NEQ", "%v1", "%t3", "16(%rax)", "    cmpq %r12, %r14\n    je 16(%rax)\n|ret=je|d=0;v=-1;m=2;u=true;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfBrc("rfBrc 0 BAD %v1 #5 ", 0, "BAD", "%v1", "#5", "", "EX")
	c_rfBrc("rfBrc 0 SLT #5 #5 $5", 0, "SLT", "#5", "#5", "$5", "    movl $5, %r15d\n    cmpq $5, %r15\n    jle $5\n|ret=jle|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfBrc("rfBrc 0 EQ %s #-2147483649 %rax", 0, "EQ", "%s", "#-2147483649", "%rax", "    movq $-2147483649, %r15\n    cmpq %r15, %r15\n    jne %rax\n|ret=jne|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfBrc("rfBrc 0 BAD %t3 #-3 foo", 0, "BAD", "%t3", "#-3", "foo", "EX")
	c_rfBrc("rfBrc 0 NEQ #5 %s -8(%rbp)", 0, "NEQ", "#5", "%s", "-8(%rbp)", "    cmpq $5, %r15\n    je -8(%rbp)\n|ret=je|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfBrc("rfBrc 0 LT x #-3 %rax", 0, "LT", "x", "#-3", "%rax", "EX")
