	c_rfBrc("rfBrc 0 BAD %t3 # %rax", 0, "BAD", "%t3", "#", "%rax", "EX")
	c_rfBrc("rfBrc 0 GT_EQ %t0 $-16 16(%rax)", 0, "GT_EQ", "%t0", "$-16", "16(%rax)", "    cmpq -16(%rbp), %rax\n    jb 16(%rax)\n|ret=jb|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfBrc("rfBrc 0 BAD %t3 %t3 $5", 0, "BAD", "%t3", "%t3", "$5", "EX")
	c_rfBrc("rfBrc 0 LT %t3 $-16 foo", 0, "LT", "%t3", "$-16", "foo", "    cmpq -16(%rbp), %r12\n    jae foo\n|ret=jae|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfBrc("rfBrc 0 NEQ %t3 %t3 %rax", 0, "NEQ", "%t3", "%t3", "%rax", "    cmpq %r12, %r12\n    je %rax\n|ret=je|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfBrc("rfBrc 0 BAD #5 5 %rax", 0, "BAD", "#5", "5", "%rax", "EX")
	c_rfBrc("rfBrc 0 BAD %t3 # 16(%rax)", 0, "BAD", "%t3", "#", "16(%rax)", "EX")
	c_rfBrc("rfBrc 0 LT %t3 5 x y", 0, "LT", "%t3", "5", "x y", "EX")
	c_rfBrc("rfBrc 0 GT_EQ x $24 ", 0, "GT_EQ", "x", "$24", "", "EX")
	c_rfBrc("rfBrc 0 NEQ %v1 #-2147483649 -8(%rbp)", 0, "NEQ", "%v1", "#-2147483649", "-8(%rbp)", "    movq $-2147483649, %r15\n    cmpq %r15, %r14\n    je -8(%rbp)\n|ret=je|d=0;v=-1;m=2;u=true;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfBrc("rfBrc 0 BAD %v1 %t3 16(%rax)", 0, "BAD", "%v1", "%t3", "16(%rax)", "EX")
	c_rfBrc("rfBrc 0 EQ %s # ", 0, "EQ", "%s", "#", "", "EX")
	c_rfBrc("rfBrc 0 BAD %t3 #5 16(%rax)", 0, "BAD", "%t3", "#5", "16(%rax)", "EX")
