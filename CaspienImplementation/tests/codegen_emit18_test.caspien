	c_rfFloat("rfFloat 0 True GT 6 %v1 %x1 #5 a.b", 0, true, "GT", 6, "%v1", "%x1", "#5", "a.b", "    ucomisd .LFC0(%rip), %xmm9\n    jbe a.b\n|d=0;v=-1;m=2;u=true;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfFloat("rfFloat 0 False SUB 8 #5 $-8 #1073741824 foo", 0, false, "SUB", 8, "#5", "$-8", "#1073741824", "foo", "EX")
