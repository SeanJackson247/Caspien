// 'match @lock': every non-target (CLOSED) path must end in 'continue' (retry the acquire, which safe code writes as CLOSED:default(n)),
// 'break' (give up without the lock), 'return' or 'throw'. Falling off the end is a compile error.
import "../stdlib/libc.caspien"

enum St{ OPEN, CLOSED }

struct Mtx{@pub{
	swap lockState: atomic mut St
	n: mut u64
}}

// a second lock type whose policy opens the (held) lock on the third failed attempt, to show a retry that succeeds
struct RMtx{@pub{
	swap lockState: atomic mut St
	n: mut u64
}}
let static rm = mut RMtx{lockState= St.OPEN, n= mut 0}
let static failed = mut atomic 0

impl default match @lock RMtx{
	CLOSED:(tries:imut u64, limit:imut u64)=>{
		let t = mut (tries + 0)
		unsafe atomic{ failed = t }
		if tries == 3{
			unsafe atomic{ rm.lockState swap St.OPEN }
		}
		continue
	}
}

// a swap-mutex struct held in a plain local (used to segfault: the lock field's value was used as its address)
func localTest() void{
	let m = mut Mtx{lockState= St.OPEN, n= mut 0}
	match @lock m{
		OPEN:{
			m.n += 1
			unsafe extern{ printf("local: got lock n=%llu\n", m.n) }
		}
		CLOSED:default(1000000000)
	}
}

// retry (through the policy): three failed attempts, then the policy frees the lock and the fourth attempt succeeds
func retryTest() void{
	unsafe atomic{ rm.lockState swap St.CLOSED }
	match @lock rm{
		OPEN:{
			let f = mut 0
			unsafe atomic{ f = mut failed }
			unsafe extern{ printf("retry: got lock after %llu failed attempts\n", f) }
		}
		CLOSED:default(10)
	}
}

// break = give up: the lock is never taken, execution continues after the match
func giveUpTest() void{
	let static m = mut Mtx{lockState= St.OPEN, n= mut 0}
	unsafe atomic{ m.lockState swap St.CLOSED }
	match @lock m{
		OPEN:{
			unsafe extern{ printf("giveup: WRONG, got lock\n") }
		}
		CLOSED:{
			break
		}
	}
	unsafe extern{ printf("giveup: gave up, carried on\n") }
}

// return from CLOSED
func returnTest() mut u64{
	let static m = mut Mtx{lockState= St.OPEN, n= mut 0}
	unsafe atomic{ m.lockState swap St.CLOSED }
	match @lock m{
		OPEN:{
			return 1
		}
		CLOSED:{
			return 2
		}
	}
	return 3
}

// mixed paths: each branch ends in a different terminator
func mixedTest() mut u64{
	let static m = mut Mtx{lockState= St.OPEN, n= mut 7}
	unsafe atomic{ m.lockState swap St.CLOSED }
	let k = mut 0
	match @lock m{
		OPEN:{
			return 0
		}
		CLOSED:{
			k++
			if k == 1{
				return 9
			}
			else{
				break
			}
		}
	}
	return 3
}

func main() void{
	retryTest()
	localTest()
	giveUpTest()
	unsafe extern{ printf("return: %llu\n", returnTest()) }
	unsafe extern{ printf("mixed: %llu\n", mixedTest()) }
}
