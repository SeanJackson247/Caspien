// A throw out of the OPEN case of 'match @lock' must release the lock.
// Expected: PASS. holdAndThrow() throws from OPEN; main catches it; reacquire() retries the lock.
import "../stdlib/libc.caspien"

enum St{ OPEN, CLOSED }

struct Mtx{@pub{
	swap lockState: atomic mut St
	n: mut u64
}}

let static m = mut Mtx{lockState= St.OPEN, n= mut 0}

@throws
func holdAndThrow() void{
	match @lock m{
		OPEN:{
			throw "boom"
		}
		CLOSED:default(1000000000)
	}
}

func reacquire() void{
	let got = mut false
	match @lock m{
		OPEN:{
			got = mut true
			unsafe extern{ printf("PASS: lock was released by the throw\n") }
		}
		CLOSED:default(1000)
	}
	if !got{
		unsafe extern{ printf("FAIL: lock still held after the throw\n") }
	}
}

func main() void{
	try{
		?catch(e){ continue }
		?holdAndThrow()
	}
	reacquire()
}
