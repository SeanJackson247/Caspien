// `@drop` on a function: the drop glue calls it with the struct's address just before an `owns` value of that struct is freed
// (scope end, a throw unwinding past it, a member of another struct, an element of a dynarray). Each close prints a line.
// Prints CLOSE lines in the exact order the model expects; the final PASS/FAIL compares the whole order.
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"

struct Res{@pub{
	id: mut u64
}}

let static log = mut 0

@drop
func resClose(r: ref some mut Res) void{
	unsafe extern global{
		log = log * 10 + r.id
		printf("close %llu\n", r.id)
	}
}

struct Box{@pub{
	inner: owns some mut Res
	tag: mut u64
}}

@throws
func thrower() void{
	?catch(e){ throw e }
	let r = mut ?new Res{id= 3}
	throw "boom"
}

func scoped() void{
	?catch(e){ return }
	let a = mut ?new Res{id= 1}
	let b = mut ?new Res{id= 2}
}

func caught() void{
	try{
		?catch(e){ unsafe extern{ printf("caught\n") } 
			return }
		?thrower()
	}
}

func boxed() void{
	?catch(e){ return }
	let r = mut ?new Res{id= 4}
	let bx = mut ?new Box{inner= r, tag= 9}
}

func inDyn() void{
	?catch(e){ return }
	let r1 = mut ?new Res{id= 5}
	let r2 = mut ?new Res{id= 6}
	let arr = mut ?dyn([r1, r2])
}

func main() void{
	scoped()
	caught()
	boxed()
	inDyn()
	let got = mut 0
	unsafe global{ got = log }
	unsafe extern{
		if got == 21345 * 10 + 6 + 0{ printf("PASS drop order\n") }
		else{ printf("FAIL drop order %llu\n", got) }
	}
}
