// Differential test of the converted collectDeclarations against the Java original (check lines generated by gen_codegen_decl_test.py).
import "stdlib/libc.caspien"
import "stdlib/gt/*"
import "../Codegen/src/main/java/caspien/codegen/x86backend/X86Backend.caspien"

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

func nb(win: imut bool) owns mut X86Backend{
	?catch(e){ return null }
	if win{
		let w = mut ? new X86Backend(CodegenTarget.WINDOWS_GNU_X64)
		? w.wire(w)
		return w
	}
	let b = mut ? new X86Backend(CodegenTarget.LINUX_X64)
	? b.wire(b)
	return b
}

func chk(name: static imut string, got: ref imut String, want: static imut string) void{
	let ok = mut String.literalsEqual(want, "EX")
	match Some(got){
		ok = got.equals(got, want)
	}
	check(name, ok)
}

func fill(lines: ref mut ObjectList<BytecodeStatement>, spec: static imut string) void{
	?catch(e){ return }
	let s = mut ? new String(spec)
	let stmt = mut ? new BytecodeStatement()
	let tok = mut ? new String()
	let n = mut s.length(s)
	for i in 0..n{
		let c = mut s.charAt(s, i)
		if c == ' ' || c == ';'{
			let f = mut ? new String("f")
			let tk = mut ? new BytecodeToken(tok, f, 1, BytecodeTokenKind.CODE)
			? stmt.items.add(stmt.items, tk)
			tok = ? new String()
			if c == ';'{
				match Some(lines){ ? lines.add(lines, stmt) }
				stmt = ? new BytecodeStatement()
			}
		} else{
			? tok.appendChar(tok, c)
		}
	}
}

func num3(out: ref some mut String, v: ref some imut DynamicArray<s64>, count: mut u64) void{
	?catch(e){ return }
	for i in 0..count{
		match i in v.backing{
			? out.appendS64(out, v.backing[i])
			if i + 1 < count{ ? out.append(out, ",") }
		}
	}
}

func t_decl(spec: static imut string) owns mut String{
	?catch(e){ return null }
	let b = mut nb(false)
	let lines = mut ? new ObjectList:<BytecodeStatement>()
	fill(lines, spec)
	match Some(b){ match Some(b.emit){ match Some(lines){ ? b.emit.collectDeclarations(b.emit, lines) } } }
	let out = mut ? new String("SI:")
	let n = mut 0
	match Some(b){ match Some(b.core){ n = b.core.globalsSizeInit.size(b.core.globalsSizeInit) } }
	for i in 0..n{
		let key = mut ? new String()
		match Some(b){ match Some(b.core){
			let k = b.core.globalsSizeInit.keyAt(b.core.globalsSizeInit, i)
			match Some(k){ key = ? k.substring(k, 0) }
		} }
		? out.append(out, key)
		? out.append(out, "=")
		match Some(b){ match Some(b.core){
			let v = b.core.globalsSizeInit.valueAt(b.core.globalsSizeInit, i)
			match Some(v){ num3(out, v, 2) }
		} }
		? out.append(out, "|")
	}
	? out.append(out, ";HI:")
	match Some(b){ match Some(b.core){ n = b.core.globalsHasInit.size(b.core.globalsHasInit) } }
	for i2 in 0..n{
		let key2 = mut ? new String()
		let flag = mut false
		match Some(b){ match Some(b.core){
			flag = b.core.globalsHasInit.valueAt(b.core.globalsHasInit, i2, false)
		} }
		match Some(b){ match Some(b.core){
			let k2 = b.core.globalsHasInit.keyAt(b.core.globalsHasInit, i2)
			match Some(k2){ key2 = ? k2.substring(k2, 0) }
		} }
		? out.append(out, key2)
		if flag{ ? out.append(out, "=true|") } else{ ? out.append(out, "=false|") }
	}
	? out.append(out, ";AO:")
	match Some(b){ match Some(b.core){ n = b.core.globalAliasOffset.size(b.core.globalAliasOffset) } }
	for i3 in 0..n{
		let key3 = mut ? new String()
		let:<mut s64> val3 = mut 0
		match Some(b){ match Some(b.core){
			val3 = b.core.globalAliasOffset.valueAt(b.core.globalAliasOffset, i3, 0)
		} }
		match Some(b){ match Some(b.core){
			let k3 = b.core.globalAliasOffset.keyAt(b.core.globalAliasOffset, i3)
			match Some(k3){ key3 = ? k3.substring(k3, 0) }
		} }
		? out.append(out, key3)
		? out.append(out, "=")
		? out.appendS64(out, val3)
		? out.append(out, "|")
	}
	? out.append(out, ";AP:")
	match Some(b){ match Some(b.core){ n = b.core.globalAliasParent.size(b.core.globalAliasParent) } }
	for i4 in 0..n{
		let key4 = mut ? new String()
		let val4 = mut ? new String()
		match Some(b){ match Some(b.core){
			let k4 = b.core.globalAliasParent.keyAt(b.core.globalAliasParent, i4)
			match Some(k4){ key4 = ? k4.substring(k4, 0) }
		} }
		match Some(b){ match Some(b.core){
			let v4 = b.core.globalAliasParent.valueAt(b.core.globalAliasParent, i4)
			match Some(v4){ val4 = ? v4.substring(v4, 0) }
		} }
		? out.append(out, key4)
		? out.append(out, "=")
		? out.append(out, val4)
		? out.append(out, "|")
	}
	? out.append(out, ";AI:")
	match Some(b){ match Some(b.core){ n = b.core.aliasInits.size(b.core.aliasInits) } }
	for i5 in 0..n{
		let key5 = mut ? new String()
		match Some(b){ match Some(b.core){
			let k5 = b.core.aliasInits.keyAt(b.core.aliasInits, i5)
			match Some(k5){ key5 = ? k5.substring(k5, 0) }
		} }
		? out.append(out, key5)
		? out.append(out, "=")
		let m = mut 0
		match Some(b){ match Some(b.core){
			let lst = b.core.aliasInits.valueAt(b.core.aliasInits, i5)
			match Some(lst){ m = lst.size(lst) }
		} }
		for j in 0..m{
			match Some(b){ match Some(b.core){
				let lst2 = b.core.aliasInits.valueAt(b.core.aliasInits, i5)
				match Some(lst2){
					let e = lst2.get(lst2, j)
					match Some(e){ num3(out, e, 3) }
				}
			} }
			? out.append(out, "/")
		}
		? out.append(out, "|")
	}
	? out.append(out, ";SL:")
	match Some(b){ match Some(b.core){ n = b.core.stringLiterals.size(b.core.stringLiterals) } }
	for i6 in 0..n{
		let key6 = mut ? new String()
		let val6 = mut ? new String()
		match Some(b){ match Some(b.core){
			let k6 = b.core.stringLiterals.keyAt(b.core.stringLiterals, i6)
			match Some(k6){ key6 = ? k6.substring(k6, 0) }
		} }
		match Some(b){ match Some(b.core){
			let v6 = b.core.stringLiterals.valueAt(b.core.stringLiterals, i6)
			match Some(v6){ val6 = ? v6.substring(v6, 0) }
		} }
		? out.append(out, key6)
		? out.append(out, "=")
		? out.append(out, val6)
		? out.append(out, "|")
	}
	? out.append(out, ";FN:")
	let f0 = mut false
	let f1 = mut false
	let f2 = mut false
	let f3 = mut false
	match Some(b){ match Some(b.core){
		f0 = b.core.declaredFunctionNames.contains(b.core.declaredFunctionNames, "main")
		f1 = b.core.declaredFunctionNames.contains(b.core.declaredFunctionNames, "f")
		f2 = b.core.declaredFunctionNames.contains(b.core.declaredFunctionNames, "g")
		f3 = b.core.declaredFunctionNames.contains(b.core.declaredFunctionNames, "helper")
	} }
	if f0{ ? out.append(out, "main=true|") } else{ ? out.append(out, "main=false|") }
	if f1{ ? out.append(out, "f=true|") } else{ ? out.append(out, "f=false|") }
	if f2{ ? out.append(out, "g=true|") } else{ ? out.append(out, "g=false|") }
	if f3{ ? out.append(out, "helper=true|") } else{ ? out.append(out, "helper=false|") }
	return out
}

func c_decl(name: static imut string, spec: static imut string, want: static imut string) void{
	let r = mut t_decl(spec)
	chk(name, r, want)
}

func part0() void{
	c_decl("collectDeclarations 1", "STRING s3 \"a\\n\";GLOBAL c.d 8 1.5;GLOBAL b 4 0;GLOBAL a.y.k x;GLOBAL b.q 2;GLOBAL a.y 24;NOP x;GLOBAL b 1 9223372036854775807;", "EX")
