// An owner freed (moved into a consuming call) inside the match Some body that proved its ref alive: using the ref afterwards must be rejected.
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
struct Node{@pub{ value: mut u64 }}
func consume(n: owns mut Node) void{ }
func viaCall(n: owns mut Node) void{
	consume(n)
}
func main() void{
	?catch(e){ return }
	let a = mut ?new Node{value= 111}
	let r = mut ref a
	let seen = mut 0
	match Some(r){
		consume(a)
		seen = r.value
	}
}
