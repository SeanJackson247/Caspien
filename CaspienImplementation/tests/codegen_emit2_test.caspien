// Differential test of converted emit2 methods against the Java originals (generated by gen_codegen_emit_test.py emit2).
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
import "../Codegen/src/main/java/caspien/codegen/x86backend/X86Backend.caspien"

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

func nb(su: mut s32) owns mut X86Backend{
	?catch(e){ return null }
	if su == 4{
		let w = mut ? new X86Backend(CodegenTarget.WINDOWS_GNU_X64)
		? w.wire(w)
		return w
	}
	let b = mut ? new X86Backend(CodegenTarget.LINUX_X64)
	? b.wire(b)
	if su == 1{
		let ix = mut ? String.from("rcx")
		match Some(b){ match Some(b.core){
			b.core.rfIdxReg = ix
			b.core.rfIdxScale = 4
			b.core.rfIdxDisp = 8
		} }
	}
	if su == 2{
		let ov = mut ? String.from("16(%rax)")
		match Some(b){ match Some(b.core){ b.core.rfMemOverride = ov } }
	}
	if su == 3{
		let k1 = mut ? String.from("g.a")
		let k2 = mut ? String.from("g.a")
		let v2 = mut ? String.from("par.ent")
		match Some(b){ match Some(b.core){
			? b.core.globalAliasOffset.put(b.core.globalAliasOffset, k1, 24)
			? b.core.globalAliasParent.put(b.core.globalAliasParent, k2, v2)
		} }
	}
	return b
}

func outOf(b: ref imut X86Backend) owns mut String{
	?catch(e){ return null }
	let r = mut ? new String()
	match Some(b){ match Some(b.core){ r = ? b.core.out.substring(b.core.out, 0) } }
	return r
}

func verdict(label: static imut string, thrown: imut bool, b: ref imut X86Backend, want: static imut string) void{
	if thrown{
		check(label, String.literalsEqual(want, "EX"))
		return
	}
	let o = mut outOf(b)
	let ok = mut false
	match Some(o){ ok = o.equals(o, want) }
	check(label, ok)
}

func c_loadSizedFromFrame(label: static imut string, su: mut s32, a0: static imut string, a1: mut s64, a2: mut s32, want: static imut string) void{
	?catch(ex){
		check(label, false)
		return
	}
	let thrown = mut false
	let b = mut nb(su)
	let s0 = mut ? new String(a0)
	try{
		match Some(b){ match Some(b.emit){
			try b.emit.loadSizedFromFrame(b.emit, s0, a1, a2) catch(e){
				thrown = true
				continue
			}
		} }
	}
	verdict(label, thrown, b, want)
}

