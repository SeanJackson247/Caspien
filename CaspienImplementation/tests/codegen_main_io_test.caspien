// Main.writeFile/readFile of the Codegen port (computed file names, no unsafe in the port). Run by codegen_main_io_check.sh, which
// renames the port's `func main`, whitelists /tmp/caspien_cg_io:rw and checks the bytes on disk against a Python model.
import "../Codegen/src/main/java/caspien/codegen/Main.caspien"

func report(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) } else { printf("FAIL %s\n", name) }
	}
}

func pattern(n: mut u64) owns mut String{
	?catch(e){ return null }
	let s = mut ? new String()
	for i in 0..n{
		let k = mut (i % 26)
		let c = mut 'a'
		for j in 0..k{
			c = nextLetter(c)
		}
		? s.appendChar(s, c)
	}
	return s
}

func nextLetter(c: mut char) mut char{
	if c == 'a'{ return 'b' } elseif c == 'b'{ return 'c' } elseif c == 'c'{ return 'd' } elseif c == 'd'{ return 'e' } elseif c == 'e'{ return 'f' }
	elseif c == 'f'{ return 'g' } elseif c == 'g'{ return 'h' } elseif c == 'h'{ return 'i' } elseif c == 'i'{ return 'j' } elseif c == 'j'{ return 'k' }
	elseif c == 'k'{ return 'l' } elseif c == 'l'{ return 'm' } elseif c == 'm'{ return 'n' } elseif c == 'n'{ return 'o' } elseif c == 'o'{ return 'p' }
	elseif c == 'p'{ return 'q' } elseif c == 'q'{ return 'r' } elseif c == 'r'{ return 's' } elseif c == 's'{ return 't' } elseif c == 't'{ return 'u' }
	elseif c == 'u'{ return 'v' } elseif c == 'v'{ return 'w' } elseif c == 'w'{ return 'x' } elseif c == 'x'{ return 'y' } elseif c == 'y'{ return 'z' }
	return 'a'
}

func nameOf(k: mut u64) owns mut String{
	?catch(e){ return null }
	let s = mut ? new String()
	? s.appendChar(s, 'f')
	let c = mut 'a'
	for j in 0..k{ c = nextLetter(c) }
	? s.appendChar(s, c)
	? s.appendChar(s, '.')
	? s.appendChar(s, 't')
	return s
}

/** 1 when file k (name fK.t, content pattern(n)) is written and read back equal. */
func one(d: ref imut Dir, k: mut u64, n: mut u64) mut u64{
	?catch(e){ return 0 }
	let name = mut nameOf(k)
	let text = mut pattern(n)
	let ok = mut 0
	match Some(name){
		match Some(text){
			? Main.writeFile(d, name, text)
			let back = mut ? Main.readFile(d, name)
			match Some(back){
				if back.length(back) == n{
					ok = 1
					for i in 0..n{
						match Some(text){
							if back.charAt(back, i) != text.charAt(text, i){ ok = 0 }
						}
					}
				}
			}
		}
	}
	return ok
}

func main() imut s32{
	?catch(e){
		unsafe extern{ printf("FAIL uncaught %s\n", e.msg) }
		return 1
	}
	let d = mut ? Dir.rootRW("/tmp/caspien_cg_io")
	match Some(d){
		report("write+read 0 chars", one(d, 0, 0) == 1)
		report("write+read 1 char", one(d, 1, 1) == 1)
		report("write+read 5000 chars", one(d, 2, 5000) == 1)
		report("overwrite shorter", one(d, 2, 3) == 1)
	}
	return 0
}
