	check("rfTrueSuffix ge", String.literalsEqual(t_suffix("jl"), "ge"))
	check("rfMirrorJump jmp", String.literalsEqual(t_mirror("jmp"), "jmp"))
	check("rfTrueSuffix EX", String.literalsEqual(t_suffix("jmp"), "EX"))
