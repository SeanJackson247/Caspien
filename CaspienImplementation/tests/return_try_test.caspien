// Regression test: `return ?f(x)` (and `return try f(x) catch(e){...}`) must run its catch when f throws. It used to compile to a plain call:
// the `?catch` was ignored, the throw simply propagated. Also covers a re-throwing catch (message kept), `?new` in a return, an owns local
// destructed on the catch path, a return inside a loop and a catch ending in `continue`. Identical with inlining off and at every preset.
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
extern strcmp(static imut string, static imut string) mut s32

struct Box{
	@pub{ v: mut u64 }
}

func check(name: static imut string, ok: mut bool) void{
	unsafe extern{
		if ok{
			printf("PASS %s\n", name)
		}else{
			printf("FAIL %s\n", name)
		}
	}
	return
}

@throws
func f(x: mut u64) mut u64{
	if x > 5{
		throw "big"
	}
	return x + 1
}

func viaQ(x: mut u64) mut u64{
	?catch(e){ return 999 }
	return ?f(x)
}

func viaTry(x: mut u64) mut u64{
	return try f(x) catch(e){ return 555 }
}

@throws
func rethrow(x: mut u64) mut u64{
	?catch(e){ throw e }
	return ?f(x)
}

func viaRethrow(x: mut u64) mut u64{
	?catch(e){ return 888 }
	return ?rethrow(x)
}

func message(x: mut u64) mut bool{
	let same = mut false
	try{
		?catch(e){
			unsafe extern{
				if strcmp(e.msg, "big") == 0{
					same = true
				}
			}
			continue
		}
		let v = mut ?f(x)
	}
	return same
}

@throws
func makeBox(n: mut u64) owns some mut Box{
	?catch(e){ throw e }
	return ?new Box{v= n}
}

func boxValue(n: mut u64) mut u64{
	?catch(e){ return 0 }
	let b = mut ?makeBox(n)
	let r = mut 0
	match Some(b){
		let copy = mut deref(b)
		r = copy.v
	}
	return r
}

func withOwns(x: mut u64) mut u64{
	?catch(e){ return 4242 }
	let b = mut ?makeBox(7)
	return ?f(x)
}

func inLoop(n: mut u64) mut u64{
	?catch(e){ return 1000 }
	let t = mut 0
	for i in 0..n{
		t = t + i
		if i == 4{
			return ?f(i + 10)
		}
	}
	return t
}

func afterTryBlock(x: mut u64) mut u64{
	try{
		?catch(e){ continue }
		if x < 100{
			return ?f(x)
		}
	}
	return 321
}

func main() void{
	check("no throw", viaQ(2) == 3)
	check("throw caught by the ?catch", viaQ(9) == 999)
	check("explicit try in return, no throw", viaTry(1) == 2)
	check("explicit try in return, thrown", viaTry(8) == 555)
	check("re-throwing catch, no throw", viaRethrow(3) == 4)
	check("re-throwing catch, thrown, caught above", viaRethrow(7) == 888)
	check("catch sees the thrown message", message(9) == true)
	check("return ?new, value", boxValue(12) == 12)
	check("owns local and a throw", withOwns(9) == 4242)
	check("owns local, no throw", withOwns(1) == 2)
	check("return in a loop, thrown", inLoop(10) == 1000)
	check("return in a loop, loop ends first", inLoop(3) == 3)
	check("catch ending in continue", afterTryBlock(9) == 321)
	check("continue variant, no throw", afterTryBlock(2) == 3)
}
