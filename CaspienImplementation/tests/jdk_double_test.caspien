// Double.toString / Float.toString / BigDecimal.toPlainString (stdlib/jdk_double.caspien) against the JDK: this program and JdkDoubleOracle.java generate the same
// deterministic vectors (special bit patterns, powers of two with neighbours, random bit patterns, decimals D/10^k) and print "kind bits toString plain" lines;
// jdk_double_check.sh diffs the two outputs. Vector count per random family is fixed at 800 (the full 20000-vector run, 144919 lines, was identical to the JDK; ~600 lines/s because the digit search is exact BigInt arithmetic).
import "stdlib/libc.caspien"
import "stdlib/print_string.caspien"
import "stdlib/jdk_double.caspien"
import "stdlib/gt/*"

@throws
func plainOf(s: ref some imut String) owns some mut String{
	?catch(e){
		throw e
	}
	let hasPoint = mut (s.indexOf(s, mut '.') >= 0)
	let hasE = mut (s.indexOf(s, mut 'E') >= 0)
	let out = mut ? new String()
	if s.charAt(s, 0) == 'N' || s.charAt(s, 0) == 'I' || (s.length(s) > 1 && s.charAt(s, 1) == 'I'){
		? out.append(out, s)
		return out
	}
	out = ? BigDecimalText.toPlainString(s)
	if out.indexOf(out, mut '.') < 0{
		? out.append(out, mut '.')
		? out.append(out, mut '0')
	}
	return out
}

func emitD(bits: mut u64) void{
	?catch(e){
		unsafe extern{ printf("FAIL uncaught: %s\n", e.msg) }
		return
	}
	let v = mut Double.longBitsToDouble(bits)
	let s = mut ? Double.toString(v)
	let p = mut ? plainOf(s)
	let b = mut ? String.fromU64(bits)
	print("D ")
	print(b)
	print(" ")
	print(s)
	print(" ")
	print(p)
	print("\n")
}

func emitF(bits: mut u32) void{
	?catch(e){
		unsafe extern{ printf("FAIL uncaught: %s\n", e.msg) }
		return
	}
	let v = mut Float.intBitsToFloat(bits)
	let s = mut ? Float.toString(v)
	let p = mut ? plainOf(s)
	let b = mut ? String.fromU64(bits as u64)
	print("F ")
	print(b)
	print(" ")
	print(s)
	print(" ")
	print(p)
	print("\n")
}

/** The f64 bits of the integer n (< 2^53, exact), built by hand because there is no integer-to-float conversion. */
func u2d(n: mut u64) mut u64{
	if n == 0{
		return 0
	}
	let bl = mut 0
	for i in 0..64{
		if bits_and(bits_right(n, i), 1) == 1{
			bl = i + 1
		}
	}
	let frac = mut bits_and(bits_left(n, 53 - bl), 4503599627370495)
	return bits_or(bits_left(1022 + bl, 52), frac)
}

/** The f32 bits of the integer n (< 2^24, exact). */
func u2f(n: mut u64) mut u32{
	if n == 0{
		return 0
	}
	let bl = mut 0
	for i in 0..64{
		if bits_and(bits_right(n, i), 1) == 1{
			bl = i + 1
		}
	}
	let frac = mut bits_and(bits_left(n, 24 - bl), 8388607)
	return wrap:<u32>(bits_or(bits_left(126 + bl, 23), frac))
}

func decD(dd: mut u64, k: mut u64) mut u64{
	let out = mut 0
	unsafe assume{
		let:<mut f64> pd = mut 1.0
		for j in 0..k{
			assume match pd : finite
			pd = pd * 10.0
		}
		let num = mut Double.longBitsToDouble(u2d(dd))
		assume match num : finite
		assume match pd : finite
		let v = mut (num / pd)
		out = Double.doubleToRawLongBits(v)
	}
	return out
}

func decF(dd: mut u64, k: mut u64) mut u32{
	let:<mut u32> out = mut 0
	unsafe assume{
		let:<mut f32> pf = mut 1.0
		for j in 0..k{
			assume match pf : finite
			pf = pf * 10.0
		}
		let num = mut Float.intBitsToFloat(u2f(dd % 16777215 + 1))
		assume match num : finite
		assume match pf : finite
		let v = mut (num / pf)
		out = Float.floatToRawIntBits(v)
	}
	return out
}

func main() void{
	let count = mut 800
	let st = mut 12345
	// special patterns
	emitD(0)
	emitD(0x8000000000000000)
	emitD(1)
	emitD(0x000fffffffffffff)
	emitD(0x0010000000000000)
	emitD(0x7fefffffffffffff)
	emitD(0x7ff0000000000000)
	emitD(0xfff0000000000000)
	emitD(0x7ff8000000000000)
	emitD(0xffefffffffffffff)
	emitF(0)
	emitF(0x80000000)
	emitF(1)
	emitF(0x007fffff)
	emitF(0x00800000)
	emitF(0x7f7fffff)
	emitF(0x7f800000)
	emitF(0xff800000)
	emitF(0x7fc00000)
	// powers of two with neighbours
	for e in 1..2047{
		let b = mut (e * 4503599627370496)
		emitD(b - 1)
		emitD(b)
		emitD(b + 1)
	}
	for e2 in 1..255{
		let b2 = mut wrap:<u32>(e2 * 8388608)
		emitF(b2 - 1)
		emitF(b2)
		emitF(b2 + 1)
	}
	// random bit patterns (all exponents, subnormals included)
	for i in 0..count{
		st = st + 0x9e3779b97f4a7c15
		let z = mut st
		z = bits_xor(z, bits_right(z, 30)) * 0xbf58476d1ce4e5b9
		z = bits_xor(z, bits_right(z, 27)) * 0x94d049bb133111eb
		z = bits_xor(z, bits_right(z, 31))
		emitD(z)
		emitF(wrap:<u32>(bits_and(z, 4294967295)))
		// subnormal-ish and small-significand patterns
		emitD(bits_and(z, 4503599627370495))
		emitF(wrap:<u32>(bits_and(z, 8388607)))
		// decimals D / 10^k
		let dd = mut ((z % 999999999) + 1)
		let k = mut (bits_right(z, 40) % 16)
		emitD(decD(dd, k))
		emitF(decF(dd, k % 11))
	}
	// around 1e-3 and 1e7
	for q in 0..2000{
		let a = mut (9990000 + q)
		emitD(decD(a, 0))
		emitD(decD(a, 10))
		emitD(decD(q, 6))
		emitD(decD(q + 990, 6))
		emitD(decD(q + 1, 3))
		emitF(decF(a, 0))
		emitF(decF(a, 10))
		emitF(decF(q + 1, 3))
		emitF(decF(q + 990, 6))
	}
}
