import "../stdlib/libc.caspien"
import "../stdlib/gt/*"

// Aggressive inlining of a constructor that builds a heap struct with an owns member and members narrower than 8 bytes.
struct Num{@pub{
	limbs: owns some mut dynarray(imut u32)
	neg: mut bool
	small: mut u8
	mid: mut u32
}}

@pub
@throws
impl constructor for Num(flag: mut bool, s: mut u8, m: mut u32) self{
	?catch(e){ throw e }
	let l = mut ? dyn:<u32>([])
	return Num{limbs= l, neg= flag, small= s, mid= m}
}

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

func main() void{
	?catch(e){
		unsafe extern{ printf("FAIL uncaught\n") }
		return
	}
	let n = mut ? new Num(true, 7, 123456)
	check("neg", n.neg)
	check("small", n.small == 7)
	check("mid", n.mid == 123456)
}
