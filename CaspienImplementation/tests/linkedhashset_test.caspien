// LinkedHashSet<T> over LinkedHashMap: a random run (adds, removals, compactions) checked against linkedhashset_test.py; iteration must follow insertion order.
import "stdlib/libc.caspien"
import "stdlib/linked_hash_set.caspien"
import "stdlib/gt/*"

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

func main() void{
	?catch(e){
		unsafe extern{ printf("FAIL uncaught: %s\n", e.msg) }
		return
	}
	let s = mut ? new LinkedHashSet:<u64>(mut 0, mut 16)
	let x = mut 777
	let added = mut 0
	let removed = mut 0
	let found = mut 0
	for i in 0..8000{
		x = (x * 1103515245 + 12345) % 2147483648
		let op = mut (bits_right(x, 16) % 4)
		let key = mut (bits_right(x, 8) % 1200)
		if op < 2{
			let isNew = mut ? s.add(s, key)
			if isNew{ added = added + 1 }
		}
		else{
			if op == 2{
				if s.remove(s, key){ removed = removed + 1 }
			}
			else{
				if s.contains(s, key){ found = found + 1 }
			}
		}
	}
	let keySum = mut 0
	let wk = mut 0
	let rank = mut 0
	let firstKey = mut 0
	let lastKey = mut 0
	for match i in s.map.slots{
		if s.map.isLive(s.map, i){
			let k = mut s.map.keyAt(s.map, i)
			rank = rank + 1
			keySum = keySum + k
			wk = (wk + rank * k) % 1000003
			if rank == 1{ firstKey = k }
			lastKey = k
		}
	}
	check("random run: size", s.size(s) == 797 && rank == 797)
	check("random run: new adds", added == 1851)
	check("random run: removes", removed == 1054)
	check("random run: contains", found == 1043)
	check("sum of elements", keySum == 469218)
	check("first and last element", firstKey == 469 && lastKey == 1129)
	check("order-weighted checksum", wk == 532904)
	check("compaction kept slots bounded", s.slotCount(s) < 2 * s.size(s) + 10)

	let t = mut ? new LinkedHashSet:<u8>(mut 0, mut 4)
	let a1 = mut ? t.add(t, mut 30)
	let a2 = mut ? t.add(t, mut 10)
	let a3 = mut ? t.add(t, mut 20)
	let a4 = mut ? t.add(t, mut 30)
	check("add new elements", a1 && a2 && a3)
	check("add again", !a4)
	check("re-add keeps size and position", t.size(t) == 3 && t.slotCount(t) == 3)
	check("remove absent", !t.remove(t, mut 99))
	check("remove present", t.remove(t, mut 10) && !t.contains(t, mut 10) && t.size(t) == 2)
	let a5 = mut ? t.add(t, mut 10)
	check("re-add after remove is new", a5)
	let seq = mut 0
	let ordered = mut true
	for match i in t.map.slots{
		if t.map.isLive(t.map, i){
			let k = mut t.map.keyAt(t.map, i)
			if seq == 0 && k != 30{ ordered = false }
			if seq == 1 && k != 20{ ordered = false }
			if seq == 2 && k != 10{ ordered = false }
			seq = seq + 1
		}
	}
	check("insertion order after remove and re-add", ordered && seq == 3)
}
