@throws
func putB(o: ref some mut String, b: imut bool) void{
	?catch(e){ throw e }
	if b{ ? o.appendChar(o, 'T') } else { ? o.appendChar(o, 'F') }
}

@throws
func putS(o: ref some mut String, s: ref imut String) void{
	?catch(e){ throw e }
	let n = mut 0
	match Some(s){ n = s.length(s) }
	let isNone = mut true
	match Some(s){ isNone = false }
	if isNone{
		? o.appendChar(o, 'N')
		return
	}
	? o.appendU64(o, n)
	? o.appendChar(o, ':')
	match Some(s){ ? o.append(o, s) }
}

@throws
func putL(o: ref some mut String, l: ref imut ObjectList<String>) void{
	?catch(e){ throw e }
	let isNone = mut true
	match Some(l){ isNone = false }
	if isNone{
		? o.appendChar(o, 'N')
		return
	}
	let n = mut 0
	match Some(l){ n = l.size(l) }
	? o.appendChar(o, '[')
	for i in 0..n{
		if i > 0{ ? o.appendChar(o, ',') }
		match Some(l){
			let x = mut l.get(l, i)
			? putS(o, x)
		}
	}
	? o.appendChar(o, ']')
}

@throws
func putP(o: ref some mut String, p: ref imut Span) void{
	?catch(e){ throw e }
	let isNone = mut true
	match Some(p){ isNone = false }
	if isNone{
		? o.appendChar(o, 'N')
		return
	}
	let:<mut s64> a = mut 0
	let:<mut s64> b = mut 0
	match Some(p){
		a = p.start + 0
		b = p.end + 0
	}
	? o.appendChar(o, 'S')
	? o.appendS64(o, a)
	? o.appendChar(o, ',')
	? o.appendS64(o, b)
}

func chk(label: static imut string, got: ref imut String, want: static imut string) mut u64{
	let same = mut false
	match Some(got){ same = got.equals(got, want) }
	if same{
		return 0
	}
	print("FAIL ")
	print(label)
	print(" got ")
	println(got)
	print("   want ")
	println(want)
	return 1
}

