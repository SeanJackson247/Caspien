	c_rfRmw("rfRmw 4 MUL %v7 #5", 4, "MUL", "%v7", "#5", "EX")
	c_rfRmw("rfRmw 4 INC $24 %v1", 4, "INC", "$24", "%v1", "    incq 24(%rbp)\n|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfRmw("rfRmw 4 MUL %t0 #-2147483649", 4, "MUL", "%t0", "#-2147483649", "EX")
	c_rfRmw("rfRmw 4 SUB %t0 #", 4, "SUB", "%t0", "#", "EX")
	c_rfRmw("rfRmw 4 INC %t0 %t3", 4, "INC", "%t0", "%t3", "EX")
	c_rfRmw("rfRmw 4 SUB %v7 $-16", 4, "SUB", "%v7", "$-16", "    movq -16(%rbp), %r15\n    subq %r15, %rdi\n|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfRmw("rfRmw 4 DEC %s $24", 4, "DEC", "%s", "$24", "EX")
	c_rfRmw("rfRmw 4 DEC %v1 #", 4, "DEC", "%v1", "#", "    decq %r14\n|d=0;v=-1;m=2;u=true;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfRmw("rfRmw 4 ADD %t2 #-3", 4, "ADD", "%t2", "#-3", "EX")
	c_rfRmw("rfRmw 4 MUL %t0 #5", 4, "MUL", "%t0", "#5", "EX")
}

