	c_rfRmw("rfRmw 4 ADD $24 #5", 4, "ADD", "$24", "#5", "    addq $5, 24(%rbp)\n|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfRmw("rfRmw 4 MUL $-16 $-16", 4, "MUL", "$-16", "$-16", "EX")
	c_rfRmw("rfRmw 4 ADD %v7 #-3", 4, "ADD", "%v7", "#-3", "    addq $-3, %rdi\n|d=0;v=-1;m=0;u=false;ir=null;is=1;id=0;sh=0;sk=0;mo=null")
	c_rfRmw("rfRmw 4 MUL %v1 %v1", 4, "MUL", "%v1", "%v1", "EX")
	c_rfRmw("rfRmw 4 ADD &glob $-16", 4, "ADD", "&glob", "$-16", "EX")
	c_rfRmw("rfRmw 4 DEC %t2 #-3", 4, "DEC", "%t2", "#-3", "EX")
	c_rfRmw("rfRmw 4 INC %t2 5", 4, "INC", "%t2", "5", "EX")
