// Passing an owns variable as `take(mut b)` moves b: using it afterwards is an error.
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
struct World{@pub{
	ticks: mut u64
}}
func take(p: owns some mut World) void{ }
func main() void{
	?catch(e){ return }
	let a = mut ? new World{ticks= 1}
	let b = mut ? new World{ticks= 2}
	take(mut b)
	let t = mut b.ticks
}
