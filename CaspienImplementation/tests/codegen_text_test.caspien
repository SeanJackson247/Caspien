	check("containsWord (r12)|x|d|false", t_word("(r12)", "x", "d", false) == false)
	check("containsWord (r12)|x|d|true", t_word("(r12)", "x", "d", true) == false)
	check("containsWord r12r12|r12||false", t_word("r12r12", "r12", "", false) == false)
	check("containsWord r12r12|r12||true", t_word("r12r12", "r12", "", true) == false)
	check("containsWord r12r12|r12|dwb|false", t_word("r12r12", "r12", "dwb", false) == false)
	check("containsWord r12r12|r12|dwb|true", t_word("r12r12", "r12", "dwb", true) == false)
	check("containsWord r12r12|r12|d|false", t_word("r12r12", "r12", "d", false) == false)
	check("containsWord r12r12|r12|d|true", t_word("r12r12", "r12", "d", true) == false)
	check("containsWord r12r12|r1||false", t_word("r12r12", "r1", "", false) == false)
	check("containsWord r12r12|r1||true", t_word("r12r12", "r1", "", true) == false)
	check("containsWord r12r12|r1|dwb|false", t_word("r12r12", "r1", "dwb", false) == false)
	check("containsWord r12r12|r1|dwb|true", t_word("r12r12", "r1", "dwb", true) == false)
	check("containsWord r12r12|r1|d|false", t_word("r12r12", "r1", "d", false) == false)
	check("containsWord r12r12|r1|d|true", t_word("r12r12", "r1", "d", true) == false)
	check("containsWord r12r12|x||false", t_word("r12r12", "x", "", false) == false)
	check("containsWord r12r12|x||true", t_word("r12r12", "x", "", true) == false)
	check("containsWord r12r12|x|dwb|false", t_word("r12r12", "x", "dwb", false) == false)
	check("containsWord r12r12|x|dwb|true", t_word("r12r12", "x", "dwb", true) == false)
	check("containsWord r12r12|x|d|false", t_word("r12r12", "x", "d", false) == false)
	check("containsWord r12r12|x|d|true", t_word("r12r12", "x", "d", true) == false)
}

