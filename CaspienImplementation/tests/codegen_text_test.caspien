// Differential test of codegenCaspien/Text.caspien against caspien.bytecode.Text (check lines generated by gen_codegen_text_test.py from the Java class).
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
import "../Codegen/src/main/java/caspien/codegen/Text.caspien"

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

func t_digits(a: static imut string) mut bool{
	?catch(e){ return false }
	let s = mut ? new String(a)
	let r = mut false
	match Some(s){ r = Text.isDigits(s) }
	return r
}

func t_dec(a: static imut string) mut bool{
	?catch(e){ return false }
	let s = mut ? new String(a)
	let r = mut false
	match Some(s){ r = Text.isDecimalNumber(s) }
	return r
}

func t_pref(a: static imut string, p: static imut string) mut bool{
	?catch(e){ return false }
	let s = mut ? new String(a)
	let pp = mut ? new String(p)
	let r = mut false
	match Some(s){
		match Some(pp){
			r = try Text.isPrefixedDigits(s, pp) catch(err){ return false }
		}
	}
	return r
}

func t_word(t: static imut string, n: static imut string, sf: static imut string, d: imut bool) mut bool{
	?catch(e){ return false }
	let a = mut ? new String(t)
	let b = mut ? new String(n)
	let c = mut ? new String(sf)
	let r = mut false
	match Some(a){
		match Some(b){
			match Some(c){
				r = Text.containsWord(a, b, c, d)
			}
		}
	}
	return r
}

func part0() void{
	check("isDigits ", t_digits("") == false)
	check("isDecimalNumber ", t_dec("") == false)
	check("isPrefixedDigits |r", t_pref("", "r") == false)
	check("isPrefixedDigits |ARG", t_pref("", "ARG") == false)
	check("isPrefixedDigits |", t_pref("", "") == false)
	check("isPrefixedDigits |x", t_pref("", "x") == false)
	check("isDigits 0", t_digits("0") == true)
	check("isDecimalNumber 0", t_dec("0") == false)
	check("isPrefixedDigits 0|r", t_pref("0", "r") == false)
	check("isPrefixedDigits 0|ARG", t_pref("0", "ARG") == false)
	check("isPrefixedDigits 0|", t_pref("0", "") == true)
	check("isPrefixedDigits 0|x", t_pref("0", "x") == false)
	check("isDigits 12", t_digits("12") == true)
	check("isDecimalNumber 12", t_dec("12") == false)
	check("isPrefixedDigits 12|r", t_pref("12", "r") == false)
