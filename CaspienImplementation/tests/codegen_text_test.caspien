	check("containsWord |x|d|false", t_word("", "x", "d", false) == false)
	check("containsWord |x|d|true", t_word("", "x", "d", true) == false)
	check("containsWord r12|r12||false", t_word("r12", "r12", "", false) == true)
	check("containsWord r12|r12||true", t_word("r12", "r12", "", true) == true)
	check("containsWord r12|r12|dwb|false", t_word("r12", "r12", "dwb", false) == true)
	check("containsWord r12|r12|dwb|true", t_word("r12", "r12", "dwb", true) == true)
	check("containsWord r12|r12|d|false", t_word("r12", "r12", "d", false) == true)
	check("containsWord r12|r12|d|true", t_word("r12", "r12", "d", true) == true)
	check("containsWord r12|r1||false", t_word("r12", "r1", "", false) == false)
	check("containsWord r12|r1||true", t_word("r12", "r1", "", true) == false)
	check("containsWord r12|r1|dwb|false", t_word("r12", "r1", "dwb", false) == false)
