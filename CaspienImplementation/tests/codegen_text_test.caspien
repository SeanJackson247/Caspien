func part2() void{
	check("containsWord movq %r12d, x|x||false", t_word("movq %r12d, x", "x", "", false) == true)
	check("containsWord movq %r12d, x|x||true", t_word("movq %r12d, x", "x", "", true) == true)
	check("containsWord movq %r12d, x|x|dwb|false", t_word("movq %r12d, x", "x", "dwb", false) == true)
	check("containsWord movq %r12d, x|x|dwb|true", t_word("movq %r12d, x", "x", "dwb", true) == true)
	check("containsWord movq %r12d, x|x|d|false", t_word("movq %r12d, x", "x", "d", false) == true)
	check("containsWord movq %r12d, x|x|d|true", t_word("movq %r12d, x", "x", "d", true) == true)
