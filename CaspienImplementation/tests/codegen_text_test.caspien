	check("containsWord mov r12, r13|r12||false", t_word("mov r12, r13", "r12", "", false) == true)
	check("containsWord mov r12, r13|r12||true", t_word("mov r12, r13", "r12", "", true) == true)
	check("containsWord mov r12, r13|r12|dwb|false", t_word("mov r12, r13", "r12", "dwb", false) == true)
	check("containsWord mov r12, r13|r12|dwb|true", t_word("mov r12, r13", "r12", "dwb", true) == true)
	check("containsWord mov r12, r13|r12|d|false", t_word("mov r12, r13", "r12", "d", false) == true)
	check("containsWord mov r12, r13|r12|d|true", t_word("mov r12, r13", "r12", "d", true) == true)
