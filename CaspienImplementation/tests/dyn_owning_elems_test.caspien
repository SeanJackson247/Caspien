// A safe dynarray whose elements own memory -- inline structs with an `owns` member, and plain `owns` pointers -- drops,
// grows and clones element by element: `dyn([h1, h2, h3])` builds it, a shrinking `resize` frees the owns members of the
// elements it cuts off, a growing `resize` gives every new slot its own deep clone of the fill value (never an alias), and
// `clone` deep-copies. Checked through the ghost table's entry count (dyn_owning_elems_check.sh runs this under valgrind).
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
struct World{@pub{
	ticks: mut u64
}}
struct Holder{@pub{
	w: owns some mut World
}}

func live() mut u64{
	let n = mut 0
	unsafe assume{
		assume match ghost_table.lockState : OPEN
		n = mut ghost_table.len
	}
	return n
}

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

func inlinePart() void{
	?catch(e){ return }
	let base = mut live()
	let w1 = mut ? new World{ticks= 10}
	let w2 = mut ? new World{ticks= 20}
	let w3 = mut ? new World{ticks= 30}
	let h1 = mut Holder{w= w1}
	let h2 = mut Holder{w= w2}
	let h3 = mut Holder{w= w3}
	let v = mut ? dyn([h1, h2, h3])
	check("inline len", len(v) == 3)
	let a0 = mut 0
	match 0 in v{ a0 = v[0].w.ticks }
	let a1 = mut 0
	match 1 in v{ a1 = v[1].w.ticks }
	let a2 = mut 0
	match 2 in v{ a2 = v[2].w.ticks }
	check("inline ticks", a0 == 10 && a1 == 20 && a2 == 30)
	check("inline entries", live() == base + 4)
	// the literal took the holders: they are nulled out, and the worlds belong to the array now
	// shrink: the cut-off elements' worlds are freed; the (unused) fill stays with its owner
	let ws = mut ? new World{ticks= 3}
	let hs = mut Holder{w= ws}
	v = ?resize(v, 1, hs)
	check("shrink len", len(v) == 1)
	check("shrink entries", live() == base + 3)
	// grow: the fill stays with its owner, every new slot is a deep clone of it
	let wf = mut ? new World{ticks= 7}
	let hf = mut Holder{w= wf}
	v = ?resize(v, 4, hf)
	check("grow len", len(v) == 4)
	let b0 = mut 0
	match 0 in v{ b0 = v[0].w.ticks }
	let b1 = mut 0
	match 1 in v{ b1 = v[1].w.ticks }
	let b2 = mut 0
	match 2 in v{ b2 = v[2].w.ticks }
	let b3 = mut 0
	match 3 in v{ b3 = v[3].w.ticks }
	check("grow ticks", b0 == 10 && b1 == 7 && b2 == 7 && b3 == 7)
	check("grow entries", live() == base + 7)
	match 3 in v{ v[3].w.ticks = 99 }
	let d1 = mut 0
	match 1 in v{ d1 = v[1].w.ticks }
	let d2 = mut 0
	match 2 in v{ d2 = v[2].w.ticks }
	let d3 = mut 0
	match 3 in v{ d3 = v[3].w.ticks }
	let df = mut 0
	df = hf.w.ticks
	check("grow independent", d1 == 7 && d2 == 7 && d3 == 99 && df == 7)
	// deep clone
	let c = mut ?clone(v)
	check("clone entries", live() == base + 12)
	match 0 in c{ c[0].w.ticks = 5 }
	let e0 = mut 0
	match 0 in v{ e0 = v[0].w.ticks }
	let e1 = mut 0
	match 0 in c{ e1 = c[0].w.ticks }
	let e2 = mut 0
	match 3 in c{ e2 = c[3].w.ticks }
	check("clone independent", e0 == 10 && e1 == 5 && e2 == 99)
}

func pointerPart() void{
	?catch(e){ return }
	let base = mut live()
	let a = mut ? new World{ticks= 1}
	let b = mut ? new World{ticks= 2}
	let c = mut ? new World{ticks= 3}
	let v = mut ? dyn([a, b, c])
	let f = mut ? new World{ticks= 8}
	v = ?resize(v, 1, f)
	check("ptr shrink entries", live() == base + 3)
	let g = mut ? new World{ticks= 9}
	v = ?resize(v, 3, g)
	check("ptr grow len", len(v) == 3)
	check("ptr grow entries", live() == base + 6)
	let s = mut 0
	match 1 in v{ v[1].ticks += 100 }
	match 1 in v{ s = v[1].ticks }
	let u = mut 0
	match 2 in v{ u = v[2].ticks }
	check("ptr grow independent", s == 109 && u == 9)
}

func main() void{
	let before = mut live()
	inlinePart()
	check("inline freed", live() == before)
	pointerPart()
	check("pointer freed", live() == before)
}
