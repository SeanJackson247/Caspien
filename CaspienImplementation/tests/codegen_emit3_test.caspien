	let b = mut nb(su, ll)
	if su >= 26 && su <= 30{
		match Some(b){ match Some(b.core){ b.core.allLines = ref ll } }
	}
	try{
		match Some(b){ match Some(b.gen){
			try b.gen.xvReloadAll(b.gen) catch(e){
				thrown = true
				continue
			}
		} }
	}
	let rv = mut ? new String()
	verdict(label, thrown, b, rv, want)
}

func c_movRegToXmm(label: static imut string, su: mut s32, a0: static imut string, a1: static imut string, want: static imut string) void{
	?catch(ex){
		check(label, false)
		return
	}
	let thrown = mut false
	let ll = mut ? new ObjectList:<BytecodeStatement>()
	let b = mut nb(su, ll)
	if su >= 26 && su <= 30{
		match Some(b){ match Some(b.core){ b.core.allLines = ref ll } }
	}
	let s0 = mut ? new String(a0)
	let s1 = mut ? new String(a1)
	try{
		match Some(b){ match Some(b.calls){
			try b.calls.movRegToXmm(b.calls, s0, s1) catch(e){
				thrown = true
				continue
			}
		} }
	}
	let rv = mut ? new String()
	verdict(label, thrown, b, rv, want)
}

func c_movXmmToReg(label: static imut string, su: mut s32, a0: static imut string, a1: static imut string, want: static imut string) void{
	?catch(ex){
		check(label, false)
		return
	}
	let thrown = mut false
	let ll = mut ? new ObjectList:<BytecodeStatement>()
	let b = mut nb(su, ll)
	if su >= 26 && su <= 30{
		match Some(b){ match Some(b.core){ b.core.allLines = ref ll } }
	}
	let s0 = mut ? new String(a0)
	let s1 = mut ? new String(a1)
