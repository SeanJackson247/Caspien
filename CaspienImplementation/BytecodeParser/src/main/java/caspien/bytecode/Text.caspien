import "stdlib/string.caspien"
import "../../../../../../Codegen/src/main/java/caspien/codegen/collections.caspien"

// Hand-written string helpers that replace regex/split/replaceAll (statement-for-statement port of Text.java; see README "Differences").
// Conventions: a Java `while` is a bounded `for` with `break`/`continue` (an unbounded `loop` needs `unsafe`); `&&`/`||` that Java short-circuits are `&&then`/`||then`.

/** Result of `findUnsafeUnaudited`: [start, end) of the match (Java returns int[2] or null). */
@pub
struct Span{@pub{
	start: imut s64
	end: imut s64
}}

@pub
impl constructor for Span(start: imut s64, end: imut s64) self{
	return Span{start= start, end= end}
}

enum TextConstGate{ OPEN, CLOSED }

/** A lock-wrapped integer constant (the Caspien form of a Java `static final int`). */
@lock(match self.gate : OPEN)
struct TextConstInt{@pub{
	swap gate: atomic mut TextConstGate
	value: mut s32
}}

let static Text_SEP_WHITESPACE = mut TextConstInt{gate= TextConstGate.OPEN, value= mut 1}

/** Java `SEP_WHITESPACE` = 1 (`\s+`). */
func Text_sepWhitespace() mut s32{
	let:<mut s32> out = mut 0
	/*! termination: bound */
	match @lock Text_SEP_WHITESPACE{
		OPEN:{ out = Text_SEP_WHITESPACE.value }
		CLOSED:default(1000000)
	}
	return out
}

let static Text_SEP_NON_WORD = mut TextConstInt{gate= TextConstGate.OPEN, value= mut 2}

/** Java `SEP_NON_WORD` = 2 (`[^A-Za-z0-9_]+`). */
func Text_sepNonWord() mut s32{
	let:<mut s32> out = mut 0
	/*! termination: bound */
	match @lock Text_SEP_NON_WORD{
		OPEN:{ out = Text_SEP_NON_WORD.value }
		CLOSED:default(1000000)
	}
	return out
}

let static Text_SEP_LINE_BREAK = mut TextConstInt{gate= TextConstGate.OPEN, value= mut 3}

/** Java `SEP_LINE_BREAK` = 3 (`\R`). */
func Text_sepLineBreak() mut s32{
	let:<mut s32> out = mut 0
	/*! termination: bound */
	match @lock Text_SEP_LINE_BREAK{
		OPEN:{ out = Text_SEP_LINE_BREAK.value }
		CLOSED:default(1000000)
	}
	return out
}

let static Text_SEP_CRLF_OR_LF = mut TextConstInt{gate= TextConstGate.OPEN, value= mut 4}

/** Java `SEP_CRLF_OR_LF` = 4 (`\r?\n`). */
func Text_sepCrlfOrLf() mut s32{
	let:<mut s32> out = mut 0
	/*! termination: bound */
	match @lock Text_SEP_CRLF_OR_LF{
		OPEN:{ out = Text_SEP_CRLF_OR_LF.value }
		CLOSED:default(1000000)
	}
	return out
}

@pub
struct Text{@pub{
}}

impl constructor for Text() self{
	return Text{}
}

@pub
impl Text{
	@pub
	static func isDigit(c: mut char) bool{
		return c >= '0' && c <= '9'
	}

	@pub
	static func isWordChar(c: mut char) mut bool{
		return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || String.isDigit(c) || c == '_'
	}

	/** \s */
	@pub
	static func isSpace(c: mut char) bool{
		let v = mut String.charCode(c)
		return v == 32 || (v >= 9 && v <= 13)
	}

	/** the characters that Java treats as line terminators */
	@pub
	static func isLineTerminator(c: mut char) bool{
		// forced: a char is ONE BYTE here, so U+0085, U+2028 and U+2029 (Java's other three terminators) cannot be a char value; only \n and \r are tested
		return c == '\n' || c == '\r'
	}

	/** Java `s.startsWith(lit, at)`; forced: String has no startsWith(prefix, offset), so the bounds test + `litAt` stand in for it (`ln` = length of `lit`). */
	@pub
	static func hasLit(s: ref some imut String, lit: static imut string, ln: mut u64, at: mut u64) mut bool{
		if at + ln > s.length(s){
			return false
		}
		return s.litAt(s, lit, ln, at)
	}

	/** A copy of `s` (port-only: Java Strings are immutable and shared). */
	@pub
	@throws
	static func copyOf(s: ref some imut String) owns some mut String{
		?catch(e){ throw e }
		let r = mut ? s.sub(s, 0, s.length(s))
		return r
	}

	/** NOT part of the Java Text and unused in this file: kept only because Codegen's X86Core calls it (Java: isDigits(substring)); delete it once that call is Java-shaped. Index of the first non-digit of `s` at or after `from` (n when none). */
	@pub
	static func digitRunEnd(s: ref some imut String, from: mut u64, n: mut u64) mut u64{
		for j in from..n{
			if String.isDigit(s.charAt(s, j)) == false{
				return j
			}
		}
		return n
	}

	/** [0-9]+ or \d+ */
	@pub
	static func isDigits(s: ref some imut String) mut bool{
		let n = mut s.length(s)
		if n == 0{
			return false
		}
		for i in 0..n{
			if String.isDigit(s.charAt(s, i)) == false{
				return false
			}
		}
		return true
	}

	/** -?\d+ */
	@pub
	@throws
	static func isSignedDigits(s: ref some imut String) mut bool{
		?catch(e){ throw e }
		if s.startsWith(s, "-"){
			let rest = mut ? s.substring(s, 1)
			let r = mut false
			match Some(rest){ r = Text.isDigits(rest) }
			return r
		}
		return Text.isDigits(s)
	}

	/** -?\d+\.\d+([eE][+-]?\d+)? */
	@pub
	static func isDecimalNumber(s: ref some imut String) mut bool{
		let n = mut s.length(s)
		let i = mut 0
		if i < n &&then s.charAt(s, i) == '-'{
			i += 1
		}
		let start = mut i
		for k in i..n{
			if Text.isDigit(s.charAt(s, i)) == false{
				break
			}
			i += 1
		}
		if i == start ||then i >= n ||then s.charAt(s, i) != '.'{
			return false
		}
		i += 1
		start = i
		for k in i..n{
			if Text.isDigit(s.charAt(s, i)) == false{
				break
			}
			i += 1
		}
		if i == start{
			return false
		}
		if i == n{
			return true
		}
		let e = mut s.charAt(s, i)
		if e != 'e' && e != 'E'{
			return false
		}
		i += 1
		if i < n &&then (s.charAt(s, i) == '+' || s.charAt(s, i) == '-'){
			i += 1
		}
		start = i
		for k in i..n{
			if Text.isDigit(s.charAt(s, i)) == false{
				break
			}
			i += 1
		}
		return i > start && i == n
	}

	/** [A-Za-z0-9_]+ */
	@pub
	static func isWord(s: ref some imut String) mut bool{
		let n = mut s.length(s)
		if n == 0{
			return false
		}
		for i in 0..n{
			if Text.isWordChar(s.charAt(s, i)) == false{
				return false
			}
		}
		return true
	}

	/** [A-Za-z_][A-Za-z_0-9.]* */
	@pub
	static func isDottedName(s: ref some imut String) mut bool{
		let n = mut s.length(s)
		if n == 0{
			return false
		}
		let c = mut s.charAt(s, 0)
		if (c >= 'a' && c <= 'z') == false && (c >= 'A' && c <= 'Z') == false && c != '_'{
			return false
		}
		for i in 1..n{
			let d = mut s.charAt(s, i)
			if Text.isWordChar(d) == false && d != '.'{
				return false
			}
		}
		return true
	}

	/** prefix followed by exactly one character from chars, e.g. "%t" + [0-3] */
	@pub
	static func isPrefixedChar(s: ref some imut String, prefix: ref some imut String, chars: ref some imut String) mut bool{
		let pl = mut prefix.length(prefix)
		if s.length(s) != pl + 1 ||then s.startsWith(s, prefix) == false{
			return false
		}
		return chars.indexOf(chars, s.charAt(s, pl)) >= 0
	}

	/** prefix followed by one or more digits, e.g. "ARG[0-9]+" or "r\d+" */
	@pub
	@throws
	static func isPrefixedDigits(s: ref some imut String, prefix: ref some imut String) mut bool{
		?catch(e){ throw e }
		if s.startsWith(s, prefix) == false{
			return false
		}
		let rest = mut ? s.substring(s, prefix.length(prefix))
		let r = mut false
		match Some(rest){
			r = Text.isDigits(rest)
		}
		return r
	}

	/** r(8|9|1[0-5]) */
	@pub
	static func isHighGpr(s: ref some imut String) mut bool{
		?catch(e){ return false } // forced: keeps the non-throwing signature Codegen's X86Emit calls (substring can only fail on out of memory)
		if s.startsWith(s, "r") == false{
			return false
		}
		let n = mut ? s.substring(s, 1)
		let r = mut false
		match Some(n){
			if n.equals(n, "8") ||then n.equals(n, "9") ||then n.equals(n, "10") ||then n.equals(n, "11") ||then n.equals(n, "12") ||then n.equals(n, "13") ||then n.equals(n, "14") ||then n.equals(n, "15"){
				r = true
			}
		}
		return r
	}

	/** \d+\.(start|end) */
	@pub
	@throws
	static func isDigitsDotStartOrEnd(s: ref some imut String) mut bool{
		?catch(e){ throw e }
		let dot = mut s.indexOf(s, '.')
		if dot < 0{
			return false
		}
		let head = mut ? s.sub(s, 0, wrap:<u64>(dot))
		let tail = mut ? s.substring(s, wrap:<u64>(dot) + 1)
		let r = mut false
		match Some(head){ match Some(tail){
			r = Text.isDigits(head) && (tail.equals(tail, "start") || tail.equals(tail, "end"))
		} }
		return r
	}

	static func isScalarName(s: ref some imut String) mut bool{
		if s.equals(s, "u8") ||then s.equals(s, "u16") ||then s.equals(s, "u32") ||then s.equals(s, "u64") ||then s.equals(s, "s8") ||then s.equals(s, "s16") ||then s.equals(s, "s32") ||then s.equals(s, "s64") ||then s.equals(s, "f32") ||then s.equals(s, "f64") ||then s.equals(s, "bool") ||then s.equals(s, "char"){
			return true
		}
		return false
	}

	/** (mut|imut)_scalar, or with allowIndeterminate (mut|imut|indeterminate)_scalar */
	@pub
	@throws
	static func isQualifiedScalar(s: ref some imut String, allowIndeterminate: imut bool) mut bool{
		?catch(e){ throw e }
		let us = mut s.indexOf(s, '_')
		if us < 0{
			return false
		}
		let uu = mut wrap:<u64>(us)
		let q = mut ? s.substring(s, 0, uu)
		let ok = mut false
		match Some(q){
			if q.equals(q, "mut") ||then q.equals(q, "imut") ||then allowIndeterminate &&then q.equals(q, "indeterminate"){
				ok = true
			}
		}
		if ok == false{
			return false
		}
		let rest = mut ? s.substring(s, uu + 1)
		let r = mut false
		match Some(rest){ r = Text.isScalarName(rest) }
		return r
	}

	/** (imut_|mut_)?range */
	@pub
	static func isRangeType(s: ref some imut String) bool{
		if s.equals(s, "range") ||then s.equals(s, "imut_range") ||then s.equals(s, "mut_range"){
			return true
		}
		return false
	}

	/** ^(?:imut|mut|indeterminate)_range(?:\(.*\))?$ (matches(), no line breaks inside the parentheses) */
	@pub
	static func isByValueRangeType(s: ref some imut String) mut bool{
		let n = mut s.length(s)
		let from = mut 0
		if n >= 10 && Text.hasLit(s, "imut_range", 10, 0){
			from = 10
		} else if n >= 9 && Text.hasLit(s, "mut_range", 9, 0){
			from = 9
		} else if n >= 19 && Text.hasLit(s, "indeterminate_range", 19, 0){
			from = 19
		} else {
			return false
		}
		let restLen = mut (n - from)
		if restLen == 0{
			return true
		}
		if restLen < 2 || s.charAt(s, from) != '(' || s.charAt(s, n - 1) != ')'{
			return false
		}
		let rlo1 = mut (from + 1)
		let rhi2 = mut (n - 1)
		for i in rlo1..rhi2{
			if Text.isLineTerminator(s.charAt(s, i)){
				return false
			}
		}
		return true
	}

	/** .*[us](8|16|32) matched against the whole string (no line breaks) */
	@pub
	static func endsWithSmallIntType(s: ref some imut String) mut bool{
		let n = mut s.length(s)
		for i in 0..n{
			if Text.isLineTerminator(s.charAt(s, i)){
				return false
			}
		}
		if s.endsWith(s, "u8") ||then s.endsWith(s, "s8") ||then s.endsWith(s, "u16") ||then s.endsWith(s, "s16") ||then s.endsWith(s, "u32") ||then s.endsWith(s, "s32"){
			return true
		}
		return false
	}

	/** [us]\d+ matched against the whole string */
	@pub
	@throws
	static func isSizedIntName(s: ref some imut String) mut bool{
		?catch(e){ throw e }
		if s.length(s) >= 2 &&then (s.charAt(s, 0) == 'u' || s.charAt(s, 0) == 's'){
			let rest = mut ? s.substring(s, 1)
			let r = mut false
			match Some(rest){ r = Text.isDigits(rest) }
			return r
		}
		return false
	}

	/** removes one leading imut_ or mut_ (replaceFirst("^(imut_|mut_)", "")) */
	@pub
	@throws
	static func stripMutPrefix(s: ref some imut String) owns some mut String{
		?catch(e){ throw e }
		if s.startsWith(s, "imut_"){
			let a = mut ? s.substring(s, 5)
			return a
		}
		if s.startsWith(s, "mut_"){
			let b = mut ? s.substring(s, 4)
			return b
		}
		let c = mut ? Text.copyOf(s)
		return c
	}

	/** removes every leading mut_ / imut_ / indeterminate_ (replaceFirst("^((mut|imut|indeterminate)_)+", "")) */
	@pub
	@throws
	static func stripQualifierPrefixes(s: ref some imut String) owns some mut String{
		?catch(e){ throw e }
		let r = mut ? Text.copyOf(s)
		let again = mut true
		let n = mut s.length(s)
		let lim = mut (n + 1)
		for step in 0..lim{ // forced: while -> bounded for (every pass strips at least 4 characters)
			if again == false{
				break
			}
			again = false
			if r.startsWith(r, "imut_"){
				let t5 = mut ? r.substring(r, 5)
				r = t5
				again = true
			} else if r.startsWith(r, "mut_"){
				let t4 = mut ? r.substring(r, 4)
				r = t4
				again = true
			} else if r.startsWith(r, "indeterminate_"){
				let t14 = mut ? r.substring(r, 14)
				r = t14
				again = true
			}
		}
		return r
	}

	/** Splits "name[N]" into {name, N}. mode 0: the name is one or more characters (^(.+)\[([0-9]+)\]$), mode 1: one or more word characters, mode 2: zero or more characters (^(.*)\[(\d+)\]$). Returns null when s has another shape. */
	@pub
	@throws
	static func splitArrayType(s: ref some imut String, mode: imut s32) owns mut ObjectList<String>{
		?catch(e){ throw e }
		let n = mut s.length(s)
		if n < 3 ||then s.charAt(s, n - 1) != ']'{
			return null
		}
		let last = mut (wrap:<s64>(n) - 2)
		let i = mut last
		for step in 0..n{ // forced: while -> bounded for
			if i < 0{
				break
			}
			if Text.isDigit(s.charAt(s, wrap:<u64>(i))) == false{
				break
			}
			i -= 1
		}
		if i == last ||then i < 0 ||then s.charAt(s, wrap:<u64>(i)) != '['{
			return null
		}
		let iu = mut wrap:<u64>(i)
		let name = mut ? s.substring(s, 0, iu)
		if mode != 2 &&then name.isEmpty(name){
			return null
		}
		if mode == 1{
			if Text.isWord(name) == false{
				return null
			}
		} else {
			let nl = mut name.length(name)
			for k in 0..nl{
				if Text.isLineTerminator(name.charAt(name, k)){
					return null
				}
			}
		}
		let out = mut ? new ObjectList:<String>()
		let digits = mut ? s.substring(s, iu + 1, n - 1)
		? out.add(out, name)
		? out.add(out, digits)
		return out
	}

	/** Java's $ (no MULTILINE): the end of the input, or just before a line terminator that ends the input. */
	@pub
	static func atDollar(s: ref some imut String, pos: mut u64) mut bool{
		let n = mut s.length(s)
		if pos == n{
			return true
		}
		if pos + 1 == n{
			let c = mut s.charAt(s, pos)
			if c == '\n'{
				if pos > 0 &&then s.charAt(s, pos - 1) == '\r'{
					return false
				}
				return true
			}
			// forced: a char is one byte, so Java's U+0085, U+2028 and U+2029 cannot be tested here
			return c == '\r'
		}
		if pos + 2 == n{
			return s.charAt(s, pos) == '\r' && s.charAt(s, pos + 1) == '\n'
		}
		return false
	}

	/** replaceAll("\\s+$", ""): the first whitespace run that ends at a $ position goes. */
	@pub
	@throws
	static func stripTrailingSpace(s: ref some imut String) owns some mut String{
		?catch(e){ throw e }
		let n = mut s.length(s)
		let p = mut 0
		let lim = mut (n + 1)
		for step in 0..lim{ // forced: while -> bounded for (p advances every pass)
			if p >= n{
				break
			}
			if Text.isSpace(s.charAt(s, p)) == false{
				p += 1
				continue
			}
			let q = mut p
			for k in q..n{
				if Text.isSpace(s.charAt(s, q)) == false{
					break
				}
				q += 1
			}
			let e = mut q
			let back = mut (q - p)
			for k in 0..back{
				if e <= p ||then Text.atDollar(s, e){
					break
				}
				e -= 1
			}
			if e > p{
				let r = mut ? s.substring(s, 0, p)
				let tail = mut ? s.substring(s, e)
				? r.append(r, tail)
				return r
			}
			p = q
		}
		let c = mut ? Text.copyOf(s)
		return c
	}

	/** replaceAll("\\s+", " ") */
	@pub
	@throws
	static func collapseSpace(s: ref some imut String) owns some mut String{
		?catch(e){ throw e }
		let sb = mut ? new String()
		let n = mut s.length(s)
		let i = mut 0
		let lim = mut (n + 1)
		for step in 0..lim{ // forced: while -> bounded for (i advances every pass)
			if i >= n{
				break
			}
			let c = mut s.charAt(s, i)
			if Text.isSpace(c){
				for k in i..n{
					if Text.isSpace(s.charAt(s, i)) == false{
						break
					}
					i += 1
				}
				? sb.appendChar(sb, ' ')
			} else {
				? sb.appendChar(sb, c)
				i += 1
			}
		}
		return sb
	}

	/** replaceAll("[^A-Za-z0-9_]", with) */
	@pub
	@throws
	static func replaceNonWordChars(s: ref some imut String, with: ref some imut String) owns some mut String{
		?catch(e){ throw e }
		let sb = mut ? new String()
		let n = mut s.length(s)
		for i in 0..n{
			let c = mut s.charAt(s, i)
			if Text.isWordChar(c){
				? sb.appendChar(sb, c)
			} else {
				? sb.append(sb, with)
			}
		}
		return sb
	}

	/** The JDK's `s.lastIndexOf(needle, from)`: the largest match start <= from, or -1. forced: the String library has no lastIndexOf. */
	static func lastIndexOf(s: ref some imut String, needle: ref some imut String, from: mut u64) mut s64{
		let n = mut s.length(s)
		let m = mut needle.length(needle)
		if m > n{
			return -1
		}
		let top = mut (n - m)
		if from < top{
			top = from
		}
		let cnt = mut (top + 1)
		for step in 0..cnt{
			let q = mut (top - step)
			if s.strAt(s, needle, q){
				return wrap:<s64>(q)
			}
		}
		return -1
	}

	/** replaceFirst("\\.caspien$", "") for a suffix (the $ may sit before a final line terminator) */
	@pub
	@throws
	static func stripSuffixAtEnd(s: ref some imut String, suffix: ref some imut String) owns some mut String{
		?catch(e){ throw e }
		let n = mut s.length(s)
		let sl = mut suffix.length(suffix)
		let pos = mut Text.lastIndexOf(s, suffix, n)
		let lim = mut (n + 1)
		for step in 0..lim{ // forced: while -> bounded for (pos strictly decreases)
			if pos < 0{
				break
			}
			let pu = mut wrap:<u64>(pos)
			if Text.atDollar(s, pu + sl){
				let r = mut ? s.substring(s, 0, pu)
				let tail = mut ? s.substring(s, pu + sl)
				? r.append(r, tail)
				return r
			}
			if pu == 0{
				break
			}
			pos = Text.lastIndexOf(s, suffix, pu - 1)
		}
		let c = mut ? Text.copyOf(s)
		return c
	}

	/** replaceFirst("^[#;]\\s*", "") */
	@pub
	@throws
	static func stripCommentLead(s: ref some imut String) owns some mut String{
		?catch(e){ throw e }
		let n = mut s.length(s)
		if n == 0 ||then (s.charAt(s, 0) != '#' && s.charAt(s, 0) != ';'){
			let c = mut ? Text.copyOf(s)
			return c
		}
		let i = mut 1
		for k in i..n{
			if Text.isSpace(s.charAt(s, i)) == false{
				break
			}
			i += 1
		}
		let r = mut ? s.substring(s, i)
		return r
	}

	/** replaceFirst("^0+(?=.)", ""): leading zeros go, but not the last character */
	@pub
	@throws
	static func stripLeadingZeros(s: ref some imut String) owns some mut String{
		?catch(e){ throw e }
		let n = mut s.length(s)
		let i = mut 0
		for step in 0..n{ // forced: while -> bounded for (i advances every pass)
			if i + 1 < n &&then s.charAt(s, i) == '0' &&then Text.isLineTerminator(s.charAt(s, i + 1)) == false{
				i += 1
			} else {
				break
			}
		}
		let r = mut ? s.substring(s, i)
		return r
	}

	/** replaceFirst(":\\d+\"$", "\"") */
	@pub
	@throws
	static func stripLineNumberBeforeQuote(s: ref some imut String) owns some mut String{
		?catch(e){ throw e }
		let r = mut ? Text.firstLineNumberMatch(s)
		return r
	}

	@throws
	static func firstLineNumberMatch(s: ref some imut String) owns some mut String{
		?catch(e){ throw e }
		let n = mut s.length(s)
		for c in 0..n{
			if s.charAt(s, c) != ':'{
				continue
			}
			let i = mut (c + 1)
			let lo = mut i
			for k in lo..n{
				if Text.isDigit(s.charAt(s, i)) == false{
					break
				}
				i += 1
			}
			if i == c + 1 ||then i >= n ||then s.charAt(s, i) != '"'{
				continue
			}
			if Text.atDollar(s, i + 1){
				let r = mut ? s.substring(s, 0, c)
				? r.appendChar(r, '"')
				let tail = mut ? s.substring(s, i + 1)
				? r.append(r, tail)
				return r
			}
		}
		let cp = mut ? Text.copyOf(s)
		return cp
	}

	/** ^(\s*)unsafe\b[^{]*\{\s*(//.*)?$ against a whole line: {leading whitespace, trailing comment from the slashes or null}, or null for another shape. */
	@pub
	@throws
	static func unsafeOpenParts(line: ref some imut String) owns mut ObjectList<String>{
		?catch(e){ throw e }
		let n = mut line.length(line)
		let i = mut 0
		for k in i..n{
			if Text.isSpace(line.charAt(line, i)) == false{
				break
			}
			i += 1
		}
		let indentEnd = mut i
		if Text.hasLit(line, "unsafe", 6, i) == false{
			return null
		}
		i += 6
		if i < n &&then Text.isWordChar(line.charAt(line, i)){
			return null
		}
		for k in i..n{
			if line.charAt(line, i) == '{'{
				break
			}
			i += 1
		}
		if i >= n{
			return null
		}
		i += 1
		for k in i..n{
			if Text.isSpace(line.charAt(line, i)) == false{
				break
			}
			i += 1
		}
		// the two result Strings are made before the list (adding to a list of Strings ends the borrow of `line`)
		let indent = mut ? line.sub(line, 0, indentEnd)
		let:<owns mut String> comment = mut null
		if i != n{
			if Text.hasLit(line, "//", 2, i) == false{
				return null
			}
			let rlo = mut (i + 2)
			for k in rlo..n{
				if Text.isLineTerminator(line.charAt(line, k)){
					return null
				}
			}
			comment = mut ? line.sub(line, i, n)
		}
		let out = mut ? new ObjectList:<String>()
		? out.add(out, indent)
		? out.add(out, comment)
		return out
	}

	/** ^\s*\}\s*(//.*)?$ against a whole line */
	@pub
	static func isCloseLine(line: ref some imut String) mut bool{
		let n = mut line.length(line)
		let i = mut 0
		for k in i..n{
			if Text.isSpace(line.charAt(line, i)) == false{
				break
			}
			i += 1
		}
		if i >= n ||then line.charAt(line, i) != '}'{
			return false
		}
		i += 1
		for k in i..n{
			if Text.isSpace(line.charAt(line, i)) == false{
				break
			}
			i += 1
		}
		if i == n{
			return true
		}
		if Text.hasLit(line, "//", 2, i) == false{
			return false
		}
		let rlo = mut (i + 2)
		for k in rlo..n{
			if Text.isLineTerminator(line.charAt(line, k)){
				return false
			}
		}
		return true
	}

	/** \bunsafe\s+unaudited\s*\{ : returns {start, end} of the first match, or null */
	@pub
	@throws
	static func findUnsafeUnaudited(s: ref some imut String) owns mut Span{
		?catch(e){ throw e }
		let n = mut s.length(s)
		let from = mut 0
		let lim = mut (n + 1)
		for step in 0..lim{ // forced: while(true) -> bounded for (from grows every pass)
			let p = mut s.indexOf(s, "unsafe", from)
			if p < 0{
				return null
			}
			let pu = mut wrap:<u64>(p)
			from = pu + 1
			if pu > 0 &&then Text.isWordChar(s.charAt(s, pu - 1)){
				continue
			}
			let i = mut (pu + 6)
			let ws = mut i
			for k in i..n{
				if Text.isSpace(s.charAt(s, i)) == false{
					break
				}
				i += 1
			}
			if i == ws ||then Text.hasLit(s, "unaudited", 9, i) == false{
				continue
			}
			i += 9
			for k in i..n{
				if Text.isSpace(s.charAt(s, i)) == false{
					break
				}
				i += 1
			}
			if i < n &&then s.charAt(s, i) == '{'{
				let r = mut ? new Span(p, wrap:<s64>(i + 1))
				return r
			}
		}
		return null
	}

	/**
	 * True when text holds name as a whole word: not preceded by a word character (or, with dotBlocks, a dot) and
	 * not followed by one. With suffixChars, one optional character from it may follow name first, e.g. the
	 * pattern (?<![A-Za-z0-9_])r12[dwb]?(?![A-Za-z0-9_]).
	 */
	@pub
	static func containsWord(text: ref some imut String, name: ref some imut String, suffixChars: ref some imut String, dotBlocks: imut bool) mut bool{
		let n = mut text.length(text)
		let from = mut 0
		let limit = mut (n + 1)
		for attempt in 0..limit{ // forced: while(true) -> bounded for (from grows every pass)
			let p = mut text.indexOf(text, name, from)
			if p < 0{
				return false
			}
			let pu = mut wrap:<u64>(p)
			from = pu + 1
			if pu > 0{
				let before = mut text.charAt(text, pu - 1)
				if Text.isWordChar(before) ||then dotBlocks &&then before == '.'{
					continue
				}
			}
			let q = mut (pu + name.length(name))
			if q < n &&then suffixChars.indexOf(suffixChars, text.charAt(text, q)) >= 0{
				q += 1
			}
			if q >= n ||then Text.isWordChar(text.charAt(text, q)) == false{
				return true
			}
		}
		return false
	}

	/** containsWord with any of several names (an alternation) */
	@pub
	static func containsAnyWord(text: ref some imut String, names: ref some imut ObjectList<String>, suffixChars: ref some imut String) mut bool{
		let m = mut names.size(names)
		for i in 0..m{
			let nm = mut names.get(names, i)
			match Some(nm){
				if Text.containsWord(text, nm, suffixChars, false){
					return true
				}
			}
		}
		return false
	}

	// Separator kinds: 0 = one given char, else the Text_SEP_* constants above.

	// finds the next separator at or after from; returns its end (exclusive) and stores its start in startOut[0], or -1
	static func nextSeparator(s: ref some imut String, kind: imut s32, sep: mut char, from: mut u64, startOut: ref some mut DynamicArray<s64>) mut s64{
		let sepWs = Text_sepWhitespace()
		let sepNw = Text_sepNonWord()
		let sepLb = Text_sepLineBreak()
		let n = mut s.length(s)
		for i in from..n{
			let c = mut s.charAt(s, i)
			let v = mut String.charCode(c)
			if kind == 0{
				if c == sep{
					match 0 into startOut.backing{
						startOut.set(startOut, 0, wrap:<s64>(i))
					}
					return wrap:<s64>(i + 1)
				}
			} else if kind == sepWs{
				if Text.isSpace(c){
					let j = mut i
					for k in i..n{
						if Text.isSpace(s.charAt(s, j)) == false{
							break
						}
						j += 1
					}
					match 0 into startOut.backing{
						startOut.set(startOut, 0, wrap:<s64>(i))
					}
					return wrap:<s64>(j)
				}
			} else if kind == sepNw{
				if Text.isWordChar(c) == false{
					let j = mut i
					for k in i..n{
						if Text.isWordChar(s.charAt(s, j)){
							break
						}
						j += 1
					}
					match 0 into startOut.backing{
						startOut.set(startOut, 0, wrap:<s64>(i))
					}
					return wrap:<s64>(j)
				}
			} else if kind == sepLb{
				if c == '\r' &&then i + 1 < n &&then s.charAt(s, i + 1) == '\n'{
					match 0 into startOut.backing{
						startOut.set(startOut, 0, wrap:<s64>(i))
					}
					return wrap:<s64>(i + 2)
				}
				// forced: no U+0085, U+2028, U+2029 (a char is one byte); v == 11 is \u000B, v == 12 is \f
				if c == '\n' ||then v == 11 ||then v == 12 ||then c == '\r'{
					match 0 into startOut.backing{
						startOut.set(startOut, 0, wrap:<s64>(i))
					}
					return wrap:<s64>(i + 1)
				}
			} else {
				if c == '\n'{
					match 0 into startOut.backing{
						startOut.set(startOut, 0, wrap:<s64>(i))
					}
					return wrap:<s64>(i + 1)
				}
				if c == '\r' &&then i + 1 < n &&then s.charAt(s, i + 1) == '\n'{
					match 0 into startOut.backing{
						startOut.set(startOut, 0, wrap:<s64>(i))
					}
					return wrap:<s64>(i + 2)
				}
			}
		}
		return -1
	}

	// the String.split algorithm for separators that are never empty
	@pub
	@throws
	static func splitBy(s0: ref some imut String, kind: imut s32, sep: mut char, limit: imut s64) owns some mut ObjectList<String>{
		?catch(e){ throw e }
		let s = mut ? Text.copyOf(s0) // ownership: the borrowed parameter is read after allocations, so it is copied once
		let list = mut ? new ObjectList:<String>()
		let limited = mut (limit > 0)
		let index = mut 0
		let:<mut s64> zero = mut 0
		let zarr = mut ? dyn([zero])
		let start = mut ? new DynamicArray:<s64>(zarr)
		let pos = mut 0
		let n = mut s.length(s)
		let lim = mut (n + 2)
		for step in 0..lim{ // forced: while(true) -> bounded for (pos grows every pass)
			let end = mut Text.nextSeparator(s, kind, sep, pos, start)
			if end < 0{
				break
			}
			let endu = mut wrap:<u64>(end)
			pos = endu
			let st = mut 0
			match 0 in start.backing{
				st = wrap:<u64>(start.get(start, 0))
			}
			let cnt = mut wrap:<s64>(list.size(list))
			if limited == false ||then cnt < limit - 1{
				let part = mut ? s.substring(s, index, st)
				? list.add(list, part)
				index = endu
			} else if cnt == limit - 1{
				let part = mut ? s.substring(s, index)
				? list.add(list, part)
				index = endu
			}
		}
		if index == 0{
			let whole = mut ? new ObjectList:<String>()
			let one = mut ? Text.copyOf(s)
			? whole.add(whole, one)
			return whole
		}
		let cnt2 = mut wrap:<s64>(list.size(list))
		if limited == false ||then cnt2 < limit{
			let part = mut ? s.substring(s, index)
			? list.add(list, part)
		}
		if limit == 0{
			// forced: Java decrements `size` and copies the first `size` elements into a String[]; the list owns its Strings, so the trailing empties are removed instead
			let size = mut list.size(list)
			for k in 0..size{
				let last = mut list.peek(list)
				let empty = mut false
				match Some(last){ empty = last.isEmpty(last) }
				if empty == false{
					break
				}
				? list.removeLast(list)
			}
		}
		return list
	}

	/** s.split(String.valueOf(sep), limit) for a single non-special character */
	@pub
	@throws
	static func split(s: ref some imut String, sep: mut char, limit: imut s32) owns some mut ObjectList<String>{
		?catch(e){ throw e }
		let r = mut ? Text.splitBy(s, 0, sep, wrap:<s64>(limit))
		return r
	}

	/** s.split("\\s+", limit) */
	@pub
	@throws
	static func splitSpace(s: ref some imut String, limit: imut s32) owns some mut ObjectList<String>{
		?catch(e){ throw e }
		let kind = Text_sepWhitespace()
		let r = mut ? Text.splitBy(s, kind, ' ', wrap:<s64>(limit))
		return r
	}

	/** s.split("[^A-Za-z0-9_]+") */
	@pub
	@throws
	static func splitNonWord(s: ref some imut String) owns some mut ObjectList<String>{
		?catch(e){ throw e }
		let kind = Text_sepNonWord()
		let r = mut ? Text.splitBy(s, kind, ' ', 0)
		return r
	}

	/** s.split("\\R") (ASCII line breaks only) */
	@pub
	@throws
	static func splitLineBreaks(s: ref some imut String) owns some mut ObjectList<String>{
		?catch(e){ throw e }
		let kind = Text_sepLineBreak()
		let r = mut ? Text.splitBy(s, kind, ' ', 0)
		return r
	}

	/** s.split("\r?\n", limit) */
	@pub
	@throws
	static func splitNewlines(s: ref some imut String, limit: imut s32) owns some mut ObjectList<String>{
		?catch(e){ throw e }
		let kind = Text_sepCrlfOrLf()
		let r = mut ? Text.splitBy(s, kind, ' ', wrap:<s64>(limit))
		return r
	}
}
