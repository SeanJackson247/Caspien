		match Some(h){ ? h.orFlag(h, id, 65536) }
		id = ? HbIO.lit(h, "GT_DESTRUCT")
		match Some(h){ ? h.orFlag(h, id, 65536) }
		id = ? HbIO.lit(h, "RET")
		match Some(h){ ? h.orFlag(h, id, 65536) }
		id = ? HbIO.lit(h, "POP")
		match Some(h){ ? h.orFlag(h, id, 65536) }
		id = ? HbIO.lit(h, "PUSH")
		match Some(h){ ? h.orFlag(h, id, 131072) }
		id = ? HbIO.lit(h, "ADDR")
		match Some(h){ ? h.orFlag(h, id, 131072) }
		id = ? HbIO.lit(h, "GT_DESTRUCT")
		match Some(h){ ? h.orFlag(h, id, 131072) }
		id = ? HbIO.lit(h, "ATOMIC_PUSH")
		match Some(h){ ? h.orFlag(h, id, 131072) }
		match Some(h){ ? h.recomputeAll(h) }
		return h
	}

	/** Every statement of `program` becomes a line of `ls` with its "original" mark (index + 1). */
	@pub
	@throws
	static func load(h: ref some mut Hb, program: ref some imut BytecodeProgram, ls: ref some mut Ls) void{
		?catch(e){ throw e }
		let n = mut program.size(program)
		for i in 0..n{
			? ls.addLine(ls, i + 1)
			let st = mut ? program.items.getSome(program.items, i)
			let m = mut st.size(st)
			for t in 0..m{
				let tk = mut ? st.items.getSome(st.items, t)
				h.tmpClear(h)
				let cn = mut tk.text.length(tk.text)
				for q in 0..cn{
					? h.tmpPush(h, String.charCode(tk.text.charAt(tk.text, q)))
				}
				let id = mut ? h.internTmp(h)
				? ls.addTok(ls, id)
			}
		}
	}

	/** The program for `ls`: lines still marked "original" are moved out of `program`, the others are scanned from their tokens. */
	@pub
	@throws
	static func build(h: ref imut Hb, ls: ref imut Ls, program: ref mut BytecodeProgram) owns some mut BytecodeProgram{
		?catch(e){ throw e }
		let out = mut ? new BytecodeProgram()
		let origin = mut ? new String()
		match Some(program){
			if program.size(program) > 0{
				let st0 = mut ? program.items.getSome(program.items, 0)
				let f0 = st0.fileOf(st0)
				match Some(f0){ origin = ? f0.sub(f0, 0, f0.length(f0)) }
			}
		}
		let n = mut 0
		match Some(ls){ n = ls.n(ls) }
		for i in 0..n{
			let mark = mut 0
			let s = mut 0
			let z = mut 0
			match Some(ls){
				mark = ls.origOf(ls, i)
				s = ls.lineStart(ls, i)
				z = ls.lineEnd(ls, i)
			}
			if mark > 0{
				match Some(program){
					let moved = mut program.items.take(program.items, mark - 1)
					? out.items.add(out.items, moved)
				}
			} else {
				let sb = mut ? new String()
				for q in s..z{
					if q > s{
						? sb.appendChar(sb, ' ')
					}
					let id = mut 0
					match Some(ls){ id = ls.toks.get(ls.toks, q) }
					match Some(h){ ? h.appendTo(h, sb, id) }
				}
				let stmt = mut ? BytecodeStatement.fromText(sb, origin)
				? out.items.add(out.items, stmt)
			}
		}
		return out
	}
}
