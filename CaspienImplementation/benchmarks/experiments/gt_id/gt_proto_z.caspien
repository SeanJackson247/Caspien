// Ghost-table micro benchmark (E tables, no id ever taken). GT_N synthetic addresses 48 bytes apart in one malloc'd region, visited in a pseudo-random order
// (k = i * 7919 mod N, N prime-ish). Generated by make_proto_bench.py.
import "../../stdlib/libc.caspien"
import "../../stdlib/gt/*"
extern getenv(static imut string) static imut string
extern atol(static imut string) mut u64

func lap(name: static imut string, t0: mut u64, ops: mut u64) mut u64{
	let t1 = mut 0
	unsafe assume extern{
		assume match ops != 0
		t1 = clock()
		printf("%-28s %6llu ns/op\n", name, (t1 - t0) * 1000 / ops)
		t1 = clock()
	}
	return t1
}

func main() void{
	unsafe assume extern{
		let n = mut atol(getenv("GT_N"))
		assume match n != 0
		let:<raw mut u8> region = null
		region = mut malloc(n * 48 + 64)
		gt_init()
		let t = mut clock()
		for i in 0..n{
			let k = mut ((i * 7919) % n)
			let p = mut (region + k * 48)
			let ok = gt_register(p)
		}
		t = lap("register", t, n)
		let hits = mut 0
		for i in 0..n{
			let k = mut ((i * 7919) % n)
			let p = mut (region + k * 48)
			let alive = gt_alive_check(p)
			if alive{ hits += 1 }
		}
		t = lap("alive_check (hit)", t, n)

		for i in 0..n{
			let k = mut ((i * 7919) % n)
			let p = mut (region + k * 48)
			gt_moved(p)
		}
		t = lap("moved (unregister)", t, n)
		printf("hits %llu\n", hits)
		free(region)
	}
}
