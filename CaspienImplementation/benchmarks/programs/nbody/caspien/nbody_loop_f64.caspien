// n-body (Computer Language Benchmarks Game), ported from the reference C
// program (nbody-gcc-1, contributed by Christoph Bauer) to Caspien -- looped array version.
//
// DIFFERENCES FROM THE C PROGRAM (each one forced by the current language):
//  * f64 variant: every value and operation is double precision, like the C program
//    (the f32 sibling of this file has the same layout). sqrt is the libm extern.
//  * struct-of-arrays: seven `let static` f64[5] arrays (x, y, z, vx, vy, vz,
//    mass) with their initial values in the static initialisers.
//  * every array access through a loop variable sits inside a `match i in/into <array>`
//    bounds proof, one per array (a proof is keyed to one array), so the loops are
//    nested match blocks (generated by gen3.py).
//  * N comes from the environment variable NBODY_N (no argv access from a
//    plain `main`).
extern printf(static imut string,...) void
extern sqrt(mut f64) mut f64
extern getenv(static imut string) static imut string
extern atol(static imut string) mut u64

let static:<mut f64[5]> x = mut [0.0, 4.841431442464721, 8.34336671824458, 12.894369562139131, 15.379697114850917]
let static:<mut f64[5]> y = mut [0.0, -1.1603200440274284, 4.124798564124305, -15.111151401698631, -25.919314609987964]
let static:<mut f64[5]> z = mut [0.0, -0.10362204447112311, -0.4035234171143214, -0.22330757889265573, 0.17925877295037118]
let static:<mut f64[5]> vx = mut [0.0, 0.606326392995832, -1.0107743461787924, 1.0827910064415354, 0.979090732243898]
let static:<mut f64[5]> vy = mut [0.0, 2.81198684491626, 1.8256623712304119, 0.8687130181696082, 0.5946989986476762]
let static:<mut f64[5]> vz = mut [0.0, -0.02521836165988763, 0.008415761376584154, -0.010832637401363636, -0.034755955504078104]
let static:<mut f64[5]> mass = mut [39.47841760435743, 0.03769367487038949, 0.011286326131968767, 0.0017237240570597112, 0.0020336868699246304]

func advance(dt: mut f64) void{
	unsafe assume extern global{
		for i in x{
			match i into vx{
				match i into vy{
					match i into vz{
						match i in x{
							match i in y{
								match i in z{
									match i in mass{
										let j0 = mut (i + 1)
										for j in j0..5{
											match j into vx{
												match j into vy{
													match j into vz{
														match j in x{
															match j in y{
																match j in z{
																	match j in mass{
																		assume match x[i] : finite
																		assume match x[j] : finite
																		let dx = mut (x[i] - x[j])
																		assume match y[i] : finite
																		assume match y[j] : finite
																		let dy = mut (y[i] - y[j])
																		assume match z[i] : finite
																		assume match z[j] : finite
																		let dz = mut (z[i] - z[j])
																		assume match dx : finite
																		assume match dy : finite
																		assume match dx*dx : finite
																		assume match dy*dy : finite
																		assume match dz : finite
																		assume match (dx*dx)+(dy*dy) : finite
																		assume match dz*dz : finite
																		let dist = mut sqrt(dx * dx + dy * dy + dz * dz)
																		assume match dist : finite
																		assume match dist*dist : finite
																		assume match dt : finite
																		assume match (dist*dist)*dist : finite
																		let mag = mut (dt / (dist * dist * dist))
																		assume match mass[j] : finite
																		assume match dx*mass[j] : finite
																		assume match mag : finite
																		vx[i] -= dx * mass[j] * mag
																		assume match dy*mass[j] : finite
																		vy[i] -= dy * mass[j] * mag
																		assume match dz*mass[j] : finite
																		vz[i] -= dz * mass[j] * mag
																		assume match mass[i] : finite
																		assume match dx*mass[i] : finite
																		vx[j] += dx * mass[i] * mag
																		assume match dy*mass[i] : finite
																		vy[j] += dy * mass[i] * mag
																		assume match dz*mass[i] : finite
																		vz[j] += dz * mass[i] * mag
																	}
																}
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		for i in x{
			match i into x{
				match i into y{
					match i into z{
						match i in vx{
							match i in vy{
								match i in vz{
									assume match dt : finite
									assume match vx[i] : finite
									x[i] += dt * vx[i]
									assume match vy[i] : finite
									y[i] += dt * vy[i]
									assume match vz[i] : finite
									z[i] += dt * vz[i]
								}
							}
						}
					}
				}
			}
		}
	}
	return
}

func energy() mut f64{
	let:<mut f64> e = mut 0.0
	unsafe assume extern global{
		for i in x{
			match i in x{
				match i in y{
					match i in z{
						match i in vx{
							match i in vy{
								match i in vz{
									match i in mass{
										assume match mass[i] : finite
										assume match vx[i] : finite
										assume match vy[i] : finite
										assume match vx[i]*vx[i] : finite
										assume match vy[i]*vy[i] : finite
										assume match vz[i] : finite
										assume match (vx[i]*vx[i])+(vy[i]*vy[i]) : finite
										assume match vz[i]*vz[i] : finite
										assume match 0.5*mass[i] : finite
										assume match ((vx[i]*vx[i])+(vy[i]*vy[i]))+(vz[i]*vz[i]) : finite
										e += 0.5 * mass[i] * (vx[i] * vx[i] + vy[i] * vy[i] + vz[i] * vz[i])
										let j0 = mut (i + 1)
										for j in j0..5{
											match j in x{
												match j in y{
													match j in z{
														match j in mass{
															assume match x[i] : finite
															assume match x[j] : finite
															let dx = mut (x[i] - x[j])
															assume match y[i] : finite
															assume match y[j] : finite
															let dy = mut (y[i] - y[j])
															assume match z[i] : finite
															assume match z[j] : finite
															let dz = mut (z[i] - z[j])
															assume match dx : finite
															assume match dy : finite
															assume match dx*dx : finite
															assume match dy*dy : finite
															assume match dz : finite
															assume match (dx*dx)+(dy*dy) : finite
															assume match dz*dz : finite
															let dist = mut sqrt(dx * dx + dy * dy + dz * dz)
															assume match mass[j] : finite
															assume match mass[i]*mass[j] : finite
															assume match dist : finite
															e -= (mass[i] * mass[j]) / dist
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
	return e
}

func offsetMomentum() void{
	unsafe assume global{
		let:<mut f64> px = mut 0.0
		let:<mut f64> py = mut 0.0
		let:<mut f64> pz = mut 0.0
		for i in x{
			match i in vx{
				match i in vy{
					match i in vz{
						match i in mass{
							assume match vx[i] : finite
							assume match mass[i] : finite
							px += vx[i] * mass[i]
							assume match vy[i] : finite
							py += vy[i] * mass[i]
							assume match vz[i] : finite
							pz += vz[i] * mass[i]
						}
					}
				}
			}
		}
		assume match px : finite
		assume match px/39.47841760435743 : finite
		vx[0] = mut 0.0 - px / 39.47841760435743
		assume match py : finite
		assume match py/39.47841760435743 : finite
		vy[0] = mut 0.0 - py / 39.47841760435743
		assume match pz : finite
		assume match pz/39.47841760435743 : finite
		vz[0] = mut 0.0 - pz / 39.47841760435743
	}
	return
}

func main() void{
	let n = mut 0
	unsafe extern{
		n = atol(getenv("NBODY_N"))
	}
	offsetMomentum()
	let e0 = mut energy()
	unsafe extern{
		printf("%.9f\n", e0)
	}
	for s in 0..n{
		advance(0.01)
	}
	let e1 = mut energy()
	unsafe extern{
		printf("%.9f\n", e1)
	}
	return
}
