import "stdlib/string.caspien"
import "../token/TokStore.caspien"
import "../token/TokenType.caspien"
import "Ty.caspien"
import "Infos.caspien"
import "World.caspien"
import "TypeAnn.caspien"
import "../util/StrMap.caspien"

/**
 * Port of TypeCheckerExpressions.resolveExprType, first slice: literals, parentheses, `mut`/`imut`, unary minus, `atomic` and array literals,
 * enough to type the initialiser of most globals. One explicit stack of (node, phase) pairs; a node's children are typed first (post-order) and their
 * Ty rows wait on a value stack. typeOf returns the Ty row, or TOK_NONE for any construct (or error case) this slice does not cover yet.
 * Literal values are decimal-text string ids in TY_LITVAL / the list in TY_LIT_ELEMS. Not yet done: the node.chk annotations (resolvedType, adaptLiteral retags).
 */
const MULTI_CAND 18446744073709551614
const XK_IND 0
const XK_IMUT 1
const XK_MUT 2
const XK_U64 3
const XK_S64 4
const XK_STRING 5
const XK_STATIC 6
const XK_CHAR 7
const XK_BOOL 8
const XK_NULL 9
const XK_F32 10
const XK_NEG 11
const XK_ZERO 12

@pub
struct Expr{@pub{
}}

@pub
impl Expr{
	@throws
	static func consts(ts: ref mut TokStore) mut u64{
		?catch(e){ throw e }
		let k = mut ? TokStore.newList(ts)
		let a0 = mut ? TokStore.addLit(ts, "indeterminate")
		? TokStore.listAdd(ts, k, a0)
		let a1 = mut ? TokStore.addLit(ts, "imut")
		? TokStore.listAdd(ts, k, a1)
		let a2 = mut ? TokStore.addLit(ts, "mut")
		? TokStore.listAdd(ts, k, a2)
		let a3 = mut ? TokStore.addLit(ts, "u64")
		? TokStore.listAdd(ts, k, a3)
		let a4 = mut ? TokStore.addLit(ts, "s64")
		? TokStore.listAdd(ts, k, a4)
		let a5 = mut ? TokStore.addLit(ts, "string")
		? TokStore.listAdd(ts, k, a5)
		let a6 = mut ? TokStore.addLit(ts, "static")
		? TokStore.listAdd(ts, k, a6)
		let a7 = mut ? TokStore.addLit(ts, "char")
		? TokStore.listAdd(ts, k, a7)
		let a8 = mut ? TokStore.addLit(ts, "bool")
		? TokStore.listAdd(ts, k, a8)
		let a9 = mut ? TokStore.addLit(ts, "null")
		? TokStore.listAdd(ts, k, a9)
		let a10 = mut ? TokStore.addLit(ts, "f32")
		? TokStore.listAdd(ts, k, a10)
		let a11 = mut ? TokStore.addLit(ts, "-")
		? TokStore.listAdd(ts, k, a11)
		let a12 = mut ? TokStore.addLit(ts, "0")
		? TokStore.listAdd(ts, k, a12)
		return k
	}

	@pub
	static func isIntBase(ts: ref imut TokStore, sid: mut u64) mut bool{
		if TokStore.strEq(ts, sid, "u8") || TokStore.strEq(ts, sid, "u16") || TokStore.strEq(ts, sid, "u32") || TokStore.strEq(ts, sid, "u64"){
			return true
		}
		if TokStore.strEq(ts, sid, "s8") || TokStore.strEq(ts, sid, "s16") || TokStore.strEq(ts, sid, "s32") || TokStore.strEq(ts, sid, "s64"){
			return true
		}
		return false
	}

	@pub
	static func isFloatBase(ts: ref imut TokStore, sid: mut u64) mut bool{
		return TokStore.strEq(ts, sid, "f32") || TokStore.strEq(ts, sid, "f64")
	}

	/** Type of the variable of `for v in <rangeTy>`: `mut u64` for a range, a fixed array or a safe dynarray; TOK_NONE for anything else. */
	@pub
	@throws
	static func loopVarType(ts: ref mut TokStore, tl: mut u64, rangeTy: mut u64) mut u64{
		?catch(e){ throw e }
		let k = mut ? Expr.consts(ts)
		let base = mut Ty.get(ts, tl, rangeTy, TY_BASE)
		let dyn = mut Ty.get(ts, tl, rangeTy, TY_DYN_ELEM)
		let rg = mut ? TokStore.addLit(ts, "range(")
		if Decl.startsWith(ts, base, rg) == 0 && Decl.isArrayType(ts, base) == 0 && dyn == TOK_NONE{
			return TOK_NONE
		}
		if Ty.get(ts, tl, rangeTy, TY_UDYN_ELEM) != TOK_NONE{
			return TOK_NONE
		}
		let lt = mut ? Expr.litTy(ts, tl, TOK_NONE, TokStore.listGet(ts, k, XK_MUT), TokStore.listGet(ts, k, XK_U64))
		return lt
	}

	/** TypeCheckerCalls.isPureSimpleOperand: a variable, integer literal, field chain, or a mut/imut/negation of one. */
	static func pureSimple(ts: ref imut TokStore, t0: mut u64) mut bool{
		let t = mut t0
		for lp in 0..1000{
			let kd = mut TokStore.kind(ts, t)
			if kd == TT_VARREF || kd == TT_INTEGER{
				return true
			}
			if kd != TT_OPERATOR || TokStore.left(ts, t) == TOK_NONE{
				return false
			}
			if TokStore.textEq(ts, t, ".") && TokStore.unary(ts, t) == 0 && TokStore.right(ts, t) != TOK_NONE{
				if TokStore.kind(ts, TokStore.right(ts, t)) != TT_VARREF{
					return false
				}
				t = TokStore.left(ts, t)
			} else if TokStore.textEq(ts, t, "mut") || TokStore.textEq(ts, t, "imut") || (TokStore.textEq(ts, t, "-") && TokStore.unary(ts, t) != 0){
				t = TokStore.left(ts, t)
			} else {
				return false
			}
		}
		return false
	}

	/** Compares the digits of `a` from index `from` with the whole text `b`: 0 equal, 1 a > b, 2 a < b (no leading zeros assumed). */
	static func cmpDec(ts: ref imut TokStore, a: mut u64, from: mut u64, b: mut u64) mut u64{
		let la = mut (TokStore.strLen(ts, a) - from)
		let lb = mut TokStore.strLen(ts, b)
		if la > lb{
			return 1
		}
		if la < lb{
			return 2
		}
		for i in 0..la{
			let ca = mut String.charCode(TokStore.strCh(ts, a, from + i))
			let cb = mut String.charCode(TokStore.strCh(ts, b, i))
			if ca > cb{
				return 1
			}
			if ca < cb{
				return 2
			}
		}
		return 0
	}

	/** True when the decimal text `v` (optionally with a leading '-') fits s64. `lim` and `limNeg` are the texts of 9223372036854775807 and 9223372036854775808. */
	static func fitsS64(ts: ref imut TokStore, v: mut u64, lim: mut u64, limNeg: mut u64) mut bool{
		let n = mut TokStore.strLen(ts, v)
		if n == 0{
			return false
		}
		if TokStore.strCh(ts, v, 0) == '-'{
			return Expr.cmpDec(ts, v, 1, limNeg) != 1
		}
		return Expr.cmpDec(ts, v, 0, lim) != 1
	}

	/** Decimal limits, indexed: 0..3 max of u8,u16,u32,u64; 4..7 max of s8,s16,s32,s64; 8..11 magnitude of the min of s8,s16,s32,s64. */
	@pub
	@throws
	static func limits(ts: ref mut TokStore) mut u64{
		?catch(e){ throw e }
		let l = mut ? TokStore.newList(ts)
		let a0 = mut ? TokStore.addLit(ts, "255")
		? TokStore.listAdd(ts, l, a0)
		let a1 = mut ? TokStore.addLit(ts, "65535")
		? TokStore.listAdd(ts, l, a1)
		let a2 = mut ? TokStore.addLit(ts, "4294967295")
		? TokStore.listAdd(ts, l, a2)
		let a3 = mut ? TokStore.addLit(ts, "18446744073709551615")
		? TokStore.listAdd(ts, l, a3)
		let a4 = mut ? TokStore.addLit(ts, "127")
		? TokStore.listAdd(ts, l, a4)
		let a5 = mut ? TokStore.addLit(ts, "32767")
		? TokStore.listAdd(ts, l, a5)
		let a6 = mut ? TokStore.addLit(ts, "2147483647")
		? TokStore.listAdd(ts, l, a6)
		let a7 = mut ? TokStore.addLit(ts, "9223372036854775807")
		? TokStore.listAdd(ts, l, a7)
		let a8 = mut ? TokStore.addLit(ts, "128")
		? TokStore.listAdd(ts, l, a8)
		let a9 = mut ? TokStore.addLit(ts, "32768")
		? TokStore.listAdd(ts, l, a9)
		let a10 = mut ? TokStore.addLit(ts, "2147483648")
		? TokStore.listAdd(ts, l, a10)
		let a11 = mut ? TokStore.addLit(ts, "9223372036854775808")
		? TokStore.listAdd(ts, l, a11)
		return l
	}

	/** Index 0..3 for u8..u64 and 4..7 for s8..s64 of an integer base name, else 99. */
	static func intIndex(ts: ref imut TokStore, sid: mut u64) mut u64{
		if TokStore.strEq(ts, sid, "u8"){ return 0 }
		if TokStore.strEq(ts, sid, "u16"){ return 1 }
		if TokStore.strEq(ts, sid, "u32"){ return 2 }
		if TokStore.strEq(ts, sid, "u64"){ return 3 }
		if TokStore.strEq(ts, sid, "s8"){ return 4 }
		if TokStore.strEq(ts, sid, "s16"){ return 5 }
		if TokStore.strEq(ts, sid, "s32"){ return 6 }
		if TokStore.strEq(ts, sid, "s64"){ return 7 }
		return 99
	}

	/** TypeCheckerModel.literalFits for the decimal text `v` and the integer type named `base`. */
	@pub
	static func literalFits(ts: ref imut TokStore, lim: mut u64, v: mut u64, base: mut u64) mut bool{
		let ix = mut Expr.intIndex(ts, base)
		if ix == 99{
			return false
		}
		if TokStore.strCh(ts, v, 0) == '-'{
			if ix < 4{
				return false
			}
			return Expr.cmpDec(ts, v, 1, TokStore.listGet(ts, lim, ix + 4)) != 1
		}
		return Expr.cmpDec(ts, v, 0, TokStore.listGet(ts, lim, ix)) != 1
	}

	/** TypeChecker.mutabilityCompatible on the mutability string ids (TOK_NONE = Java null). */
	@pub
	static func mutCompat(ts: ref imut TokStore, expected: mut u64, actual: mut u64) mut bool{
		if expected == TOK_NONE || actual == TOK_NONE{
			return true
		}
		if TokStore.strsEq(ts, expected, actual){
			return true
		}
		if TokStore.strEq(ts, expected, "indeterminate"){
			return false
		}
		if TokStore.strEq(ts, actual, "indeterminate"){
			return true
		}
		return TokStore.strEq(ts, actual, "mut") && TokStore.strEq(ts, expected, "imut")
	}

	/** Index of the first '[' in the text (0 when absent). */
	static func openIx(ts: ref imut TokStore, sid: mut u64) mut u64{
		let n = mut TokStore.strLen(ts, sid)
		for i in 0..n{
			if TokStore.strCh(ts, sid, i) == '['{
				return i
			}
		}
		return 0
	}

	/** True when the text from each string's first '[' to its end is identical. */
	static func dimsEq(ts: ref imut TokStore, a: mut u64, b: mut u64) mut bool{
		let ia = mut Expr.openIx(ts, a)
		let ib = mut Expr.openIx(ts, b)
		if ia == 0 || ib == 0{
			return false
		}
		let la = mut (TokStore.strLen(ts, a) - ia)
		let lb = mut (TokStore.strLen(ts, b) - ib)
		if la != lb{
			return false
		}
		for i in 0..la{
			if TokStore.strCh(ts, a, ia + i) != TokStore.strCh(ts, b, ib + i){
				return false
			}
		}
		return true
	}

	/** TypeChecker.literalAdapts(expected, actual). */
	@pub
	@throws
	static func literalAdapts(ts: ref mut TokStore, tl: mut u64, lim: mut u64, expected: mut u64, actual: mut u64) mut bool{
		?catch(e){ throw e }
		let eSt = mut Ty.get(ts, tl, expected, TY_STORAGE)
		let eSome = mut Ty.get(ts, tl, expected, TY_SOME)
		let eBase = mut Ty.get(ts, tl, expected, TY_BASE)
		let eMut = mut Ty.get(ts, tl, expected, TY_MUT)
		let aMut = mut Ty.get(ts, tl, actual, TY_MUT)
		let aBase = mut Ty.get(ts, tl, actual, TY_BASE)
		let elems = mut Ty.get(ts, tl, actual, TY_LIT_ELEMS)
		let fArr = mut Ty.get(ts, tl, actual, TY_FLOAT_ARR_LIT)
		if elems != TOK_NONE || fArr != 0{
			if eSt != TOK_NONE || eSome != 0 || Expr.mutCompat(ts, eMut, aMut) == false{
				return false
			}
			let open = mut Expr.openIx(ts, eBase)
			let bn = mut TokStore.strLen(ts, eBase)
			if open == 0 || TokStore.strCh(ts, eBase, bn - 1) != ']'{
				return false
			}
			let elem = mut ? Ty.subStr(ts, eBase, 0, open)
			if Expr.dimsEq(ts, eBase, aBase) == false{
				return false
			}
			if elems != TOK_NONE{
				if Expr.intIndex(ts, elem) == 99{
					return false
				}
				let ne = mut TokStore.listSize(ts, elems)
				for i in 0..ne{
					if Expr.literalFits(ts, lim, TokStore.listGet(ts, elems, i), elem) == false{
						return false
					}
				}
				return true
			}
			return Expr.isFloatBase(ts, elem)
		}
		if Ty.get(ts, tl, actual, TY_FLOAT_LIT) != 0{
			return Ty.get(ts, tl, actual, TY_STORAGE) == TOK_NONE && eSt == TOK_NONE && eSome == 0 && Expr.isFloatBase(ts, eBase) && Expr.mutCompat(ts, eMut, aMut)
		}
		let lv = mut Ty.get(ts, tl, actual, TY_LITVAL)
		if lv == TOK_NONE || Ty.get(ts, tl, actual, TY_STORAGE) != TOK_NONE || eSt != TOK_NONE || eSome != 0{
			return false
		}
		return Expr.literalFits(ts, lim, lv, eBase) && Expr.mutCompat(ts, eMut, aMut)
	}

	/**
	 * resolveAndValidateTypeBound for a non-null initialiser of plain (storage-free) shape: the bound itself when the initialiser's type equals it or
	 * adapts as a literal, else TOK_NONE (an error case, or a shape not covered yet).
	 */
	@pub
	@throws
	static func boundResult(ts: ref mut TokStore, tl: mut u64, lim: mut u64, bound: mut u64, rhs: mut u64) mut u64{
		?catch(e){ throw e }
		let rMut = mut Ty.get(ts, tl, rhs, TY_MUT)
		if rMut == TOK_NONE || (TokStore.strEq(ts, rMut, "mut") == false && TokStore.strEq(ts, rMut, "imut") == false){
			return TOK_NONE
		}
		if Ty.get(ts, tl, bound, TY_STORAGE) != TOK_NONE || Ty.get(ts, tl, rhs, TY_STORAGE) != TOK_NONE{
			return TOK_NONE
		}
		let same = mut TokStore.strsEq(ts, Ty.get(ts, tl, rhs, TY_BASE), Ty.get(ts, tl, bound, TY_BASE))
		let litOk = mut ? Expr.literalAdapts(ts, tl, lim, bound, rhs)
		if same == false && litOk == false{
			return TOK_NONE
		}
		if Expr.mutCompat(ts, Ty.get(ts, tl, bound, TY_MUT), rMut) == false{
			return TOK_NONE
		}
		return bound
	}

	@pub
	@throws
	static func litTy(ts: ref mut TokStore, tl: mut u64, storage: mut u64, mutab: mut u64, base: mut u64) mut u64{
		?catch(e){ throw e }
		let t = mut ? Ty.make(ts, tl, storage, mutab, base, TOK_NONE)
		return t
	}

	/** Types `root`; TOK_NONE = not covered by this slice. */
	@pub
	@throws
	static func typeOf(ts: ref mut TokStore, tl: mut u64, w: mut u64, er: mut u64, root: mut u64, env: mut u64, cx: mut u64) mut u64{
		?catch(e){ throw e }
		let k = mut ? Expr.consts(ts)
		let lim0 = mut ? Expr.limits(ts)
		let stN = mut ? TokStore.newList(ts)
		let stP = mut ? TokStore.newList(ts)
		let vals = mut ? TokStore.newList(ts)
		? TokStore.listAdd(ts, stN, root)
		? TokStore.listAdd(ts, stP, 0)
		let rec = mut TOK_NONE
		if cx != TOK_NONE && TokStore.listSize(ts, cx) > 16{
			rec = TokStore.listGet(ts, cx, 16)
		}
		let lastNode = mut TOK_NONE
		let lastSz = mut 0
		let lastVs = mut 0
		let lastPh = mut 0
		for lp in 0..1000000000{
			if lastNode != TOK_NONE && rec != TOK_NONE{
				let didPop = mut (TokStore.listSize(ts, stN) + 1 == lastSz)
				let didVal = mut (TokStore.listSize(ts, vals) != lastVs || lastPh != 0)
				if didPop && didVal && TokStore.listSize(ts, vals) > 0{
					? TokStore.listAdd(ts, rec, lastNode)
					? TokStore.listAdd(ts, rec, TokStore.listGet(ts, vals, TokStore.listSize(ts, vals) - 1))
				}
			}
			if TokStore.listSize(ts, stN) == 0{
				break
			}
			lastSz = TokStore.listSize(ts, stN)
			lastVs = TokStore.listSize(ts, vals)
			let node = mut TokStore.listPop(ts, stN)
			let ph = mut TokStore.listPop(ts, stP)
			lastNode = node
			lastPh = ph
			let kind = mut TokStore.kind(ts, node)
			if ph == 0{
				if kind == TT_VARREF{
					if env == TOK_NONE{
						return TOK_NONE
					}
					let vt = mut StrMap.get(ts, env, TokStore.text(ts, node))
					if vt == TOK_NONE && StrMap.has(ts, env, TokStore.text(ts, node)) == false && cx != TOK_NONE{
						vt = StrMap.get(ts, World.get(ts, w, W_M_GLOBALS), TokStore.text(ts, node))
					}
					if vt == TOK_NONE && cx != TOK_NONE && StrMap.has(ts, env, TokStore.text(ts, node)) == false && StrMap.has(ts, World.get(ts, w, W_M_GLOBALS), TokStore.text(ts, node)) == false{
						let fov = mut StrMap.get(ts, World.get(ts, w, W_M_FUNCS), TokStore.text(ts, node))
						if fov != TOK_NONE && TokStore.listSize(ts, fov) == 1{
							let ffl = mut TokStore.listGet(ts, cx, 7)
							let ffi = mut TokStore.listGet(ts, fov, 0)
							let ftok = mut Infos.fget(ts, ffl, ffi, FI_FUNC_TOK)
							if Dec.getDecorator(ts, TokStore.decorators(ts, ftok), "event_loop") != TOK_NONE{
								return TOK_NONE
							}
							let fdn = mut ? TokStore.newList(ts)
							let fds = mut TokStore.decorators(ts, ftok)
							if fds != TOK_NONE{
								let nfd = mut TokStore.listSize(ts, fds)
								for fdi in 0..nfd{
									? TokStore.listAdd(ts, fdn, TokStore.dName(ts, TokStore.listGet(ts, fds, fdi)))
								}
							}
							let fpt = mut ? Ty.funcPointer(ts, tl, TokStore.listGet(ts, k, XK_IMUT), Infos.fget(ts, ffl, ffi, FI_PARAM_TYPES), Infos.fget(ts, ffl, ffi, FI_RETURN), fdn, Infos.fget(ts, ffl, ffi, FI_CALL_CONV))
							? TokStore.listAdd(ts, vals, fpt)
							continue
						}
					}
					if vt == TOK_NONE{
						return TOK_NONE
					}
					let vc = mut ? Ty.copy(ts, tl, vt)
					Ty.set(ts, tl, vc, TY_LITVAL, TOK_NONE)
					Ty.set(ts, tl, vc, TY_FLOAT_LIT, 0)
					Ty.set(ts, tl, vc, TY_FLOAT_ARR_LIT, 0)
					Ty.set(ts, tl, vc, TY_LIT_ELEMS, TOK_NONE)
					? TokStore.listAdd(ts, vals, vc)
					continue
				}
				if (kind == TT_KEYWORD || kind == TT_OPERATOR) && TokStore.textEq(ts, node, "try"){
					let tsb = mut TokStore.sub(ts, node)
					if tsb == TOK_NONE || TokStore.listSize(ts, tsb) == 0{
						return TOK_NONE
					}
					? TokStore.listAdd(ts, stN, node)
					? TokStore.listAdd(ts, stP, 500008)
					? TokStore.listAdd(ts, stN, TokStore.listGet(ts, tsb, 0))
					? TokStore.listAdd(ts, stP, 0)
					continue
				}
				if kind == TT_OPERATOR && TokStore.unary(ts, node) == 0 && TokStore.textEq(ts, node, "CALL") && TokStore.left(ts, node) != TOK_NONE && TokStore.kind(ts, TokStore.left(ts, node)) == TT_VARREF{
					let cname = mut TokStore.text(ts, TokStore.left(ts, node))
					if TokStore.strEq(ts, cname, "len") && TokStore.genericArgs(ts, TokStore.left(ts, node)) == TOK_NONE{
						let largs = mut ? TokStore.newList(ts)
						let nla = mut Expr.collectArgs(ts, TokStore.right(ts, node), largs)
						if nla != 1{
							return TOK_NONE
						}
						? TokStore.listAdd(ts, stN, node)
						? TokStore.listAdd(ts, stP, 500009)
						? TokStore.listAdd(ts, stN, TokStore.listGet(ts, largs, 0))
						? TokStore.listAdd(ts, stP, 0)
						continue
					}
					if TokStore.strEq(ts, cname, "len") || TokStore.strEq(ts, cname, "sizeof") || TokStore.strEq(ts, cname, "insecure_rand"){
						let bt0 = mut ? Expr.litTy(ts, tl, TOK_NONE, TokStore.listGet(ts, k, XK_IND), TokStore.listGet(ts, k, XK_U64))
						? TokStore.listAdd(ts, vals, bt0)
						continue
					}
					if TokStore.strEq(ts, cname, "dyn") && TokStore.genericArgs(ts, TokStore.left(ts, node)) != TOK_NONE{
						let dga = mut TokStore.genericArgs(ts, TokStore.left(ts, node))
						if TokStore.listSize(ts, dga) != 1{
							return TOK_NONE
						}
						let dgrp = mut TokStore.listGet(ts, dga, 0)
						if TokStore.listSize(ts, dgrp) != 1{
							return TOK_NONE
						}
						let delem = mut TokStore.listGet(ts, dgrp, 0)
						let dargs2 = mut ? TokStore.newList(ts)
						let nda2 = mut Expr.collectArgs(ts, TokStore.right(ts, node), dargs2)
						if nda2 != 1{
							return TOK_NONE
						}
						let darg = mut TokStore.listGet(ts, dargs2, 0)
						if TokStore.kind(ts, darg) != TT_DELINEATOR || TokStore.childs(ts, darg) != TOK_NONE && TokStore.listSize(ts, TokStore.childs(ts, darg)) != 0{
							return TOK_NONE
						}
						let mutSid = mut ? TokStore.addLit(ts, "mut")
