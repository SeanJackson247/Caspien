				let rb5 = mut Ty.get(ts, tl, r5, TY_BASE)
				let lb5 = mut Ty.get(ts, tl, l5, TY_BASE)
				if (TokStore.strEq(ts, rb5, "bool") == false && Expr.isIntBase(ts, rb5) == false) || (TokStore.strEq(ts, lb5, "bool") == false && Expr.isIntBase(ts, lb5) == false){
					return TOK_NONE
				}
				let bt5 = mut ? Expr.litTy(ts, tl, TOK_NONE, TokStore.listGet(ts, k, XK_IND), TokStore.listGet(ts, k, XK_BOOL))
				? TokStore.listAdd(ts, vals, bt5)
				continue
			}
			if ph == 500006{
				let r6 = mut TokStore.listPop(ts, vals)
				let l6 = mut TokStore.listPop(ts, vals)
				let isEq = mut (TokStore.textEq(ts, node, "==") || TokStore.textEq(ts, node, "!="))
				let c6 = mut ? Expr.cmpResult(ts, tl, lim0, k, isEq, l6, r6)
				if c6 == TOK_NONE{
					return TOK_NONE
				}
				? Expr.unifyRetag(ts, tl, lim0, rec, node, l6, r6)
				? TokStore.listAdd(ts, vals, c6)
				continue
			}
			if ph == 500010{
				let swr = mut TokStore.listPop(ts, vals)
				let swl = mut TokStore.listPop(ts, vals)
				if Ty.get(ts, tl, swl, TY_ATOMIC) == 0 || Ty.get(ts, tl, swl, TY_STORAGE) != TOK_NONE || TokStore.strEq(ts, Ty.get(ts, tl, swl, TY_MUT), "mut") == false{
					return TOK_NONE
				}
				let swc = mut ? Expr.compat(ts, tl, lim0, w, swl, swr)
				if swc != 1{
					return TOK_NONE
				}
				let swt = mut ? Ty.make(ts, tl, TOK_NONE, TokStore.listGet(ts, k, XK_IND), Ty.get(ts, tl, swl, TY_BASE), TOK_NONE)
				? TokStore.listAdd(ts, vals, swt)
				continue
			}
			if ph == 500002{
				let nt = mut TokStore.listPop(ts, vals)
				let ownsSid = mut ? TokStore.addLit(ts, "owns")
				let nt1 = mut ? Ty.make(ts, tl, ownsSid, Ty.get(ts, tl, nt, TY_MUT), Ty.get(ts, tl, nt, TY_BASE), TOK_NONE)
				let nt2 = mut ? Ty.withSome(ts, tl, nt1, 1)
				? TokStore.listAdd(ts, vals, nt2)
				continue
			}
			if ph == 500003{
				let dt = mut TokStore.listPop(ts, vals)
				let elemT = mut TOK_NONE
				if TokStore.strEq(ts, Ty.get(ts, tl, dt, TY_BASE), "string") && Ty.get(ts, tl, dt, TY_ARR_ELEM) == TOK_NONE{
					let imutSid = mut TokStore.listGet(ts, k, XK_IMUT)
					let chSid = mut TokStore.listGet(ts, k, XK_CHAR)
					elemT = ? Ty.make(ts, tl, TOK_NONE, imutSid, chSid, TOK_NONE)
				} else {
					elemT = Ty.get(ts, tl, dt, TY_ARR_ELEM)
				}
				if elemT == TOK_NONE{
					return TOK_NONE
				}
				let dd1 = mut ? Ty.dynArray(ts, tl, TokStore.listGet(ts, k, XK_IND), elemT)
				let dd2 = mut ? Ty.withSome(ts, tl, dd1, 1)
				if rec != TOK_NONE{
					let dga = mut ? TokStore.newList(ts)
					let ndg = mut Expr.collectArgs(ts, TokStore.right(ts, node), dga)
					if ndg == 1 && TokStore.kind(ts, TokStore.listGet(ts, dga, 0)) == TT_DELINEATOR && TokStore.textEq(ts, TokStore.listGet(ts, dga, 0), "["){
						? TokStore.listAdd(ts, rec, TokStore.listGet(ts, dga, 0))
						? TokStore.listAdd(ts, rec, TOK_NONE)
					}
				}
				? TokStore.listAdd(ts, vals, dd2)
				continue
			}
			if ph == 500001{
				let lta = mut TokStore.listPop(ts, vals)
				let asr2 = mut ? Expr.asResult(ts, tl, w, k, lta, TokStore.text(ts, TokStore.right(ts, node)))
				if asr2 == TOK_NONE{
					return TOK_NONE
				}
				? TokStore.listAdd(ts, vals, asr2)
				continue
			}
			if ph == 500000{
				let lt0 = mut TokStore.listPop(ts, vals)
				let srows = mut World.get(ts, w, W_M_STRUCTS)
				let sbase = mut Ty.get(ts, tl, lt0, TY_BASE)
				let rgp = mut ? TokStore.addLit(ts, "range(")
				if Decl.startsWith(ts, sbase, rgp) == 1 || TokStore.strEq(ts, sbase, "range"){
					let rmn = mut TokStore.right(ts, node)
					if Ty.get(ts, tl, lt0, TY_STORAGE) != TOK_NONE || TokStore.kind(ts, rmn) != TT_VARREF || (TokStore.textEq(ts, rmn, "start") == false && TokStore.textEq(ts, rmn, "end") == false){
						return TOK_NONE
					}
					let rmt = mut ? Expr.litTy(ts, tl, TOK_NONE, TokStore.listGet(ts, k, XK_IND), TokStore.listGet(ts, k, XK_U64))
					? TokStore.listAdd(ts, vals, rmt)
					continue
				}
				if StrMap.has(ts, srows, sbase) == false{
					return TOK_NONE
				}
				let srow = mut StrMap.get(ts, srows, sbase)
				let sl = mut TokStore.listGet(ts, cx, CX_SR)
				let memb = mut Infos.sget(ts, sl, srow, SI_MEMBERS)
				let mname = mut TokStore.text(ts, TokStore.right(ts, node))
				if memb == TOK_NONE || StrMap.has(ts, memb, mname) == false{
					return TOK_NONE
				}
				? TokStore.listAdd(ts, vals, StrMap.get(ts, memb, mname))
				continue
			}
			if ph == 2{
				let opk0 = mut 2
				if TokStore.textEq(ts, node, "+"){
					opk0 = 0
				} else if TokStore.textEq(ts, node, "-"){
					opk0 = 1
				}
				let rty = mut TokStore.listPop(ts, vals)
				let lty = mut TokStore.listPop(ts, vals)
				let ar2 = mut ? Expr.arithResult(ts, tl, lim0, k, opk0, lty, rty)
				if ar2 == TOK_NONE{
					return TOK_NONE
				}
				? Expr.unifyRetag(ts, tl, lim0, rec, node, lty, rty)
				? TokStore.listAdd(ts, vals, ar2)
				continue
			}
			if ph == 1{
				if kind == TT_DELINEATOR{
					continue
				}
				let operand = mut TokStore.listPop(ts, vals)
				let r = mut ? Expr.unaryResult(ts, tl, k, node, operand)
				if r == TOK_NONE{
					return TOK_NONE
				}
				? TokStore.listAdd(ts, vals, r)
				continue
			}
			let n = mut (ph - 2)
			let nv = mut TokStore.listSize(ts, vals)
			let base0 = mut (nv - n)
			let ets = mut ? TokStore.newList(ts)
			for ei in 0..n{
				? TokStore.listAdd(ts, ets, TokStore.listGet(ts, vals, base0 + ei))
			}
			for pi in 0..n{
				TokStore.listPop(ts, vals)
			}
			let enodes = mut ? TokStore.newList(ts)
			let nen = mut Expr.collectArgs(ts, node, enodes)
			let ar = mut ? Expr.arrayResult(ts, tl, k, ets, rec, enodes)
			if ar == TOK_NONE{
				return TOK_NONE
			}
			? TokStore.listAdd(ts, vals, ar)
		}
		if TokStore.listSize(ts, vals) != 1{
			return TOK_NONE
		}
		return TokStore.listGet(ts, vals, 0)
	}

	/** Appends the comma-separated argument tokens of a call's `(` token to `out` in order; returns their count. */
	@pub
	static func collectArgs(ts: ref mut TokStore, args: mut u64, out: mut u64) mut u64{
		?catch(e){ return 0 }
		if args == TOK_NONE{
			return 0
		}
		let cs = mut TokStore.childs(ts, args)
		if cs == TOK_NONE || TokStore.listSize(ts, cs) == 0{
			return 0
		}
		let work = mut ? TokStore.newList(ts)
		? TokStore.listAdd(ts, work, TokStore.listGet(ts, cs, 0))
		let cnt = mut 0
		for lp in 0..1000000000{
			if TokStore.listSize(ts, work) == 0{
				break
			}
			let a = mut TokStore.listPop(ts, work)
			if TokStore.kind(ts, a) == TT_OPERATOR && TokStore.textEq(ts, a, ",") && TokStore.unary(ts, a) == 0{
				? TokStore.listAdd(ts, work, TokStore.right(ts, a))
				? TokStore.listAdd(ts, work, TokStore.left(ts, a))
			} else {
				? TokStore.listAdd(ts, out, a)
				cnt = cnt + 1
			}
		}
		return cnt
	}

	/** Latest type recorded for `node` in `rec` (pairs node, type), TOK_NONE if none. */
	static func latest(ts: ref mut TokStore, rec: mut u64, node: mut u64) mut u64{
		let q = mut TokStore.listSize(ts, rec)
		for lp in 0..1000000000{
			if q < 2{
				break
			}
			q = q - 2
			if TokStore.listGet(ts, rec, q) == node{
				return TokStore.listGet(ts, rec, q + 1)
			}
		}
		return TOK_NONE
	}

	/** Same-width unsigned counterpart of a signed integer base (UNSIGNED_TO_SIGNED reversed); other bases unchanged. */
	@throws
	static func unsignedOf(ts: ref mut TokStore, b: mut u64) mut u64{
		?catch(e){ throw e }
		if TokStore.strEq(ts, b, "s64"){
			let u1 = mut ? TokStore.addLit(ts, "u64")
			return u1
		}
		if TokStore.strEq(ts, b, "s32"){
			let u2 = mut ? TokStore.addLit(ts, "u32")
			return u2
		}
		if TokStore.strEq(ts, b, "s16"){
			let u3 = mut ? TokStore.addLit(ts, "u16")
			return u3
		}
		if TokStore.strEq(ts, b, "s8"){
			let u4 = mut ? TokStore.addLit(ts, "u8")
			return u4
		}
		return b
	}

	/** Java TypeChecker.adaptLiteral(root, expected): retags literal expressions with the slot's base type, recording the new types in `rec`. */
	@throws
	static func adapt(ts: ref mut TokStore, tl: mut u64, rec: mut u64, root: mut u64, eBase: mut u64) void{
		?catch(e){ throw e }
		if rec == TOK_NONE || root == TOK_NONE{
			return
		}
		let work = mut ? TokStore.newList(ts)
		? TokStore.listAdd(ts, work, root)
		? TokStore.listAdd(ts, work, eBase)
		? TokStore.listAdd(ts, work, 0)
		? TokStore.listAdd(ts, work, TOK_NONE)
		for lp in 0..1000000000{
			if TokStore.listSize(ts, work) == 0{
				break
			}
			let extra = mut TokStore.listPop(ts, work)
			let mode = mut TokStore.listPop(ts, work)
			let base = mut TokStore.listPop(ts, work)
			let node = mut TokStore.listPop(ts, work)
			if mode == 1{
				let ft = mut ? Ty.make(ts, tl, TOK_NONE, extra, base, TOK_NONE)
				? TokStore.listAdd(ts, rec, node)
				? TokStore.listAdd(ts, rec, ft)
				continue
			}
			if node == TOK_NONE{
				continue
			}
			let cur = mut Expr.latest(ts, rec, node)
			if cur == TOK_NONE || Ty.get(ts, tl, cur, TY_STORAGE) != TOK_NONE{
				continue
			}
			let pre = mut Ty.get(ts, tl, cur, TY_MUT)
			let kind = mut TokStore.kind(ts, node)
			let isFl = mut Expr.isFloatBase(ts, base)
			if kind == TT_OPERATOR && (TokStore.textEq(ts, node, "mut") || TokStore.textEq(ts, node, "imut")){
				? TokStore.listAdd(ts, work, TokStore.left(ts, node))
				? TokStore.listAdd(ts, work, base)
				? TokStore.listAdd(ts, work, 0)
				? TokStore.listAdd(ts, work, TOK_NONE)
				let nt1 = mut ? Ty.make(ts, tl, TOK_NONE, pre, base, TOK_NONE)
				? TokStore.listAdd(ts, rec, node)
				? TokStore.listAdd(ts, rec, nt1)
				continue
			}
			if kind == TT_DELINEATOR && TokStore.textEq(ts, node, "(") && TokStore.childs(ts, node) != TOK_NONE && TokStore.listSize(ts, TokStore.childs(ts, node)) == 1{
				? TokStore.listAdd(ts, work, TokStore.listGet(ts, TokStore.childs(ts, node), 0))
				? TokStore.listAdd(ts, work, base)
				? TokStore.listAdd(ts, work, 0)
				? TokStore.listAdd(ts, work, TOK_NONE)
				let nt2 = mut ? Ty.make(ts, tl, TOK_NONE, pre, base, TOK_NONE)
				? TokStore.listAdd(ts, rec, node)
				? TokStore.listAdd(ts, rec, nt2)
				continue
			}
			if kind == TT_OPERATOR && TokStore.textEq(ts, node, "-") && TokStore.unary(ts, node) != 0{
				let nt3 = mut ? Ty.make(ts, tl, TOK_NONE, pre, base, TOK_NONE)
				? TokStore.listAdd(ts, rec, node)
				? TokStore.listAdd(ts, rec, nt3)
				let lf = mut TokStore.left(ts, node)
				if lf != TOK_NONE{
					let lcur = mut Expr.latest(ts, rec, lf)
					if lcur != TOK_NONE{
						let inner = mut Ty.get(ts, tl, lcur, TY_MUT)
						if isFl{
							? TokStore.listAdd(ts, work, lf)
							? TokStore.listAdd(ts, work, base)
							? TokStore.listAdd(ts, work, 1)
							? TokStore.listAdd(ts, work, inner)
							? TokStore.listAdd(ts, work, lf)
							? TokStore.listAdd(ts, work, base)
							? TokStore.listAdd(ts, work, 0)
							? TokStore.listAdd(ts, work, TOK_NONE)
						} else {
							let ub = mut ? Expr.unsignedOf(ts, base)
							let nt4 = mut ? Ty.make(ts, tl, TOK_NONE, inner, ub, TOK_NONE)
							? TokStore.listAdd(ts, rec, lf)
							? TokStore.listAdd(ts, rec, nt4)
						}
					}
				}
				continue
			}
			if kind == TT_INTEGER || kind == TT_FLOAT{
				let nt5 = mut ? Ty.make(ts, tl, TOK_NONE, pre, base, TOK_NONE)
				? TokStore.listAdd(ts, rec, node)
				? TokStore.listAdd(ts, rec, nt5)
			}
			if isFl && kind == TT_OPERATOR && TokStore.unary(ts, node) == 0 && TokStore.left(ts, node) != TOK_NONE && TokStore.right(ts, node) != TOK_NONE && (TokStore.textEq(ts, node, "+") || TokStore.textEq(ts, node, "-") || TokStore.textEq(ts, node, "*") || TokStore.textEq(ts, node, "/")){
				let nt6 = mut ? Ty.make(ts, tl, TOK_NONE, pre, base, TOK_NONE)
				? TokStore.listAdd(ts, rec, node)
				? TokStore.listAdd(ts, rec, nt6)
				? TokStore.listAdd(ts, work, TokStore.right(ts, node))
				? TokStore.listAdd(ts, work, base)
				? TokStore.listAdd(ts, work, 0)
				? TokStore.listAdd(ts, work, TOK_NONE)
				? TokStore.listAdd(ts, work, TokStore.left(ts, node))
				? TokStore.listAdd(ts, work, base)
				? TokStore.listAdd(ts, work, 0)
				? TokStore.listAdd(ts, work, TOK_NONE)
			}
			if kind == TT_DELINEATOR && TokStore.textEq(ts, node, "[") && Expr.openIx(ts, base) > 0 && TokStore.childs(ts, node) != TOK_NONE && TokStore.listSize(ts, TokStore.childs(ts, node)) > 0{
				let bl = mut TokStore.strLen(ts, base)
				let lastOpen = mut 0
				for bi in 0..bl{
					if TokStore.strCh(ts, base, bi) == '['{
						lastOpen = bi
					}
				}
				let elem = mut ? Ty.subStr(ts, base, 0, lastOpen)
				let els = mut ? TokStore.newList(ts)
				let ne = mut Expr.collectArgs(ts, node, els)
				let ei = mut ne
				for lp2 in 0..1000000000{
					if ei == 0{
						break
					}
					ei = ei - 1
					? TokStore.listAdd(ts, work, TokStore.listGet(ts, els, ei))
					? TokStore.listAdd(ts, work, elem)
					? TokStore.listAdd(ts, work, 0)
					? TokStore.listAdd(ts, work, TOK_NONE)
				}
				let nt7 = mut ? Ty.make(ts, tl, TOK_NONE, pre, base, TOK_NONE)
				? TokStore.listAdd(ts, rec, node)
				? TokStore.listAdd(ts, rec, nt7)
			}
		}
	}

	/** Retags every literal argument of `node` (a CALL) that adapts to its parameter type in `pt` (Java retagLiteralArgs / acceptsAdaptingLiteral). */
	@throws
	static func retagParams(ts: ref mut TokStore, tl: mut u64, lim: mut u64, rec: mut u64, node: mut u64, pt: mut u64, atypes: mut u64) void{
		?catch(e){ throw e }
		if rec == TOK_NONE{
			return
		}
		let args = mut ? TokStore.newList(ts)
		let na = mut Expr.collectArgs(ts, TokStore.right(ts, node), args)
		let np = mut TokStore.listSize(ts, pt)
		for i in 0..na{
			if i >= np{
				break
			}
			let a = mut TokStore.listGet(ts, atypes, i)
			let isLit = mut (Ty.get(ts, tl, a, TY_LITVAL) != TOK_NONE || Ty.get(ts, tl, a, TY_LIT_ELEMS) != TOK_NONE || Ty.get(ts, tl, a, TY_FLOAT_LIT) != 0)
			if isLit{
				let p = mut TokStore.listGet(ts, pt, i)
				let ad = mut ? Expr.literalAdapts(ts, tl, lim, p, a)
				if ad{
					? Expr.adapt(ts, tl, rec, TokStore.listGet(ts, args, i), Ty.get(ts, tl, p, TY_BASE))
				}
			}
		}
	}

	/** retagParams for the overload row picked by pickFromList (chosen holds its row id, or is empty). */
	@throws
	static func retagChosen(ts: ref mut TokStore, tl: mut u64, lim: mut u64, cx: mut u64, rec: mut u64, node: mut u64, chosen: mut u64, atypes: mut u64) void{
		?catch(e){ throw e }
		if TokStore.listSize(ts, chosen) == 0{
			return
		}
		let fl = mut TokStore.listGet(ts, cx, 7)
		let pt = mut Infos.fget(ts, fl, TokStore.listGet(ts, chosen, 0), FI_PARAM_TYPES)
		? Expr.retagParams(ts, tl, lim, rec, node, pt, atypes)
	}

	/** Java acceptsAdaptingLiteral's retag: when `actual` is a literal type that adapts to `expected`, retags the expression `expr`. */
	@pub
	@throws
	static func acceptAdapt(ts: ref mut TokStore, tl: mut u64, lim: mut u64, rec: mut u64, expr: mut u64, expected: mut u64, actual: mut u64) void{
		?catch(e){ throw e }
		if rec == TOK_NONE || expr == TOK_NONE || expected == TOK_NONE || actual == TOK_NONE{
			return
		}
		let isLit = mut (Ty.get(ts, tl, actual, TY_LITVAL) != TOK_NONE || Ty.get(ts, tl, actual, TY_LIT_ELEMS) != TOK_NONE || Ty.get(ts, tl, actual, TY_FLOAT_LIT) != 0 || Ty.get(ts, tl, actual, TY_FLOAT_ARR_LIT) != 0)
		if isLit{
			let ad = mut ? Expr.literalAdapts(ts, tl, lim, expected, actual)
			if ad{
				? Expr.adapt(ts, tl, rec, expr, Ty.get(ts, tl, expected, TY_BASE))
			}
		}
	}

	/** bitsTail's literal adaptation: the literal argument takes the other argument's integer type when its value fits. */
	@throws
	static func bitsRetag(ts: ref mut TokStore, tl: mut u64, lim: mut u64, rec: mut u64, node: mut u64, l: mut u64, r: mut u64) void{
		?catch(e){ throw e }
		if rec == TOK_NONE{
			return
		}
		let lb = mut Ty.get(ts, tl, l, TY_BASE)
		let rb = mut Ty.get(ts, tl, r, TY_BASE)
		if TokStore.strsEq(ts, lb, rb){
			return
		}
		let args = mut ? TokStore.newList(ts)
		let na = mut Expr.collectArgs(ts, TokStore.right(ts, node), args)
		if na != 2{
			return
		}
		let lv = mut Ty.get(ts, tl, l, TY_LITVAL)
		let rv = mut Ty.get(ts, tl, r, TY_LITVAL)
		if rv != TOK_NONE && Expr.literalFits(ts, lim, rv, lb){
			? Expr.adapt(ts, tl, rec, TokStore.listGet(ts, args, 1), lb)
		} else if lv != TOK_NONE && Expr.literalFits(ts, lim, lv, rb){
			? Expr.adapt(ts, tl, rec, TokStore.listGet(ts, args, 0), rb)
		}
	}

	/** Java TypeChecker.unifyLiteralOperands: retags the literal side of a binary operator that adapts to the other side's type. */
	@throws
	static func unifyRetag(ts: ref mut TokStore, tl: mut u64, lim: mut u64, rec: mut u64, node: mut u64, l: mut u64, r: mut u64) void{
		?catch(e){ throw e }
		if rec == TOK_NONE || r == TOK_NONE || l == TOK_NONE{
			return
		}
		let lLit = mut (Ty.get(ts, tl, l, TY_LITVAL) != TOK_NONE || Ty.get(ts, tl, l, TY_FLOAT_LIT) != 0)
		let rLit = mut (Ty.get(ts, tl, r, TY_LITVAL) != TOK_NONE || Ty.get(ts, tl, r, TY_FLOAT_LIT) != 0)
		if rLit && lLit == false{
			let ra = mut ? Ty.withMutability(ts, tl, r, Ty.get(ts, tl, l, TY_MUT))
			let adR = mut ? Expr.literalAdapts(ts, tl, lim, l, ra)
			if adR{
				? Expr.adapt(ts, tl, rec, TokStore.right(ts, node), Ty.get(ts, tl, l, TY_BASE))
			}
		} else if lLit && rLit == false{
			let la = mut ? Ty.withMutability(ts, tl, l, Ty.get(ts, tl, r, TY_MUT))
			let adL = mut ? Expr.literalAdapts(ts, tl, lim, r, la)
			if adL{
				? Expr.adapt(ts, tl, rec, TokStore.left(ts, node), Ty.get(ts, tl, r, TY_BASE))
			}
		}
	}

	/** bits_* result: an integer type, the literal operand adapting to the other side when its value fits; TOK_NONE = not covered / error. rty = TOK_NONE for bits_not. */
	@throws
	static func bitsResult(ts: ref mut TokStore, tl: mut u64, lim: mut u64, k: mut u64, l: mut u64, r: mut u64) mut u64{
		?catch(e){ throw e }
		let lb = mut Ty.get(ts, tl, l, TY_BASE)
		if Expr.isIntBase(ts, lb) == false{
			return TOK_NONE
		}
		if r == TOK_NONE{
			let t1 = mut ? Expr.litTy(ts, tl, TOK_NONE, TokStore.listGet(ts, k, XK_IND), lb)
			return t1
		}
		let rb = mut Ty.get(ts, tl, r, TY_BASE)
		if Expr.isIntBase(ts, rb) == false{
			return TOK_NONE
		}
		if TokStore.strsEq(ts, lb, rb) == false{
			let lv = mut Ty.get(ts, tl, l, TY_LITVAL)
			let rv = mut Ty.get(ts, tl, r, TY_LITVAL)
			if rv != TOK_NONE && Expr.literalFits(ts, lim, rv, lb){
				rb = lb
			} else if lv != TOK_NONE && Expr.literalFits(ts, lim, lv, rb){
				lb = rb
			} else {
				return TOK_NONE
			}
		}
		let t2 = mut ? Expr.litTy(ts, tl, TOK_NONE, TokStore.listGet(ts, k, XK_IND), lb)
		return t2
	}

	/** Comparison: both sides one type after the literal adapts (or null against a pointer for ==/!=); bool. TOK_NONE = error / not covered. */
	@throws
	static func cmpResult(ts: ref mut TokStore, tl: mut u64, lim: mut u64, k: mut u64, isEq: mut bool, l: mut u64, r: mut u64) mut u64{
		?catch(e){ throw e }
		let lb = mut Ty.get(ts, tl, l, TY_BASE)
		let rb = mut Ty.get(ts, tl, r, TY_BASE)
		let lLit = mut (Ty.get(ts, tl, l, TY_LITVAL) != TOK_NONE || Ty.get(ts, tl, l, TY_FLOAT_LIT) != 0)
		let rLit = mut (Ty.get(ts, tl, r, TY_LITVAL) != TOK_NONE || Ty.get(ts, tl, r, TY_FLOAT_LIT) != 0)
		let same = mut false
		if rLit && lLit == false{
			let ra = mut ? Ty.withMutability(ts, tl, r, Ty.get(ts, tl, l, TY_MUT))
			let adR = mut ? Expr.literalAdapts(ts, tl, lim, l, ra)
			if adR{
				same = true
			}
		} else if lLit && rLit == false{
			let la = mut ? Ty.withMutability(ts, tl, l, Ty.get(ts, tl, r, TY_MUT))
			let adL = mut ? Expr.literalAdapts(ts, tl, lim, r, la)
			if adL{
				same = true
			}
		}
		if same == false{
			same = Ty.sameBaseType(ts, tl, l, r)
		}
		let nullPtr = mut false
		if isEq{
			if TokStore.strEq(ts, rb, "null") && Ty.get(ts, tl, l, TY_STORAGE) != TOK_NONE{
				nullPtr = true
			}
			if TokStore.strEq(ts, lb, "null") && Ty.get(ts, tl, r, TY_STORAGE) != TOK_NONE{
				nullPtr = true
			}
		}
		if same == false && nullPtr == false{
			return TOK_NONE
		}
		let t = mut ? Expr.litTy(ts, tl, TOK_NONE, TokStore.listGet(ts, k, XK_IND), TokStore.listGet(ts, k, XK_BOOL))
		return t
	}

	/** `x as T` for a plain integer widening target or f32 as f64 (no alias involved); TOK_NONE = not covered. */
	@throws
	static func asResult(ts: ref mut TokStore, tl: mut u64, w: mut u64, k: mut u64, l: mut u64, target: mut u64) mut u64{
		?catch(e){ throw e }
		if Ty.get(ts, tl, l, TY_ALIAS) != TOK_NONE || StrMap.has(ts, World.get(ts, w, W_M_ALIAS_RAW_TARGETS), target){
			return TOK_NONE
		}
		let lb = mut Ty.get(ts, tl, l, TY_BASE)
		if TokStore.strEq(ts, target, "f64") && TokStore.strEq(ts, lb, "f32") && Ty.get(ts, tl, l, TY_STORAGE) == TOK_NONE{
			if Ty.get(ts, tl, l, TY_FLOAT_LIT) != 0{
				return TOK_NONE
			}
			let f1 = mut ? Ty.make(ts, tl, TOK_NONE, Ty.get(ts, tl, l, TY_MUT), target, TOK_NONE)
			return f1
		}
		if Expr.isIntBase(ts, lb) == false || Expr.isIntBase(ts, target) == false{
			return TOK_NONE
		}
		let r1 = mut ? Ty.make(ts, tl, Ty.get(ts, tl, l, TY_STORAGE), Ty.get(ts, tl, l, TY_MUT), target, TOK_NONE)
		return r1
	}

	/** Number of comma-separated arguments inside the `(` token of a call. */
	static func countArgs(ts: ref mut TokStore, args: mut u64) mut u64{
		?catch(e){ return 0 }
		if args == TOK_NONE{
			return 0
		}
		let cs = mut TokStore.childs(ts, args)
		if cs == TOK_NONE || TokStore.listSize(ts, cs) == 0{
			return 0
		}
		let work = mut ? TokStore.newList(ts)
		? TokStore.listAdd(ts, work, TokStore.listGet(ts, cs, 0))
		let cnt = mut 0
		for lp in 0..1000000000{
			if TokStore.listSize(ts, work) == 0{
				break
			}
			let a = mut TokStore.listPop(ts, work)
			if TokStore.kind(ts, a) == TT_OPERATOR && TokStore.textEq(ts, a, ",") && TokStore.unary(ts, a) == 0{
				? TokStore.listAdd(ts, work, TokStore.right(ts, a))
				? TokStore.listAdd(ts, work, TokStore.left(ts, a))
			} else {
				cnt = cnt + 1
			}
		}
		return cnt
	}

	/** Result type of a call to a plain function name that has exactly one overload of the right arity; TOK_NONE otherwise (not covered / error). */
	@throws
	static func callResult(ts: ref mut TokStore, tl: mut u64, w: mut u64, cx: mut u64, node: mut u64) mut u64{
		?catch(e){ throw e }
		if cx == TOK_NONE{
			return TOK_NONE
		}
		let nm = mut TokStore.left(ts, node)
		if nm == TOK_NONE || TokStore.kind(ts, nm) != TT_VARREF{
			return TOK_NONE
		}
		let ov = mut StrMap.get(ts, World.get(ts, w, W_M_FUNCS), TokStore.text(ts, nm))
		if ov == TOK_NONE && StrMap.has(ts, World.get(ts, w, W_M_STRUCTS), TokStore.text(ts, nm)){
			let cn = mut ? Ty.prefixed(ts, "__ctor__", TokStore.text(ts, nm), "")
			ov = StrMap.get(ts, World.get(ts, w, W_M_FUNCS), cn)
		}
		if ov == TOK_NONE{
			return TOK_NONE
		}
		let argc = mut Expr.countArgs(ts, TokStore.right(ts, node))
		let fl = mut TokStore.listGet(ts, cx, 7)
		let found = mut TOK_NONE
		let cnt = mut 0
		let n = mut TokStore.listSize(ts, ov)
		for j in 0..n{
			let fi = mut TokStore.listGet(ts, ov, j)
			if TokStore.listSize(ts, Infos.fget(ts, fl, fi, FI_PARAM_TYPES)) == argc{
				cnt = cnt + 1
				found = fi
			}
		}
		if cnt == 0{
			return TOK_NONE
		}
		if cnt > 1{
			return MULTI_CAND
		}
		return Infos.fget(ts, fl, found, FI_RETURN)
	}

	/** TypeChecker.typesCompatible for plain types: 1 compatible, 0 not, 2 = involves a rule not ported (interfaces, ranges, function pointers). */
	@throws
	static func compat(ts: ref mut TokStore, tl: mut u64, lim: mut u64, w: mut u64, expected: mut u64, actual: mut u64) mut u64{
		?catch(e){ throw e }
		let ad = mut ? Expr.literalAdapts(ts, tl, lim, expected, actual)
		if ad{
			return 1
		}
		let eb = mut Ty.get(ts, tl, expected, TY_BASE)
		let ab = mut Ty.get(ts, tl, actual, TY_BASE)
		let es = mut Ty.get(ts, tl, expected, TY_STORAGE)
		if TokStore.strEq(ts, ab, "null") && es != TOK_NONE{
			if Ty.get(ts, tl, expected, TY_SOME) != 0{
				return 0
			}
			return 1
		}
		let rgLit = mut ? TokStore.addLit(ts, "range(")
		if TokStore.strEq(ts, eb, "range") && Decl.startsWith(ts, ab, rgLit) == 1{
			if Expr.mutCompat(ts, Ty.get(ts, tl, expected, TY_MUT), Ty.get(ts, tl, actual, TY_MUT)) == false{
				return 0
			}
			if es == TOK_NONE{
				return 1
			}
			let rs = mut Ty.get(ts, tl, actual, TY_STORAGE)
			if rs == TOK_NONE{
				return 0
			}
			if TokStore.strsEq(ts, es, rs) || TokStore.strEq(ts, es, "raw") || (TokStore.strEq(ts, es, "ref") && TokStore.strEq(ts, rs, "owns")){
				return 1
			}
			return 0
		}
		if TokStore.strEq(ts, eb, "range") || TokStore.strEq(ts, ab, "range") || Decl.startsWith(ts, eb, rgLit) == 1 || Decl.startsWith(ts, ab, rgLit) == 1{
			return 2
		}
		if StrMap.has(ts, World.get(ts, w, W_M_IFACES), eb){
			return 2
		}
		if TokStore.strsEq(ts, eb, ab) == false{
			return 0
		}
		if Ty.get(ts, tl, expected, TY_FP_PARAMS) != TOK_NONE{
			return 2
		}
		let ea = mut Ty.get(ts, tl, expected, TY_ALIAS)
		let aa = mut Ty.get(ts, tl, actual, TY_ALIAS)
		if ea == TOK_NONE && aa != TOK_NONE{
			return 0
		}
		if ea != TOK_NONE && aa == TOK_NONE{
			return 0
		}
		if ea != TOK_NONE && TokStore.strsEq(ts, ea, aa) == false{
			return 0
		}
		if Expr.mutCompat(ts, Ty.get(ts, tl, expected, TY_MUT), Ty.get(ts, tl, actual, TY_MUT)) == false{
			return 0
		}
		if es == TOK_NONE{
			return 1
		}
		let as2 = mut Ty.get(ts, tl, actual, TY_STORAGE)
		if as2 == TOK_NONE{
			return 0
		}
		if Ty.get(ts, tl, expected, TY_SOME) != 0 && Ty.get(ts, tl, actual, TY_SOME) == 0{
			return 0
		}
		if TokStore.strsEq(ts, es, as2){
			return 1
		}
		if TokStore.strEq(ts, es, "raw"){
			return 1
		}
		if TokStore.strEq(ts, es, "ref") && TokStore.strEq(ts, as2, "owns"){
			return 1
		}
		return 0
	}

	/** Picks the overload (same arity) the argument types select, as callTail does; its return type, or TOK_NONE when unsure / no match. */
	@throws
	static func overloadResult(ts: ref mut TokStore, tl: mut u64, lim: mut u64, w: mut u64, cx: mut u64, node: mut u64, atypes: mut u64, chosen: mut u64) mut u64{
		?catch(e){ throw e }
		let nm = mut TokStore.left(ts, node)
		let ov = mut StrMap.get(ts, World.get(ts, w, W_M_FUNCS), TokStore.text(ts, nm))
		if ov == TOK_NONE{
			let cn = mut ? Ty.prefixed(ts, "__ctor__", TokStore.text(ts, nm), "")
			ov = StrMap.get(ts, World.get(ts, w, W_M_FUNCS), cn)
		}
		if ov == TOK_NONE{
			return TOK_NONE
		}
		return ? Expr.pickFromList(ts, tl, lim, w, cx, ov, atypes, chosen)
	}

	/** Range bound descriptor (rangeBoundDescriptor); TOK_NONE when the operand is not a plain u64 bare literal/variable. */
	@throws
	static func rangeBound(ts: ref mut TokStore, tl: mut u64, tok: mut u64, ty: mut u64) mut u64{
		?catch(e){ throw e }
		if Ty.get(ts, tl, ty, TY_STORAGE) != TOK_NONE || TokStore.strEq(ts, Ty.get(ts, tl, ty, TY_BASE), "u64") == false{
			return TOK_NONE
		}
		let kd = mut TokStore.kind(ts, tok)
		if kd == TT_INTEGER{
			return TokStore.text(ts, tok)
		}
		if kd == TT_VARREF{
			let us = mut ? TokStore.addLit(ts, "_")
			let sb = mut TokStore.strBegin(ts)
			? TokStore.strAppendId(ts, Ty.get(ts, tl, ty, TY_MUT))
			? TokStore.strAppendId(ts, us)
			? TokStore.strAppendId(ts, TokStore.text(ts, tok))
			let id = mut ? TokStore.strEnd(ts, sb)
			return id
		}
		return TOK_NONE
	}

	/** Method call `recv.name(args)`: candidates of the receiver's impls (one impl only), then the same selection as a plain call; TOK_NONE when unsure. */
	@throws
	static func methodResult(ts: ref mut TokStore, tl: mut u64, lim: mut u64, w: mut u64, cx: mut u64, node: mut u64, recv: mut u64, atypes: mut u64, chosen: mut u64) mut u64{
		?catch(e){ throw e }
		let isStat = mut 0
		let base = mut TOK_NONE
		if recv == TOK_NONE{
			isStat = 1
			base = TokStore.text(ts, TokStore.left(ts, TokStore.left(ts, node)))
		} else {
			base = Ty.get(ts, tl, recv, TY_BASE)
		}
		if StrMap.has(ts, World.get(ts, w, W_M_IFACES), base){
			return TOK_NONE
		}
		let impls = mut StrMap.get(ts, World.get(ts, w, W_M_IMPLS_BY_TYPE), base)
		if impls == TOK_NONE{
			return TOK_NONE
		}
		let mr = mut TokStore.listGet(ts, cx, 14)
		let mname = mut TokStore.text(ts, TokStore.right(ts, TokStore.left(ts, node)))
		let all = mut ? TokStore.newList(ts)
		let usedImpls = mut 0
		let ni = mut TokStore.listSize(ts, impls)
		for q in 0..ni{
			let im = mut TokStore.listGet(ts, impls, q)
			let cl = mut ? ImplColl.candidates(ts, mr, im, mname, isStat)
			if TokStore.listSize(ts, cl) > 0{
				usedImpls = usedImpls + 1
				? TokStore.listAddAll(ts, all, cl)
			}
		}
		if usedImpls != 1{
			return TOK_NONE
		}
		return ? Expr.pickFromList(ts, tl, lim, w, cx, all, atypes, chosen)
	}

	/** Selection among overload rows `ov` for argument types `atypes` (see overloadResult). */
	@throws
	static func pickFromList(ts: ref mut TokStore, tl: mut u64, lim: mut u64, w: mut u64, cx: mut u64, ov: mut u64, atypes: mut u64, chosen: mut u64) mut u64{
		?catch(e){ throw e }
		let fl = mut TokStore.listGet(ts, cx, 7)
		let argc = mut TokStore.listSize(ts, atypes)
		let exact = mut ? TokStore.newList(ts)
		let rest = mut ? TokStore.newList(ts)
		let n = mut TokStore.listSize(ts, ov)
		for j in 0..n{
			let fi = mut TokStore.listGet(ts, ov, j)
			let pt = mut Infos.fget(ts, fl, fi, FI_PARAM_TYPES)
			if TokStore.listSize(ts, pt) != argc{
				continue
			}
			let needs = mut false
			for i in 0..argc{
				let a = mut TokStore.listGet(ts, atypes, i)
				let isLit = mut (Ty.get(ts, tl, a, TY_LITVAL) != TOK_NONE || Ty.get(ts, tl, a, TY_LIT_ELEMS) != TOK_NONE || Ty.get(ts, tl, a, TY_FLOAT_LIT) != 0)
				if isLit && TokStore.strsEq(ts, Ty.get(ts, tl, TokStore.listGet(ts, pt, i), TY_BASE), Ty.get(ts, tl, a, TY_BASE)) == false{
					needs = true
				}
			}
			if needs{
				? TokStore.listAdd(ts, rest, fi)
			} else {
				? TokStore.listAdd(ts, exact, fi)
			}
		}
		? TokStore.listAddAll(ts, exact, rest)
		let ne = mut TokStore.listSize(ts, exact)
		for j in 0..ne{
			let fi = mut TokStore.listGet(ts, exact, j)
			let pt = mut Infos.fget(ts, fl, fi, FI_PARAM_TYPES)
			let allOk = mut true
			for i in 0..argc{
				let pty = mut TokStore.listGet(ts, pt, i)
				let aty = mut TokStore.listGet(ts, atypes, i)
				let c = mut ? Expr.compat(ts, tl, lim, w, pty, aty)
				if c == 2{
					return TOK_NONE
				}
				if c == 0{
					allOk = false
					if Ty.get(ts, tl, pty, TY_SOME) != 0 && Ty.get(ts, tl, aty, TY_SOME) == 0{
						let aty2 = mut ? Ty.withSome(ts, tl, aty, 1)
						let c2 = mut ? Expr.compat(ts, tl, lim, w, pty, aty2)
						if c2 != 0{
							return TOK_NONE
						}
					}
				}
			}
			if allOk{
				? TokStore.listAdd(ts, chosen, fi)
				return Infos.fget(ts, fl, fi, FI_RETURN)
			}
		}
		return TOK_NONE
	}

	/** Arithmetic on two plain numeric operands of one base type, after the literal operand adapts to the other side (arithmeticType); TOK_NONE otherwise. */
	@throws
	static func arithResult(ts: ref mut TokStore, tl: mut u64, lim: mut u64, k: mut u64, opk: mut u64, l: mut u64, r: mut u64) mut u64{
		?catch(e){ throw e }
		let lRaw = mut false
		let rRaw = mut false
		if Ty.get(ts, tl, l, TY_STORAGE) != TOK_NONE && TokStore.strEq(ts, Ty.get(ts, tl, l, TY_STORAGE), "raw") && Ty.get(ts, tl, l, TY_FP_PARAMS) == TOK_NONE{
			lRaw = true
		}
		if Ty.get(ts, tl, r, TY_STORAGE) != TOK_NONE && TokStore.strEq(ts, Ty.get(ts, tl, r, TY_STORAGE), "raw") && Ty.get(ts, tl, r, TY_FP_PARAMS) == TOK_NONE{
			rRaw = true
		}
		if (lRaw || rRaw) && opk < 2{
			if lRaw && rRaw{
				if opk != 1 || TokStore.strsEq(ts, Ty.get(ts, tl, l, TY_BASE), Ty.get(ts, tl, r, TY_BASE)) == false{
					return TOK_NONE
				}
				let d1 = mut ? Expr.litTy(ts, tl, TOK_NONE, TokStore.listGet(ts, k, XK_IND), TokStore.listGet(ts, k, XK_S64))
				return d1
			}
			let ptr = mut l
			let oth = mut r
			if rRaw{
				if opk == 1{
					return TOK_NONE
				}
				ptr = r
				oth = l
			}
			let ob = mut Ty.get(ts, tl, oth, TY_BASE)
			if TokStore.strEq(ts, ob, "u64") == false && TokStore.strEq(ts, ob, "s64") == false{
				return TOK_NONE
			}
			let pp = mut Ty.get(ts, tl, ptr, TY_RAW_POINTEE)
			if pp != TOK_NONE{
				let pr1 = mut ? Ty.rawPointer(ts, tl, TokStore.listGet(ts, k, XK_IND), pp)
				return pr1
			}
			let rawSid = mut ? TokStore.addLit(ts, "raw")
			let pr2 = mut ? Expr.litTy(ts, tl, rawSid, TokStore.listGet(ts, k, XK_IND), Ty.get(ts, tl, ptr, TY_BASE))
			return pr2
		}
		if Ty.get(ts, tl, l, TY_STORAGE) != TOK_NONE || Ty.get(ts, tl, r, TY_STORAGE) != TOK_NONE{
			return TOK_NONE
		}
		let lb = mut Ty.get(ts, tl, l, TY_BASE)
		let rb = mut Ty.get(ts, tl, r, TY_BASE)
		let lLit = mut (Ty.get(ts, tl, l, TY_LITVAL) != TOK_NONE || Ty.get(ts, tl, l, TY_FLOAT_LIT) != 0)
		let rLit = mut (Ty.get(ts, tl, r, TY_LITVAL) != TOK_NONE || Ty.get(ts, tl, r, TY_FLOAT_LIT) != 0)
		if Expr.isIntBase(ts, lb) == false && Expr.isFloatBase(ts, lb) == false{
			return TOK_NONE
		}
		if Expr.isIntBase(ts, rb) == false && Expr.isFloatBase(ts, rb) == false{
			return TOK_NONE
		}
		if Ty.get(ts, tl, l, TY_FLOAT_STATES) != TOK_NONE || Ty.get(ts, tl, r, TY_FLOAT_STATES) != TOK_NONE{
			return TOK_NONE
		}
		let bothFloat = mut (Ty.get(ts, tl, l, TY_FLOAT_LIT) != 0 && Ty.get(ts, tl, r, TY_FLOAT_LIT) != 0)
		let base = mut lb
		if rLit && lLit == false{
			let ra = mut ? Ty.withMutability(ts, tl, r, Ty.get(ts, tl, l, TY_MUT))
			let adR = mut ? Expr.literalAdapts(ts, tl, lim, l, ra)
			if adR{
				rb = lb
			}
		} else if lLit && rLit == false{
			let la = mut ? Ty.withMutability(ts, tl, l, Ty.get(ts, tl, r, TY_MUT))
			let adL = mut ? Expr.literalAdapts(ts, tl, lim, r, la)
			if adL{
				lb = rb
				base = rb
			}
		}
		if TokStore.strsEq(ts, lb, rb) == false{
			return TOK_NONE
		}
		let t = mut ? Expr.litTy(ts, tl, TOK_NONE, TokStore.listGet(ts, k, XK_IND), base)
		if bothFloat{
			Ty.set(ts, tl, t, TY_FLOAT_LIT, 1)
		}
		return t
	}

	/** `mut`/`imut`, unary minus and `atomic` applied to an already-typed operand; TOK_NONE = unsupported or an error case. */
	@throws
	static func unaryResult(ts: ref mut TokStore, tl: mut u64, k: mut u64, node: mut u64, operand: mut u64) mut u64{
		?catch(e){ throw e }
		if TokStore.textEq(ts, node, "mut") || TokStore.textEq(ts, node, "imut"){
			let target = mut TokStore.listGet(ts, k, XK_MUT)
			if TokStore.textEq(ts, node, "imut"){
				target = TokStore.listGet(ts, k, XK_IMUT)
			}
			let cur = mut Ty.get(ts, tl, operand, TY_MUT)
			if cur != TOK_NONE && TokStore.strEq(ts, cur, "imut") && TokStore.textEq(ts, node, "mut"){
				return TOK_NONE
			}
			let r = mut ? Ty.withMutability(ts, tl, operand, target)
			return r
		}
		if TokStore.textEq(ts, node, "atomic"){
			if Ty.get(ts, tl, operand, TY_STORAGE) != TOK_NONE{
				return TOK_NONE
			}
			let bs = mut Ty.get(ts, tl, operand, TY_BASE)
			if Expr.isIntBase(ts, bs) == false && TokStore.strEq(ts, bs, "bool") == false && TokStore.strEq(ts, bs, "char") == false{
				return TOK_NONE
			}
			let t0 = mut ? Expr.litTy(ts, tl, TOK_NONE, Ty.get(ts, tl, operand, TY_MUT), bs)
			let t1 = mut ? Ty.withAtomic(ts, tl, t0, 1)
			return t1
		}
		// unary minus
		if Ty.get(ts, tl, operand, TY_STORAGE) != TOK_NONE{
			return TOK_NONE
		}
		let bs = mut Ty.get(ts, tl, operand, TY_BASE)
		let isInt = mut Expr.isIntBase(ts, bs)
		if isInt == false && Expr.isFloatBase(ts, bs) == false{
			return TOK_NONE
		}
		if Ty.get(ts, tl, operand, TY_FLOAT_STATES) != TOK_NONE{
			return TOK_NONE
		}
		let rb = mut bs
		if TokStore.strEq(ts, bs, "u64"){
			rb = TokStore.listGet(ts, k, XK_S64)
		}
		if TokStore.strEq(ts, bs, "u32") || TokStore.strEq(ts, bs, "u16") || TokStore.strEq(ts, bs, "u8"){
			return TOK_NONE
		}
		let neg = mut ? Expr.litTy(ts, tl, TOK_NONE, TokStore.listGet(ts, k, XK_IND), rb)
		let lv = mut Ty.get(ts, tl, operand, TY_LITVAL)
		if lv != TOK_NONE && TokStore.strEq(ts, bs, "u64"){
			let nl = mut ? Expr.negText(ts, k, lv)
			Ty.set(ts, tl, neg, TY_LITVAL, nl)
		}
		if Ty.get(ts, tl, operand, TY_FLOAT_LIT) != 0{
			Ty.set(ts, tl, neg, TY_FLOAT_LIT, 1)
		}
		return neg
	}

	/** BigInteger.negate on a decimal text. */
	@throws
	static func negText(ts: ref mut TokStore, k: mut u64, v: mut u64) mut u64{
		?catch(e){ throw e }
		if TokStore.strEq(ts, v, "0"){
			return v
		}
		let sb = mut TokStore.strBegin(ts)
		if TokStore.strCh(ts, v, 0) == '-'{
			let n = mut TokStore.strLen(ts, v)
			for i in 1..n{
				? TokStore.strPush(ts, TokStore.strCh(ts, v, i))
			}
		} else {
			? TokStore.strPush(ts, '-')
			? TokStore.strAppendId(ts, v)
		}
		let id = mut ? TokStore.strEnd(ts, sb)
		return id
	}

	/** The type of an array literal from its element types (list `ets`); TOK_NONE = unsupported or an error case. */
	@throws
	static func arrayResult(ts: ref mut TokStore, tl: mut u64, k: mut u64, ets: mut u64, rec: mut u64, enodes: mut u64) mut u64{
		?catch(e){ throw e }
		let n = mut TokStore.listSize(ts, ets)
		let established = mut TOK_NONE
		let typedInt = mut TOK_NONE
		let allInt = mut true
		let anyNeg = mut false
		for i in 0..n{
			let t = mut TokStore.listGet(ts, ets, i)
			let bs = mut Ty.get(ts, tl, t, TY_BASE)
			if TokStore.strEq(ts, bs, "null"){
				return TOK_NONE
			}
			if Ty.get(ts, tl, t, TY_STORAGE) != TOK_NONE{
				return TOK_NONE
			}
			if established == TOK_NONE{
				established = t
			}
			let lv = mut Ty.get(ts, tl, t, TY_LITVAL)
			if lv == TOK_NONE{
				allInt = false
				if Expr.isIntBase(ts, bs) && typedInt == TOK_NONE{
					typedInt = t
				}
			} else {
				if TokStore.strCh(ts, lv, 0) == '-'{
					anyNeg = true
				}
			}
		}
		if established == TOK_NONE{
			return TOK_NONE
		}
		if typedInt != TOK_NONE{
			let tlim = mut ? Expr.limits(ts)
			let tbase = mut Ty.get(ts, tl, typedInt, TY_BASE)
			let adaptable = mut true
			for i in 0..n{
				let t = mut TokStore.listGet(ts, ets, i)
				let lv = mut Ty.get(ts, tl, t, TY_LITVAL)
				if lv != TOK_NONE && Expr.literalFits(ts, tlim, lv, tbase) == false{
					adaptable = false
				}
			}
			if adaptable{
				for i in 0..n{
					let t = mut TokStore.listGet(ts, ets, i)
					if Ty.get(ts, tl, t, TY_LITVAL) != TOK_NONE{
						if rec != TOK_NONE && TokStore.listSize(ts, enodes) == n{
							? Expr.adapt(ts, tl, rec, TokStore.listGet(ts, enodes, i), tbase)
						}
						let nt = mut ? Ty.make(ts, tl, TOK_NONE, Ty.get(ts, tl, t, TY_MUT), tbase, TOK_NONE)
						TokStore.listSet(ts, ets, i, nt)
					}
				}
				established = typedInt
				allInt = false
			}
		}
		if allInt && anyNeg{
			let lim = mut ? TokStore.addLit(ts, "9223372036854775807")
			let limNeg = mut ? TokStore.addLit(ts, "9223372036854775808")
			for i in 0..n{
				let t = mut TokStore.listGet(ts, ets, i)
				if TokStore.strEq(ts, Ty.get(ts, tl, t, TY_BASE), "s64") == false{
					let lv = mut Ty.get(ts, tl, t, TY_LITVAL)
					if Expr.fitsS64(ts, lv, lim, limNeg){
						if rec != TOK_NONE && TokStore.listSize(ts, enodes) == n{
							? Expr.adapt(ts, tl, rec, TokStore.listGet(ts, enodes, i), TokStore.listGet(ts, k, XK_S64))
						}
						let rt = mut ? Expr.litTy(ts, tl, TOK_NONE, Ty.get(ts, tl, t, TY_MUT), TokStore.listGet(ts, k, XK_S64))
						Ty.set(ts, tl, rt, TY_LITVAL, lv)
						TokStore.listSet(ts, ets, i, rt)
					}
				}
			}
			established = TokStore.listGet(ts, ets, 0)
		}
		let eb = mut Ty.get(ts, tl, established, TY_BASE)
		for i in 0..n{
			let t = mut TokStore.listGet(ts, ets, i)
			if TokStore.strsEq(ts, Ty.get(ts, tl, t, TY_BASE), eb) == false{
				return TOK_NONE
			}
		}
		let arr = mut ? Ty.array(ts, tl, established, n)
		let allLiteral = mut Expr.isIntBase(ts, eb)
		for i in 0..n{
			if Ty.get(ts, tl, TokStore.listGet(ts, ets, i), TY_LITVAL) == TOK_NONE{
				allLiteral = false
			}
		}
		if allLiteral{
			let vl = mut ? TokStore.newList(ts)
			for i in 0..n{
				? TokStore.listAdd(ts, vl, Ty.get(ts, tl, TokStore.listGet(ts, ets, i), TY_LITVAL))
			}
			Ty.set(ts, tl, arr, TY_LIT_ELEMS, vl)
		}
		let bracket = mut false
		let el = mut TokStore.strLen(ts, eb)
		for bi in 1..el{
			if TokStore.strCh(ts, eb, bi) == '['{
				bracket = true
			}
		}
		if allLiteral == false && bracket{
			let nested = mut true
			let flat = mut ? TokStore.newList(ts)
			for i in 0..n{
				let le = mut Ty.get(ts, tl, TokStore.listGet(ts, ets, i), TY_LIT_ELEMS)
				if le == TOK_NONE{
					nested = false
				} else {
					? TokStore.listAddAll(ts, flat, le)
				}
			}
			if nested{
				Ty.set(ts, tl, arr, TY_LIT_ELEMS, flat)
			}
			let nestedF = mut true
			for i in 0..n{
				if Ty.get(ts, tl, TokStore.listGet(ts, ets, i), TY_FLOAT_ARR_LIT) == 0{
					nestedF = false
				}
			}
			if nestedF{
				Ty.set(ts, tl, arr, TY_FLOAT_ARR_LIT, 1)
			}
		}
		let allFloat = mut Expr.isFloatBase(ts, eb)
		for i in 0..n{
			if Ty.get(ts, tl, TokStore.listGet(ts, ets, i), TY_FLOAT_LIT) == 0{
				allFloat = false
			}
		}
		if allFloat{
			Ty.set(ts, tl, arr, TY_FLOAT_ARR_LIT, 1)
		}
		return arr
	}
}
