					let lines = mut TokStore.childs(ts, body)
					let nl = mut TokStore.listSize(ts, lines)
					? TokStore.listAdd(ts, stN, node)
					? TokStore.listAdd(ts, stP, 1000000 + nl)
					for ri in 0..nl{
						let ln = mut TokStore.listGet(ts, lines, nl - 1 - ri)
						let asg = mut TokStore.listGet(ts, TokStore.childs(ts, ln), 0)
						if asg == TOK_NONE || TokStore.kind(ts, asg) != TT_OPERATOR{
