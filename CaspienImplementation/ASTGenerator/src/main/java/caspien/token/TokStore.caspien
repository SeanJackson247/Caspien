import "stdlib/string.caspien"
import "../../../../../../Codegen/src/main/java/caspien/codegen/collections.caspien"
import "../../../../../../LowerOrderGenerator/src/main/java/caspien/lowerorder/Vec.caspien"
import "../util/Txt.caspien"

/**
 * The token arena of the front end after the lexer (port of caspien.token.Token and Decorator).
 * Struct-of-arrays: every Token field is a column indexed by the token's `u64` id, so token links (`left`, `right`, `next`, `chk.catchTry` ...) are plain integers
 * with `TOK_NONE` meaning "none". List-valued fields (`childs`, `sub`, `pinned`, `decorators`, `typeParams`, ...) hold a list id into `lists`; two tokens sharing a
 * list id share the list, exactly like the Java aliasing (`gathered.childs = block.childs`), and edits are in place. A list holds u64 entries: token ids, decorator ids,
 * string ids or flags. String-valued fields are ids into the append-only string pool `strs` (TOK_NONE = null): a "set" appends a new string and repoints the column,
 * so no owned slot is ever overwritten (which would end every borrow of the store, see docs/ASTGeneratorPort.md, "Conventions"). The file name is a string id too.
 * Decorators are rows of the `d*` columns. Generated by scratch tooling, then edited by hand.
 */
const TOK_NONE 18446744073709551615

/** Ids of the strings interned first by `TokStore.make()`, so the parser can create synthesized tokens without creating Strings. */
const STR_LINE 0
const STR_CALL 1
const STR_LOOKUP 2
const STR_TEMPLATE 3
const STR_EMPTY 4
const STR_LPAREN 5
const STR_LET 6

/** Number of bytes before the terminating NUL of a literal. Reads under non-freeing unsafe tags, so callers' proofs survive. */
@pub
func tokLitLength(lit: static imut string) mut u64{
	let:<raw mut u8> lp = null
	unsafe memcopy raw{
		let tmp = mut raw lit
		memcopy(raw lp, mut 8, raw tmp)
	}
	let ln = mut 0
	unsafe memcopy raw loop{
		let scan = mut lp
		loop{
			let b = mut 0
			memcopy(raw b, mut 1, scan)
			if b == mut 0{
				break
			}
			ln = mut (ln + 1)
			scan++
		}
	}
	return ln
}

/** Byte `i` of a literal as a char (the caller keeps `i` below the literal's length). */
@pub
func tokLitByte(lit: static imut string, i: mut u64) mut char{
	let:<raw mut u8> lp = null
	unsafe memcopy raw{
		let tmp = mut raw lit
		memcopy(raw lp, mut 8, raw tmp)
	}
	let q = mut (lp + i)
	let b = mut '\0'
	unsafe memcopy raw{
		memcopy(raw b, mut 1, q)
	}
	return b
}

