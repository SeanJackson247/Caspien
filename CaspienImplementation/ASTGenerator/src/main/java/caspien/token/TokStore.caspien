		let:<owns mut String> none = mut null
		ts.catchParamNameS.setAt(ts.catchParamNameS, id, none)
	}

	/** True when the constructorConcreteName column holds a string for `id`. */
	@pub
	static func hasConstructorConcreteName(ts: ref some imut TokStore, id: mut u64) mut bool{
		let s = mut ts.constructorConcreteNameS.get(ts.constructorConcreteNameS, id)
		match Some(s){ return true }
		return false
	}

	@pub
	static func constructorConcreteNameEq(ts: ref some imut TokStore, id: mut u64, lit: static imut string) mut bool{
		let s = mut ts.constructorConcreteNameS.get(ts.constructorConcreteNameS, id)
		return Txt.eqLit(s, lit)
	}

	@pub
	@throws
	static func constructorConcreteNameCopy(ts: ref some imut TokStore, id: mut u64) owns some mut String{
		?catch(e){ throw e }
		let s = mut ts.constructorConcreteNameS.get(ts.constructorConcreteNameS, id)
		let out = mut ? Txt.copy(s)
		return out
	}

	@pub
	static func setConstructorConcreteName(ts: ref some mut TokStore, id: mut u64, v: owns some mut String) void{
		ts.constructorConcreteNameS.setAt(ts.constructorConcreteNameS, id, v)
	}

