	// ---- creation ----------------------------------------------------------------------------------------------------------

	/** Interns a file name; returns its id through `ts` (the last id is `files.size() - 1`, an existing name is reused). */
	@pub
	@throws
	static func internFile(ts: owns some mut TokStore, name: owns some mut String) owns some mut TokStore{
		?catch(e){ throw e }
		let n = mut ts.files.size(ts.files)
		? ts.files.add(ts.files, name)
		return ts
	}

	/** Appends a token (all fields unset) with the given kind, text and line; its id is the previous `count`. */
	@pub
	@throws
	static func newToken(ts: owns some mut TokStore, kind: mut u64, text: owns some mut String, line: mut u64, fileId: mut u64) owns some mut TokStore{
		?catch(e){ throw e }
		? ts.kind.push(ts.kind, kind)
		? ts.line.push(ts.line, line)
		? ts.fileId.push(ts.fileId, fileId)
		? ts.childs.push(ts.childs, TOK_NONE)
		? ts.sub.push(ts.sub, TOK_NONE)
		? ts.pinned.push(ts.pinned, TOK_NONE)
		? ts.left.push(ts.left, TOK_NONE)
		? ts.right.push(ts.right, TOK_NONE)
		? ts.next.push(ts.next, TOK_NONE)
		? ts.unary.push(ts.unary, 0)
		? ts.isStatic.push(ts.isStatic, 0)
		? ts.isConst.push(ts.isConst, 0)
		? ts.isStaticMethod.push(ts.isStaticMethod, 0)
		? ts.isCaseMatch.push(ts.isCaseMatch, 0)
		? ts.isForMatch.push(ts.isForMatch, 0)
		? ts.isTryBlock.push(ts.isTryBlock, 0)
		? ts.hasBlock.push(ts.hasBlock, 0)
		? ts.fromGenericInstance.push(ts.fromGenericInstance, 0)
		? ts.isConstructorDecl.push(ts.isConstructorDecl, 0)
		? ts.isPubBlockMember.push(ts.isPubBlockMember, 0)
		? ts.staticApproved.push(ts.staticApproved, 0)
		? ts.radix.push(ts.radix, 0)
		? ts.hasEnumValue.push(ts.hasEnumValue, 0)
		? ts.enumValue.push(ts.enumValue, 0)
		? ts.hasRangeStart.push(ts.hasRangeStart, 0)
		? ts.rangeStart.push(ts.rangeStart, 0)
		? ts.hasRangeEnd.push(ts.hasRangeEnd, 0)
		? ts.rangeEnd.push(ts.rangeEnd, 0)
		? ts.typeParams.push(ts.typeParams, TOK_NONE)
		? ts.typeParamBounds.push(ts.typeParamBounds, TOK_NONE)
		? ts.extendsNames.push(ts.extendsNames, TOK_NONE)
		? ts.implementsNames.push(ts.implementsNames, TOK_NONE)
		? ts.unsafeTags.push(ts.unsafeTags, TOK_NONE)
		? ts.assumeVariants.push(ts.assumeVariants, TOK_NONE)
		? ts.decorators.push(ts.decorators, TOK_NONE)
		? ts.genericArgs.push(ts.genericArgs, TOK_NONE)
		? ts.typeBound.push(ts.typeBound, TOK_NONE)
		? ts.chk.push(ts.chk, TOK_NONE)
		? ts.textS.add(ts.textS, text)
		let:<owns mut String> none_literalValue = mut null
		? ts.literalValueS.add(ts.literalValueS, none_literalValue)
		let:<owns mut String> none_forcedLiteralType = mut null
		? ts.forcedLiteralTypeS.add(ts.forcedLiteralTypeS, none_forcedLiteralType)
		let:<owns mut String> none_catchParamName = mut null
		? ts.catchParamNameS.add(ts.catchParamNameS, none_catchParamName)
		let:<owns mut String> none_constructorConcreteName = mut null
		? ts.constructorConcreteNameS.add(ts.constructorConcreteNameS, none_constructorConcreteName)
		let:<owns mut String> none_asmBlockText = mut null
		? ts.asmBlockTextS.add(ts.asmBlockTextS, none_asmBlockText)
		let:<owns mut String> none_asmFilePath = mut null
		? ts.asmFilePathS.add(ts.asmFilePathS, none_asmFilePath)
		ts.count = ts.count + 1
		return ts
	}

	// ---- lists (u64 ids, shared by id) -------------------------------------------------------------------------------------

	/** Creates an empty list; its id is the previous `lists.size()`. */
	@pub
	@throws
	static func newList(ts: owns some mut TokStore) owns some mut TokStore{
		?catch(e){ throw e }
		let v = mut ? Vec.make()
		? ts.lists.add(ts.lists, v)
		return ts
	}

	@pub
	static func listCount(ts: ref some imut TokStore) mut u64{
		return ts.lists.size(ts.lists)
	}

	@pub
	static func listSize(ts: ref some imut TokStore, l: mut u64) mut u64{
		let v = mut ts.lists.get(ts.lists, l)
		match Some(v){ return v.size(v) }
		return 0
	}

	@pub
	static func listGet(ts: ref some imut TokStore, l: mut u64, i: mut u64) mut u64{
		let v = mut ts.lists.get(ts.lists, l)
		match Some(v){ return v.get(v, i) }
		return TOK_NONE
	}

	@pub
	static func listSet(ts: ref some mut TokStore, l: mut u64, i: mut u64, x: mut u64) void{
		let v = mut ts.lists.get(ts.lists, l)
		match Some(v){ v.set(v, i, x) }
	}

	@pub
	@throws
	static func listAdd(ts: ref some mut TokStore, l: mut u64, x: mut u64) void{
		?catch(e){ throw e }
		let v = mut ts.lists.get(ts.lists, l)
		match Some(v){ ? v.push(v, x) }
	}

	@pub
	static func listClear(ts: ref some mut TokStore, l: mut u64) void{
		let v = mut ts.lists.get(ts.lists, l)
		match Some(v){ v.clear(v) }
	}

	/** Java `list.remove(i)`: later entries shift down. */
	@pub
	static func listRemoveAt(ts: ref some mut TokStore, l: mut u64, i: mut u64) void{
		let v = mut ts.lists.get(ts.lists, l)
		match Some(v){
			let n = mut v.size(v)
			if i >= n{
				return
			}
			let lastIdx = mut (n - 1)
			for k in i..lastIdx{
				v.set(v, k, v.get(v, k + 1))
			}
			let dead = mut v.pop(v)
		}
	}

	/** Java `list.add(i, x)`: later entries shift up. */
	@pub
	@throws
	static func listInsert(ts: ref some mut TokStore, l: mut u64, i: mut u64, x: mut u64) void{
		?catch(e){ throw e }
		let n = mut TokStore.listSize(ts, l)
		? TokStore.listAdd(ts, l, x)
		let k = mut n
		for lp1 in 0..1000000000{
			if k <= i{
				break
			}
			TokStore.listSet(ts, l, k, TokStore.listGet(ts, l, k - 1))
			k = k - 1
		}
		TokStore.listSet(ts, l, i, x)
	}

	/** Java `dst.addAll(src)` (also correct when dst == src). */
	@pub
	@throws
	static func listAddAll(ts: ref some mut TokStore, dst: mut u64, src: mut u64) void{
		?catch(e){ throw e }
		let n = mut TokStore.listSize(ts, src)
		for i in 0..n{
			? TokStore.listAdd(ts, dst, TokStore.listGet(ts, src, i))
		}
	}

	/** Java `new ArrayList<>(src)`: a new list with the same entries; returns the store (new id = listCount - 1). */
	@pub
	@throws
	static func listCopy(ts: owns some mut TokStore, src: mut u64) owns some mut TokStore{
		?catch(e){ throw e }
		ts = ? TokStore.newList(ts)
		let dst = mut (TokStore.listCount(ts) - 1)
		? TokStore.listAddAll(ts, dst, src)
		return ts
	}

	/** Index of `x` in the list, or -1 (Java `indexOf`, by id = identity). */
	@pub
	static func listIndexOf(ts: ref some imut TokStore, l: mut u64, x: mut u64) mut s64{
		let n = mut TokStore.listSize(ts, l)
		for i in 0..n{
			if TokStore.listGet(ts, l, i) == x{
				return wrap:<s64>(i)
			}
		}
		return -1
	}
}
