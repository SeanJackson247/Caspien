	// ---- strings ------------------------------------------------------------------------------------------------------------
	// Every function takes the store as a nullable borrow and proves it itself: a call that grows a column or creates a String ends every proof about
	// the store, so callers never hold a proof across store calls (docs/ASTGeneratorPort.md, "Conventions").

	/** Offset where the next appended text will start (call before appending to `ts.sbuf`). */
	@pub
	static func strBegin(ts: ref mut TokStore) mut u64{
		match Some(ts){ return ts.sbuf.length(ts.sbuf) }
		return 0
	}

	/** Records the text appended to `ts.sbuf` since `start` as a new string; returns its id. */
	@pub
	@throws
	static func strEnd(ts: ref mut TokStore, start: mut u64) mut u64{
		?catch(e){ throw e }
		let id = mut 0
		let len = mut 0
		match Some(ts){
			id = ts.sstart.size(ts.sstart)
			len = ts.sbuf.length(ts.sbuf) - start
		}
		match Some(ts){ ? ts.sstart.push(ts.sstart, start) }
		match Some(ts){ ? ts.slen.push(ts.slen, len) }
		return id
	}

	/** Adds a copy of `s` to the pool and returns its id (`s` itself is only borrowed). */
	@pub
	@throws
	static func addStr(ts: ref mut TokStore, s: ref imut String) mut u64{
		?catch(e){ throw e }
		let start = mut TokStore.strBegin(ts)
		match Some(ts){
			match Some(s){ ? ts.sbuf.append(ts.sbuf, s) }
		}
		let id = mut ? TokStore.strEnd(ts, start)
		return id
	}

	@pub
	@throws
	static func addLit(ts: ref mut TokStore, lit: static imut string) mut u64{
		?catch(e){ throw e }
		let start = mut TokStore.strBegin(ts)
		match Some(ts){ ? ts.sbuf.append(ts.sbuf, lit) }
		let id = mut ? TokStore.strEnd(ts, start)
		return id
	}

	/** Appends one byte to the string being built (between strBegin and strEnd). */
	@pub
	@throws
	static func strPush(ts: ref mut TokStore, c: mut char) void{
		?catch(e){ throw e }
		match Some(ts){ ? ts.sbuf.appendChar(ts.sbuf, c) }
	}

	/** Appends the bytes of string `sid` to the string being built. */
	@pub
	@throws
	static func strAppendId(ts: ref mut TokStore, sid: mut u64) void{
		?catch(e){ throw e }
		let n = mut TokStore.strLen(ts, sid)
		for i in 0..n{
			? TokStore.strPush(ts, TokStore.strCh(ts, sid, i))
		}
	}

	/** True when string `sid` equals `lit` (false for TOK_NONE). */
	@pub
	static func strEq(ts: ref imut TokStore, sid: mut u64, lit: static imut string) mut bool{
		if sid == TOK_NONE{
			return false
		}
		let n = mut tokLitLength(lit)
		if TokStore.strLen(ts, sid) != n{
			return false
		}
		for i in 0..n{
			if TokStore.strCh(ts, sid, i) != tokLitByte(lit, i){
				return false
			}
		}
		return true
	}

	/** True when strings `a` and `b` are both set and equal. */
	@pub
	static func strsEq(ts: ref imut TokStore, a: mut u64, b: mut u64) mut bool{
		if a == TOK_NONE || b == TOK_NONE{
			return false
		}
		let n = mut TokStore.strLen(ts, a)
		if TokStore.strLen(ts, b) != n{
			return false
		}
		for i in 0..n{
			if TokStore.strCh(ts, a, i) != TokStore.strCh(ts, b, i){
				return false
			}
		}
		return true
	}

	@pub
	static func strLen(ts: ref imut TokStore, sid: mut u64) mut u64{
		if sid == TOK_NONE{
			return 0
		}
		match Some(ts){ return ts.slen.get(ts.slen, sid) }
		return 0
	}

	@pub
	static func strCh(ts: ref imut TokStore, sid: mut u64, i: mut u64) mut char{
		if sid == TOK_NONE{
			return '\0'
		}
		match Some(ts){
			if i < ts.slen.get(ts.slen, sid){
				return ts.sbuf.charAt(ts.sbuf, ts.sstart.get(ts.sstart, sid) + i)
			}
		}
		return '\0'
	}

	/** A fresh owned copy of string `sid` (empty for TOK_NONE). */
	@pub
	@throws
	static func strCopy(ts: ref imut TokStore, sid: mut u64) owns some mut String{
		?catch(e){ throw e }
		let out = mut ? new String()
		let n = mut TokStore.strLen(ts, sid)
		for i in 0..n{
			? out.appendChar(out, TokStore.strCh(ts, sid, i))
		}
		return out
	}

	@pub
	static func textEq(ts: ref imut TokStore, id: mut u64, lit: static imut string) mut bool{
		return TokStore.strEq(ts, TokStore.text(ts, id), lit)
	}

	@pub
	static func textLen(ts: ref imut TokStore, id: mut u64) mut u64{
		return TokStore.strLen(ts, TokStore.text(ts, id))
	}

	@pub
	static func textCh(ts: ref imut TokStore, id: mut u64, i: mut u64) mut char{
		return TokStore.strCh(ts, TokStore.text(ts, id), i)
	}

	/** True when the texts of tokens `a` and `b` are equal. */
	@pub
	static func textsEq(ts: ref imut TokStore, a: mut u64, b: mut u64) mut bool{
		return TokStore.strsEq(ts, TokStore.text(ts, a), TokStore.text(ts, b))
	}

	/** Replaces the text of token `id` with a new pooled string. */
	@pub
	@throws
	static func replaceText(ts: ref mut TokStore, id: mut u64, s: ref imut String) void{
		?catch(e){ throw e }
		let sid = mut ? TokStore.addStr(ts, s)
		TokStore.setText(ts, id, sid)
	}

	@pub
	@throws
	static func replaceTextLit(ts: ref mut TokStore, id: mut u64, lit: static imut string) void{
		?catch(e){ throw e }
		let sid = mut ? TokStore.addLit(ts, lit)
		TokStore.setText(ts, id, sid)
	}

	/** Interns the file name. */
	@pub
	@throws
	static func internFile(ts: ref mut TokStore, name: ref imut String) mut u64{
		?catch(e){ throw e }
		let sid = mut ? TokStore.addStr(ts, name)
		return sid
	}

	// ---- creation ----------------------------------------------------------------------------------------------------------

	/** Appends a token (all fields unset) with the given kind, text string id, line and file string id; returns its id. */
	@pub
	@throws
	static func newToken(ts: ref mut TokStore, kind: mut u64, textId: mut u64, line: mut u64, fileId: mut u64) mut u64{
		?catch(e){ throw e }
		let id = mut 0
		match Some(ts){
			id = ts.count
		}
		match Some(ts){
			? ts.kind.push(ts.kind, kind)
		}
		match Some(ts){
			? ts.line.push(ts.line, line)
		}
		match Some(ts){
			? ts.fileId.push(ts.fileId, fileId)
		}
		match Some(ts){
			? ts.childs.push(ts.childs, TOK_NONE)
		}
		match Some(ts){
			? ts.sub.push(ts.sub, TOK_NONE)
		}
		match Some(ts){
			? ts.pinned.push(ts.pinned, TOK_NONE)
		}
		match Some(ts){
			? ts.left.push(ts.left, TOK_NONE)
		}
		match Some(ts){
			? ts.right.push(ts.right, TOK_NONE)
		}
		match Some(ts){
			? ts.next.push(ts.next, TOK_NONE)
		}
		match Some(ts){
			? ts.unary.push(ts.unary, 0)
		}
		match Some(ts){
			? ts.isStatic.push(ts.isStatic, 0)
		}
		match Some(ts){
			? ts.isConst.push(ts.isConst, 0)
		}
		match Some(ts){
			? ts.isStaticMethod.push(ts.isStaticMethod, 0)
		}
		match Some(ts){
			? ts.isCaseMatch.push(ts.isCaseMatch, 0)
		}
		match Some(ts){
			? ts.isForMatch.push(ts.isForMatch, 0)
		}
		match Some(ts){
			? ts.isTryBlock.push(ts.isTryBlock, 0)
		}
		match Some(ts){
			? ts.hasBlock.push(ts.hasBlock, 0)
		}
		match Some(ts){
			? ts.fromGenericInstance.push(ts.fromGenericInstance, 0)
		}
		match Some(ts){
			? ts.pendingBounds.push(ts.pendingBounds, TOK_NONE)
		}
		match Some(ts){
			? ts.isConstructorDecl.push(ts.isConstructorDecl, 0)
		}
		match Some(ts){
			? ts.isPubBlockMember.push(ts.isPubBlockMember, 0)
		}
		match Some(ts){
			? ts.staticApproved.push(ts.staticApproved, 0)
		}
		match Some(ts){
			? ts.radix.push(ts.radix, 0)
		}
		match Some(ts){
			? ts.hasEnumValue.push(ts.hasEnumValue, 0)
		}
		match Some(ts){
			? ts.enumValue.push(ts.enumValue, 0)
		}
		match Some(ts){
			? ts.hasRangeStart.push(ts.hasRangeStart, 0)
		}
		match Some(ts){
			? ts.rangeStart.push(ts.rangeStart, 0)
		}
		match Some(ts){
			? ts.hasRangeEnd.push(ts.hasRangeEnd, 0)
		}
		match Some(ts){
			? ts.rangeEnd.push(ts.rangeEnd, 0)
		}
		match Some(ts){
			? ts.typeParams.push(ts.typeParams, TOK_NONE)
		}
		match Some(ts){
			? ts.typeParamBounds.push(ts.typeParamBounds, TOK_NONE)
		}
		match Some(ts){
			? ts.extendsNames.push(ts.extendsNames, TOK_NONE)
		}
		match Some(ts){
			? ts.implementsNames.push(ts.implementsNames, TOK_NONE)
		}
		match Some(ts){
			? ts.unsafeTags.push(ts.unsafeTags, TOK_NONE)
		}
		match Some(ts){
			? ts.assumeVariants.push(ts.assumeVariants, TOK_NONE)
		}
		match Some(ts){
			? ts.decorators.push(ts.decorators, TOK_NONE)
		}
		match Some(ts){
			? ts.genericArgs.push(ts.genericArgs, TOK_NONE)
		}
		match Some(ts){
			? ts.typeBound.push(ts.typeBound, TOK_NONE)
		}
		match Some(ts){
			? ts.chk.push(ts.chk, TOK_NONE)
		}
		match Some(ts){
			? ts.text.push(ts.text, textId)
		}
		match Some(ts){
			? ts.literalValue.push(ts.literalValue, TOK_NONE)
		}
		match Some(ts){
			? ts.forcedLiteralType.push(ts.forcedLiteralType, TOK_NONE)
		}
		match Some(ts){
			? ts.catchParamName.push(ts.catchParamName, TOK_NONE)
		}
		match Some(ts){
			? ts.constructorConcreteName.push(ts.constructorConcreteName, TOK_NONE)
		}
		match Some(ts){
			? ts.asmBlockText.push(ts.asmBlockText, TOK_NONE)
		}
		match Some(ts){
			? ts.asmFilePath.push(ts.asmFilePath, TOK_NONE)
		}
		match Some(ts){
			ts.count = id + 1
		}
		return id
	}

	/** Appends a decorator row (all optional fields unset); returns its id. */
	@pub
	@throws
	static func newDecorator(ts: ref mut TokStore, nameId: mut u64, line: mut u64, fileId: mut u64) mut u64{
		?catch(e){ throw e }
		let id = mut 0
		match Some(ts){
			id = ts.decCount
		}
		match Some(ts){
			? ts.dName.push(ts.dName, nameId)
		}
		match Some(ts){
			? ts.dLine.push(ts.dLine, line)
		}
		match Some(ts){
			? ts.dFile.push(ts.dFile, fileId)
		}
		match Some(ts){
			? ts.dArgs.push(ts.dArgs, TOK_NONE)
		}
		match Some(ts){
			? ts.dArgIsString.push(ts.dArgIsString, TOK_NONE)
		}
		match Some(ts){
			? ts.dLockField.push(ts.dLockField, TOK_NONE)
		}
		match Some(ts){
			? ts.dLockVariants.push(ts.dLockVariants, TOK_NONE)
		}
		match Some(ts){
			? ts.dLockInParams.push(ts.dLockInParams, TOK_NONE)
		}
		match Some(ts){
			? ts.dLockInFields.push(ts.dLockInFields, TOK_NONE)
		}
		match Some(ts){
			? ts.dLockInOperators.push(ts.dLockInOperators, TOK_NONE)
		}
		match Some(ts){
			? ts.dLockInSomeWrapped.push(ts.dLockInSomeWrapped, TOK_NONE)
		}
		match Some(ts){
			? ts.dLifetimeTerms.push(ts.dLifetimeTerms, TOK_NONE)
		}
		match Some(ts){
			? ts.dLifetimeOps.push(ts.dLifetimeOps, TOK_NONE)
		}
		match Some(ts){
			ts.decCount = id + 1
		}
		return id
	}

	// ---- lists (u64 ids, shared by id) -------------------------------------------------------------------------------------

	/** Creates an empty list and returns its id. */
	@pub
	@throws
	static func newList(ts: ref mut TokStore) mut u64{
		?catch(e){ throw e }
		let id = mut 0
		let v = mut ? Vec.make()
		match Some(ts){
			id = ts.lists.size(ts.lists)
			? ts.lists.add(ts.lists, v)
		}
		return id
	}

	@pub
	static func listCount(ts: ref imut TokStore) mut u64{
		match Some(ts){ return ts.lists.size(ts.lists) }
		return 0
	}

	@pub
	static func listSize(ts: ref imut TokStore, l: mut u64) mut u64{
		?catch(e){ return 0 }
		if l == TOK_NONE{
			return 0
		}
		match Some(ts){
			let v = ? ts.lists.getSome(ts.lists, l)
			return v.size(v)
		}
		return 0
	}

	@pub
	static func listGet(ts: ref imut TokStore, l: mut u64, i: mut u64) mut u64{
		?catch(e){ return TOK_NONE }
		if l == TOK_NONE{
			return TOK_NONE
		}
		match Some(ts){
			let v = ? ts.lists.getSome(ts.lists, l)
			return v.get(v, i)
		}
		return TOK_NONE
	}

	@pub
	static func listSet(ts: ref mut TokStore, l: mut u64, i: mut u64, x: mut u64) void{
		?catch(e){ return }
		if l == TOK_NONE{
			return
		}
		match Some(ts){
			let v = ? ts.lists.getSome(ts.lists, l)
			v.set(v, i, x)
		}
	}

	@pub
	@throws
	static func listAdd(ts: ref mut TokStore, l: mut u64, x: mut u64) void{
		?catch(e){ throw e }
		match Some(ts){
			let v = ? ts.lists.getSome(ts.lists, l)
			? v.push(v, x)
		}
	}

	@pub
	static func listClear(ts: ref mut TokStore, l: mut u64) void{
		?catch(e){ return }
		if l == TOK_NONE{
			return
		}
		match Some(ts){
			let v = ? ts.lists.getSome(ts.lists, l)
			v.clear(v)
		}
	}

	/** Removes the last entry and returns it (TOK_NONE when empty). */
	@pub
	static func listPop(ts: ref mut TokStore, l: mut u64) mut u64{
		?catch(e){ return TOK_NONE }
		let n = mut TokStore.listSize(ts, l)
		if n == 0{
			return TOK_NONE
		}
		let x = mut TokStore.listGet(ts, l, n - 1)
		match Some(ts){
			let v = ? ts.lists.getSome(ts.lists, l)
			let dead = mut v.pop(v)
		}
		return x
	}

	/** Java `list.remove(i)`: later entries shift down. */
	@pub
	static func listRemoveAt(ts: ref mut TokStore, l: mut u64, i: mut u64) void{
		let n = mut TokStore.listSize(ts, l)
		if i >= n{
			return
		}
		let lastIdx = mut (n - 1)
		for k in i..lastIdx{
			TokStore.listSet(ts, l, k, TokStore.listGet(ts, l, k + 1))
		}
		let dead = mut TokStore.listPop(ts, l)
	}

	/** Java `list.add(i, x)`: later entries shift up. */
	@pub
	@throws
	static func listInsert(ts: ref mut TokStore, l: mut u64, i: mut u64, x: mut u64) void{
		?catch(e){ throw e }
		let n = mut TokStore.listSize(ts, l)
		? TokStore.listAdd(ts, l, x)
		let k = mut n
		for lp1 in 0..1000000000{
			if k <= i{
				break
			}
			TokStore.listSet(ts, l, k, TokStore.listGet(ts, l, k - 1))
			k = k - 1
		}
		TokStore.listSet(ts, l, i, x)
	}

	/** Java `dst.addAll(src)` (also correct when dst == src). */
	@pub
	@throws
	static func listAddAll(ts: ref mut TokStore, dst: mut u64, src: mut u64) void{
		?catch(e){ throw e }
		let n = mut TokStore.listSize(ts, src)
		for i in 0..n{
			? TokStore.listAdd(ts, dst, TokStore.listGet(ts, src, i))
		}
	}

	/** Java `new ArrayList<>(src)`: a new list with the same entries; returns its id. */
	@pub
	@throws
	static func listCopy(ts: ref mut TokStore, src: mut u64) mut u64{
		?catch(e){ throw e }
		let dst = mut ? TokStore.newList(ts)
		? TokStore.listAddAll(ts, dst, src)
		return dst
	}

	/** Java `list.subList(a, b)` copied into a new list. */
	@pub
	@throws
	static func listSlice(ts: ref mut TokStore, src: mut u64, a: mut u64, b: mut u64) mut u64{
		?catch(e){ throw e }
		let dst = mut ? TokStore.newList(ts)
		for i in a..b{
			? TokStore.listAdd(ts, dst, TokStore.listGet(ts, src, i))
		}
		return dst
	}

	/** Index of `x` in the list, or -1 (Java `indexOf`, by id = identity). */
	@pub
	static func listIndexOf(ts: ref imut TokStore, l: mut u64, x: mut u64) mut s64{
		let n = mut TokStore.listSize(ts, l)
		for i in 0..n{
			if TokStore.listGet(ts, l, i) == x{
				return wrap:<s64>(i)
			}
		}
		return -1
	}
}
