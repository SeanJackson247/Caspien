@pub
impl TokStore{
	/** A store with the standard strings interned (see STR_*). */
	@pub
	@throws
	static func make() owns some mut TokStore{
		?catch(e){ throw e }
		let ts = mut ? new TokStore()
		let a = mut ? TokStore.addLit(ts, "line")
		let b = mut ? TokStore.addLit(ts, "CALL")
		let c = mut ? TokStore.addLit(ts, "LOOKUP")
		let d = mut ? TokStore.addLit(ts, "`...`")
		let e2 = mut ? TokStore.addLit(ts, "")
		let f = mut ? TokStore.addLit(ts, "(")
		let g = mut ? TokStore.addLit(ts, "let")
		return ts
	}

	@pub
	static func kind(ts: ref imut TokStore, id: mut u64) mut u64{
		match Some(ts){
