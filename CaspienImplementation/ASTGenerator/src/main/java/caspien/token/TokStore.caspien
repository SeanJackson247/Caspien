	hasRangeStart: owns some mut Vec
	rangeStart: owns some mut Vec
	hasRangeEnd: owns some mut Vec
	rangeEnd: owns some mut Vec
	typeParams: owns some mut Vec
	typeParamBounds: owns some mut Vec
	extendsNames: owns some mut Vec
	implementsNames: owns some mut Vec
	unsafeTags: owns some mut Vec
	assumeVariants: owns some mut Vec
	decorators: owns some mut Vec
	genericArgs: owns some mut Vec
	typeBound: owns some mut Vec
