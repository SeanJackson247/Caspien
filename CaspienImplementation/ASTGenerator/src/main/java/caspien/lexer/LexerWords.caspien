import "stdlib/string.caspien"
import "../../../../../../LowerOrderGenerator/src/main/java/caspien/lowerorder/Vec.caspien"
import "../util/Txt.caspien"

/** Word and character classes of the lexer (the static sets and helpers of caspien.lexer.Lexer). Text is bytes: a byte >= 0x80 counts as a letter. */
@pub
struct LexWords{@pub{
}}

@pub
impl LexWords{
	/** The byte `v` (0-255) as a char (the inverse of String.charCode). */
	@pub
	static func charOf(v: mut u64) mut char{
		let:<mut u8> b = mut wrap:<u8>(v)
		let:<mut char> c = mut '\0'
		unsafe memcopy raw{
			memcopy(raw c, mut 1, raw b)
		}
		return c
	}

	@pub
	static func isDigit(c: mut char) mut bool{
		return c >= '0' && c <= '9'
	}

	/** Java `Character.isLetterOrDigit(c) || c == '_'` for bytes (non-ASCII bytes are letters). */
	@pub
	static func isWordChar(c: mut char) mut bool{
		if c >= '0' && c <= '9'{ return true }
		if c >= 'a' && c <= 'z'{ return true }
		if c >= 'A' && c <= 'Z'{ return true }
		if c == '_'{ return true }
		if String.charCode(c) >= 128{ return true }
		return false
	}

	/** Java `Character.isLetter(c) || c == '_'`. */
	@pub
	static func isWordStart(c: mut char) mut bool{
		if c >= 'a' && c <= 'z'{ return true }
		if c >= 'A' && c <= 'Z'{ return true }
		if c == '_'{ return true }
		if String.charCode(c) >= 128{ return true }
		return false
	}

	/** 0-15 for a hex digit, 99 otherwise. */
	@pub
	static func digitValue(c: mut char) mut u64{
		if c >= '0' && c <= '9'{ return String.charCode(c) - 48 }
		if c >= 'a' && c <= 'f'{ return String.charCode(c) - 97 + 10 }
		if c >= 'A' && c <= 'F'{ return String.charCode(c) - 65 + 10 }
		return 99
	}

	@pub
	static func isKeyword(t: ref imut String) mut bool{
		if Txt.eqLit(t, "if"){ return true }
		if Txt.eqLit(t, "else"){ return true }
		if Txt.eqLit(t, "elseif"){ return true }
		if Txt.eqLit(t, "elif"){ return true }
		if Txt.eqLit(t, "loop"){ return true }
		if Txt.eqLit(t, "struct"){ return true }
		if Txt.eqLit(t, "enum"){ return true }
		if Txt.eqLit(t, "import"){ return true }
		if Txt.eqLit(t, "func"){ return true }
		if Txt.eqLit(t, "let"){ return true }
		if Txt.eqLit(t, "return"){ return true }
		if Txt.eqLit(t, "break"){ return true }
		if Txt.eqLit(t, "continue"){ return true }
		if Txt.eqLit(t, "interface"){ return true }
		if Txt.eqLit(t, "impl"){ return true }
		if Txt.eqLit(t, "for"){ return true }
		if Txt.eqLit(t, "extends"){ return true }
		if Txt.eqLit(t, "type"){ return true }
		if Txt.eqLit(t, "new"){ return true }
		if Txt.eqLit(t, "match"){ return true }
		if Txt.eqLit(t, "elsematch"){ return true }
		if Txt.eqLit(t, "unsafe"){ return true }
		if Txt.eqLit(t, "safe"){ return true }
		if Txt.eqLit(t, "extern"){ return true }
		if Txt.eqLit(t, "export"){ return true }
		if Txt.eqLit(t, "ASM"){ return true }
		if Txt.eqLit(t, "const"){ return true }
		if Txt.eqLit(t, "par"){ return true }
		if Txt.eqLit(t, "await"){ return true }
		if Txt.eqLit(t, "yield"){ return true }
		if Txt.eqLit(t, "sleep"){ return true }
		if Txt.eqLit(t, "throw"){ return true }
		if Txt.eqLit(t, "assume"){ return true }
		if Txt.eqLit(t, "library"){ return true }
		if Txt.eqLit(t, "atomic"){ return true }
		if Txt.eqLit(t, "try"){ return true }
		if Txt.eqLit(t, "catch"){ return true }
		return false
	}

	@pub
	static func isModifier(t: ref imut String) mut bool{
		if Txt.eqLit(t, "mut"){ return true }
		if Txt.eqLit(t, "imut"){ return true }
		if Txt.eqLit(t, "owns"){ return true }
		if Txt.eqLit(t, "ref"){ return true }
		if Txt.eqLit(t, "raw"){ return true }
		if Txt.eqLit(t, "auto"){ return true }
		if Txt.eqLit(t, "static"){ return true }
		if Txt.eqLit(t, "some"){ return true }
		return false
	}

	/** The words lexed as infix/prefix OPERATORs: as in within into fits is instanceof implements and dup swap. */
	@pub
	static func isOperatorWord(t: ref imut String) mut bool{
		if Txt.eqLit(t, "as"){ return true }
		if Txt.eqLit(t, "in"){ return true }
		if Txt.eqLit(t, "within"){ return true }
		if Txt.eqLit(t, "into"){ return true }
		if Txt.eqLit(t, "fits"){ return true }
		if Txt.eqLit(t, "is"){ return true }
		if Txt.eqLit(t, "instanceof"){ return true }
		if Txt.eqLit(t, "implements"){ return true }
		if Txt.eqLit(t, "and"){ return true }
		if Txt.eqLit(t, "dup"){ return true }
		if Txt.eqLit(t, "swap"){ return true }
		return false
	}

	@pub
	static func isSingleCharOperator(c: mut char) mut bool{
		if c == '&' || c == '|' || c == '+' || c == '-' || c == '/' || c == '%' || c == '*' || c == ','{ return true }
		if c == '.' || c == '<' || c == '>' || c == '!' || c == '=' || c == ':' || c == '@' || c == '?'{ return true }
		return false
	}

	@pub
	static func isDelineator(c: mut char) mut bool{
		return c == '(' || c == ')' || c == '[' || c == ']' || c == '{' || c == '}'
	}

	/** True when `t` (two operator texts joined) is a multi-character operator. */
	@pub
	static func isMultiCharOperator(t: ref imut String) mut bool{
		if Txt.eqLit(t, "&&"){ return true }
		if Txt.eqLit(t, "||"){ return true }
		if Txt.eqLit(t, "++"){ return true }
		if Txt.eqLit(t, "--"){ return true }
		if Txt.eqLit(t, "+="){ return true }
		if Txt.eqLit(t, "-="){ return true }
		if Txt.eqLit(t, "/="){ return true }
		if Txt.eqLit(t, "%="){ return true }
		if Txt.eqLit(t, "*="){ return true }
		if Txt.eqLit(t, "<="){ return true }
		if Txt.eqLit(t, ">="){ return true }
		if Txt.eqLit(t, "=="){ return true }
		if Txt.eqLit(t, "!="){ return true }
		if Txt.eqLit(t, ".."){ return true }
		if Txt.eqLit(t, ":<"){ return true }
		if Txt.eqLit(t, "..."){ return true }
		if Txt.eqLit(t, "=>"){ return true }
		return false
	}

	/** Index 0..19 of a numeric-limit constant name (u8Max, s64Min, f32Max, ...), -1 for any other word. */
	@pub
	static func limitIndex(t: ref imut String) mut s64{
		if Txt.eqLit(t, "u8Max"){ return 0 }
		if Txt.eqLit(t, "u8Min"){ return 1 }
		if Txt.eqLit(t, "u16Max"){ return 2 }
		if Txt.eqLit(t, "u16Min"){ return 3 }
		if Txt.eqLit(t, "u32Max"){ return 4 }
		if Txt.eqLit(t, "u32Min"){ return 5 }
		if Txt.eqLit(t, "u64Max"){ return 6 }
		if Txt.eqLit(t, "u64Min"){ return 7 }
		if Txt.eqLit(t, "s8Max"){ return 8 }
		if Txt.eqLit(t, "s8Min"){ return 9 }
		if Txt.eqLit(t, "s16Max"){ return 10 }
		if Txt.eqLit(t, "s16Min"){ return 11 }
		if Txt.eqLit(t, "s32Max"){ return 12 }
		if Txt.eqLit(t, "s32Min"){ return 13 }
		if Txt.eqLit(t, "s64Max"){ return 14 }
		if Txt.eqLit(t, "s64Min"){ return 15 }
		if Txt.eqLit(t, "f32Max"){ return 16 }
		if Txt.eqLit(t, "f32Min"){ return 17 }
		if Txt.eqLit(t, "f64Max"){ return 18 }
		if Txt.eqLit(t, "f64Min"){ return 19 }
		return -1
	}

	/** The literal text of limit constant `i` (see limitIndex). */
	@pub
	static func limitText(i: mut s64) static imut string{
		if i == 0{ return "255" }
		if i == 1{ return "0" }
		if i == 2{ return "65535" }
		if i == 3{ return "0" }
		if i == 4{ return "4294967295" }
		if i == 5{ return "0" }
		if i == 6{ return "18446744073709551615" }
		if i == 7{ return "0" }
		if i == 8{ return "127" }
		if i == 9{ return "-128" }
		if i == 10{ return "32767" }
		if i == 11{ return "-32768" }
		if i == 12{ return "2147483647" }
		if i == 13{ return "-2147483648" }
		if i == 14{ return "9223372036854775807" }
		if i == 15{ return "-9223372036854775808" }
		if i == 16{ return "340282346638528859811704183484516925440.0" }
		if i == 17{ return "-340282346638528859811704183484516925440.0" }
		if i == 18{ return "1.7976931348623157e308" }
		return "-1.7976931348623157e308"
	}

	/** The forced base type of limit constant `i`. */
	@pub
	static func limitType(i: mut s64) static imut string{
		if i < 2{ return "u8" }
		if i < 4{ return "u16" }
		if i < 6{ return "u32" }
		if i < 8{ return "u64" }
		if i < 10{ return "s8" }
		if i < 12{ return "s16" }
		if i < 14{ return "s32" }
		if i < 16{ return "s64" }
		if i < 18{ return "f32" }
		return "f64"
	}

	/** Limit constants 16..19 are FLOAT literals. */
	@pub
	static func limitIsFloat(i: mut s64) mut bool{
		return i >= 16
	}

	/** The decimal text of the number whose digits (no separators) are `digits` in base `radix` (2..16); arbitrary size, no leading zeros. */
	@pub
	@throws
	static func radixToDecimal(digits: ref imut String, radix: mut u64) owns some mut String{
		?catch(e){ throw e }
		let limbs = mut ? Vec.make()
		let n = mut Txt.len(digits)
		for k in 0..n{
			let c = mut Txt.ch(digits, k)
			let carry = mut LexWords.digitValue(c)
			let m = mut limbs.size(limbs)
			for j in 0..m{
				let v = mut (limbs.get(limbs, j) * radix + carry)
				limbs.set(limbs, j, v % 1000000000)
				carry = v / 1000000000
			}
			if carry > 0{
				? limbs.push(limbs, carry)
			}
		}
		let out = mut ? new String()
		let cnt = mut limbs.size(limbs)
		if cnt == 0{
			? out.appendChar(out, '0')
			return out
		}
		let top = mut limbs.get(limbs, cnt - 1)
		? out.appendU64(out, top)
		let idx = mut (cnt - 1)
		for r in 0..cnt{
			if idx > 0{
				idx = idx - 1
				let limb = mut limbs.get(limbs, idx)
				// zero-pad to 9 digits
				let div = mut 100000000
				for z in 0..9{
					match div != 0{
						let dg = mut ((limb / div) % 10)
						? out.appendChar(out, LexWords.charOf(48 + dg))
						div = div / 10
					}
				}
			}
		}
		return out
	}
}
