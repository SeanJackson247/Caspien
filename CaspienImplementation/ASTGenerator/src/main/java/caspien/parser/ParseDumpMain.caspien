import "stdlib/libc.caspien"
import "stdlib/gt/*"
import "stdlib/make_safe_args.caspien"
import "stdlib/string.caspien"
import "stdlib/fs.caspien"
import "stdlib/print_string.caspien"
import "../../../../../../Orchestrator/Io.caspien"
import "../lexer/Lexer.caspien"
import "../token/TokStore.caspien"
import "ParserLines.caspien"
import "../importresolver/ImportResolver.caspien"
import "../dupexpander/DupExpander.caspien"
import "../genericsexpander/GenericsExpander.caspien"
import "../typechecker/Collect.caspien"
import "../typechecker/TypeAnn.caspien"
import "../typechecker/Flatten.caspien"
import "../typechecker/Funcs.caspien"
import "../typechecker/Impls.caspien"
import "../typechecker/ImplColl.caspien"
import "../typechecker/Hier.caspien"
import "../typechecker/Expr.caspien"
import "../typechecker/Globals.caspien"
import "../typechecker/Lets.caspien"
import "../typechecker/Checks.caspien"
import "../typechecker/RootAsm.caspien"

/**
 * Test tool: `parse_dump <nest|split|lines|full> <file.caspien>` prints the token tree in the format of the Java `ParseDump` (tools/ParseDump.java):
 * one line per token, `label: TYPE|text|line|literalValue|forcedType|flags...`, children indented under their parent in the order
 * left, right, next, sub, childs, typeBound, genericArgs groups.
 */
@pub
struct PDump{@pub{
}}

@pub
impl PDump{
	static func putLit(out: ref mut String, lit: static imut string) void{
		?catch(e){ return }
		match Some(out){ ? out.append(out, lit) }
	}

	static func putCh(out: ref mut String, c: mut char) void{
		?catch(e){ return }
		match Some(out){ ? out.appendChar(out, c) }
	}

	static func putU64(out: ref mut String, v: mut u64) void{
		?catch(e){ return }
		match Some(out){ ? out.appendU64(out, v) }
	}

	static func putStr(out: ref mut String, s: ref imut String) void{
		?catch(e){ return }
		match Some(out){
			match Some(s){ ? out.append(out, s) }
		}
	}

	static func hexDigit(v: mut u64) mut char{
		if v < 10{
			return LexWords.charOf(48 + v)
		}
		return LexWords.charOf(97 + v - 10)
	}

	/** Java LexDump.esc: `~` for null, backslash escapes, \xHH (at least 2 hex digits) for control and non-ASCII code points. */
	static func esc(out: ref mut String, s: ref imut String) void{
		?catch(e){ return }
		let n = mut 0
		match Some(s){ n = s.length(s) }
		let i = mut 0
		for lp1 in 0..1000000000{
			if i >= n{
				break
			}
			let b = mut 0
			match Some(s){ b = String.charCode(s.charAt(s, i)) }
			let cp = mut b
			let adv = mut 1
			if b >= 224 && i + 2 < n{
				let b1 = mut 0
				let b2 = mut 0
				match Some(s){
					b1 = String.charCode(s.charAt(s, i + 1))
					b2 = String.charCode(s.charAt(s, i + 2))
				}
				cp = (b % 16) * 4096 + (b1 % 64) * 64 + b2 % 64
				adv = 3
			} else if b >= 192 && i + 1 < n{
				let c1 = mut 0
				match Some(s){ c1 = String.charCode(s.charAt(s, i + 1)) }
				cp = (b % 32) * 64 + c1 % 64
				adv = 2
			}
			if cp == 92{
				PDump.putLit(out, "\\\\")
			} else if cp == 10{
				PDump.putLit(out, "\\n")
			} else if cp == 13{
				PDump.putLit(out, "\\r")
			} else if cp == 9{
				PDump.putLit(out, "\\t")
			} else if cp < 32 || cp > 126{
				PDump.putLit(out, "\\x")
				if cp > 65535{
					PDump.putCh(out, PDump.hexDigit((cp / 1048576) % 16))
					PDump.putCh(out, PDump.hexDigit((cp / 65536) % 16))
				}
				if cp > 255{
					PDump.putCh(out, PDump.hexDigit((cp / 4096) % 16))
					PDump.putCh(out, PDump.hexDigit((cp / 256) % 16))
				}
				PDump.putCh(out, PDump.hexDigit((cp / 16) % 16))
				PDump.putCh(out, PDump.hexDigit(cp % 16))
			} else {
				PDump.putCh(out, LexWords.charOf(cp))
			}
			i = i + adv
		}
	}


	/** Java ParseDump.esc of string `sid` (`~` when unset), decoding UTF-8 to code points like Java chars. */
	static func addStrOf(out: ref mut String, ts: ref imut TokStore, sid: mut u64) void{
		if sid == TOK_NONE{
			PDump.putCh(out, '~')
			return
		}
		let n = mut TokStore.strLen(ts, sid)
		let i = mut 0
		for lp1 in 0..1000000000{
			if i >= n{
				break
			}
			let b = mut String.charCode(TokStore.strCh(ts, sid, i))
			let cp = mut b
			let adv = mut 1
			if b >= 224 && i + 2 < n{
				let b1 = mut String.charCode(TokStore.strCh(ts, sid, i + 1))
				let b2 = mut String.charCode(TokStore.strCh(ts, sid, i + 2))
				cp = (b % 16) * 4096 + (b1 % 64) * 64 + b2 % 64
				adv = 3
			} else if b >= 192 && i + 1 < n{
				let c1 = mut String.charCode(TokStore.strCh(ts, sid, i + 1))
				cp = (b % 32) * 64 + c1 % 64
				adv = 2
			}
			if cp == 92{
				PDump.putLit(out, "\\\\")
			} else if cp == 10{
				PDump.putLit(out, "\\n")
			} else if cp == 13{
				PDump.putLit(out, "\\r")
			} else if cp == 9{
				PDump.putLit(out, "\\t")
			} else if cp < 32 || cp > 126{
				PDump.putLit(out, "\\x")
				if cp > 65535{
					PDump.putCh(out, PDump.hexDigit((cp / 1048576) % 16))
					PDump.putCh(out, PDump.hexDigit((cp / 65536) % 16))
				}
				if cp > 255{
					PDump.putCh(out, PDump.hexDigit((cp / 4096) % 16))
					PDump.putCh(out, PDump.hexDigit((cp / 256) % 16))
				}
				PDump.putCh(out, PDump.hexDigit((cp / 16) % 16))
				PDump.putCh(out, PDump.hexDigit(cp % 16))
			} else {
				PDump.putCh(out, LexWords.charOf(cp))
			}
			i = i + adv
		}
	}

	/** One token line (without indent and label). */
		static func tokenLine(out: ref mut String, ts: ref imut TokStore, t: mut u64, extra: mut u64) void{
		PDump.putLit(out, tokenTypeName(TokStore.kind(ts, t)))
		PDump.putCh(out, '|')
		PDump.addStrOf(out, ts, TokStore.text(ts, t))
		PDump.putCh(out, '|')
		PDump.putU64(out, TokStore.line(ts, t))
		PDump.putCh(out, '|')
		PDump.addStrOf(out, ts, TokStore.literalValue(ts, t))
		PDump.putCh(out, '|')
		PDump.addStrOf(out, ts, TokStore.forcedLiteralType(ts, t))
		if TokStore.unary(ts, t) != 0{ PDump.putLit(out, "|unary") }
		if TokStore.isStatic(ts, t) != 0{ PDump.putLit(out, "|static") }
		if TokStore.isConst(ts, t) != 0{ PDump.putLit(out, "|const") }
		if TokStore.isStaticMethod(ts, t) != 0{ PDump.putLit(out, "|staticMethod") }
		if TokStore.isCaseMatch(ts, t) != 0{ PDump.putLit(out, "|caseMatch") }
		if TokStore.isForMatch(ts, t) != 0{ PDump.putLit(out, "|forMatch") }
		if TokStore.isTryBlock(ts, t) != 0{ PDump.putLit(out, "|tryBlock") }
		if TokStore.hasBlock(ts, t) != 0{ PDump.putLit(out, "|hasBlock") }
		if TokStore.isConstructorDecl(ts, t) != 0{
			PDump.putLit(out, "|ctor=")
			PDump.addStrOf(out, ts, TokStore.constructorConcreteName(ts, t))
		}
		if TokStore.isPubBlockMember(ts, t) != 0{ PDump.putLit(out, "|pubMember") }
		if TokStore.catchParamName(ts, t) != TOK_NONE{
			PDump.putLit(out, "|catch=")
			PDump.addStrOf(out, ts, TokStore.catchParamName(ts, t))
		}
		PDump.strList(out, ts, "|tp=", TokStore.typeParams(ts, t))
		PDump.strList(out, ts, "|tpb=", TokStore.typeParamBounds(ts, t))
		PDump.strList(out, ts, "|ext=", TokStore.extendsNames(ts, t))
		PDump.strList(out, ts, "|impl=", TokStore.implementsNames(ts, t))
		PDump.strList(out, ts, "|tags=", TokStore.unsafeTags(ts, t))
		PDump.strList(out, ts, "|assume=", TokStore.assumeVariants(ts, t))
		if TokStore.hasEnumValue(ts, t) != 0{
			PDump.putLit(out, "|enumVal=")
			PDump.putU64(out, TokStore.enumValue(ts, t))
		}
		if TokStore.hasRangeStart(ts, t) != 0{
			PDump.putLit(out, "|rs=")
			PDump.putU64(out, TokStore.rangeStart(ts, t))
		}
		if TokStore.hasRangeEnd(ts, t) != 0{
			PDump.putLit(out, "|re=")
			PDump.putU64(out, TokStore.rangeEnd(ts, t))
		}
		if TokStore.asmBlockText(ts, t) != TOK_NONE{
			PDump.putLit(out, "|asm=")
			PDump.addStrOf(out, ts, TokStore.asmBlockText(ts, t))
		}
		if extra != 0{
			PDump.putLit(out, "|file=")
			PDump.addStrOf(out, ts, TokStore.fileId(ts, t))
			if TokStore.fromGenericInstance(ts, t) != 0{
				PDump.putLit(out, "|fgi")
			}
			let pb = mut TokStore.pendingBounds(ts, t)
			if pb != TOK_NONE{
				PDump.putLit(out, "|pbc=[")
				let npb = mut TokStore.listSize(ts, pb)
				let bi = mut 0
				for lp9 in 0..1000000000{
					if bi >= npb{
						break
					}
					if bi > 0{
						PDump.putCh(out, ',')
					}
					PDump.addStrOf(out, ts, TokStore.listGet(ts, pb, bi))
					PDump.putCh(out, ':')
					PDump.addStrOf(out, ts, TokStore.listGet(ts, pb, bi + 1))
					PDump.putCh(out, ':')
					PDump.addStrOf(out, ts, TokStore.listGet(ts, pb, bi + 2))
					bi = bi + 3
				}
				PDump.putCh(out, ']')
			}
		}
		let dl = mut TokStore.decorators(ts, t)
		let nd = mut TokStore.listSize(ts, dl)
		for di in 0..nd{
			PDump.putLit(out, "|")
			PDump.decorator(out, ts, TokStore.listGet(ts, dl, di))
		}
		let pl = mut TokStore.pinned(ts, t)
		let np = mut TokStore.listSize(ts, pl)
		for pi in 0..np{
			let p = mut TokStore.listGet(ts, pl, pi)
			PDump.putLit(out, "|pin ")
			PDump.putLit(out, tokenTypeName(TokStore.kind(ts, p)))
			PDump.putCh(out, ':')
			PDump.putU64(out, TokStore.line(ts, p))
			PDump.putCh(out, ':')
			PDump.addStrOf(out, ts, TokStore.text(ts, p))
		}
	}

	/** `prefix[a,b,c]` for a string-id list (nothing for an unset list, `~` entries for unset strings). */
		static func strList(out: ref mut String, ts: ref imut TokStore, prefix: static imut string, l: mut u64) void{
		if l == TOK_NONE{
			return
		}
		PDump.putLit(out, prefix)
		PDump.strListBody(out, ts, l)
	}

		static func strListBody(out: ref mut String, ts: ref imut TokStore, l: mut u64) void{
		if l == TOK_NONE{
			PDump.putCh(out, '~')
			return
		}
		PDump.putCh(out, '[')
		let n = mut TokStore.listSize(ts, l)
		for i in 0..n{
			if i > 0{
				PDump.putCh(out, ',')
			}
			PDump.addStrOf(out, ts, TokStore.listGet(ts, l, i))
		}
		PDump.putCh(out, ']')
	}

		static func boolListBody(out: ref mut String, ts: ref imut TokStore, l: mut u64) void{
		if l == TOK_NONE{
			PDump.putCh(out, '~')
			return
		}
		PDump.putCh(out, '[')
		let n = mut TokStore.listSize(ts, l)
		for i in 0..n{
			if i > 0{
				PDump.putCh(out, ',')
			}
			if TokStore.listGet(ts, l, i) != 0{
				PDump.putLit(out, "true")
			} else {
				PDump.putLit(out, "false")
			}
		}
		PDump.putCh(out, ']')
	}

		static func decorator(out: ref mut String, ts: ref imut TokStore, d: mut u64) void{
		PDump.putCh(out, '@')
		PDump.addStrOf(out, ts, TokStore.dName(ts, d))
		PDump.putLit(out, " args=")
		PDump.strListBody(out, ts, TokStore.dArgs(ts, d))
		PDump.putLit(out, " str=")
		PDump.boolListBody(out, ts, TokStore.dArgIsString(ts, d))
		PDump.putLit(out, " line=")
		PDump.putU64(out, TokStore.dLine(ts, d))
		PDump.putLit(out, " lockField=")
		PDump.addStrOf(out, ts, TokStore.dLockField(ts, d))
		PDump.putLit(out, " lockVariants=")
		PDump.strListBody(out, ts, TokStore.dLockVariants(ts, d))
		PDump.putLit(out, " inParams=")
		PDump.strListBody(out, ts, TokStore.dLockInParams(ts, d))
		PDump.putLit(out, " inFields=")
		PDump.strListBody(out, ts, TokStore.dLockInFields(ts, d))
		PDump.putLit(out, " inOps=")
		PDump.strListBody(out, ts, TokStore.dLockInOperators(ts, d))
		PDump.putLit(out, " inSome=")
		PDump.boolListBody(out, ts, TokStore.dLockInSomeWrapped(ts, d))
		PDump.putLit(out, " ltTerms=")
		PDump.strListBody(out, ts, TokStore.dLifetimeTerms(ts, d))
		PDump.putLit(out, " ltOps=")
		PDump.strListBody(out, ts, TokStore.dLifetimeOps(ts, d))
	}

	/** Label text for a label code: 1 root 2 left 3 right 4 next 5 sub 6 child 7 bound, 100+g = garg<g>. */
		static func label(out: ref mut String, code: mut u64) void{
		if code == 1{ PDump.putLit(out, "root") }
		else if code == 2{ PDump.putLit(out, "left") }
		else if code == 3{ PDump.putLit(out, "right") }
		else if code == 4{ PDump.putLit(out, "next") }
		else if code == 5{ PDump.putLit(out, "sub") }
		else if code == 6{ PDump.putLit(out, "child") }
		else if code == 7{ PDump.putLit(out, "bound") }
		else {
			PDump.putLit(out, "garg")
			PDump.putU64(out, code - 100)
		}
	}

	/** Prints the trees rooted at the tokens of list `roots` (Java ParseDump.dump). */
	@throws
	static func dumpTree(out: ref mut String, ts: ref imut TokStore, roots: mut u64, extra: mut u64) void{
		?catch(e){ throw e }
		let stT = mut ? Vec.make()
		let stD = mut ? Vec.make()
		let stL = mut ? Vec.make()
		let kT = mut ? Vec.make()
		let kL = mut ? Vec.make()
		let nr = mut TokStore.listSize(ts, roots)
		for ri in 0..nr{
			let k = mut (nr - 1 - ri)
			? stT.push(stT, TokStore.listGet(ts, roots, k))
			? stD.push(stD, 0)
			? stL.push(stL, 1)
		}
		for lp1 in 0..1000000000{
			if stT.size(stT) == 0{
				break
			}
			let t = mut stT.pop(stT)
			let depth = mut stD.pop(stD)
			let lab = mut stL.pop(stL)
			for q in 0..depth{
				PDump.putLit(out, "  ")
			}
			PDump.label(out, lab)
			PDump.putLit(out, ": ")
			PDump.tokenLine(out, ts, t, extra)
			PDump.putCh(out, '\n')
			kT.clear(kT)
			kL.clear(kL)
			let l = mut TokStore.left(ts, t)
			if l != TOK_NONE{
				? kT.push(kT, l)
				? kL.push(kL, 2)
			}
			let r = mut TokStore.right(ts, t)
			if r != TOK_NONE{
				? kT.push(kT, r)
				? kL.push(kL, 3)
			}
			let nx = mut TokStore.next(ts, t)
			if nx != TOK_NONE{
				? kT.push(kT, nx)
				? kL.push(kL, 4)
			}
			? PDump.collect(ts, TokStore.sub(ts, t), 5, kT, kL)
			? PDump.collect(ts, TokStore.childs(ts, t), 6, kT, kL)
			? PDump.collect(ts, TokStore.typeBound(ts, t), 7, kT, kL)
			let ga = mut TokStore.genericArgs(ts, t)
			let ng = mut TokStore.listSize(ts, ga)
			for g in 0..ng{
				? PDump.collect(ts, TokStore.listGet(ts, ga, g), 100 + g, kT, kL)
			}
			let nk = mut kT.size(kT)
			for qi in 0..nk{
				let idx = mut (nk - 1 - qi)
				? stT.push(stT, kT.get(kT, idx))
				? stD.push(stD, depth + 1)
				? stL.push(stL, kL.get(kL, idx))
			}
		}
	}

	@throws
	static func collect(ts: ref imut TokStore, l: mut u64, code: mut u64, kT: ref some mut Vec, kL: ref some mut Vec) void{
		?catch(e){ throw e }
		let n = mut TokStore.listSize(ts, l)
		for i in 0..n{
			? kT.push(kT, TokStore.listGet(ts, l, i))
			? kL.push(kL, code)
		}
	}

	/** Plain list of string ids joined by `sep`. */
	static func joinSids(out: ref mut String, ts: ref imut TokStore, l: mut u64, sep: mut char) void{
		if l == TOK_NONE{
			return
		}
		let n = mut TokStore.listSize(ts, l)
		for i in 0..n{
			if i > 0{
				PDump.putCh(out, sep)
			}
			PDump.addStrOf(out, ts, TokStore.listGet(ts, l, i))
		}
	}

	/** u64 list in the Java List.toString form "[1, 2]". */
	static func u64List(out: ref mut String, ts: ref imut TokStore, l: mut u64) void{
		PDump.putCh(out, '[')
		let n = mut TokStore.listSize(ts, l)
		for i in 0..n{
			if i > 0{
				PDump.putLit(out, ", ")
			}
			PDump.putU64(out, TokStore.listGet(ts, l, i))
		}
		PDump.putCh(out, ']')
	}

	/** One struct's member types; on any error only "ERR" is printed for it. */
	static func dumpStructTypes(out: ref mut String, ts: ref mut TokStore, tl: mut u64, sr: mut u64, cx: mut u64, nm: mut u64) void{
		?catch(e){
			PDump.putLit(out, "type ")
			PDump.addStrOf(out, ts, nm)
			PDump.putLit(out, " ERR\n")
			return
		}
		let row = mut StrMap.get(ts, World.get(ts, TokStore.listGet(ts, cx, CX_W), W_M_STRUCTS), nm)
		let lines = mut Infos.sget(ts, sr, row, SI_RAW_LINES)
		let acc = mut ? TokStore.newList(ts)
		let nl = mut TokStore.listSize(ts, lines)
		for i in 0..nl{
			let ml = mut TokStore.listGet(ts, lines, i)
			? TypeAnn.parseNameTypeGroups(ts, cx, TokStore.childs(ts, ml), 1, acc)
		}
		let na = mut (TokStore.listSize(ts, acc) / 3)
		for j in 0..na{
			let mname = mut TokStore.listGet(ts, acc, j * 3)
			let ty = mut TokStore.listGet(ts, acc, j * 3 + 1)
			let canon = mut ? Ty.canonical(ts, tl, ty)
			PDump.putLit(out, "type ")
			PDump.addStrOf(out, ts, nm)
			PDump.putCh(out, '.')
			PDump.addStrOf(out, ts, mname)
			PDump.putLit(out, " = ")
			PDump.addStrOf(out, ts, canon)
			PDump.putLit(out, " alias=")
			let al = mut Ty.get(ts, tl, ty, TY_ALIAS)
			if al == TOK_NONE{
				PDump.putCh(out, '-')
			}
			else{
				PDump.addStrOf(out, ts, al)
			}
			PDump.putLit(out, " const=")
			PDump.putU64(out, Ty.get(ts, tl, ty, TY_CONST))
			PDump.putLit(out, " swap=")
			PDump.putU64(out, TokStore.listGet(ts, acc, j * 3 + 2))
			PDump.putCh(out, '\n')
		}
	}

	/** flattenStruct for every struct in order; prints members, public members, swap and lock fields (or ERR). */
	static func dumpOneFlat(out: ref mut String, ts: ref mut TokStore, tl: mut u64, sr: mut u64, er: mut u64, cx: mut u64, nm: mut u64) void{
		?catch(e){
			PDump.putLit(out, "flat ")
			PDump.addStrOf(out, ts, nm)
			PDump.putLit(out, " ERR\n")
			return
		}
		? Flatten.flattenStruct(ts, cx, er, nm)
		let w = mut TokStore.listGet(ts, cx, CX_W)
		let row = mut StrMap.get(ts, World.get(ts, w, W_M_STRUCTS), nm)
		let members = mut Infos.sget(ts, sr, row, SI_MEMBERS)
		let pubm = mut Infos.sget(ts, sr, row, SI_PUBLIC_MEMBERS)
		let keys = mut TokStore.listGet(ts, members, 0)
		let vals = mut TokStore.listGet(ts, members, 1)
		PDump.putLit(out, "flat ")
		PDump.addStrOf(out, ts, nm)
		PDump.putLit(out, " m=")
		let n = mut TokStore.listSize(ts, keys)
		for i in 0..n{
			let k = mut TokStore.listGet(ts, keys, i)
			PDump.addStrOf(out, ts, k)
			PDump.putCh(out, ':')
			let canon = mut ? Ty.canonical(ts, tl, TokStore.listGet(ts, vals, i))
			PDump.addStrOf(out, ts, canon)
			if StrMap.has(ts, pubm, k){
				PDump.putLit(out, "!p")
			}
			PDump.putCh(out, ',')
		}
		PDump.putLit(out, " swap=")
		let sw = mut Infos.sget(ts, sr, row, SI_SWAP_FIELD)
		if sw != TOK_NONE{
			PDump.addStrOf(out, ts, sw)
		}
		PDump.putLit(out, " lock=")
		let lf = mut Infos.sget(ts, sr, row, SI_LOCK_FIELD)
		if lf != TOK_NONE{
			PDump.addStrOf(out, ts, lf)
			PDump.putCh(out, ':')
			PDump.joinSids(out, ts, Infos.sget(ts, sr, row, SI_LOCK_VARIANTS), ',')
		}
		PDump.putCh(out, '\n')
	}

	static func dumpOneIface(out: ref mut String, ts: ref mut TokStore, w: mut u64, ir: mut u64, nm: mut u64) void{
		?catch(e){
			PDump.putLit(out, "iflat ")
			PDump.addStrOf(out, ts, nm)
			PDump.putLit(out, " ERR\n")
			return
		}
		? Flatten.flattenInterface(ts, w, ir, nm)
		let row = mut StrMap.get(ts, World.get(ts, w, W_M_IFACES), nm)
		let methods = mut Infos.rget(ts, ir, 8, row, II_METHODS)
		PDump.putLit(out, "iflat ")
		PDump.addStrOf(out, ts, nm)
		PDump.putLit(out, " m=")
		PDump.joinSids(out, ts, TokStore.listGet(ts, methods, 0), ',')
		PDump.putCh(out, '\n')
	}

	static func dumpIfaceFlat(out: ref mut String, ts: ref mut TokStore, w: mut u64, ir: mut u64) void{
		?catch(e){
			PDump.putLit(out, "iflat ERR\n")
			return
		}
		let ik = mut ? Collect.sortedKeys(ts, World.get(ts, w, W_M_IFACES))
		let n = mut TokStore.listSize(ts, ik)
		for i in 0..n{
			PDump.dumpOneIface(out, ts, w, ir, TokStore.listGet(ts, ik, i))
		}
	}

	static func tyText(out: ref mut String, ts: ref mut TokStore, tl: mut u64, ty: mut u64) void{
		?catch(e){ return }
		let c = mut ? Ty.canonical(ts, tl, ty)
		PDump.addStrOf(out, ts, c)
		let al = mut Ty.get(ts, tl, ty, TY_ALIAS)
		if al != TOK_NONE{
			PDump.putCh(out, '~')
			PDump.addStrOf(out, ts, al)
		}
	}

	static func tyList(out: ref mut String, ts: ref mut TokStore, tl: mut u64, l: mut u64) void{
		let n = mut TokStore.listSize(ts, l)
		for i in 0..n{
			if i > 0{
				PDump.putCh(out, ';')
			}
			PDump.tyText(out, ts, tl, TokStore.listGet(ts, l, i))
		}
	}

	/** True when `e` is `[mut|imut]* atomic ...` (TypeCheckerImpls.isDirectAtomicDeclaration). */
	static func isDirectAtomic(ts: ref imut TokStore, e: mut u64) mut bool{
		let t = mut e
		for lp in 0..1000000000{
			if TokStore.kind(ts, t) == TT_OPERATOR && TokStore.unary(ts, t) != 0 && (TokStore.textEq(ts, t, "mut") || TokStore.textEq(ts, t, "imut")){
				t = TokStore.left(ts, t)
			} else {
				break
			}
		}
		return TokStore.kind(ts, t) == TT_OPERATOR && TokStore.textEq(ts, t, "atomic")
	}

	/** Marks every name appearing under `root` as unknown in `env` (a binding construct may retype it). */
	@throws
	static func unbindAll(ts: ref mut TokStore, env: mut u64, root: mut u64) void{
		?catch(e){ throw e }
		let wl = mut ? TokStore.newList(ts)
		? TokStore.listAdd(ts, wl, root)
		for k in 0..1000000{
			if TokStore.listSize(ts, wl) == 0{
				break
			}
			let t = mut TokStore.listPop(ts, wl)
			if t == TOK_NONE{
				continue
			}
			if TokStore.kind(ts, t) == TT_VARREF{
				? StrMap.put(ts, env, TokStore.text(ts, t), TOK_NONE)
			}
			? TokStore.listAdd(ts, wl, TokStore.left(ts, t))
			? TokStore.listAdd(ts, wl, TokStore.right(ts, t))
			let cs = mut TokStore.childs(ts, t)
			let nc = mut TokStore.listSize(ts, cs)
			for q in 0..nc{
				? TokStore.listAdd(ts, wl, TokStore.listGet(ts, cs, q))
			}
			let ss = mut TokStore.sub(ts, t)
			let ns = mut TokStore.listSize(ts, ss)
			for q in 0..ns{
				? TokStore.listAdd(ts, wl, TokStore.listGet(ts, ss, q))
			}
		}
	}

	/** One `node` line per sub-expression typed since `mark` (pairs of node, type in the recorder list), under the statement at `line`. */
	/** Nodes reachable from r1/r2 the way Java's nodeDump walks them: right, left, sub, childs; LINE tokens (and everything under them) are skipped. */
	@throws
	static func reachable(ts: ref mut TokStore, r1: mut u64, r2: mut u64) mut u64{
		?catch(e){ throw e }
		let reach = mut ? TokStore.newList(ts)
		let stk = mut ? TokStore.newList(ts)
		if r2 != TOK_NONE{
			? TokStore.listAdd(ts, stk, r2)
		}
		if r1 != TOK_NONE{
			? TokStore.listAdd(ts, stk, r1)
		}
		for lp in 0..100000000{
			if TokStore.listSize(ts, stk) == 0{
				break
			}
			let x = mut TokStore.listPop(ts, stk)
			if x == TOK_NONE || TokStore.kind(ts, x) == TT_LINE{
				continue
			}
			? TokStore.listAdd(ts, reach, x)
			let a = mut TokStore.right(ts, x)
			if a != TOK_NONE{
				? TokStore.listAdd(ts, stk, a)
			}
			let b = mut TokStore.left(ts, x)
			if b != TOK_NONE{
				? TokStore.listAdd(ts, stk, b)
			}
			let sb = mut TokStore.sub(ts, x)
			if sb != TOK_NONE{
				let nsb = mut TokStore.listSize(ts, sb)
				for i in 0..nsb{
					? TokStore.listAdd(ts, stk, TokStore.listGet(ts, sb, i))
				}
			}
			let cd = mut TokStore.childs(ts, x)
			if cd != TOK_NONE{
				let ncd = mut TokStore.listSize(ts, cd)
				for i in 0..ncd{
					? TokStore.listAdd(ts, stk, TokStore.listGet(ts, cd, i))
				}
			}
		}
		return reach
	}

	/** The string's characters unescaped (Java prints a node's text as is). */
	static func addRawOf(out: ref mut String, ts: ref imut TokStore, sid: mut u64) void{
		if sid == TOK_NONE{
			return
		}
		let n = mut TokStore.strLen(ts, sid)
		for i in 0..n{
			if String.charCode(TokStore.strCh(ts, sid, i)) != 0{
				PDump.putCh(out, TokStore.strCh(ts, sid, i))
			}
		}
	}

	static func listHas(ts: ref mut TokStore, l: mut u64, x: mut u64) mut bool{
		let nl = mut TokStore.listSize(ts, l)
		for i in 0..nl{
			if TokStore.listGet(ts, l, i) == x{
				return true
			}
		}
		return false
	}

	/** One "node" line per reachable annotated node: the LAST type recorded for it since `mark`. */
	static func putNodes(out: ref mut String, ts: ref mut TokStore, tl: mut u64, rec: mut u64, mark: mut u64, fname: mut u64, j: mut u64, line: mut u64, r1: mut u64, r2: mut u64) void{
		?catch(e){ return }
		let reach = mut ? PDump.reachable(ts, r1, r2)
		let n = mut TokStore.listSize(ts, rec)
		let q = mut mark
		for lp in 0..100000000{
			if q + 1 >= n{
				break
			}
			let nd = mut TokStore.listGet(ts, rec, q)
			let ty = mut TokStore.listGet(ts, rec, q + 1)
			q = q + 2
			if PDump.listHas(ts, reach, nd) == false{
				continue
			}
			let later = mut false
			let q2 = mut q
			for lp2 in 0..100000000{
				if q2 + 1 >= n{
					break
				}
				if TokStore.listGet(ts, rec, q2) == nd{
					later = true
					break
				}
				q2 = q2 + 2
			}
			if later || ty == TOK_NONE{
				continue
			}
			let cn = mut ? Ty.canonical(ts, tl, ty)
			PDump.putLit(out, "node ")
			PDump.addStrOf(out, ts, fname)
			PDump.putCh(out, '#')
			PDump.putU64(out, j)
			PDump.putLit(out, " L")
			PDump.putU64(out, line)
			PDump.putCh(out, ' ')
			PDump.putLit(out, tokenTypeName(TokStore.kind(ts, nd)))
			PDump.putCh(out, ':')
			PDump.addRawOf(out, ts, TokStore.text(ts, nd))
			PDump.putCh(out, ' ')
			PDump.addStrOf(out, ts, cn)
			PDump.putCh(out, '\n')
		}
	}

	/** "UNSUP <head>" for an expression the type walker does not cover: the head of the initialiser after peeling mut/imut, parentheses and try. */
	static func unsupHead(out: ref mut String, ts: ref mut TokStore, rh0: mut u64) void{
					let rh = mut rh0
					for ul in 0..12{
						if TokStore.kind(ts, rh) == TT_OPERATOR && TokStore.unary(ts, rh) != 0 && (TokStore.textEq(ts, rh, "mut") || TokStore.textEq(ts, rh, "imut")) && TokStore.left(ts, rh) != TOK_NONE{
							rh = TokStore.left(ts, rh)
						} else if TokStore.kind(ts, rh) == TT_DELINEATOR && TokStore.textEq(ts, rh, "(") && TokStore.listSize(ts, TokStore.childs(ts, rh)) > 0{
							rh = TokStore.listGet(ts, TokStore.childs(ts, rh), 0)
						} else if (TokStore.kind(ts, rh) == TT_KEYWORD || TokStore.kind(ts, rh) == TT_OPERATOR) && TokStore.textEq(ts, rh, "try") && TokStore.listSize(ts, TokStore.sub(ts, rh)) > 0{
							rh = TokStore.listGet(ts, TokStore.sub(ts, rh), 0)
						}
					}
					PDump.putLit(out, "UNSUP ")
					if TokStore.kind(ts, rh) == TT_OPERATOR || TokStore.kind(ts, rh) == TT_DELINEATOR || TokStore.kind(ts, rh) == TT_KEYWORD{
						PDump.addStrOf(out, ts, TokStore.text(ts, rh))
						if TokStore.kind(ts, rh) == TT_OPERATOR && TokStore.textEq(ts, rh, "CALL") && TokStore.left(ts, rh) != TOK_NONE{
							PDump.putCh(out, ':')
							PDump.addStrOf(out, ts, TokStore.text(ts, TokStore.left(ts, rh)))
						}
					} else {
						PDump.putLit(out, "kind")
						PDump.putU64(out, TokStore.kind(ts, rh))
					}
	}

	/** Type of every plain `let` of every function body, nested blocks included (Java ParseDump "lets"); UNSUP = not covered by Expr yet. */
	static func dumpLets(out: ref mut String, ts: ref mut TokStore, w: mut u64, tl: mut u64, cx: mut u64, er: mut u64) void{
		?catch(e){
			Io.eprintLit(e.msg)
			Io.eprintLit("\n")
			PDump.putLit(out, "lets ERR\n")
			return
		}
		let fl = mut TokStore.listGet(ts, cx, 7)
		let rec = mut TokStore.listGet(ts, cx, 16)
		let lim = mut ? Expr.limits(ts)
		let fk = mut ? Collect.sortedKeys(ts, World.get(ts, w, W_M_FUNCS))
		let nf = mut TokStore.listSize(ts, fk)
		for i in 0..nf{
			let nm = mut TokStore.listGet(ts, fk, i)
			let ov = mut StrMap.get(ts, World.get(ts, w, W_M_FUNCS), nm)
			let no = mut TokStore.listSize(ts, ov)
			for j in 0..no{
				let fi = mut TokStore.listGet(ts, ov, j)
				let env0 = mut ? StrMap.make(ts)
				let pn = mut Infos.fget(ts, fl, fi, FI_PARAM_NAMES)
				let pt = mut Infos.fget(ts, fl, fi, FI_PARAM_TYPES)
				let np = mut TokStore.listSize(ts, pn)
				for q in 0..np{
					? StrMap.put(ts, env0, TokStore.listGet(ts, pn, q), TokStore.listGet(ts, pt, q))
				}
				let ftok = mut Infos.fget(ts, fl, fi, FI_FUNC_TOK)
				let isRec = mut false
				if Dec.getDecorator(ts, TokStore.decorators(ts, ftok), "recursive") != TOK_NONE{
					isRec = true
				}
				// frames of three entries: lines list, next index, environment
				let stk = mut ? TokStore.newList(ts)
				? TokStore.listAdd(ts, stk, TokStore.childs(ts, ftok))
				? TokStore.listAdd(ts, stk, 0)
				? TokStore.listAdd(ts, stk, env0)
				for step in 0..100000000{
					let sz = mut TokStore.listSize(ts, stk)
					if sz == 0{
						break
					}
					let lines = mut TokStore.listGet(ts, stk, sz - 3)
					let li = mut TokStore.listGet(ts, stk, sz - 2)
					let env = mut TokStore.listGet(ts, stk, sz - 1)
					if li >= TokStore.listSize(ts, lines){
						let d1 = mut TokStore.listPop(ts, stk)
						let d2 = mut TokStore.listPop(ts, stk)
						let d3 = mut TokStore.listPop(ts, stk)
						continue
					}
					TokStore.listSet(ts, stk, sz - 2, li + 1)
					let lcs = mut TokStore.childs(ts, TokStore.listGet(ts, lines, li))
					if TokStore.listSize(ts, lcs) == 0{
						continue
					}
					let st = mut TokStore.listGet(ts, lcs, 0)
					if TokStore.kind(ts, st) == TT_KEYWORD && TokStore.listSize(ts, TokStore.childs(ts, st)) > 0 && TokStore.left(ts, st) == TOK_NONE{
						// a block statement: its body and the chain of else parts; unsafe/safe blocks share the scope
						let chain = mut ? TokStore.newList(ts)
						let ct = mut st
						for cl in 0..64{
							if ct == TOK_NONE{
								break
							}
							? TokStore.listAdd(ts, chain, ct)
							ct = TokStore.next(ts, ct)
						}
						let nch = mut TokStore.listSize(ts, chain)
						for ci in 0..nch{
							let bt = mut TokStore.listGet(ts, chain, nch - 1 - ci)
							let shared = mut false
							if TokStore.textEq(ts, bt, "unsafe") || TokStore.textEq(ts, bt, "safe"){
								shared = true
							}
							let benv = mut env
							if shared == false{
								benv = ? StrMap.copy(ts, env)
								let bsub = mut TokStore.sub(ts, bt)
								let nbs = mut TokStore.listSize(ts, bsub)
								for q in 0..nbs{
									let cnd = mut TokStore.listGet(ts, bsub, q)
									let ctyp = mut ? Expr.typeOf(ts, tl, w, er, cnd, env, cx)
									let isSome = mut false
									if TokStore.kind(ts, cnd) == TT_OPERATOR && TokStore.textEq(ts, cnd, "CALL") && TokStore.left(ts, cnd) != TOK_NONE && TokStore.textEq(ts, TokStore.left(ts, cnd), "Some"){
										isSome = true
									}
									let keepsTypes = mut false
									if TokStore.kind(ts, cnd) == TT_OPERATOR && (TokStore.textEq(ts, cnd, "fits") || TokStore.textEq(ts, cnd, "in") || TokStore.textEq(ts, cnd, "into") || TokStore.textEq(ts, cnd, "within")){
										keepsTypes = true
									}
									if TokStore.kind(ts, cnd) == TT_OPERATOR && TokStore.unary(ts, cnd) == 0 && (TokStore.textEq(ts, cnd, "!=") || TokStore.textEq(ts, cnd, "==") || TokStore.textEq(ts, cnd, "<") || TokStore.textEq(ts, cnd, ">") || TokStore.textEq(ts, cnd, "<=") || TokStore.textEq(ts, cnd, ">=")){
										keepsTypes = true
									}
									let forIn = mut false
									if TokStore.textEq(ts, bt, "for") && TokStore.kind(ts, cnd) == TT_OPERATOR && (TokStore.textEq(ts, cnd, "in") || TokStore.textEq(ts, cnd, "into")) && TokStore.kind(ts, TokStore.left(ts, cnd)) == TT_VARREF{
										forIn = true
									}
									if forIn{
										? StrMap.put(ts, benv, TokStore.text(ts, TokStore.left(ts, cnd)), TOK_NONE)
									} else if TokStore.textEq(ts, bt, "for") || (TokStore.textEq(ts, bt, "match") && isSome == false && keepsTypes == false){
										? PDump.unbindAll(ts, benv, cnd)
									}
									if TokStore.textEq(ts, bt, "for") && TokStore.kind(ts, cnd) == TT_OPERATOR && (TokStore.textEq(ts, cnd, "in") || TokStore.textEq(ts, cnd, "into")) && TokStore.kind(ts, TokStore.left(ts, cnd)) == TT_VARREF{
										let rty = mut ? Expr.typeOf(ts, tl, w, er, TokStore.right(ts, cnd), env, cx)
										if rty != TOK_NONE{
											let lvt = mut ? Expr.loopVarType(ts, tl, rty)
											if lvt != TOK_NONE{
												? StrMap.put(ts, benv, TokStore.text(ts, TokStore.left(ts, cnd)), lvt)
											}
										}
									}
								}
								if TokStore.textEq(ts, bt, "for") == false && TokStore.textEq(ts, bt, "match") == false && TokStore.textEq(ts, bt, "if") == false && TokStore.textEq(ts, bt, "else") == false && TokStore.textEq(ts, bt, "elseif") == false && TokStore.textEq(ts, bt, "while") == false && TokStore.textEq(ts, bt, "loop") == false{
									continue
								}
							}
							? TokStore.listAdd(ts, stk, TokStore.childs(ts, bt))
							? TokStore.listAdd(ts, stk, 0)
							? TokStore.listAdd(ts, stk, benv)
						}
						continue
					}
					let stKind = mut 0
					if TokStore.kind(ts, st) == TT_KEYWORD && TokStore.textEq(ts, st, "return"){
						stKind = 1
					} else if TokStore.kind(ts, st) == TT_OPERATOR && TokStore.unary(ts, st) == 0 && TokStore.textEq(ts, st, "CALL"){
						stKind = 2
					} else if TokStore.kind(ts, st) == TT_OPERATOR && TokStore.unary(ts, st) == 0 && TokStore.textEq(ts, st, "=") && TokStore.left(ts, st) != TOK_NONE && TokStore.kind(ts, TokStore.left(ts, st)) != TT_KEYWORD{
						stKind = 3
					}
					if stKind != 0{
						PDump.putLit(out, "stmt ")
						PDump.addStrOf(out, ts, nm)
						PDump.putCh(out, '#')
						PDump.putU64(out, j)
						PDump.putCh(out, ' ')
						PDump.putCh(out, 'L')
						PDump.putU64(out, TokStore.line(ts, st))
						PDump.putCh(out, ' ')
						PDump.addStrOf(out, ts, TokStore.text(ts, st))
						PDump.putCh(out, ' ')
						let mark = mut TokStore.listSize(ts, rec)
						if stKind == 1 && isRec{
							PDump.putLit(out, "UNSUP return\n")
							continue
						}
						if stKind == 1{
							let rtc = mut ? Ty.canonical(ts, tl, Infos.fget(ts, fl, fi, FI_RETURN))
							PDump.addStrOf(out, ts, rtc)
							PDump.putCh(out, '\n')
							let rsub = mut TokStore.sub(ts, st)
							if rsub != TOK_NONE && TokStore.listSize(ts, rsub) == 1{
								let rdone = mut ? Expr.typeOf(ts, tl, w, er, TokStore.listGet(ts, rsub, 0), env, cx)
								if rdone != TOK_NONE{
									? Expr.acceptAdapt(ts, tl, lim, rec, TokStore.listGet(ts, rsub, 0), Infos.fget(ts, fl, fi, FI_RETURN), rdone)
									PDump.putNodes(out, ts, tl, rec, mark, nm, j, TokStore.line(ts, st), TokStore.listGet(ts, rsub, 0), TOK_NONE)
								}
							}
							continue
						}
						let styRoot = mut st
						if stKind == 3{
							styRoot = TokStore.left(ts, st)
						}
						let sty = mut ? Expr.typeOf(ts, tl, w, er, styRoot, env, cx)
						if sty == TOK_NONE{
							PDump.unsupHead(out, ts, styRoot)
						} else {
							let scn = mut ? Ty.canonical(ts, tl, sty)
							PDump.addStrOf(out, ts, scn)
						}
						PDump.putCh(out, '\n')
						let good = mut true
						if sty == TOK_NONE{
							good = false
						}
						if stKind == 3{
							let rhsDone = mut ? Expr.typeOf(ts, tl, w, er, TokStore.right(ts, st), env, cx)
							if rhsDone == TOK_NONE{
								good = false
							}
							if rhsDone != TOK_NONE && sty != TOK_NONE{
								? Expr.acceptAdapt(ts, tl, lim, rec, TokStore.right(ts, st), sty, rhsDone)
							}
						}
						if good && stKind == 3{
							PDump.putNodes(out, ts, tl, rec, mark, nm, j, TokStore.line(ts, st), TokStore.left(ts, st), TokStore.right(ts, st))
						} else if good{
							PDump.putNodes(out, ts, tl, rec, mark, nm, j, TokStore.line(ts, st), st, TOK_NONE)
						}
						continue
					}
					if TokStore.kind(ts, st) != TT_OPERATOR || TokStore.textEq(ts, st, "=") == false || TokStore.unary(ts, st) != 0{
						continue
					}
					let lt = mut TokStore.left(ts, st)
					if lt == TOK_NONE || TokStore.kind(ts, lt) != TT_KEYWORD || TokStore.textEq(ts, lt, "let") == false || TokStore.isStatic(ts, lt) != 0{
						continue
					}
					let lname = mut TokStore.text(ts, TokStore.listGet(ts, TokStore.childs(ts, lt), 0))
					PDump.putLit(out, "let ")
					PDump.addStrOf(out, ts, nm)
					PDump.putCh(out, '#')
					PDump.putU64(out, j)
					PDump.putCh(out, ' ')
					PDump.putCh(out, 'L')
					PDump.putU64(out, TokStore.line(ts, lt))
					PDump.putCh(out, ' ')
					PDump.addStrOf(out, ts, lname)
					PDump.putCh(out, ' ')
					let lmark = mut TokStore.listSize(ts, rec)
					let ty = mut ? Lets.typeLet(ts, cx, env, st, lim, er)
					if ty == TOK_NONE{
						? StrMap.put(ts, env, lname, TOK_NONE)
						PDump.unsupHead(out, ts, TokStore.right(ts, st))
						PDump.putCh(out, '\n')
						continue
					}
					? StrMap.put(ts, env, lname, ty)
					let cn = mut ? Ty.canonical(ts, tl, ty)
					PDump.addStrOf(out, ts, cn)
					PDump.putCh(out, '\n')
					PDump.putNodes(out, ts, tl, rec, lmark, nm, j, TokStore.line(ts, lt), TokStore.right(ts, st), TOK_NONE)
				}
			}
		}
	}

	/** Registers every global initialiser the way the checker does before it looks at function bodies (stops quietly at the first one Globals.collect rejects). */
	static func collectGlobals(ts: ref mut TokStore, cx: mut u64, w: mut u64, er: mut u64, flatLines: mut u64) void{
		?catch(e){ return }
		let lim = mut ? Expr.limits(ts)
		let n = mut TokStore.listSize(ts, flatLines)
		for i in 0..n{
			let asg = mut Collect.globalLetAssignOf(ts, TokStore.listGet(ts, flatLines, i))
			if asg == TOK_NONE{
				continue
			}
			let ok = mut ? Globals.collect(ts, cx, asg, i, lim, er)
		}
	}

	/** Resolved type of each global initialiser through Globals.collect (Java ParseDump "gexpr"); UNSUP = not covered by Expr yet. */
	static func dumpGexpr(out: ref mut String, ts: ref mut TokStore, tl: mut u64, cx: mut u64, w: mut u64, er: mut u64, flatLines: mut u64, flatSafety: mut u64) void{
		?catch(e){
			Io.eprintLit(e.msg)
			Io.eprintLit("\n")
			PDump.putLit(out, "gexpr ERR\n")
			return
		}
		let lim = mut ? Expr.limits(ts)
		let n = mut TokStore.listSize(ts, flatLines)
		for i in 0..n{
			let asg = mut Collect.globalLetAssignOf(ts, TokStore.listGet(ts, flatLines, i))
			if asg == TOK_NONE{
				continue
			}
			let letTok = mut TokStore.left(ts, asg)
			let nameTok = mut TokStore.listGet(ts, TokStore.childs(ts, letTok), 0)
			let name = mut TokStore.text(ts, nameTok)
			PDump.putLit(out, "gexpr ")
			PDump.addStrOf(out, ts, name)
			PDump.putLit(out, " ")
			let ok = mut ? Globals.collect(ts, cx, asg, i, lim, er)
			if ok == 0{
				PDump.putLit(out, "UNSUP\n")
				continue
			}
			let ty = mut StrMap.get(ts, World.get(ts, w, W_M_GLOBALS), name)
			PDump.tyText(out, ts, tl, ty)
			PDump.putLit(out, " lv=")
			let lv = mut Ty.get(ts, tl, ty, TY_LITVAL)
			if lv == TOK_NONE{
				PDump.putLit(out, "null")
			} else {
				PDump.addStrOf(out, ts, lv)
			}
			PDump.putLit(out, " le=")
			let le = mut Ty.get(ts, tl, ty, TY_LIT_ELEMS)
			if le == TOK_NONE{
				PDump.putLit(out, "~")
			} else {
				let ne = mut TokStore.listSize(ts, le)
				for j in 0..ne{
					PDump.addStrOf(out, ts, TokStore.listGet(ts, le, j))
					PDump.putCh(out, ',')
				}
			}
			PDump.putLit(out, " fl=")
			PDump.putU64(out, Ty.get(ts, tl, ty, TY_FLOAT_LIT))
			PDump.putLit(out, " fal=")
			PDump.putU64(out, Ty.get(ts, tl, ty, TY_FLOAT_ARR_LIT))
			PDump.putLit(out, " ord=")
			PDump.putU64(out, StrMap.get(ts, World.get(ts, w, W_M_GLOBAL_DECL_ORDER), name))
			PDump.putLit(out, " pub=")
			if StrMap.has(ts, World.get(ts, w, W_M_PUBLIC_GLOBALS), name){
				PDump.putU64(out, 1)
			} else {
				PDump.putU64(out, 0)
			}
			PDump.putCh(out, '\n')
		}
		PDump.dumpRootAsm(out, ts, w, flatLines, flatSafety)
	}

	/** Pass 1e: root ASM declarations and invocations in file order, then the registry (Java ParseDump "gexpr" tail). */
	static func dumpRootAsm(out: ref mut String, ts: ref mut TokStore, w: mut u64, flatLines: mut u64, flatSafety: mut u64) void{
		?catch(e){
			Io.eprintLit(e.msg)
			Io.eprintLit("\n")
			PDump.putLit(out, "asm ERR\n")
			return
		}
		let n = mut TokStore.listSize(ts, flatLines)
		for i in 0..n{
			let t = mut TokStore.listGet(ts, TokStore.childs(ts, TokStore.listGet(ts, flatLines, i)), 0)
			let sf = mut TokStore.listGet(ts, flatSafety, i)
			if TokStore.kind(ts, t) == TT_KEYWORD && TokStore.textEq(ts, t, "ASM"){
				? RootAsm.declare(ts, w, t, sf)
			}
			else if TokStore.kind(ts, t) == TT_VARREF{
				? RootAsm.invoke(ts, w, t, sf)
			}
		}
		let m = mut World.get(ts, w, W_M_ROOT_ASMS)
		let keys = mut ? Collect.sortedKeys(ts, m)
		let nk = mut TokStore.listSize(ts, keys)
		for k in 0..nk{
			let nm = mut TokStore.listGet(ts, keys, k)
			PDump.putLit(out, "asm ")
			PDump.addStrOf(out, ts, nm)
			PDump.putLit(out, " ")
			let rawT = mut StrMap.get(ts, m, nm)
			if rawT == TOK_NONE{
				PDump.putLit(out, "UNSUP\n")
			} else {
				PDump.putU64(out, TokStore.strLen(ts, rawT))
				PDump.putCh(out, '\n')
			}
		}
	}

	/** Pass 1a.5 flatten, externs, plain funcs and exports; prints the registries (one "funcs ERR" line if any step throws). */
	static func dumpFuncs(out: ref mut String, ts: ref mut TokStore, w: mut u64, tl: mut u64, sr: mut u64, er: mut u64, ir: mut u64, cx: mut u64, flatLines: mut u64, flatSafety: mut u64, lets: mut u64) void{
		?catch(e){
			Io.eprintLit(e.msg)
			Io.eprintLit("\n")
			if lets == 2{
				PDump.putLit(out, "VERDICT ERR\n")
				return
			}
			PDump.putLit(out, "funcs ERR\n")
			return
		}
		let fl = mut TokStore.listGet(ts, cx, 7)
		let xr = mut TokStore.listGet(ts, cx, 8)
		let order = mut World.get(ts, w, W_L_STRUCT_ORDER)
		let ns = mut TokStore.listSize(ts, order)
		for i in 0..ns{
			let sn = mut TokStore.listGet(ts, order, i)
			? Flatten.flattenStruct(ts, cx, er, sn)
		}
		let ik = mut ? Collect.sortedKeys(ts, World.get(ts, w, W_M_IFACES))
		let ni = mut TokStore.listSize(ts, ik)
		for i in 0..ni{
			let inm = mut TokStore.listGet(ts, ik, i)
			? Flatten.flattenInterface(ts, w, ir, inm)
		}
		let n = mut TokStore.listSize(ts, flatLines)
		for i in 0..n{
			let t = mut TokStore.listGet(ts, TokStore.childs(ts, TokStore.listGet(ts, flatLines, i)), 0)
			if TokStore.kind(ts, t) == TT_KEYWORD && TokStore.textEq(ts, t, "extern"){
				? Funcs.collectExtern(ts, cx, t)
			}
		}
		for i in 0..n{
			let t = mut TokStore.listGet(ts, TokStore.childs(ts, TokStore.listGet(ts, flatLines, i)), 0)
			if TokStore.textEq(ts, t, "func"){
				let sf = mut TokStore.listGet(ts, flatSafety, i)
				? Funcs.collectFunc(ts, cx, t, sf, i)
			}
			else if TokStore.textEq(ts, t, "impl"){
				let sf = mut TokStore.listGet(ts, flatSafety, i)
				? ImplColl.collectImpl(ts, cx, t, sf, i)
			}
			else if TokStore.kind(ts, t) == TT_KEYWORD && TokStore.textEq(ts, t, "library"){
				let sf = mut TokStore.listGet(ts, flatSafety, i)
				? Impls.collectLibrary(ts, cx, t, sf, i)
			}
		}
		for i in 0..n{
			let t = mut TokStore.listGet(ts, TokStore.childs(ts, TokStore.listGet(ts, flatLines, i)), 0)
			if TokStore.kind(ts, t) == TT_KEYWORD && TokStore.textEq(ts, t, "export"){
				? Funcs.collectExport(ts, cx, t)
			}
		}
		? Impls.mangleOverloads(ts, cx)
		let libKeys = mut TokStore.listGet(ts, World.get(ts, w, W_M_LIBS), 0)
		let nlk = mut TokStore.listSize(ts, libKeys)
		for i in 0..nlk{
			let ln = mut TokStore.listGet(ts, libKeys, i)
			? Impls.flattenLibrary(ts, cx, ln)
		}
		? Hier.checkImplementsContract(ts, cx)
		? Hier.generateClassEnum(ts, cx)
		? Hier.generateEnumForEnums(ts, cx)
		? Hier.generateInterfaceDispatchers(ts, cx)
		if lets != 0{
			PDump.collectGlobals(ts, cx, w, er, flatLines)
			if lets == 2{
				let scratch = mut ? new String()
				PDump.dumpLets(scratch, ts, w, tl, cx, er)
				? Checks.run(out, ts, w, tl, cx, er)
				PDump.putLit(out, "VERDICT OK\n")
				return
			}
			PDump.dumpLets(out, ts, w, tl, cx, er)
			return
		}
		let fk = mut ? Collect.sortedKeys(ts, World.get(ts, w, W_M_FUNCS))
		let nf = mut TokStore.listSize(ts, fk)
		for i in 0..nf{
			let nm = mut TokStore.listGet(ts, fk, i)
			let ov = mut StrMap.get(ts, World.get(ts, w, W_M_FUNCS), nm)
			let no = mut TokStore.listSize(ts, ov)
			for j in 0..no{
				let fi = mut TokStore.listGet(ts, ov, j)
				PDump.putLit(out, "func ")
				PDump.addStrOf(out, ts, nm)
				PDump.putLit(out, " p=")
				PDump.tyList(out, ts, tl, Infos.fget(ts, fl, fi, FI_PARAM_TYPES))
				PDump.putLit(out, " r=")
				PDump.tyText(out, ts, tl, Infos.fget(ts, fl, fi, FI_RETURN))
				PDump.putLit(out, " m=")
				PDump.addStrOf(out, ts, Infos.fget(ts, fl, fi, FI_MANGLED))
				PDump.putLit(out, " cc=")
				PDump.addStrOf(out, ts, Infos.fget(ts, fl, fi, FI_CALL_CONV))
				PDump.putLit(out, " a=")
				PDump.putU64(out, Infos.fget(ts, fl, fi, FI_ASYNC))
				PDump.putLit(out, " t=")
				PDump.putU64(out, Infos.fget(ts, fl, fi, FI_THROWS))
				PDump.putLit(out, " pub=")
				PDump.putU64(out, Infos.fget(ts, fl, fi, FI_PUBLIC))
				PDump.putLit(out, " ctor=")
				PDump.putU64(out, Infos.fget(ts, fl, fi, FI_CONSTRUCTOR))
				PDump.putLit(out, " exp=")
				PDump.putU64(out, Infos.fget(ts, fl, fi, FI_EXPORTED))
				PDump.putLit(out, " ord=")
				PDump.putU64(out, Infos.fget(ts, fl, fi, FI_DECL_ORDER))
				PDump.putCh(out, '\n')
			}
		}
		let mr2 = mut TokStore.listGet(ts, cx, 14)
		let implsByType = mut World.get(ts, w, W_M_IMPLS_BY_TYPE)
		let ck = mut ? Collect.sortedKeys(ts, implsByType)
		let nck = mut TokStore.listSize(ts, ck)
		for i in 0..nck{
			let cn = mut TokStore.listGet(ts, ck, i)
			let il = mut StrMap.get(ts, implsByType, cn)
			let nil = mut TokStore.listSize(ts, il)
			for j in 0..nil{
				let im = mut TokStore.listGet(ts, il, j)
				PDump.putLit(out, "impl ")
				let ifn = mut Infos.rget(ts, mr2, 12, im, IM_INTERFACE)
				if ifn == TOK_NONE{
					PDump.putCh(out, '-')
				}
				else{
					PDump.addStrOf(out, ts, ifn)
				}
				PDump.putCh(out, ' ')
				PDump.addStrOf(out, ts, cn)
				PDump.putLit(out, " pub=")
				PDump.putU64(out, Infos.rget(ts, mr2, 12, im, IM_PUBLIC))
				PDump.putLit(out, " st=")
				PDump.addStrOf(out, ts, Infos.rget(ts, mr2, 12, im, IM_SAFETY))
				PDump.putCh(out, '\n')
				for pass in 0..2{
					let mslot = mut IM_METHODS
					let oslot = mut IM_OVERLOADS
					if pass == 1{
						mslot = IM_STATIC_METHODS
						oslot = IM_STATIC_OVERLOADS
					}
					let mm = mut Infos.rget(ts, mr2, 12, im, mslot)
					let mkeys = mut TokStore.listGet(ts, mm, 0)
					let mvals = mut TokStore.listGet(ts, mm, 1)
					let nmk = mut TokStore.listSize(ts, mkeys)
					for q in 0..nmk{
						let fi = mut TokStore.listGet(ts, mvals, q)
						if pass == 0{
							PDump.putLit(out, " m ")
						}
						else{
							PDump.putLit(out, " s ")
						}
						PDump.addStrOf(out, ts, TokStore.listGet(ts, mkeys, q))
						PDump.putCh(out, ' ')
						PDump.addStrOf(out, ts, Infos.fget(ts, fl, fi, FI_MANGLED))
						PDump.putLit(out, " p=")
						PDump.tyList(out, ts, tl, Infos.fget(ts, fl, fi, FI_PARAM_TYPES))
						PDump.putLit(out, " r=")
						PDump.tyText(out, ts, tl, Infos.fget(ts, fl, fi, FI_RETURN))
						PDump.putLit(out, " pub=")
						PDump.putU64(out, Infos.fget(ts, fl, fi, FI_PUBLIC))
						PDump.putLit(out, " ord=")
						PDump.putU64(out, Infos.fget(ts, fl, fi, FI_DECL_ORDER))
						PDump.putLit(out, " a=")
						PDump.putU64(out, Infos.fget(ts, fl, fi, FI_ASYNC))
						PDump.putLit(out, " t=")
						PDump.putU64(out, Infos.fget(ts, fl, fi, FI_THROWS))
						PDump.putCh(out, '\n')
					}
					let om = mut Infos.rget(ts, mr2, 12, im, oslot)
					let okeys = mut TokStore.listGet(ts, om, 0)
					let ovals = mut TokStore.listGet(ts, om, 1)
					let nok = mut TokStore.listSize(ts, okeys)
					for q in 0..nok{
						if pass == 0{
							PDump.putLit(out, " mo ")
						}
						else{
							PDump.putLit(out, " so ")
						}
						PDump.addStrOf(out, ts, TokStore.listGet(ts, okeys, q))
						PDump.putCh(out, ' ')
						let ol = mut TokStore.listGet(ts, ovals, q)
						let nol = mut TokStore.listSize(ts, ol)
						for z in 0..nol{
							PDump.addStrOf(out, ts, Infos.fget(ts, fl, TokStore.listGet(ts, ol, z), FI_MANGLED))
							PDump.putCh(out, ';')
						}
						PDump.putCh(out, '\n')
					}
				}
				let gm = mut Infos.rget(ts, mr2, 12, im, IM_GENERIC_TEMPLATES)
				let gkeys = mut TokStore.listGet(ts, gm, 0)
				let ngk = mut TokStore.listSize(ts, gkeys)
				for q in 0..ngk{
					PDump.putLit(out, " g ")
					PDump.addStrOf(out, ts, TokStore.listGet(ts, gkeys, q))
					PDump.putCh(out, '\n')
				}
			}
		}
		let uk = mut ? Collect.sortedKeys(ts, World.get(ts, w, W_M_UNAVAILABLE_GENERIC))
		let nuk = mut TokStore.listSize(ts, uk)
		for i in 0..nuk{
			let k = mut TokStore.listGet(ts, uk, i)
			PDump.putLit(out, "unavail ")
			PDump.addStrOf(out, ts, k)
			PDump.putCh(out, ' ')
			PDump.putU64(out, TokStore.listSize(ts, StrMap.get(ts, World.get(ts, w, W_M_UNAVAILABLE_GENERIC), k)))
			PDump.putCh(out, '\n')
		}
		let enk = mut ? Collect.sortedKeys(ts, World.get(ts, w, W_M_ENUMS))
		let nek = mut TokStore.listSize(ts, enk)
		let erl = mut TokStore.listGet(ts, cx, 6)
		for i in 0..nek{
			let en = mut TokStore.listGet(ts, enk, i)
			let isSynth = mut TokStore.strEq(ts, en, "Class")
			if TokStore.strLen(ts, en) > 10 && TokStore.strCh(ts, en, 0) == '$'{
				isSynth = true
			}
			if isSynth{
				let erow = mut StrMap.get(ts, World.get(ts, w, W_M_ENUMS), en)
				PDump.putLit(out, "genum ")
				PDump.addStrOf(out, ts, en)
				PDump.putLit(out, " v=")
				let vs = mut Infos.rget(ts, erl, 8, erow, EI_VARIANTS)
				let vals = mut Infos.rget(ts, erl, 8, erow, EI_VALUES)
				let nv = mut TokStore.listSize(ts, vs)
				for q in 0..nv{
					PDump.addStrOf(out, ts, TokStore.listGet(ts, vs, q))
					PDump.putCh(out, ',')
				}
				PDump.putLit(out, " vals=")
				for q in 0..nv{
					PDump.putU64(out, TokStore.listGet(ts, vals, q))
					PDump.putCh(out, ',')
				}
				PDump.putCh(out, '\n')
			}
		}
		let lk = mut ? Collect.sortedKeys(ts, World.get(ts, w, W_M_LIBS))
		let nl2 = mut TokStore.listSize(ts, lk)
		let lr = mut TokStore.listGet(ts, cx, 9)
		for i in 0..nl2{
			let ln = mut TokStore.listGet(ts, lk, i)
			let lrow = mut StrMap.get(ts, World.get(ts, w, W_M_LIBS), ln)
			let flat = mut Infos.rget(ts, lr, 8, lrow, LI_FUNCS)
			let fnk = mut ? Collect.sortedKeys(ts, flat)
			let nfk = mut TokStore.listSize(ts, fnk)
			for j in 0..nfk{
				let fnm = mut TokStore.listGet(ts, fnk, j)
				let ovs = mut StrMap.get(ts, flat, fnm)
				let nov = mut TokStore.listSize(ts, ovs)
				for q in 0..nov{
					let fi = mut TokStore.listGet(ts, ovs, q)
					PDump.putLit(out, "libfn ")
					PDump.addStrOf(out, ts, ln)
					PDump.putCh(out, ' ')
					PDump.addStrOf(out, ts, fnm)
					PDump.putLit(out, " p=")
					PDump.tyList(out, ts, tl, Infos.fget(ts, fl, fi, FI_PARAM_TYPES))
					PDump.putLit(out, " r=")
					PDump.tyText(out, ts, tl, Infos.fget(ts, fl, fi, FI_RETURN))
					PDump.putLit(out, " m=")
					PDump.addStrOf(out, ts, Infos.fget(ts, fl, fi, FI_MANGLED))
					PDump.putLit(out, " ord=")
					PDump.putU64(out, Infos.fget(ts, fl, fi, FI_DECL_ORDER))
					PDump.putCh(out, '\n')
				}
			}
		}
		let xk = mut ? Collect.sortedKeys(ts, World.get(ts, w, W_M_EXTERNS))
		let nx = mut TokStore.listSize(ts, xk)
		for i in 0..nx{
			let nm = mut TokStore.listGet(ts, xk, i)
			let xi = mut StrMap.get(ts, World.get(ts, w, W_M_EXTERNS), nm)
			PDump.putLit(out, "extern ")
			PDump.addStrOf(out, ts, nm)
			PDump.putLit(out, " link=")
			PDump.addStrOf(out, ts, Infos.rget(ts, xr, 8, xi, XI_LINK))
			PDump.putLit(out, " cc=")
			PDump.addStrOf(out, ts, Infos.rget(ts, xr, 8, xi, XI_CALL_CONV))
			PDump.putLit(out, " va=")
			PDump.putU64(out, Infos.rget(ts, xr, 8, xi, XI_VARARGS))
			PDump.putLit(out, " p=")
			PDump.tyList(out, ts, tl, Infos.rget(ts, xr, 8, xi, XI_PARAMS))
			PDump.putLit(out, " r=")
			PDump.tyText(out, ts, tl, Infos.rget(ts, xr, 8, xi, XI_RETURN))
			PDump.putCh(out, '\n')
		}
		let gk = mut ? Collect.sortedKeys(ts, World.get(ts, w, W_M_GHOST_FUNCS))
		let ng = mut TokStore.listSize(ts, gk)
		for i in 0..ng{
			let nm = mut TokStore.listGet(ts, gk, i)
			let fi = mut StrMap.get(ts, World.get(ts, w, W_M_GHOST_FUNCS), nm)
			PDump.putLit(out, "ghost ")
			PDump.addStrOf(out, ts, nm)
			PDump.putCh(out, '=')
			PDump.addStrOf(out, ts, Infos.fget(ts, fl, fi, FI_NAME))
			PDump.putCh(out, '\n')
		}
		let dk = mut ? Collect.sortedKeys(ts, World.get(ts, w, W_M_DROP_HOOK_OWNERS))
		let nd = mut TokStore.listSize(ts, dk)
		for i in 0..nd{
			let nm = mut TokStore.listGet(ts, dk, i)
			PDump.putLit(out, "drop ")
			PDump.addStrOf(out, ts, nm)
			PDump.putCh(out, '=')
			PDump.addStrOf(out, ts, StrMap.get(ts, World.get(ts, w, W_M_DROP_HOOK_OWNERS), nm))
			PDump.putCh(out, '\n')
		}
		let ek = mut ? Collect.sortedKeys(ts, World.get(ts, w, W_M_EXPORTED))
		let ne = mut TokStore.listSize(ts, ek)
		for i in 0..ne{
			PDump.putLit(out, "export ")
			PDump.addStrOf(out, ts, TokStore.listGet(ts, ek, i))
			PDump.putCh(out, '\n')
		}
	}

	static func dumpFlat(out: ref mut String, ts: ref mut TokStore, w: mut u64, tl: mut u64, sr: mut u64, er: mut u64, cx: mut u64) void{
		let order = mut World.get(ts, w, W_L_STRUCT_ORDER)
		let ns = mut TokStore.listSize(ts, order)
		for i in 0..ns{
			PDump.dumpOneFlat(out, ts, tl, sr, er, cx, TokStore.listGet(ts, order, i))
		}
		PDump.dumpIfaceFlat(out, ts, w, TokStore.listGet(ts, cx, CX_IR))
	}

	static func dumpTypes(out: ref mut String, ts: ref mut TokStore, w: mut u64, tl: mut u64, sr: mut u64, cx: mut u64) void{
		let order = mut World.get(ts, w, W_L_STRUCT_ORDER)
		let ns = mut TokStore.listSize(ts, order)
		for i in 0..ns{
			PDump.dumpStructTypes(out, ts, tl, sr, cx, TokStore.listGet(ts, order, i))
		}
	}

	/** The pass-1a registry dump (Java ParseDump "decl" stage format). */
	static func dumpDecl(out: ref mut String, ts: ref mut TokStore, w: mut u64, sr: mut u64, er: mut u64, ir: mut u64, mr: mut u64, lr: mut u64) void{
		?catch(e){ return }
		let order = mut World.get(ts, w, W_L_STRUCT_ORDER)
		let ns = mut TokStore.listSize(ts, order)
		let structs = mut World.get(ts, w, W_M_STRUCTS)
		for i in 0..ns{
			let nm = mut TokStore.listGet(ts, order, i)
			let row = mut StrMap.get(ts, structs, nm)
			PDump.putLit(out, "struct ")
			PDump.addStrOf(out, ts, nm)
			PDump.putLit(out, " pub=")
			PDump.putU64(out, Infos.sget(ts, sr, row, SI_PUBLIC))
			PDump.putLit(out, " impl=")
			PDump.joinSids(out, ts, Infos.sget(ts, sr, row, SI_IMPLEMENTS), ',')
			PDump.putCh(out, '\n')
		}
		let ek = mut ? Collect.sortedKeys(ts, World.get(ts, w, W_M_ENUMS))
		let ne = mut TokStore.listSize(ts, ek)
		for i in 0..ne{
			let nm = mut TokStore.listGet(ts, ek, i)
			let row = mut StrMap.get(ts, World.get(ts, w, W_M_ENUMS), nm)
			PDump.putLit(out, "enum ")
			PDump.addStrOf(out, ts, nm)
			PDump.putLit(out, " ne=")
			PDump.putU64(out, Infos.rget(ts, er, 8, row, EI_NON_EXHAUSTIVE))
			PDump.putLit(out, " v=")
			PDump.joinSids(out, ts, Infos.rget(ts, er, 8, row, EI_VARIANTS), ',')
			let vals = mut Infos.rget(ts, er, 8, row, EI_VALUES)
			if vals != TOK_NONE{
				PDump.putLit(out, " vals=")
				PDump.u64List(out, ts, vals)
			}
			let rs = mut Infos.rget(ts, er, 8, row, EI_RANGE_STARTS)
			if rs != TOK_NONE{
				PDump.putLit(out, " rs=")
				PDump.u64List(out, ts, rs)
				PDump.putLit(out, " re=")
				PDump.u64List(out, ts, Infos.rget(ts, er, 8, row, EI_RANGE_ENDS))
			}
			PDump.putCh(out, '\n')
		}
		let ik = mut ? Collect.sortedKeys(ts, World.get(ts, w, W_M_IFACES))
		let ni = mut TokStore.listSize(ts, ik)
		for i in 0..ni{
			let nm = mut TokStore.listGet(ts, ik, i)
			let row = mut StrMap.get(ts, World.get(ts, w, W_M_IFACES), nm)
			PDump.putLit(out, "interface ")
			PDump.addStrOf(out, ts, nm)
			PDump.putLit(out, " pub=")
			PDump.putU64(out, Infos.rget(ts, ir, 8, row, II_PUBLIC))
			PDump.putLit(out, " ext=")
			PDump.joinSids(out, ts, Infos.rget(ts, ir, 8, row, II_EXTENDS), ',')
			PDump.putLit(out, " m=")
			let own = mut Infos.rget(ts, ir, 8, row, II_OWN_METHODS)
			let okeys = mut TokStore.listGet(ts, own, 0)
			let ovals = mut TokStore.listGet(ts, own, 1)
			let nm2 = mut TokStore.listSize(ts, okeys)
			for j in 0..nm2{
				PDump.addStrOf(out, ts, TokStore.listGet(ts, okeys, j))
				let sig = mut TokStore.listGet(ts, ovals, j)
				if Infos.rget(ts, mr, 8, sig, MS_STATIC) != 0{
					PDump.putLit(out, "!s")
				}
				if Infos.rget(ts, mr, 8, sig, MS_DEFAULT) != 0{
					PDump.putLit(out, "!d")
				}
				PDump.putCh(out, ',')
			}
			PDump.putCh(out, '\n')
		}
		let lk = mut ? Collect.sortedKeys(ts, World.get(ts, w, W_M_LIBS))
		let nl = mut TokStore.listSize(ts, lk)
		for i in 0..nl{
			let nm = mut TokStore.listGet(ts, lk, i)
			let row = mut StrMap.get(ts, World.get(ts, w, W_M_LIBS), nm)
			PDump.putLit(out, "library ")
			PDump.addStrOf(out, ts, nm)
			PDump.putLit(out, " pub=")
			PDump.putU64(out, Infos.rget(ts, lr, 8, row, LI_PUBLIC))
			PDump.putLit(out, " ext=")
			PDump.joinSids(out, ts, Infos.rget(ts, lr, 8, row, LI_EXTENDS), ',')
			PDump.putCh(out, '\n')
		}
		let ak = mut ? Collect.sortedKeys(ts, World.get(ts, w, W_M_ALIAS_RAW_TARGETS))
		let na = mut TokStore.listSize(ts, ak)
		for i in 0..na{
			let nm = mut TokStore.listGet(ts, ak, i)
			PDump.putLit(out, "alias ")
			PDump.addStrOf(out, ts, nm)
			PDump.putLit(out, " n=")
			PDump.putU64(out, TokStore.listSize(ts, StrMap.get(ts, World.get(ts, w, W_M_ALIAS_RAW_TARGETS), nm)))
			PDump.putCh(out, '\n')
		}
		let ck = mut ? Collect.sortedKeys(ts, World.get(ts, w, W_M_CONST_EXPRS))
		let nc = mut TokStore.listSize(ts, ck)
		for i in 0..nc{
			PDump.putLit(out, "const ")
			PDump.addStrOf(out, ts, TokStore.listGet(ts, ck, i))
			PDump.putCh(out, '\n')
		}
	}

	@pub
	@throws
	static func run(stage: ref imut String, path: ref imut String, stdlib: ref imut String) mut u64{
		?catch(e){ throw e }
		let pathCopy = mut ? new String()
		match Some(path){ pathCopy = ? Txt.copy(path) }
		let:<owns mut String> base = mut null
		match Some(path){ base = Io.pathName(path) }
		let src = mut ? new String()
		match Some(path){ src = ? Io.readFile(path) }
		let roots = mut ? String.from("*")
		let cur = mut ? new LexCursor()
		let result = mut ? new LexResult()
		match Some(base){
			result = ? Lexer.tokenize(src, base, roots, pathCopy, cur)
		}
		let ts = mut ? TokStore.make()
		let fileId = mut ? TokStore.internFile(ts, path)
		let flat = mut ? ParserLines.toTokens(ts, result.tokens, fileId)
		let res = mut ? ParserLines.nest(ts, flat)
		if Txt.eqLit(stage, "resolved") || Txt.eqLit(stage, "dup") || Txt.eqLit(stage, "generics") || Txt.eqLit(stage, "decl") || Txt.eqLit(stage, "gexpr") || (Txt.eqLit(stage, "lets") || Txt.eqLit(stage, "verdict")) || Txt.eqLit(stage, "types") || Txt.eqLit(stage, "flat") || Txt.eqLit(stage, "funcs") || (Txt.eqLit(stage, "lets") || Txt.eqLit(stage, "verdict")){
			let treeStage = mut ? String.from("tree")
			res = ? ParserLines.runStage(ts, treeStage, res)
			let cwdList = mut ? new ObjectList:<String>()
			let pwdCmd = mut ? String.from("pwd")
			let pc = mut Io.collect(pwdCmd, cwdList)
			let cwdStr = mut cwdList.get(cwdList, 0)
			let cwdSid = mut ? TokStore.addStr(ts, cwdStr)
			let stdSid = mut ? TokStore.addStr(ts, stdlib)
			let platSid = mut ? TokStore.addLit(ts, "linux")
			let resolver = mut ? new ImportResolver(ts, stdSid, platSid, cwdSid)
			res = ? ImportResolver.resolve(resolver, ts, res, fileId)
			if Txt.eqLit(stage, "dup") || Txt.eqLit(stage, "generics") || Txt.eqLit(stage, "decl") || Txt.eqLit(stage, "gexpr") || (Txt.eqLit(stage, "lets") || Txt.eqLit(stage, "verdict")) || Txt.eqLit(stage, "types") || Txt.eqLit(stage, "flat") || Txt.eqLit(stage, "funcs") || (Txt.eqLit(stage, "lets") || Txt.eqLit(stage, "verdict")){
				? DupExpander.expand(ts, res)
			}
			if Txt.eqLit(stage, "generics") || Txt.eqLit(stage, "decl") || Txt.eqLit(stage, "gexpr") || (Txt.eqLit(stage, "lets") || Txt.eqLit(stage, "verdict")) || Txt.eqLit(stage, "types") || Txt.eqLit(stage, "flat") || Txt.eqLit(stage, "funcs") || (Txt.eqLit(stage, "lets") || Txt.eqLit(stage, "verdict")){
				res = ? GenericsExpander.expand(ts, res)
			}
		} else {
			res = ? ParserLines.runStage(ts, stage, res)
		}
		let extraFlag = mut 0
		if Txt.eqLit(stage, "generics"){
			extraFlag = 1
		}
		let out = mut ? new String()
		if Txt.eqLit(stage, "types") || Txt.eqLit(stage, "flat") || Txt.eqLit(stage, "funcs") || (Txt.eqLit(stage, "lets") || Txt.eqLit(stage, "verdict")){
			let w = mut ? World.make(ts)
			let sr = mut ? TokStore.newList(ts)
			let er = mut ? TokStore.newList(ts)
			let ir = mut ? TokStore.newList(ts)
			let mr = mut ? TokStore.newList(ts)
			let lr = mut ? TokStore.newList(ts)
			let flatLines = mut ? TokStore.newList(ts)
			let flatSafety = mut ? TokStore.newList(ts)
			? Collect.flattenRootLines(ts, res, flatLines, flatSafety)
			? Collect.pass1a(ts, w, sr, er, ir, mr, lr, flatLines)
			let tl = mut ? TokStore.newList(ts)
			let ccs = mut ? StrMap.make(ts)
			let c1 = mut ? TokStore.addLit(ts, "win64")
			let c2 = mut ? TokStore.addLit(ts, "sysv_x64")
			let c3 = mut ? TokStore.addLit(ts, "arm64")
			? StrMap.put(ts, ccs, c1, 1)
			? StrMap.put(ts, ccs, c2, 1)
			? StrMap.put(ts, ccs, c3, 1)
			let cx = mut ? TypeAnn.makeCx(ts, w, tl, c1, ccs, sr, ir)
			if Txt.eqLit(stage, "funcs") || (Txt.eqLit(stage, "lets") || Txt.eqLit(stage, "verdict")){
				let fl = mut ? TokStore.newList(ts)
				let xr = mut ? TokStore.newList(ts)
				? Funcs.extendCx(ts, cx, er, fl, xr)
				let imr = mut ? TokStore.newList(ts)
				? Funcs.extendCx2(ts, cx, lr, mr, imr)
				let letsFlag = mut 0
				if Txt.eqLit(stage, "lets"){
					letsFlag = 1
				}
				if Txt.eqLit(stage, "verdict"){
					letsFlag = 2
				}
				PDump.dumpFuncs(out, ts, w, tl, sr, er, ir, cx, flatLines, flatSafety, letsFlag)
			}
			else if Txt.eqLit(stage, "flat"){
				PDump.dumpFlat(out, ts, w, tl, sr, er, cx)
			}
			else{
				PDump.dumpTypes(out, ts, w, tl, sr, cx)
			}
			Io.oprint(out)
			return 0
		}
		if Txt.eqLit(stage, "gexpr"){
			let w = mut ? World.make(ts)
			let sr = mut ? TokStore.newList(ts)
			let er = mut ? TokStore.newList(ts)
			let ir = mut ? TokStore.newList(ts)
			let mr = mut ? TokStore.newList(ts)
			let lr = mut ? TokStore.newList(ts)
			let flatLines = mut ? TokStore.newList(ts)
			let flatSafety = mut ? TokStore.newList(ts)
			? Collect.flattenRootLines(ts, res, flatLines, flatSafety)
			? Collect.pass1a(ts, w, sr, er, ir, mr, lr, flatLines)
			let tl = mut ? TokStore.newList(ts)
			let ccs = mut ? StrMap.make(ts)
			let c1 = mut ? TokStore.addLit(ts, "win64")
			let c2 = mut ? TokStore.addLit(ts, "sysv_x64")
			let c3 = mut ? TokStore.addLit(ts, "arm64")
			? StrMap.put(ts, ccs, c1, 1)
			? StrMap.put(ts, ccs, c2, 1)
			? StrMap.put(ts, ccs, c3, 1)
			let cx = mut ? TypeAnn.makeCx(ts, w, tl, c1, ccs, sr, ir)
			PDump.dumpGexpr(out, ts, tl, cx, w, er, flatLines, flatSafety)
			Io.oprint(out)
			return 0
		}
		if Txt.eqLit(stage, "decl"){
			let w = mut ? World.make(ts)
			let sr = mut ? TokStore.newList(ts)
			let er = mut ? TokStore.newList(ts)
			let ir = mut ? TokStore.newList(ts)
			let mr = mut ? TokStore.newList(ts)
			let lr = mut ? TokStore.newList(ts)
			let flatLines = mut ? TokStore.newList(ts)
			let flatSafety = mut ? TokStore.newList(ts)
			? Collect.flattenRootLines(ts, res, flatLines, flatSafety)
			? Collect.pass1a(ts, w, sr, er, ir, mr, lr, flatLines)
			PDump.dumpDecl(out, ts, w, sr, er, ir, mr, lr)
			Io.oprint(out)
			return 0
		}
		? PDump.dumpTree(out, ts, res, extraFlag)
		Io.oprint(out)
		return 0
	}
}

func main(args: owns some mut dynarray(imut dynarray(imut char))) void{
	?catch(e){
		Io.eprintLit("error\n")
		Io.oprintLit("ERROR\n")
		unsafe extern{ exit(0) }
		return
	}
	let n = mut len(args)
	let stage = mut ? new String()
	let path = mut ? new String()
	if n > 2{
		match 1 in args{
			let one = mut args[1]
			let m = mut len(one)
			for k in 0..m{
				match k in one{ ? stage.appendChar(stage, one[k]) }
			}
		}
		match 2 in args{
			let two = mut args[2]
			let m2 = mut len(two)
			for k2 in 0..m2{
				match k2 in two{ ? path.appendChar(path, two[k2]) }
			}
		}
	}
	let stdlib = mut ? String.from("/home/claude/caspien/stdlib")
	if n > 3{
		match 3 in args{
			stdlib = ? new String()
			let three = mut args[3]
			let m3 = mut len(three)
			for k3 in 0..m3{
				match k3 in three{ ? stdlib.appendChar(stdlib, three[k3]) }
			}
		}
	}
	let code = mut ? PDump.run(stage, path, stdlib)
	unsafe extern{ exit(wrap:<u32>(code)) }
}
