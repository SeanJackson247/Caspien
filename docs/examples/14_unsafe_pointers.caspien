// Raw pointers, pointer arithmetic, `memcopy`, and calling C. Everything here sits in `unsafe`.
// Expected output:
//   span=5 sum=105 third=21 bytes=40
//   abs=42 strlen=12 atoi=123 sum=165
//   OK
import "../../stdlib/libc.caspien"

// `@link_name` gives a C function a different Caspien name.
@link_name(labs)
extern c_abs(mut s64) mut s64
extern atoi(static imut string) mut s64

func main() void{
	let count = mut 5
	let bytes = mut (count * sizeof(u64))
	unsafe assume deref extern memcopy raw{
		let base = mut malloc(bytes)            // a `raw u8`
		let p = mut (base as u64)               // widening the pointee makes it a `raw u64`: it now steps by 8
		let start = mut p
		for i in 0..count{
			let v = mut (i * 10 + 1)
			memcopy(p, mut 8, raw v)            // memcopy(destination, byteCount, source)
			p++                                 // advances sizeof(u64) = 8 bytes
		}
		let span = mut (p - start)              // pointer difference counts elements, not bytes
		let q = mut start
		let sum = mut 0
		for i in 0..count{
			assume match Some(q)
			sum += deref(q)                     // deref reads; it is never an assignment target
			q++
		}
		let third = mut (start + 2)
		assume match Some(third)
		let t = mut deref(third)
		printf("span=%lld sum=%llu third=%llu bytes=%llu\n", span, sum, t, bytes)
		free(base)
	}

	let n = mut -42
	unsafe extern{
		let a = mut c_abs(n)
		let len = mut strlen("hello, world")
		let v = mut atoi("123")
		let total = mut (a + v)
		printf("abs=%lld strlen=%llu atoi=%lld sum=%lld\n", a, len, v, total)
		putchar(79)
		putchar(75)
		putchar(10)
	}
}
