// Child processes, threads and sleeping. `spawn` runs a shell command through popen and is one-directional: a handle is opened for reading the child's
// output OR for writing to its input, chosen by `ProcessMode`. `StdOut.read` returns one line; `closeProcess` waits for the child and gives its
// exit status. `sleep(seconds)` is a keyword that needs stdlib/sleep.caspien in the program; it returns the seconds left if it was interrupted.
// Expected output:
//   child said: hello from the child
//   child exit status: 0
//   slept, 0 seconds left
//   await: 42
import "../../stdlib/libc.caspien"
import "../../stdlib/gt/*"
import "../../stdlib/process.caspien"
import "../../stdlib/sleep.caspien"
import "../../stdlib/par_call.caspien"
import "../../stdlib/await_call.caspien"

// An @async function can run on its own OS thread: `await f(x)` starts it and waits for the result, `par f(x)` starts it and returns a handle at once.
// Starting a thread can fail, so both go through `?`. (More in 16_atomics_and_locks.)
@async
func triple(x: mut u64) mut u64{
	return x * 3
}

func main() void{
	?catch(e){ return }
	let p = mut ? spawn("echo hello from the child", imut ProcessMode.READ)
	let line = imut StdOut.read(p.stream)
	unsafe extern{ printf("child said: %s", line) }          // the line keeps its newline
	let status = mut closeProcess(p)
	unsafe extern{ printf("child exit status: %llu\n", status) }

	let left = mut sleep(1)
	unsafe extern{ printf("slept, %llu seconds left\n", left) }

	let r = mut ? await triple(mut 14)
	unsafe extern{ printf("await: %llu\n", r) }
}
