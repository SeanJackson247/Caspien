// One `unsafe` block for every tag, each naming exactly the reasons it needs (a missing or extra tag is a compile error).
// Tags: extern memcopy raw deref clone global loop udyn udyn:owns assume call asm async guard atomic (and `unaudited`, the catch-all, at the end)
// Expected output:
//   extern: 5
//   raw+memcopy+deref+assume: 7 7
//   clone: 4 4
//   global: 3
//   loop: 5
//   udyn: 30
//   udyn:owns: 9
//   call: 11
//   asm: 42
//   async: 6
//   guard: held=0 total=11
//   atomic: 2
//   unaudited: 6
import "../../stdlib/libc.caspien"
import "../../stdlib/gt/*"
import "../../stdlib/par_call.caspien"
import "../../stdlib/await_call.caspien"
import "../../stdlib/guard.caspien"

struct World{@pub{
	ticks: mut u64
}}
struct Holder{@pub{
	w: owns some mut World
}}

// `asm`: a function defined in assembly (root-level blocks take no tags), called through `extern`.
unsafe{
ASM {
.text
.globl answer
answer:
	mov $42, %rax
	ret
}
}
extern answer() mut u64

// `global`: a mutable static that is not atomic or lock-protected.
let static counter = mut 0

// `atomic`: a swap mutex struct; its state field (like any atomic) may only be touched outside `match @lock` with the `atomic` tag.
enum St{ OPEN, CLOSED }
struct Mtx{@pub{
	swap lockState: atomic mut St
	n: mut u64
}}

// `guard`: a `@guard` type used without `lock x{ }`.
struct Gate{@pub{
	n: mut u64
}}
struct Marker{@pub{
	x: mut u64
}}
let static held = mut 0
impl Guard<Marker> for Gate{
	@pub
	@realizes
	@lock
	func lock() imut void{
		unsafe global{ held = 1 }
	}
	@pub
	@realizes
	@unlock
	func unlock() imut void{
		unsafe global{ held = 0 }
	}
}
let static gate = mut Gate{n= 0}

func inc(x: mut u64) mut u64{ return x + 1 }

// `async`: a pointer crosses the thread boundary.
@async
func readCell(p: raw mut u64) mut u64{
	let t = mut 0
	unsafe assume deref{
		assume match Some(p)
		t = mut deref(p)
	}
	return t
}

@throws
func duplicate(src: raw some mut World) owns some mut World{
	?catch(e){ throw e }
	unsafe clone{
		return ?clone(src)
	}
}

func main() void{
	?catch(e){ return }

	unsafe extern{ printf("extern: %llu\n", mut 5) }

	// `raw` makes the pointer, `memcopy` copies bytes through it, `deref` reads through one,
	// and `assume` vouches that it is alive (a raw pointer into plain memory is not in the ghost table).
	let v = mut 7
	let dst = mut 0
	let seen = mut 0
	unsafe memcopy raw{ memcopy(raw dst, mut 8, raw v) }
	unsafe assume deref raw{
		let pv = mut (raw v)
		assume match Some(pv)
		seen = mut deref(pv)
	}
	unsafe extern{ printf("raw+memcopy+deref+assume: %llu %llu\n", dst, seen) }

	let w = mut ?new World{ticks= 4}
	let twin = mut ?duplicate(w)
	unsafe extern{ printf("clone: %llu %llu\n", w.ticks, twin.ticks) }

	unsafe global{ counter += 3 }
	unsafe extern global{ printf("global: %llu\n", counter) }

	let n = mut 0
	unsafe loop{
		loop{
			n += 1
			if n == 5{ break }
		}
	}
	unsafe extern{ printf("loop: %llu\n", n) }

	unsafe extern udyn{
		let a = mut unsafe dyn([10, 20, 30])
		printf("udyn: %llu\n", a[0] + a[1])
	}

	let w0 = mut ?new World{ticks= 9}
	let h = mut Holder{w= w0}
	unsafe extern udyn:owns{
		let arr2 = mut unsafe dyn([h])
		let back = mut arr2[0].w                  // moved out, so it is freed here instead of leaking
		printf("udyn:owns: %llu\n", back.ticks)
	}

	let fp = imut inc
	unsafe call extern{
		let r = mut call(fp, mut 10)
		printf("call: %llu\n", r)
	}

	unsafe asm extern{
		ASM relax {                            // an inline assembly block is declared once and emitted wherever its name is written
			pause
		}
		relax
		printf("asm: %llu\n", answer())        // `answer` is defined by the root-level ASM block above
	}

	let cell = mut 6
	let got = mut 0
	unsafe async raw{
		let pc = mut (raw cell)
		got = mut ? await readCell(pc)
	}
	unsafe extern{ printf("async: %llu\n", got) }

	unsafe global guard extern{
		gate.lock()
		counter += 8
		gate.unlock()
		printf("guard: held=%llu total=%llu\n", held, counter)
	}

	let m = mut Mtx{lockState= St.OPEN, n= mut 0}
	unsafe atomic{ m.lockState swap St.CLOSED }          // close the mutex by hand, outside `match @lock`
	let free = mut 0
	match @lock m{
		OPEN:{ free = 1 }
		CLOSED:{ break }
	}
	unsafe atomic{ m.lockState swap St.OPEN }
	match @lock m{
		OPEN:{ free = free + 2 }
		CLOSED:{ break }
	}
	unsafe extern{ printf("atomic: %llu\n", free) }

	// `unaudited` stands for every other tag: this block needs extern, global, raw and deref, and names none of them. It says "nobody has
	// checked why this is unsafe", so it is a grep target for review, and the standard library may never use it.
	unsafe unaudited{
		let cell2 = mut 6
		let pc2 = mut (raw cell2)
		assume match Some(pc2)
		counter = mut deref(pc2)
		printf("unaudited: %llu\n", counter)
	}
}
