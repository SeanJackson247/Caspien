# "target" selects the code generator's output: one of
#   linux         -- GAS AT&T syntax, SysV ABI (as/gcc/ld)
#   windows_gnu   -- GAS AT&T syntax, win64 ABI (gcc via mingw-w64)
#
# Set this to "linux" if you move this project to a Linux machine building
# with native gcc/as instead.
target windows_gnu
#
# bmi2: on|off -- variable shifts (`bits_left`/`bits_right`/`<<`-style with a run-time count) use the BMI2 instructions shlx/shrx, which take the
# count from any register: no %rcx save/restore, 4 instructions instead of 8. Needs a CPU with BMI2 (Intel Haswell 2013+, AMD Excavator/Zen
# and later); on an older CPU the program would stop with an illegal instruction. Shipped off. Signed (arithmetic) right shifts are unchanged.
bmi2 off
#
# avx: on|off -- scalar float arithmetic (+ - * /) on register-held floats uses the 3-operand VEX forms (vaddsd, vmulsd, ...): no `movaps` copy of the
# first operand before each operation. Needs a CPU with AVX (Intel Sandy Bridge 2011+, AMD Bulldozer 2011+). On an older CPU the program would stop with
# an illegal instruction. Shipped off.
avx off
#
# jcc-padding: on|off -- the assembler pads branches so that none crosses or ends on a 32-byte boundary (GNU as -mbranches-within-32B-boundaries,
# binutils 2.34+; ignored with a warning when the assembler lacks it). Intel Skylake-family CPUs (Skylake .. Cascade Lake, Comet Lake) cannot cache
# such a branch in their decoded-instruction cache after a microcode update that fixed the JCC erratum, so a tight loop whose closing jump lands
# on a boundary runs several percent slower, and an unrelated change elsewhere in the program (one instruction more or less) can move it there.
# With this on, a loop's speed no longer depends on where it lands; costs a few nop bytes per branch. Other CPUs are not affected either way.
# Shipped off. Needs the compiler to run `as` itself (target linux; windows_gnu passes it through gcc -Wa).
jcc-padding off

