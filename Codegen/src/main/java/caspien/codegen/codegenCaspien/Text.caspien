// The four caspien.bytecode.Text helpers the codegen files use (no regex), called as in Java: `Text.isDigits(s)`.
import "../../../../../../../stdlib/string.caspien"

@pub
struct Text{@pub{
}}

impl constructor for Text() self{
	return Text{}
}

@pub
impl Text{
	@pub
	static func isWordChar(c: mut char) mut bool{
		return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || String.isDigit(c) || c == '_'
	}

	/** Index of the first non-digit of `s` at or after `from` (n when none). */
	@pub
	static func digitRunEnd(s: ref some imut String, from: mut u64, n: mut u64) mut u64{
		for j in from..n{
			if String.isDigit(s.charAt(s, j)) == false{
				return j
			}
		}
		return n
	}

	/** [0-9]+ */
	@pub
	static func isDigits(s: ref some imut String) mut bool{
		let n = mut s.length(s)
		if n == 0{
			return false
		}
		for i in 0..n{
			if String.isDigit(s.charAt(s, i)) == false{
				return false
			}
		}
		return true
	}

	/** prefix followed by one or more digits, e.g. "r\d+" */
	@pub
	@throws
	static func isPrefixedDigits(s: ref some imut String, prefix: ref some imut String) mut bool{
		?catch(e){ throw e }
		if s.startsWith(s, prefix) == false{
			return false
		}
		let rest = mut ? s.substring(s, prefix.length(prefix))
		let r = mut false
		match Some(rest){
			r = Text.isDigits(rest)
		}
		return r
	}

	/** -?\d+\.\d+([eE][+-]?\d+)? */
	@pub
	static func isDecimalNumber(s: ref some imut String) mut bool{
		let n = mut s.length(s)
		let i = mut 0
		if i < n && s.charAt(s, i) == '-'{
			i += 1
		}
		let start = mut i
		i = Text.digitRunEnd(s, i, n)
		if i == start || i >= n || s.charAt(s, i) != '.'{
			return false
		}
		i += 1
		start = i
		i = Text.digitRunEnd(s, i, n)
		if i == start{
			return false
		}
		if i == n{
			return true
		}
		let e = mut s.charAt(s, i)
		if e != 'e' && e != 'E'{
			return false
		}
		i += 1
		if i < n && (s.charAt(s, i) == '+' || s.charAt(s, i) == '-'){
			i += 1
		}
		start = i
		i = Text.digitRunEnd(s, i, n)
		return i > start && i == n
	}

	/** `containsWord` with literal name and suffix (port-only helper; allocates the two Strings). */
	@pub
	@throws
	static func containsWordLit(text: ref imut String, name: static imut string, suffixChars: static imut string, dotBlocks: imut bool) mut bool{
		?catch(e){ throw e }
		let n = mut ? new String(name)
		let sfx = mut ? new String(suffixChars)
		let r = mut false
		match Some(text){ r = Text.containsWord(text, n, sfx, dotBlocks) }
		return r
	}

	/** containsAnyWord(text, {"rbx","ebx","bx","bl","bh"}, "") */
	@pub
	@throws
	static func usesRbx(text: ref imut String) mut bool{
		?catch(e){ throw e }
		let w0 = mut ? Text.containsWordLit(text, "rbx", "", false)
		let w1 = mut ? Text.containsWordLit(text, "ebx", "", false)
		let w2 = mut ? Text.containsWordLit(text, "bx", "", false)
		let w3 = mut ? Text.containsWordLit(text, "bl", "", false)
		let w4 = mut ? Text.containsWordLit(text, "bh", "", false)
		let r = mut (w0 || w1 || w2 || w3 || w4)
		return r
	}

	/** containsAnyWord(text, {"rdi","edi","di","dil"}, "") */
	@pub
	@throws
	static func usesRdi(text: ref imut String) mut bool{
		?catch(e){ throw e }
		let w0 = mut ? Text.containsWordLit(text, "rdi", "", false)
		let w1 = mut ? Text.containsWordLit(text, "edi", "", false)
		let w2 = mut ? Text.containsWordLit(text, "di", "", false)
		let w3 = mut ? Text.containsWordLit(text, "dil", "", false)
		let r = mut (w0 || w1 || w2 || w3)
		return r
	}

	/** containsAnyWord(text, {"rsi","esi","si","sil"}, "") */
	@pub
	@throws
	static func usesRsi(text: ref imut String) mut bool{
		?catch(e){ throw e }
		let w0 = mut ? Text.containsWordLit(text, "rsi", "", false)
		let w1 = mut ? Text.containsWordLit(text, "esi", "", false)
		let w2 = mut ? Text.containsWordLit(text, "si", "", false)
		let w3 = mut ? Text.containsWordLit(text, "sil", "", false)
		let r = mut (w0 || w1 || w2 || w3)
		return r
	}

	/** ASCII lower case of one char (port-only helper for the case-insensitive config words). */
	@pub
	static func lowerChar(c: mut char) mut char{
		if c == 'A'{ return 'a' }
		if c == 'B'{ return 'b' }
		if c == 'C'{ return 'c' }
		if c == 'D'{ return 'd' }
		if c == 'E'{ return 'e' }
		if c == 'F'{ return 'f' }
		if c == 'G'{ return 'g' }
		if c == 'H'{ return 'h' }
		if c == 'I'{ return 'i' }
		if c == 'J'{ return 'j' }
		if c == 'K'{ return 'k' }
		if c == 'L'{ return 'l' }
		if c == 'M'{ return 'm' }
		if c == 'N'{ return 'n' }
		if c == 'O'{ return 'o' }
		if c == 'P'{ return 'p' }
		if c == 'Q'{ return 'q' }
		if c == 'R'{ return 'r' }
		if c == 'S'{ return 's' }
		if c == 'T'{ return 't' }
		if c == 'U'{ return 'u' }
		if c == 'V'{ return 'v' }
		if c == 'W'{ return 'w' }
		if c == 'X'{ return 'x' }
		if c == 'Y'{ return 'y' }
		if c == 'Z'{ return 'z' }
		return c
	}

	/** r(8|9|1[0-5]) */
	@pub
	static func isHighGpr(s: ref some imut String) mut bool{
		let n = mut s.length(s)
		if s.startsWith(s, "r") == false || n < 2 || n > 3{
			return false
		}
		let a = mut s.charAt(s, 1)
		if n == 2{
			return a == '8' || a == '9'
		}
		let b = mut s.charAt(s, 2)
		return a == '1' && b >= '0' && b <= '5'
	}

	/** `name` as a whole word of `text` (see the Java original); one optional char of `suffixChars` may follow `name`. */
	@pub
	static func containsWord(text: ref some imut String, name: ref some imut String, suffixChars: ref some imut String, dotBlocks: imut bool) mut bool{
		let n = mut text.length(text)
		let from = mut 0
		let limit = mut (n + 1)
		for attempt in 0..limit{
			let p = mut text.indexOf(text, name, from)
			if p < 0{
				return false
			}
			let pu = mut wrap:<u64>(p)
			from = pu + 1
			let blocked = mut false
			if pu > 0{
				let before = mut text.charAt(text, pu - 1)
				if Text.isWordChar(before) || (dotBlocks && before == '.'){
					blocked = true
				}
			}
			if blocked == false{
				let q = mut (pu + name.length(name))
				if q < n && suffixChars.indexOf(suffixChars, text.charAt(text, q)) >= 0{
					q += 1
				}
				if q >= n || Text.isWordChar(text.charAt(text, q)) == false{
					return true
				}
			}
		}
		return false
	}
}
