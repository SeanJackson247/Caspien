import "../../../../../../../stdlib/string.caspien"
import "CodegenResult.caspien"
import "CodegenConfig.caspien"
import "x86backend/X86Backend.caspien"
import "bytecode/BytecodeParser.caspien"

@pub
struct Codegen{@pub{
}}

impl constructor for Codegen() self{
	return Codegen{}
}

@pub
impl Codegen{
	/** The CodegenException path: a failed result carrying the message (helper of the port). */
	@pub
	static func failure(msg: static imut string) owns mut CodegenResult{
		?catch(e){ return null }
		let ms = mut ? new ObjectList:<String>()
		let m = mut ? String.from(msg)
		? ms.add(ms, m)
		return ? new CodegenResult(null, ms, true)
	}

	@pub
	static func generate(lobText: ref imut String, origin: ref imut String, configText: ref imut String) owns mut CodegenResult{
		?catch(e){ return Codegen.failure(e.msg) }
		let path = mut ? String.from("codegen.config")
		let config = mut ? CodegenConfig.parse(configText, path)
		let parser = mut ? new BytecodeParser()
		let program = mut ? parser.parse(parser, lobText, origin)
		let backend = mut ? new X86Backend(config.target, config.bmi2)
		? backend.wire(backend)
		if config.avx{
			backend.avx = true
		}
		let:<owns mut String> asm = mut null
		match Some(program){ asm = backend.generate(backend, program.items) }
		let ms = mut ? new ObjectList:<String>()
		return ? new CodegenResult(asm, ms, false)
	}
}
