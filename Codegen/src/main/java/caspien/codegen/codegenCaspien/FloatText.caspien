// Java `Float.parseFloat` / `Double.parseDouble` for the decimal forms the codegen sees (-?\d+\.\d+([eE][+-]?\d+)?), exactly rounded, as IEEE bits.
import "../../../../../../../stdlib/string.caspien"
import "../../../../../../../stdlib/bigint.caspien"

@pub
struct FloatText{@pub{
}}

impl constructor for FloatText() self{
	return FloatText{}
}

@pub
impl FloatText{
	/** The IEEE-754 bits of the decimal `text` rounded to nearest-even: a double (isDouble) or a float in the low 32 bits. Throws "NumberFormatException". */
	@pub
	@throws
	static func bits(text: ref some imut String, isDouble: imut bool) mut u64{
		?catch(e){ throw e }
		let t = mut ? text.substring(text, 0)
		let n = mut t.length(t)
		let start = mut 0
		let neg = mut false
		if n > 0 && t.charAt(t, 0) == '-'{
			neg = true
			start = 1
		}
		let ten = mut ? BigInt.valueOf(10)
		let m = mut ? BigInt.valueOf(0)
		let:<mut s64> digits = mut 0
		let:<mut s64> frac = mut 0
		let:<mut s64> expVal = mut 0
		let expNeg = mut false
		let phase = mut 0
		let expStarted = mut false
		for k in start..n{
			let c = mut t.charAt(t, k)
			if phase < 2 && c == '.'{
				if phase == 1{
					throw "NumberFormatException"
				}
				phase = 1
			} elseif phase < 2 && (c == 'e' || c == 'E'){
				phase = 2
			} elseif phase == 2 && expStarted == false && (c == '+' || c == '-'){
				expStarted = true
				expNeg = c == '-'
			} else{
				if String.isDigit(c) == false{
					throw "NumberFormatException"
				}
				let d = mut (wrap:<s64>(String.charCode(c)) - 48)
				if phase < 2{
					let scaled = mut ? m.multiply(m, ten)
					let dv = mut ? BigInt.valueOf(d)
					m = ? scaled.add(scaled, dv)
					digits += 1
					if phase == 1{
						frac += 1
					}
				} else{
					expStarted = true
					if expVal < 100000{
						expVal = expVal * 10 + d
					}
				}
			}
		}
		if digits == 0{
			throw "NumberFormatException"
		}
		let p = mut 24
		let:<mut s64> emin = mut -149
		let:<mut s64> maxTop = mut 127
		let:<mut s64> bias = mut 127
		let signShift = mut 31
		if isDouble{
			p = 53
			emin = -1074
			maxTop = 1023
			bias = 1023
			signShift = 63
		}
		let signBit = mut bits_left(1, signShift)
		let negBits = mut 0
		if neg{
			negBits = signBit
		}
		let expBitsAll = mut bits_left(wrap:<u64>(bias * 2 + 1), p - 1)
		if m.isZero(m){
			return negBits
		}
		let:<mut s64> exp10 = mut expVal
		if expNeg{
			exp10 = 0 - expVal
		}
		exp10 = exp10 - frac
		if exp10 > 400{
			return bits_or(negBits, expBitsAll)
		}
		if exp10 + digits < -400{
			return negBits
		}
		let num = mut ? m.shiftLeft(m, 0)
		let den = mut ? BigInt.valueOf(1)
		if exp10 >= 0{
			let pw = mut ? ten.pow(ten, wrap:<u64>(exp10))
			num = ? m.multiply(m, pw)
		} else{
			den = ? ten.pow(ten, wrap:<u64>(0 - exp10))
		}
		let:<mut s64> e2 = mut (wrap:<s64>(num.bitLength(num)) - wrap:<s64>(den.bitLength(den)) - wrap:<s64>(p))
		if e2 < emin{
			e2 = emin
		}
		let pBits = mut wrap:<u64>(p)
		let q = mut ? BigInt.valueOf(0)
		let rnd = mut false
		let done = mut false
		for tries in 0..6{
			if done == false{
				let sn = mut ? num.shiftLeft(num, 0)
				let sd = mut ? den.shiftLeft(den, 0)
				if e2 < 0{
					sn = ? num.shiftLeft(num, wrap:<u64>(0 - e2))
				} else{
					sd = ? den.shiftLeft(den, wrap:<u64>(e2))
				}
				let qq = mut ? sn.divide(sn, sd)
				let rr = mut ? sn.remainder(sn, sd)
				let len = mut qq.bitLength(qq)
				if len > pBits{
					e2 += 1
				} elseif len < pBits && e2 > emin{
					e2 -= 1
				} else{
					let twice = mut ? rr.shiftLeft(rr, 1)
					let cmp = mut twice.compareTo(twice, sd)
					let odd = mut qq.testBit(qq, 0)
					if cmp > 0 || (cmp == 0 && odd){
						let one = mut ? BigInt.valueOf(1)
						qq = ? qq.add(qq, one)
					}
					q = qq
					done = true
				}
			}
		}
		if done == false{
			throw "NumberFormatException"
		}
		if q.bitLength(q) > pBits{
			q = ? q.shiftRight(q, 1)
			e2 += 1
		}
		let qv = mut q.toU64(q)
		let hidden = mut bits_left(1, pBits - 1)
		if qv < hidden{
			return bits_or(negBits, qv)
		}
		let top = mut (e2 + wrap:<s64>(p) - 1)
		if top > maxTop{
			return bits_or(negBits, expBitsAll)
		}
		let biased = mut wrap:<u64>(top + bias)
		let mant = mut (qv - hidden)
		return bits_or(bits_or(negBits, bits_left(biased, pBits - 1)), mant)
	}
}
