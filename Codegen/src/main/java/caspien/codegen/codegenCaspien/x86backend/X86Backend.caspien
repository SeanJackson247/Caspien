import "../../../../../../../../stdlib/string.caspien"
import "../collections.caspien"
import "../bytecode/BytecodeStatement.caspien"
import "../CodegenTarget.caspien"
import "X86Core.caspien"
import "X86Structs.caspien"
import "X86Emit.caspien"
import "X86Calls.caspien"
import "X86CasesA.caspien"
import "X86CasesB.caspien"
import "X86RegForm.caspien"
import "X86Generator.caspien"

@pub
@throws
impl constructor for X86Backend(target: imut CodegenTarget) self{
	?catch(e){ throw e }
	let core = mut ? new X86Core(target, imut false)
	return X86Backend{core= core, emit= null, calls= null, casesA= null, casesB= null, regForm= null, gen= null, avx= false}
}

@pub
@throws
impl constructor for X86Backend(target: imut CodegenTarget, bmi2: imut bool) self{
	?catch(e){ throw e }
	let core = mut ? new X86Core(target, bmi2)
	return X86Backend{core= core, emit= null, calls= null, casesA= null, casesB= null, regForm= null, gen= null, avx= false}
}

@pub
impl X86Backend{
	@pub
	@throws
	func wire(_self: ref some mut self) void{
		?catch(e){ throw e }
		_self.emit = ? new X86Emit(_self)
		_self.calls = ? new X86Calls(_self)
		_self.casesA = ? new X86CasesA(_self)
		_self.casesB = ? new X86CasesB(_self)
		_self.regForm = ? new X86RegForm(_self)
		_self.gen = ? new X86Generator(_self)
	}

	@pub
	@throws
	func generate(_self: ref some mut self, lines: ref some mut ObjectList<BytecodeStatement>) owns mut String{
		?catch(e){ throw e }
		let a = mut _self.avx
		match Some(_self){ match Some(_self.core){ _self.core.avx = a } }
		let:<owns mut String> result = mut null
		match Some(_self){ match Some(_self.gen){ result = ? _self.gen.generate(_self.gen, lines) } }
		return result
	}


}
