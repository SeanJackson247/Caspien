	@pub
	@throws
	func floatPoolLabel(_self: ref some mut self, bits: mut s64, n: mut s32) owns some mut String{
		?catch(e){ throw e }
		let b = mut X86Generator.maskIf4(bits, n)
		let key = mut ? String.fromS64(wrap:<s64>(n))
		? key.append(key, ":")
		? key.appendS64(key, b)
		let found = mut ? new String()
		let present = mut false
		match Some(_self){ match Some(_self.core){
			let hit = _self.core.floatPool.get(_self.core.floatPool, key)
			match Some(hit){
				present = true
				found = ? hit.substring(hit, 0)
			}
		} }
		if present{
			return found
		}
		let label = mut ? String.from(".LFC")
		match Some(_self){ match Some(_self.core){ ? label.appendU64(label, _self.core.floatPool.size(_self.core.floatPool)) } }
		let stored = mut ? label.substring(label, 0)
		match Some(_self){ match Some(_self.core){ ? _self.core.floatPool.put(_self.core.floatPool, key, stored) } }
		return label
	}

