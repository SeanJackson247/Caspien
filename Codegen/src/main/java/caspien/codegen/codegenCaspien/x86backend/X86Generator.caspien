	@pub
	@throws
	func rfTimesTwoOperand(_self: ref some mut self, n: mut s32, aTok: ref imut String, bTok: ref imut String) owns mut String{
		?catch(e){ throw e }
		let:<mut s64> two = mut 0x40000000
		if n == 8{
			two = 0x4000000000000000
		}
		let aImm = mut false
		let bImm = mut false
		let:<mut s64> aVal = mut 0
		let:<mut s64> bVal = mut 0
		match Some(aTok){
			aImm = X86Core.rfIsImm(aTok)
			if aImm{ aVal = ? X86Core.rfImm(aTok) }
		}
		match Some(bTok){
			bImm = X86Core.rfIsImm(bTok)
			if bImm{ bVal = ? X86Core.rfImm(bTok) }
		}
		if aImm && X86Generator.maskUnless8(aVal, n) == two && bImm == false{
			let r = mut ? new String()
			match Some(bTok){ r = ? bTok.substring(bTok, 0) }
			return r
		}
		if bImm && X86Generator.maskUnless8(bVal, n) == two && aImm == false{
			let r2 = mut ? new String()
			match Some(aTok){ r2 = ? aTok.substring(aTok, 0) }
			return r2
		}
		return null
	}

