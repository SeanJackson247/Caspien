	@pub
	@throws
	func rfFloatMem(_self: ref some mut self, addrTok: ref imut String, n: mut s32) owns some mut String{
		?catch(e){ throw e }
		let out = mut ? new String()
		let isSlot = mut false
		let isGlobal = mut false
		match Some(addrTok){
			isSlot = X86Core.rfIsSlot(addrTok)
			isGlobal = X86Core.rfIsGlobal(addrTok)
		}
		if isSlot{
			let:<mut s64> off = mut 0
			match Some(addrTok){ off = ? X86Core.rfSlot(addrTok) }
			? out.appendS64(out, off)
			? out.append(out, "(%rbp)")
		} else if isGlobal{
			let name = mut ? new String()
			match Some(addrTok){ name = ? addrTok.substring(addrTok, 1) }
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ out = ? _self.hub.emit.globalRipOperand(_self.hub.emit, name) } } }
		} else{
			? out.append(out, "(%")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.regForm){ match Some(addrTok){
				let reg = ? _self.hub.regForm.rfReg(_self.hub.regForm, addrTok)
				? out.append(out, reg)
			} } } }
			? out.append(out, ")")
		}
		return out
	}

