	@pub
	@throws
	func rfArgReg(_self: ref some mut self, idx: mut s32) static imut string{
		?catch(e){ throw e }
		match Some(_self.hub){ match Some(_self.hub.calls){
			let reg = _self.hub.calls.argReg(_self.hub.calls, idx)
