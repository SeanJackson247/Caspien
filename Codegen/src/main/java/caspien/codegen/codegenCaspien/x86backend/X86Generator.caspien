	@pub
	@throws
	func varMarksNeeded(_self: ref some mut self, start: mut s32) mut s32{
		?catch(e){ throw e }
		let:<mut s32> mask = mut 0
		let:<mut u64> from = mut 0
		if start > 0{
			from = wrap:<u64>(start)
		}
		let r13 = mut ? new String("r13")
		let r14 = mut ? new String("r14")
		let r12 = mut ? new String("r12")
		let dwb = mut ? new String("dwb")
		let bound = mut 0
		match Some(_self){ match Some(_self.core){ bound = _self.core.out.length(_self.core.out) + 1 } }
		for step in 0..bound{
			let:<mut s64> i = mut -1
			let:<mut s64> j = mut -1
			match Some(_self){ match Some(_self.core){ i = _self.core.out.indexOf(_self.core.out, "@@V1314S@@\n", from) } }
			if i < 0{
				break
			}
			let segStart = mut wrap:<u64>(i + 11)
			match Some(_self){ match Some(_self.core){ j = _self.core.out.indexOf(_self.core.out, "@@V1314R@@\n", segStart) } }
			if j < 0{
				break
			}
			let seg = mut ? new String()
			match Some(_self){ match Some(_self.core){ seg = ? _self.core.out.sub(_self.core.out, segStart, wrap:<u64>(j)) } }
			if Text.containsWord(seg, r13, dwb, false){
				mask = bits_or(mask, 1)
			}
			if Text.containsWord(seg, r14, dwb, false){
				mask = bits_or(mask, 2)
			}
			if Text.containsWord(seg, r12, dwb, false){
				mask = bits_or(mask, 4)
			}
			from = wrap:<u64>(j + 11)
		}
		return mask
	}

	@pub
	@throws
	func expandVarMarks(_self: ref some mut self, start: mut s32) void{
		?catch(e){ throw e }
		let:<mut u64> from = mut 0
		if start > 0{
			from = wrap:<u64>(start)
		}
		let names = mut ? new ObjectList:<String>()
		let n13 = mut ? new String("r13")
		let n14 = mut ? new String("r14")
		let n12 = mut ? new String("r12")
		? names.add(names, n13)
		? names.add(names, n14)
		? names.add(names, n12)
		let dwb = mut ? new String("dwb")
		let bound = mut 0
		match Some(_self){ match Some(_self.core){ bound = _self.core.out.length(_self.core.out) + 1 } }
		for step in 0..bound{
			let:<mut s64> i = mut -1
			let:<mut s64> j = mut -1
			match Some(_self){ match Some(_self.core){ i = _self.core.out.indexOf(_self.core.out, "@@V1314S@@\n", from) } }
			if i < 0{
				break
			}
			let segStart = mut wrap:<u64>(i + 11)
			match Some(_self){ match Some(_self.core){ j = _self.core.out.indexOf(_self.core.out, "@@V1314R@@\n", segStart) } }
			if j < 0{
				throw "codegen internal error: unbalanced register-save marks"
			}
			let seg = mut ? new String()
			match Some(_self){ match Some(_self.core){ seg = ? _self.core.out.sub(_self.core.out, segStart, wrap:<u64>(j)) } }
			let sv = mut ? new String()
			let rs = mut ? new String()
			for vi in 0..3{
				let slot = mut ? new String()
				match Some(_self){ match Some(_self.core){
					let s = _self.core.vSlots.get(_self.core.vSlots, vi)
					match Some(s){ slot = ? s.substring(s, 0) }
				} }
				let nm = mut ? new String()
				let nmSrc = names.get(names, vi)
				match Some(nmSrc){ nm = ? nmSrc.substring(nmSrc, 0) }
				if slot.length(slot) > 0 && Text.containsWord(seg, nm, dwb, false){
					? sv.append(sv, "    movq %")
					? sv.append(sv, nm)
					? sv.append(sv, ", ")
					? sv.append(sv, slot)
					? sv.append(sv, "\n")
					? rs.append(rs, "    movq ")
					? rs.append(rs, slot)
					? rs.append(rs, ", %")
					? rs.append(rs, nm)
					? rs.append(rs, "\n")
				}
			}
			match Some(_self){ match Some(_self.core){ ? _self.core.out.replaceRange(_self.core.out, wrap:<u64>(j), wrap:<u64>(j + 11), rs) } }
			match Some(_self){ match Some(_self.core){ ? _self.core.out.replaceRange(_self.core.out, wrap:<u64>(i), wrap:<u64>(i + 11), sv) } }
			from = wrap:<u64>(i) + sv.length(sv)
		}
	}

	@pub
	@throws
	func finishCalleeSaved(_self: ref some mut self) void{
		?catch(e){ throw e }
		let:<mut s32> start = mut -1
		let:<mut s64> frameBytes = mut 0
		let win = mut false
		match Some(_self){ match Some(_self.core){
			start = _self.core.csrFuncStart
			frameBytes = _self.core.csrAllocSum
			win = _self.core.target == CodegenTarget.WINDOWS_GNU_X64
		} }
		if start < 0{
			return
		}
		let body = mut ? new String()
		match Some(_self){ match Some(_self.core){ body = ? _self.core.out.substring(_self.core.out, wrap:<u64>(start)) } }
		let regs = mut ? new ObjectList:<String>()
		let hasRbx = mut ? Text.usesRbx(body)
		if hasRbx{
			let r0 = mut ? String.from("rbx")
			? regs.add(regs, r0)
		}
		let h12 = mut ? Text.containsWordLit(body, "r12", "dwb", false)
		if h12{
			let r1 = mut ? String.from("r12")
			? regs.add(regs, r1)
		}
		let h13 = mut ? Text.containsWordLit(body, "r13", "dwb", false)
		if h13{
			let r2 = mut ? String.from("r13")
			? regs.add(regs, r2)
		}
		let h14 = mut ? Text.containsWordLit(body, "r14", "dwb", false)
		if h14{
			let r3 = mut ? String.from("r14")
			? regs.add(regs, r3)
		}
		let h15 = mut ? Text.containsWordLit(body, "r15", "dwb", false)
		if h15{
			let r4 = mut ? String.from("r15")
			? regs.add(regs, r4)
		}
		if win{
			let hasRdi = mut ? Text.usesRdi(body)
			if hasRdi{
				let r5 = mut ? String.from("rdi")
				? regs.add(regs, r5)
			}
			let hasRsi = mut ? Text.usesRsi(body)
			if hasRsi{
				let r6 = mut ? String.from("rsi")
				? regs.add(regs, r6)
			}
			for x in 6..16{
				let nm = ? X86Core.xmmName(wrap:<s32>(x))
				let hx = mut ? Text.containsWordLit(body, nm, "", false)
				if hx{
					let r7 = mut ? String.from(nm)
					? regs.add(regs, r7)
				}
			}
		}
		let restoreText = mut ? new String()
		for z in 0..3{
			let blank = mut ? new String()
			match Some(_self){ match Some(_self.core){ _self.core.vSlots.setAt(_self.core.vSlots, z, blank) } }
		}
		if regs.isEmpty(regs) == false{
			let noAlloc = mut false
			match Some(_self){ match Some(_self.core){ noAlloc = _self.core.csrAllocPos < 0 } }
			if noAlloc{
				let blankLine = mut ? new String()
				match Some(_self){ match Some(_self.core){
					_self.core.csrAllocPos = _self.core.csrFuncStart
					_self.core.csrAllocBytes = 0
					_self.core.csrAllocLine = blankLine
				} }
			}
			let:<mut s32> allocPos = mut 0
			let:<mut s64> allocBytes = mut 0
			match Some(_self){ match Some(_self.core){
				allocPos = _self.core.csrAllocPos
				allocBytes = _self.core.csrAllocBytes
			} }
			let beforeAlloc = mut ? new String()
			match Some(_self){ match Some(_self.core){ beforeAlloc = ? _self.core.out.substring(_self.core.out, wrap:<u64>(start), wrap:<u64>(allocPos)) } }
			let early = mut ? beforeAlloc.replace(beforeAlloc, "@@CSR@@", "")
			let nregs = mut regs.size(regs)
			for k in 0..nregs{
				let reg = mut ? new String()
				let rr = regs.get(regs, k)
				match Some(rr){ reg = ? rr.substring(rr, 0) }
				let usedEarly = mut false
				if reg.startsWith(reg, "xmm"){
					let w = mut ? new String()
					usedEarly = Text.containsWord(early, reg, w, false)
				} else if reg.equals(reg, "rbx"){
					usedEarly = ? Text.usesRbx(early)
				} else if reg.equals(reg, "rdi"){
					usedEarly = ? Text.usesRdi(early)
				} else if reg.equals(reg, "rsi"){
					usedEarly = ? Text.usesRsi(early)
				} else{
					let dwb = mut ? new String("dwb")
					usedEarly = Text.containsWord(early, reg, dwb, false)
				}
				if usedEarly{
					throw "codegen internal error: a function uses a callee-saved register before its frame is allocated"
				}
			}
			let:<mut s64> cur = mut allocBytes
			let saves = mut ? new String()
			let restores = mut ? new String()
			for k2 in 0..nregs{
				let reg2 = mut ? new String()
				let rr2 = regs.get(regs, k2)
				match Some(rr2){ reg2 = ? rr2.substring(rr2, 0) }
				let isX = mut reg2.startsWith(reg2, "xmm")
				let mem = mut ? new String("-")
				if isX{
					cur = cur + 16
				} else{
					cur = cur + 8
				}
				? mem.appendS64(mem, cur)
				? mem.append(mem, "(%rbp)")
				? saves.append(saves, "    ")
				? restores.append(restores, "    ")
				if isX{
					? saves.append(saves, "movups %")
					? restores.append(restores, "movups ")
				} else{
					? saves.append(saves, "movq %")
					? restores.append(restores, "movq ")
				}
				? saves.append(saves, reg2)
				? saves.append(saves, ", ")
				? saves.append(saves, mem)
				? saves.append(saves, "\n")
				? restores.append(restores, mem)
				? restores.append(restores, ", %")
				? restores.append(restores, reg2)
				? restores.append(restores, "\n")
			}
			for z2 in 0..3{
				let blank2 = mut ? new String()
				match Some(_self){ match Some(_self.core){ _self.core.vSlots.setAt(_self.core.vSlots, z2, blank2) } }
			}
			let:<mut s32> needMask = mut 0
			match Some(_self){ needMask = ? _self.varMarksNeeded(_self, start) }
			for vi in 0..3{
				let:<mut s32> varMask = mut 0
				match Some(_self){ match Some(_self.core){ varMask = _self.core.rfVarMask } }
				let:<mut s32> bit = mut 1
				if vi == 1{ bit = 2 }
				if vi == 2{ bit = 4 }
				if bits_and(bits_and(varMask, needMask), bit) != 0{
					cur = cur + 8
					let slot = mut ? String.from("-")
					? slot.appendS64(slot, cur)
					? slot.append(slot, "(%rbp)")
					match Some(_self){ match Some(_self.core){ _self.core.vSlots.setAt(_self.core.vSlots, vi, slot) } }
				}
			}
			let total = mut bits_and(cur + 15, -16)
			let:<mut s64> allocSum = mut 0
			match Some(_self){ match Some(_self.core){ allocSum = _self.core.csrAllocSum } }
			frameBytes = allocSum - allocBytes + total
			let newSub = mut ? String.from("    subq $")
			? newSub.appendS64(newSub, total)
			? newSub.append(newSub, ", %rsp\n")
			let:<mut u64> allocLen = mut 0
			let same = mut false
			let current = mut ? new String()
			match Some(_self){ match Some(_self.core){
				match Some(_self.core.csrAllocLine){ allocLen = _self.core.csrAllocLine.length(_self.core.csrAllocLine) }
			} }
			match Some(_self){ match Some(_self.core){ current = ? _self.core.out.substring(_self.core.out, wrap:<u64>(allocPos), wrap:<u64>(allocPos) + allocLen) } }
			match Some(_self){ match Some(_self.core){
				match Some(_self.core.csrAllocLine){ same = current.equals(current, _self.core.csrAllocLine) }
			} }
			if same == false{
				throw "codegen internal error: ALLOC line moved"
			}
			? newSub.append(newSub, saves)
			match Some(_self){ match Some(_self.core){ ? _self.core.out.replaceRange(_self.core.out, wrap:<u64>(allocPos), wrap:<u64>(allocPos) + allocLen, newSub) } }
			restoreText = ? restores.substring(restores, 0)
		}
		match Some(_self){ ? _self.expandVarMarks(_self, start) }
		let:<mut u64> from = mut wrap:<u64>(start)
		let bound = mut 0
		match Some(_self){ match Some(_self.core){ bound = _self.core.out.length(_self.core.out) + 1 } }
		for step in 0..bound{
			let:<mut s64> i = mut -1
			match Some(_self){ match Some(_self.core){ i = _self.core.out.indexOf(_self.core.out, "@@CSR@@\n", from) } }
			if i < 0{
				break
			}
			match Some(_self){ match Some(_self.core){ ? _self.core.out.replaceRange(_self.core.out, wrap:<u64>(i), wrap:<u64>(i + 8), restoreText) } }
			from = wrap:<u64>(i) + restoreText.length(restoreText)
		}
		let rspFix = mut ? new String()
		if frameBytes == 0{
			? rspFix.append(rspFix, "    movq %rbp, %rsp\n")
		} else{
			? rspFix.append(rspFix, "    leaq -")
			? rspFix.appendS64(rspFix, frameBytes)
			? rspFix.append(rspFix, "(%rbp), %rsp\n")
		}
		from = wrap:<u64>(start)
		match Some(_self){ match Some(_self.core){ bound = _self.core.out.length(_self.core.out) + 1 } }
		for step2 in 0..bound{
			let:<mut s64> j = mut -1
			match Some(_self){ match Some(_self.core){ j = _self.core.out.indexOf(_self.core.out, "@@RSP@@\n", from) } }
			if j < 0{
				break
			}
			match Some(_self){ match Some(_self.core){ ? _self.core.out.replaceRange(_self.core.out, wrap:<u64>(j), wrap:<u64>(j + 8), rspFix) } }
			from = wrap:<u64>(j) + rspFix.length(rspFix)
		}
		match Some(_self){ match Some(_self.core){ _self.core.csrFuncStart = -1 } }
	}

	@pub
	func emitFunctionEpilogue(_self: ref some mut self) void{
	}
}
