	func rfMemOperand(_self: ref some mut self, baseReg: static imut string) owns some mut String{
		?catch(e){ throw e }
		let out = mut ? new String()
		match Some(_self.core){
			match Some(_self.core.rfMemOverride){
				? out.append(out, _self.core.rfMemOverride)
				return out
			}
		}
		let indexed = mut false
		match Some(_self.core){
			match Some(_self.core.rfIdxReg){
				indexed = true
			}
		}
		if indexed == false{
			? out.append(out, "(%")
			? out.append(out, baseReg)
			? out.append(out, ")")
			return out
		}
		match Some(_self.core){
			if _self.core.rfIdxDisp != 0{
				? out.appendS64(out, _self.core.rfIdxDisp)
			}
		}
		? out.append(out, "(%")
		? out.append(out, baseReg)
		? out.append(out, ",%")
