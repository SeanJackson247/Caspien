	@pub
	@throws
	func xvReg(_self: ref some mut self, tok: ref imut String) static imut string{
		?catch(e){ throw e }
		let:<mut s64> k = mut 0
		let isZ = mut false
		let isY = mut false
		match Some(tok){
			isZ = tok.startsWith(tok, "%z")
			isY = tok.startsWith(tok, "%y")
		}
		match Some(tok){
			let digits = mut ? tok.substring(tok, 2)
			k = ? digits.parseS64(digits)
		}
		if isZ{
			if k < 0 || k >= 4{
				throw "float cache register out of range"
			}
			let z = ? X86Core.xmmName(wrap:<s32>(k))
			return z
		}
		if isY{
			if k < 0 || k >= 4{
				throw "float temporary register out of range"
			}
			let y = ? _self.yPhys(_self, wrap:<s32>(k))
			return y
		}
		if k < 0 || k >= 6{
			throw "float variable register out of range"
		}
		let v = ? _self.xvPhys(_self, wrap:<s32>(k))
		return v
	}

