	@pub
	@throws
	func raw_(_self: ref some mut self, text: ref imut String) void{
		?catch(e){ throw e }
		match Some(_self){
			let sink = _self.currentSink(_self)
			match Some(sink){ match Some(text){ ? sink.append(sink, text) } }
		}
		match Some(_self){
			let sink2 = _self.currentSink(_self)
			match Some(sink2){ ? sink2.append(sink2, '\n') }
		}
		match Some(_self){ match Some(text){ ? _self.trackStackDelta(_self, text) } }
		let active = mut false
		match Some(_self){ match Some(_self.core){ active = _self.core.strideKeySink != null } }
		if active{
			match Some(_self){ match Some(text){ ? _self.strideKeyAfter(_self, text) } }
		}
	}

	@pub
	@throws
	func strideKeyAfter(_self: ref some mut self, text: ref imut String) void{
		?catch(e){ throw e }
		let t = mut ? new String()
		match Some(text){ t = ? text.trim(text) }
		let sp = mut t.firstIndexOf(t, ' ')
		let op = mut ? new String()
		if sp < 0{
			op = ? t.substring(t, 0)
		} else{
			op = ? t.substring(t, 0, wrap:<u64>(sp))
		}
		let keep = mut X86Core.isStrideKeepOp(op)
		if t.firstIndexOf(t, '\n') >= 0 || t.endsWith(t, ":") || keep == false{
			match Some(_self){ match Some(_self.core){ _self.core.strideKeySink = null } }
			return
		}
		let:<mut s64> depth = mut 0
		let:<mut s64> cut = mut -1
		let tn = mut t.length(t)
		for i in 0..tn{
			let c = mut t.charAt(t, i)
			if c == '('{
				depth = depth + 1
			} else if c == ')'{
				depth = depth - 1
			} else if c == ',' && depth == 0{
				cut = wrap:<s64>(i)
			}
		}
		let destRaw = mut ? new String()
		if cut < 0{
			let from = mut tn
			if sp >= 0{
				from = wrap:<u64>(sp)
			}
			destRaw = ? t.substring(t, from)
		} else{
			destRaw = ? t.substring(t, wrap:<u64>(cut + 1))
		}
		let dest = mut ? destRaw.trim(destRaw)
		if dest.startsWith(dest, "%") == false{
			return
		}
		if dest.startsWith(dest, "%xmm"){
			return
		}
		let reg = mut ? dest.substring(dest, 1)
		let scratch = mut ? new String("r15")
		let hit = mut X86Core.regAliasOf(reg, scratch)
		if hit == false{
			match Some(_self){ match Some(_self.core){ match Some(_self.core.strideKeyIdx){ hit = X86Core.regAliasOf(reg, _self.core.strideKeyIdx) } } }
		}
		if hit{
			match Some(_self){ match Some(_self.core){ _self.core.strideKeySink = null } }
		}
	}

	@pub
	@throws
	func trackStackDelta(_self: ref some mut self, rawText: ref imut String) void{
		?catch(e){ throw e }
		let skip = mut true
		match Some(_self.core){
			skip = _self.core.argTrackSuspendDepth > 0 || len(_self.core.argTrackDeltaStack.backing) == 0
		}
		if skip{
			return
		}
		let t = mut ? new String()
		match Some(rawText){ t = ? rawText.trim(rawText) }
		let:<mut s64> delta = mut 0
		let tn = mut t.length(t)
		if t.startsWith(t, "pushq %") || t.startsWith(t, "push "){
			delta = 8
		} else if t.startsWith(t, "popq %") || t.startsWith(t, "pop "){
			delta = -8
		} else if t.startsWith(t, "subq $") && t.endsWith(t, ", %rsp"){
			let p1 = mut ? new String("subq $")
			let p2 = mut ? new String(", %rsp")
			match Some(_self){ delta = ? _self.parseRspDelta(_self, t, p1, p2) }
		} else if t.startsWith(t, "addq $") && t.endsWith(t, ", %rsp"){
			let p1 = mut ? new String("addq $")
			let p2 = mut ? new String(", %rsp")
			let:<mut s64> d = mut 0
			match Some(_self){ d = ? _self.parseRspDelta(_self, t, p1, p2) }
			delta = 0 - d
		} else if t.startsWith(t, "sub rsp, "){
			let rest = mut ? t.substring(t, 9)
			let trimmed = mut ? rest.trim(rest)
			delta = ? trimmed.parseS64(trimmed)
		} else if t.startsWith(t, "add rsp, "){
			let rest = mut ? t.substring(t, 9)
			let trimmed = mut ? rest.trim(rest)
			let d = mut ? trimmed.parseS64(trimmed)
			delta = 0 - d
		}
		if delta != 0{
			let:<mut s64> top = mut 0
			match Some(_self){ match Some(_self.core){ top = ? _self.core.argTrackDeltaStack.popBack(_self.core.argTrackDeltaStack, 0) } }
			match Some(_self){ match Some(_self.core){ ? _self.core.argTrackDeltaStack.pushBack(_self.core.argTrackDeltaStack, top + delta) } }
		}
	}

	/** The number between `prefix` and `suffix` in `t` (trimmed); throws "NumberFormatException". */
	@pub
	@throws
	func parseRspDelta(_self: ref some mut self, t: ref some imut String, prefix: ref some imut String, suffix: ref some imut String) mut s64{
		?catch(e){ throw e }
		let a = mut prefix.length(prefix)
		let b = mut (t.length(t) - suffix.length(suffix))
		let mid = mut ? t.substring(t, a, b)
		let trimmed = mut ? mid.trim(mid)
		let:<mut s64> v = mut 0
		match Some(trimmed){
			v = ? trimmed.parseS64(trimmed)
		}
		return v
	}

