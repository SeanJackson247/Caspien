	@pub
	@throws
	static func plusOffset(off: mut s64) owns some mut String{
		?catch(e){ throw e }
		if off != 0{
			let r = mut ? String.from("+")
			? r.appendS64(r, off)
			return r
		}
		let z = mut ? String.from("")
		return z
	}

	@pub
	@throws
	static func offsetText(off: mut s64) owns some mut String{
		?catch(e){ throw e }
		if off == 0{
			let z = mut ? String.from("")
			return z
		}
		let r = mut ? String.fromS64(off)
		return r
	}

	static func widthFor(left: mut s64) mut s32{
		if left >= 8{
			return 8
		} elseif left >= 4{
			return 4
		} elseif left >= 2{
			return 2
		}
		return 1
	}

	static func pickBySize(size: mut s32, s1: static imut string, s2: static imut string, s4: static imut string, other: static imut string) static imut string{
		if size == 1{
			return s1
		} elseif size == 2{
			return s2
		} elseif size == 4{
			return s4
		}
		return other
	}

	@pub
	func movSuffix(_self: ref some mut self, size: mut s32) static imut string{
		return X86Emit.pickBySize(size, "b", "w", "l", "q")
	}

