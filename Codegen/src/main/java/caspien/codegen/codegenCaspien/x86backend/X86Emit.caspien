	/** The register name for the low `size` bytes of `reg64` (al/ax/eax/rax, r8b/r8w/r8d/r8 ...). */
	/** The register name for the low `size` bytes of `reg64` (al/ax/eax/rax, r8b/r8w/r8d/r8 ...). */
	@pub
	@throws
	func sizedReg(_self: ref some mut self, reg64: ref some imut String, size: mut s32) owns some mut String{
		?catch(e){ throw e }
		let lit = X86Emit.sizedRegLiteral(reg64, size)
		let special = mut (reg64.equals(reg64, "rax") || reg64.equals(reg64, "rbx") || reg64.equals(reg64, "rcx") || reg64.equals(reg64, "rdx") || reg64.equals(reg64, "rsi") || reg64.equals(reg64, "rdi"))
		let high = mut (Text.isHighGpr(reg64) && size < 8)
		let out = mut ? reg64.substring(reg64, 0)
		if special{
			out = ? String.from(lit)
			return out
		}
		if high{
			? out.append(out, X86Emit.pickBySize(size, "b", "w", "d", "d"))
		}
		return out
	}

	/** The literal register name for the six legacy registers ("" for any other). */
	@pub
	static func sizedRegLiteral(reg64: ref some imut String, size: mut s32) static imut string{
		if reg64.equals(reg64, "rax"){
			return X86Emit.pickBySize(size, "al", "ax", "eax", "rax")
		} elseif reg64.equals(reg64, "rbx"){
			return X86Emit.pickBySize(size, "bl", "bx", "ebx", "rbx")
		} elseif reg64.equals(reg64, "rcx"){
			return X86Emit.pickBySize(size, "cl", "cx", "ecx", "rcx")
		} elseif reg64.equals(reg64, "rdx"){
			return X86Emit.pickBySize(size, "dl", "dx", "edx", "rdx")
		} elseif reg64.equals(reg64, "rsi"){
			return X86Emit.pickBySize(size, "sil", "si", "esi", "rsi")
		} elseif reg64.equals(reg64, "rdi"){
			return X86Emit.pickBySize(size, "dil", "di", "edi", "rdi")
		}
		return ""
	}

