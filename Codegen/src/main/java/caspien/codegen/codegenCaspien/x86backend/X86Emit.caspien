	@pub
	@throws
	func emitHeader(_self: ref some mut self) void{
		?catch(e){ throw e }
		let win = mut false
		match Some(_self){ match Some(_self.core){ win = _self.core.target == CodegenTarget.WINDOWS_GNU_X64 } }
		if win{
			match Some(_self){ match Some(_self.core){ ? _self.core.out.append(_self.core.out, "# Generated by caspien-codegen (target: windows_gnu x86-64, mingw-w64/GNU as)\n") } }
			match Some(_self){ match Some(_self.core){ ? _self.core.out.append(_self.core.out, "# GAS AT&T syntax, win64 ABI -- assemble/link with x86_64-w64-mingw32-gcc.\n") } }
		} else{
			match Some(_self){ match Some(_self.core){ ? _self.core.out.append(_self.core.out, "# Generated by caspien-codegen (target: linux x86-64)\n") } }
			match Some(_self){ match Some(_self.core){ ? _self.core.out.append(_self.core.out, "# GAS AT&T syntax -- assemblable/runnable directly with as/ld/gcc.\n") } }
		}
	}

