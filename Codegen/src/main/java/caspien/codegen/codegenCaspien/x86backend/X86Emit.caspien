@pub
impl constructor for X86Emit(hub: ref some mut X86Backend) self{
	return X86Emit{hub= hub, core= ref hub.core}
}

@pub
impl X86Emit{
	@pub
	func lineAtOffsetIsAtomicSwap(_self: ref some mut self, offset: mut s32) mut bool{ return false }

	@pub
	func noteArgRegLoaded(_self: ref some mut self, tag: ref imut String) void{
	}

	@pub
	func currentSink(_self: ref some mut self) ref mut String{ return null }

	@pub
	func consumeVarargsXmmCount(_self: ref some mut self) mut s32{
		let:<mut s32> count = mut 0
		match Some(_self.core){
			if _self.core.pendingVarargsXmmCount < 0{
				count = 0
			} else{
				count = _self.core.pendingVarargsXmmCount
			}
			_self.core.pendingVarargsXmmCount = -1
		}
		return count
	}

	@pub
	func findRunStart(_self: ref some mut self, endExclusive: mut s32, targetSize: mut s64) mut s32{ return 0 }

	@pub
	func populateDirectMembers(_self: ref some mut self, start: mut s32, endExclusive: mut s32, runTotal: mut s64) void{
	}

	@pub
	func storeConstructionOrPlainPush(_self: ref some mut self, regName: ref imut String, size: mut s32) void{
	}

	@pub
	func collectRunEntries(_self: ref some mut self, start: mut s32, endExclusive: mut s32) owns mut X86RunEntries{ return null }

	@pub
	func emitNewRepack(_self: ref some mut self, size: mut s64, line: ref imut BytecodeStatement) void{
	}

	@pub
	func emitAssignRepack(_self: ref some mut self, size: mut s64, line: ref imut BytecodeStatement) void{
	}

	@pub
	func copyBytes(_self: ref some mut self, srcReg: ref imut String, srcOff: mut s64, dstReg: ref imut String, dstOff: mut s64, n: mut s64) void{
	}

	@pub
	func copyBytesR12ToR14(_self: ref some mut self, srcOff: mut s64, dstOff: mut s64, n: mut s64) void{
	}

	@pub
	func precomputeConstructionOffsets(_self: ref some mut self) void{
	}

	@pub
	func isWinAbi(_self: ref some mut self) mut bool{
		let result = mut false
		match Some(_self.core){
			result = _self.core.target == CodegenTarget.WINDOWS_GNU_X64
		}
		return result
	}

	@pub
	func collectDeclarations(_self: ref some mut self, lines: ref imut ObjectList<BytecodeStatement>) void{
	}

	@pub
	func initBits(_self: ref some mut self, text: ref imut String, size: mut s64) mut s64{ return 0 }

	@pub
	func parseInitValue(_self: ref some mut self, text: ref imut String) mut s64{ return 0 }

	@pub
	func emitDataSections(_self: ref some mut self) void{
	}

	@pub
	func emitStorageDirective(_self: ref some mut self, size: mut s64, init: mut s64) void{
	}

	@pub
	@throws
	func mangleGlobalName(_self: ref some mut self, name: ref some imut String) owns some mut String{
		?catch(e){ throw e }
		let r = mut ? name.replace(name, '.', '_')
		return r
	}

	@pub
	func emitHeader(_self: ref some mut self) void{
