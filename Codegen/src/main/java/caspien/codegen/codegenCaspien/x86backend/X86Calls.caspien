@pub
impl constructor for X86Calls(hub: ref some mut X86Backend) self{
	return X86Calls{hub= hub, core= ref hub.core}
}

@pub
impl X86Calls{
	/** The constant byte count (1..64) of the MEMCOPY being emitted, found among the previous lines, or -1. */
	@pub
	@throws
	func memcopyConstantSize(_self: ref some mut self) mut s64{
		?catch(e){ throw e }
		let values = mut 0
		for back in 1..5{
			let present = mut false
			let:<mut s32> idx = mut 0
			match Some(_self.core){
				idx = _self.core.currentLineIndex - wrap:<s32>(back)
			}
			if idx < 0{
				return -1
			}
			match Some(_self.core){ match Some(_self.core.allLines){
				let l = _self.core.allLines.get(_self.core.allLines, wrap:<u64>(idx))
				match Some(l){
					present = true
					let n = mut l.items.size(l.items)
					if n == 0{
						return -1
					}
					if X86Core.tokenIs(l, 0, "ADDR_OF"){
						continue
					}
					if X86Core.tokenIs(l, 0, "PUSH") == false || n < 3{
						return -1
					}
					if X86Core.tokenIsDigits(l, 2) && X86Core.tokenIs(l, 1, "8"){
						if values != 1{
							return -1
						}
						let v = mut ? X86Core.tokenS64(l, 2)
						if v >= 1 && v <= 64{
							return v
						}
						return -1
					}
					values += 1
					if values > 1{
						return -1
					}
				}
			} }
			if present == false{
				return -1
			}
		}
		return -1
	}

	@pub
	@throws
	func movRegToXmm(_self: ref some mut self, gpr64: ref imut String, xmmReg: ref imut String) void{
		?catch(e){ throw e }
		let ln1 = mut ? String.from("    movq %")
		match Some(gpr64){ ? ln1.append(ln1, gpr64) }
		? ln1.append(ln1, ", %")
		match Some(xmmReg){ ? ln1.append(ln1, xmmReg) }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln1) } } }
	}

	@pub
	@throws
	func movXmmToReg(_self: ref some mut self, xmmReg: ref imut String, gpr64: ref imut String) void{
		?catch(e){ throw e }
		let ln2 = mut ? String.from("    movq %")
		match Some(xmmReg){ ? ln2.append(ln2, xmmReg) }
		? ln2.append(ln2, ", %")
		match Some(gpr64){ ? ln2.append(ln2, gpr64) }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln2) } } }
	}

	@pub
	func sseSuffix(_self: ref some mut self, size: mut s32) static imut string{
		if size <= 4{
			return "ss"
		}
		return "sd"
	}

	@pub
	@throws
	func pushSizedOrBlockFromAddr(_self: ref some mut self, addrReg64: ref imut String, size: mut s32) void{
		?catch(e){ throw e }
		let rax = mut ? String.from("rax")
		let r11 = mut ? String.from("r11")
		if size <= 8{
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){
				? _self.hub.emit.loadSizedFromAddr(_self.hub.emit, rax, addrReg64, size)
			} } }
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.pushReg(_self.hub.emit, rax) } } }
			return
		}
		let:<mut u64> words = mut (wrap:<u64>(size + 7) / 8)
		for i in 0..words{
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){
				? _self.hub.emit.loadSizedFromAddr(_self.hub.emit, r11, addrReg64, 8)
			} } }
			if i + 1 < words{
				let ln10 = mut ? String.from("    addq $8, %")
				match Some(addrReg64){ ? ln10.append(ln10, addrReg64) }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln10) } } }
			}
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.pushReg(_self.hub.emit, r11) } } }
		}
	}

	@pub
	func argReg(_self: ref some mut self, index: mut s32) static imut string{
		let win = mut false
		match Some(_self.core){ win = _self.core.target == CodegenTarget.WINDOWS_GNU_X64 }
		if win{
			if index == 0{ return "rcx" } elseif index == 1{ return "rdx" } elseif index == 2{ return "r8" } elseif index == 3{ return "r9" }
		} else{
			if index == 0{ return "rdi" } elseif index == 1{ return "rsi" } elseif index == 2{ return "rdx" } elseif index == 3{ return "rcx" } elseif index == 4{ return "r8" } elseif index == 5{ return "r9" }
		}
		return "rax"
	}

	@pub
	func argFloatReg(_self: ref some mut self, index: mut s32) static imut string{
		let win = mut false
		match Some(_self.core){ win = _self.core.target == CodegenTarget.WINDOWS_GNU_X64 }
		if index == 0{ return "xmm0" } elseif index == 1{ return "xmm1" } elseif index == 2{ return "xmm2" } elseif index == 3{ return "xmm3" }
		if win == false{
			if index == 4{ return "xmm4" } elseif index == 5{ return "xmm5" } elseif index == 6{ return "xmm6" } elseif index == 7{ return "xmm7" }
		}
		return "xmm0"
	}

	@pub
	func alignPadFor(_self: ref some mut self, stackArgBytes: mut s64) mut s32{
		if stackArgBytes % 16 == 0{
			return 16
		}
		return 8
	}

	@pub
	@throws
	func emitStackArgRestore(_self: ref some mut self, stackArgBytes: mut s64) void{
		?catch(e){ throw e }
		let ln3 = mut ? String.from("    movq ")
		? ln3.appendS64(ln3, stackArgBytes)
		? ln3.append(ln3, "(%rsp), %rsp")
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln3) } } }
	}

	@pub
	@throws
	func buildStackArgReservation(_self: ref some mut self, stackArgBytes: mut s64) owns some mut String{
		?catch(e){ throw e }
		let pad = mut _self.alignPadFor(_self, stackArgBytes)
		let r = mut ? String.from("    movq %rsp, %rax\n    andq $-16, %rsp\n    subq $")
		? r.appendS64(r, wrap:<s64>(pad))
		? r.append(r, ", %rsp\n    movq %rax, (%rsp)\n")
		return r
	}

	@pub
	@throws
	func reverseStackArgWords(_self: ref some mut self, stackArgBytes: mut s64) void{
		?catch(e){ throw e }
		let:<mut u64> words = mut 0
		if stackArgBytes > 0{
			words = wrap:<u64>(stackArgBytes) / 8
		}
		let:<mut u64> half = mut (words / 2)
		for i in 0..half{
			let:<mut s64> lo = mut (wrap:<s64>(i) * 8)
			let:<mut s64> hi = mut (wrap:<s64>(words - 1 - i) * 8)
			let ln6 = mut ? String.from("    movq ")
			? ln6.appendS64(ln6, lo)
			? ln6.append(ln6, "(%rsp), %rax")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln6) } } }
			let ln7 = mut ? String.from("    movq ")
			? ln7.appendS64(ln7, hi)
			? ln7.append(ln7, "(%rsp), %r11")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln7) } } }
			let ln8 = mut ? String.from("    movq %r11, ")
			? ln8.appendS64(ln8, lo)
			? ln8.append(ln8, "(%rsp)")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln8) } } }
			let ln9 = mut ? String.from("    movq %rax, ")
			? ln9.appendS64(ln9, hi)
			? ln9.append(ln9, "(%rsp)")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln9) } } }
		}
	}

	@pub
	@throws
	func resolveStackArgBytesAndCall(_self: ref some mut self, indirect: mut bool, target: ref imut String) void{
		let counted = mut false
		?catch(e){
			if counted{
				match Some(_self){ match Some(_self.core){ _self.core.argTrackSuspendDepth = _self.core.argTrackSuspendDepth - 1 } }
			}
			throw e
		}
		let empty = mut false
		match Some(_self){ match Some(_self.core){
			empty = len(_self.core.argTrackDeltaStack.backing) == 0 || _self.core.callBufferStack.isEmpty(_self.core.callBufferStack)
		} }
		if empty{
			match Some(_self){ ? _self.emitAlignedCall(_self, indirect, target) }
			return
		}
		let:<mut s64> sab = mut 0
		match Some(_self){ match Some(_self.core){ sab = ? _self.core.argTrackDeltaStack.popBack(_self.core.argTrackDeltaStack, 0) } }
		match Some(_self){ match Some(_self.core){ ? _self.core.argTrackDeltaStack.pushBack(_self.core.argTrackDeltaStack, sab) } }
		if sab <= 0{
			match Some(_self){ ? _self.emitAlignedCall(_self, indirect, target) }
			return
		}
		let nb = mut ? new String()
		match Some(_self){ nb = ? _self.buildStackArgReservation(_self, sab) }
		match Some(_self){ match Some(_self.core){
			let cur = _self.core.callBufferStack.peek(_self.core.callBufferStack)
			match Some(cur){ ? nb.append(nb, cur) }
		} }
		match Some(_self){ match Some(_self.core){ ? _self.core.callBufferStack.removeLast(_self.core.callBufferStack) } }
		match Some(_self){ match Some(_self.core){ ? _self.core.callBufferStack.add(_self.core.callBufferStack, nb) } }
		let winAbi = mut false
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ winAbi = _self.hub.emit.isWinAbi(_self.hub.emit) } } }
		match Some(_self){ match Some(_self.core){ _self.core.argTrackSuspendDepth = _self.core.argTrackSuspendDepth + 1 } }
		counted = true
		match Some(_self){ ? _self.reverseStackArgWords(_self, sab) }
		if winAbi{
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.rawLit(_self.hub.emit, "    subq $32, %rsp") } } }
		} else{
			let:<mut s32> xmmCount = mut 0
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ xmmCount = _self.hub.emit.consumeVarargsXmmCount(_self.hub.emit) } } }
			let ln = mut ? String.from("    movl $")
			? ln.appendS64(ln, xmmCount as s64)
			? ln.append(ln, ", %eax")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln) } } }
		}
		match Some(_self){ ? _self.emitCallTarget(_self, indirect, target) }
		if winAbi{
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.rawLit(_self.hub.emit, "    addq $32, %rsp") } } }
		}
		match Some(_self){ match Some(_self.core){ _self.core.argTrackSuspendDepth = _self.core.argTrackSuspendDepth - 1 } }
		counted = false
		match Some(_self){ ? _self.emitStackArgRestore(_self, sab) }
	}

	@pub
	@throws
	func emitCallTarget(_self: ref some mut self, indirect: mut bool, target: ref imut String) void{
		?catch(e){ throw e }
		if indirect{
			match Some(_self){ ? _self.emitCallIndirect(_self, target) }
		} else{
			match Some(_self){ ? _self.emitCallByName(_self, target) }
		}
	}

	@pub
	@throws
	func emitAlignedCallByName(_self: ref some mut self, name: ref imut String) void{
		?catch(e){ throw e }
		match Some(_self){ ? _self.emitAlignedCall(_self, false, name) }
	}

	@pub
	@throws
	func emitAlignedCall(_self: ref some mut self, indirect: mut bool, target: ref imut String) void{
		match Some(_self){ match Some(_self.core){ _self.core.argTrackSuspendDepth = _self.core.argTrackSuspendDepth + 1 } }
		?catch(e){
			match Some(_self){ match Some(_self.core){ _self.core.argTrackSuspendDepth = _self.core.argTrackSuspendDepth - 1 } }
			throw e
		}
		let winAbi = mut false
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ winAbi = _self.hub.emit.isWinAbi(_self.hub.emit) } } }
		let ln11 = mut ? String.from("    movq %rsp, %rax")
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln11) } } }
		let ln12 = mut ? String.from("    andq $-16, %rsp")
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln12) } } }
		let ln13 = mut ? String.from("    subq $16, %rsp")
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln13) } } }
		let ln14 = mut ? String.from("    movq %rax, 8(%rsp)")
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln14) } } }
		if winAbi{
			let ln15 = mut ? String.from("    subq $32, %rsp")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln15) } } }
		} else{
			let:<mut s32> xmmCount = mut 0
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ xmmCount = _self.hub.emit.consumeVarargsXmmCount(_self.hub.emit) } } }
			let ln16 = mut ? String.from("    movl $")
			? ln16.appendS64(ln16, xmmCount as s64)
			? ln16.append(ln16, ", %eax")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln16) } } }
		}
		match Some(_self){ ? _self.emitCallTarget(_self, indirect, target) }
		if winAbi{
			let ln17 = mut ? String.from("    addq $32, %rsp")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln17) } } }
		}
		let ln18 = mut ? String.from("    movq 8(%rsp), %rsp")
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln18) } } }
		match Some(_self){ match Some(_self.core){ _self.core.argTrackSuspendDepth = _self.core.argTrackSuspendDepth - 1 } }
	}

	@pub
	@throws
	func emitCallByName(_self: ref some mut self, name: ref imut String) void{
		?catch(e){ throw e }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.gen){ ? _self.hub.gen.xvSpillAll(_self.hub.gen) } } }
		let ln4 = mut ? String.from("    call ")
		match Some(name){ ? ln4.append(ln4, name) }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln4) } } }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.gen){ ? _self.hub.gen.xvReloadAll(_self.hub.gen) } } }
	}

	@pub
	@throws
	func emitCallIndirect(_self: ref some mut self, reg64: ref imut String) void{
		?catch(e){ throw e }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.gen){ ? _self.hub.gen.xvSpillAll(_self.hub.gen) } } }
		let ln5 = mut ? String.from("    call *%")
		match Some(reg64){ ? ln5.append(ln5, reg64) }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln5) } } }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.gen){ ? _self.hub.gen.xvReloadAll(_self.hub.gen) } } }
	}

	@pub
	@throws
	func emitLine(_self: ref some mut self, line: ref imut BytecodeStatement) void{
		?catch(e){ throw e }
		let special = mut false
		let n = mut 0
		match Some(line){ n = line.items.size(line.items) }
		let ok = mut false
		match Some(_self){ match Some(_self.core){
			ok = n >= 1 && _self.core.currentLineIndex > _self.core.asmSkipUntilIndex && _self.core.csrFuncStart >= 0
		} }
		if ok{
			let isLabelOnly = mut false
			match Some(line){
				if n == 1{
					let t0 = line.items.get(line.items, 0)
					match Some(t0){ isLabelOnly = t0.text.endsWith(t0.text, ":") }
				}
			}
			let user = mut false
			match Some(line){
				user = X86Core.tokenIs(line, 0, "NEW") || X86Core.tokenIs(line, 0, "NEW_DYN") || X86Core.tokenIs(line, 0, "NEW_UDYN") || X86Core.tokenIs(line, 0, "NEW_FROM_STRING") || X86Core.tokenIs(line, 0, "NEW_FROM_USTRING") || X86Core.tokenIs(line, 0, "CLONE") || X86Core.tokenIs(line, 0, "CLONE_DYN") || X86Core.tokenIs(line, 0, "RESIZE") || X86Core.tokenIs(line, 0, "URESIZE") || X86Core.tokenIs(line, 0, "DOT") || X86Core.tokenIs(line, 0, "LOOKUP_ARRAY")
			}
			special = isLabelOnly == false && user
		}
		if special{
			let ln312 = mut ? String.from("@@V1314S@@")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln312) } } }
			match Some(_self){ ? _self.emitLineInner(_self, line) }
			let ln313 = mut ? String.from("@@V1314R@@")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln313) } } }
			return
		}
		match Some(_self){ ? _self.emitLineInner(_self, line) }
	}

	@pub
	@throws
	func emitLineInner(_self: ref some mut self, line: ref imut BytecodeStatement) void{
		?catch(e){ throw e }
		let n = mut 0
		match Some(line){ n = line.items.size(line.items) }
		if n == 0{
			return
		}
		let skip = mut false
		match Some(_self){ match Some(_self.core){
			if _self.core.currentLineIndex <= _self.core.asmSkipUntilIndex{
				skip = true
			}
		} }
		if skip{
			return
		}
		let first = mut ? new String()
		match Some(line){ first = ? X86Core.lineTok(line, 0) }
		let isLabel = mut false
		match Some(first){
			if n == 1 && first.endsWith(first, ":"){
				isLabel = true
			}
		}
		if isLabel{
			let name = mut ? new String()
			match Some(first){ name = ? first.sub(first, 0, first.length(first) - 1) }
			let mangled = mut ? new String()
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.gen){ match Some(name){ mangled = ? _self.hub.gen.mangleLabel(_self.hub.gen, name) } } } }
			? mangled.append(mangled, ":")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, mangled) } } }
			let isCatch = mut false
			match Some(first){ isCatch = first.contains(first, "catch_") }
			let inFunc = mut false
			match Some(_self){ match Some(_self.core){
				if _self.core.csrFuncStart >= 0{
					inFunc = true
				}
			} }
			if isCatch && inFunc{
				let mark = mut ? String.from("@@RSP@@")
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, mark) } } }
			}
			return
		}
		let wasCmp = mut false
		let:<mut s64> pending = mut 0
		match Some(_self){ match Some(_self.core){
			if _self.core.lastWasCmp{
				wasCmp = true
			}
			_self.core.lastWasCmp = false
			pending = _self.core.lastValueBlockSize
			_self.core.lastValueBlockSize = 0
		} }
		let isPush = mut false
		match Some(first){ isPush = first.equals(first, "PUSH") }
		let digits = mut false
		match Some(line){
			if isPush && n > 1{
				digits = X86Core.tokenIsDigits(line, 1)
			}
		}
		if digits{
			match Some(_self){ match Some(_self.core){
				if pending != 0 && _self.core.pushedWordWithTag{
					pending = 0
				}
			} }
			let is8 = mut false
			match Some(line){ is8 = X86Core.tokenIs(line, 1, "8") }
			match Some(_self){ match Some(_self.core){
				_self.core.pushedWordWithTag = pending != 0 && is8
			} }
		} else{
			match Some(_self){ match Some(_self.core){ _self.core.pushedWordWithTag = false } }
		}
		match Some(first){
			if first.equals(first, "ASM_START"){
				match Some(_self){ match Some(_self.core){ _self.core.rfClobberSeen = true } }
			}
		}
		for k in 1..8{
			let done = mut false
			match Some(_self){ match Some(first){
				done = ? _self.runCase(_self, wrap:<u64>(k), first, line, wasCmp, pending)
			} }
			if done{
				return
			}
		}
		let txt = mut ? new String()
		match Some(line){
			let parts = mut ? X86Core.textsOf(line)
			match Some(parts){
				for pi in 0..n{
					if pi > 0{
						? txt.append(txt, " ")
					}
					let piece = parts.get(parts, pi)
					match Some(piece){
						? txt.append(txt, piece)
					}
				}
			}
		}
		let msg = mut ? String.from("TODO(codegen): '")
		? msg.append(msg, txt)
		? msg.append(msg, "' not yet implemented")
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.comment(_self.hub.emit, msg) } } }
	}

	/** Port helper: calls `emitCases<k>` of the part that owns it. */
	@pub
	@throws
	func runCase(_self: ref some mut self, k: mut u64, first: ref imut String, line: ref imut BytecodeStatement, wasCmp: mut bool, pending: mut s64) mut bool{
		?catch(e){ throw e }
		let r = mut false
		if k == 1{
			match Some(_self){ r = ? _self.emitCases1(_self, first, line, first, wasCmp, pending) }
		}
		if k == 2{
