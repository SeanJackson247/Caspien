				match Some(_self){ ? _self.rfMov(_self, dstTok, aTok) }
			}
			if c != 0{
				if size < 4{
					match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(d){ ? _self.hub.emit.zeroExtendReg(_self.hub.emit, d, size) } } } }
				}
				let ln = mut ? String.from("    ")
				match Some(mn){ ? ln.append(ln, mn) }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? ln.append(ln, _self.hub.emit.movSuffix(_self.hub.emit, size)) } } }
				? ln.append(ln, " $")
				? ln.appendS64(ln, c)
				? ln.append(ln, ", %")
				match Some(szd){ ? ln.append(ln, szd) }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln) } } }
			}
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(d){ ? _self.hub.emit.zeroExtendReg(_self.hub.emit, d, size) } } } }
			return
		}
		let rcx = mut ? String.from("rcx")
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(rcx){ ? _self.hub.emit.pushReg(_self.hub.emit, rcx) } } } }
		let bT = mut false
		match Some(bTok){ bT = X86Core.rfIsTemp(bTok) }
		if bT{
			let bs = mut ? new String()
			match Some(_self){ match Some(bTok){
				let b0 = ? _self.rfReg(_self, bTok)
				bs = ? String.from(b0)
			} }
			match Some(_self){ match Some(bs){ ? _self.rfRegToReg(_self, rcx, bs) } }
		} else{
			let:<mut s64> off = mut 0
			match Some(bTok){ off = ? X86Core.rfSlot(bTok) }
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(rcx){ ? _self.hub.emit.movMemToReg(_self.hub.emit, rcx, off) } } } }
		}
		if aIsD == false{
			match Some(_self){ ? _self.rfMov(_self, dstTok, aTok) }
		}
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(d){ ? _self.hub.emit.zeroExtendReg(_self.hub.emit, d, size) } } } }
		let ln2 = mut ? String.from("    ")
		match Some(mn){ ? ln2.append(ln2, mn) }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? ln2.append(ln2, _self.hub.emit.movSuffix(_self.hub.emit, size)) } } }
		? ln2.append(ln2, " %cl, %")
		match Some(szd){ ? ln2.append(ln2, szd) }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln2) } } }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(rcx){ ? _self.hub.emit.popReg(_self.hub.emit, rcx) } } } }
	}

	@pub
	@throws
	func rfShift(_self: ref some mut self, op: ref imut String, size: mut s32, dstTok: ref imut String, aTok: ref imut String, bTok: ref imut String) void{
		?catch(e){ throw e }
		let d = mut ? new String()
		match Some(_self){ match Some(dstTok){
			let d0 = ? _self.rfReg(_self, dstTok)
			d = ? String.from(d0)
		} }
		let aIsD = mut false
		let aT = mut false
		match Some(aTok){ aT = X86Core.rfIsTemp(aTok) }
		if aT{
			match Some(_self){ match Some(aTok){ match Some(d){
				let a0 = ? _self.rfReg(_self, aTok)
				let as0 = ? String.from(a0)
				aIsD = as0.equals(as0, d)
			} } }
		}
		let isSar = mut false
		let isShr = mut false
		let isShl = mut false
		match Some(op){
			isSar = op.equals(op, "SAR")
			isShr = op.equals(op, "SHR")
			isShl = op.equals(op, "SHL")
		}
		let bImm = mut false
		match Some(bTok){ bImm = X86Core.rfIsImm(bTok) }
		let r15 = mut ? String.from("r15")
		let rcx = mut ? String.from("rcx")
		if bImm{
			let:<mut s64> iv = mut 0
			match Some(bTok){ iv = ? X86Core.rfImm(bTok) }
			let:<mut s64> c = mut X86Core.rfExtImm(iv, size, false)
			let wide = mut (c < 0 || c > 63)
			if aIsD == false{
				match Some(_self){ ? _self.rfMov(_self, dstTok, aTok) }
			}
			if wide && isSar == false{
				let d4 = mut ? new String()
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(d){ d4 = ? _self.hub.emit.sizedReg(_self.hub.emit, d, 4) } } } }
				let ln = mut ? String.from("    xorl %")
				match Some(d4){ ? ln.append(ln, d4) }
				? ln.append(ln, ", %")
				match Some(d4){ ? ln.append(ln, d4) }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln) } } }
				return
			}
			if wide{
				c = 63
			}
			if isShr{
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(d){ ? _self.hub.emit.zeroExtendReg(_self.hub.emit, d, size) } } } }
			} elseif isSar{
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(d){ ? _self.hub.emit.signExtendReg(_self.hub.emit, d, size) } } } }
			}
			if c != 0{
				let ln2 = mut ? String.from("    sar")
				if isShl{
					ln2 = ? String.from("    shl")
				} elseif isShr{
					ln2 = ? String.from("    shr")
				}
				? ln2.append(ln2, "q $")
				? ln2.appendS64(ln2, c)
				? ln2.append(ln2, ", %")
				match Some(d){ ? ln2.append(ln2, d) }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln2) } } }
			}
			if isShr == false{
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(d){ ? _self.hub.emit.zeroExtendReg(_self.hub.emit, d, size) } } } }
			}
			return
		}
		let bmi = mut false
		match Some(_self){ match Some(_self.core){ if _self.core.bmi2{ bmi = true } } }
		let bT = mut false
		match Some(bTok){ bT = X86Core.rfIsTemp(bTok) }
		if bmi && isSar == false{
			if bT{
				let bs = mut ? new String()
				match Some(_self){ match Some(bTok){
					let b0 = ? _self.rfReg(_self, bTok)
					bs = ? String.from(b0)
				} }
				match Some(_self){ match Some(bs){ ? _self.rfRegToReg(_self, r15, bs) } }
			} else{
				let:<mut s64> off = mut 0
				match Some(bTok){ off = ? X86Core.rfSlot(bTok) }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(r15){ ? _self.hub.emit.movMemToReg(_self.hub.emit, r15, off) } } } }
			}
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(r15){ ? _self.hub.emit.zeroExtendReg(_self.hub.emit, r15, size) } } } }
			if aIsD == false{
				match Some(_self){ ? _self.rfMov(_self, dstTok, aTok) }
			}
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(op){ match Some(d){ match Some(r15){ ? _self.hub.emit.emitShiftBmi2(_self.hub.emit, op, size, d, r15) } } } } } }
			return
		}
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(rcx){ ? _self.hub.emit.pushReg(_self.hub.emit, rcx) } } } }
		if bT{
			let bs2 = mut ? new String()
			match Some(_self){ match Some(bTok){
				let b1 = ? _self.rfReg(_self, bTok)
				bs2 = ? String.from(b1)
			} }
			match Some(_self){ match Some(bs2){ ? _self.rfRegToReg(_self, rcx, bs2) } }
		} else{
			let:<mut s64> off2 = mut 0
			match Some(bTok){ off2 = ? X86Core.rfSlot(bTok) }
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(rcx){ ? _self.hub.emit.movMemToReg(_self.hub.emit, rcx, off2) } } } }
		}
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(rcx){ ? _self.hub.emit.zeroExtendReg(_self.hub.emit, rcx, size) } } } }
		if aIsD == false{
			match Some(_self){ ? _self.rfMov(_self, dstTok, aTok) }
		}
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(op){ match Some(d){ ? _self.hub.emit.emitShiftCore(_self.hub.emit, op, size, d) } } } } }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(rcx){ ? _self.hub.emit.popReg(_self.hub.emit, rcx) } } } }
	}

	/** `raw` of pre + number + post (helper of the port; no Java counterpart). */
	@pub
	@throws
	func rawNum(_self: ref some mut self, pre: static imut string, n: mut s64, post: static imut string) void{
		?catch(e){ throw e }
		let ln = mut ? String.from(pre)
		? ln.appendS64(ln, n)
		? ln.append(ln, post)
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln) } } }
	}

	/** Loads the dividend `aTok` into `reg` (zero-extending a narrow non-immediate): the shared head of `rfDivConst`'s paths. */
	@pub
	@throws
	func divLoadDividend(_self: ref some mut self, reg: ref imut String, aTok: ref imut String, size: mut s32, extend: mut bool) void{
		?catch(e){ throw e }
		let aT = mut false
		let aI = mut false
		match Some(aTok){
			aT = X86Core.rfIsTemp(aTok)
			aI = X86Core.rfIsImm(aTok)
		}
		if aT{
			let as0 = mut ? new String()
			match Some(_self){ match Some(aTok){
				let a0 = ? _self.rfReg(_self, aTok)
				as0 = ? String.from(a0)
			} }
			match Some(_self){ match Some(reg){ match Some(as0){ ? _self.rfRegToReg(_self, reg, as0) } } }
		} elseif aI{
			let:<mut s64> iv = mut 0
			match Some(aTok){ iv = ? X86Core.rfImm(aTok) }
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(reg){ ? _self.hub.emit.movImmToReg(_self.hub.emit, reg, X86Core.rfExtImm(iv, size, false)) } } } }
		} else{
			let:<mut s64> off = mut 0
			match Some(aTok){ off = ? X86Core.rfSlot(aTok) }
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(reg){ ? _self.hub.emit.movMemToReg(_self.hub.emit, reg, off) } } } }
		}
		if extend && size < 8 && aI == false{
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(reg){ ? _self.hub.emit.zeroExtendReg(_self.hub.emit, reg, size) } } } }
		}
	}

	@pub
	@throws
	func rfDivConst(_self: ref some mut self, mod: mut bool, size: mut s32, dstTok: ref imut String, aTok: ref imut String, k: mut s64) void{
		?catch(e){ throw e }
		let d = mut ? new String()
		match Some(_self){ match Some(dstTok){
			let d0 = ? _self.rfReg(_self, dstTok)
			d = ? String.from(d0)
		} }
		let hasMs = mut false
		let:<mut s64> pre = mut 0
		let:<mut s64> mg = mut 0
		let:<mut s64> post = mut 0
		let ms0 = mut ? X86Core.divMagicSimple(k)
		match Some(ms0){
			hasMs = true
			match 0 in ms0.backing{ pre = ms0.get(ms0, 0) }
			match 1 in ms0.backing{ mg = ms0.get(ms0, 1) }
			match 2 in ms0.backing{ post = ms0.get(ms0, 2) }
		}
		let rax = mut ? String.from("rax")
		let rdx = mut ? String.from("rdx")
		let r15 = mut ? String.from("r15")
		let inRax = mut false
		match Some(d){ inRax = d.equals(d, "rax") }
		if hasMs && mod == false{
			match Some(_self){ match Some(rdx){ ? _self.divLoadDividend(_self, rdx, aTok, size, true) } }
			if pre > 0{
				match Some(_self){ ? _self.rawNum(_self, "    shrq $", pre, ", %rdx") }
			}
			if inRax == false{
				let x1 = mut ? String.from("    xchgq %rax, %")
				match Some(d){ ? x1.append(x1, d) }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, x1) } } }
			}
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(rax){ ? _self.hub.emit.movImmToReg(_self.hub.emit, rax, mg) } } } }
			match Some(_self){ ? _self.rawLitE(_self, "    mulq %rdx") }
			if post > 0{
				match Some(_self){ ? _self.rawNum(_self, "    shrq $", post, ", %rdx") }
			}
			match Some(_self){ ? _self.rawLitE(_self, "    movq %rdx, %rax") }
			if inRax == false{
				let x2 = mut ? String.from("    xchgq %rax, %")
				match Some(d){ ? x2.append(x2, d) }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, x2) } } }
			}
			return
		}
		match Some(_self){ match Some(r15){ ? _self.divLoadDividend(_self, r15, aTok, size, true) } }
		if hasMs{
			if inRax == false{
				let x3 = mut ? String.from("    xchgq %rax, %")
				match Some(d){ ? x3.append(x3, d) }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, x3) } } }
			}
			let src = mut ? String.from("r15")
			if pre > 0{
				match Some(_self){ ? _self.rawLitE(_self, "    movq %r15, %rdx") }
				match Some(_self){ ? _self.rawNum(_self, "    shrq $", pre, ", %rdx") }
				src = ? String.from("rdx")
			}
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(rax){ ? _self.hub.emit.movImmToReg(_self.hub.emit, rax, mg) } } } }
			let ml = mut ? String.from("    mulq %")
			match Some(src){ ? ml.append(ml, src) }
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ml) } } }
			if post > 0{
				match Some(_self){ ? _self.rawNum(_self, "    shrq $", post, ", %rdx") }
			}
			if mod{
				if X86Core.rfFitsImm32(k){
					match Some(_self){ ? _self.rawNum(_self, "    imulq $", k, ", %rdx, %rax") }
				} else{
					match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(rax){ ? _self.hub.emit.movImmToReg(_self.hub.emit, rax, k) } } } }
					match Some(_self){ ? _self.rawLitE(_self, "    imulq %rdx, %rax") }
				}
				match Some(_self){ ? _self.rawLitE(_self, "    subq %rax, %r15") }
				match Some(_self){ ? _self.rawLitE(_self, "    movq %r15, %rax") }
			} else{
				match Some(_self){ ? _self.rawLitE(_self, "    movq %rdx, %rax") }
			}
			if inRax == false{
				let x4 = mut ? String.from("    xchgq %rax, %")
				match Some(d){ ? x4.append(x4, d) }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, x4) } } }
			}
			return
		}
		let:<mut s32> l = mut (64 - Long.numberOfLeadingZeros(k - 1))
		let one = mut ? BigInt.valueOf(1)
		let two64 = mut ? one.shiftLeft(one, 64)
		let bk = mut ? BigInt.fromU64(wrap:<u64>(k))
		let pl = mut ? one.shiftLeft(one, wrap:<u64>(l))
		let t1 = mut ? pl.subtract(pl, bk)
		let t2 = mut ? t1.shiftLeft(t1, 64)
		let t3 = mut ? t2.divide(t2, bk)
		let t4 = mut ? t3.add(t3, one)
		let t5 = mut ? t4.mod(t4, two64)
		let:<mut s64> magic = mut wrap:<s64>(t5.toU64(t5))
		if inRax == false{
			let x5 = mut ? String.from("    xchgq %rax, %")
			match Some(d){ ? x5.append(x5, d) }
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, x5) } } }
		}
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(rax){ ? _self.hub.emit.movImmToReg(_self.hub.emit, rax, magic) } } } }
		match Some(_self){ ? _self.rawLitE(_self, "    mulq %r15") }
		match Some(_self){ ? _self.rawLitE(_self, "    movq %r15, %rax") }
		match Some(_self){ ? _self.rawLitE(_self, "    subq %rdx, %rax") }
		match Some(_self){ ? _self.rawLitE(_self, "    shrq $1, %rax") }
		match Some(_self){ ? _self.rawLitE(_self, "    addq %rdx, %rax") }
		if l > 1{
			match Some(_self){ ? _self.rawNum(_self, "    shrq $", wrap:<s64>(l - 1), ", %rax") }
		}
		if mod{
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(rdx){ ? _self.hub.emit.movImmToReg(_self.hub.emit, rdx, k) } } } }
			match Some(_self){ ? _self.rawLitE(_self, "    imulq %rdx, %rax") }
			match Some(_self){ ? _self.rawLitE(_self, "    movq %r15, %rdx") }
			match Some(_self){ ? _self.rawLitE(_self, "    subq %rax, %rdx") }
			if inRax{
				match Some(_self){ ? _self.rawLitE(_self, "    movq %rdx, %rax") }
			} else{
				let y1 = mut ? String.from("    movq %")
				match Some(d){ ? y1.append(y1, d) }
				? y1.append(y1, ", %rax")
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, y1) } } }
				let y2 = mut ? String.from("    movq %rdx, %")
				match Some(d){ ? y2.append(y2, d) }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, y2) } } }
			}
		} elseif inRax == false{
			let x6 = mut ? String.from("    xchgq %rax, %")
			match Some(d){ ? x6.append(x6, d) }
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, x6) } } }
		}
	}

	/** `rawLit` through the emitter (helper of the port; no Java counterpart). */
	@pub
	@throws
	func rawLitE(_self: ref some mut self, text: static imut string) void{
		?catch(e){ throw e }
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.rawLit(_self.hub.emit, text) } } }
	}
}
