				match Some(src){ off = ? X86Core.rfSlot(src) }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.movMemToReg(_self.hub.emit, d, off) } } }
			} else{
				let s = mut ? new String()
				match Some(_self){ match Some(src){
