	@pub
	@throws
	func rfMov(_self: ref some mut self, dst: ref imut String, src: ref imut String) void{
		?catch(e){ throw e }
		let dTemp = mut false
		match Some(dst){ dTemp = X86Core.rfIsTemp(dst) }
		let sTemp = mut false
		let sImm = mut false
		let sSlot = mut false
		match Some(src){
			sTemp = X86Core.rfIsTemp(src)
			sImm = X86Core.rfIsImm(src)
			sSlot = X86Core.rfIsSlot(src)
		}
