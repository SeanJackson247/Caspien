	@pub
	@throws
	func rfRotate(_self: ref some mut self, op: ref imut String, size: mut s32, dstTok: ref imut String, aTok: ref imut String, bTok: ref imut String) void{
		?catch(e){ throw e }
		let d = mut ? new String()
		match Some(_self){ match Some(dstTok){
			let d0 = ? _self.rfReg(_self, dstTok)
			d = ? String.from(d0)
		} }
		let aIsD = mut false
		let aT = mut false
		match Some(aTok){ aT = X86Core.rfIsTemp(aTok) }
		if aT{
			match Some(_self){ match Some(aTok){ match Some(d){
				let a0 = ? _self.rfReg(_self, aTok)
				let as0 = ? String.from(a0)
				aIsD = as0.equals(as0, d)
			} } }
		}
		let mn = mut ? String.from("ror")
		match Some(op){ if op.equals(op, "ROTL"){ mn = ? String.from("rol") } }
		let bImm = mut false
		match Some(bTok){ bImm = X86Core.rfIsImm(bTok) }
		let szd = mut ? new String()
		match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(d){ szd = ? _self.hub.emit.sizedReg(_self.hub.emit, d, size) } } } }
		if bImm{
			let:<mut s64> c = mut 0
			let:<mut s64> iv = mut 0
			match Some(bTok){ iv = ? X86Core.rfImm(bTok) }
			c = bits_and(X86Core.rfExtImm(iv, size, false), wrap:<s64>(size) * 8 - 1)
