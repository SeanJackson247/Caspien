	/** The physical register name of a `%tN`/`%vN`/`%s` token; marks the r12-r14 variable registers as used. */
	@pub
	@throws
	func rfReg(_self: ref some mut self, tok: ref some imut String) static imut string{
		?catch(e){ throw e }
		if tok.equals(tok, "%s"){
			return "r15"
		}
		let isVar = mut tok.startsWith(tok, "%v")
		let numText = mut ? tok.substring(tok, 2)
		let idx = mut 0
		match Some(numText){
			idx = ? numText.parseU64(numText)
		}
		if isVar{
			if idx < 3{
				let:<mut s32> bit = mut 1
				if idx == 1{
					bit = 2
				} elseif idx == 2{
					bit = 4
				}
				match Some(_self){
					match Some(_self.core){
						_self.core.rfVarMask = bits_or(_self.core.rfVarMask, bit)
						_self.core.rfVarUsed = true
					}
				}
			}
			let v = ? X86Core.rfVarRegName(idx)
			return v
		}
		let t = ? X86Core.rfTempRegName(idx)
		return t
	}

