			let s2 = mut ? new String()
			match Some(_self){ match Some(src){
				let s20 = ? _self.rfReg(_self, src)
				s2 = ? String.from(s20)
			} }
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.movRegToMem(_self.hub.emit, s2, doff) } } }
		} elseif sImm{
