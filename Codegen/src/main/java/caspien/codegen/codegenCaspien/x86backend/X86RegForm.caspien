		?catch(e){ throw e }
		let isTemp = mut false
		let isSlot = mut false
		match Some(tok){
			isTemp = X86Core.rfIsTemp(tok)
			isSlot = X86Core.rfIsSlot(tok)
		}
		if isTemp{
			let out = mut ? new String()
			match Some(_self){ match Some(tok){
				let rg = ? _self.rfReg(_self, tok)
				out = ? _self.rfRegText(_self, rg)
			} }
			return out
		}
		if isSlot{
			let:<mut s64> off = mut 0
			match Some(tok){ off = ? X86Core.rfSlot(tok) }
			let out2 = mut ? new String()
			match Some(_self){ out2 = ? _self.rfMemText(_self, off) }
			return out2
		}
		let:<mut s64> v = mut 0
		match Some(tok){ v = ? X86Core.rfImm(tok) }
		if X86Core.rfFitsImm32(v) == false{
			let r15 = mut ? String.from("r15")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.movImmToReg(_self.hub.emit, r15, v) } } }
			let out3 = mut ? new String()
			match Some(_self){ out3 = ? _self.rfRegText(_self, "r15") }
			return out3
		}
		let out4 = mut ? String.from("$")
		? out4.appendS64(out4, v)
		return out4
	}

