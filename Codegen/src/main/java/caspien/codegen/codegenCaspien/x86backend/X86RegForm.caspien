		?catch(e){ throw e }
		let dTemp = mut false
		match Some(dst){ dTemp = X86Core.rfIsTemp(dst) }
		let sTemp = mut false
		let sImm = mut false
		let sSlot = mut false
		match Some(src){
			sTemp = X86Core.rfIsTemp(src)
			sImm = X86Core.rfIsImm(src)
			sSlot = X86Core.rfIsSlot(src)
		}
		let r15 = mut ? String.from("r15")
		if dTemp{
			let d = mut ? new String()
			match Some(_self){ match Some(dst){
				let d0 = ? _self.rfReg(_self, dst)
				d = ? String.from(d0)
			} }
			if sImm{
				let:<mut s64> v = mut 0
				match Some(src){ v = ? X86Core.rfImm(src) }
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.movImmToReg(_self.hub.emit, d, v) } } }
			} elseif sSlot{
