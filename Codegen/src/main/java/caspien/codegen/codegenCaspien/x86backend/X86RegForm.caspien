	@pub
	@throws
	func emitResizeWideFillCopy(_self: ref some mut self, elemSize: mut s32, words: mut s32) void{
		?catch(e){ throw e }
		let rdx = mut ? String.from("rdx")
		let:<mut u64> wcount = mut 0
		if words > 0{
			wcount = wrap:<u64>(words)
		}
		for kk in 0..wcount{
			let:<mut s32> k = mut wrap:<s32>(kk)
			let:<mut s64> extra = mut 0
			match Some(_self){ match Some(_self.core){ extra = _self.core.resizeExtraStack as s64 } }
			let:<mut s64> srcOff = mut ((wrap:<s64>(words - 1 - k)) * 8 + extra)
			let:<mut s32> n = mut (elemSize - 8 * k)
			if n > 8{
				n = 8
			}
			let ln502 = mut ? String.from("    movq ")
			? ln502.appendS64(ln502, srcOff)
			? ln502.append(ln502, "(%rsp), %rdx")
			match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln502) } } }
			let:<mut s64> dst = mut (8 * (k as s64))
			let:<mut s32> b = mut 0
			let:<mut u64> guard = mut 0
			if n > 0{
				guard = wrap:<u64>(n)
			}
			for gg in 0..guard{
				if b >= n{
					break
				}
				let:<mut s32> chunk = mut 1
				if n - b >= 8{
					chunk = 8
				} elseif n - b >= 4{
					chunk = 4
				} elseif n - b >= 2{
					chunk = 2
				}
				let:<mut s64> at = mut (dst + (b as s64))
				let ln503 = mut ? String.from("    mov")
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? ln503.append(ln503, _self.hub.emit.movSuffix(_self.hub.emit, chunk)) } } }
				? ln503.append(ln503, " %")
				let t1 = mut ? new String()
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ match Some(rdx){ t1 = ? _self.hub.emit.sizedReg(_self.hub.emit, rdx, chunk) } } } }
				? ln503.append(ln503, t1)
				? ln503.append(ln503, ", ")
				? ln503.appendS64(ln503, at)
				? ln503.append(ln503, "(%rax)")
				match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln503) } } }
				if b + chunk < n{
					let:<mut s32> bits = mut (chunk * 8)
					let ln504 = mut ? String.from("    shrq $")
					? ln504.appendS64(ln504, bits as s64)
					? ln504.append(ln504, ", %rdx")
					match Some(_self){ match Some(_self.hub){ match Some(_self.hub.emit){ ? _self.hub.emit.raw_(_self.hub.emit, ln504) } } }
				}
				b = b + chunk
			}
		}
	}

