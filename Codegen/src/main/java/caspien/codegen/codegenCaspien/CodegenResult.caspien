import "../../../../../../../stdlib/string.caspien"
import "collections.caspien"

@pub
struct CodegenResult{@pub{
	asm: owns mut String
	messages: owns some mut ObjectList<String>
	failed: imut bool
}}

impl constructor for CodegenResult(asm: owns mut String, messages: owns some mut ObjectList<String>, failed: imut bool) self{
	return CodegenResult{asm= asm, messages= messages, failed= failed}
}
