// LRU cache benchmark (LRU_N operations): fixed capacity 262144, key space 1048576, 75% of operations on a hot half-capacity subset.
// Recency list = index-based doubly linked list in dynarrays (a recursive struct is rejected on purpose, so no node pointers).
// get: hit -> hits+1, move to front, checksum += value + key; miss -> misses+1. put: update + move to front, or insert at the front
// evicting the least recently used entry when full (checksum += evicted key). Elements are u64 (the C reference uses u32).
// Prints: hits misses checksum. Generated by a script from one template; all three variants are the same algorithm.
// NAIVE variant: the stdlib DynamicArray<u64> class for the node pool (get/set methods, each under its bounds proof) and the stdlib
// HashMap<u64> (key -> node index; the stdlib map has no remove, so an evicted key is overwritten with the NONE sentinel).
import "../../../stdlib/libc.caspien"
import "../../../stdlib/dynamic_array.caspien"
import "../../../stdlib/hash_map.caspien"
import "../../../stdlib/gt_init.caspien"
import "../../../stdlib/gt_register.caspien"
import "../../../stdlib/gt_alive_check.caspien"
import "../../../stdlib/gt_destruct.caspien"
import "../../../stdlib/gt_moved.caspien"

extern getenv(static imut string) static imut string
extern atol(static imut string) mut u64

func main() void{
	?catch(e){ return }
	unsafe{
		let n = mut 0
		n = atol(getenv("LRU_N"))
		let:<mut u64> zero = mut 0
		let none = mut 0xFFFFFFFF
		let rkey = mut ? dyn:<u64>([])
		let rval = mut ? dyn:<u64>([])
		let rprv = mut ? dyn:<u64>([])
		let rnxt = mut ? dyn:<u64>([])
		rkey = ? resize(rkey, 262144, zero)
		let key = mut ? new DynamicArray:<u64>(rkey)
		rval = ? resize(rval, 262144, zero)
		let val = mut ? new DynamicArray:<u64>(rval)
		rprv = ? resize(rprv, 262144, zero)
		let prv = mut ? new DynamicArray:<u64>(rprv)
		rnxt = ? resize(rnxt, 262144, zero)
		let nxt = mut ? new DynamicArray:<u64>(rnxt)
		let idx = mut ? new HashMap:<u64>(mut 0, mut 0, mut 2097152)
		let head = mut 0xFFFFFFFF
		let tail = mut 0xFFFFFFFF
		let size = mut 0
		let hits = mut 0
		let misses = mut 0
		let sum = mut 0
		let x = mut 12345
		for op in 0..n{
			x = bits_and(x * 1664525 + 1013904223, 0xFFFFFFFF)
			let a = mut x
			x = bits_and(x * 1664525 + 1013904223, 0xFFFFFFFF)
			let y = mut x
			let range = mut 131072
			if (y / 1048576) % 4 == 0{
				range = 1048576
			}
			let k = mut ((a / 256) % range)
			let i = mut none
			i = idx.get(idx, mut k, mut none)
			if (y / 16777216) % 4 != 0{
				if i != none{
					hits += 1
					let v = mut 0
					match i in val.backing{
						v = val.get(val, i)
					}
					sum = bits_and(sum + v + k, 0xFFFFFFFF)
					let p_1 = mut 0
					let q_2 = mut 0
					match i in prv.backing{
						p_1 = prv.get(prv, i)
					}
					match i in nxt.backing{
						q_2 = nxt.get(nxt, i)
					}
					if p_1 != none{
						match p_1 into nxt.backing{
							nxt.set(nxt, p_1, q_2)
						}
					}else{
						head = q_2
					}
					if q_2 != none{
						match q_2 into prv.backing{
							prv.set(prv, q_2, p_1)
						}
					}else{
						tail = p_1
					}
					match i into prv.backing{
						prv.set(prv, i, none)
					}
					match i into nxt.backing{
						nxt.set(nxt, i, head)
					}
					if head != none{
						match head into prv.backing{
							prv.set(prv, head, i)
						}
					}else{
						tail = i
					}
					head = i
				}else{
					misses += 1
				}
			}else{
				if i != none{
					match i into val.backing{
						val.set(val, i, y)
					}
					let p_3 = mut 0
					let q_4 = mut 0
					match i in prv.backing{
						p_3 = prv.get(prv, i)
					}
					match i in nxt.backing{
						q_4 = nxt.get(nxt, i)
					}
					if p_3 != none{
						match p_3 into nxt.backing{
							nxt.set(nxt, p_3, q_4)
						}
					}else{
						head = q_4
					}
					if q_4 != none{
						match q_4 into prv.backing{
							prv.set(prv, q_4, p_3)
						}
					}else{
						tail = p_3
					}
					match i into prv.backing{
						prv.set(prv, i, none)
					}
					match i into nxt.backing{
						nxt.set(nxt, i, head)
					}
					if head != none{
						match head into prv.backing{
							prv.set(prv, head, i)
						}
					}else{
						tail = i
					}
					head = i
				}else{
					if size == 262144{
						i = tail
						let evk = mut 0
						match i in key.backing{
							evk = key.get(key, i)
						}
						sum = bits_and(sum + evk, 0xFFFFFFFF)
						let p_5 = mut 0
						let q_6 = mut 0
						match i in prv.backing{
							p_5 = prv.get(prv, i)
						}
						match i in nxt.backing{
							q_6 = nxt.get(nxt, i)
						}
						if p_5 != none{
							match p_5 into nxt.backing{
								nxt.set(nxt, p_5, q_6)
							}
						}else{
							head = q_6
						}
						if q_6 != none{
							match q_6 into prv.backing{
								prv.set(prv, q_6, p_5)
							}
						}else{
							tail = p_5
						}
						let ek_7 = mut 0
						match i in key.backing{
							ek_7 = key.get(key, i)
						}
						idx.set(idx, mut ek_7, mut none)
					}else{
						i = size
						size += 1
					}
					match i into key.backing{
						key.set(key, i, k)
					}
					match i into val.backing{
						val.set(val, i, y)
					}
					idx.set(idx, mut k, mut i)
					match i into prv.backing{
						prv.set(prv, i, none)
					}
					match i into nxt.backing{
						nxt.set(nxt, i, head)
					}
					if head != none{
						match head into prv.backing{
							prv.set(prv, head, i)
						}
					}else{
						tail = i
					}
					head = i
				}
			}
		}
		let fin = mut 0
		let c = mut head
		loop{
			if c == none{
				break
			}
			let kc = mut 0
			match c in key.backing{
				kc = key.get(key, c)
			}
			fin = bits_and(fin * 31 + kc, 0xFFFFFFFF)
			let nc = mut 0
			match c in nxt.backing{
				nc = nxt.get(nxt, c)
			}
			c = nc
		}
		let total = mut (bits_and(sum + fin, 0xFFFFFFFF))
		printf("%llu %llu %llu\n", hits, misses, total)
	}
}
