// LRU cache benchmark (LRU_N operations): fixed capacity 262144, key space 1048576, 75% of operations on a hot half-capacity subset.
// Recency list = index-based doubly linked list in dynarrays (the index-based version; lru_ref_* uses real `ref` node links).
// get: hit -> hits+1, move to front, checksum += value + key; miss -> misses+1. put: update + move to front, or insert at the front
// evicting the least recently used entry when full (checksum += evicted key). Elements are u64 (the C reference uses u32).
// Prints: hits misses checksum. Generated by a script from one template; all three variants are the same algorithm.
// SAFE variant: safe dynarrays, every element access under a bounds proof (match i in/into array); own chained hash map.
import "../../../stdlib/libc.caspien"
import "../../../stdlib/gt/*"

extern getenv(static imut string) static imut string
extern atol(static imut string) mut u64

func main() void{
	?catch(e){ return }
	unsafe assume extern loop{
		let n = mut 0
		n = atol(getenv("LRU_N"))
		let:<mut u64> zero = mut 0
		let none = mut 0xFFFFFFFF
		let key = mut ? dyn:<u64>([])
		let val = mut ? dyn:<u64>([])
		let prv = mut ? dyn:<u64>([])
		let nxt = mut ? dyn:<u64>([])
		let hn = mut ? dyn:<u64>([])
		let bucket = mut ? dyn:<u64>([])
		key = ? resize(key, 262144, zero)
		val = ? resize(val, 262144, zero)
		prv = ? resize(prv, 262144, zero)
		nxt = ? resize(nxt, 262144, zero)
		hn = ? resize(hn, 262144, zero)
		bucket = ? resize(bucket, 524288, zero)
		for bi in 0..524288{
			match bi into bucket{
				bucket[bi] = none
			}
		}
		let head = mut 0xFFFFFFFF
		let tail = mut 0xFFFFFFFF
		let size = mut 0
		let hits = mut 0
		let misses = mut 0
		let sum = mut 0
		let x = mut 12345
		for op in 0..n{
			x = bits_and(x * 1664525 + 1013904223, 0xFFFFFFFF)
			let a = mut x
			x = bits_and(x * 1664525 + 1013904223, 0xFFFFFFFF)
			let y = mut x
			let range = mut 131072
			if (y / 1048576) % 4 == 0{
				range = 1048576
			}
			assume match range != 0
			let k = mut ((a / 256) % range)
			let i = mut none
			let h = mut ((bits_and(k * 2654435761, 0xFFFFFFFF)) / 8192)
			match h in bucket{
				i = bucket[h]
			}
			let ck = mut 0
			loop{
				if i == none{
					break
				}
				match i in key{
					ck = key[i]
				}
				if ck == k{
					break
				}
				let nx = mut 0
				match i in hn{
					nx = hn[i]
				}
				i = nx
			}
			if (y / 16777216) % 4 != 0{
				if i != none{
					hits += 1
					let v = mut 0
					match i in val{
						v = val[i]
					}
					sum = bits_and(sum + v + k, 0xFFFFFFFF)
					let p_1 = mut 0
					let q_2 = mut 0
					match i in prv{
						p_1 = prv[i]
					}
					match i in nxt{
						q_2 = nxt[i]
					}
					if p_1 != none{
						match p_1 into nxt{
							nxt[p_1] = q_2
						}
					}else{
						head = q_2
					}
					if q_2 != none{
						match q_2 into prv{
							prv[q_2] = p_1
						}
					}else{
						tail = p_1
					}
					match i into prv{
						prv[i] = none
					}
					match i into nxt{
						nxt[i] = head
					}
					if head != none{
						match head into prv{
							prv[head] = i
						}
					}else{
						tail = i
					}
					head = i
				}else{
					misses += 1
				}
			}else{
				if i != none{
					match i into val{
						val[i] = y
					}
					let p_3 = mut 0
					let q_4 = mut 0
					match i in prv{
						p_3 = prv[i]
					}
					match i in nxt{
						q_4 = nxt[i]
					}
					if p_3 != none{
						match p_3 into nxt{
							nxt[p_3] = q_4
						}
					}else{
						head = q_4
					}
					if q_4 != none{
						match q_4 into prv{
							prv[q_4] = p_3
						}
					}else{
						tail = p_3
					}
					match i into prv{
						prv[i] = none
					}
					match i into nxt{
						nxt[i] = head
					}
					if head != none{
						match head into prv{
							prv[head] = i
						}
					}else{
						tail = i
					}
					head = i
				}else{
					if size == 262144{
						i = tail
						let evk = mut 0
						match i in key{
							evk = key[i]
						}
						sum = bits_and(sum + evk, 0xFFFFFFFF)
						let p_5 = mut 0
						let q_6 = mut 0
						match i in prv{
							p_5 = prv[i]
						}
						match i in nxt{
							q_6 = nxt[i]
						}
						if p_5 != none{
							match p_5 into nxt{
								nxt[p_5] = q_6
							}
						}else{
							head = q_6
						}
						if q_6 != none{
							match q_6 into prv{
								prv[q_6] = p_5
							}
						}else{
							tail = p_5
						}
						let ek_7 = mut 0
						match i in key{
							ek_7 = key[i]
						}
						let hb_8 = mut ((bits_and(ek_7 * 2654435761, 0xFFFFFFFF)) / 8192)
						let bh_9 = mut 0
						let hi_10 = mut 0
						match hb_8 in bucket{
							bh_9 = bucket[hb_8]
						}
						match i in hn{
							hi_10 = hn[i]
						}
						if bh_9 == i{
							match hb_8 into bucket{
								bucket[hb_8] = hi_10
							}
						}else{
							let j_11 = mut bh_9
							let nj_12 = mut 0
							match j_11 in hn{
								nj_12 = hn[j_11]
							}
							loop{
								if nj_12 == i{
									break
								}
								j_11 = nj_12
								match j_11 in hn{
									nj_12 = hn[j_11]
								}
							}
							match j_11 into hn{
								hn[j_11] = hi_10
							}
						}
					}else{
						i = size
						size += 1
					}
					match i into key{
						key[i] = k
					}
					match i into val{
						val[i] = y
					}
					let hb_13 = mut ((bits_and(k * 2654435761, 0xFFFFFFFF)) / 8192)
					let bh_14 = mut 0
					match hb_13 in bucket{
						bh_14 = bucket[hb_13]
					}
					match i into hn{
						hn[i] = bh_14
					}
					match hb_13 into bucket{
						bucket[hb_13] = i
					}
					match i into prv{
						prv[i] = none
					}
					match i into nxt{
						nxt[i] = head
					}
					if head != none{
						match head into prv{
							prv[head] = i
						}
					}else{
						tail = i
					}
					head = i
				}
			}
		}
		let fin = mut 0
		let c = mut head
		loop{
			if c == none{
				break
			}
			let kc = mut 0
			match c in key{
				kc = key[c]
			}
			fin = bits_and(fin * 31 + kc, 0xFFFFFFFF)
			let nc = mut 0
			match c in nxt{
				nc = nxt[c]
			}
			c = nc
		}
		let total = mut (bits_and(sum + fin, 0xFFFFFFFF))
		printf("%llu %llu %llu\n", hits, misses, total)
	}
}
