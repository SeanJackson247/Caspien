// LRU cache benchmark (LRU_N operations): fixed capacity 262144, key space 1048576, 75% of operations on a hot half-capacity subset.
// REF variant: the recency list is a doubly linked list of heap nodes, `Entry{key, val, prv, nxt, hn}`, whose prv/nxt/hn are plain `ref` members of
// the same struct (self-referential; allowed for `ref` only), the hash map is chained buckets of ref heads threaded through `hn`, and the entries
// are owned by a dynarray of Holder{n: owns} slots. Every node access is under a `match Some` alive proof. UNSAFE variant: the bucket heads are an unsafe dynarray of refs without bounds checks; the owner slots stay a safe dynarray (an unsafe one would destruct uninitialised owns slots).
// get: hit -> hits+1, move to front, checksum += value + key; miss -> misses+1. put: update + move to front, or insert at the front
// evicting the least recently used entry when full (the evicted node is reused for the new key; checksum += evicted key). Elements are u64.
// Prints: hits misses checksum (identical to the index-based variants). Generated by gen_ref.py.
import "../../../stdlib/libc.caspien"
import "../../../stdlib/gt_init.caspien"
import "../../../stdlib/gt_register.caspien"
import "../../../stdlib/gt_alive_check.caspien"
import "../../../stdlib/gt_destruct.caspien"
import "../../../stdlib/gt_moved.caspien"

extern getenv(static imut string) static imut string
extern atol(static imut string) mut u64

struct Entry{@pub{
	key: mut u64
	val: mut u64
	prv: ref mut Entry
	nxt: ref mut Entry
	hn: ref mut Entry
}}
struct Holder{@pub{ n: owns mut Entry }}
struct QRef{@pub{ n: ref mut Entry }}

func main() void{
	?catch(e){ return }
	unsafe assume extern loop udyn{
		let n = mut 0
		n = atol(getenv("LRU_N"))
		let nil = mut QRef{n= null}
		let pool = mut ? dyn([Holder{n= null}])
		pool = ? resize(pool, 262144, Holder{n= null})
		let bucket = mut unsafe dyn:<QRef>([])
		bucket = resize(bucket, 524288)
		for bi in 0..524288{
			bucket[bi].n = nil.n
		}
		let head = mut nil.n
		let tail = mut nil.n
		let size = mut 0
		let hits = mut 0
		let misses = mut 0
		let sum = mut 0
		let x = mut 12345
		for op in 0..n{
			x = bits_and(x * 1664525 + 1013904223, 0xFFFFFFFF)
			let a = mut x
			x = bits_and(x * 1664525 + 1013904223, 0xFFFFFFFF)
			let y = mut x
			let range = mut 131072
			if (y / 1048576) % 4 == 0{
				range = 1048576
			}
			assume match range != 0
			let k = mut ((a / 256) % range)
			let h = mut ((bits_and(k * 2654435761, 0xFFFFFFFF)) / 8192)
			let i = mut nil.n
			i = bucket[h].n
			let found = mut 0
			loop{
				match Some(i){
					let ik = mut i.key
					let inx = mut i.hn
					if ik == k{
						found = 1
						break
					}
					i = inx
				}
				else{
					break
				}
			}
			if (y / 16777216) % 4 != 0{
				if found == 1{
					hits += 1
					assume match Some(i)
					let v = mut i.val
					sum = bits_and(sum + v + k, 0xFFFFFFFF)
					let p_1 = mut i.prv
					let q_2 = mut i.nxt
					match Some(p_1){
						p_1.nxt = q_2
					}
					else{
						head = q_2
					}
					match Some(q_2){
						q_2.prv = p_1
					}
					else{
						tail = p_1
					}
					i.prv = nil.n
					i.nxt = head
					match Some(head){
						head.prv = i
					}
					else{
						tail = i
					}
					head = i
				}else{
					misses += 1
				}
			}else{
				if found == 1{
					assume match Some(i)
					i.val = y
					let p_3 = mut i.prv
					let q_4 = mut i.nxt
					match Some(p_3){
						p_3.nxt = q_4
					}
					else{
						head = q_4
					}
					match Some(q_4){
						q_4.prv = p_3
					}
					else{
						tail = p_3
					}
					i.prv = nil.n
					i.nxt = head
					match Some(head){
						head.prv = i
					}
					else{
						tail = i
					}
					head = i
				}else{
					let ent = mut nil.n
					if size == 262144{
						ent = tail
						assume match Some(ent)
						let evk = mut ent.key
						sum = bits_and(sum + evk, 0xFFFFFFFF)
						let p_5 = mut ent.prv
						let q_6 = mut ent.nxt
						match Some(p_5){
							p_5.nxt = q_6
						}
						else{
							head = q_6
						}
						match Some(q_6){
							q_6.prv = p_5
						}
						else{
							tail = p_5
						}
						let hb = mut ((bits_and(evk * 2654435761, 0xFFFFFFFF)) / 8192)
						let bh = mut nil.n
						bh = bucket[hb].n
						let enx = mut ent.hn
						assume match Some(bh)
						let bhk = mut bh.key
						if bhk == evk{
							bucket[hb].n = enx
						}else{
							let j = mut bh
							loop{
								match Some(j){
									let nj = mut j.hn
									match Some(nj){
										let njk = mut nj.key
										if njk == evk{
											j.hn = enx
											break
										}
									}
									else{
										break
									}
									j = nj
								}
								else{
									break
								}
							}
						}
					}else{
						let ne = mut ? new Entry{key= 0, val= 0, prv= null, nxt= null, hn= null}
						assume match size into pool
						pool[size].n = ne
						assume match size in pool
						ent = ref pool[size].n
						size += 1
					}
					assume match Some(ent)
					ent.key = k
					ent.val = y
					let hb2 = mut ((bits_and(k * 2654435761, 0xFFFFFFFF)) / 8192)
					let old = mut nil.n
					old = bucket[hb2].n
					ent.hn = old
					bucket[hb2].n = ent
					ent.prv = nil.n
					ent.nxt = head
					match Some(head){
						head.prv = ent
					}
					else{
						tail = ent
					}
					head = ent
				}
			}
		}
		let fin = mut 0
		let c = mut head
		loop{
			match Some(c){
				let kc = mut c.key
				fin = bits_and(fin * 31 + kc, 0xFFFFFFFF)
				let nc = mut c.nxt
				c = nc
			}
			else{
				break
			}
		}
		let total = mut (bits_and(sum + fin, 0xFFFFFFFF))
		printf("%llu %llu %llu\n", hits, misses, total)
	}
}
