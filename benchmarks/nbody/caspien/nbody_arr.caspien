// n-body (Computer Language Benchmarks Game), ported from the reference C
// program (nbody-gcc-1, contributed by Christoph Bauer) to Caspien -- array version.
//
// DIFFERENCES FROM THE C PROGRAM (each one forced by the current language):
//  * f32, not double: Caspien has no f64 type (only f32), so every value
//    and every operation here is single precision. sqrtf replaces sqrt.
//  * struct-of-arrays: seven `let static` f32[5] arrays (x, y, z, vx, vy, vz,
//    mass) with their initial values in the static initialisers. A fixed array
//    accepts only a literal index (a variable index needs a bounds proof that
//    fixed arrays cannot give), so the pair loop and per-body loops are written
//    out (generated by gen2.py) rather than looped.
//  * N comes from the environment variable NBODY_N (no argv access from a
//    plain `main`).
extern printf(static imut string,...) void
extern sqrtf(mut f32) mut f32
extern getenv(static imut string) static imut string
extern atol(static imut string) mut u64

let static x = mut [0.0, 4.841431442464721, 8.34336671824458, 12.894369562139131, 15.379697114850917]
let static y = mut [0.0, -1.1603200440274284, 4.124798564124305, -15.111151401698631, -25.919314609987964]
let static z = mut [0.0, -0.10362204447112311, -0.4035234171143214, -0.22330757889265573, 0.17925877295037118]
let static vx = mut [0.0, 0.606326392995832, -1.0107743461787924, 1.0827910064415354, 0.979090732243898]
let static vy = mut [0.0, 2.81198684491626, 1.8256623712304119, 0.8687130181696082, 0.5946989986476762]
let static vz = mut [0.0, -0.02521836165988763, 0.008415761376584154, -0.010832637401363636, -0.034755955504078104]
let static mass = mut [39.47841760435743, 0.03769367487038949, 0.011286326131968767, 0.0017237240570597112, 0.0020336868699246304]

func advance(dt: mut f32) void{
	unsafe{
		let dx01 = mut (x[0] - x[1])
		let dy01 = mut (y[0] - y[1])
		let dz01 = mut (z[0] - z[1])
		let dist01 = mut sqrtf(dx01 * dx01 + dy01 * dy01 + dz01 * dz01)
		let mag01 = mut (dt / (dist01 * dist01 * dist01))
		vx[0] -= dx01 * mass[1] * mag01
		vy[0] -= dy01 * mass[1] * mag01
		vz[0] -= dz01 * mass[1] * mag01
		vx[1] += dx01 * mass[0] * mag01
		vy[1] += dy01 * mass[0] * mag01
		vz[1] += dz01 * mass[0] * mag01
		let dx02 = mut (x[0] - x[2])
		let dy02 = mut (y[0] - y[2])
		let dz02 = mut (z[0] - z[2])
		let dist02 = mut sqrtf(dx02 * dx02 + dy02 * dy02 + dz02 * dz02)
		let mag02 = mut (dt / (dist02 * dist02 * dist02))
		vx[0] -= dx02 * mass[2] * mag02
		vy[0] -= dy02 * mass[2] * mag02
		vz[0] -= dz02 * mass[2] * mag02
		vx[2] += dx02 * mass[0] * mag02
		vy[2] += dy02 * mass[0] * mag02
		vz[2] += dz02 * mass[0] * mag02
		let dx03 = mut (x[0] - x[3])
		let dy03 = mut (y[0] - y[3])
		let dz03 = mut (z[0] - z[3])
		let dist03 = mut sqrtf(dx03 * dx03 + dy03 * dy03 + dz03 * dz03)
		let mag03 = mut (dt / (dist03 * dist03 * dist03))
		vx[0] -= dx03 * mass[3] * mag03
		vy[0] -= dy03 * mass[3] * mag03
		vz[0] -= dz03 * mass[3] * mag03
		vx[3] += dx03 * mass[0] * mag03
		vy[3] += dy03 * mass[0] * mag03
		vz[3] += dz03 * mass[0] * mag03
		let dx04 = mut (x[0] - x[4])
		let dy04 = mut (y[0] - y[4])
		let dz04 = mut (z[0] - z[4])
		let dist04 = mut sqrtf(dx04 * dx04 + dy04 * dy04 + dz04 * dz04)
		let mag04 = mut (dt / (dist04 * dist04 * dist04))
		vx[0] -= dx04 * mass[4] * mag04
		vy[0] -= dy04 * mass[4] * mag04
		vz[0] -= dz04 * mass[4] * mag04
		vx[4] += dx04 * mass[0] * mag04
		vy[4] += dy04 * mass[0] * mag04
		vz[4] += dz04 * mass[0] * mag04
		let dx12 = mut (x[1] - x[2])
		let dy12 = mut (y[1] - y[2])
		let dz12 = mut (z[1] - z[2])
		let dist12 = mut sqrtf(dx12 * dx12 + dy12 * dy12 + dz12 * dz12)
		let mag12 = mut (dt / (dist12 * dist12 * dist12))
		vx[1] -= dx12 * mass[2] * mag12
		vy[1] -= dy12 * mass[2] * mag12
		vz[1] -= dz12 * mass[2] * mag12
		vx[2] += dx12 * mass[1] * mag12
		vy[2] += dy12 * mass[1] * mag12
		vz[2] += dz12 * mass[1] * mag12
		let dx13 = mut (x[1] - x[3])
		let dy13 = mut (y[1] - y[3])
		let dz13 = mut (z[1] - z[3])
		let dist13 = mut sqrtf(dx13 * dx13 + dy13 * dy13 + dz13 * dz13)
		let mag13 = mut (dt / (dist13 * dist13 * dist13))
		vx[1] -= dx13 * mass[3] * mag13
		vy[1] -= dy13 * mass[3] * mag13
		vz[1] -= dz13 * mass[3] * mag13
		vx[3] += dx13 * mass[1] * mag13
		vy[3] += dy13 * mass[1] * mag13
		vz[3] += dz13 * mass[1] * mag13
		let dx14 = mut (x[1] - x[4])
		let dy14 = mut (y[1] - y[4])
		let dz14 = mut (z[1] - z[4])
		let dist14 = mut sqrtf(dx14 * dx14 + dy14 * dy14 + dz14 * dz14)
		let mag14 = mut (dt / (dist14 * dist14 * dist14))
		vx[1] -= dx14 * mass[4] * mag14
		vy[1] -= dy14 * mass[4] * mag14
		vz[1] -= dz14 * mass[4] * mag14
		vx[4] += dx14 * mass[1] * mag14
		vy[4] += dy14 * mass[1] * mag14
		vz[4] += dz14 * mass[1] * mag14
		let dx23 = mut (x[2] - x[3])
		let dy23 = mut (y[2] - y[3])
		let dz23 = mut (z[2] - z[3])
		let dist23 = mut sqrtf(dx23 * dx23 + dy23 * dy23 + dz23 * dz23)
		let mag23 = mut (dt / (dist23 * dist23 * dist23))
		vx[2] -= dx23 * mass[3] * mag23
		vy[2] -= dy23 * mass[3] * mag23
		vz[2] -= dz23 * mass[3] * mag23
		vx[3] += dx23 * mass[2] * mag23
		vy[3] += dy23 * mass[2] * mag23
		vz[3] += dz23 * mass[2] * mag23
		let dx24 = mut (x[2] - x[4])
		let dy24 = mut (y[2] - y[4])
		let dz24 = mut (z[2] - z[4])
		let dist24 = mut sqrtf(dx24 * dx24 + dy24 * dy24 + dz24 * dz24)
		let mag24 = mut (dt / (dist24 * dist24 * dist24))
		vx[2] -= dx24 * mass[4] * mag24
		vy[2] -= dy24 * mass[4] * mag24
		vz[2] -= dz24 * mass[4] * mag24
		vx[4] += dx24 * mass[2] * mag24
		vy[4] += dy24 * mass[2] * mag24
		vz[4] += dz24 * mass[2] * mag24
		let dx34 = mut (x[3] - x[4])
		let dy34 = mut (y[3] - y[4])
		let dz34 = mut (z[3] - z[4])
		let dist34 = mut sqrtf(dx34 * dx34 + dy34 * dy34 + dz34 * dz34)
		let mag34 = mut (dt / (dist34 * dist34 * dist34))
		vx[3] -= dx34 * mass[4] * mag34
		vy[3] -= dy34 * mass[4] * mag34
		vz[3] -= dz34 * mass[4] * mag34
		vx[4] += dx34 * mass[3] * mag34
		vy[4] += dy34 * mass[3] * mag34
		vz[4] += dz34 * mass[3] * mag34
		x[0] += dt * vx[0]
		y[0] += dt * vy[0]
		z[0] += dt * vz[0]
		x[1] += dt * vx[1]
		y[1] += dt * vy[1]
		z[1] += dt * vz[1]
		x[2] += dt * vx[2]
		y[2] += dt * vy[2]
		z[2] += dt * vz[2]
		x[3] += dt * vx[3]
		y[3] += dt * vy[3]
		z[3] += dt * vz[3]
		x[4] += dt * vx[4]
		y[4] += dt * vy[4]
		z[4] += dt * vz[4]
	}
	return
}

func energy() mut f32{
	let e = mut 0.0
	unsafe{
		e += 0.5 * mass[0] * (vx[0] * vx[0] + vy[0] * vy[0] + vz[0] * vz[0])
		e += 0.5 * mass[1] * (vx[1] * vx[1] + vy[1] * vy[1] + vz[1] * vz[1])
		e += 0.5 * mass[2] * (vx[2] * vx[2] + vy[2] * vy[2] + vz[2] * vz[2])
		e += 0.5 * mass[3] * (vx[3] * vx[3] + vy[3] * vy[3] + vz[3] * vz[3])
		e += 0.5 * mass[4] * (vx[4] * vx[4] + vy[4] * vy[4] + vz[4] * vz[4])
		let dx01 = mut (x[0] - x[1])
		let dy01 = mut (y[0] - y[1])
		let dz01 = mut (z[0] - z[1])
		let dist01 = mut sqrtf(dx01 * dx01 + dy01 * dy01 + dz01 * dz01)
		e -= (mass[0] * mass[1]) / dist01
		let dx02 = mut (x[0] - x[2])
		let dy02 = mut (y[0] - y[2])
		let dz02 = mut (z[0] - z[2])
		let dist02 = mut sqrtf(dx02 * dx02 + dy02 * dy02 + dz02 * dz02)
		e -= (mass[0] * mass[2]) / dist02
		let dx03 = mut (x[0] - x[3])
		let dy03 = mut (y[0] - y[3])
		let dz03 = mut (z[0] - z[3])
		let dist03 = mut sqrtf(dx03 * dx03 + dy03 * dy03 + dz03 * dz03)
		e -= (mass[0] * mass[3]) / dist03
		let dx04 = mut (x[0] - x[4])
		let dy04 = mut (y[0] - y[4])
		let dz04 = mut (z[0] - z[4])
		let dist04 = mut sqrtf(dx04 * dx04 + dy04 * dy04 + dz04 * dz04)
		e -= (mass[0] * mass[4]) / dist04
		let dx12 = mut (x[1] - x[2])
		let dy12 = mut (y[1] - y[2])
		let dz12 = mut (z[1] - z[2])
		let dist12 = mut sqrtf(dx12 * dx12 + dy12 * dy12 + dz12 * dz12)
		e -= (mass[1] * mass[2]) / dist12
		let dx13 = mut (x[1] - x[3])
		let dy13 = mut (y[1] - y[3])
		let dz13 = mut (z[1] - z[3])
		let dist13 = mut sqrtf(dx13 * dx13 + dy13 * dy13 + dz13 * dz13)
		e -= (mass[1] * mass[3]) / dist13
		let dx14 = mut (x[1] - x[4])
		let dy14 = mut (y[1] - y[4])
		let dz14 = mut (z[1] - z[4])
		let dist14 = mut sqrtf(dx14 * dx14 + dy14 * dy14 + dz14 * dz14)
		e -= (mass[1] * mass[4]) / dist14
		let dx23 = mut (x[2] - x[3])
		let dy23 = mut (y[2] - y[3])
		let dz23 = mut (z[2] - z[3])
		let dist23 = mut sqrtf(dx23 * dx23 + dy23 * dy23 + dz23 * dz23)
		e -= (mass[2] * mass[3]) / dist23
		let dx24 = mut (x[2] - x[4])
		let dy24 = mut (y[2] - y[4])
		let dz24 = mut (z[2] - z[4])
		let dist24 = mut sqrtf(dx24 * dx24 + dy24 * dy24 + dz24 * dz24)
		e -= (mass[2] * mass[4]) / dist24
		let dx34 = mut (x[3] - x[4])
		let dy34 = mut (y[3] - y[4])
		let dz34 = mut (z[3] - z[4])
		let dist34 = mut sqrtf(dx34 * dx34 + dy34 * dy34 + dz34 * dz34)
		e -= (mass[3] * mass[4]) / dist34
	}
	return e
}

func offsetMomentum() void{
	unsafe{
		let px = mut 0.0
		let py = mut 0.0
		let pz = mut 0.0
		px += vx[0] * mass[0]
		py += vy[0] * mass[0]
		pz += vz[0] * mass[0]
		px += vx[1] * mass[1]
		py += vy[1] * mass[1]
		pz += vz[1] * mass[1]
		px += vx[2] * mass[2]
		py += vy[2] * mass[2]
		pz += vz[2] * mass[2]
		px += vx[3] * mass[3]
		py += vy[3] * mass[3]
		pz += vz[3] * mass[3]
		px += vx[4] * mass[4]
		py += vy[4] * mass[4]
		pz += vz[4] * mass[4]
		vx[0] = mut 0.0 - px / 39.47841760435743
		vy[0] = mut 0.0 - py / 39.47841760435743
		vz[0] = mut 0.0 - pz / 39.47841760435743
	}
	return
}

func main() void{
	let n = mut 0
	unsafe{
		n = atol(getenv("NBODY_N"))
	}
	offsetMomentum()
	let e0 = mut energy()
	unsafe{
		printf("%.9f\n", e0)
	}
	for s in 0..n{
		advance(0.01)
	}
	let e1 = mut energy()
	unsafe{
		printf("%.9f\n", e1)
	}
	return
}
