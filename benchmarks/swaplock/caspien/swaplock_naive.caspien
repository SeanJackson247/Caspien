// swaplock: 32 OS threads all update one shared struct (count, sum) under one swap lock, K times each (K comes from SWAPLOCK_K).
// Each update: count += 1; sum += id + (i % 7). The result does not depend on the order of the updates.
// The lock is a `swap` field (an atomic exchange): `match @lock shared` runs OPEN when it took the lock and CLOSED when someone holds it.
// naive: a CLOSED lock is retried at once (pure spinning)
import "../../../stdlib/libc.caspien"
import "../../../stdlib/gt_init.caspien"
import "../../../stdlib/gt_register.caspien"
import "../../../stdlib/gt_alive_check.caspien"
import "../../../stdlib/gt_destruct.caspien"
import "../../../stdlib/gt_moved.caspien"
import "../../../stdlib/par_call.caspien"
import "../../../stdlib/await_call.caspien"
extern getenv(static imut string) static imut string
extern atol(static imut string) mut u64

enum Gate{ OPEN, CLOSED }

@lock(match self.gate : OPEN)
struct Shared{@pub{
	swap gate: atomic mut Gate
	count: mut u64
	sum: mut u64
}}

let static shared = mut Shared{gate= Gate.OPEN, count= mut 0, sum= mut 0}
let static k = mut atomic 0

@async
func worker(id: mut u64) void{
	let rounds = mut k
	for i in 0..rounds{
		match @lock shared{
			OPEN:{
				shared.count += 1
				shared.sum += id + (i % 7)
			}
			CLOSED:{ continue }
		}
	}
}

func main() void{
	?catch(e){
		unsafe extern{ printf("FAIL %s\n", e) }
		return
	}
	let rounds = mut 0
	unsafe extern{ rounds = atol(getenv("SWAPLOCK_K")) }
	k = rounds
	? par worker(mut 0)
	? par worker(mut 1)
	? par worker(mut 2)
	? par worker(mut 3)
	? par worker(mut 4)
	? par worker(mut 5)
	? par worker(mut 6)
	? par worker(mut 7)
	? par worker(mut 8)
	? par worker(mut 9)
	? par worker(mut 10)
	? par worker(mut 11)
	? par worker(mut 12)
	? par worker(mut 13)
	? par worker(mut 14)
	? par worker(mut 15)
	? par worker(mut 16)
	? par worker(mut 17)
	? par worker(mut 18)
	? par worker(mut 19)
	? par worker(mut 20)
	? par worker(mut 21)
	? par worker(mut 22)
	? par worker(mut 23)
	? par worker(mut 24)
	? par worker(mut 25)
	? par worker(mut 26)
	? par worker(mut 27)
	? par worker(mut 28)
	? par worker(mut 29)
	? par worker(mut 30)
	? par worker(mut 31)
	let want = mut (32 * rounds)
	for w in 0..100000000000{
		let c = mut 0
		let s = mut 0
		match @lock shared{
			OPEN:{
				c = shared.count
				s = shared.sum
			}
			CLOSED:{ continue }
		}
		if c == want{
			unsafe extern{ printf("count=%llu sum=%llu\n", c, s) }
			break
		}
		yield
	}
}
