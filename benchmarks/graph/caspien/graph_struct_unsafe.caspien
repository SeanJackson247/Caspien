// Heap graph benchmark (GRAPH_N nodes), STRUCT + UNSAFE variant: ONE unsafe dynarray of Node structs (es[i].field), no bounds proofs.
// Same graph, RNG and search as graph_unsafe (which uses parallel arrays). Prints: reachable maxdepth needledist valuesum.
import "../../../stdlib/libc.caspien"
import "../../../stdlib/gt_init.caspien"
import "../../../stdlib/gt_register.caspien"
import "../../../stdlib/gt_alive_check.caspien"
import "../../../stdlib/gt_destruct.caspien"
import "../../../stdlib/gt_moved.caspien"

extern getenv(static imut string) static imut string
extern atol(static imut string) mut u64

// One node = value, BFS distance and four outgoing edges (indices of other nodes: a recursive struct is rejected, so no node pointers).
struct Node{
	@pub{ value: mut u64 }
	@pub{ dist: mut u64 }
	@pub{ e0: mut u64 }
	@pub{ e1: mut u64 }
	@pub{ e2: mut u64 }
	@pub{ e3: mut u64 }
}

func main() void{
	unsafe{
		let n = mut 0
		n = atol(getenv("GRAPH_N"))
		let nodes = mut unsafe dyn:<Node>([])
		let queue = mut unsafe dyn:<u64>([])
		nodes = resize(nodes, n)
		queue = resize(queue, n)
		let x = mut 12345
		for i in 0..n{
			x = bits_and(x * 1664525 + 1013904223, 0xFFFFFFFF)
			nodes[i].value = x % 16777216
			nodes[i].dist = 0
		}
		let needle = mut (n * 7 / 10)
		nodes[needle].value = 0xFFFFFFFF
		for i in 0..n{
			nodes[i].e0 = (i + 1) % n
			x = bits_and(x * 1664525 + 1013904223, 0xFFFFFFFF)
			nodes[i].e1 = x % n
			x = bits_and(x * 1664525 + 1013904223, 0xFFFFFFFF)
			nodes[i].e2 = x % n
			x = bits_and(x * 1664525 + 1013904223, 0xFFFFFFFF)
			nodes[i].e3 = x % n
		}
		let head = mut 0
		let tail = mut 0
		queue[tail] = 0
		tail += 1
		nodes[0].dist = 1
		let maxdist = mut 1
		let needledist = mut 0
		let sum = mut 0
		loop{
			if head >= tail{
				break
			}
			let u = mut queue[head]
			head += 1
			let du = mut nodes[u].dist
			let vu = mut nodes[u].value
			sum += vu
			if vu == 0xFFFFFFFF{
				needledist = du
			}
			if du > maxdist{
				maxdist = du
			}
			let ve0 = mut nodes[u].e0
			if nodes[ve0].dist == 0{
				nodes[ve0].dist = du + 1
				queue[tail] = ve0
				tail += 1
			}
			let ve1 = mut nodes[u].e1
			if nodes[ve1].dist == 0{
				nodes[ve1].dist = du + 1
				queue[tail] = ve1
				tail += 1
			}
			let ve2 = mut nodes[u].e2
			if nodes[ve2].dist == 0{
				nodes[ve2].dist = du + 1
				queue[tail] = ve2
				tail += 1
			}
			let ve3 = mut nodes[u].e3
			if nodes[ve3].dist == 0{
				nodes[ve3].dist = du + 1
				queue[tail] = ve3
				tail += 1
			}
		}
		let total = mut (bits_and(sum, 0xFFFFFFFF))
		let md = mut (maxdist - 1)
		let nd = mut (needledist - 1)
		printf("%llu %llu %llu %llu\n", tail, md, nd, total)
	}
}
