func bswap(v: mut u32) mut u32{
	return bits_or(bits_or(bits_right(v, 24), bits_and(bits_right(v, 8), 0xff00)), bits_or(bits_and(bits_left(v, 8), 0xff0000), bits_left(v, 24)))
}

// S = SHA256(le64(d) || le64(i)) for d = dhi * 2^32 + dlo, i = ihi * 2^32 + ilo: one block (16-byte message plus padding)
func leaf(dlo: mut u32, dhi: mut u32, ilo: mut u32, ihi: mut u32) void{
	unsafe global{
		W[0] = bswap(dlo) as u64
		W[1] = bswap(dhi) as u64
		W[2] = bswap(ilo) as u64
		W[3] = bswap(ihi) as u64
		W[4] = 0x80000000
		W[5] = 0
		W[6] = 0
		W[7] = 0
		W[8] = 0
		W[9] = 0
		W[10] = 0
		W[11] = 0
		W[12] = 0
		W[13] = 0
		W[14] = 0
		W[15] = 128
		S[0] = 0x6a09e667
		S[1] = 0xbb67ae85
		S[2] = 0x3c6ef372
		S[3] = 0xa54ff53a
		S[4] = 0x510e527f
		S[5] = 0x9b05688c
		S[6] = 0x1f83d9ab
		S[7] = 0x5be0cd19
		comp()
	}
}

// S = SHA256(L || R) where the 16 words of L || R are in W[0..15]: two blocks, the second one pure padding
func node() void{
	unsafe global{
		S[0] = 0x6a09e667
		S[1] = 0xbb67ae85
		S[2] = 0x3c6ef372
		S[3] = 0xa54ff53a
		S[4] = 0x510e527f
		S[5] = 0x9b05688c
		S[6] = 0x1f83d9ab
		S[7] = 0x5be0cd19
		comp()
		compPad()
	}
}

func main() void{
	unsafe assume extern global loop udyn{
		let n = mut 0
		n = atol(getenv("MERKLE_N"))
		let dat = mut unsafe dyn:<u32>([])
		let t = mut unsafe dyn:<u32>([])
		let sibs = mut unsafe dyn:<u32>([])
		let tn = mut ((2 * n + 64) * 8)
		dat = resize(dat, n)
		t = resize(t, tn)
		sibs = resize(sibs, 512)
		let ix = mut 0
		let ix2 = mut 0
		let:<mut u32> xl = mut 12345
		let:<mut u32> d0 = mut 0
		for i in 0..n{
			xl = xl * 1664525 + 1013904223
			d0 = xl
			let tb = mut (i * 8)
			dat[i] = d0
			let ihi = mut wrap:<u32>(bits_right(i, 32))
			leaf(d0, 0, wrap:<u32>(i), ihi)
			ix = tb + 0
			t[ix] = wrap:<u32>(S[0])
			ix = tb + 1
			t[ix] = wrap:<u32>(S[1])
			ix = tb + 2
			t[ix] = wrap:<u32>(S[2])
			ix = tb + 3
			t[ix] = wrap:<u32>(S[3])
			ix = tb + 4
			t[ix] = wrap:<u32>(S[4])
			ix = tb + 5
			t[ix] = wrap:<u32>(S[5])
			ix = tb + 6
			t[ix] = wrap:<u32>(S[6])
			ix = tb + 7
			t[ix] = wrap:<u32>(S[7])
		}
		let off = mut 0
		let size = mut n
		loop{
			if size <= 1{
				break
			}
			let noff = mut (off + size)
			let ns = mut ((size + 1) / 2)
			for j in 0..ns{
				let li = mut (off + 2 * j)
				let ri = mut li
				if 2 * j + 1 < size{
					ri = li + 1
				}
				let lb = mut (li * 8)
				let rb = mut (ri * 8)
				ix = lb + 0
				W[0] = t[ix] as u64
				ix = lb + 1
				W[1] = t[ix] as u64
				ix = lb + 2
				W[2] = t[ix] as u64
				ix = lb + 3
				W[3] = t[ix] as u64
				ix = lb + 4
				W[4] = t[ix] as u64
				ix = lb + 5
				W[5] = t[ix] as u64
				ix = lb + 6
				W[6] = t[ix] as u64
				ix = lb + 7
				W[7] = t[ix] as u64
				ix = rb + 0
				W[8] = t[ix] as u64
				ix = rb + 1
				W[9] = t[ix] as u64
				ix = rb + 2
				W[10] = t[ix] as u64
				ix = rb + 3
				W[11] = t[ix] as u64
				ix = rb + 4
				W[12] = t[ix] as u64
				ix = rb + 5
				W[13] = t[ix] as u64
				ix = rb + 6
				W[14] = t[ix] as u64
				ix = rb + 7
				W[15] = t[ix] as u64
				node()
				let oj = mut (noff + j)
				let tb = mut (oj * 8)
				ix = tb + 0
				t[ix] = wrap:<u32>(S[0])
				ix = tb + 1
				t[ix] = wrap:<u32>(S[1])
				ix = tb + 2
				t[ix] = wrap:<u32>(S[2])
				ix = tb + 3
				t[ix] = wrap:<u32>(S[3])
				ix = tb + 4
				t[ix] = wrap:<u32>(S[4])
				ix = tb + 5
				t[ix] = wrap:<u32>(S[5])
				ix = tb + 6
				t[ix] = wrap:<u32>(S[6])
				ix = tb + 7
				t[ix] = wrap:<u32>(S[7])
			}
			off = noff
			size = ns
		}
		let:<mut u64> r0 = mut 0
		let:<mut u64> r1 = mut 0
		let:<mut u64> r2 = mut 0
		let:<mut u64> r3 = mut 0
		let:<mut u64> r4 = mut 0
		let:<mut u64> r5 = mut 0
		let:<mut u64> r6 = mut 0
		let:<mut u64> r7 = mut 0
		let rb = mut (off * 8)
		ix = rb + 0
		r0 = t[ix] as u64
		ix = rb + 1
		r1 = t[ix] as u64
		ix = rb + 2
		r2 = t[ix] as u64
		ix = rb + 3
		r3 = t[ix] as u64
		ix = rb + 4
		r4 = t[ix] as u64
		ix = rb + 5
		r5 = t[ix] as u64
		ix = rb + 6
		r6 = t[ix] as u64
		ix = rb + 7
		r7 = t[ix] as u64
		let verified = mut 0
		let rejected = mut 0
		let half = mut (n / 2)
		let:<mut u64> c0 = mut 0
		let:<mut u64> c1 = mut 0
		let:<mut u64> c2 = mut 0
		let:<mut u64> c3 = mut 0
		let:<mut u64> c4 = mut 0
		let:<mut u64> c5 = mut 0
		let:<mut u64> c6 = mut 0
		let:<mut u64> c7 = mut 0
		let:<mut u32> sv = mut 0
		for p in 0..half{
			xl = xl * 1664525 + 1013904223
			let xw = mut xl as u64
			assume match n != 0
			let idx = mut (xw % n)
			let o = mut 0
			let s = mut n
			let pos = mut idx
			let depth = mut 0
			loop{
				if s <= 1{
					break
				}
				let sb = mut (pos + 1)
				if pos % 2 != 0{
					sb = pos - 1
				}
				if sb >= s{
					sb = pos
				}
				let sbase = mut ((o + sb) * 8)
				let dbase = mut (depth * 8)
				ix = sbase + 0
				sv = t[ix]
				ix2 = dbase + 0
				sibs[ix2] = sv
				ix = sbase + 1
				sv = t[ix]
				ix2 = dbase + 1
				sibs[ix2] = sv
				ix = sbase + 2
				sv = t[ix]
				ix2 = dbase + 2
				sibs[ix2] = sv
				ix = sbase + 3
				sv = t[ix]
				ix2 = dbase + 3
				sibs[ix2] = sv
				ix = sbase + 4
				sv = t[ix]
				ix2 = dbase + 4
				sibs[ix2] = sv
				ix = sbase + 5
				sv = t[ix]
				ix2 = dbase + 5
				sibs[ix2] = sv
				ix = sbase + 6
				sv = t[ix]
				ix2 = dbase + 6
				sibs[ix2] = sv
				ix = sbase + 7
				sv = t[ix]
				ix2 = dbase + 7
				sibs[ix2] = sv
				depth += 1
				o += s
				s = (s + 1) / 2
				pos = pos / 2
			}
			let:<mut u32> dlo = mut 0
			dlo = dat[idx]
			let:<mut u32> dhi = mut 0
			if p % 4 == 3{
				dlo = dlo + 1
				if dlo == 0{
					dhi = 1
				}
			}
			let ihi2 = mut wrap:<u32>(bits_right(idx, 32))
			leaf(dlo, dhi, wrap:<u32>(idx), ihi2)
			c0 = S[0]
			c1 = S[1]
			c2 = S[2]
			c3 = S[3]
			c4 = S[4]
			c5 = S[5]
			c6 = S[6]
			c7 = S[7]
			pos = idx
			for d in 0..depth{
				let sb2 = mut (d * 8)
				if pos % 2 == 0{
					W[0] = c0
					W[1] = c1
					W[2] = c2
					W[3] = c3
					W[4] = c4
					W[5] = c5
					W[6] = c6
					W[7] = c7
					ix = sb2 + 0
					W[8] = sibs[ix] as u64
					ix = sb2 + 1
					W[9] = sibs[ix] as u64
					ix = sb2 + 2
					W[10] = sibs[ix] as u64
					ix = sb2 + 3
					W[11] = sibs[ix] as u64
					ix = sb2 + 4
					W[12] = sibs[ix] as u64
					ix = sb2 + 5
					W[13] = sibs[ix] as u64
					ix = sb2 + 6
					W[14] = sibs[ix] as u64
					ix = sb2 + 7
					W[15] = sibs[ix] as u64
				}else{
					ix = sb2 + 0
					W[0] = sibs[ix] as u64
					ix = sb2 + 1
					W[1] = sibs[ix] as u64
					ix = sb2 + 2
					W[2] = sibs[ix] as u64
					ix = sb2 + 3
					W[3] = sibs[ix] as u64
					ix = sb2 + 4
					W[4] = sibs[ix] as u64
					ix = sb2 + 5
					W[5] = sibs[ix] as u64
					ix = sb2 + 6
					W[6] = sibs[ix] as u64
					ix = sb2 + 7
					W[7] = sibs[ix] as u64
					W[8] = c0
					W[9] = c1
					W[10] = c2
					W[11] = c3
					W[12] = c4
					W[13] = c5
					W[14] = c6
					W[15] = c7
				}
				node()
				c0 = S[0]
				c1 = S[1]
				c2 = S[2]
				c3 = S[3]
				c4 = S[4]
				c5 = S[5]
				c6 = S[6]
				c7 = S[7]
				pos = pos / 2
			}
			if c0 == r0 && c1 == r1 && c2 == r2 && c3 == r3 && c4 == r4 && c5 == r5 && c6 == r6 && c7 == r7{
				verified += 1
			}else{
				rejected += 1
			}
		}
		printf("%08x%08x%08x%08x", r0, r1, r2, r3)
		printf("%08x%08x%08x%08x %llu %llu\n", r4, r5, r6, r7, verified, rejected)
	}
}
