// threads: spawn many OS threads, each runs the same integer kernel on its own state, collect every result. No data is shared
// between the threads. Tasks run in waves of 64 `par` threads; N comes from THREADS_N and must be a multiple of 64.
// Generated by gen.py: a `par` handle has no type name, so it cannot be stored in an array and the 64 handles of a wave are
// 64 named locals, each polled through `match @lock` (`state`, then `resolve()` once READY).
// optimized: the kernel is inlined by hand and unrolled four times
import "../../../../stdlib/libc.caspien"
import "../../../../stdlib/gt/*"
import "../../../../stdlib/par_call.caspien"
import "../../../../stdlib/await_call.caspien"
extern getenv(static imut string) static imut string
extern atol(static imut string) mut u64

@async
func task(id: mut u64) mut u64{
	let s = mut ((id + 1) * 2654435761)
	let acc = mut 0
	for i in 0..250000{                  // the kernel is unrolled four times, everything stays in registers
		s = bits_xor(s, bits_left(s, 13))
		s = bits_xor(s, bits_right(s, 7))
		s = bits_xor(s, bits_left(s, 17))
		acc += bits_and(s, 255)
		s = bits_xor(s, bits_left(s, 13))
		s = bits_xor(s, bits_right(s, 7))
		s = bits_xor(s, bits_left(s, 17))
		acc += bits_and(s, 255)
		s = bits_xor(s, bits_left(s, 13))
		s = bits_xor(s, bits_right(s, 7))
		s = bits_xor(s, bits_left(s, 17))
		acc += bits_and(s, 255)
		s = bits_xor(s, bits_left(s, 13))
		s = bits_xor(s, bits_right(s, 7))
		s = bits_xor(s, bits_left(s, 17))
		acc += bits_and(s, 255)
	}
	return acc
}

func main() void{
