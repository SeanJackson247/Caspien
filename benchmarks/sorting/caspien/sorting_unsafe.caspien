// Sorting and searching benchmark (SORT_N values), UNSAFE variant: unsafe dynarrays of u64, no bounds proofs.
// Iterative quicksort (Hoare, middle pivot, explicit stack), bottom-up merge sort, heap sort, then n binary searches on the sorted array and
// 20 linear searches on the unsorted one. Arrays are 1-based (element 0 unused) so that Hoare's j = lo - 1 cannot underflow an unsigned index.
// Elements are u64 (the reference programs use 32-bit ints). Prints: hash binary-hits linear-hits OK|BAD. Generated by generate.py.
import "../../../stdlib/libc.caspien"
import "../../../stdlib/gt/*"
extern getenv(static imut string) static imut string
extern atol(static imut string) mut u64

func main() void{
	unsafe assume extern loop udyn{
		let n = mut 0
		n = atol(getenv("SORT_N"))
		let n1 = mut (n + 1)
		let sz = mut (n + 1)
		let orig = mut unsafe dyn:<u64>([])
		orig = resize(orig, sz)
		let a = mut unsafe dyn:<u64>([])
		a = resize(a, sz)
		let b = mut unsafe dyn:<u64>([])
		b = resize(b, sz)
		let d = mut unsafe dyn:<u64>([])
		d = resize(d, sz)
		let tmp = mut unsafe dyn:<u64>([])
		tmp = resize(tmp, sz)
		let stk = mut unsafe dyn:<u64>([])
		stk = resize(stk, 256)
		let x = mut 12345
		for i in 1..sz{
			x = bits_and(x * 1664525 + 1013904223, 0xFFFFFFFF)
			let val = mut (x / 2)
			orig[i] = val
			a[i] = val
			b[i] = val
			d[i] = val
		}
		let sp = mut 0
		let one = mut 1
		stk[sp] = one
		sp += 1
		stk[sp] = n
		sp += 1
		loop{
			if sp == 0{
				break
			}
			sp -= 1
			let hi = mut 0
			hi = stk[sp]
			sp -= 1
			let lo = mut 0
			lo = stk[sp]
			loop{
				if lo >= hi{
					break
				}
				let mm = mut ((lo + hi) / 2)
				let pivot = mut 0
				pivot = a[mm]
				let i = mut lo
				let j = mut hi
				loop{
					if i > j{
						break
					}
					loop{
						let v1 = mut 0
						v1 = a[i]
						if v1 >= pivot{
							break
						}
						i += 1
					}
					loop{
						let v2 = mut 0
						v2 = a[j]
						if v2 <= pivot{
							break
						}
						j -= 1
					}
					if i <= j{
						let v3 = mut 0
						v3 = a[i]
						let v4 = mut 0
						v4 = a[j]
						a[i] = v4
						a[j] = v3
						i += 1
						j -= 1
					}
				}
				let left = mut (j + i)
				let right = mut (hi + lo)
				if left < right{
					stk[sp] = i
					sp += 1
					stk[sp] = hi
					sp += 1
					hi = j
				}
				else{
					stk[sp] = lo
					sp += 1
					stk[sp] = j
					sp += 1
					lo = i
				}
			}
		}
		let w = mut 1
		let dir = mut 0
		loop{
			if w >= n{
				break
			}
			if dir == 0{
				let lo5 = mut 1
				loop{
					if lo5 > n{
						break
					}
					let mid6 = mut (lo5 + w)
					if mid6 > n1{
						mid6 = n1
					}
					let hi7 = mut (lo5 + 2 * w)
					if hi7 > n1{
						hi7 = n1
					}
					let i8 = mut lo5
					let j9 = mut mid6
					let k10 = mut lo5
					loop{
						if i8 >= mid6{
							break
						}
						if j9 >= hi7{
							break
						}
						let v11 = mut 0
						v11 = b[i8]
						let v12 = mut 0
						v12 = b[j9]
						if v11 <= v12{
							tmp[k10] = v11
							i8 += 1
						}
						else{
							tmp[k10] = v12
							j9 += 1
						}
						k10 += 1
					}
					loop{
						if i8 >= mid6{
							break
						}
						let v13 = mut 0
						v13 = b[i8]
						tmp[k10] = v13
						i8 += 1
						k10 += 1
					}
					loop{
						if j9 >= hi7{
							break
						}
						let v14 = mut 0
						v14 = b[j9]
						tmp[k10] = v14
						j9 += 1
						k10 += 1
					}
					lo5 += 2 * w
				}
				dir = 1
			}
			else{
				let lo15 = mut 1
				loop{
					if lo15 > n{
						break
					}
					let mid16 = mut (lo15 + w)
					if mid16 > n1{
						mid16 = n1
					}
					let hi17 = mut (lo15 + 2 * w)
					if hi17 > n1{
						hi17 = n1
					}
					let i18 = mut lo15
					let j19 = mut mid16
					let k20 = mut lo15
					loop{
						if i18 >= mid16{
							break
						}
						if j19 >= hi17{
							break
						}
						let v21 = mut 0
						v21 = tmp[i18]
						let v22 = mut 0
						v22 = tmp[j19]
						if v21 <= v22{
							b[k20] = v21
							i18 += 1
						}
						else{
							b[k20] = v22
							j19 += 1
						}
						k20 += 1
					}
					loop{
						if i18 >= mid16{
							break
						}
						let v23 = mut 0
						v23 = tmp[i18]
						b[k20] = v23
						i18 += 1
						k20 += 1
					}
					loop{
						if j19 >= hi17{
							break
						}
						let v24 = mut 0
						v24 = tmp[j19]
						b[k20] = v24
						j19 += 1
						k20 += 1
					}
					lo15 += 2 * w
				}
				dir = 0
			}
			w *= 2
		}
		if dir == 1{
			for i in 1..sz{
				let v25 = mut 0
				v25 = tmp[i]
				b[i] = v25
			}
		}
		let hr = mut (n / 2)
		loop{
			if hr == 0{
				break
			}
			let root = mut hr
			loop{
				let c26 = mut (2 * root)
				if c26 > n{
					break
				}
				let c127 = mut (c26 + 1)
				if c127 <= n{
					let v28 = mut 0
					v28 = d[c127]
					let v29 = mut 0
					v29 = d[c26]
					if v28 > v29{
						c26 = c127
					}
				}
				let v30 = mut 0
				v30 = d[root]
				let v31 = mut 0
				v31 = d[c26]
				if v30 >= v31{
					break
				}
				d[root] = v31
				d[c26] = v30
				root = c26
			}
			hr -= 1
		}
		let e = mut n
		loop{
			if e < 2{
				break
			}
			let v32 = mut 0
			v32 = d[one]
			let v33 = mut 0
			v33 = d[e]
			d[one] = v33
			d[e] = v32
			let em = mut (e - 1)
			let root2 = mut 1
			loop{
				let c34 = mut (2 * root2)
				if c34 > em{
					break
				}
				let c135 = mut (c34 + 1)
				if c135 <= em{
					let v36 = mut 0
					v36 = d[c135]
					let v37 = mut 0
					v37 = d[c34]
					if v36 > v37{
						c34 = c135
					}
				}
				let v38 = mut 0
				v38 = d[root2]
				let v39 = mut 0
				v39 = d[c34]
				if v38 >= v39{
					break
				}
				d[root2] = v39
				d[c34] = v38
				root2 = c34
			}
			e -= 1
		}
		let h = mut 0
		let ok = mut 1
		let prev = mut 0
		for i in 1..sz{
			let v40 = mut 0
			v40 = a[i]
			let v41 = mut 0
			v41 = b[i]
			let v42 = mut 0
			v42 = d[i]
			h = bits_and(h * 31 + v40, 0xFFFFFFFF)
			if v40 != v41{
				ok = 0
			}
			if v40 != v42{
				ok = 0
			}
			if i > 1{
				if prev > v40{
					ok = 0
				}
			}
			prev = v40
		}
		let bs = mut 0
		for k in 0..n{
			x = bits_and(x * 1664525 + 1013904223, 0xFFFFFFFF)
			let key = mut (x / 2)
			if k % 2 == 0{
				assume match n != 0
				let kk = mut (key % n + 1)
				key = orig[kk]
			}
			let lo2 = mut 1
			let hi2 = mut n1
			loop{
				if lo2 >= hi2{
					break
				}
				let m2 = mut ((lo2 + hi2) / 2)
				let v43 = mut 0
				v43 = a[m2]
				if v43 < key{
					lo2 = m2 + 1
				}
				else{
					hi2 = m2
				}
			}
			if lo2 <= n{
				let v44 = mut 0
				v44 = a[lo2]
				if v44 == key{
					bs += 1
				}
			}
		}
		let ls = mut 0
		for k in 0..20{
			x = bits_and(x * 1664525 + 1013904223, 0xFFFFFFFF)
			let key = mut (x / 2)
			if k % 2 == 0{
				assume match n != 0
				let kk = mut (key % n + 1)
				key = orig[kk]
			}
			let li = mut 1
			loop{
				if li > n{
					break
				}
				let v45 = mut 0
				v45 = orig[li]
				if v45 == key{
					ls += 1
					break
				}
				li += 1
			}
		}
		if ok == 1{
			printf("%llu %llu %llu OK\n", h, bs, ls)
		}
		else{
			printf("%llu %llu %llu BAD\n", h, bs, ls)
		}
	}
}
