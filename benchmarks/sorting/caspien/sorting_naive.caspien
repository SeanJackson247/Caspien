// Sorting and searching benchmark (SORT_N values), NAIVE variant: the stdlib DynamicArray<u64> class (get/set methods, each under its bounds proof).
// Iterative quicksort (Hoare, middle pivot, explicit stack), bottom-up merge sort, heap sort, then n binary searches on the sorted array and
// 20 linear searches on the unsorted one. Arrays are 1-based (element 0 unused) so that Hoare's j = lo - 1 cannot underflow an unsigned index.
// Elements are u64 (the reference programs use 32-bit ints). Prints: hash binary-hits linear-hits OK|BAD. Generated by generate.py.
import "../../../stdlib/libc.caspien"
import "../../../stdlib/dynamic_array.caspien"
import "../../../stdlib/gt_init.caspien"
import "../../../stdlib/gt_register.caspien"
import "../../../stdlib/gt_alive_check.caspien"
import "../../../stdlib/gt_destruct.caspien"
import "../../../stdlib/gt_moved.caspien"
extern getenv(static imut string) static imut string
extern atol(static imut string) mut u64

func main() void{
	?catch(e){ return }
	unsafe{
		let n = mut 0
		n = atol(getenv("SORT_N"))
		let n1 = mut (n + 1)
		let sz = mut (n + 1)
		let:<mut u64> zero = mut 0
		let r_orig = mut ? dyn:<u64>([])
		r_orig = ? resize(r_orig, sz, zero)
		let orig = mut ? new DynamicArray:<u64>(r_orig)
		let r_a = mut ? dyn:<u64>([])
		r_a = ? resize(r_a, sz, zero)
		let a = mut ? new DynamicArray:<u64>(r_a)
		let r_b = mut ? dyn:<u64>([])
		r_b = ? resize(r_b, sz, zero)
		let b = mut ? new DynamicArray:<u64>(r_b)
		let r_d = mut ? dyn:<u64>([])
		r_d = ? resize(r_d, sz, zero)
		let d = mut ? new DynamicArray:<u64>(r_d)
		let r_tmp = mut ? dyn:<u64>([])
		r_tmp = ? resize(r_tmp, sz, zero)
		let tmp = mut ? new DynamicArray:<u64>(r_tmp)
		let r_stk = mut ? dyn:<u64>([])
		r_stk = ? resize(r_stk, 256, zero)
		let stk = mut ? new DynamicArray:<u64>(r_stk)
		let x = mut 12345
		for i in 1..sz{
			x = bits_and(x * 1664525 + 1013904223, 0xFFFFFFFF)
			let val = mut (x / 2)
			match i into orig.backing{
				orig.set(orig, i, val)
			}
			match i into a.backing{
				a.set(a, i, val)
			}
			match i into b.backing{
				b.set(b, i, val)
			}
			match i into d.backing{
				d.set(d, i, val)
			}
		}
		let sp = mut 0
		let one = mut 1
		match sp into stk.backing{
			stk.set(stk, sp, one)
		}
		sp += 1
		match sp into stk.backing{
			stk.set(stk, sp, n)
		}
		sp += 1
		loop{
			if sp == 0{
				break
			}
			sp -= 1
			let hi = mut 0
			match sp in stk.backing{
				hi = stk.get(stk, sp)
			}
			sp -= 1
			let lo = mut 0
			match sp in stk.backing{
				lo = stk.get(stk, sp)
			}
			loop{
				if lo >= hi{
					break
				}
				let mm = mut ((lo + hi) / 2)
				let pivot = mut 0
				match mm in a.backing{
					pivot = a.get(a, mm)
				}
				let i = mut lo
				let j = mut hi
				loop{
					if i > j{
						break
					}
					loop{
						let v1 = mut 0
						match i in a.backing{
							v1 = a.get(a, i)
						}
						if v1 >= pivot{
							break
						}
						i += 1
					}
					loop{
						let v2 = mut 0
						match j in a.backing{
							v2 = a.get(a, j)
						}
						if v2 <= pivot{
							break
						}
						j -= 1
					}
					if i <= j{
						let v3 = mut 0
						match i in a.backing{
							v3 = a.get(a, i)
						}
						let v4 = mut 0
						match j in a.backing{
							v4 = a.get(a, j)
						}
						match i into a.backing{
							a.set(a, i, v4)
						}
						match j into a.backing{
							a.set(a, j, v3)
						}
						i += 1
						j -= 1
					}
				}
				let left = mut (j + i)
				let right = mut (hi + lo)
				if left < right{
					match sp into stk.backing{
						stk.set(stk, sp, i)
					}
					sp += 1
					match sp into stk.backing{
						stk.set(stk, sp, hi)
					}
					sp += 1
					hi = j
				}
				else{
					match sp into stk.backing{
						stk.set(stk, sp, lo)
					}
					sp += 1
					match sp into stk.backing{
						stk.set(stk, sp, j)
					}
					sp += 1
					lo = i
				}
			}
		}
		let w = mut 1
		let dir = mut 0
		loop{
			if w >= n{
				break
			}
			if dir == 0{
				let lo5 = mut 1
				loop{
					if lo5 > n{
						break
					}
					let mid6 = mut (lo5 + w)
					if mid6 > n1{
						mid6 = n1
					}
					let hi7 = mut (lo5 + 2 * w)
					if hi7 > n1{
						hi7 = n1
					}
					let i8 = mut lo5
					let j9 = mut mid6
					let k10 = mut lo5
					loop{
						if i8 >= mid6{
							break
						}
						if j9 >= hi7{
							break
						}
						let v11 = mut 0
						match i8 in b.backing{
							v11 = b.get(b, i8)
						}
						let v12 = mut 0
						match j9 in b.backing{
							v12 = b.get(b, j9)
						}
						if v11 <= v12{
							match k10 into tmp.backing{
								tmp.set(tmp, k10, v11)
							}
							i8 += 1
						}
						else{
							match k10 into tmp.backing{
								tmp.set(tmp, k10, v12)
							}
							j9 += 1
						}
						k10 += 1
					}
					loop{
						if i8 >= mid6{
							break
						}
						let v13 = mut 0
						match i8 in b.backing{
							v13 = b.get(b, i8)
						}
						match k10 into tmp.backing{
							tmp.set(tmp, k10, v13)
						}
						i8 += 1
						k10 += 1
					}
					loop{
						if j9 >= hi7{
							break
						}
						let v14 = mut 0
						match j9 in b.backing{
							v14 = b.get(b, j9)
						}
						match k10 into tmp.backing{
							tmp.set(tmp, k10, v14)
						}
						j9 += 1
						k10 += 1
					}
					lo5 += 2 * w
				}
				dir = 1
			}
			else{
				let lo15 = mut 1
				loop{
					if lo15 > n{
						break
					}
					let mid16 = mut (lo15 + w)
					if mid16 > n1{
						mid16 = n1
					}
					let hi17 = mut (lo15 + 2 * w)
					if hi17 > n1{
						hi17 = n1
					}
					let i18 = mut lo15
					let j19 = mut mid16
					let k20 = mut lo15
					loop{
						if i18 >= mid16{
							break
						}
						if j19 >= hi17{
							break
						}
						let v21 = mut 0
						match i18 in tmp.backing{
							v21 = tmp.get(tmp, i18)
						}
						let v22 = mut 0
						match j19 in tmp.backing{
							v22 = tmp.get(tmp, j19)
						}
						if v21 <= v22{
							match k20 into b.backing{
								b.set(b, k20, v21)
							}
							i18 += 1
						}
						else{
							match k20 into b.backing{
								b.set(b, k20, v22)
							}
							j19 += 1
						}
						k20 += 1
					}
					loop{
						if i18 >= mid16{
							break
						}
						let v23 = mut 0
						match i18 in tmp.backing{
							v23 = tmp.get(tmp, i18)
						}
						match k20 into b.backing{
							b.set(b, k20, v23)
						}
						i18 += 1
						k20 += 1
					}
					loop{
						if j19 >= hi17{
							break
						}
						let v24 = mut 0
						match j19 in tmp.backing{
							v24 = tmp.get(tmp, j19)
						}
						match k20 into b.backing{
							b.set(b, k20, v24)
						}
						j19 += 1
						k20 += 1
					}
					lo15 += 2 * w
				}
				dir = 0
			}
			w *= 2
		}
		if dir == 1{
			for i in 1..sz{
				let v25 = mut 0
				match i in tmp.backing{
					v25 = tmp.get(tmp, i)
				}
				match i into b.backing{
					b.set(b, i, v25)
				}
			}
		}
		let hr = mut (n / 2)
		loop{
			if hr == 0{
				break
			}
			let root = mut hr
			loop{
				let c26 = mut (2 * root)
				if c26 > n{
					break
				}
				let c127 = mut (c26 + 1)
				if c127 <= n{
					let v28 = mut 0
					match c127 in d.backing{
						v28 = d.get(d, c127)
					}
					let v29 = mut 0
					match c26 in d.backing{
						v29 = d.get(d, c26)
					}
					if v28 > v29{
						c26 = c127
					}
				}
				let v30 = mut 0
				match root in d.backing{
					v30 = d.get(d, root)
				}
				let v31 = mut 0
				match c26 in d.backing{
					v31 = d.get(d, c26)
				}
				if v30 >= v31{
					break
				}
				match root into d.backing{
					d.set(d, root, v31)
				}
				match c26 into d.backing{
					d.set(d, c26, v30)
				}
				root = c26
			}
			hr -= 1
		}
		let e = mut n
		loop{
			if e < 2{
				break
			}
			let v32 = mut 0
			match one in d.backing{
				v32 = d.get(d, one)
			}
			let v33 = mut 0
			match e in d.backing{
				v33 = d.get(d, e)
			}
			match one into d.backing{
				d.set(d, one, v33)
			}
			match e into d.backing{
				d.set(d, e, v32)
			}
			let em = mut (e - 1)
			let root2 = mut 1
			loop{
				let c34 = mut (2 * root2)
				if c34 > em{
					break
				}
				let c135 = mut (c34 + 1)
				if c135 <= em{
					let v36 = mut 0
					match c135 in d.backing{
						v36 = d.get(d, c135)
					}
					let v37 = mut 0
					match c34 in d.backing{
						v37 = d.get(d, c34)
					}
					if v36 > v37{
						c34 = c135
					}
				}
				let v38 = mut 0
				match root2 in d.backing{
					v38 = d.get(d, root2)
				}
				let v39 = mut 0
				match c34 in d.backing{
					v39 = d.get(d, c34)
				}
				if v38 >= v39{
					break
				}
				match root2 into d.backing{
					d.set(d, root2, v39)
				}
				match c34 into d.backing{
					d.set(d, c34, v38)
				}
				root2 = c34
			}
			e -= 1
		}
		let h = mut 0
		let ok = mut 1
		let prev = mut 0
		for i in 1..sz{
			let v40 = mut 0
			match i in a.backing{
				v40 = a.get(a, i)
			}
			let v41 = mut 0
			match i in b.backing{
				v41 = b.get(b, i)
			}
			let v42 = mut 0
			match i in d.backing{
				v42 = d.get(d, i)
			}
			h = bits_and(h * 31 + v40, 0xFFFFFFFF)
			if v40 != v41{
				ok = 0
			}
			if v40 != v42{
				ok = 0
			}
			if i > 1{
				if prev > v40{
					ok = 0
				}
			}
			prev = v40
		}
		let bs = mut 0
		for k in 0..n{
			x = bits_and(x * 1664525 + 1013904223, 0xFFFFFFFF)
			let key = mut (x / 2)
			if k % 2 == 0{
				let kk = mut (key % n + 1)
				match kk in orig.backing{
					key = orig.get(orig, kk)
				}
			}
			let lo2 = mut 1
			let hi2 = mut n1
			loop{
				if lo2 >= hi2{
					break
				}
				let m2 = mut ((lo2 + hi2) / 2)
				let v43 = mut 0
				match m2 in a.backing{
					v43 = a.get(a, m2)
				}
				if v43 < key{
					lo2 = m2 + 1
				}
				else{
					hi2 = m2
				}
			}
			if lo2 <= n{
				let v44 = mut 0
				match lo2 in a.backing{
					v44 = a.get(a, lo2)
				}
				if v44 == key{
					bs += 1
				}
			}
		}
		let ls = mut 0
		for k in 0..20{
			x = bits_and(x * 1664525 + 1013904223, 0xFFFFFFFF)
			let key = mut (x / 2)
			if k % 2 == 0{
				let kk = mut (key % n + 1)
				match kk in orig.backing{
					key = orig.get(orig, kk)
				}
			}
			let li = mut 1
			loop{
				if li > n{
					break
				}
				let v45 = mut 0
				match li in orig.backing{
					v45 = orig.get(orig, li)
				}
				if v45 == key{
					ls += 1
					break
				}
				li += 1
			}
		}
		if ok == 1{
			printf("%llu %llu %llu OK\n", h, bs, ls)
		}
		else{
			printf("%llu %llu %llu BAD\n", h, bs, ls)
		}
	}
}
