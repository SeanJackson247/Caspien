// REF-IN-STDLIB variant of knucleotide_naive: identical program, but the stdlib HashMap is stdlib/ref/hash_map.caspien (separate chaining over self-referential `ref` nodes) instead of the open-addressing stdlib/hash_map.caspien.
// k-nucleotide benchmark, NAIVE variant: stdlib DynamicArray<u8>/<u64> for the sequence and the query tables, and the stdlib HashMap<u64> (stdlib/hash_map.caspien, which hashes each key with its own multiply/xor-shift mix) for the k-mer counts.
// Same sequence, k-mers and output as knucleotide.c (read its header): N = KNUC_N bases from the benchmarks-game LCG, the packed 2-bit
// k-mers for k = 1,2,3,4,6,12 are counted in a hash map, prints 18 numbers (6 distinct counts, then 12 k-mer counts).
// The map grows by itself (the capacity is only a starting size, rounded up to a power of two); it is still created per k with capacity 2 x min(4^k, N-k+1, 139968) + 1,
// so no growth happens during the timed counting.
import "../../../stdlib/libc.caspien"
import "../../../stdlib/dynamic_array.caspien"
import "../../../stdlib/ref/hash_map.caspien"
import "../../../stdlib/gt_init.caspien"
import "../../../stdlib/gt_register.caspien"
import "../../../stdlib/gt_alive_check.caspien"
import "../../../stdlib/gt_destruct.caspien"
import "../../../stdlib/gt_moved.caspien"
extern getenv(static imut string) static imut string
extern atol(static imut string) mut u64

func main() void{
	?catch(e){ return }
	unsafe extern{
		let n = mut 0
		n = atol(getenv("KNUC_N"))
		let:<mut u8> zb = mut 0
		let:<mut u64> zw = mut 0
		let r_seq = mut ? dyn:<u8>([])
		r_seq = ? resize(r_seq, (n + 1), zb)
		let seq = mut ? new DynamicArray:<u8>(r_seq)
		let r_qk = mut ? dyn:<u64>([])
		r_qk = ? resize(r_qk, 12, zw)
		let qk = mut ? new DynamicArray:<u64>(r_qk)
		let r_qv = mut ? dyn:<u64>([])
		r_qv = ? resize(r_qv, 12, zw)
		let qv = mut ? new DynamicArray:<u64>(r_qv)
		let r_res = mut ? dyn:<u64>([])
		r_res = ? resize(r_res, 18, zw)
		let res = mut ? new DynamicArray:<u64>(r_res)
		let last = mut 42
		for i in 0..n{
			last = (last * 3877 + 29573) % 139968
			let b = mut 3
			if last < 97767{
				b = 2
			}
			if last < 70117{
				b = 1
			}
			if last < 42404{
				b = 0
			}
			let:<mut u8> sb = mut 0
			sb = wrap:<u8>(b)
			match i into seq.backing{
				seq.set(seq, i, sb)
			}
		}
		let m12 = mut 12
		if n < 12{
			m12 = n
		}
		let first12 = mut 0
		for i in 0..m12{
			let sv = mut 0
			match i in seq.backing{
				sv = seq.get(seq, i) as u64
			}
			first12 = first12 * 4 + sv
		}
		let qi = mut 0
		qi = 0
		match qi into qk.backing{
			qk.set(qk, qi, 1)
		}
		match qi into qv.backing{
			qv.set(qv, qi, 0)
		}
		qi = 1
		match qi into qk.backing{
			qk.set(qk, qi, 1)
		}
		match qi into qv.backing{
			qv.set(qv, qi, 1)
		}
		qi = 2
		match qi into qk.backing{
			qk.set(qk, qi, 1)
		}
		match qi into qv.backing{
			qv.set(qv, qi, 2)
		}
		qi = 3
		match qi into qk.backing{
			qk.set(qk, qi, 1)
		}
		match qi into qv.backing{
			qv.set(qv, qi, 3)
		}
		qi = 4
		match qi into qk.backing{
			qk.set(qk, qi, 2)
		}
		match qi into qv.backing{
			qv.set(qv, qi, 10)
		}
		qi = 5
		match qi into qk.backing{
			qk.set(qk, qi, 2)
		}
		match qi into qv.backing{
			qv.set(qv, qi, 11)
		}
		qi = 6
		match qi into qk.backing{
			qk.set(qk, qi, 2)
		}
		match qi into qv.backing{
			qv.set(qv, qi, 0)
		}
		qi = 7
		match qi into qk.backing{
			qk.set(qk, qi, 3)
		}
		match qi into qv.backing{
			qv.set(qv, qi, 43)
		}
		qi = 8
		match qi into qk.backing{
			qk.set(qk, qi, 4)
		}
		match qi into qv.backing{
			qv.set(qv, qi, 172)
		}
		qi = 9
		match qi into qk.backing{
			qk.set(qk, qi, 6)
		}
		match qi into qv.backing{
			qv.set(qv, qi, 2767)
		}
		qi = 10
		match qi into qk.backing{
			qk.set(qk, qi, 12)
		}
		match qi into qv.backing{
			qv.set(qv, qi, 11337487)
		}
		qi = 11
		match qi into qk.backing{
			qk.set(qk, qi, 12)
		}
		match qi into qv.backing{
			qv.set(qv, qi, first12)
		}
		let capmax = mut 2
		let maxd12 = mut 139968
		if n < maxd12{
			maxd12 = n
		}
		let tw = mut (2 * maxd12)
		let nq = mut 0
		for ki in 0..6{
			let k = mut 1
			if ki == 1{
				k = 2
			}
			if ki == 2{
				k = 3
			}
			if ki == 3{
				k = 4
			}
			if ki == 4{
				k = 6
			}
			if ki == 5{
				k = 12
			}
			let maxd = mut 1
			maxd = bits_left(maxd, 2 * k)
			let win = mut 0
			if n >= k{
				win = n - k + 1
			}
			if win < maxd{
				maxd = win
			}
			if maxd > 139968{
				maxd = 139968
			}
			let two = mut (2 * maxd)
			let sh = mut (64 - 2 * k)
			let nd = mut 0
			let key = mut 0
			let kmask = mut (64 - 2 * k)
			let cap = mut (two + 1)
			let m = mut ? new HashMap:<u64>(zw, zw, cap)
			for i in 0..n{
				let sv = mut 0
				match i in seq.backing{
					sv = seq.get(seq, i) as u64
				}
				key = bits_right(bits_left(key * 4 + sv, kmask), kmask)
				let ik = mut (i + 1)
				if ik >= k{
					let cv = mut m.get(m, key, zw)
					cv += 1
					m.set(m, key, cv)
				}
			}
			nd = m.count
			match ki into res.backing{
				res.set(res, ki, nd)
			}
			for q in 0..12{
				let qkv = mut 0
				match q in qk.backing{
					qkv = qk.get(qk, q)
				}
				if qkv == k{
					let qvv = mut 0
					match q in qv.backing{
						qvv = qv.get(qv, q)
					}
					let found = mut 0
					found = m.get(m, qvv, zw)
					let ri = mut (6 + nq)
					match ri into res.backing{
						res.set(res, ri, found)
					}
					nq += 1
				}
			}
		}
		for i in 0..18{
			let pv = mut 0
			match i in res.backing{
				pv = res.get(res, i)
			}
			if i == 0{
				printf("%llu", pv)
			}
			else{
				printf(" %llu", pv)
			}
		}
		printf("\n")
	}
}
