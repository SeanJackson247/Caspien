// String manipulation benchmark, UNSAFE variant: byte buffers are unsafe dynarrays (no bounds checks). Same steps and output as strings.c:
// words longest abc revhash replacedlen replacedhash uphash. N (characters) comes from STRINGS_N.
import "../../../stdlib/libc.caspien"
import "../../../stdlib/gt_init.caspien"
import "../../../stdlib/gt_register.caspien"
import "../../../stdlib/gt_alive_check.caspien"
import "../../../stdlib/gt_destruct.caspien"
import "../../../stdlib/gt_moved.caspien"
extern getenv(static imut string) static imut string
extern atol(static imut string) mut u64

func main() void{
	unsafe extern udyn{
		let n = mut 0
		n = atol(getenv("STRINGS_N"))
		let text = mut unsafe dyn:<u8>([])
		text = resize(text, n)
		let x = mut 12345
		for i in 0..n{
			x = bits_and(x * 1664525 + 1013904223, 0xFFFFFFFF)
			let r = mut (bits_right(x, 16) % 27)
			let:<mut u8> ch = mut wrap:<u8>(97 + r)
			if r == 26{
				ch = 32
			}
			text[i] = ch
		}
		// word statistics
		let words = mut 0
		let longest = mut 0
		let cur = mut 0
		for i in 0..n{
			if text[i] == 32{
				if cur > 0{
					words += 1
					if cur > longest{
						longest = cur
					}
					cur = 0
				}
			}
			else{
				cur += 1
			}
		}
		if cur > 0{
			words += 1
			if cur > longest{
				longest = cur
			}
		}
		// occurrences of "abc"
		let abc = mut 0
		let lim = mut 0
		if n >= 3{
			lim = n - 2
		}
		for i in 0..lim{
			let i1 = mut (i + 1)
			let i2 = mut (i + 2)
			if text[i] == 97{
				if text[i1] == 98{
					if text[i2] == 99{
						abc += 1
					}
				}
			}
		}
		// reverse
		let rev = mut unsafe dyn:<u8>([])
		rev = resize(rev, n)
		for i in 0..n{
			let j = mut (n - 1 - i)
			rev[i] = text[j]
		}
		let hrev = mut 7
		for i in 0..n{
			hrev = bits_and(hrev * 31 + rev[i] as u64, 0xFFFFFFFF)
		}
		// replace every 'e' by "33"
		let es = mut 0
		for i in 0..n{
			if text[i] == 101{
				es += 1
			}
		}
		let m = mut (n + es)
		let rep = mut unsafe dyn:<u8>([])
		rep = resize(rep, m)
		let k = mut 0
		for i in 0..n{
			if text[i] == 101{
				let k1 = mut (k + 1)
				rep[k] = 51
				rep[k1] = 51
				k += 2
			}
			else{
				rep[k] = text[i]
				k += 1
			}
		}
		let hrep = mut 7
		for i in 0..m{
			hrep = bits_and(hrep * 31 + rep[i] as u64, 0xFFFFFFFF)
		}
		// upper case
		let up = mut unsafe dyn:<u8>([])
		up = resize(up, n)
		for i in 0..n{
			if text[i] == 32{
				up[i] = 32
			}
			else{
				up[i] = wrap:<u8>(text[i] as u64 - 32)
			}
		}
		let hup = mut 7
		for i in 0..n{
			hup = bits_and(hup * 31 + up[i] as u64, 0xFFFFFFFF)
		}
		printf("%llu %llu %llu %llu %llu %llu %llu\n", words, longest, abc, hrev, m, hrep, hup)
	}
}
