// Sieve of Eratosthenes, counting the primes <= N (SIEVE_N). UNSAFE variant: an unsafe dynarray of bytes, no bounds proofs.
// Same algorithm as the C program: one byte per number, inner loop from i*i in steps of i.
import "../../../stdlib/libc.caspien"
import "../../../stdlib/gt/*"

extern getenv(static imut string) static imut string
extern atol(static imut string) mut u64

func main() void{
	unsafe extern loop udyn{
		let n = mut 0
		n = atol(getenv("SIEVE_N"))
		let f = mut unsafe dyn:<u8>([])
		let total = mut (n + 1)
		f = resize(f, total)
		for i in 0..total{
			f[i] = 1
		}
		let i = mut 2
		loop{
			if i * i > n{
				break
			}
			if f[i] != 0{
				let j = mut (i * i)
				loop{
					if j > n{
						break
					}
					f[j] = 0
					j += i
				}
			}
			i += 1
		}
		let count = mut 0
		for k in 2..total{
			count += f[k] as u64
		}
		printf("%llu\n", count)
	}
}
