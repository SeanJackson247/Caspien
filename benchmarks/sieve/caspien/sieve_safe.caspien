// Sieve of Eratosthenes, counting the primes <= N (SIEVE_N). SAFE variant: a safe dynarray of bytes; every element access sits
// under a bounds proof (match i in/into f). Only the unbounded loop{} and the C calls need unsafe.
import "../../../stdlib/libc.caspien"
import "../../../stdlib/gt/*"
extern getenv(static imut string) static imut string
extern atol(static imut string) mut u64

func main() void{
	?catch(e){ return }
	unsafe extern loop{
		let n = mut 0
		n = atol(getenv("SIEVE_N"))
		let f = mut ? dyn:<u8>([])
		let total = mut (n + 1)
		let:<mut u8> one = mut 1
		f = ? resize(f, total, one)
		let i = mut 2
		loop{
			if i * i > n{
				break
			}
			let keep = mut 0
			match i in f{
				keep = f[i] as u64
			}
			if keep != 0{
				let j = mut (i * i)
				loop{
					if j > n{
						break
					}
					match j into f{
						f[j] = 0
					}
					j += i
				}
			}
			i += 1
		}
		let count = mut 0
		for k in 2..total{
			match k in f{
				count += f[k] as u64
			}
		}
		printf("%llu\n", count)
	}
}
