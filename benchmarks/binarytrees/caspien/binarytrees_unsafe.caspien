// Binary trees (BINARYTREES_N = max depth), OPTIMIZED UNSAFE variant: unsafe dynarrays for the node pool (Node structs) and the work stack, no bounds checks.
// Prints one line: stretch-tree check, then for d = 4,6,..,N the summed check of 2^(N-d+4) trees of depth d, then the long-lived tree check
// (check = number of nodes reached by walking the tree), exactly as binarytrees.c.
//
// DIFFERENCES FROM THE REFERENCE (pointer nodes, recursive make/check/free): This is the INDEX-BASED version (the binarytrees_ref_* variants link real heap nodes with `ref` members instead); Caspien only supports
// structurally-decreasing recursion, so the tree is INDEX-BASED: nodes live in one pool (a dynarray of Node{l, r} structs, children are pool
// indices, 0 = null), allocated from a free list (a freed node is chained through its `l` field) or by bumping `top`. make/check/free are
// iterative with an explicit work stack (entries pack node*64 + depth for the build). Allocation and freeing are real: every tree is
// built node by node, walked, then every node is returned to the free list. The pool never grows (capacity 2^(N+2)+2 covers the stretch tree).
import "../../../stdlib/libc.caspien"
import "../../../stdlib/gt_init.caspien"
import "../../../stdlib/gt_register.caspien"
import "../../../stdlib/gt_alive_check.caspien"
import "../../../stdlib/gt_destruct.caspien"
import "../../../stdlib/gt_moved.caspien"

extern getenv(static imut string) static imut string
extern atol(static imut string) mut u64

struct Node{
	@pub{ l: mut u64 }
	@pub{ r: mut u64 }
}

func main() void{
	unsafe extern loop udyn{
		let maxd = mut 0
		maxd = atol(getenv("BINARYTREES_N"))
		if maxd < 6{
			maxd = 6
		}
		let cap = mut 1
		let lim = mut (maxd + 2)
		for i in 0..lim{
			cap = cap * 2
		}
		cap += 2
		let nodes = mut unsafe dyn:<Node>([])
		let stack = mut unsafe dyn:<u64>([])
		nodes = resize(nodes, cap)
		stack = resize(stack, 128)
		let freeh = mut 0
		let top = mut 1
		let sp = mut 0
		let e = mut 0
		let id = mut 0
		let dp = mut 0
		let ca = mut 0
		let cb = mut 0
		let cnt = mut 0
		let root = mut 0
		let llroot = mut 0
		let sum = mut 0
		let d = mut 4
		let iters = mut 0
		// stretch tree: build, check, free
		let sd = mut (maxd + 1)
		if freeh != 0{
			root = freeh
			freeh = nodes[root].l
		}else{
			root = top
			top += 1
		}
		nodes[root].l = 0
		nodes[root].r = 0
		sp = 0
		stack[sp] = root * 64 + sd
		sp += 1
		loop{
			if sp == 0{
				break
			}
			sp -= 1
			e = stack[sp]
			id = e / 64
			dp = e % 64
			if dp > 0{
				if freeh != 0{
					ca = freeh
					freeh = nodes[ca].l
				}else{
					ca = top
					top += 1
				}
				nodes[ca].l = 0
				nodes[ca].r = 0
				if freeh != 0{
					cb = freeh
					freeh = nodes[cb].l
				}else{
					cb = top
					top += 1
				}
				nodes[cb].l = 0
				nodes[cb].r = 0
				nodes[id].l = ca
				nodes[id].r = cb
				stack[sp] = ca * 64 + (dp - 1)
				sp += 1
				stack[sp] = cb * 64 + (dp - 1)
				sp += 1
			}
		}
		cnt = 0
		sp = 0
		stack[sp] = root
		sp += 1
		loop{
			if sp == 0{
				break
			}
			sp -= 1
			id = stack[sp]
			cnt += 1
			ca = nodes[id].l
			if ca != 0{
				stack[sp] = ca
				sp += 1
				cb = nodes[id].r
				stack[sp] = cb
				sp += 1
			}
		}
		printf("%llu", cnt)
		sp = 0
		stack[sp] = root
		sp += 1
		loop{
			if sp == 0{
				break
			}
			sp -= 1
			id = stack[sp]
			ca = nodes[id].l
			if ca != 0{
				stack[sp] = ca
				sp += 1
				cb = nodes[id].r
				stack[sp] = cb
				sp += 1
			}
			nodes[id].l = freeh
			freeh = id
		}
		// long-lived tree: kept until the end
		if freeh != 0{
			llroot = freeh
			freeh = nodes[llroot].l
		}else{
			llroot = top
			top += 1
		}
		nodes[llroot].l = 0
		nodes[llroot].r = 0
		sp = 0
		stack[sp] = llroot * 64 + maxd
		sp += 1
		loop{
			if sp == 0{
				break
			}
			sp -= 1
			e = stack[sp]
			id = e / 64
			dp = e % 64
			if dp > 0{
				if freeh != 0{
					ca = freeh
					freeh = nodes[ca].l
				}else{
					ca = top
					top += 1
				}
				nodes[ca].l = 0
				nodes[ca].r = 0
				if freeh != 0{
					cb = freeh
					freeh = nodes[cb].l
				}else{
					cb = top
					top += 1
				}
				nodes[cb].l = 0
				nodes[cb].r = 0
				nodes[id].l = ca
				nodes[id].r = cb
				stack[sp] = ca * 64 + (dp - 1)
				sp += 1
				stack[sp] = cb * 64 + (dp - 1)
				sp += 1
			}
		}
		loop{
			if d > maxd{
				break
			}
			iters = 1
			let sh = mut ((maxd - d) + 4)
			for k in 0..sh{
				iters = iters * 2
			}
			sum = 0
			for it in 0..iters{
				if freeh != 0{
					root = freeh
					freeh = nodes[root].l
				}else{
					root = top
					top += 1
				}
				nodes[root].l = 0
				nodes[root].r = 0
				sp = 0
				stack[sp] = root * 64 + d
				sp += 1
				loop{
					if sp == 0{
						break
					}
					sp -= 1
					e = stack[sp]
					id = e / 64
					dp = e % 64
					if dp > 0{
						if freeh != 0{
							ca = freeh
							freeh = nodes[ca].l
						}else{
							ca = top
							top += 1
						}
						nodes[ca].l = 0
						nodes[ca].r = 0
						if freeh != 0{
							cb = freeh
							freeh = nodes[cb].l
						}else{
							cb = top
							top += 1
						}
						nodes[cb].l = 0
						nodes[cb].r = 0
						nodes[id].l = ca
						nodes[id].r = cb
						stack[sp] = ca * 64 + (dp - 1)
						sp += 1
						stack[sp] = cb * 64 + (dp - 1)
						sp += 1
					}
				}
				cnt = 0
				sp = 0
				stack[sp] = root
				sp += 1
				loop{
					if sp == 0{
						break
					}
					sp -= 1
					id = stack[sp]
					cnt += 1
					ca = nodes[id].l
					if ca != 0{
						stack[sp] = ca
						sp += 1
						cb = nodes[id].r
						stack[sp] = cb
						sp += 1
					}
				}
				sum += cnt
				sp = 0
				stack[sp] = root
				sp += 1
				loop{
					if sp == 0{
						break
					}
					sp -= 1
					id = stack[sp]
					ca = nodes[id].l
					if ca != 0{
						stack[sp] = ca
						sp += 1
						cb = nodes[id].r
						stack[sp] = cb
						sp += 1
					}
					nodes[id].l = freeh
					freeh = id
				}
			}
			printf(" %llu", sum)
			d += 2
		}
		cnt = 0
		sp = 0
		stack[sp] = llroot
		sp += 1
		loop{
			if sp == 0{
				break
			}
			sp -= 1
			id = stack[sp]
			cnt += 1
			ca = nodes[id].l
			if ca != 0{
				stack[sp] = ca
				sp += 1
				cb = nodes[id].r
				stack[sp] = cb
				sp += 1
			}
		}
		printf(" %llu\n", cnt)
		sp = 0
		stack[sp] = llroot
		sp += 1
		loop{
			if sp == 0{
				break
			}
			sp -= 1
			id = stack[sp]
			ca = nodes[id].l
			if ca != 0{
				stack[sp] = ca
				sp += 1
				cb = nodes[id].r
				stack[sp] = cb
				sp += 1
			}
			nodes[id].l = freeh
			freeh = id
		}
	}
}
