// The java.lang.Long statics the codegen files use, called as in Java: `Long.bitCount(x)`, `Long.numberOfTrailingZeros(x)`, `Long.numberOfLeadingZeros(x)`.
struct Long{@pub{
}}

impl constructor for Long() self{
	return Long{}
}

@pub
impl Long{
	/** The number of one bits in the 64-bit two's-complement form of `x`. */
	@pub
	static func bitCount(x: mut s64) mut s32{
		let v = mut wrap:<u64>(x)
		let:<mut s32> count = mut 0
		for i in 0..64{
			let bit = mut bits_and(bits_right(v, i), 1)
			if bit == 1{
				count += 1
			}
		}
		return count
	}

	/** The number of zero bits below the lowest one bit of `x`; 64 when `x` is 0. */
	@pub
	static func numberOfTrailingZeros(x: mut s64) mut s32{
		let v = mut wrap:<u64>(x)
		let:<mut s32> count = mut 0
		let seen = mut false
		for i in 0..64{
			let bit = mut bits_and(bits_right(v, i), 1)
			if bit == 1{
				seen = true
			}
			if seen == false{
				count += 1
			}
		}
		return count
	}

	/** The number of zero bits above the highest one bit of `x`; 64 when `x` is 0. */
	@pub
	static func numberOfLeadingZeros(x: mut s64) mut s32{
		let v = mut wrap:<u64>(x)
		let:<mut s32> count = mut 0
		let seen = mut false
		for i in 0..64{
			let bit = mut bits_and(bits_right(v, 63 - i), 1)
			if bit == 1{
				seen = true
			}
			if seen == false{
				count += 1
			}
		}
		return count
	}
}
