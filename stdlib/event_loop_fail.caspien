// Shared by the three event_loop*.caspien variants: when 'main' or the '@tick' function throws, the loop
// writes the thrown message and a newline to stderr (fd 2) before the error leaves 'start', so a loop that
// stopped never looks like a clean shutdown (the process then exits with a non-zero status).
import "libc.caspien"

@pub
func eventLoopReport(msg: static imut string) void{
	unsafe extern{
		write(2, "event loop stopped: ", 20)
		write(2, msg, strlen(msg))
		write(2, "\n", 1)
	}
	return
}
