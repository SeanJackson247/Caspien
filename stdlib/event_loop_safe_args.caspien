import "event_loop_fail.caspien"
// NOTE: 'main' here must be '@throws' (a '@with_tick' main builds heap state, which can fail),
// so the call is wrapped with '?'. If 'main' or the '@tick' function throws, the message goes to stderr and the program exits non-zero.
// The safe-args counterpart of "event_loop.caspien" -- for a program
// whose own '@with_tick' 'main' takes the wrapped, safe
// "owns some mut dynarray(dynarray(char))" shape rather than raw
// argc/argv. '@event_loop' is still the real entry point, so it still
// receives the raw C-ABI arguments (the same signature
// "event_loop_c_args.caspien" uses, confirmed directly this is
// required whenever 'main' itself takes arguments at all) -- but here
// it calls '@make_safe_args' itself first, the exact same shape the
// compiler's own synthesized wrapper uses when there's no
// '@event_loop' at all (see BytecodeEmitter.emitSafeArgsMainWrapper),
// just written here as ordinary Caspien source instead of being
// generated directly as bytecode.
@event_loop
@throws
func start(argc: imut s32, argv: raw mut raw mut char) void{
	?catch(e){
		eventLoopReport(e)
		throw e
	}
	let args = mut ? make_safe_args(argc, argv)
	let state = mut ? main(args)
	loop{
		state = ? tick(state)
	}
}
