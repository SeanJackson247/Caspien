// HashSet<T>: a thin wrapper over HashMap<T, bool> (the value is always true). Same limits as the map: T is a non-struct type of at most 8 bytes.
// Imports the ref (chained) map next to it (stdlib/ref/hash_map.caspien); stdlib/hash_set.caspien is the same file over the open-addressing map.
import "hash_map.caspien"

@pub
struct HashSet<T>{@pub{
	map: owns some mut HashMap<T, bool>
}}

/** `new HashSet:<u64>(defaultElement, capacity)` -- an empty set; `capacity` is only the starting size (the map grows). `@throws`: the map allocation can fail. */
@pub
@throws
impl<T> constructor for HashSet<T>(defaultElement: mut T, capacity: mut u64) self{
	?catch(e){ throw e }
	let map = mut ? new HashMap:<T, bool>(defaultElement, false, capacity)
	return HashSet:<T>{map= map}
}

@pub
impl<T> HashSet<T>{
	/** Adds `x`; returns true if it was not in the set yet. */
	@pub
	func add(_self: ref some mut self, x: mut T) mut bool{
		let had = mut _self.map.contains(_self.map, x)
		_self.map.set(_self.map, x, true)
		return !had
	}

	@pub
	func contains(_self: ref some imut self, x: mut T) mut bool{
		return _self.map.contains(_self.map, x)
	}

	/** Removes `x`; returns whether it was there. */
	@pub
	func remove(_self: ref some mut self, x: mut T) mut bool{
		return _self.map.remove(_self.map, x)
	}

	@pub
	func size(_self: ref some imut self) mut u64{
		return _self.map.count
	}
}
