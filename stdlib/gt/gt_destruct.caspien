// The "@gt_destruct" of the id table -- unregisters `ptr` (dropping its id, if it ever had one) and frees it (nothing happens for null or an
// unregistered pointer). T1 is halved when it falls below an eighth of its capacity (a failed shrink is ignored). T2/T3 never shrink.
import "ghost_table.caspien"

@gt_destruct
@pub
func gt_destruct(ptr: raw imut u8) void{
	if ptr != null{
		match @lock ghost_table{
			OPEN:{
				let addr = mut gtAddrOf(ptr)
				let at = mut gtT1Find(ghost_table.base, ghost_table.capacity, addr)
				if at != ghost_table.capacity{
					let stored = mut gtLoad(ghost_table.base, at)
					if bits_and(stored, 1) == 1{
						gtUnlinkId(ghost_table.refBase, ghost_table.refCap, ghost_table.idBase, ghost_table.idCap, addr)
						ghost_table.refLen = mut (ghost_table.refLen - 1)
						ghost_table.idLen = mut (ghost_table.idLen - 1)
					}
					gtT1RemoveAt(ghost_table.base, ghost_table.capacity, at)
					ghost_table.len = mut (ghost_table.len - 1)
					if ghost_table.capacity > 8 && ghost_table.len * 8 < ghost_table.capacity{
						let newCapacity = mut (ghost_table.capacity / 2)
						let:<raw mut u8> newBase = null
						unsafe extern{
							newBase = mut realloc(null, newCapacity * 8)
						}
						if newBase != null{
							gtClear(newBase, newCapacity)
							gtT1Rehash(ghost_table.base, ghost_table.capacity, newBase, newCapacity)
							unsafe extern{
								free(ghost_table.base)
							}
							ghost_table.base = mut newBase
							ghost_table.capacity = mut newCapacity
						}
					}
					unsafe extern{
						free(ptr)
					}
				}
			}
			CLOSED:{
				continue
			}
		}
	}
}
