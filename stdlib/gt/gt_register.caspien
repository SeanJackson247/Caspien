// The "@gt_register" of the id table -- registers a raw pointer (as an untagged T1 entry). Returns true when the pointer is registered afterwards
// (null and an already present pointer need nothing and count as success), false when T1 could not grow: then the pointer is NOT registered
// and the table is exactly as it was. Growth: capacity doubles at len + 1 > capacity / 2 (fresh array, rehash keeping tags, old array freed).
import "ghost_table.caspien"

@gt_register
@pub
func gt_register(ptr: raw imut u8) imut bool{
	if ptr == null{
		return imut true
	}
	let ok = mut true
	match @lock ghost_table{
		OPEN:{
			let addr = mut gtAddrOf(ptr)
			let at = mut gtT1Find(ghost_table.base, ghost_table.capacity, addr)
			if at == ghost_table.capacity{
				if (ghost_table.len + 1) * 2 > ghost_table.capacity{
					let newCapacity = mut (ghost_table.capacity * 2)
					let:<raw mut u8> newBase = null
					unsafe extern{
						newBase = mut realloc(null, newCapacity * 8)
					}
					if newBase == null{
						ok = mut false
					}
					else{
						gtClear(newBase, newCapacity)
						gtT1Rehash(ghost_table.base, ghost_table.capacity, newBase, newCapacity)
						unsafe extern{
							free(ghost_table.base)
						}
						ghost_table.base = mut newBase
						ghost_table.capacity = mut newCapacity
					}
				}
				if ok{
					gtT1Insert(ghost_table.base, ghost_table.capacity, addr)
					ghost_table.len = mut (ghost_table.len + 1)
				}
			}
		}
		CLOSED:{
			continue
		}
	}
	return imut ok
}
