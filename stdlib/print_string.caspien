// print / println for a String (see print.caspien for the other types). Separate file because String allocates, so any program that
// imports it must define the `gt_*` runtime functions; a program that only prints text and numbers imports print.caspien alone.
// A String is written one character at a time with `putchar`.
import "print.caspien"
import "string.caspien"

// The parameter is a plain (nullable) `ref`, not `ref some`: every character goes out through an `unsafe extern` call, and an extern call
// ends the alive proof of a `ref some` parameter, so the String is re-matched on each character instead. A null prints `null`, so a missing String is visible.
@pub
func print(s: ref imut String) void{
	let n = mut 0
	let present = mut false
	match Some(s){
		present = true
		n = len(s.chars.backing)
	}
	if !present{
		print("null")
		return
	}
	// The characters are copied into a scratch buffer first (no extern call in that loop, so `s` stays proven alive), then written from it.
	let:<raw mut u8> buf = null
	unsafe extern{
		buf = malloc(n + 1)
	}
	if buf == null{
		for k in 0..n{
			match Some(s){
				match k in s.chars.backing{
					let c = mut s.chars.backing[k]
					unsafe extern{
						put_char(c)
					}
				}
			}
		}
		return
	}
	match Some(s){
		for k in 0..n{
			match k in s.chars.backing{
				let c = mut s.chars.backing[k]
				let q = mut (buf + k)
				unsafe memcopy raw{
					memcopy(q, mut 1, raw c)
				}
			}
		}
	}
	for k in 0..n{
		let q = mut (buf + k)
		let c = mut ' '
		unsafe memcopy raw{
			memcopy(raw c, mut 1, q)
		}
		unsafe extern{
			put_char(c)
		}
	}
	unsafe extern{
		free(buf)
	}
	return
}

@pub
func println(x: ref imut String) void{
	print(x)
	printNewline()
	return
}

