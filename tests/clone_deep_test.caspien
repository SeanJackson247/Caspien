// clone(p) is a deep copy: every 'owns' member (and dynarray element) reachable from p is cloned too, and each new
// allocation is registered with the ghost table. Expected values: worked out in Python from the initial values below.
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
struct Pair{
	@pub{ a: mut u64
	b: mut u64 }
}
struct Outer{
	@pub{ x: mut u64
	inner: owns some mut Pair }
}
struct Top{
	@pub{ y: mut u64
	mid: owns some mut Outer }
}
func check(name: static imut string, got: imut u64, want: imut u64) mut u64{
	if got == want{
		unsafe extern{ printf("PASS %s\n", name) }
		return 0
	}
	unsafe extern{ printf("FAIL %s got %llu want %llu\n", name, got, want) }
	return 1
}
func main() void{
	let fails = mut 0
	try{
		?catch(e){
			unsafe extern{ printf("FAIL caught %s\n", e.msg) }
			return
		}
		let ip = mut ?new Pair{a= 7, b= 9}
		let o = mut ?new Outer{x= 5, inner= ip}
		let c = mut ?clone(o)
		c.x = 50
		c.inner.a = 70
		fails += check("orig x", o.x, 5)
		fails += check("orig inner.a", o.inner.a, 7)
		fails += check("orig inner.b", o.inner.b, 9)
		fails += check("copy x", c.x, 50)
		fails += check("copy inner.a", c.inner.a, 70)
		fails += check("copy inner.b", c.inner.b, 9)

		let ip2 = mut ?new Pair{a= 1, b= 2}
		let o2 = mut ?new Outer{x= 3, inner= ip2}
		let t = mut ?new Top{y= 4, mid= o2}
		let tc = mut ?clone(t)
		tc.mid.inner.b = 22
		fails += check("three-level orig b", t.mid.inner.b, 2)
		fails += check("three-level copy b", tc.mid.inner.b, 22)
		fails += check("three-level copy y", tc.y, 4)

		let row = mut ?dyn([mut 1, mut 2, mut 3])
		let rc = mut ?clone(row)
		let o1 = mut 0
		let c1 = mut 0
		match 1 into rc{ rc[1] = 20 }
		match 1 in row{ o1 = row[1] }
		match 1 in rc{ c1 = rc[1] }
		fails += check("dyn len", len(rc), 3)
		fails += check("dyn orig", o1, 2)
		fails += check("dyn copy", c1, 20)

		let d1 = mut ?new Pair{a= 1, b= 2}
		let d2 = mut ?new Pair{a= 3, b= 4}
		let ptrs = mut ?dyn([d1, d2])
		let pc = mut ?clone(ptrs)
		let origA = mut 0
		let copyA = mut 0
		let copyB = mut 0
		match 1 in pc{
			let q = mut pc[1]
			q.a = 30
			copyA = q.a
			copyB = q.b
		}
		match 1 in ptrs{
			let r = mut ptrs[1]
			origA = r.a
		}
		fails += check("dyn of owns len", len(pc), 2)
		fails += check("dyn of owns orig a", origA, 3)
		fails += check("dyn of owns copy a", copyA, 30)
		fails += check("dyn of owns copy b", copyB, 4)
	}
	unsafe extern{ printf("done fails=%llu\n", fails) }
}
