					assume match d[7].a4 : finite
					assume match d[7].a4*3.0 : finite
					assume match s : finite
					s = s + d[7].a4 * 3.0
					assume match d[5].a1 : finite
					assume match d[5].a1*7.0 : finite
					assume match s : finite
					s = s + d[5].a1 * 7.0
				}
			}
		}
		return s
	}
}

@untyped
struct S_f64_7{@pub{
	a0: mut f64
	a1: mut f64
	a2: mut f64
	a3: mut f64
	a4: mut f64
	a5: mut f64
	a6: mut f64
}}

@dont(inline)
func S_f64_7_udyn(n: mut u64) mut f64{
	unsafe assume udyn{
		let d = mut unsafe dyn:<S_f64_7>([])
		d = resize(d, n)
		let:<mut f64> fi = mut 0.0
		@dont(unroll)
		for i in 0..n{
			assume match fi : finite
			fi = fi + 1.0
			assume match fi : finite
			assume match fi*1.0 : finite
			d[i].a0 = fi * 1.0
			assume match fi*2.0 : finite
			d[i].a1 = fi * 2.0
			assume match fi*3.0 : finite
			d[i].a2 = fi * 3.0
			assume match fi*4.0 : finite
			d[i].a3 = fi * 4.0
			assume match fi*5.0 : finite
			d[i].a4 = fi * 5.0
			assume match fi*6.0 : finite
			d[i].a5 = fi * 6.0
			assume match fi*7.0 : finite
			d[i].a6 = fi * 7.0
		}
		let:<mut f64> fj = mut 0.0
		@dont(unroll)
		for i in 0..n{
			assume match fj : finite
			fj = fj + 1.0
			assume match fj : finite
			assume match fj+100.0 : finite
			d[i].a6 = fj + 100.0
		}
		let:<mut f64> s = mut 0.0
		@dont(unroll)
		for i in 0..n{
			assume match d[i].a0 : finite
			assume match d[i].a0*1.0 : finite
			assume match s : finite
			s = s + d[i].a0 * 1.0
			assume match d[i].a1 : finite
			assume match d[i].a1*2.0 : finite
			assume match s : finite
			s = s + d[i].a1 * 2.0
			assume match d[i].a2 : finite
			assume match d[i].a2*3.0 : finite
			assume match s : finite
			s = s + d[i].a2 * 3.0
			assume match d[i].a3 : finite
			assume match d[i].a3*4.0 : finite
			assume match s : finite
			s = s + d[i].a3 * 4.0
			assume match d[i].a4 : finite
			assume match d[i].a4*5.0 : finite
			assume match s : finite
			s = s + d[i].a4 * 5.0
			assume match d[i].a5 : finite
			assume match d[i].a5*6.0 : finite
			assume match s : finite
			s = s + d[i].a5 * 6.0
			assume match d[i].a6 : finite
			assume match d[i].a6*7.0 : finite
			assume match s : finite
			s = s + d[i].a6 * 7.0
		}
		assume match d[2].a0 : finite
		assume match d[2].a0*1.0 : finite
		assume match s : finite
		s = s + d[2].a0 * 1.0
		assume match d[7].a6 : finite
		assume match d[7].a6*3.0 : finite
		assume match s : finite
		s = s + d[7].a6 * 3.0
		assume match d[5].a1 : finite
		assume match d[5].a1*7.0 : finite
		assume match s : finite
		s = s + d[5].a1 * 7.0
		return s
	}
}

@dont(inline)
func S_f64_7_safe(n: mut u64) mut f64{
	?catch(e){ return 0.0 }
	unsafe assume{
		let zero = mut S_f64_7{a0= 0.0, a1= 0.0, a2= 0.0, a3= 0.0, a4= 0.0, a5= 0.0, a6= 0.0}
		let d = mut ? dyn:<S_f64_7>([])
		d = ? resize(d, n, zero)
		let:<mut f64> fi = mut 0.0
		@dont(unroll)
		for i in 0..n{
			assume match fi : finite
			fi = fi + 1.0
			assume match fi : finite
			match i into d{
				assume match fi*1.0 : finite
				d[i].a0 = fi * 1.0
				assume match fi*2.0 : finite
				d[i].a1 = fi * 2.0
				assume match fi*3.0 : finite
				d[i].a2 = fi * 3.0
				assume match fi*4.0 : finite
				d[i].a3 = fi * 4.0
				assume match fi*5.0 : finite
				d[i].a4 = fi * 5.0
				assume match fi*6.0 : finite
				d[i].a5 = fi * 6.0
				assume match fi*7.0 : finite
				d[i].a6 = fi * 7.0
			}
		}
		let:<mut f64> fj = mut 0.0
		@dont(unroll)
		for i in 0..n{
			assume match fj : finite
			fj = fj + 1.0
			assume match fj : finite
			match i into d{
				assume match fj+100.0 : finite
				d[i].a6 = fj + 100.0
			}
		}
		let:<mut f64> s = mut 0.0
		@dont(unroll)
		for i in 0..n{
			match i in d{
				assume match d[i].a0 : finite
				assume match d[i].a0*1.0 : finite
				assume match s : finite
				s = s + d[i].a0 * 1.0
				assume match d[i].a1 : finite
				assume match d[i].a1*2.0 : finite
				assume match s : finite
				s = s + d[i].a1 * 2.0
				assume match d[i].a2 : finite
				assume match d[i].a2*3.0 : finite
				assume match s : finite
				s = s + d[i].a2 * 3.0
				assume match d[i].a3 : finite
				assume match d[i].a3*4.0 : finite
				assume match s : finite
				s = s + d[i].a3 * 4.0
				assume match d[i].a4 : finite
				assume match d[i].a4*5.0 : finite
				assume match s : finite
				s = s + d[i].a4 * 5.0
				assume match d[i].a5 : finite
				assume match d[i].a5*6.0 : finite
				assume match s : finite
				s = s + d[i].a5 * 6.0
				assume match d[i].a6 : finite
				assume match d[i].a6*7.0 : finite
				assume match s : finite
				s = s + d[i].a6 * 7.0
			}
		}
		match 2 in d{
			match 5 in d{
				match 7 in d{
					assume match d[2].a0 : finite
					assume match d[2].a0*1.0 : finite
					assume match s : finite
					s = s + d[2].a0 * 1.0
					assume match d[7].a6 : finite
					assume match d[7].a6*3.0 : finite
					assume match s : finite
					s = s + d[7].a6 * 3.0
					assume match d[5].a1 : finite
					assume match d[5].a1*7.0 : finite
					assume match s : finite
					s = s + d[5].a1 * 7.0
				}
			}
		}
		return s
	}
}

func main() void{
	check("S_u8_3_udyn", S_u8_3_udyn(9), 5014)
	check("S_u8_3_safe", S_u8_3_safe(9), 5014)
	check("S_u8_5_udyn", S_u8_5_udyn(9), 12241)
	check("S_u8_5_safe", S_u8_5_safe(9), 12241)
	check("S_u16_3_udyn", S_u16_3_udyn(9), 6550)
	check("S_u16_3_safe", S_u16_3_safe(9), 6550)
	check("S_u16_7_udyn", S_u16_7_udyn(9), 38896)
	check("S_u16_7_safe", S_u16_7_safe(9), 38896)
	check("S_u32_3_udyn", S_u32_3_udyn(9), 6550)
	check("S_u32_3_safe", S_u32_3_safe(9), 6550)
	check("S_u32_5_udyn", S_u32_5_udyn(9), 18385)
	check("S_u32_5_safe", S_u32_5_safe(9), 18385)
	check("S_u64_3_udyn", S_u64_3_udyn(9), 6550)
	check("S_u64_3_safe", S_u64_3_safe(9), 6550)
	check("S_u64_7_udyn", S_u64_7_udyn(9), 38896)
	check("S_u64_7_safe", S_u64_7_safe(9), 38896)
	checkf32("S_f32_3_udyn", S_f32_3_udyn(9), 3471.0)
	checkf32("S_f32_3_safe", S_f32_3_safe(9), 3471.0)
	checkf32("S_f32_5_udyn", S_f32_5_udyn(9), 6486.0)
	checkf32("S_f32_5_safe", S_f32_5_safe(9), 6486.0)
	checkf64("S_f64_3_udyn", S_f64_3_udyn(9), 3471.0)
	checkf64("S_f64_3_safe", S_f64_3_safe(9), 3471.0)
	checkf64("S_f64_5_udyn", S_f64_5_udyn(9), 6486.0)
	checkf64("S_f64_5_safe", S_f64_5_safe(9), 6486.0)
	checkf64("S_f64_7_udyn", S_f64_7_udyn(9), 11121.0)
	checkf64("S_f64_7_safe", S_f64_7_safe(9), 11121.0)
	return
}
