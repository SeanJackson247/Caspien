	check("sel_u32_NEQ", sel_u32_NEQ(300) == 3865470623250)
	check("sel_u32_LT", sel_u32_LT(300) == 12884944071)
	check("sel_u32_LE", sel_u32_LE(300) == 12884944071)
	check("sel_u32_GT", sel_u32_GT(300) == 3852585710679)
	check("sel_u32_GE", sel_u32_GE(300) == 3852585710679)
	check("sel_u64_EQ", sel_u64_EQ(300) == 31500)
	check("sel_u64_NEQ", sel_u64_NEQ(300) == 3865470623250)
	check("sel_u64_LT", sel_u64_LT(300) == 12884933323)
	check("sel_u64_LE", sel_u64_LE(300) == 12884933323)
	check("sel_u64_GT", sel_u64_GT(300) == 3852585721427)
	check("sel_u64_GE", sel_u64_GE(300) == 3852585721427)
	check("sel_s8_EQ", sel_s8_EQ(300) == 25769835280)
	check("sel_s8_NEQ", sel_s8_NEQ(300) == 3839700819470)
	check("sel_s8_LT", sel_s8_LT(300) == 3466038651977)
	check("sel_s8_LE", sel_s8_LE(300) == 3491808455757)
	check("sel_s8_GT", sel_s8_GT(300) == 373662198993)
	check("sel_s8_GE", sel_s8_GE(300) == 399432002773)
	check("sel_s16_EQ", sel_s16_EQ(300) == 31500)
	check("sel_s16_NEQ", sel_s16_NEQ(300) == 3865470623250)
	check("sel_s16_LT", sel_s16_LT(300) == 1932735327973)
	check("sel_s16_LE", sel_s16_LE(300) == 1932735327973)
	check("sel_s16_GT", sel_s16_GT(300) == 1932735326777)
	check("sel_s16_GE", sel_s16_GE(300) == 1932735326777)
	check("sel_s32_EQ", sel_s32_EQ(300) == 31500)
	check("sel_s32_NEQ", sel_s32_NEQ(300) == 3865470623250)
	check("sel_s32_LT", sel_s32_LT(300) == 1662152391263)
	check("sel_s32_LE", sel_s32_LE(300) == 1662152391263)
	check("sel_s32_GT", sel_s32_GT(300) == 2203318263487)
	check("sel_s32_GE", sel_s32_GE(300) == 2203318263487)
	check("sel_s64_EQ", sel_s64_EQ(300) == 31500)
	check("sel_s64_NEQ", sel_s64_NEQ(300) == 3865470623250)
	check("sel_s64_LT", sel_s64_LT(300) == 12884933323)
	check("sel_s64_LE", sel_s64_LE(300) == 12884933323)
	check("sel_s64_GT", sel_s64_GT(300) == 3852585721427)
	check("sel_s64_GE", sel_s64_GE(300) == 3852585721427)
	check("clamp_0", clamp(0) == 0)
	check("maxmin_0", maxmin(0) == 0)
	check("narrowdst_0", narrowdst(0) == 0)
	check("clamp_1", clamp(1) == 3)
	check("maxmin_1", maxmin(1) == 125)
	check("narrowdst_1", narrowdst(1) == 97)
	check("clamp_27", clamp(27) == 211)
