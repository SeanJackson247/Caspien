func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

@dont(inline)
func sel_u8_EQ(n: mut u64) mut u64{
	let s = mut 0
	for i in 0..n{
		let:<mut u8> x = mut wrap:<u8>(i * 37 + 11)
		let:<mut u8> y = mut wrap:<u8>(i * 29 + 200)
		let r = mut 100
		if x == y{ r = i }
		let q = mut 0
		if x == y{
			q = 11
		}
		else{
			q = 0
		}
		let w = mut 5
		if x == 100{ w = 12884901895 }
		s = s + r + q * 3 + w
	}
	return s
}

