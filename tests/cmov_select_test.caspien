@dont(inline)
func clamp(n: mut u64) mut u64{
	let s = mut 0
	for i in 0..n{
		let v = mut ((i * 7) % 23)
		if v > 10{ v = 10 }
		if v < 3{ v = 3 }
		s = s + v
	}
	return s
}

@dont(inline)
func maxmin(n: mut u64) mut u64{
	let s = mut 0
	for i in 0..n{
		let a = mut ((i * 31 + 5) % 97)
		let b = mut ((i * 17 + 40) % 89)
		let mx = mut 0
		let mn = mut 0
		if a > b{
			mx = a
		}
		else{
			mx = b
		}
		if a > b{
			mn = b
		}
		else{
			mn = a
		}
		s = s + mx * 3 + mn
	}
	return s
}

@dont(inline)
func narrowdst(n: mut u64) mut u64{
	let s = mut 0
	for i in 0..n{
		let r = mut ((i * 13) % 27)
		let:<mut u8> ch = mut wrap:<u8>(97 + r)
		if r == 26{
			ch = 32
		}
		s = s + wrap:<u64>(ch)
	}
	return s
}

func main() void{
	check("sel_u8_EQ", sel_u8_EQ(300) == 25769835280)
	check("sel_u8_NEQ", sel_u8_NEQ(300) == 3839700819470)
	check("sel_u8_LT", sel_u8_LT(300) == 1533303368329)
	check("sel_u8_LE", sel_u8_LE(300) == 1559073172109)
	check("sel_u8_GT", sel_u8_GT(300) == 2306397482641)
	check("sel_u8_GE", sel_u8_GE(300) == 2332167286421)
	check("sel_u16_EQ", sel_u16_EQ(300) == 31500)
	check("sel_u16_NEQ", sel_u16_NEQ(300) == 3865470623250)
