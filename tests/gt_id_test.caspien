// The id ghost table (stdlib/, design E) driven directly with 60000 pseudo-random register / moved / alive_check / ref_id / ref_resolve
// operations on 3000 synthetic addresses (16 bytes apart inside one malloc'd region), checked against a model kept in the program (is the address
// registered; the id it was given in this registration, if any), then drained. tests/gt_id_model.py replays the same sequence in Python
// (sets and dicts, ids numbered 1, 2, 3, ...) and gives the expected counts in the EXPECT line.
// Prints one PASS/FAIL line per check and `ALL GT ID TESTS PASSED`.
// EXPECT hits=5220 refs=5245 idsum=7128317 live=1485 issued=2972 resolved=2406 dead=9710
import "../stdlib/libc.caspien"
import "../stdlib/gt_init.caspien"
import "../stdlib/gt_register.caspien"
import "../stdlib/gt_alive_check.caspien"
import "../stdlib/gt_destruct.caspien"
import "../stdlib/gt_moved.caspien"
import "../stdlib/gt_ref_id.caspien"
import "../stdlib/gt_ref_resolve.caspien"

struct Pair{@pub{
	a: mut u64
	b: mut u64
}}

func check(name: static imut string, got: mut u64, want: mut u64) mut u64{
	let failed = mut 0
	unsafe extern{
		if got == want{
			printf("PASS %s\n", name)
		}else{
			printf("FAIL %s got %llu want %llu\n", name, got, want)
			failed = 1
		}
	}
	return failed
}

func live() mut u64{
	let n = mut 0
	unsafe assume{
		assume match ghost_table.lockState : OPEN
		n = mut ghost_table.len
	}
	return n
}

func idLive() mut u64{
	let n = mut 0
	unsafe assume{
		assume match ghost_table.lockState : OPEN
		n = mut (ghost_table.refLen + ghost_table.idLen * 1000000)
	}
	return n
}

func issued() mut u64{
	let n = mut 0
	unsafe assume{
		assume match ghost_table.lockState : OPEN
		n = mut ghost_table.nextId
	}
	return n
}

func main() void{
	?catch(e){
		unsafe extern{ printf("FAIL out of memory\n") }
		return
	}
	let anchor = mut ?new Pair{a= 1, b= 2}
	let fails = mut 0
	let:<raw mut u8> region = null
	unsafe extern{ region = mut malloc(mut 65536) }
	let inModel = mut ?dyn([mut 0, mut 0])
	inModel = ?resize(inModel, 3000, 0)
	let idModel = mut ?dyn([mut 0, mut 0])
	idModel = ?resize(idModel, 3000, 0)
	let lastId = mut ?dyn([mut 0, mut 0])
	lastId = ?resize(lastId, 3000, 0)
	let base = mut live()
	let seed = mut 12345
	let hits = mut 0
	let refs = mut 0
	let idsum = mut 0
	let wrong = mut 0
	let refused = mut 0
	let resolved = mut 0
	let dead = mut 0
	for step in 0..60000{
		seed = mut bits_and(seed * 1103515245 + 12345, 2147483647)
		let k = mut (bits_right(seed, 8) % 3000)
		let op = mut (seed % 5)
		let p = mut (region + k * 16)
		match k in inModel{
		match k in idModel{
		match k in lastId{
			let have = mut inModel[k]
			if op == 0{
				let ok = gt_register(p)
				if !ok{ refused += 1 }
				match k into inModel{ inModel[k] = 1 }
			}
			if op == 1{
				gt_moved(p)
				match k into inModel{ inModel[k] = 0 }
				match k into idModel{ idModel[k] = 0 }
			}
			if op == 2{
				let alive = gt_alive_check(p)
				if alive{ hits += 1 }
				if alive && have == 0{ wrong += 1 }
				if !alive && have == 1{ wrong += 1 }
			}
			if op == 3{
				let id = mut gt_ref_id(p)
				if have == 0{
					if id != 0{ wrong += 1 }
				}
				else{
					if id == 0{ wrong += 1 }
					refs += 1
					idsum += id
					if idModel[k] == 0{
						match k into idModel{ idModel[k] = id }
					}
					else{
						if idModel[k] != id{ wrong += 1 }
					}
					match k into lastId{ lastId[k] = id }
				}
			}
			if op == 4{
				let q = mut gt_ref_resolve(lastId[k])
				if q == null{
					dead += 1
					if have == 1 && idModel[k] == lastId[k] && lastId[k] != 0{ wrong += 1 }
				}
				else{
					resolved += 1
					if q != p{ wrong += 1 }
					if have == 0{ wrong += 1 }
				}
			}
		}
		}
		}
	}
	fails += check("alive/ref answers match the model", wrong, 0)
	fails += check("no registration refused", refused, 0)
	fails += check("alive hits", hits, 5220)
	fails += check("ref_id calls on registered addresses", refs, 5245)
	fails += check("sum of the ids returned", idsum, 7128317)
	fails += check("resolve hits", resolved, 2406)
	fails += check("resolve misses", dead, 9710)
	let stored = mut 0
	let withId = mut 0
	for k in 0..3000{
		match k in inModel{ stored += inModel[k] }
		match k in idModel{
			if idModel[k] != 0{ withId += 1 }
		}
	}
	fails += check("len equals the model", live() - base, stored)
	fails += check("final len", live() - base, 1485)
	fails += check("ids issued", issued(), 2972)
	fails += check("T2 and T3 hold exactly the objects with an id", idLive(), withId + withId * 1000000)
	let zero = mut gt_ref_resolve(0)
	let nothing = mut 0
	if zero == null{ nothing = 1 }
	fails += check("id 0 resolves to null", nothing, 1)
	let huge = mut gt_ref_resolve(999999999)
	let none2 = mut 0
	if huge == null{ none2 = 1 }
	fails += check("an id never issued resolves to null", none2, 1)
	for k in 0..3000{
		let p = mut (region + k * 16)
		gt_moved(p)
	}
	fails += check("drained back to the baseline", live(), base)
	fails += check("T2 and T3 empty after the drain", idLive(), 0)
	let stillThere = mut 0
	match Some(anchor){ stillThere = anchor.a }
	fails += check("the real allocation survived", stillThere, 1)
	unsafe extern{ free(region) }
	if fails == 0{
		unsafe extern{ printf("ALL GT ID TESTS PASSED\n") }
	}
}
