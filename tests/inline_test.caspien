// Regression test for function inlining (`function-inlining: off|conservative|balanced|aggressive`).
// Every function has a hand-computed expected value, so a wrong copy, a wrong evaluation order, a name clash between an inlined
// local and a caller local, or a broken multi-return shows up as a FAIL. The output must be identical with inlining off and on
// (at every preset, and together with the other optimizer switches).
import "../stdlib/libc.caspien"
import "../stdlib/gt_init.caspien"
import "../stdlib/gt_register.caspien"
import "../stdlib/gt_alive_check.caspien"
import "../stdlib/gt_destruct.caspien"
import "../stdlib/gt_moved.caspien"

let static tickCount = mut 0

struct Pair{
	@pub{
		a: mut u64
		b: mut u64
	}
}

struct Cell{
	@pub{
		n: mut u64
		w: mut u8
	}
}

func check(name: static imut string, ok: mut bool) void{
	unsafe extern{
		if ok{
			printf("PASS %s\n", name)
		}else{
			printf("FAIL %s\n", name)
		}
	}
	return
}

// ---- plain scalar functions ----
func sq(x: mut u64) mut u64{
	return x * x
}
func addTwo(a: mut u64, b: mut u64) mut u64{
	return a + b
}
func sub3(a: mut u64, b: mut u64, c: mut u64) mut u64{
	return a - b - c
}
func absdiff(a: mut u64, b: mut u64) mut u64{
	if a > b{
		return a - b
	}
	return b - a
}
func isEven(x: mut u64) mut bool{
	return x % 2 == 0
}
func low8(x: mut u64) mut u8{
	return wrap:<u8>(x)
}
func sdiff(a: mut s64, b: mut s64) mut s64{
	return a - b
}
func firstChar(a: mut char, b: mut char, useFirst: mut bool) mut char{
	if useFirst{
		return a
	}
	return b
}
func fmix(a: mut f32, b: mut f32) mut f32{
	unsafe assume{
		assume match a : finite
		assume match b : finite
		assume match a*b : finite
		return a * b + 0.5
	}
}

// ---- name clashes and modified parameters ----
func clash(x: mut u64) mut u64{
	let y = mut (x + 1)
	let z = mut (y * 2)
	return z
}
func dec2(x: mut u64) mut u64{
	x = x - 2
	return x
}

// ---- chains ----
func d1(x: mut u64) mut u64{
	return x + 1
}
func c1(x: mut u64) mut u64{
	return d1(x) * 2
}
func b1(x: mut u64) mut u64{
	return c1(x) + d1(x)
}
func a1(x: mut u64) mut u64{
	return b1(sq(x))
}

// ---- loops in the callee ----
func sumTo(n: mut u64) mut u64{
	let s = mut 0
	for i in 0..n{
		s += i
	}
	return s
}
func firstOver(limit: mut u64) mut u64{
	let i = mut 0
	for j in 0..1000{
		if j * j > limit{
			return j
		}
		i += 1
	}
	return i
}

// ---- side effects: evaluation order of the arguments ----
func tick() mut u64{
	unsafe global{
		tickCount = tickCount + 1
		return tickCount
	}
}

// ---- void functions, early return, pointer arguments ----
func addInto(p: auto mut Pair, d: mut u64) void{
	p.a += d
	if d > 100{
		return
	}
	p.b += d
	return
}
func narrowBump(c: auto mut Cell) void{
	c.n = c.n + 1
	c.w = c.w + 200
	return
}

// ---- a struct returned by value ----
func mkPair(a: mut u64, b: mut u64) Pair{
	return Pair{a:a,b:b}
}

// ---- a recursive function (turned into a loop before optimisation; the range shrinks by two per step) ----
@recursive
func addto(n: mut u64, acc: mut u64, r: imut range) mut u64{
	match r is base{
		return acc
	}
	let lo = mut (r.start + 1)
	let hi = mut (r.end - 1)
	let r2 = imut (lo..hi)
	match r2 within r{
		return addto(n - 1, acc + n, r2)
	}
	else{
		return acc
	}
}

// a callee that calls something and ignores the result leaves that result word on the operand stack; run inline in the middle of an
// expression (`t += noisy(1)`) it must not upset the operands pending beneath it (found by the stdlib test, first at aggressive)
func noisy(x: mut u64) mut u64{
	unsafe extern{ putchar(46) }
	return x + 1
}

func main() void{
	let ok = mut true

	check("sq", sq(7) == 49)
	check("two args", addTwo(20, 22) == 42)
	check("three args", sub3(100, 30, 12) == 58)
	check("nested calls", addTwo(sq(3), sq(4)) == 25)
	check("call in expression", 5 + sq(6) == 41)
	check("call as condition", sq(3) == 9)
	check("absdiff a<b", absdiff(3, 10) == 7)
	check("absdiff a>b", absdiff(10, 3) == 7)
	check("absdiff equal", absdiff(4, 4) == 0)
	check("bool result", isEven(10))
	check("bool result false", !isEven(7))
	check("u8 result wraps", low8(300) == 44)
	check("s64 negative result", sdiff(3, 10) == -7)
	check("char select first", firstChar('x', 'y', true) == 'x')
	check("char select second", firstChar('x', 'y', false) == 'y')
	unsafe assume{
		assume match fmix(2.0,3.0) : finite
		ok = fmix(2.0, 3.0) == 6.5
	}
	check("f32 result", ok)

	// caller variables with the same names the callee uses
	let x = mut 10
	let y = mut 20
	let z = mut 30
	let c = mut clash(x)
	check("clash result", c == 22)
	check("caller x kept", x == 10)
	check("caller y kept", y == 20)
	check("caller z kept", z == 30)
	let v = mut 10
	let w = mut dec2(v)
	check("param modified, result", w == 8)
	check("param modified, caller value kept", v == 10)

	// chains: a1(3) = b1(9) = c1(9) + d1(9) = (10*2) + 10 = 30
	check("chain of four", a1(3) == 30)

	// loops inside the callee, several copies in one function
	check("loop callee", sumTo(5) == 10)
	check("loop callee twice", sumTo(4) + sumTo(6) == 21)
	check("loop callee with return in loop", firstOver(50) == 8)
	let acc = mut 0
	for i in 0..5{
		acc += sumTo(i)
	}
	check("loop callee called in a loop", acc == 0 + 0 + 1 + 3 + 6)
	let acc2 = mut 0
	for i in 0..6{
		acc2 += absdiff(i, 3)
	}
	check("branching callee called in a loop", acc2 == 3 + 2 + 1 + 0 + 1 + 2)

	// evaluation order of arguments with side effects: tick() gives 1, then 2
	let e = mut addTwo(tick(), tick() * 10)
	check("argument order", e == 21)
	unsafe global{
		ok = tickCount == 2
	}
	check("tick count", ok)

	// void callees
	let p = mut Pair{a= 1, b= 2}
	addInto(auto p, 5)
	check("void callee a", p.a == 6)
	check("void callee b", p.b == 7)
	addInto(auto p, 1000)
	check("void early return a", p.a == 1006)
	check("void early return b unchanged", p.b == 7)
	let cell = mut Cell{n= 4, w= 100}
	narrowBump(auto cell)
	narrowBump(auto cell)
	check("narrow field n", cell.n == 6)
	check("narrow field wraps", cell.w == 244)
	let q = mut Pair{a= 0, b= 0}
	for i in 0..4{
		addInto(auto q, i)
	}
	check("void callee in a loop a", q.a == 6)
	check("void callee in a loop b", q.b == 6)

	// struct by value
	let pr = mut mkPair(3, 4)
	check("struct result a", pr.a == 3)
	check("struct result b", pr.b == 4)
	let pr2 = mut mkPair(sq(2), addTwo(5, 6))
	check("struct result with call arguments", pr2.a == 4 && pr2.b == 11)

	// recursion: 10 + 9 + 8 + 7 + 6
	let rr = imut (0..10)
	let total = mut addto(mut 10, mut 0, rr)
	check("recursive function", total == 40)
	let rr2 = imut (0..4)
	let total2 = mut addto(mut 3, mut 100, rr2)
	check("recursive function, second call", total2 == 105)

	let nz = mut 5
	nz += noisy(1)
	unsafe extern{ putchar(10) }
	check("ignored call result inside an inlined callee, mid-expression", nz == 7)
	let nz2 = mut (noisy(2) + noisy(3))
	unsafe extern{ putchar(10) }
	check("two such callees in one expression", nz2 == 7)
	return
}
