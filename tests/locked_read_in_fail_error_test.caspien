// Must fail: payload read inside the FAIL case.
import "../stdlib/libc.caspien"
enum ResultState{ OK, FAIL }
@lock(match self.state : OK)
struct Result<T>{@pub{
	state: imut ResultState
	payload: mut T
}}
func main() void{
	let a = mut Result:<u64>{state= ResultState.FAIL}
	match a.state{
		OK:{ }
		FAIL:{ let x = mut a.payload }
	}
}
