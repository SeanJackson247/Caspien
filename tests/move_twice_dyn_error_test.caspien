// The same owns variable twice in one dyn([..]) literal would give two owners of one block: an error.
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
struct World{@pub{
	ticks: mut u64
}}
struct Two{@pub{
	p: owns some mut World
	q: owns some mut World
}}
func main() void{
	?catch(e){ return }
	let a = mut ? new World{ticks= 1}
	let d = mut ? dyn([a, a])
}
