// HashSet<T> over HashMap: the same random run as hashmap_remove_test, checked against hashset_test.py.
import "../stdlib/libc.caspien"
import "../stdlib/ref/hash_set.caspien"
import "../stdlib/gt/*"

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

func main() void{
	?catch(e){
		unsafe extern{ printf("FAIL uncaught: %s\n", e.msg) }
		return
	}
	let s = mut ? new HashSet:<u64>(mut 0, mut 16)
	let x = mut 12345
	let added = mut 0
	let removed = mut 0
	let found = mut 0
	for i in 0..20000{
		x = (x * 1103515245 + 12345) % 2147483648
		let op = mut (bits_right(x, 16) % 4)
		let key = mut (bits_right(x, 8) % 5000)
		if op < 2{
			if s.add(s, key){ added = added + 1 }
		}
		else{
			if op == 2{
				if s.remove(s, key){ removed = removed + 1 }
			}
			else{
				if s.contains(s, key){ found = found + 1 }
			}
		}
	}
	check("random run: size", s.size(s) == 3131)
	check("random run: new adds", added == 5409)
	check("random run: removes", removed == 2278)
	check("random run: contains", found == 2251)

	let t = mut ? new HashSet:<u8>(mut 0, mut 4)
	check("add new", t.add(t, mut 7))
	check("add again", !t.add(t, mut 7))
	check("contains", t.contains(t, mut 7) && !t.contains(t, mut 8))
	check("remove", t.remove(t, mut 7) && !t.remove(t, mut 7))
	check("empty again", t.size(t) == 0)
}
