// A lock struct holding an interface-typed owns member compiles when no implementer holds a ref/auto.
import "../stdlib/libc.caspien"
import "../stdlib/gt_init.caspien"
import "../stdlib/gt_register.caspien"
import "../stdlib/gt_alive_check.caspien"
import "../stdlib/gt_destruct.caspien"
import "../stdlib/gt_moved.caspien"
enum Gate{ OPEN, CLOSED }
struct Counter{@pub{ n: mut u64 }}
interface Source{
	get(_self: ref some mut self) mut u64;
}
struct Holder{@pub{ n: mut u64 }}
impl Source for Holder{
	@pub
	@realizes
	func get(_self: ref some mut self) mut u64{
		return 7
	}
}
@lock(match self.gate : OPEN)
struct Slot{@pub{
	swap gate: atomic mut Gate
	src: owns mut Source
}}
let static slot = mut Slot{gate= Gate.OPEN, src= null}
func main() void{
}
