// `self` is a `ref some` parameter too: an `unsafe` block ends its entry proof.
import "../stdlib/libc.caspien"
import "../stdlib/gt_init.caspien"
import "../stdlib/gt_register.caspien"
import "../stdlib/gt_alive_check.caspien"
import "../stdlib/gt_destruct.caspien"
import "../stdlib/gt_moved.caspien"
struct Counter{@pub{ n: mut u64 }}
@pub
impl Counter{
	@pub
	func bump(_self: ref some mut self) void{
		unsafe extern{ printf("bump\n") }
		_self.n = mut (_self.n + 1)
	}
}
func main() void{
	?catch(e){ return }
	let c = mut ?new Counter{n= 0}
	let r = mut ref c
	r.bump(r)
}
