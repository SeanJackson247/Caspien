// A literal index into a dynarray is proven like a variable one: `match 1 in a{ ... }`.
// Expected output: read=2 wrote=9 skipped=0 total=4
import "../stdlib/libc.caspien"
import "../stdlib/gt_init.caspien"
import "../stdlib/gt_register.caspien"
import "../stdlib/gt_alive_check.caspien"
import "../stdlib/gt_destruct.caspien"
func main() void{
	?catch(e){ return }
	let a = mut ? dyn([1, 2, 3])
	let r = mut 0
	let w = mut 0
	let s = mut 0
	let t = mut 0
	match 1 in a{ r = a[1] }
	match 1 into a{ a[1] = 9 }
	match 1 in a{ w = a[1] }
	match 7 in a{ s = a[7] }
	match 0 in a{ t += a[0] }
	match 2 in a{ t += a[2] }
	unsafe{ printf("read=%llu wrote=%llu skipped=%llu total=%llu\n", r, w, s, t) }
}
