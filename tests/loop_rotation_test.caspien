// GENERATED by gen_loop_rotation.py (expected values come from its Python models). Loop shapes that LoopRotationPass copies the exit test of:
// for loops with literal and run-time bounds (including zero trips), nested loops, continue / break / return inside, `unsafe loop` with the exit test
// first (unsigned, narrow u8 and signed counters), a safe dynarray length as the bound. Each line checks the result against the model.
import "../stdlib/libc.caspien"
import "../stdlib/gt_init.caspien"
import "../stdlib/gt_register.caspien"
import "../stdlib/gt_alive_check.caspien"
import "../stdlib/gt_destruct.caspien"
import "../stdlib/gt_moved.caspien"

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

@dont(inline)
func forsum(n: mut u64) mut u64{
	let s = mut 0
	for i in 0..n{
		s += i * i + 1
	}
	return s
}

@dont(inline)
func tri(n: mut u64) mut u64{
	let s = mut 0
	for i in 0..n{
		for j in 0..i{
			s += j + 1
		}
	}
	return s
}

@dont(inline)
func cont(n: mut u64) mut u64{
	let s = mut 0
	for i in 0..n{
		if i % 3 == 0{ continue }
		s += i
	}
	return s
}

@dont(inline)
func brk(n: mut u64) mut u64{
	let r = mut 0
	for i in 0..1000{
		if i * i > n{
			r = i
			break
		}
	}
	return r
}

@dont(inline)
func whileLoop(n: mut u64) mut u64{
	let i = mut 0
	let s = mut 0
	unsafe loop{
		loop{
		if i >= n{ break }
		s += 2 * i + 1
		i += 1
		}
	}
	return s
}

@dont(inline)
func down(k0: mut u64) mut u64{
	let k = mut k0
	let s = mut 0
	unsafe loop{
		loop{
		if k == 0{ break }
		s += k
		k -= 1
		}
	}
	return s
}

@dont(inline)
func narrow(lim: mut u8) mut u64{
	let:<mut u8> c = mut 0
	let cnt = mut 0
	unsafe loop{
		loop{
		if c >= lim{ break }
		cnt += 3
		c = wrap:<u8>(c + 1)
		}
	}
	return cnt
}

@dont(inline)
func signed(start: mut s64) mut u64{
	let x = mut start
	let n = mut 0
	unsafe loop{
		loop{
		if x <= -5{ break }
		x -= 1
		n += 1
		}
	}
	return n
}

@dont(inline)
func find(n: mut u64, t: mut u64) mut u64{
	for i in 0..n{
		if i * 7 % 11 == t{ return i }
	}
	return 9999
}

@dont(inline)
func nest(n: mut u64) mut u64{
	let s = mut 0
	for i in 0..n{
		for j in 0..n{
			if j == i{ continue }
			if j > 5{ break }
			s += 10 * i + j
		}
	}
	return s
}

@dont(inline)
func big(n: mut u64) mut u64{
	let s = mut 0
	for i in 0..n{
		s += i % 7
	}
	return s
}

@dont(inline)
func dynsum(m: mut u64) mut u64{
	?catch(e){ return 7777777 }
	let d = mut ? dyn([3, 1, 4, 1, 5, 9, 2, 6])
	let s = mut 0
	let i = mut 0
	unsafe loop{
		loop{
		if i >= m{ break }
		match i in d{
			s += d[i] * 3
		}
		i += 1
		}
	}
	return s
}

func main() void{
	check("for sum n=0", forsum(0) == 0)
	check("for sum n=1", forsum(1) == 1)
	check("for sum n=2", forsum(2) == 3)
	check("for sum n=7", forsum(7) == 98)
	check("for sum n=100", forsum(100) == 328450)
	check("triangular n=0", tri(0) == 0)
	check("triangular n=1", tri(1) == 0)
	check("triangular n=2", tri(2) == 1)
	check("triangular n=9", tri(9) == 120)
	check("triangular n=40", tri(40) == 10660)
	check("for continue n=0", cont(0) == 0)
	check("for continue n=1", cont(1) == 0)
	check("for continue n=3", cont(3) == 3)
	check("for continue n=10", cont(10) == 27)
	check("for continue n=61", cont(61) == 1200)
	check("for break n=0", brk(0) == 1)
	check("for break n=1", brk(1) == 2)
	check("for break n=2", brk(2) == 2)
	check("for break n=50", brk(50) == 8)
	check("for break n=998001", brk(998001) == 0)
	check("while-style n=0", whileLoop(0) == 0)
	check("while-style n=1", whileLoop(1) == 1)
	check("while-style n=2", whileLoop(2) == 4)
	check("while-style n=50", whileLoop(50) == 2500)
	check("countdown k=0", down(0) == 0)
	check("countdown k=1", down(1) == 1)
	check("countdown k=10", down(10) == 55)
	check("countdown k=1000", down(1000) == 500500)
	check("u8 counter lim=0", narrow(0) == 0)
	check("u8 counter lim=1", narrow(1) == 3)
	check("u8 counter lim=2", narrow(2) == 6)
	check("u8 counter lim=100", narrow(100) == 300)
	check("u8 counter lim=255", narrow(255) == 765)
	check("signed counter start=10", signed(10) == 15)
	check("signed counter start=0", signed(0) == 5)
	check("signed counter start=-4", signed(-4) == 1)
	check("signed counter start=-5", signed(-5) == 0)
	check("signed counter start=-9", signed(-9) == 0)
	check("return inside n=0 t=3", find(0, 3) == 9999)
	check("return inside n=1 t=0", find(1, 0) == 0)
	check("return inside n=20 t=3", find(20, 3) == 2)
	check("return inside n=20 t=10", find(20, 10) == 3)
	check("return inside n=5 t=10", find(5, 10) == 3)
	check("nested continue/break n=0", nest(0) == 0)
	check("nested continue/break n=1", nest(1) == 0)
	check("nested continue/break n=2", nest(2) == 11)
	check("nested continue/break n=8", nest(8) == 1635)
	check("nested continue/break n=9", nest(9) == 2130)
	check("large trip count n=0", big(0) == 0)
	check("large trip count n=1", big(1) == 0)
	check("large trip count n=3000000", big(3000000) == 8999994)
	check("dynarray bound m=0", dynsum(0) == 0)
	check("dynarray bound m=1", dynsum(1) == 9)
	check("dynarray bound m=5", dynsum(5) == 42)
	check("dynarray bound m=8", dynsum(8) == 93)
}
