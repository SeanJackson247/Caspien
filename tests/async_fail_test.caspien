// `await` and `par` under failure: the handle allocation can fail (out of memory) and the thread can fail to start. Both are
// reported through the `try`/`?` around the call, and nothing is left allocated. Run plainly it prints
// "await=42 par=42"; async_fail_check.sh runs it with a shim that fails each malloc in turn and pthread_create.
import "../stdlib/libc.caspien"
import "../stdlib/gt_init.caspien"
import "../stdlib/gt_register.caspien"
import "../stdlib/gt_alive_check.caspien"
import "../stdlib/gt_destruct.caspien"
import "../stdlib/gt_moved.caspien"
import "../stdlib/par_call.caspien"
import "../stdlib/await_call.caspien"

@async
func triple(x: mut u64) mut u64{
	return x * 3
}

func main() void{
	try{
		?catch(e){
			unsafe extern{ printf("CAUGHT %s\n", e) }
			return
		}
		let a = mut ? await triple(mut 14)
		let h = mut ? par triple(mut 14)
		for i in 0..100000000{
			let ready = mut false
			match h.state{
				READY:{ ready = true }
				default:{ ready = false }
			}
			if ready{ break }
			yield
		}
		let b = mut h.resolve(h)
		unsafe extern{ printf("await=%llu par=%llu\n", a, b) }
	}
}
