func ct_s8() void{
	chk_s8("const and s8 max 0", bits_and(s8Max, 0b0), 0B0000)
	chk_s8("const and s8 0 max", bits_and(0, s8Max), 0x00)
	chk_s8("const and s8 max 1", bits_and(s8Max, 0x001), 0x1)
	chk_s8("const and s8 1 max", bits_and(1, s8Max), 0x1)
	chk_s8("const and s8 max 85", bits_and(s8Max, 0X55), 0b1010101)
	chk_s8("const and s8 85 max", bits_and(0B0101_0101, s8Max), 85)
	chk_s8("const and s8 max -86", bits_and(s8Max, -0x56), 0x002a)
	chk_s8("const and s8 -86 max", bits_and(-0x56, s8Max), 42)
	chk_s8("const and s8 max -16", bits_and(s8Max, -0x10), 0X70)
	chk_s8("const and s8 -16 max", bits_and(-0b10000, s8Max), 0B0111_0000)
	chk_s8("const and s8 max -1", bits_and(s8Max, -1), 0x7F)
	chk_s8("const and s8 -1 max", bits_and(-0x001, s8Max), 0x7f)
	chk_s8("const or s8 max 0", bits_or(s8Max, 0), 0x7f)
	chk_s8("const or s8 0 max", bits_or(0X0, s8Max), 0b1111111)
	chk_s8("const or s8 max 1", bits_or(s8Max, 0B0001), 127)
	chk_s8("const or s8 1 max", bits_or(0x01, s8Max), 0x007f)
