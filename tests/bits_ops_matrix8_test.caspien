	chk_s8("const nested and(xor,or) s8", bits_and(bits_xor(s8Max, 0X55), bits_or(s8Min, -0b10000)), 0B0010_0000)
	chk_s8("const nested not(left) s8", bits_not(bits_left(s8Max, 1)), 1)
	chk_s8("const nested right(left) s8", bits_right(bits_left(s8Max, 3), 2), -0x02)
	chk_s8("const nested xor(not,not) s8", bits_xor(bits_not(s8Max), bits_not(s8Min)), -0x001)
	return
}

