	checkHash("hashOf:<s64> -2", hashOf:<s64>(imut t64), 18165890468499916316)
	t64 = mut -1
	checkHash("hashOf:<s64> -1", hashOf:<s64>(imut t64), 10157053723145373757)
	t64 = mut 0
	checkHash("hashOf:<s64> 0", hashOf:<s64>(imut t64), 12161962213042174405)
	t64 = mut 1
	checkHash("hashOf:<s64> 1", hashOf:<s64>(imut t64), 9929646806074584996)
	t64 = mut 2
