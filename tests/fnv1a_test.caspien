// Tests for stdlib/hash.caspien: real 64-bit FNV-1a. `fnv1a64Bytes` against the published vectors and a Python reference over strings and
// byte patterns of every length class, and `hashOf:<T>` (copy the value's bytes, hash them) for u8 / u16 / u32 / u64 / s32 / s64 values
// against FNV-1a of the value's LITTLE-ENDIAN bytes. A struct cannot be passed to the generic `hashOf` (by-value struct parameter), so
// padding-free structs are hashed through `fnv1a64Bytes` on a copy of their bytes. Also: determinism, and distinct values hash differently.
// GENERATED by tests/fnv1a_gen.py -- every expected value is from that script's Python FNV-1a (the three published vectors
// "" -> 0xcbf29ce484222325, "a" -> 0xaf63dc4c8601ec8c, "foobar" -> 0x85944171f73967e8 are asserted there). Do not edit; edit the generator.
// Prints PASS/FAIL per check and a summary line; the output must be identical with every optimisation switch off and on.
import "../stdlib/libc.caspien"
import "../stdlib/hash.caspien"
import "../stdlib/gt_init.caspien"
import "../stdlib/gt_register.caspien"
import "../stdlib/gt_alive_check.caspien"
import "../stdlib/gt_destruct.caspien"
import "../stdlib/gt_moved.caspien"

let static passed = mut 0
let static failed = mut 0

@pub
struct Pair{@pub{
	a: mut u64
	b: mut u64
}}
@pub
struct Quad{@pub{
	a: mut u32
	b: mut u32
	c: mut u32
	d: mut u32
}}

func check(name: static imut string, ok: mut bool) void{
	unsafe{
		if ok{
			passed++
			printf("PASS %s\n", name)
		}else{
			failed++
			printf("FAIL %s\n", name)
		}
	}
	return
}
func checkHash(name: static imut string, got: mut u64, expected: mut u64) void{
	unsafe{
		if got == expected{
			passed++
			printf("PASS %s\n", name)
		}else{
			failed++
			printf("FAIL %s expected %llx got %llx\n", name, expected, got)
		}
	}
	return
}
// fnv1a64Bytes over the characters of a string literal (copied into a scratch buffer: a literal is not a `raw imut u8`)
func hashStr(s: static imut string) mut u64{
	let h = mut 0
	unsafe{
		let n = mut strlen(s)
		let buf = mut malloc(n + 1)
		memcopy(buf, n, s)
		h = fnv1a64Bytes(buf, n)
		free(buf)
	}
	return h
}
// fnv1a64Bytes over n bytes of the pattern byte(i) = (i * 37 + 11) mod 256
func hashPattern(n: mut u64) mut u64{
	let h = mut 0
	unsafe{
		let buf = mut malloc(n + 1)
		for i in 0..n{
			let v = mut wrap:<u8>(i * 37 + 11)
			memcopy(buf + i, mut 1, raw v)
		}
		h = fnv1a64Bytes(buf, n)
		free(buf)
	}
	return h
}
// the 16 member bytes of a struct (the hidden 8-byte class-id header in front of them is skipped); a struct local is copied
// out of the `auto` pointer first (`raw p` would be the address of the parameter, not of the struct)
func hashPair(p: auto imut Pair) mut u64{
	let h = mut 0
	unsafe{
		let n = mut sizeof(Pair)
		let buf = mut malloc(n)
		let c = imut deref(p)
		memcopy(buf, n, raw c)
		h = fnv1a64Bytes(buf + (n - 16), mut 16)
		free(buf)
	}
	return h
}
func hashQuad(p: auto imut Quad) mut u64{
	let h = mut 0
	unsafe{
		let n = mut sizeof(Quad)
		let buf = mut malloc(n)
		let c = imut deref(p)
		memcopy(buf, n, raw c)
		h = fnv1a64Bytes(buf + (n - 16), mut 16)
		free(buf)
	}
	return h
}

func main() void{
	// ---- published vectors (and a few more strings)
	checkHash("fnv1a64Bytes: empty", fnv1a64Bytes(null, mut 0), 0xcbf29ce484222325)

	checkHash("hashStr: ''", hashStr(""), 14695981039346656037)
	checkHash("hashStr: 'a'", hashStr("a"), 12638187200555641996)
	checkHash("hashStr: 'foobar'", hashStr("foobar"), 9625390261332436968)
	checkHash("hashStr: 'b'", hashStr("b"), 12638190499090526629)
	checkHash("hashStr: 'ab'", hashStr("ab"), 620445648566982762)
	checkHash("hashStr: 'abc'", hashStr("abc"), 16654208175385433931)
	checkHash("hashStr: 'hello'", hashStr("hello"), 11831194018420276491)
	checkHash("hashStr: 'hello world'", hashStr("hello world"), 8618312879776256743)
	checkHash("hashStr: 'The quick brown fox jumps over the lazy dog'", hashStr("The quick brown fox jumps over the lazy dog"), 17580284887202820368)
	checkHash("hashStr: '0123456789abcdef'", hashStr("0123456789abcdef"), 3330193207084279677)
	checkHash("hashPattern 1 bytes", hashPattern(1), 12638163011299821354)
	checkHash("hashPattern 2 bytes", hashPattern(2), 599275651681571118)
	checkHash("hashPattern 3 bytes", hashPattern(3), 2813714132783166465)
	checkHash("hashPattern 7 bytes", hashPattern(7), 18226734573711439785)
	checkHash("hashPattern 8 bytes", hashPattern(8), 3931156000417648837)
	checkHash("hashPattern 9 bytes", hashPattern(9), 4454383383410823682)
	checkHash("hashPattern 15 bytes", hashPattern(15), 9274623009836401825)
	checkHash("hashPattern 16 bytes", hashPattern(16), 12387545992954858645)
	checkHash("hashPattern 17 bytes", hashPattern(17), 65185782699885066)
	checkHash("hashPattern 31 bytes", hashPattern(31), 16123853202563983905)
	checkHash("hashPattern 32 bytes", hashPattern(32), 10952857708260800965)
	checkHash("hashPattern 33 bytes", hashPattern(33), 10473472664085403114)
	checkHash("hashPattern 63 bytes", hashPattern(63), 3233879696196659489)
	checkHash("hashPattern 64 bytes", hashPattern(64), 7552869386198218469)
	checkHash("hashPattern 65 bytes", hashPattern(65), 6911059632779012522)
	checkHash("hashPattern 100 bytes", hashPattern(100), 12316872312821756577)
	checkHash("hashPattern 255 bytes", hashPattern(255), 14571156115752629537)
	checkHash("hashPattern 256 bytes", hashPattern(256), 14837709748493705509)
	checkHash("hashPattern 1000 bytes", hashPattern(1000), 2403631003335126693)
	// ---- hashOf:<T> = FNV-1a of the value's little-endian bytes
	let:<mut u8> v8 = mut 0
	let:<mut u16> v16 = mut 0
	let:<mut u32> v32 = mut 0
	let:<mut u64> v64 = mut 0
	let:<mut s32> t32 = mut 0
	let:<mut s64> t64 = mut 0
	v8 = mut 0
	checkHash("hashOf:<u8> 0", hashOf:<u8>(imut v8), 12638153115695167455)
	v8 = mut 1
	checkHash("hashOf:<u8> 1", hashOf:<u8>(imut v8), 12638152016183539244)
	v8 = mut 2
	checkHash("hashOf:<u8> 2", hashOf:<u8>(imut v8), 12638155314718423877)
	v8 = mut 7
	checkHash("hashOf:<u8> 7", hashOf:<u8>(imut v8), 12638149817160282822)
	v8 = mut 42
	checkHash("hashOf:<u8> 42", hashOf:<u8>(imut v8), 12638128926439346813)
	v8 = mut 127
	checkHash("hashOf:<u8> 127", hashOf:<u8>(imut v8), 12638211389811462638)
	v8 = mut 128
	checkHash("hashOf:<u8> 128", hashOf:<u8>(imut v8), 12638293853183578463)
	v8 = mut 255
	checkHash("hashOf:<u8> 255", hashOf:<u8>(imut v8), 12638352127299873646)
	v16 = mut 0
	checkHash("hashOf:<u16> 0", hashOf:<u16>(imut v16), 590684067820433389)
