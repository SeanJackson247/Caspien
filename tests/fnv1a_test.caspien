	checkHash("hashOf:<s64> 2147483648", hashOf:<s64>(imut t64), 5860980763039959109)
	t64 = mut 3735928559
	checkHash("hashOf:<s64> 3735928559", hashOf:<s64>(imut t64), 8436364122023583835)
	t64 = mut 4294967295
	checkHash("hashOf:<s64> 4294967295", hashOf:<s64>(imut t64), 5673037472935113441)
	t64 = mut 81985529216486895
	checkHash("hashOf:<s64> 81985529216486895", hashOf:<s64>(imut t64), 4029383781087845461)
	t64 = mut 9223372036854775807
	checkHash("hashOf:<s64> 9223372036854775807", hashOf:<s64>(imut t64), 10157194460633784765)
	// literal argument (adapts to T)
	checkHash("hashOf:<u64>(42) literal", hashOf:<u64>(imut 42), 18391255480883862255)
	checkHash("hashOf:<u32>(7) literal", hashOf:<u32>(imut 7), 7869321708915449410)
	checkHash("hashOf:<u8>(200) literal", hashOf:<u8>(imut 200), 12638373018020809655)
	// ---- behaviour: deterministic, different inputs differ, width matters
	let a = mut hashOf:<u64>(imut 1234567)
	let b = mut hashOf:<u64>(imut 1234567)
	let c = mut hashOf:<u64>(imut 1234568)
	check("hashOf deterministic", a == b)
	check("hashOf: different values differ", a != c)
	check("hashOf: same value, different width differs", hashOf:<u32>(imut 7) != hashOf:<u64>(imut 7))
	// ---- structs (padding-free), through fnv1a64Bytes over the member bytes
	let pr = mut Pair{a= mut 0x0102030405060708, b= mut 0x1112131415161718}
	let pr0 = mut Pair{a= mut 0, b= mut 0}
	let q = mut Quad{a= mut 1, b= mut 2, c= mut 0xdeadbeef, d= mut 0xffffffff}

	check("sizeof(Pair) == 24 (8-byte hidden header + 16 member bytes)", sizeof(Pair) == 24)
	check("sizeof(Quad) == 24 (8-byte hidden header + 16 member bytes)", sizeof(Quad) == 24)
	checkHash("hashPair {0x0102030405060708, 0x1112131415161718}", hashPair(auto pr), 8196511168062809125)
	checkHash("hashPair {0, 0}", hashPair(auto pr0), 9808874869469701221)
	checkHash("hashQuad {1, 2, 0xdeadbeef, 0xffffffff}", hashQuad(auto q), 2110391782796641668)
	unsafe{
		printf("fnv1a: %llu passed, %llu failed\n", passed, failed)
		if failed == 0{
			printf("ALL FNV1A TESTS PASSED\n")
		}
	}
}
