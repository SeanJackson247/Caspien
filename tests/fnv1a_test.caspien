	checkHash("hashOf:<u32> 7", hashOf:<u32>(imut v32), 7869321708915449410)
	v32 = mut 42
	checkHash("hashOf:<u32> 42", hashOf:<u32>(imut v32), 10203658981158674303)
	v32 = mut 127
	checkHash("hashOf:<u32> 127", hashOf:<u32>(imut v32), 7785338617881042426)
	v32 = mut 128
	checkHash("hashOf:<u32> 128", hashOf:<u32>(imut v32), 5367018254603410549)
	v32 = mut 255
	checkHash("hashOf:<u32> 255", hashOf:<u32>(imut v32), 7593377266945255034)
	v32 = mut 256
	checkHash("hashOf:<u32> 256", hashOf:<u32>(imut v32), 4934814342159144266)
	v32 = mut 257
	checkHash("hashOf:<u32> 257", hashOf:<u32>(imut v32), 13102173594614519311)
	v32 = mut 65535
	checkHash("hashOf:<u32> 65535", hashOf:<u32>(imut v32), 10992417411537582043)
	v32 = mut 65536
	checkHash("hashOf:<u32> 65536", hashOf:<u32>(imut v32), 5558023030422843596)
	v32 = mut 16909060
	checkHash("hashOf:<u32> 16909060", hashOf:<u32>(imut v32), 12917768894214892981)
	v32 = mut 2147483647
	checkHash("hashOf:<u32> 2147483647", hashOf:<u32>(imut v32), 11047037850681434065)
