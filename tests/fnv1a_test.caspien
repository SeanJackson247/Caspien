	t64 = mut 7
	checkHash("hashOf:<s64> 7", hashOf:<s64>(imut t64), 5465015992139406178)
	t64 = mut 42
	checkHash("hashOf:<s64> 42", hashOf:<s64>(imut t64), 18391255480883862255)
	t64 = mut 127
	checkHash("hashOf:<s64> 127", hashOf:<s64>(imut t64), 1347470266357551770)
	t64 = mut 128
	checkHash("hashOf:<s64> 128", hashOf:<s64>(imut t64), 2750429125540792901)
