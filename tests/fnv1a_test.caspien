	checkHash("hashOf:<u32> 3735928559", hashOf:<u32>(imut v32), 11839450912400667691)
	v32 = mut 4294967295
	checkHash("hashOf:<u32> 4294967295", hashOf:<u32>(imut v32), 11047178588169845073)
	v64 = mut 0
	checkHash("hashOf:<u64> 0", hashOf:<u64>(imut v64), 12161962213042174405)
	v64 = mut 1
	checkHash("hashOf:<u64> 1", hashOf:<u64>(imut v64), 9929646806074584996)
	v64 = mut 2
	checkHash("hashOf:<u64> 2", hashOf:<u64>(imut v64), 16626593026977353223)
	v64 = mut 7
	checkHash("hashOf:<u64> 7", hashOf:<u64>(imut v64), 5465015992139406178)
	v64 = mut 42
	checkHash("hashOf:<u64> 42", hashOf:<u64>(imut v64), 18391255480883862255)
	v64 = mut 127
	checkHash("hashOf:<u64> 127", hashOf:<u64>(imut v64), 1347470266357551770)
	v64 = mut 128
	checkHash("hashOf:<u64> 128", hashOf:<u64>(imut v64), 2750429125540792901)
	v64 = mut 255
	checkHash("hashOf:<u64> 255", hashOf:<u64>(imut v64), 10382681252565721882)
	v64 = mut 256
	checkHash("hashOf:<u64> 256", hashOf:<u64>(imut v64), 16390143479181108970)
	v64 = mut 257
	checkHash("hashOf:<u64> 257", hashOf:<u64>(imut v64), 5701465539935650431)
	v64 = mut 65535
	checkHash("hashOf:<u64> 65535", hashOf:<u64>(imut v64), 9970289527379425035)
	v64 = mut 65536
	checkHash("hashOf:<u64> 65536", hashOf:<u64>(imut v64), 14713704181997794188)
	v64 = mut 16909060
	checkHash("hashOf:<u64> 16909060", hashOf:<u64>(imut v64), 11727677991710658437)
	v64 = mut 2147483647
	checkHash("hashOf:<u64> 2147483647", hashOf:<u64>(imut v64), 17818800096642449761)
	v64 = mut 2147483648
	checkHash("hashOf:<u64> 2147483648", hashOf:<u64>(imut v64), 5860980763039959109)
	v64 = mut 3735928559
	checkHash("hashOf:<u64> 3735928559", hashOf:<u64>(imut v64), 8436364122023583835)
	v64 = mut 4294967295
	checkHash("hashOf:<u64> 4294967295", hashOf:<u64>(imut v64), 5673037472935113441)
	v64 = mut 81985529216486895
	checkHash("hashOf:<u64> 81985529216486895", hashOf:<u64>(imut v64), 4029383781087845461)
	v64 = mut 9223372036854775807
	checkHash("hashOf:<u64> 9223372036854775807", hashOf:<u64>(imut v64), 10157194460633784765)
	v64 = mut 9223372036854775808
	checkHash("hashOf:<u64> 9223372036854775808", hashOf:<u64>(imut v64), 12161821475553763397)
	v64 = mut 18364758544493064720
	checkHash("hashOf:<u64> 18364758544493064720", hashOf:<u64>(imut v64), 15244364643513354549)
	v64 = mut 18446744073709551615
	checkHash("hashOf:<u64> 18446744073709551615", hashOf:<u64>(imut v64), 10157053723145373757)
	t32 = mut -2147483648
	checkHash("hashOf:<s32> -2147483648", hashOf:<s32>(imut t32), 5558838868050786933)
	t32 = mut -123456
	checkHash("hashOf:<s32> -123456", hashOf:<s32>(imut t32), 5664939816431960565)
	t32 = mut -32768
	checkHash("hashOf:<s32> -32768", hashOf:<s32>(imut t32), 17935171537698748907)
	t32 = mut -255
	checkHash("hashOf:<s32> -255", hashOf:<s32>(imut t32), 6014962448677246055)
	t32 = mut -129
	checkHash("hashOf:<s32> -129", hashOf:<s32>(imut t32), 17228364472434321873)
	t32 = mut -128
	checkHash("hashOf:<s32> -128", hashOf:<s32>(imut t32), 8859553173873240406)
	t32 = mut -2
	checkHash("hashOf:<s32> -2", hashOf:<s32>(imut t32), 8093943181019293376)
	t32 = mut -1
	checkHash("hashOf:<s32> -1", hashOf:<s32>(imut t32), 11047178588169845073)
	t32 = mut 0
	checkHash("hashOf:<s32> 0", hashOf:<s32>(imut t32), 5558979605539197941)
	t32 = mut 1
	checkHash("hashOf:<s32> 1", hashOf:<s32>(imut t32), 12478008331234465636)
	t32 = mut 2
	checkHash("hashOf:<s32> 2", hashOf:<s32>(imut t32), 10167666227858214167)
	t32 = mut 7
	checkHash("hashOf:<s32> 7", hashOf:<s32>(imut t32), 7869321708915449410)
	t32 = mut 42
	checkHash("hashOf:<s32> 42", hashOf:<s32>(imut t32), 10203658981158674303)
	t32 = mut 127
	checkHash("hashOf:<s32> 127", hashOf:<s32>(imut t32), 7785338617881042426)
	t32 = mut 128
	checkHash("hashOf:<s32> 128", hashOf:<s32>(imut t32), 5367018254603410549)
	t32 = mut 255
	checkHash("hashOf:<s32> 255", hashOf:<s32>(imut t32), 7593377266945255034)
	t32 = mut 256
	checkHash("hashOf:<s32> 256", hashOf:<s32>(imut t32), 4934814342159144266)
	t32 = mut 257
	checkHash("hashOf:<s32> 257", hashOf:<s32>(imut t32), 13102173594614519311)
	t32 = mut 65535
	checkHash("hashOf:<s32> 65535", hashOf:<s32>(imut t32), 10992417411537582043)
	t32 = mut 65536
	checkHash("hashOf:<s32> 65536", hashOf:<s32>(imut t32), 5558023030422843596)
	t32 = mut 16909060
	checkHash("hashOf:<s32> 16909060", hashOf:<s32>(imut t32), 12917768894214892981)
	t32 = mut 2147483647
	checkHash("hashOf:<s32> 2147483647", hashOf:<s32>(imut t32), 11047037850681434065)
	t64 = mut -9223372036854775808
	checkHash("hashOf:<s64> -9223372036854775808", hashOf:<s64>(imut t64), 12161821475553763397)
	t64 = mut -123456
	checkHash("hashOf:<s64> -123456", hashOf:<s64>(imut t64), 12952779147007480097)
