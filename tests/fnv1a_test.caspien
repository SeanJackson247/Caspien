	v16 = mut 65535
	checkHash("hashOf:<u16> 65535", hashOf:<u16>(imut v16), 763862646787557219)
	v32 = mut 0
	checkHash("hashOf:<u32> 0", hashOf:<u32>(imut v32), 5558979605539197941)
	v32 = mut 1
	checkHash("hashOf:<u32> 1", hashOf:<u32>(imut v32), 12478008331234465636)
	v32 = mut 2
	checkHash("hashOf:<u32> 2", hashOf:<u32>(imut v32), 10167666227858214167)
