// The same with logic before the `continue`: still an unbounded retry written by hand, still an error. Put the logic in an `impl default match @lock` policy.
import "../stdlib/libc.caspien"
import "../stdlib/gt_init.caspien"
import "../stdlib/gt_register.caspien"
import "../stdlib/gt_alive_check.caspien"
import "../stdlib/gt_destruct.caspien"
import "../stdlib/gt_moved.caspien"

enum Gate{ OPEN, CLOSED }

@lock(match self.gate : OPEN)
struct Box{@pub{
	swap gate: atomic mut Gate
	n: mut u64
}}
let static box = mut Box{gate= Gate.OPEN, n= mut 0}

func main() void{
	let tries = mut 0
	match @lock box{
		OPEN:{ box.n += 1 }
		CLOSED:{
			tries++
			if tries == 1000{ break }
			continue
		}
	}
}
