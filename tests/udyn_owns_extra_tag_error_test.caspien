// `udyn:owns` on an unsafe dynarray of plain data is an extra tag.
import "../stdlib/libc.caspien"
import "../stdlib/gt_init.caspien"
import "../stdlib/gt_register.caspien"
import "../stdlib/gt_alive_check.caspien"
import "../stdlib/gt_destruct.caspien"
import "../stdlib/gt_moved.caspien"
struct World{@pub{
	ticks: mut u64
}}
struct Holder{@pub{
	w: owns some mut World
}}
func main() void{
	?catch(e){ return }
	unsafe udyn:owns{
		let a = mut unsafe dyn([1, 2, 3])
		a[0] = 5
	}
}
