// `continue` in a `for` or `loop` is "next iteration" (a `for` still runs its step; a `loop` goes back to its start). Inside a catch
// body it keeps its old meaning (jump past the enclosing try{} block) unless a loop is opened inside that catch, where it belongs to
// that loop. Owns locals declared in the body before the `continue` are freed (checked through the ghost table's entry count).
// Expected values come from an independent Python model. Output must be identical with the optimiser switches on and off
// (a fixed-size `for` with a `continue` is unrolled when they are on).
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

func live() mut u64{
	let n = mut 0
	unsafe assume{
		assume match ghost_table.lockState : OPEN
		n = mut ghost_table.len
	}
	return n
}

@throws
func boom(x: mut u64) mut u64{
	if x % 2 == 1{
		throw "odd"
	}
	return x
}

func forSkip() mut u64{
	let odd = mut 0
	for i in 0..10{
		if i % 2 == 0{ continue }
		odd += i
	}
	return odd
}

func loopSkip() mut u64{
	let n = mut 0
	let s = mut 0
	unsafe loop{
		loop{
			n += 1
			if n > 8{ break }
			if n % 3 == 0{ continue }
			s += n
		}
	}
	return s
}

func nested() mut u64{
	let t = mut 0
	for i in 0..4{
		for j in 0..4{
			if j == i{ continue }
			if j > 2{ break }
			t += 10 * i + j
		}
	}
	return t
}

func runtimeBound(n: mut u64) mut u64{
	let s = mut 0
	for i in 0..n{
		if i % 4 == 1{ continue }
		s += i
	}
	return s
}

func catchContinue() mut u64{
	let u = mut 0
	for i in 0..6{
		try{
			let r = try boom(i) catch(e){ continue }
			u += r
		}
	}
	return u
}

func catchWithLoop() mut u64{
	let w = mut 0
	for i in 0..4{
		try{
			let r = try boom(i) catch(e){
				for k in 0..5{
					if k == 2{ continue }
					w += k
				}
				continue
			}
			w += 100
		}
	}
	return w
}

func dynSkip() mut u64{
	?catch(e){ return 0 }
	let v = mut ?dyn:<u64>([])
	v = ?resize(v, 10, 0)
	for i in 0..10{
		match i into v{ v[i] = i * i }
	}
	let s = mut 0
	for i in 0..10{
		if i % 2 == 1{ continue }
		match i in v{ s += v[i] }
	}
	return s
}

// an owns local declared before the `continue` is freed on that path: the table is back to its starting count at the end
func ownsFreed() mut u64{
	?catch(e){ return 999 }
	let base = mut live()
	let kept = mut 0
	for i in 0..6{
		let tmp = mut ?dyn:<u64>([])
		tmp = ?resize(tmp, 8, 1)
		if i % 2 == 0{ continue }
		kept += 1
	}
	let after = mut live()
	if after == base{ return kept }
	return 1000 + after
}

func main() void{
	check("for: skip even", forSkip() == 25)
	check("loop: skip multiples of 3", loopSkip() == 27)
	check("nested for: continue and break", nested() == 159)
	check("runtime bound", runtimeBound(10) == 30)
	check("catch continue still skips the try block", catchContinue() == 6)
	check("loop inside a catch owns its continue", catchWithLoop() == 216)
	check("dynarray element skip", dynSkip() == 120)
	check("owns local freed on the continue path", ownsFreed() == 3)
}
