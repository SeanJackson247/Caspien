@dont(inline)
func k2() void{
	let a = mut 0
	let:<mut s64> b = mut 0
	let:<mut u32> c = mut 0
	for i in 0..200{
		let x = mut (i * 1099511628211 + 14695981039346656037)
		let:<mut s64> y = mut (wrap:<s64>(i * 7919) - 100000)
		let:<mut u32> w = mut wrap:<u32>(i * 40503 + 99)
		a = a + x * 2
		b = b + y * 2
		c = c + w * 2
	}
	unsafe extern{ printf("2 %llu %lld %llu\n", a, b, c as u64) }
}
