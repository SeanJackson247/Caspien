// Using an inline struct that owns memory after it was copied (moved) is an error.
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
struct World{@pub{
	ticks: mut u64
}}
struct Holder{@pub{
	w: owns some mut World
}}
struct Outer{@pub{
	h: mut Holder
	n: mut u64
}}

func live() mut u64{
	let n = mut 0
	unsafe assume{
		assume match ghost_table.lockState : OPEN
		n = mut ghost_table.len
	}
	return n
}

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}
func main() void{
	?catch(e){ return }
	let w = mut ? new World{ticks= 6}
	let h = mut Holder{w= w}
	let h2 = mut h
	let t = mut 0
	t = h.w.ticks
}
