// HashMap growth and layout: the capacity is rounded up to a power of two, the map doubles itself when one more key would pass 70% load, and
// every key keeps its value across the rehashes. Expected values from a Python model (hashmap_growth_test.py). A map of u8 keys exercises a
// key narrower than a word. hashmap_growth_check.sh adds valgrind and a failing-growth (out of memory) case.
import "../stdlib/libc.caspien"
import "../stdlib/hash_map.caspien"
import "../stdlib/gt/*"

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

func main() void{
	?catch(e){
		unsafe extern{ printf("FAIL uncaught: %s\n", e.msg) }
		return
	}
	let m100 = mut ? new HashMap:<u64>(mut 0, mut 0, mut 100)
	check("capacity 100 rounds up to 128", m100.capacity == 128)
	let m8 = mut ? new HashMap:<u64>(mut 0, mut 0, mut 8)
	check("capacity 8 stays 8", m8.capacity == 8)
	let m1000 = mut ? new HashMap:<u64>(mut 0, mut 0, mut 1000)
	check("capacity 1000 rounds up to 1024", m1000.capacity == 1024)
	let m = mut ? new HashMap:<u64>(mut 0, mut 0, mut 2)
	for i in 0..50000{
		let key = mut ((i * 7919 + 13) % 1000003)
		m.set(m, key, i * 2 + 1)
	}
	check("50000 inserts: count", m.count == 50000)
	check("50000 inserts: capacity is 131072", m.capacity == 131072)
	for i in 0..5000{
		let key = mut ((i * 7919 + 13) % 1000003)
		m.set(m, key, mut 7)
	}
	check("5000 updates: count unchanged", m.count == 50000)
	let total = mut 0
	for i in 0..50000{
		let key = mut ((i * 7919 + 13) % 1000003)
		total = total + m.get(m, key, mut 0)
	}
	check("sum of all values after growth and updates", total == 2475035000)
	let missing = mut 0
	for i in 0..100{
		let key = mut (2000000 + i)
		if m.contains(m, key){
			missing = missing + 1
		}
	}
	check("100 absent keys are not found", missing == 0)
	let small = mut ? new HashMap:<u8>(mut 0, mut 0, mut 1)
	for i in 0..200{
		let:<mut u8> key = mut wrap:<u8>(i)
		let:<mut u8> val = mut wrap:<u8>(i + 1)
		small.set(small, key, val)
	}
	let st = mut 0
	for i in 0..200{
		let:<mut u8> key = mut wrap:<u8>(i)
		st = st + small.get(small, key, mut 0) as u64
	}
	check("u8 keys: count", small.count == 200)
	check("u8 keys: sum", st == 20100)
}
