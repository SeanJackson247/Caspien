// inline-max-multi-callee-lines: `big` (long body, two call sites) must stay a call when the limit is below its size, `once` (equally long,
// one call site) is still inlined, `small` (two call sites, short) is inlined. Values come from tests/inline_multi_callee_test.py;
// tests/inline_multi_callee_check.sh compares them and looks at the optimised HOB for the CALL lines under several limits.
import "../stdlib/libc.caspien"

func out(name: static imut string, v: imut u64) void{
	unsafe extern{ printf("%s %llu\n", name, v) }
}

func big(x: mut u64) mut u64{
	let v = mut x
	v = bits_and(v * 3 + 1, 16777215)
	v = bits_and(v * 3 + 2, 16777215)
	v = bits_and(v * 3 + 3, 16777215)
	v = bits_and(v * 3 + 4, 16777215)
	v = bits_and(v * 3 + 5, 16777215)
	v = bits_and(v * 3 + 6, 16777215)
	v = bits_and(v * 3 + 7, 16777215)
	v = bits_and(v * 3 + 8, 16777215)
	v = bits_and(v * 3 + 9, 16777215)
	v = bits_and(v * 3 + 10, 16777215)
	v = bits_and(v * 3 + 11, 16777215)
	v = bits_and(v * 3 + 12, 16777215)
	v = bits_and(v * 3 + 13, 16777215)
	v = bits_and(v * 3 + 14, 16777215)
	v = bits_and(v * 3 + 15, 16777215)
	v = bits_and(v * 3 + 16, 16777215)
	v = bits_and(v * 3 + 17, 16777215)
	v = bits_and(v * 3 + 18, 16777215)
	v = bits_and(v * 3 + 19, 16777215)
	v = bits_and(v * 3 + 20, 16777215)
	v = bits_and(v * 3 + 21, 16777215)
	v = bits_and(v * 3 + 22, 16777215)
	v = bits_and(v * 3 + 23, 16777215)
	v = bits_and(v * 3 + 24, 16777215)
	v = bits_and(v * 3 + 25, 16777215)
	v = bits_and(v * 3 + 26, 16777215)
	v = bits_and(v * 3 + 27, 16777215)
	v = bits_and(v * 3 + 28, 16777215)
	v = bits_and(v * 3 + 29, 16777215)
	v = bits_and(v * 3 + 30, 16777215)
	v = bits_and(v * 3 + 31, 16777215)
	v = bits_and(v * 3 + 32, 16777215)
	v = bits_and(v * 3 + 33, 16777215)
	v = bits_and(v * 3 + 34, 16777215)
	v = bits_and(v * 3 + 35, 16777215)
	v = bits_and(v * 3 + 36, 16777215)
	v = bits_and(v * 3 + 37, 16777215)
	v = bits_and(v * 3 + 38, 16777215)
	v = bits_and(v * 3 + 39, 16777215)
	v = bits_and(v * 3 + 40, 16777215)
	v = bits_and(v * 3 + 41, 16777215)
	v = bits_and(v * 3 + 42, 16777215)
	v = bits_and(v * 3 + 43, 16777215)
	v = bits_and(v * 3 + 44, 16777215)
	v = bits_and(v * 3 + 45, 16777215)
	v = bits_and(v * 3 + 46, 16777215)
	v = bits_and(v * 3 + 47, 16777215)
	v = bits_and(v * 3 + 48, 16777215)
	v = bits_and(v * 3 + 49, 16777215)
	v = bits_and(v * 3 + 50, 16777215)
	v = bits_and(v * 3 + 51, 16777215)
	v = bits_and(v * 3 + 52, 16777215)
	v = bits_and(v * 3 + 53, 16777215)
	v = bits_and(v * 3 + 54, 16777215)
	v = bits_and(v * 3 + 55, 16777215)
	v = bits_and(v * 3 + 56, 16777215)
	v = bits_and(v * 3 + 57, 16777215)
	v = bits_and(v * 3 + 58, 16777215)
	v = bits_and(v * 3 + 59, 16777215)
	v = bits_and(v * 3 + 60, 16777215)
	return v
}

