	v = bits_and(v * 3 + 54, 16777215)
	v = bits_and(v * 3 + 55, 16777215)
	v = bits_and(v * 3 + 56, 16777215)
	v = bits_and(v * 3 + 57, 16777215)
	v = bits_and(v * 3 + 58, 16777215)
	v = bits_and(v * 3 + 59, 16777215)
	v = bits_and(v * 3 + 60, 16777215)
	return v
}

func small(x: mut u64) mut u64{
	return bits_and(x * 5 + 1, 16777215)
}

func main() void{
	let a = mut big(7)
	let b = mut big(a + 1)
	out("big", a + b)
	let c = mut once(11)
	out("once", c)
	let d = mut small(3)
	let e = mut small(d)
	out("small", d + e)
}
