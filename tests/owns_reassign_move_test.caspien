// `s = f(s)` moves the old value into f; it must not be destructed before the call.
// Expected output: moved=6 replaced=9
import "../stdlib/libc.caspien"
import "../stdlib/gt_init.caspien"
import "../stdlib/gt_register.caspien"
import "../stdlib/gt_alive_check.caspien"
import "../stdlib/gt_destruct.caspien"
struct World{@pub{
	ticks: mut u64
}}
func pass(w: owns some mut World) owns some mut World{
	w.ticks += 1
	return w
}
func main() void{
	?catch(e){ return }
	let s = mut ? new World{ticks= 5}
	s = pass(s)
	let moved = mut s.ticks
	s = ? new World{ticks= 7}
	s = ? new World{ticks= 9}
	let replaced = mut s.ticks
	unsafe{ printf("moved=%llu replaced=%llu\n", moved, replaced) }
}
