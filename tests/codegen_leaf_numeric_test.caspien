// Differential test of the converted leaf methods of codegenCaspien against the Java originals (expected values come from the Java classes).
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
import "../Codegen/src/main/java/caspien/codegen/codegenCaspien/x86backend/X86Backend.caspien"

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

func t_min() mut s64{
	let:<mut s64> m = mut -9223372036854775807
	let:<mut s64> one = mut 1
	return m - one
}

func t_align(target: imut CodegenTarget, v: mut s64) mut s32{
	?catch(e){ return -99 }
	let b = mut ? new X86Backend(target)
	? b.wire(b)
	let:<mut s32> r = mut 0
	match Some(b.calls){
		r = b.calls.alignPadFor(b.calls, v)
	}
	return r
}

func t_win(target: imut CodegenTarget) mut bool{
	?catch(e){ return false }
	let b = mut ? new X86Backend(target)
	? b.wire(b)
	let r = mut false
	match Some(b.emit){
		r = b.emit.isWinAbi(b.emit)
	}
	return r
}

// also checks that the pending count is reset to -1
func t_consume(target: imut CodegenTarget, st: mut s32) mut s32{
	?catch(e){ return -99 }
	let b = mut ? new X86Backend(target)
	? b.wire(b)
	b.core.pendingVarargsXmmCount = st
	let:<mut s32> r = mut -99
	match Some(b.emit){
		r = b.emit.consumeVarargsXmmCount(b.emit)
	}
	if b.core.pendingVarargsXmmCount != -1{
		r = -98
	}
	return r
}

func t_div(k: mut s64, expectNull: mut bool, a: mut s64, b: mut s64, c: mut s64) mut bool{
	?catch(e){ return false }
	let r = mut ? X86Core.divMagicSimple(k)
	let ok = mut expectNull
	match Some(r){
		ok = false
		let n = mut len(r.backing)
		if n == 3{
			if expectNull == false{
				let i0 = mut 0
				let i1 = mut 1
				let i2 = mut 2
				match i0 in r.backing{
					match i1 in r.backing{
						match i2 in r.backing{
							ok = r.backing[i0] == a && r.backing[i1] == b && r.backing[i2] == c
						}
					}
				}
			}
		}
	}
	return ok
}

func part0() void{
	check("alignPadFor 0", t_align(CodegenTarget.LINUX_X64, 0) == 16)
	check("alignPadFor 1", t_align(CodegenTarget.LINUX_X64, 1) == 8)
