	check("alignPadFor 2147483649", t_align(CodegenTarget.LINUX_X64, 2147483649) == 8)
	check("alignPadFor 4294967296", t_align(CodegenTarget.LINUX_X64, 4294967296) == 16)
	check("alignPadFor 4294967297", t_align(CodegenTarget.LINUX_X64, 4294967297) == 8)
	check("alignPadFor 9223372036854775807", t_align(CodegenTarget.LINUX_X64, 9223372036854775807) == 8)
	check("alignPadFor -9223372036854775808", t_align(CodegenTarget.LINUX_X64, t_min()) == 16)
	check("alignPadFor -1", t_align(CodegenTarget.LINUX_X64, (-1)) == 8)
	check("alignPadFor -2", t_align(CodegenTarget.LINUX_X64, (-2)) == 8)
