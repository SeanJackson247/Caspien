	return
}
// ---- u16: values arrive as function arguments (not foldable) ----
func rt_u16() void{
	chk_u16("and u16 0 0", and_u16(0X0, 0b0), 0B0000)
	chk_u16("and u16 0 65535", and_u16(0, 0xFF_FF), 0x000)
	chk_u16("and u16 0 21845", and_u16(0x0, 21845), 0x0)
	chk_u16("and u16 65535 0", and_u16(0XfFfF, 0b0), 0B0000)
	chk_u16("and u16 65535 65535", and_u16(65_535, 0xFF_FF), 0x00ffff)
	chk_u16("and u16 65535 21845", and_u16(0xFfFf, 21845), 0x5555)
	chk_u16("and u16 21845 0", and_u16(0X5555, 0b0), 0B0000)
	chk_u16("and u16 21845 65535", and_u16(21_845, 0xFF_FF), 0x005555)
	chk_u16("and u16 21845 21845", and_u16(0x5555, 21845), 0x5555)
	chk_u16("or u16 0 0", or_u16(0X0, 0b0), 0B0000)
	chk_u16("or u16 0 65535", or_u16(0, 0xFF_FF), 0x00ffff)
	chk_u16("or u16 0 21845", or_u16(0x0, 21845), 0x5555)
	chk_u16("or u16 65535 0", or_u16(0XFfFf, 0b0), 0B1111_1111_1111_1111)
	chk_u16("or u16 65535 65535", or_u16(65_535, 0xFF_FF), 0x00ffff)
	chk_u16("or u16 65535 21845", or_u16(0xfFfF, 21845), 0xffff)
	chk_u16("or u16 21845 0", or_u16(0X5555, 0b0), 0B0101_0101_0101_0101)
	chk_u16("or u16 21845 65535", or_u16(21_845, 0xFF_FF), 0x00ffff)
	chk_u16("or u16 21845 21845", or_u16(0x5555, 21845), 0x5555)
	chk_u16("xor u16 0 0", xor_u16(0X0, 0b0), 0B0000)
	chk_u16("xor u16 0 65535", xor_u16(0, 0xFF_FF), 0x00ffff)
	chk_u16("xor u16 0 21845", xor_u16(0x0, 21845), 0x5555)
	chk_u16("xor u16 65535 0", xor_u16(0XfFfF, 0b0), 0B1111_1111_1111_1111)
