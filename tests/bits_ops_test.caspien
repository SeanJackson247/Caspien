	for match i in arr{
		match i in want{
			chk_u16("array element u16", arr[i], want[i])
		}
	}
	let:<mut u16> zero = mut 0
	let d = mut ? dyn:<u16>([])
	d = ? resize(d, 8, zero)
	for i in 0..8{
		let:<mut u16> k = mut wrap:<u16>(i)
		let:<mut u16> v = mut bits_xor(bits_left(1, k), wrap:<u16>(i * 11400714819323198485))
		match i into d{
			d[i] = v
		}
	}
	for i in 0..8{
		match i into d{
			d[i] = bits_not(bits_and(d[i], b))
		}
	}
	let:<mut u16[8]> dwant = mut [0x00ffff, 0xf3eF, 63455, 0xfbcf, 0XfFbF, 0b1111001110111111, 0B1111_0111_1100_1111, 64_495]
	for i in 0..8{
		match i in d{
			match i in dwant{
				chk_u16("dynarray element u16", d[i], dwant[i])
			}
		}
	}
	return
}
