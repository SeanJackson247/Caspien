	bx.fShl = bits_or(bits_right(bx.fShl, 1), bits_not(bx.fOr))
	bx.fNot = bits_and(bx.fNot, bits_not(bx.fXor))
	chk_s64("struct rmw fand s64", bx.fAnd, -0B1100_1011_0110_1000_1100_1011_0110_1000_1100_1011_0110_1000_1100_1011_1000)
	chk_s64("struct rmw fshl s64", bx.fShl, 4_512_394_205_319_872_158)
	chk_s64("struct rmw fnot s64", bx.fNot, 0x30_0A_30_0A_30_0A_30_0A)
	let:<mut s64[6]> arr = mut [0x001, 0xfF, 9187201950435737471, -0x7f7f7f7f7f7f7f80, 0X1234567890aBcDeF, -0b100100011010001011111011001111000100110101011110011011111]
	let:<mut s64[6]> want = mut [0B1111_1111_0000_0000_1111_1111_0000_0000_1111_1111_0000_0000_1111_1111_0010, 1_148_435_428_713_434_638, -0x0E_F1_0E_F1_0E_F1_0E_F2, 0x00ef10ef10ef10ef0, 0x2b98A3012eA7942e, -988122428322707022]
	for i in 0..6{
		match i into arr{
			arr[i] = bits_xor(bits_left(arr[i], 1), b)
		}
	}
	for match i in arr{
		match i in want{
			chk_s64("array element s64", arr[i], want[i])
		}
	}
	let:<mut s64> zero = mut 0
	let d = mut ? dyn:<s64>([])
	d = ? resize(d, 8, zero)
	for i in 0..8{
		let:<mut s64> k = mut wrap:<s64>(i)
		let:<mut s64> v = mut bits_xor(bits_left(1, k), wrap:<s64>(i * 11400714819323198485))
		match i into d{
			d[i] = v
		}
	}
	for i in 0..8{
		match i into d{
			d[i] = bits_not(bits_and(d[i], b))
		}
	}
	let:<mut s64[8]> dwant = mut [-0x1, -0XE3009b00F400C11, -0b110001100000000000110111000000001110100100000000100000100001, -0B1010_1010_0000_0000_1101_0010_0000_0000_1101_1101_0000_0000_0100_0011_0001, -635_015_106_821_881_921, -0x07_10_00_90_0C_70_0C_41, -0x005400a500bb00831, -0x38004100b000411]
	for i in 0..8{
		match i in d{
			match i in dwant{
				chk_s64("dynarray element s64", d[i], dwant[i])
			}
		}
	}
	return
}

// ---- hot loops: register-form fusion, promoted loop variables, narrow widths in loops ----
func xorshift64(seed: mut u64, n: mut u64) mut u64{
	let x = mut seed
	for i in 0..n{
		x = bits_xor(x, bits_left(x, 13))
		x = bits_xor(x, bits_right(x, 7))
		x = bits_xor(x, bits_left(x, 17))
	}
	return x
}
// variable counts that run past the width (i % 70 reaches 64..69): the documented count >= 64 rule, in a loop
func varshifts(x0: mut u64, n: mut u64) mut u64{
	let acc = mut 0
	let x = mut x0
	for i in 0..n{
		acc = acc + bits_right(x, i % 70) + bits_left(x, (i * 3) % 70)
		x = bits_xor(x, bits_left(x, i % 64))
		x = x + 0x9E3779B97F4A7C15
	}
	return bits_xor(acc, x)
}
func popcountShift(x: mut u64) mut u64{
	let c = mut 0
	for i in 0..64{
		c = c + bits_and(bits_right(x, i), 1)
	}
	return c
}
func popcountKernighan(x: mut u64) mut u64{
	let y = mut x
	let c = mut 0
	unsafe loop{
		loop{
			if y == 0{
				break
			}
			y = bits_and(y, y - 1)
			c++
		}
	}
	return c
}
func popcountSum(n: mut u64) mut u64{
	let x = mut 1
	let total = mut 0
	for i in 0..n{
		x = x * 6364136223846793005 + 1442695040888963407
		total = total + popcountShift(x) + popcountKernighan(x) * 1000
	}
	return total
}
func rev_u8(x0: mut u8) mut u8{
	let x = mut x0
	let:<mut u8> r = mut 0
	for i in 0..8{
		r = bits_or(bits_left(r, 1), bits_and(x, 1))
		x = bits_right(x, 1)
	}
	return r
}
func revSum_u8(n: mut u64) mut u64{
	let total = mut 0
	for i in 0..n{
		total = total + wrap:<u64>(rev_u8(wrap:<u8>(i * 40503 + 12345))) * (i + 1)
	}
	return total
}
func rev_u16(x0: mut u16) mut u16{
	let x = mut x0
	let:<mut u16> r = mut 0
	for i in 0..16{
		r = bits_or(bits_left(r, 1), bits_and(x, 1))
		x = bits_right(x, 1)
	}
	return r
}
func revSum_u16(n: mut u64) mut u64{
