	chk_u16("struct rmw fshl u16", bx.fShl, 0X3E9E)
	chk_u16("struct rmw fnot u16", bx.fNot, 0b11000000001010)
	let:<mut u16[6]> arr = mut [0B0001, 255, 0x7F_7F, 0x008080, 0xCdEf, 17185]
	let:<mut u16[6]> want = mut [0xff2, 0XE0E, 0b1111000100001110, 0B1110_1111_0000, 37_934, 0x89_B2]
	for i in 0..6{
