// ---- u8: values arrive as function arguments (not foldable) ----
func rt_u8() void{
	chk_u8("and u8 0 0", and_u8(0x0, 0X0), 0b0)
	chk_u8("and u8 0 255", and_u8(0B0000, 255), 0x00)
	chk_u8("and u8 0 85", and_u8(0x000, 0x55), 0)
