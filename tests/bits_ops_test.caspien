	chk_u8("and u8 85 0", and_u8(0x55, 0X0), 0b0)
	chk_u8("and u8 85 255", and_u8(0B0101_0101, 255), 0x55)
	chk_u8("and u8 85 85", and_u8(0x0055, 0x55), 85)
