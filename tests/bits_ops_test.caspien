	chk_u8("right u8 255 7", shr_u8(0xfF, 7), 0x1)
	chk_u8("right u8 255 8", shr_u8(0XfF, 0b1000), 0B0000)
	chk_u8("right u8 255 9", shr_u8(255, 0x09), 0x000)
	chk_u8("right u8 255 100", shr_u8(0xFf, 100), 0x0)
	chk_u8("right u8 85 0", shr_u8(0X55, 0b0), 0B0101_0101)
	chk_u8("right u8 85 1", shr_u8(85, 0x01), 0x002a)
	chk_u8("right u8 85 7", shr_u8(0x55, 7), 0x0)
	chk_u8("right u8 85 8", shr_u8(0X55, 0b1000), 0B0000)
	chk_u8("right u8 85 9", shr_u8(85, 0x09), 0x000)
	chk_u8("right u8 85 100", shr_u8(0x55, 100), 0x0)
	chk_u8("right u8 128 0", shr_u8(0X80, 0b0), 0B1000_0000)
	chk_u8("right u8 128 1", shr_u8(128, 0x01), 0x0040)
	chk_u8("right u8 128 7", shr_u8(0x80, 7), 0x1)
