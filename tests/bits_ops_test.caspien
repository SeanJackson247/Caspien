func crc32(n: mut u64) mut u32{
	let:<mut u32> crc = mut 0xFFFFFFFF
	for i in 0..n{
		let:<mut u32> byte = mut wrap:<u32>((i * 7 + 3) % 256)
		crc = bits_xor(crc, byte)
		for j in 0..8{
			if bits_and(crc, 1) == 1{
				crc = bits_xor(bits_right(crc, 1), 0xEDB88320)
			}else{
				crc = bits_right(crc, 1)
			}
		}
	}
	return bits_xor(crc, 0xFFFFFFFF)
}
func rotl_u32(x: mut u32, k: mut u32) mut u32{
	return bits_or(bits_left(x, k), bits_right(x, 32 - k))
}
func rotr_u32(x: mut u32, k: mut u32) mut u32{
	return bits_or(bits_right(x, k), bits_left(x, 32 - k))
}
func rotSum_u32(x0: mut u32) mut u64{
	let total = mut 0
	for i in 0..33{
		let:<mut u32> k = mut wrap:<u32>(i)
		total = total + wrap:<u64>(rotl_u32(x0, k)) + wrap:<u64>(rotr_u32(x0, k)) * 3
	}
	return total
}
func rotl_u64(x: mut u64, k: mut u64) mut u64{
	return bits_or(bits_left(x, k), bits_right(x, 64 - k))
}
func rotr_u64(x: mut u64, k: mut u64) mut u64{
	return bits_or(bits_right(x, k), bits_left(x, 64 - k))
}
func rotSum_u64(x0: mut u64) mut u64{
	let total = mut 0
	for i in 0..65{
		let:<mut u64> k = mut wrap:<u64>(i)
		total = total + wrap:<u64>(rotl_u64(x0, k)) + wrap:<u64>(rotr_u64(x0, k)) * 3
	}
	return total
}
func hash_u8(n: mut u64) mut u8{
	let:<mut u8> h = mut 1
	for i in 0..n{
		let:<mut u8> c = mut wrap:<u8>(i)
		h = bits_xor(bits_or(bits_left(h, 3), bits_right(h, 5)), bits_not(c))
		h = bits_and(h, bits_not(bits_left(c, 1)))
		h = bits_xor(h, bits_right(h, 2))
	}
	return h
}
