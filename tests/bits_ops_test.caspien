}

func and_u8(a: mut u8, b: mut u8) mut u8{ return bits_and(a, b) }
func or_u8(a: mut u8, b: mut u8) mut u8{ return bits_or(a, b) }
func xor_u8(a: mut u8, b: mut u8) mut u8{ return bits_xor(a, b) }
func shl_u8(a: mut u8, b: mut u8) mut u8{ return bits_left(a, b) }
func shr_u8(a: mut u8, b: mut u8) mut u8{ return bits_right(a, b) }
func not_u8(a: mut u8) mut u8{ return bits_not(a) }
