// ---- constant forms: literal operands (typed through the u8Max / s16Min ... limit constants where the type is narrow) ----
func ct_u8() void{
	chk_u8("const and u8 max 0", bits_and(u8Max, 0), 0x00)
	chk_u8("const and u8 0 max", bits_and(0x000, u8Max), 0x0)
	chk_u8("const and u8 max 85", bits_and(u8Max, 85), 0x55)
	chk_u8("const and u8 85 max", bits_and(0X55, u8Max), 0b1010101)
	chk_u8("const or u8 max 0", bits_or(u8Max, 0B0000), 255)
	chk_u8("const or u8 0 max", bits_or(0x00, u8Max), 0x00ff)
	chk_u8("const or u8 max 85", bits_or(u8Max, 0x55), 255)
	chk_u8("const or u8 85 max", bits_or(0x55, u8Max), 0XFf)
	chk_u8("const xor u8 max 0", bits_xor(u8Max, 0b0), 0B1111_1111)
	chk_u8("const xor u8 0 max", bits_xor(0, u8Max), 0xFF)
	chk_u8("const xor u8 max 85", bits_xor(u8Max, 0x0055), 0xaA)
	chk_u8("const xor u8 85 max", bits_xor(85, u8Max), 0xaa)
	chk_u8("const not u8 max", bits_not(u8Max), 0X0)
	chk_u8("const not not u8 max", bits_not(bits_not(u8Max)), 0b11111111)
	chk_u8("const left u8 max 0", bits_left(u8Max, 0B0000), 255)
	chk_u8("const right u8 max 0", bits_right(u8Max, 0x00), 0x00ff)
	chk_u8("const left u8 max 1", bits_left(u8Max, 0x1), 254)
	chk_u8("const right u8 max 1", bits_right(u8Max, 0x1), 0X7f)
	chk_u8("const left u8 max 7", bits_left(u8Max, 0b111), 0B1000_0000)
	chk_u8("const right u8 max 7", bits_right(u8Max, 7), 0x01)
	chk_u8("const left u8 max 8", bits_left(u8Max, 0x008), 0x0)
	chk_u8("const right u8 max 8", bits_right(u8Max, 8), 0x0)
	chk_u8("const left u8 max 9", bits_left(u8Max, 0X9), 0b0)
	chk_u8("const right u8 max 9", bits_right(u8Max, 0B1001), 0)
	chk_u8("const left u8 max 100", bits_left(u8Max, 0x64), 0x000)
	chk_u8("const right u8 max 100", bits_right(u8Max, 0x64), 0)
	chk_u8("const left u8 3 by max", bits_left(0x3, u8Max), 0X0)
	chk_u8("const right u8 3 by max", bits_right(0b11, u8Max), 0B0000)
	chk_u8("const and u8 min 0", bits_and(u8Min, 0), 0x00)
	chk_u8("const and u8 0 min", bits_and(0x000, u8Min), 0x0)
	chk_u8("const and u8 min 85", bits_and(u8Min, 85), 0x0)
	chk_u8("const and u8 85 min", bits_and(0X55, u8Min), 0b0)
	chk_u8("const or u8 min 0", bits_or(u8Min, 0B0000), 0)
	chk_u8("const or u8 0 min", bits_or(0x00, u8Min), 0x000)
	chk_u8("const or u8 min 85", bits_or(u8Min, 0x55), 85)
	chk_u8("const or u8 85 min", bits_or(0x55, u8Min), 0X55)
	chk_u8("const xor u8 min 0", bits_xor(u8Min, 0b0), 0B0000)
	chk_u8("const xor u8 0 min", bits_xor(0, u8Min), 0x00)
	chk_u8("const xor u8 min 85", bits_xor(u8Min, 0x0055), 0x55)
	chk_u8("const xor u8 85 min", bits_xor(85, u8Min), 0x55)
	chk_u8("const not u8 min", bits_not(u8Min), 0XfF)
	chk_u8("const not not u8 min", bits_not(bits_not(u8Min)), 0b0)
	chk_u8("const left u8 min 0", bits_left(u8Min, 0B0000), 0)
	chk_u8("const right u8 min 0", bits_right(u8Min, 0x00), 0x000)
	chk_u8("const left u8 min 1", bits_left(u8Min, 0x1), 0)
	chk_u8("const right u8 min 1", bits_right(u8Min, 0x1), 0X0)
	chk_u8("const left u8 min 7", bits_left(u8Min, 0b111), 0B0000)
	chk_u8("const right u8 min 7", bits_right(u8Min, 7), 0x00)
	chk_u8("const left u8 min 8", bits_left(u8Min, 0x008), 0x0)
	chk_u8("const right u8 min 8", bits_right(u8Min, 8), 0x0)
	chk_u8("const left u8 min 9", bits_left(u8Min, 0X9), 0b0)
	chk_u8("const right u8 min 9", bits_right(u8Min, 0B1001), 0)
	chk_u8("const left u8 min 100", bits_left(u8Min, 0x64), 0x000)
	chk_u8("const right u8 min 100", bits_right(u8Min, 0x64), 0)
	chk_u8("const left u8 3 by min", bits_left(0x3, u8Min), 0X3)
	chk_u8("const right u8 3 by min", bits_right(0b11, u8Min), 0B0011)
	chk_u8("const nested and(xor,or) u8", bits_and(bits_xor(u8Max, 85), bits_or(u8Min, 0xF0)), 0x00a0)
	chk_u8("const nested not(left) u8", bits_not(bits_left(u8Max, 1)), 0x1)
	chk_u8("const nested right(left) u8", bits_right(bits_left(u8Max, 3), 2), 62)
	chk_u8("const nested xor(not,not) u8", bits_xor(bits_not(u8Max), bits_not(u8Min)), 0xff)
	return
}
