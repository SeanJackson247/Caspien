	let bx = mut Box_s64{fAnd= bits_and(a, b), fOr= bits_or(a, b), fXor= bits_xor(a, b), fNot= bits_not(a), fShl= bits_left(a, n), fShr= bits_right(a, n)}
	chk_s64("struct fand s64", bx.fAnd, 0x003a003a003a003a0)
