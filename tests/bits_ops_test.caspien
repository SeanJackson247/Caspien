	chk_u16("xor u16 65535 21845", xor_u16(0xFfFf, 21845), 0xaaaa)
	chk_u16("xor u16 21845 0", xor_u16(0X5555, 0b0), 0B0101_0101_0101_0101)
	chk_u16("xor u16 21845 65535", xor_u16(21_845, 0xFF_FF), 0x00aaaa)
	chk_u16("xor u16 21845 21845", xor_u16(0x5555, 21845), 0x0)
	chk_u16("not u16 0", not_u16(0X0), 0b1111111111111111)
	chk_u16("not u16 65535", not_u16(0B1111_1111_1111_1111), 0)
	chk_u16("not u16 21845", not_u16(0x55_55), 0x00aaaa)
	chk_u16("not u16 15", not_u16(0xF), 65520)
	chk_u16("not u16 61680", not_u16(0xf0f0), 0XF0F)
	chk_u16("left u16 0 0", shl_u16(0b0, 0B0000), 0)
	chk_u16("left u16 0 1", shl_u16(0x00, 0x001), 0x0)
	chk_u16("left u16 0 15", shl_u16(0, 0xf), 0X0)
