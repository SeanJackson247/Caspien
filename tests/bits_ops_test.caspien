// ---- results stored into struct fields, fixed-array elements and dynarray elements ----
struct Box_u8{
	@pub{
		fAnd: mut u8
		fOr: mut u8
		fXor: mut u8
		fNot: mut u8
		fShl: mut u8
		fShr: mut u8
	}
}
func cont_u8(a: mut u8, b: mut u8, n: mut u8) void{
	?catch(e){ return }
	let bx = mut Box_u8{fAnd= bits_and(a, b), fOr= bits_or(a, b), fXor= bits_xor(a, b), fNot= bits_not(a), fShl= bits_left(a, n), fShr= bits_right(a, n)}
	chk_u8("struct fand u8", bx.fAnd, 0Xa0)
	chk_u8("struct for u8", bx.fOr, 0b11110101)
	chk_u8("struct fxor u8", bx.fXor, 0B0101_0101)
	chk_u8("struct fnot u8", bx.fNot, 90)
	chk_u8("struct fshl u8", bx.fShl, 0x28)
	chk_u8("struct fshr u8", bx.fShr, 0x0014)
	bx.fAnd = bits_xor(bx.fAnd, bits_left(bx.fShr, 1))
	bx.fShl = bits_or(bits_right(bx.fShl, 1), bits_not(bx.fOr))
	bx.fNot = bits_and(bx.fNot, bits_not(bx.fXor))
	chk_u8("struct rmw fand u8", bx.fAnd, 0x88)
	chk_u8("struct rmw fshl u8", bx.fShl, 30)
	chk_u8("struct rmw fnot u8", bx.fNot, 0xa)
	let:<mut u8[6]> arr = mut [0X1, 0b11111111, 0B0111_1111, 128, 0xEF, 0x0021]
	let:<mut u8[6]> want = mut [0xf2, 14, 0xe, 0Xf0, 0b101110, 0B1011_0010]
	for i in 0..6{
		match i into arr{
			arr[i] = bits_xor(bits_left(arr[i], 1), b)
		}
	}
	for match i in arr{
		match i in want{
			chk_u8("array element u8", arr[i], want[i])
		}
	}
	let:<mut u8> zero = mut 0
	let d = mut ? dyn:<u8>([])
	d = ? resize(d, 8, zero)
	for i in 0..8{
		let:<mut u8> k = mut wrap:<u8>(i)
		let:<mut u8> v = mut bits_xor(bits_left(1, k), wrap:<u8>(i * 11400714819323198485))
		match i into d{
			d[i] = v
		}
	}
	for i in 0..8{
		match i into d{
			d[i] = bits_not(bits_and(d[i], b))
		}
	}
	let:<mut u8[8]> dwant = mut [255, 0xEF, 0x00df, 0xCf, 191, 0xbf, 0XCf, 0b11101111]
	for i in 0..8{
		match i in d{
			match i in dwant{
				chk_u8("dynarray element u8", d[i], dwant[i])
			}
		}
	}
	return
}
struct Box_u16{
	@pub{
		fAnd: mut u16
		fOr: mut u16
		fXor: mut u16
		fNot: mut u16
		fShl: mut u16
		fShr: mut u16
