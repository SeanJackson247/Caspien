		let:<mut s64> x = mut wrap:<s64>(atoll("9223372036854775807"))
		let acc = mut 0
		for i in 0..70{
			let:<mut s64> c = mut wrap:<s64>(i)
			acc = acc + wrap:<u64>(bits_left(x, c))
		}
		check("sweep left s64 9223372036854775807 (70 counts)", acc == 9223372036854775809)
	}
	unsafe extern{
		let:<mut s64> x = mut wrap:<s64>(atoll("0") + 9223372036854775808)
