// ---- values from atoll() and from loop variables: whole sweeps of counts, compared as one checksum each ----
func sweep_u8() void{
	unsafe extern{
		let:<mut u8> x = mut wrap:<u8>(atoll("1"))
		let acc = mut 0
		for i in 0..78{
			let:<mut u8> c = mut wrap:<u8>(i)
			acc = acc + wrap:<u64>(bits_left(x, c))
		}
		check("sweep left u8 1 (78 counts)", acc == 255)
	}
	unsafe extern{
		let:<mut u8> x = mut wrap:<u8>(atoll("255"))
		let acc = mut 0
		for i in 0..78{
			let:<mut u8> c = mut wrap:<u8>(i)
			acc = acc + wrap:<u64>(bits_left(x, c))
		}
		check("sweep left u8 255 (78 counts)", acc == 1793)
	}
	unsafe extern{
		let:<mut u8> x = mut wrap:<u8>(atoll("0"))
		let acc = mut 0
		for i in 0..78{
			let:<mut u8> c = mut wrap:<u8>(i)
			acc = acc + wrap:<u64>(bits_left(x, c))
		}
		check("sweep left u8 0 (78 counts)", acc == 0)
	}
	unsafe extern{
		let:<mut u8> x = mut wrap:<u8>(atoll("170"))
		let acc = mut 0
		for i in 0..78{
			let:<mut u8> c = mut wrap:<u8>(i)
			acc = acc + wrap:<u64>(bits_left(x, c))
		}
		check("sweep left u8 170 (78 counts)", acc == 854)
	}
	unsafe extern{
		let:<mut u8> x = mut wrap:<u8>(atoll("85"))
		let acc = mut 0
		for i in 0..78{
			let:<mut u8> c = mut wrap:<u8>(i)
			acc = acc + wrap:<u64>(bits_left(x, c))
		}
		check("sweep left u8 85 (78 counts)", acc == 939)
	}
	unsafe extern{
		let:<mut u8> x = mut wrap:<u8>(atoll("1"))
		let acc = mut 0
		for i in 0..78{
			let:<mut u8> c = mut wrap:<u8>(i)
			acc = acc + wrap:<u64>(bits_right(x, c))
		}
		check("sweep right u8 1 (78 counts)", acc == 1)
	}
	unsafe extern{
		let:<mut u8> x = mut wrap:<u8>(atoll("255"))
		let acc = mut 0
		for i in 0..78{
			let:<mut u8> c = mut wrap:<u8>(i)
			acc = acc + wrap:<u64>(bits_right(x, c))
		}
		check("sweep right u8 255 (78 counts)", acc == 502)
	}
	unsafe extern{
		let:<mut u8> x = mut wrap:<u8>(atoll("0"))
		let acc = mut 0
		for i in 0..78{
			let:<mut u8> c = mut wrap:<u8>(i)
			acc = acc + wrap:<u64>(bits_right(x, c))
		}
		check("sweep right u8 0 (78 counts)", acc == 0)
	}
	unsafe extern{
		let:<mut u8> x = mut wrap:<u8>(atoll("170"))
		let acc = mut 0
		for i in 0..78{
			let:<mut u8> c = mut wrap:<u8>(i)
			acc = acc + wrap:<u64>(bits_right(x, c))
		}
		check("sweep right u8 170 (78 counts)", acc == 336)
	}
	unsafe extern{
		let:<mut u8> x = mut wrap:<u8>(atoll("85"))
		let acc = mut 0
		for i in 0..78{
			let:<mut u8> c = mut wrap:<u8>(i)
			acc = acc + wrap:<u64>(bits_right(x, c))
		}
		check("sweep right u8 85 (78 counts)", acc == 166)
	}
	return
}
func sweep_u16() void{
