		match i in d{
			match i in dwant{
				chk_s16("dynarray element s16", d[i], dwant[i])
			}
		}
	}
	return
}
struct Box_s32{
	@pub{
		fAnd: mut s32
		fOr: mut s32
		fXor: mut s32
		fNot: mut s32
		fShl: mut s32
		fShr: mut s32
	}
}
func cont_s32(a: mut s32, b: mut s32, n: mut s32) void{
	?catch(e){ return }
	let bx = mut Box_s32{fAnd= bits_and(a, b), fOr= bits_or(a, b), fXor= bits_xor(a, b), fNot= bits_not(a), fShl= bits_left(a, n), fShr= bits_right(a, n)}
	chk_s32("struct fand s32", bx.fAnd, 60_818_336)
	chk_s32("struct for s32", bx.fOr, -0x30_0A_30_0B)
	chk_s32("struct fxor s32", bx.fXor, -0x0033aa33ab)
	chk_s32("struct fnot s32", bx.fNot, 0x3C5A3C5A)
	chk_s32("struct fshl s32", bx.fShl, 489561384)
	chk_s32("struct fshr s32", bx.fShr, -0x78b478c)
	bx.fAnd = bits_xor(bx.fAnd, bits_left(bx.fShr, 1))
	bx.fShl = bits_or(bits_right(bx.fShl, 1), bits_not(bx.fOr))
	bx.fNot = bits_and(bx.fNot, bits_not(bx.fXor))
	chk_s32("struct rmw fand s32", bx.fAnd, -0XcB68cB8)
	chk_s32("struct rmw fshl s32", bx.fShl, 0b111110100111110011111010011110)
	chk_s32("struct rmw fnot s32", bx.fNot, 0B0011_0000_0000_1010_0011_0000_0000_1010)
	let:<mut s32[6]> arr = mut [1, 0xFF, 0x007f7f7f7f, -0x7f7f7f80, -1867788817, -0x789abcdf]
	let:<mut s32[6]> want = mut [0XFf00Ff2, 0b1111111100000000111000001110, -0B1110_1111_0001_0000_1110_1111_0010, 250_679_024, 0x2E_A7_94_2E, 0x0013a89b2]
	for i in 0..6{
		match i into arr{
			arr[i] = bits_xor(bits_left(arr[i], 1), b)
		}
	}
	for match i in arr{
		match i in want{
			chk_s32("array element s32", arr[i], want[i])
		}
	}
	let:<mut s32> zero = mut 0
	let d = mut ? dyn:<s32>([])
	d = ? resize(d, 8, zero)
	for i in 0..8{
		let:<mut s32> k = mut wrap:<s32>(i)
		let:<mut s32> v = mut bits_xor(bits_left(1, k), wrap:<s32>(i * 11400714819323198485))
		match i into d{
			d[i] = v
		}
	}
	for i in 0..8{
		match i into d{
			d[i] = bits_not(bits_and(d[i], b))
		}
	}
	let:<mut s32[8]> dwant = mut [-0x1, -255855633, -0xe900821, -0XdD00431, -0b1101001000000000000001000001, -0B1100_0111_0000_0000_1100_0100_0001, -196_085_809, -0x0B_00_04_11]
	for i in 0..8{
		match i in d{
			match i in dwant{
				chk_s32("dynarray element s32", d[i], dwant[i])
			}
		}
	}
	return
}
