	chk_u8("or u8 0 255", or_u8(0B0000, 255), 0xFF)
	chk_u8("or u8 0 85", or_u8(0x000, 0x55), 85)
	chk_u8("or u8 255 0", or_u8(0xff, 0X0), 0b11111111)
	chk_u8("or u8 255 255", or_u8(0B1111_1111, 255), 0xFF)
	chk_u8("or u8 255 85", or_u8(0x00ff, 0x55), 255)
	chk_u8("or u8 85 0", or_u8(0x55, 0X0), 0b1010101)
	chk_u8("or u8 85 255", or_u8(0B0101_0101, 255), 0xFF)
	chk_u8("or u8 85 85", or_u8(0x0055, 0x55), 85)
	chk_u8("xor u8 0 0", xor_u8(0x0, 0X0), 0b0)
	chk_u8("xor u8 0 255", xor_u8(0B0000, 255), 0xFF)
	chk_u8("xor u8 0 85", xor_u8(0x000, 0x55), 85)
