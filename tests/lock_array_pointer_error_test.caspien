// A lock struct may not hold a ref/auto inside a fixed array of structs.
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
enum Gate{ OPEN, CLOSED }
struct Counter{@pub{ n: mut u64 }}
struct Holder{@pub{ p: ref mut Counter }}
@lock(match self.gate : OPEN)
struct Slot{@pub{
	swap gate: atomic mut Gate
	hs: mut Holder[2]
}}
func main() void{
}
