// A struct may only link to itself through a plain nullable `ref`; this member form (raw) must still be rejected as a recursive struct.
import "../stdlib/libc.caspien"
import "../stdlib/gt_init.caspien"
import "../stdlib/gt_register.caspien"
import "../stdlib/gt_alive_check.caspien"
import "../stdlib/gt_destruct.caspien"
import "../stdlib/gt_moved.caspien"
struct S{@pub{
	v: mut u64
	n: raw mut S
}}
func main() void{
	unsafe extern{ printf("unreachable\n") }
}
