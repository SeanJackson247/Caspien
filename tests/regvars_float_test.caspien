// Regression test for float register variables (`float-variables-in-registers: on`, needs `variables-in-registers: on` and
// `deferred-operands: on`). Hot f32 locals are kept in xmm registers by RegVarPromotionPass; on SysV every call spills and reloads
// them, on win64 the callee-saved xmm6-15 keep them. Every expected value is worked out by hand (all values are exactly
// representable in f32); the output must be identical with the switch on and off. Prints one PASS/FAIL line per check, then one
// printf line whose text is given in the comment at the call.
import "../stdlib/libc.caspien"
import "../stdlib/gt_init.caspien"
import "../stdlib/gt_register.caspien"
import "../stdlib/gt_alive_check.caspien"
import "../stdlib/gt_destruct.caspien"
import "../stdlib/gt_moved.caspien"

extern sqrtf(mut f32) mut f32

func check(name: static imut string, ok: mut bool) void{
	unsafe extern{
		if ok{
			printf("PASS %s\n", name)
		}else{
			printf("FAIL %s\n", name)
		}
	}
	return
}

func feq(a: mut f32, b: mut f32) mut bool{
	let r = mut false
	unsafe assume{
		assume match a : finite
		assume match b : finite
		r = a == b
	}
	return r
}

// 1. plain accumulator and a float compare against the loop limit
func sumHalves(n: mut u64) mut f32{
	let s = mut 0.0
	let i = mut 0
	unsafe assume loop{
		loop{
			if i == n{
				break
			}
			assume match s : finite
			s = s + 0.5
			i++
		}
	}
	return s
}
func climb() mut f32{
	let f = mut 0.0
	unsafe assume loop{
		loop{
			assume match f : finite
			if f > 10.0{
				break
			}
			f = f + 3.0
		}
	}
	return f
}

// 2. calls inside the loop: the callee has its own float loop over the same registers; the caller's values must survive
func fInner(n: mut u64) mut f32{
	let a = mut 0.0
	let k = mut 0
	unsafe assume loop{
		loop{
			if k == n{
				break
			}
			assume match a : finite
			a = a + 1.5
			k++
		}
	}
	return a
}
func fOuter(n: mut u64) mut f32{
	let total = mut 0.0
	let j = mut 0
	unsafe assume loop{
		loop{
			if j == n{
				break
			}
			assume match total : finite
			assume match fInner((j+1)) : finite
			total = total + fInner(j + 1)
			j++
		}
	}
	return total
}

// 3. an extern (libm) call inside a loop, its result stored straight into a variable
func rootsSum() mut f32{
	let acc = mut 0.0
	let y = mut 0.0
	let x = mut 16.0
	let i = mut 0
	unsafe assume extern loop{
		loop{
			if i == 4{
				break
			}
			y = sqrtf(x)
			assume match acc : finite
			assume match y : finite
			acc = acc + y
			i++
		}
	}
	return acc
}

// 4. a float argument, a float result and a nested call in the argument list
func addf(a: mut f32, b: mut f32) mut f32{
	unsafe assume{
		assume match a : finite
		assume match b : finite
		return a + b
	}
}
func viaCalls() mut f32{
	let acc = mut 0.0
	let i = mut 0
	unsafe assume extern loop{
		loop{
			if i == 8{
				break
			}
			acc = addf(acc, 0.25)
			i++
		}
		let r = mut 0.0
		r = sqrtf(addf(acc, 2.0))
		assume match acc : finite
		assume match r : finite
		acc = acc + r
	}
	return acc
}

// 5. a throw out of a loop that keeps float variables in registers, caught one frame up
@throws
func fthrower(x: mut u64) mut f32{
	let z = mut 0.0
	let q = mut 0
	unsafe assume loop{
		loop{
			if q == x{
				break
			}
			assume match z : finite
			z = z + 2.0
			if q == 3{
				throw "three"
			}
			q++
		}
	}
	return z
}
func ftry(i: mut u64) mut f32{
	let r = try fthrower(i) catch(e){
		return 100.0
	}
	return r
}
func catchers() mut f32{
	let acc = mut 0.0
	let i = mut 0
	unsafe assume loop{
		loop{
			if i == 6{
				break
			}
			assume match acc : finite
			assume match ftry(i) : finite
			acc = acc + ftry(i)
			i++
		}
	}
	return acc
}
// the catch body itself reads the promoted float variable
func catchUses() mut f32{
	let acc = mut 0.0
	let i = mut 0
	unsafe assume loop{
		loop{
			if i == 6{
				break
			}
			assume match acc : finite
			acc = acc + 1.0
			let r = try fthrower(i) catch(e){
				assume match acc : finite
				return acc + 0.5
			}
			assume match acc : finite
			assume match r : finite
			acc = acc + r
			i++
		}
	}
	return acc
}

// 6. more hot float variables than registers: the heaviest win, the rest stay in memory, all results stay right
func manyFloats(n: mut u64) mut f32{
	let a = mut 0.0
	let b = mut 0.0
	let c = mut 0.0
	let d = mut 0.0
	let e = mut 0.0
	let f = mut 0.0
	let g = mut 0.0
	let i = mut 0
	unsafe assume loop{
		loop{
			if i == n{
				break
			}
			assume match a : finite
			a = a + 1.0
			assume match b : finite
			b = b + 2.0
			assume match c : finite
			c = c + 3.0
			assume match d : finite
			d = d + 4.0
			assume match e : finite
			e = e + 5.0
			assume match f : finite
			f = f + 6.0
			assume match g : finite
			g = g + 7.0
			i++
		}
	}
	unsafe assume{
		assume match b : finite
		assume match a : finite
		assume match b*2.0 : finite
		assume match c : finite
		assume match a+(b*2.0) : finite
		assume match c*3.0 : finite
		assume match d : finite
		assume match (a+(b*2.0))+(c*3.0) : finite
		assume match d*4.0 : finite
		assume match e : finite
		assume match ((a+(b*2.0))+(c*3.0))+(d*4.0) : finite
		assume match e*5.0 : finite
		assume match f : finite
		assume match (((a+(b*2.0))+(c*3.0))+(d*4.0))+(e*5.0) : finite
		assume match f*6.0 : finite
		assume match g : finite
		assume match ((((a+(b*2.0))+(c*3.0))+(d*4.0))+(e*5.0))+(f*6.0) : finite
		assume match g*7.0 : finite
		return a + b * 2.0 + c * 3.0 + d * 4.0 + e * 5.0 + f * 6.0 + g * 7.0
	}
}

// 7. a static (global) f32 read and written from a loop, and int and float variables together
let static gsum = mut 0.0
func globals() mut f32{
	let x = mut 0.5
	let n = mut 0
	unsafe assume global loop{
		loop{
			if n == 6{
				break
			}
			assume match gsum : finite
			assume match x : finite
			gsum = gsum + x
			x = x + 0.5
			n++
		}
		return gsum
	}
}

// 8. a promoted float that is also printed (it is pushed for the varargs call) and a narrow int next to it
func printed() mut f32{
	let v = mut 1.0
	let k = mut 0
	unsafe assume extern loop{
		loop{
			if k == 3{
				break
			}
			assume match v : finite
			v = v + 0.5
			k++
		}
		printf("printed %f\n", v) // printed 2.500000
	}
	return v
}

// 9. a function that keeps float variables in registers and also allocates
struct Box{
	@pub{ v: mut u64 }
}
@throws
func boxedF(n: mut u64) mut f32{
	?catch(e){ throw e }
	let s = mut 0.0
	let i = mut 0
	unsafe assume loop{
		loop{
			if i == n{
				break
			}
			assume match s : finite
			s = s + 0.25
			i++
		}
	}
	let b = mut ?new Box{v= n}
	return s
}

func main() void{
	check("sum of halves", feq(sumHalves(7), 3.5))
	check("climb", feq(climb(), 12.0))
	check("calls inside a loop", feq(fOuter(4), 15.0))
	check("libm call result", feq(rootsSum(), 16.0))
	check("float args and results", feq(viaCalls(), 4.0))
	check("throw caught in a float loop", feq(catchers(), 212.0))
	check("catch reads a promoted float", feq(catchUses(), 17.5))
	check("more floats than registers", feq(manyFloats(3), 420.0))
	check("static float in a loop", feq(globals(), 10.5))
	check("printed float", feq(printed(), 2.5))
	try{
		?catch(e){ return }
		let bx = mut ?boxedF(10)
		check("allocating function", feq(bx, 2.5))
	}
}
