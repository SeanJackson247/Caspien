import "../stdlib/libc.caspien"
@throws
func f(x: mut u64) mut u64{
	if x == 0{
		throw "zero"
	}
	return x
}
@throws
func g(x: mut u64) mut u64{
	?catch(e){ throw e }
	return ?f(x)
}
func show(a: mut u64) void{
	unsafe{ printf("a=%llu\n", a) }
}
func main() void{
	try{
		let a = try g(0) catch(e){
			unsafe{ printf("caught\n") }
			return
		}
		show(a)
	}
}
