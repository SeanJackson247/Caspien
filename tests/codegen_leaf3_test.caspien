func t_fb(text: static imut string, dbl: imut bool) mut u64{
	?catch(e){ return 0 }
	let a = mut ? new String(text)
	let v = mut 0
	match Some(a){
		v = ? FloatText.bits(a, dbl)
	}
	return v
}

func c_fb(name: static imut string, text: static imut string, fwant: mut u64, dwant: mut s64) void{
	check(name, t_fb(text, false) == fwant && wrap:<s64>(t_fb(text, true)) == dwant)
}

func t_grip(g: static imut string) owns mut String{
	?catch(e){ return null }
	let b = mut nb()
	let a = mut ? new String(g)
	let k1 = mut ? String.from("g.alias")
	let k2 = mut ? String.from("g.alias")
	let parentName = mut ? String.from("g.parent")
	match Some(b){
		? b.core.globalAliasOffset.put(b.core.globalAliasOffset, k1, 24)
	}
	match Some(b){
		? b.core.globalAliasParent.put(b.core.globalAliasParent, k2, parentName)
	}
	match Some(b){ match Some(b.emit){ match Some(a){
		let r = mut ? b.emit.globalRipOperand(b.emit, a)
		return r
	} } }
	return null
}

func c_grip(name: static imut string, g: static imut string, want: static imut string) void{
	let r = mut t_grip(g)
	chk(name, r, want)
}

// builds statements from "T T T;T T;" text and installs them as the backend's lines
func fill(lines: ref mut ObjectList<BytecodeStatement>, spec: static imut string) void{
	?catch(e){ return }
	let s = mut ? new String(spec)
	let stmt = mut ? new BytecodeStatement()
	let tok = mut ? new String()
	let n = mut s.length(s)
	for i in 0..n{
		let c = mut s.charAt(s, i)
		if c == ' ' || c == ';'{
			let f = mut ? new String("f")
			let tk = mut ? new BytecodeToken(tok, f, 1, BytecodeTokenKind.CODE)
			? stmt.items.add(stmt.items, tk)
			tok = ? new String()
			if c == ';'{
				match Some(lines){ ? lines.add(lines, stmt) }
				stmt = ? new BytecodeStatement()
			}
		} else{
			? tok.appendChar(tok, c)
		}
	}
}

func t_mcs(spec: static imut string, cur: mut s32) owns mut String{
	?catch(e){ return null }
	let b = mut nb()
	let lines = mut ? new ObjectList:<BytecodeStatement>()
	fill(lines, spec)
	match Some(b){ match Some(lines){
		b.core.allLines = ref lines
		b.core.currentLineIndex = cur
	} }
	match Some(b){ match Some(b.calls){
		let v = ? b.calls.memcopyConstantSize(b.calls)
		let r = mut ? String.fromS64(v)
		return r
	} }
	return null
}

func c_mcs(name: static imut string, spec: static imut string, cur: mut s32, want: static imut string) void{
	let r = mut t_mcs(spec, cur)
	chk(name, r, want)
}

func t_las(spec: static imut string, cur: mut s32, off: mut s32) mut bool{
	?catch(e){ return false }
	let b = mut nb()
	let lines = mut ? new ObjectList:<BytecodeStatement>()
	fill(lines, spec)
	match Some(b){ match Some(lines){
		b.core.allLines = ref lines
		b.core.currentLineIndex = cur
	} }
	let r = mut false
	match Some(b){ match Some(b.emit){
		r = b.emit.lineAtOffsetIsAtomicSwap(b.emit, off)
	} }
	return r
}

func c_las(name: static imut string, spec: static imut string, cur: mut s32, off: mut s32, want: imut bool) void{
	check(name, t_las(spec, cur, off) == want)
}

func t_txt(spec: static imut string) owns mut String{
	?catch(e){ return null }
	let b = mut nb()
	let stmt = mut ? new BytecodeStatement()
	let s = mut ? new String(spec)
	let tok = mut ? new String()
	let n = mut s.length(s)
	for i in 0..n{
		let c = mut s.charAt(s, i)
		if c == ' '{
			let f = mut ? new String("f")
			let tk = mut ? new BytecodeToken(tok, f, 1, BytecodeTokenKind.CODE)
			? stmt.items.add(stmt.items, tk)
			tok = ? new String()
		} else{
			? tok.appendChar(tok, c)
		}
	}
	if n > 0{
		let f = mut ? new String("f")
		let tk = mut ? new BytecodeToken(tok, f, 1, BytecodeTokenKind.CODE)
		? stmt.items.add(stmt.items, tk)
	}
	let out = mut ? new String()
	match Some(stmt){
		let list = mut ? X86Core.textsOf(stmt)
		let m = mut list.size(list)
		for j in 0..m{
			let e = list.get(list, j)
			match Some(e){
				? out.append(out, e)
				? out.append(out, "|")
			}
		}
	}
	return out
}

func c_txt(name: static imut string, spec: static imut string, want: static imut string) void{
	let r = mut t_txt(spec)
	chk(name, r, want)
}

