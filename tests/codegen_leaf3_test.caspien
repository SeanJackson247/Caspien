// Differential test of more converted leaf methods of codegenCaspien (char/immediate decoding, register names, global operands, float text, statement lookback) against the Java originals (check lines generated by gen_codegen_leaf3_test.py).
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
import "../Codegen/src/main/java/caspien/codegen/codegenCaspien/x86backend/X86Backend.caspien"
import "../Codegen/src/main/java/caspien/codegen/codegenCaspien/FloatText.caspien"

func check(name: static imut string, ok: imut bool) void{
	unsafe extern{
		if ok{ printf("PASS %s\n", name) }
		else{ printf("FAIL %s\n", name) }
	}
}

func t_min() mut s64{
	let:<mut s64> m = mut -9223372036854775807
	let:<mut s64> one = mut 1
	return m - one
}

// got == null means the method threw; want "EX" means the Java threw.
func chk(name: static imut string, got: ref imut String, want: static imut string) void{
	let ok = mut String.literalsEqual(want, "EX")
	match Some(got){
		ok = got.equals(got, want)
	}
	check(name, ok)
}

func nb() owns mut X86Backend{
	?catch(e){ return null }
	let b = mut ? new X86Backend(CodegenTarget.LINUX_X64)
	? b.wire(b)
	return b
}

func num(v: mut s64) owns mut String{
	?catch(e){ return null }
	let r = mut ? String.fromS64(v)
	return r
}

func t_dcl(text: static imut string) owns mut String{
	?catch(e){ return null }
	let s = mut ? new String(text)
	let f = mut ? new String("f")
	let tok = mut ? new BytecodeToken(s, f, 1, BytecodeTokenKind.CODE)
	match Some(tok){
		let v = ? X86Core.decodeCharLiteral(tok)
		let r = mut ? String.fromS64(v)
		return r
	}
	return null
}

func c_dcl(name: static imut string, text: static imut string, want: static imut string) void{
	let r = mut t_dcl(text)
	chk(name, r, want)
}

func t_rsp(t: static imut string, p: static imut string, s: static imut string) owns mut String{
	?catch(e){ return null }
	let b = mut nb()
	let a = mut ? new String(t)
	let pp = mut ? new String(p)
	let ss = mut ? new String(s)
	match Some(b){ match Some(b.emit){ match Some(a){ match Some(pp){ match Some(ss){
		let v = ? b.emit.parseRspDelta(b.emit, a, pp, ss)
		let r = mut ? String.fromS64(v)
		return r
	} } } } }
	return null
}

func c_rsp(name: static imut string, t: static imut string, p: static imut string, s: static imut string, want: static imut string) void{
	let r = mut t_rsp(t, p, s)
	chk(name, r, want)
}

