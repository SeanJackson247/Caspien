	?catch(e){ return null }
	let b = mut nb()
	let a = mut ? new String(reg)
	match Some(b){ match Some(b.emit){ match Some(a){
		let r = mut ? b.emit.sizedReg(b.emit, a, size)
		return r
	} } }
	return null
}

func c_sz(name: static imut string, reg: static imut string, size: mut s32, want: static imut string) void{
	let r = mut t_sz(reg, size)
	chk(name, r, want)
}

