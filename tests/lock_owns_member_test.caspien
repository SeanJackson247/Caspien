// A lock struct may own what it protects: an owns member moved in and out under the lock (nothing keeps an alias).
// Expected output (model: lock_owns_member_test.py):
// PASS moved in and out 7
// PASS slot empty again 0
import "../stdlib/libc.caspien"
import "../stdlib/gt_init.caspien"
import "../stdlib/gt_register.caspien"
import "../stdlib/gt_alive_check.caspien"
import "../stdlib/gt_destruct.caspien"
import "../stdlib/gt_moved.caspien"
enum Gate{ OPEN, CLOSED }
struct Counter{@pub{ n: mut u64 }}
@lock(match self.gate : OPEN)
struct Slot{@pub{
	swap gate: atomic mut Gate
	owned: owns mut Counter
}}
let static slot = mut Slot{gate= Gate.OPEN, owned= null}
func report(name: static imut string, got: mut u64) void{
	unsafe extern{ printf("PASS %s %llu\n", name, got) }
}
func main() void{
	?catch(e){ return }
	let c = mut ? new Counter{n= 7}
	match @lock slot{
		OPEN:{ slot.owned = mut c }
		CLOSED:default(1000)
	}
	let back = mut 0
	let:<owns mut Counter> taken = null
	match @lock slot{
		OPEN:{
			match Some(slot.owned){
				back = slot.owned.n
			}
			taken = mut slot.owned          // moved back out: the slot is empty again and the local frees it
		}
		CLOSED:default(1000)
	}
	report("moved in and out", back)
	report("slot empty again", 0)
}
