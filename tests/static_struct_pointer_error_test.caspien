// `static x` of a struct global was lowered as a struct copy into a pointer slot (crash / stack corruption): refused.
import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
enum Gate{ OPEN, CLOSED }
struct Counter{@pub{ n: mut u64 }}
@lock(match self.gate : OPEN)
struct Slot{@pub{
	swap gate: atomic mut Gate
	inner: mut Counter
}}
let static slot = mut Slot{gate= Gate.OPEN, inner= mut Counter{n= 0}}
func main() void{
	let p = mut static slot
}
