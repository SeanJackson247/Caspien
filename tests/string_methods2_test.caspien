import "../stdlib/libc.caspien"
import "../stdlib/gt/*"
import "../stdlib/print.caspien"
import "../stdlib/string.caspien"

func report(name: static imut string, ok: imut bool) void{
	if ok{ print("PASS ") } else { print("FAIL ") }
	println(name)
}

@throws
func idx(a: static imut string, b: static imut string, from: imut u64, c: mut char, want: imut s64, wantC: imut s64) void{
	?catch(e){ throw e }
	let sa = mut ? new String(a)
	let sb = mut ? new String(b)
	match Some(sa){
		match Some(sb){
			report(a, sa.indexOf(sa, sb, from) == want)
			report(a, sa.indexOf(sa, b, from) == want)
			report(a, sa.indexOf(sa, c, from) == wantC)
			report(a, sa.contains(sa, sb) == (sa.indexOf(sa, sb, 0) >= 0))
		}
	}
}

@throws
func sub1(a: static imut string, start: imut u64, want: static imut string, a2: imut u64, b2: imut u64, want2: static imut string) void{
	?catch(e){ throw e }
	let sa = mut ? new String(a)
	match Some(sa){
		let r = mut ? sa.substring(sa, start)
		match Some(r){ report(want, r.equals(r, want)) }
		let r2 = mut ? sa.substring(sa, a2, b2)
		match Some(r2){ report(want2, r2.equals(r2, want2)) }
	}
}

@throws
func trim1(a: static imut string, want: static imut string) void{
	?catch(e){ throw e }
	let sa = mut ? new String(a)
	match Some(sa){
		let r = mut ? sa.trim(sa)
		match Some(r){ report(want, r.equals(r, want)) }
	}
}

@throws
func rep1(a: static imut string, t: static imut string, r: static imut string, want: static imut string, c1: mut char, c2: mut char, wantC: static imut string) void{
	?catch(e){ throw e }
	let sa = mut ? new String(a)
	let st = mut ? new String(t)
	let sr = mut ? new String(r)
	match Some(sa){
		match Some(st){
			match Some(sr){
				let x = mut ? sa.replace(sa, st, sr)
				match Some(x){ report(want, x.equals(x, want)) }
				let y = mut ? sa.replace(sa, t, r)
				match Some(y){ report(want, y.equals(y, want)) }
				let z = mut ? sa.replace(sa, c1, c2)
				match Some(z){ report(wantC, z.equals(z, wantC)) }
			}
		}
	}
}

@throws
func rr1(a: static imut string, s: imut u64, e2: imut u64, r: static imut string, want: static imut string) void{
	?catch(e){ throw e }
	let sa = mut ? new String(a)
	let sr = mut ? new String(r)
	match Some(sa){
		match Some(sr){
			? sa.replaceRange(sa, s, e2, sr)
			report(want, sa.equals(sa, want))
		}
	}
}

@throws
func num1(v: imut s64, want: static imut string, u: imut u64, wantU: static imut string, total: imut u64) void{
	?catch(e){ throw e }
	let a = mut ? String.fromS64(v)
	match Some(a){ report(want, a.equals(a, want)) }
	let b = mut ? String.fromU64(u)
	match Some(b){ report(wantU, b.equals(b, wantU)) }
	let c = mut ? new String("x=")
	match Some(c){
		? c.appendS64(c, v)
		? c.appendU64(c, u)
		? c.append(c, "!")
		? c.append(c, '?')
		let d = mut ? new String("#")
		match Some(d){ ? c.append(c, d) }
		report(want, c.length(c) == total)
	}
}

func parse1(text: static imut string, okS: imut bool, vS: imut s64, okU: imut bool, vU: imut u64, ok32: imut bool, v32: imut s32) void{
	?catch(e){ report(text, okS == false); return }
	let s = mut ? new String(text)
	match Some(s){
		let x = mut ? s.parseS64(s)
		report(text, okS)
		report(text, x == vS)
	}
}
func parse2(text: static imut string, okU: imut bool, vU: imut u64) void{
	?catch(e){ report(text, okU == false); return }
	let s = mut ? new String(text)
	match Some(s){
		let x = mut ? s.parseU64(s)
		report(text, okU)
		report(text, x == vU)
	}
}
func parse3(text: static imut string, ok32: imut bool, v32: imut s32) void{
	?catch(e){ report(text, ok32 == false); return }
	let s = mut ? new String(text)
	match Some(s){
		let x = mut ? s.parseS32(s)
		report(text, ok32)
		report(text, x == v32)
	}
}

